#################################################################
#    Individuals
#################################################################

###  https://gwsp.cs.ksu.edu/disease-management/disease/Bacterial_Leaf_Streak
<https://gwsp.cs.ksu.edu/disease-management/disease/Bacterial_Leaf_Streak> rdf:type owl:NamedIndividual ,
                                                                                    <https://gwsp.cs.ksu.edu/disease-management/disease/Bacterial_Disease> ;
                                                                           <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Xanthomonas_translucens> ;
                                                                           rdfs:comment "Caused by Xanthomonas translucens. Produces water-soaked, translucent streaks on leaves that become necrotic. Favoured by warm, humid conditions with wind-driven rain. No effective chemical control; managed by resistant cultivars and clean seed." ;
                                                                           rdfs:label "Bacterial Leaf Streak" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Barley_Yellow_Dwarf
<https://gwsp.cs.ksu.edu/disease-management/disease/Barley_Yellow_Dwarf> rdf:type owl:NamedIndividual ,
                                                                                  <https://gwsp.cs.ksu.edu/disease-management/disease/Viral_Disease> ;
                                                                         <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Barley_Yellow_Dwarf_Virus> ;
                                                                         rdfs:comment "Caused by Barley Yellow Dwarf Virus, transmitted by cereal aphids. Causes yellowing or purpling of flag leaves and reduced grain fill. Managed by insecticidal seed treatment to control aphid vectors and by tolerant cultivars." ;
                                                                         rdfs:label "Barley Yellow Dwarf" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Common_Bunt
<https://gwsp.cs.ksu.edu/disease-management/disease/Common_Bunt> rdf:type owl:NamedIndividual ,
                                                                          <https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Fungal_Disease> ;
                                                                 <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Tilletia_spp> ;
                                                                 rdfs:comment "Also called stinking smut. Caused by Tilletia spp. Infected kernels are replaced by masses of dark, foul-smelling teliospores (bunt balls). Seedborne and soilborne; infection occurs at germination when cool, moist soil conditions prevail. Almost completely controlled by modern fungicidal seed treatments." ;
                                                                 rdfs:label "Common Bunt" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Fusarium_Foot_Rot
<https://gwsp.cs.ksu.edu/disease-management/disease/Fusarium_Foot_Rot> rdf:type owl:NamedIndividual ,
                                                                                <https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Fungal_Disease> ;
                                                                       <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Fusarium_spp> ;
                                                                       rdfs:comment "A soilborne disease caused by Fusarium spp. that attacks the crown and lower stem of wheat. Causes browning of the stem base, stunting, and premature death of tillers. Favoured by wet, cool soil conditions. Managed by seed treatment, crop rotation, and avoiding compacted soils." ;
                                                                       rdfs:label "Fusarium Foot Rot" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Fusarium_Head_Blight
<https://gwsp.cs.ksu.edu/disease-management/disease/Fusarium_Head_Blight> rdf:type owl:NamedIndividual ,
                                                                                   <https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Fungal_Disease> ;
                                                                          <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Fusarium_graminearum> ;
                                                                          rdfs:comment "Also called scab. Caused by Fusarium graminearum. Infects spikelets at flowering, causing premature bleaching of the head. Produces the mycotoxin deoxynivalenol (DON/vomitoxin) that causes grain quality rejection. Favoured by warm, humid conditions during anthesis. Managed by moderately resistant cultivars, fungicide at flowering, and crop rotation." ;
                                                                          rdfs:label "Fusarium Head Blight" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Intermediate
<https://gwsp.cs.ksu.edu/disease-management/disease/Intermediate> rdf:type owl:NamedIndividual ,
                                                                           <https://gwsp.cs.ksu.edu/disease-management/disease/Resistance_Level> ;
                                                                  rdfs:comment "Moderate disease development; the cultivar is neither clearly resistant nor clearly susceptible. May show variable response across environments. Typical severity 20â€“40%." ;
                                                                  rdfs:label "Intermediate" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Leaf_Rust
<https://gwsp.cs.ksu.edu/disease-management/disease/Leaf_Rust> rdf:type owl:NamedIndividual ,
                                                                        <https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Fungal_Disease> ;
                                                               <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Puccinia_triticina> ;
                                                               rdfs:comment "The most common rust disease of wheat worldwide. Caused by Puccinia triticina. Produces small, circular, orange-brown pustules (uredinia) primarily on the upper leaf surface. Favoured by moderate temperatures (15â€“22 degrees C) and high humidity. Yield losses of 10â€“30% are typical in susceptible cultivars during epidemic years. Managed by resistant cultivars and foliar fungicides applied at flag leaf." ;
                                                               rdfs:label "Leaf Rust" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Leaf_Spot_Complex
<https://gwsp.cs.ksu.edu/disease-management/disease/Leaf_Spot_Complex> rdf:type owl:NamedIndividual ,
                                                                                <https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Fungal_Disease> ;
                                                                       <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Septoria_Stagonospora_complex> ;
                                                                       rdfs:comment "A complex of diseases caused by Zymoseptoria tritici (Septoria tritici blotch) and Parastagonospora nodorum (Stagonospora nodorum blotch). Produces tan to brown necrotic lesions with dark fruiting bodies (pycnidia). Residue-borne; rain-splash moves spores upward through the canopy. Favoured by cool, wet conditions." ;
                                                                       rdfs:label "Leaf Spot Complex" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Loose_Smut
<https://gwsp.cs.ksu.edu/disease-management/disease/Loose_Smut> rdf:type owl:NamedIndividual ,
                                                                         <https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Fungal_Disease> ;
                                                                <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Ustilago_tritici> ;
                                                                rdfs:comment "Caused by Ustilago tritici. The entire head is replaced by a mass of dark spores that are dispersed by wind. Unique infection cycle: the pathogen infects the developing embryo at flowering and remains dormant inside the seed until the next season. Only controlled by systemic seed treatments that penetrate the embryo." ;
                                                                rdfs:label "Loose Smut" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Moderately_Resistant
<https://gwsp.cs.ksu.edu/disease-management/disease/Moderately_Resistant> rdf:type owl:NamedIndividual ,
                                                                                   <https://gwsp.cs.ksu.edu/disease-management/disease/Resistance_Level> ;
                                                                          rdfs:comment "Low disease development; symptoms present but limited in extent. Partial resistance slows epidemic progress. Typical severity 5â€“20%." ;
                                                                          rdfs:label "Moderately Resistant" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Moderately_Susceptible
<https://gwsp.cs.ksu.edu/disease-management/disease/Moderately_Susceptible> rdf:type owl:NamedIndividual ,
                                                                                     <https://gwsp.cs.ksu.edu/disease-management/disease/Resistance_Level> ;
                                                                            rdfs:comment "Substantial disease development; symptoms widespread but yield loss is partially limited by residual resistance. Typical severity 40â€“60%. Fungicide application is often economically justified." ;
                                                                            rdfs:label "Moderately Susceptible" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Resistant
<https://gwsp.cs.ksu.edu/disease-management/disease/Resistant> rdf:type owl:NamedIndividual ,
                                                                        <https://gwsp.cs.ksu.edu/disease-management/disease/Resistance_Level> ;
                                                               rdfs:comment "Little or no disease development under favourable conditions for infection. The cultivar carries effective major genes or strong quantitative resistance. Typical severity <5%." ;
                                                               rdfs:label "Resistant" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Sharp_Eyespot
<https://gwsp.cs.ksu.edu/disease-management/disease/Sharp_Eyespot> rdf:type owl:NamedIndividual ,
                                                                            <https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Fungal_Disease> ;
                                                                   <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Rhizoctonia_cerealis> ;
                                                                   rdfs:comment "Caused by Rhizoctonia cerealis. Produces sharp-bordered, eye-shaped lesions on the stem base. Soilborne; favoured by cool, wet conditions and conservation tillage that retains surface residue. Managed by seed treatment and crop rotation." ;
                                                                   rdfs:label "Sharp Eyespot" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Stem_Rust
<https://gwsp.cs.ksu.edu/disease-management/disease/Stem_Rust> rdf:type owl:NamedIndividual ,
                                                                        <https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Fungal_Disease> ;
                                                               <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Puccinia_graminis_tritici> ;
                                                               rdfs:comment "Caused by Puccinia graminis f. sp. tritici. Produces large, elongated, dark reddish-brown pustules on stems, leaves, and heads. Favoured by warm temperatures (25â€“30 degrees C). Historically the most destructive wheat disease; the Ug99 race group threatens global wheat production. Yield losses can exceed 50% in susceptible cultivars." ;
                                                               rdfs:label "Stem Rust" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Stripe_Rust
<https://gwsp.cs.ksu.edu/disease-management/disease/Stripe_Rust> rdf:type owl:NamedIndividual ,
                                                                          <https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Fungal_Disease> ;
                                                                 <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Puccinia_striiformis_tritici> ;
                                                                 rdfs:comment "Caused by Puccinia striiformis f. sp. tritici. Produces yellow to orange pustules arranged in stripes along the leaf veins. Favoured by cool temperatures (10â€“15 degrees C) and high humidity. Increasingly important in the southern Great Plains due to adaptation of new races to warmer climates." ;
                                                                 rdfs:label "Stripe Rust" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Susceptible
<https://gwsp.cs.ksu.edu/disease-management/disease/Susceptible> rdf:type owl:NamedIndividual ,
                                                                          <https://gwsp.cs.ksu.edu/disease-management/disease/Resistance_Level> ;
                                                                 rdfs:comment "Severe disease development with extensive symptom coverage and significant yield loss. No effective genetic resistance; chemical or cultural control is essential. Typical severity >60%." ;
                                                                 rdfs:label "Susceptible" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Take_All
<https://gwsp.cs.ksu.edu/disease-management/disease/Take_All> rdf:type owl:NamedIndividual ,
                                                                       <https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Fungal_Disease> ;
                                                              <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Gaeumannomyces_graminis> ;
                                                              rdfs:comment "Caused by Gaeumannomyces graminis var. tritici. A soilborne root and crown rot that blackens the root system and causes whiteheads (premature ripening of individual heads). No effective fungicides; managed by crop rotation (2+ years away from wheat/barley) and maintaining soil pH below 6.5." ;
                                                              rdfs:label "Take-All" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Streak_Mosaic
<https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Streak_Mosaic> rdf:type owl:NamedIndividual ,
                                                                                  <https://gwsp.cs.ksu.edu/disease-management/disease/Viral_Disease> ;
                                                                         <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> <https://gwsp.cs.ksu.edu/disease-management/pathogen/Wheat_Streak_Mosaic_Virus> ;
                                                                         rdfs:comment "Caused by Wheat Streak Mosaic Virus, transmitted by the wheat curl mite. Produces yellow-green mosaic patterns and leaf streaking. Managed by eliminating volunteer wheat (the green bridge), delayed planting, and resistant cultivars." ;
                                                                         rdfs:label "Wheat Streak Mosaic" .


###  https://gwsp.cs.ksu.edu/disease-management/management/At_Planting_Seed_Treatment
<https://gwsp.cs.ksu.edu/disease-management/management/At_Planting_Seed_Treatment> rdf:type owl:NamedIndividual ,
                                                                                            <https://gwsp.cs.ksu.edu/disease-management/management/Application_Timing> ;
                                                                                   rdfs:comment "Fungicidal seed treatment applied before or during planting. Targets seedborne pathogens (bunt, smut) and soilborne seedling diseases (Fusarium, Pythium, Rhizoctonia) during germination and emergence." ;
                                                                                   rdfs:label "At Planting (Seed Treatment)" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Crop_Rotation
<https://gwsp.cs.ksu.edu/disease-management/management/Crop_Rotation> rdf:type owl:NamedIndividual ,
                                                                               <https://gwsp.cs.ksu.edu/disease-management/management/Cultural_Control> ;
                                                                      rdfs:comment "Growing non-host crops in alternating seasons to break the disease cycle by depriving soilborne and residue-borne pathogens of their host. Particularly effective for take-all (requires 2+ years of non-cereal crops) and Fusarium foot rot. Less effective for wind-dispersed pathogens (rusts) whose inoculum arrives from distant sources." ;
                                                                      rdfs:label "Crop Rotation" .


###  https://gwsp.cs.ksu.edu/disease-management/management/FRAC_11_QoI
<https://gwsp.cs.ksu.edu/disease-management/management/FRAC_11_QoI> rdf:type owl:NamedIndividual ,
                                                                             <https://gwsp.cs.ksu.edu/disease-management/management/FRAC_Group> ;
                                                                    rdfs:comment "Quinone outside Inhibitors, commonly called strobilurins. Block mitochondrial respiration at Complex III. Broad-spectrum with strong preventive activity. Examples: azoxystrobin, pyraclostrobin, trifloxystrobin. High resistance risk; widespread resistance in Septoria and powdery mildew populations in some regions." ;
                                                                    rdfs:label "FRAC 11 â€“ QoI (Strobilurins)" .


###  https://gwsp.cs.ksu.edu/disease-management/management/FRAC_3_11_Premix
<https://gwsp.cs.ksu.edu/disease-management/management/FRAC_3_11_Premix> rdf:type owl:NamedIndividual ,
                                                                                  <https://gwsp.cs.ksu.edu/disease-management/management/FRAC_Group> ;
                                                                         rdfs:comment "A pre-mixed fungicide product combining FRAC 3 (DMI) and FRAC 11 (QoI) active ingredients. Provides broad-spectrum control with both systemic curative and preventive modes. Resistance monitoring is important for the QoI component." ;
                                                                         rdfs:label "FRAC 3 + 11 Premix" .


###  https://gwsp.cs.ksu.edu/disease-management/management/FRAC_3_7_Premix
<https://gwsp.cs.ksu.edu/disease-management/management/FRAC_3_7_Premix> rdf:type owl:NamedIndividual ,
                                                                                 <https://gwsp.cs.ksu.edu/disease-management/management/FRAC_Group> ;
                                                                        rdfs:comment "A pre-mixed fungicide product containing active ingredients from both FRAC 3 (DMI) and FRAC 7 (SDHI) groups. Combines the curative activity of triazoles with the preventive activity of SDHIs. The current standard for cereal disease management in many regions." ;
                                                                        rdfs:label "FRAC 3 + 7 Premix" .


###  https://gwsp.cs.ksu.edu/disease-management/management/FRAC_3_DMI
<https://gwsp.cs.ksu.edu/disease-management/management/FRAC_3_DMI> rdf:type owl:NamedIndividual ,
                                                                            <https://gwsp.cs.ksu.edu/disease-management/management/FRAC_Group> ;
                                                                   rdfs:comment "Demethylation Inhibitors (DMIs), also called triazoles or sterol biosynthesis inhibitors (SBIs). Inhibit ergosterol biosynthesis in fungal cell membranes. The most widely used fungicide class in cereals. Examples: propiconazole, tebuconazole, prothioconazole. Moderate resistance risk." ;
                                                                   rdfs:label "FRAC 3 â€“ DMI (Triazoles)" .


###  https://gwsp.cs.ksu.edu/disease-management/management/FRAC_7_SDHI
<https://gwsp.cs.ksu.edu/disease-management/management/FRAC_7_SDHI> rdf:type owl:NamedIndividual ,
                                                                             <https://gwsp.cs.ksu.edu/disease-management/management/FRAC_Group> ;
                                                                    rdfs:comment "Succinate Dehydrogenase Inhibitors. Block mitochondrial respiration at Complex II. Relatively new class with expanding use in wheat. Examples: fluxapyroxad, bixafen, pydiflumetofen. Medium to high resistance risk; should be mixed with other modes of action." ;
                                                                    rdfs:label "FRAC 7 â€“ SDHI" .


###  https://gwsp.cs.ksu.edu/disease-management/management/FRAC_M_Multi_Site
<https://gwsp.cs.ksu.edu/disease-management/management/FRAC_M_Multi_Site> rdf:type owl:NamedIndividual ,
                                                                                   <https://gwsp.cs.ksu.edu/disease-management/management/FRAC_Group> ;
                                                                          rdfs:comment "Fungicides that act on multiple biochemical sites simultaneously, making resistance development extremely unlikely. Examples: chlorothalonil (M5), mancozeb (M3). Protectant-only (no curative activity); must be applied before infection. Low resistance risk." ;
                                                                          rdfs:label "FRAC M â€“ Multi-site" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Flag_Leaf_Emergence
<https://gwsp.cs.ksu.edu/disease-management/management/Flag_Leaf_Emergence> rdf:type owl:NamedIndividual ,
                                                                                     <https://gwsp.cs.ksu.edu/disease-management/management/Application_Timing> ;
                                                                            rdfs:comment "Fungicide application at or just after flag leaf emergence (Feekes 8â€“9). The most common timing for foliar fungicides in wheat: protects the flag leaf, which contributes 60â€“80% of grain fill photosynthesis." ;
                                                                            rdfs:label "Flag Leaf Emergence" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Flowering
<https://gwsp.cs.ksu.edu/disease-management/management/Flowering> rdf:type owl:NamedIndividual ,
                                                                           <https://gwsp.cs.ksu.edu/disease-management/management/Application_Timing> ;
                                                                  rdfs:comment "Fungicide application at anthesis (Feekes 10.5.1). The critical timing for Fusarium head blight (scab) control: the infection window coincides with open florets during pollen shed." ;
                                                                  rdfs:label "Flowering" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Horizontal_Resistance
<https://gwsp.cs.ksu.edu/disease-management/management/Horizontal_Resistance> rdf:type owl:NamedIndividual ,
                                                                                       <https://gwsp.cs.ksu.edu/disease-management/management/Resistance_Type> ;
                                                                              rdfs:comment "Also called quantitative, race-nonspecific, or partial resistance. Conferred by multiple minor-effect genes that reduce disease severity without complete immunity. Effective against all races of a pathogen; provides durable, long-lasting protection. Slower epidemic development rather than outright prevention." ;
                                                                              rdfs:label "Horizontal Resistance" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Planting_Date_Adjustment
<https://gwsp.cs.ksu.edu/disease-management/management/Planting_Date_Adjustment> rdf:type owl:NamedIndividual ,
                                                                                          <https://gwsp.cs.ksu.edu/disease-management/management/Cultural_Control> ;
                                                                                 rdfs:comment "Shifting the planting date to avoid environmental conditions that favour infection. Delayed planting in winter wheat reduces fall infection by the wheat curl mite (Wheat Streak Mosaic Virus) and by early-season Septoria. Early planting increases fall tillering and biomass but can elevate disease risk." ;
                                                                                 rdfs:label "Planting Date Adjustment" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Pre_Flag_Leaf
<https://gwsp.cs.ksu.edu/disease-management/management/Pre_Flag_Leaf> rdf:type owl:NamedIndividual ,
                                                                               <https://gwsp.cs.ksu.edu/disease-management/management/Application_Timing> ;
                                                                      rdfs:comment "Fungicide application before flag leaf emergence (Feekes 7â€“8). Targets early-season foliar diseases (Septoria, early rust) to protect the upper canopy as it develops." ;
                                                                      rdfs:label "Pre-Flag Leaf" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Residue_Management
<https://gwsp.cs.ksu.edu/disease-management/management/Residue_Management> rdf:type owl:NamedIndividual ,
                                                                                    <https://gwsp.cs.ksu.edu/disease-management/management/Cultural_Control> ;
                                                                           rdfs:comment "Tillage or other practices that bury, remove, or accelerate decomposition of infected crop residue. Reduces surface inoculum for residue-borne pathogens (Septoria/Stagonospora, Fusarium head blight). Conservation tillage increases residue-borne disease pressure but benefits soil health â€” a trade-off that must be managed." ;
                                                                           rdfs:label "Residue Management" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Seeding_Rate_Adjustment
<https://gwsp.cs.ksu.edu/disease-management/management/Seeding_Rate_Adjustment> rdf:type owl:NamedIndividual ,
                                                                                         <https://gwsp.cs.ksu.edu/disease-management/management/Cultural_Control> ;
                                                                                rdfs:comment "Modifying the plant population density to affect canopy microclimate. Higher seeding rates produce denser canopies with greater humidity and leaf wetness duration, promoting foliar diseases. Lower seeding rates improve air circulation but may reduce yield potential." ;
                                                                                rdfs:label "Seeding Rate Adjustment" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Vertical_Resistance
<https://gwsp.cs.ksu.edu/disease-management/management/Vertical_Resistance> rdf:type owl:NamedIndividual ,
                                                                                     <https://gwsp.cs.ksu.edu/disease-management/management/Resistance_Type> ;
                                                                            rdfs:comment "Also called qualitative, race-specific, or major-gene resistance. Conferred by single major R-genes that interact in a gene-for-gene manner with pathogen avirulence genes. Provides complete or near-complete protection against specific pathogen races but can be overcome when new virulent races evolve. Often not durable over many years." ;
                                                                            rdfs:label "Vertical Resistance" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Volunteer_Destruction
<https://gwsp.cs.ksu.edu/disease-management/management/Volunteer_Destruction> rdf:type owl:NamedIndividual ,
                                                                                       <https://gwsp.cs.ksu.edu/disease-management/management/Cultural_Control> ;
                                                                              rdfs:comment "Destroying volunteer wheat plants that emerge between crop seasons. Volunteer wheat serves as the 'green bridge' that maintains obligate biotrophs (rusts) and virus-vectoring mites between crops. A critical cultural practice for Wheat Streak Mosaic Virus management." ;
                                                                              rdfs:label "Volunteer Destruction" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Barley_Yellow_Dwarf_Virus
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Barley_Yellow_Dwarf_Virus> rdf:type owl:NamedIndividual ,
                                                                                         <https://gwsp.cs.ksu.edu/disease-management/pathogen/Viral_Pathogen> ;
                                                                                rdfs:comment "A Luteovirus transmitted by cereal aphids (Rhopalosiphum padi, Sitobion avenae). Causes yellowing or reddening of flag leaves and reduced grain fill. Managed by insecticidal seed treatments to control aphid vectors and by resistant cultivars." ;
                                                                                rdfs:label "Barley Yellow Dwarf Virus" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Crop_Residue_Reservoir
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Crop_Residue_Reservoir> rdf:type owl:NamedIndividual ,
                                                                                      <https://gwsp.cs.ksu.edu/disease-management/pathogen/Inoculum_Reservoir> ;
                                                                             rdfs:comment "Above- and below-ground plant debris from previous crops. The primary inoculum reservoir for residue-borne pathogens (Septoria/Stagonospora, Fusarium graminearum). Tillage buries residue and accelerates decomposition, reducing surface inoculum." ;
                                                                             rdfs:label "Crop Residue" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Fusarium_graminearum
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Fusarium_graminearum> rdf:type owl:NamedIndividual ,
                                                                                    <https://gwsp.cs.ksu.edu/disease-management/pathogen/Fungal_Pathogen> ;
                                                                           rdfs:comment "The principal causal agent of Fusarium head blight (scab) in wheat. A necrotrophic fungus that survives on crop residue and produces the mycotoxin deoxynivalenol (DON/vomitoxin). Infection occurs at flowering when warm, humid conditions coincide with anthesis." ;
                                                                           rdfs:label "Fusarium graminearum" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Fusarium_spp
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Fusarium_spp> rdf:type owl:NamedIndividual ,
                                                                            <https://gwsp.cs.ksu.edu/disease-management/pathogen/Fungal_Pathogen> ;
                                                                   rdfs:comment "A complex of Fusarium species that cause foot rot, crown rot, and seedling blight in wheat. Soilborne; survives in soil and on crop debris. Favoured by wet, cool soil conditions at planting and by compacted or poorly drained soils." ;
                                                                   rdfs:label "Fusarium spp." .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Gaeumannomyces_graminis
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Gaeumannomyces_graminis> rdf:type owl:NamedIndividual ,
                                                                                       <https://gwsp.cs.ksu.edu/disease-management/pathogen/Fungal_Pathogen> ;
                                                                              rdfs:comment "The causal agent of take-all disease in wheat. A soilborne necrotrophic fungus that attacks roots and the stem base, causing blackening of the root system and 'whiteheads.' No effective fungicides; managed primarily by crop rotation and soil pH management." ;
                                                                              rdfs:label "Gaeumannomyces graminis var. tritici" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Insect_Vector_Reservoir
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Insect_Vector_Reservoir> rdf:type owl:NamedIndividual ,
                                                                                       <https://gwsp.cs.ksu.edu/disease-management/pathogen/Inoculum_Reservoir> ;
                                                                              rdfs:comment "An arthropod that acquires a pathogen from an infected plant and transmits it to a healthy plant. Primarily relevant for viral pathogens: the wheat curl mite vectors Wheat Streak Mosaic Virus; cereal aphids vector Barley Yellow Dwarf Virus. The vector itself serves as a mobile reservoir." ;
                                                                              rdfs:label "Insect Vector" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Living_Host_Reservoir
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Living_Host_Reservoir> rdf:type owl:NamedIndividual ,
                                                                                     <https://gwsp.cs.ksu.edu/disease-management/pathogen/Inoculum_Reservoir> ;
                                                                            rdfs:comment "Living plant tissue that maintains the pathogen between crop seasons. Obligate biotrophs (rust fungi) cannot survive without a living host; volunteer wheat, alternative hosts, and the 'green bridge' serve as reservoirs. Destroying volunteer wheat before planting is a key cultural control." ;
                                                                            rdfs:label "Living Host" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Machinery_Dispersal
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Machinery_Dispersal> rdf:type owl:NamedIndividual ,
                                                                                   <https://gwsp.cs.ksu.edu/disease-management/pathogen/Dispersal_Mechanism> ;
                                                                          rdfs:comment "The mechanical movement of pathogen-infested soil or residue by tillage implements, harvesters, or transport equipment. Relevant for soilborne pathogens (Fusarium, Rhizoctonia, Gaeumannomyces) that can be dragged between fields." ;
                                                                          rdfs:label "Machinery Dispersal" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Puccinia_graminis_tritici
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Puccinia_graminis_tritici> rdf:type owl:NamedIndividual ,
                                                                                         <https://gwsp.cs.ksu.edu/disease-management/pathogen/Fungal_Pathogen> ;
                                                                                rdfs:comment "The causal agent of wheat stem rust (black rust). An obligate biotroph with an alternate host (Berberis spp.). Historically the most destructive wheat disease; the Ug99 lineage remains a global threat to susceptible cultivars." ;
                                                                                rdfs:label "Puccinia graminis f. sp. tritici" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Puccinia_striiformis_tritici
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Puccinia_striiformis_tritici> rdf:type owl:NamedIndividual ,
                                                                                            <https://gwsp.cs.ksu.edu/disease-management/pathogen/Fungal_Pathogen> ;
                                                                                   rdfs:comment "The causal agent of wheat stripe rust (yellow rust). An obligate biotroph favoured by cool temperatures (10â€“15 degrees C) and high humidity. Aggressively adapted to a wide range of wheat cultivars through rapid evolution of new races." ;
                                                                                   rdfs:label "Puccinia striiformis f. sp. tritici" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Puccinia_triticina
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Puccinia_triticina> rdf:type owl:NamedIndividual ,
                                                                                  <https://gwsp.cs.ksu.edu/disease-management/pathogen/Fungal_Pathogen> ;
                                                                         rdfs:comment "The causal agent of wheat leaf rust (brown rust). An obligate biotroph that requires a living host to survive. Produces urediniospores for secondary spread by wind over long distances. The most common rust disease of wheat worldwide." ;
                                                                         rdfs:label "Puccinia triticina" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Rain_Splash_Dispersal
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Rain_Splash_Dispersal> rdf:type owl:NamedIndividual ,
                                                                                     <https://gwsp.cs.ksu.edu/disease-management/pathogen/Dispersal_Mechanism> ;
                                                                            rdfs:comment "The short-distance dispersal of spores by raindrop impact. The dominant mechanism for Septoria/Stagonospora leaf spot complex: rain splashes pycnidiospores from infected lower leaves upward through the canopy." ;
                                                                            rdfs:label "Rain-Splash Dispersal" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Rhizoctonia_cerealis
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Rhizoctonia_cerealis> rdf:type owl:NamedIndividual ,
                                                                                    <https://gwsp.cs.ksu.edu/disease-management/pathogen/Fungal_Pathogen> ;
                                                                           rdfs:comment "The causal agent of sharp eyespot in wheat. A soilborne necrotrophic fungus that infects the stem base, producing characteristic sharp-bordered, eye-shaped lesions. Favoured by high soil moisture and cool temperatures." ;
                                                                           rdfs:label "Rhizoctonia cerealis" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Seed_Reservoir
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Seed_Reservoir> rdf:type owl:NamedIndividual ,
                                                                              <https://gwsp.cs.ksu.edu/disease-management/pathogen/Inoculum_Reservoir> ;
                                                                     rdfs:comment "Infected seed as a carrier of seedborne pathogens. Tilletia spp. (bunt) contaminate the seed surface with teliospores; Ustilago tritici (loose smut) harbours dormant mycelium inside the embryo. Fungicidal seed treatment is the primary intervention." ;
                                                                     rdfs:label "Seed" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Seed_Transmission
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Seed_Transmission> rdf:type owl:NamedIndividual ,
                                                                                 <https://gwsp.cs.ksu.edu/disease-management/pathogen/Dispersal_Mechanism> ;
                                                                        rdfs:comment "The spread of pathogens via contaminated or infected seed. Relevant for bunt (surface-contaminated teliospores), loose smut (internal embryo infection), and some bacterial diseases. Clean, certified seed and seed treatment break this pathway." ;
                                                                        rdfs:label "Seed Transmission" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Septoria_Stagonospora_complex
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Septoria_Stagonospora_complex> rdf:type owl:NamedIndividual ,
                                                                                             <https://gwsp.cs.ksu.edu/disease-management/pathogen/Fungal_Pathogen> ;
                                                                                    rdfs:comment "A complex of fungal species including Zymoseptoria tritici (Septoria tritici blotch) and Parastagonospora nodorum (Stagonospora nodorum blotch) that cause the leaf spot complex in wheat. Survive on crop residue; rain-splash is the primary dispersal mechanism." ;
                                                                                    rdfs:label "Septoria/Stagonospora complex" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Soil_Reservoir
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Soil_Reservoir> rdf:type owl:NamedIndividual ,
                                                                              <https://gwsp.cs.ksu.edu/disease-management/pathogen/Inoculum_Reservoir> ;
                                                                     rdfs:comment "The soil matrix as a survival site for soilborne pathogens. Organisms like Gaeumannomyces, Rhizoctonia, and Fusarium spp. persist as mycelium or resting structures (chlamydospores, sclerotia) in the soil for months to years." ;
                                                                     rdfs:label "Soil" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Tilletia_spp
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Tilletia_spp> rdf:type owl:NamedIndividual ,
                                                                            <https://gwsp.cs.ksu.edu/disease-management/pathogen/Fungal_Pathogen> ;
                                                                   rdfs:comment "The causal agents of common bunt (stinking smut) of wheat, primarily T. tritici and T. laevis. Soilborne and seedborne; teliospores contaminate seed and infect at germination. Effectively managed by fungicidal seed treatment." ;
                                                                   rdfs:label "Tilletia spp." .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Ustilago_tritici
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Ustilago_tritici> rdf:type owl:NamedIndividual ,
                                                                                <https://gwsp.cs.ksu.edu/disease-management/pathogen/Fungal_Pathogen> ;
                                                                       rdfs:comment "The causal agent of loose smut of wheat. Infects the developing embryo within the grain during flowering; the mycelium remains dormant in the seed until the next season. Managed exclusively by systemic seed treatments that penetrate the embryo." ;
                                                                       rdfs:label "Ustilago tritici" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Vector_Transmission
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Vector_Transmission> rdf:type owl:NamedIndividual ,
                                                                                   <https://gwsp.cs.ksu.edu/disease-management/pathogen/Dispersal_Mechanism> ;
                                                                          rdfs:comment "The biological transmission of a pathogen by an arthropod vector. The vector acquires the pathogen during feeding on an infected plant and transmits it to a healthy plant during subsequent feeding. Primary pathway for viral diseases." ;
                                                                          rdfs:label "Vector Transmission" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Wheat_Streak_Mosaic_Virus
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Wheat_Streak_Mosaic_Virus> rdf:type owl:NamedIndividual ,
                                                                                         <https://gwsp.cs.ksu.edu/disease-management/pathogen/Viral_Pathogen> ;
                                                                                rdfs:comment "A Tritimovirus transmitted by the wheat curl mite (Aceria tosichella). Causes mosaic patterns, leaf streaking, and stunting. Managed by controlling volunteer wheat (the 'green bridge'), resistant cultivars, and delayed planting to avoid mite populations." ;
                                                                                rdfs:label "Wheat Streak Mosaic Virus" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Wind_Dispersal
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Wind_Dispersal> rdf:type owl:NamedIndividual ,
                                                                              <https://gwsp.cs.ksu.edu/disease-management/pathogen/Dispersal_Mechanism> ;
                                                                     rdfs:comment "The transport of airborne spores by wind currents. The primary dispersal mechanism for rust fungi (Puccinia spp.) and loose smut (Ustilago tritici). Wind enables long-distance, inter-regional spread of inoculum." ;
                                                                     rdfs:label "Wind Dispersal" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Xanthomonas_translucens
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Xanthomonas_translucens> rdf:type owl:NamedIndividual ,
                                                                                       <https://gwsp.cs.ksu.edu/disease-management/pathogen/Bacterial_Pathogen> ;
                                                                              rdfs:comment "The causal agent of bacterial leaf streak and black chaff in wheat. Enters through stomata; favoured by warm, humid conditions with wind-driven rain. No effective chemical control; managed by resistant cultivars and certified seed." ;
                                                                              rdfs:label "Xanthomonas translucens" .


