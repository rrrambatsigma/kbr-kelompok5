@prefix : <https://gwsp.cs.ksu.edu/disease-management/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://gwsp.cs.ksu.edu/disease-management/> .

<https://gwsp.cs.ksu.edu/disease-management/> rdf:type owl:Ontology ;
                                               <http://purl.org/dc/terms/creator> "GRIP, Kansas State University" ;
                                               <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                               <http://purl.org/dc/terms/title> "GRIP Disease Management Ontology"@en ;
                                               rdfs:comment "The master ontology for the GRIP Disease Management suite developed at Kansas State University. This umbrella ontology imports three domain modules â€” pathogen, disease, and management â€” and defines the shared root concept (Disease Management) that connects them. It also bridges to the GRIP Nutrient Management ontology for shared concepts (Environment, Cultivar, Crop Species, Management Practices)." ;
                                               rdfs:label "GRIP Disease Management Ontology" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://gwsp.cs.ksu.edu/disease-management/addresses_disease
:addresses_disease rdf:type owl:ObjectProperty ;
                   rdfs:domain :Disease_Management ;
                   rdfs:range <https://gwsp.cs.ksu.edu/disease-management/disease/Disease> ;
                   rdfs:comment "Links Disease Management to the Disease(s) it targets." ;
                   rdfs:label "addresses disease" .


###  https://gwsp.cs.ksu.edu/disease-management/implemented_through_strategy
:implemented_through_strategy rdf:type owl:ObjectProperty ;
                              rdfs:domain :Disease_Management ;
                              rdfs:range <https://gwsp.cs.ksu.edu/disease-management/management/Disease_Management_Strategy> ;
                              rdfs:comment "Links Disease Management to the strategies (chemical, cultural, genetic) deployed to control disease." ;
                              rdfs:label "implemented through strategy" .


###  https://gwsp.cs.ksu.edu/disease-management/involves_host
:involves_host rdf:type owl:ObjectProperty ;
               rdfs:domain :Disease_Management ;
               rdfs:range <https://gwsp.cs.ksu.edu/nutrient-management/nutrient/Cultivar> ;
               rdfs:comment "Links Disease Management to the Cultivar being protected. Bridges to the nutrient module for shared cultivar concepts." ;
               rdfs:label "involves host" .


###  https://gwsp.cs.ksu.edu/disease-management/involves_pathogen
:involves_pathogen rdf:type owl:ObjectProperty ;
                   rdfs:domain :Disease_Management ;
                   rdfs:range <https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen> ;
                   rdfs:comment "Links Disease Management to the Pathogen(s) causing the diseases being managed." ;
                   rdfs:label "involves pathogen" .


###  https://gwsp.cs.ksu.edu/disease-management/occurs_in_environment
:occurs_in_environment rdf:type owl:ObjectProperty ;
                       rdfs:domain :Disease_Management ;
                       rdfs:range <https://gwsp.cs.ksu.edu/nutrient-management/environment/Environment> ;
                       rdfs:comment "Links Disease Management to the Environment that constrains disease development and management decisions. Bridges to the nutrient management environment module." ;
                       rdfs:label "occurs in environment" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/affects_host
<https://gwsp.cs.ksu.edu/disease-management/disease/affects_host> rdf:type owl:ObjectProperty ;
                                                                  rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease> ;
                                                                  rdfs:range <https://gwsp.cs.ksu.edu/nutrient-management/nutrient/Cultivar> ;
                                                                  rdfs:comment "Links a Disease to the Cultivar (host) it infects. Represents the host vertex of the disease triangle." ;
                                                                  rdfs:label "affects host" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/caused_by
<https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> rdf:type owl:ObjectProperty ;
                                                               rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease> ;
                                                               rdfs:range <https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen> ;
                                                               rdfs:comment "Links a Disease to the Pathogen (causal organism) that produces it. Every disease has exactly one primary causal agent, though disease complexes may involve multiple species." ;
                                                               rdfs:label "caused by" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/causes_yield_loss
<https://gwsp.cs.ksu.edu/disease-management/disease/causes_yield_loss> rdf:type owl:ObjectProperty ;
                                                                       rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease> ;
                                                                       rdfs:range <https://gwsp.cs.ksu.edu/disease-management/disease/Yield_Loss> ;
                                                                       rdfs:comment "Links a Disease to the Yield Loss it produces when left unmanaged in a susceptible cultivar." ;
                                                                       rdfs:label "causes yield loss" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/conditioned_by
<https://gwsp.cs.ksu.edu/disease-management/disease/conditioned_by> rdf:type owl:ObjectProperty ;
                                                                    rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease> ;
                                                                    rdfs:range <https://gwsp.cs.ksu.edu/nutrient-management/environment/Environment> ;
                                                                    rdfs:comment "Links a Disease to the Environment that determines whether conditions are favourable for infection. Represents the environment vertex of the disease triangle." ;
                                                                    rdfs:label "conditioned by" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/for_cultivar
<https://gwsp.cs.ksu.edu/disease-management/disease/for_cultivar> rdf:type owl:ObjectProperty ;
                                                                  rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Resistance_Rating> ;
                                                                  rdfs:range <https://gwsp.cs.ksu.edu/nutrient-management/nutrient/Cultivar> ;
                                                                  rdfs:comment "Links a Disease Resistance Rating to the specific cultivar being evaluated." ;
                                                                  rdfs:label "for cultivar" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/for_disease
<https://gwsp.cs.ksu.edu/disease-management/disease/for_disease> rdf:type owl:ObjectProperty ;
                                                                 rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Resistance_Rating> ;
                                                                 rdfs:range <https://gwsp.cs.ksu.edu/disease-management/disease/Disease> ;
                                                                 rdfs:comment "Links a Disease Resistance Rating to the specific disease against which resistance is being rated." ;
                                                                 rdfs:label "for disease" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/has_assessment
<https://gwsp.cs.ksu.edu/disease-management/disease/has_assessment> rdf:type owl:ObjectProperty ;
                                                                    rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease> ;
                                                                    rdfs:range <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Assessment> ;
                                                                    rdfs:comment "Links a Disease to its quantitative assessment (incidence, severity, or rating score) observed in a specific trial." ;
                                                                    rdfs:label "has assessment" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/has_environment_component
<https://gwsp.cs.ksu.edu/disease-management/disease/has_environment_component> rdf:type owl:ObjectProperty ;
                                                                               rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Triangle> ;
                                                                               rdfs:range <https://gwsp.cs.ksu.edu/nutrient-management/environment/Environment> ;
                                                                               rdfs:comment "Links the Disease Triangle to its environment vertex â€” the weather and soil conditions that determine infection favourability." ;
                                                                               rdfs:label "has environment component" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/has_host_component
<https://gwsp.cs.ksu.edu/disease-management/disease/has_host_component> rdf:type owl:ObjectProperty ;
                                                                        rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Triangle> ;
                                                                        rdfs:range <https://gwsp.cs.ksu.edu/nutrient-management/nutrient/Cultivar> ;
                                                                        rdfs:comment "Links the Disease Triangle to its host vertex â€” the cultivar whose susceptibility is being evaluated." ;
                                                                        rdfs:label "has host component" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/has_pathogen_component
<https://gwsp.cs.ksu.edu/disease-management/disease/has_pathogen_component> rdf:type owl:ObjectProperty ;
                                                                            rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Triangle> ;
                                                                            rdfs:range <https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen> ;
                                                                            rdfs:comment "Links the Disease Triangle to its pathogen vertex â€” the organism whose virulence and inoculum pressure are assessed." ;
                                                                            rdfs:label "has pathogen component" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/has_resistance_level
<https://gwsp.cs.ksu.edu/disease-management/disease/has_resistance_level> rdf:type owl:ObjectProperty ;
                                                                          rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Resistance_Rating> ;
                                                                          rdfs:range <https://gwsp.cs.ksu.edu/disease-management/disease/Resistance_Level> ;
                                                                          rdfs:comment "Links a Disease Resistance Rating to its ordinal category on the standard resistance scale." ;
                                                                          rdfs:label "has resistance level" .


###  https://gwsp.cs.ksu.edu/disease-management/management/applies_fungicide
<https://gwsp.cs.ksu.edu/disease-management/management/applies_fungicide> rdf:type owl:ObjectProperty ;
                                                                          rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Chemical_Control> ;
                                                                          rdfs:range <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> ;
                                                                          rdfs:comment "Links Chemical Control to the Fungicide product applied." ;
                                                                          rdfs:label "applies fungicide" .


###  https://gwsp.cs.ksu.edu/disease-management/management/disrupts
<https://gwsp.cs.ksu.edu/disease-management/management/disrupts> rdf:type owl:ObjectProperty ;
                                                                 rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Disease_Management_Strategy> ;
                                                                 rdfs:range <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Triangle> ;
                                                                 rdfs:comment "Links a Disease Management Strategy to the vertex or vertices of the Disease Triangle it acts upon. Chemical control disrupts the pathogen vertex; cultural control disrupts the environment and/or pathogen vertices; host resistance disrupts the host vertex." ;
                                                                 rdfs:label "disrupts" .


###  https://gwsp.cs.ksu.edu/disease-management/management/evaluated_in
<https://gwsp.cs.ksu.edu/disease-management/management/evaluated_in> rdf:type owl:ObjectProperty ;
                                                                     rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Host_Resistance> ;
                                                                     rdfs:range <https://gwsp.cs.ksu.edu/nutrient-management/nutrient/Cultivar> ;
                                                                     rdfs:comment "Links Host Resistance to the Cultivar in which it has been evaluated and characterised." ;
                                                                     rdfs:label "evaluated in" .


###  https://gwsp.cs.ksu.edu/disease-management/management/has_active_ingredient
<https://gwsp.cs.ksu.edu/disease-management/management/has_active_ingredient> rdf:type owl:ObjectProperty ;
                                                                              rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> ;
                                                                              rdfs:range <https://gwsp.cs.ksu.edu/disease-management/management/Active_Ingredient> ;
                                                                              rdfs:comment "Links a Fungicide product to its Active Ingredient(s)." ;
                                                                              rdfs:label "has active ingredient" .


###  https://gwsp.cs.ksu.edu/disease-management/management/has_application_timing
<https://gwsp.cs.ksu.edu/disease-management/management/has_application_timing> rdf:type owl:ObjectProperty ;
                                                                               rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> ;
                                                                               rdfs:range <https://gwsp.cs.ksu.edu/disease-management/management/Application_Timing> ;
                                                                               rdfs:comment "Links a Fungicide application to the growth stage at which it is applied." ;
                                                                               rdfs:label "has application timing" .


###  https://gwsp.cs.ksu.edu/disease-management/management/has_frac_group
<https://gwsp.cs.ksu.edu/disease-management/management/has_frac_group> rdf:type owl:ObjectProperty ;
                                                                       rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> ;
                                                                       rdfs:range <https://gwsp.cs.ksu.edu/disease-management/management/FRAC_Group> ;
                                                                       rdfs:comment "Links a Fungicide or Active Ingredient to its FRAC mode-of-action classification." ;
                                                                       rdfs:label "has FRAC group" .


###  https://gwsp.cs.ksu.edu/disease-management/management/has_harvest_restriction
<https://gwsp.cs.ksu.edu/disease-management/management/has_harvest_restriction> rdf:type owl:ObjectProperty ;
                                                                                rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> ;
                                                                                rdfs:range <https://gwsp.cs.ksu.edu/disease-management/management/Harvest_Restriction> ;
                                                                                rdfs:comment "Links a Fungicide to its Harvest Restriction (pre-harvest interval)." ;
                                                                                rdfs:label "has harvest restriction" .


###  https://gwsp.cs.ksu.edu/disease-management/management/has_resistance_type
<https://gwsp.cs.ksu.edu/disease-management/management/has_resistance_type> rdf:type owl:ObjectProperty ;
                                                                            rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Host_Resistance> ;
                                                                            rdfs:range <https://gwsp.cs.ksu.edu/disease-management/management/Resistance_Type> ;
                                                                            rdfs:comment "Links Host Resistance to its genetic category (vertical or horizontal)." ;
                                                                            rdfs:label "has resistance type" .


###  https://gwsp.cs.ksu.edu/disease-management/management/targets
<https://gwsp.cs.ksu.edu/disease-management/management/targets> rdf:type owl:ObjectProperty ;
                                                                rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Disease_Management_Strategy> ;
                                                                rdfs:range <https://gwsp.cs.ksu.edu/disease-management/disease/Disease> ;
                                                                rdfs:comment "Links a Disease Management Strategy to the Disease it aims to control." ;
                                                                rdfs:label "targets" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/dispersed_by
<https://gwsp.cs.ksu.edu/disease-management/pathogen/dispersed_by> rdf:type owl:ObjectProperty ;
                                                                   rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen> ;
                                                                   rdfs:range <https://gwsp.cs.ksu.edu/disease-management/pathogen/Dispersal_Mechanism> ;
                                                                   rdfs:comment "Links a Pathogen to the Dispersal Mechanism that transports its inoculum from the reservoir to a new host. Determines the spatial scale and timing of epidemic development." ;
                                                                   rdfs:label "dispersed by" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/favoured_by
<https://gwsp.cs.ksu.edu/disease-management/pathogen/favoured_by> rdf:type owl:ObjectProperty ;
                                                                  rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen> ;
                                                                  rdfs:range <https://gwsp.cs.ksu.edu/disease-management/pathogen/Infection_Condition> ;
                                                                  rdfs:comment "Links a Pathogen to the environmental conditions (temperature, humidity, rainfall) that promote its development and infection success. Represents the pathogen-environment edge of the disease triangle." ;
                                                                  rdfs:label "favoured by" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/survives_in
<https://gwsp.cs.ksu.edu/disease-management/pathogen/survives_in> rdf:type owl:ObjectProperty ;
                                                                  rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen> ;
                                                                  rdfs:range <https://gwsp.cs.ksu.edu/disease-management/pathogen/Inoculum_Reservoir> ;
                                                                  rdfs:comment "Links a Pathogen to the Inoculum Reservoir in which it persists between crop seasons. Understanding survival sites is the basis for cultural control strategies." ;
                                                                  rdfs:label "survives in" .


#################################################################
#    Data properties
#################################################################

###  https://gwsp.cs.ksu.edu/disease-management/disease/has_incidence_percent
<https://gwsp.cs.ksu.edu/disease-management/disease/has_incidence_percent> rdf:type owl:DatatypeProperty ;
                                                                           rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Incidence> ;
                                                                           rdfs:range xsd:float ;
                                                                           rdfs:comment "The measured disease incidence as a percentage (0â€“100)." ;
                                                                           rdfs:label "has incidence percent" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/has_rating_score
<https://gwsp.cs.ksu.edu/disease-management/disease/has_rating_score> rdf:type owl:DatatypeProperty ;
                                                                      rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Rating> ;
                                                                      rdfs:range xsd:integer ;
                                                                      rdfs:comment "The disease rating on a standardised ordinal scale (e.g., 0â€“9)." ;
                                                                      rdfs:label "has rating score" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/has_severity_percent
<https://gwsp.cs.ksu.edu/disease-management/disease/has_severity_percent> rdf:type owl:DatatypeProperty ;
                                                                          rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Severity> ;
                                                                          rdfs:range xsd:float ;
                                                                          rdfs:comment "The measured disease severity as a percentage of tissue area affected (0â€“100)." ;
                                                                          rdfs:label "has severity percent" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/has_yield_loss_percent
<https://gwsp.cs.ksu.edu/disease-management/disease/has_yield_loss_percent> rdf:type owl:DatatypeProperty ;
                                                                            rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/disease/Yield_Loss> ;
                                                                            rdfs:range xsd:float ;
                                                                            rdfs:comment "The estimated yield reduction caused by disease, expressed as a percentage of disease-free yield potential." ;
                                                                            rdfs:label "has yield loss percent" .


###  https://gwsp.cs.ksu.edu/disease-management/management/has_efficacy_rating
<https://gwsp.cs.ksu.edu/disease-management/management/has_efficacy_rating> rdf:type owl:DatatypeProperty ;
                                                                            rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> ;
                                                                            rdfs:range xsd:string ;
                                                                            rdfs:comment "A qualitative or semi-quantitative rating of the fungicide's effectiveness against a specific disease, typically expressed as Excellent, Good, Fair, Poor, or Not Effective." ;
                                                                            rdfs:label "has efficacy rating" .


###  https://gwsp.cs.ksu.edu/disease-management/management/has_phi_days
<https://gwsp.cs.ksu.edu/disease-management/management/has_phi_days> rdf:type owl:DatatypeProperty ;
                                                                     rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> ;
                                                                     rdfs:range xsd:integer ;
                                                                     rdfs:comment "The pre-harvest interval in days for a specific fungicide product." ;
                                                                     rdfs:label "has PHI days" .


###  https://gwsp.cs.ksu.edu/disease-management/management/has_product_name
<https://gwsp.cs.ksu.edu/disease-management/management/has_product_name> rdf:type owl:DatatypeProperty ;
                                                                         rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> ;
                                                                         rdfs:range xsd:string ;
                                                                         rdfs:comment "The commercial trade name of a fungicide product as registered with the EPA." ;
                                                                         rdfs:label "has product name" .


###  https://gwsp.cs.ksu.edu/disease-management/management/has_rate_max_fl_oz_per_acre
<https://gwsp.cs.ksu.edu/disease-management/management/has_rate_max_fl_oz_per_acre> rdf:type owl:DatatypeProperty ;
                                                                                    rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> ;
                                                                                    rdfs:range xsd:float ;
                                                                                    rdfs:comment "The maximum labelled application rate in fluid ounces per acre." ;
                                                                                    rdfs:label "has rate max (fl oz/acre)" .


###  https://gwsp.cs.ksu.edu/disease-management/management/has_rate_min_fl_oz_per_acre
<https://gwsp.cs.ksu.edu/disease-management/management/has_rate_min_fl_oz_per_acre> rdf:type owl:DatatypeProperty ;
                                                                                    rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> ;
                                                                                    rdfs:range xsd:float ;
                                                                                    rdfs:comment "The minimum labelled application rate in fluid ounces per acre." ;
                                                                                    rdfs:label "has rate min (fl oz/acre)" .


###  https://gwsp.cs.ksu.edu/disease-management/management/has_threshold_severity
<https://gwsp.cs.ksu.edu/disease-management/management/has_threshold_severity> rdf:type owl:DatatypeProperty ;
                                                                               rdfs:domain <https://gwsp.cs.ksu.edu/disease-management/management/Economic_Threshold> ;
                                                                               rdfs:range xsd:float ;
                                                                               rdfs:comment "The disease severity percentage at which treatment becomes economically justified." ;
                                                                               rdfs:label "has threshold severity" .


#################################################################
#    Classes
#################################################################

###  https://gwsp.cs.ksu.edu/disease-management/Disease_Management
:Disease_Management rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :addresses_disease ;
                                      owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/disease/Disease>
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :implemented_through_strategy ;
                                      owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/management/Disease_Management_Strategy>
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :involves_host ;
                                      owl:someValuesFrom <https://gwsp.cs.ksu.edu/nutrient-management/nutrient/Cultivar>
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :involves_pathogen ;
                                      owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen>
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :occurs_in_environment ;
                                      owl:someValuesFrom <https://gwsp.cs.ksu.edu/nutrient-management/environment/Environment>
                                    ] ;
                    rdfs:comment "The overarching discipline of preventing, diagnosing, and controlling plant diseases to protect crop yield and quality. Disease management integrates knowledge of the pathogen (biology, survival, dispersal), the disease (symptoms, assessment, yield impact), and the available management strategies (chemical, cultural, genetic) within the constraints of the environment and the host genotype. This root concept connects all three modules of the disease management ontology and bridges to the nutrient management ontology for shared environmental and crop concepts." ;
                    rdfs:label "Disease Management" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Bacterial_Disease
<https://gwsp.cs.ksu.edu/disease-management/disease/Bacterial_Disease> rdf:type owl:Class ;
                                                                       rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/disease/Disease> ;
                                                                       rdfs:comment "A plant disease caused by a bacterial pathogen. Generally less common than fungal diseases in wheat but important in broader crop systems. No curative chemical treatments comparable to fungicides; managed primarily through copper applications, resistant cultivars, and cultural practices." ;
                                                                       rdfs:label "Bacterial Disease" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Disease
<https://gwsp.cs.ksu.edu/disease-management/disease/Disease> rdf:type owl:Class ;
                                                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/disease/affects_host> ;
                                                                               owl:someValuesFrom <https://gwsp.cs.ksu.edu/nutrient-management/nutrient/Cultivar>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/disease/caused_by> ;
                                                                               owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/disease/causes_yield_loss> ;
                                                                               owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/disease/Yield_Loss>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/disease/conditioned_by> ;
                                                                               owl:someValuesFrom <https://gwsp.cs.ksu.edu/nutrient-management/environment/Environment>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/disease/has_assessment> ;
                                                                               owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Assessment>
                                                                             ] ;
                                                             rdfs:comment "A pathological condition of a plant characterised by a set of symptoms that result from the interaction between a susceptible host, a virulent pathogen, and a favourable environment (the disease triangle). A disease is distinct from the pathogen that causes it: Leaf Rust is a disease; Puccinia triticina is the pathogen. This distinction allows the same pathogen to cause different diseases under different conditions, and the same disease symptoms to sometimes result from different pathogens." ;
                                                             rdfs:label "Disease" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Assessment
<https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Assessment> rdf:type owl:Class ;
                                                                        rdfs:comment "The quantitative or qualitative evaluation of disease presence and severity on a crop. Disease assessment provides the data needed to make treatment decisions, evaluate cultivar resistance, and estimate yield loss. The two standard metrics are incidence and severity." ;
                                                                        rdfs:label "Disease Assessment" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Incidence
<https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Incidence> rdf:type owl:Class ;
                                                                       rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Assessment> ;
                                                                       rdfs:comment "The proportion of plant units (plants, tillers, leaves, or heads) that show any disease symptoms, expressed as a percentage (0â€“100%). Incidence measures the spatial spread of disease within a field or plot but does not indicate how severely individual plants are affected." ;
                                                                       rdfs:label "Disease Incidence" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Rating
<https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Rating> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Assessment> ;
                                                                    rdfs:comment "An ordinal classification of overall disease reaction, typically on a 0â€“9 or 1â€“9 scale, used in disease nurseries and variety trials to summarise combined incidence and severity into a single score for cultivar comparison." ;
                                                                    rdfs:label "Disease Rating" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Resistance_Rating
<https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Resistance_Rating> rdf:type owl:Class ;
                                                                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                                 owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/disease/for_cultivar> ;
                                                                                                 owl:someValuesFrom <https://gwsp.cs.ksu.edu/nutrient-management/nutrient/Cultivar>
                                                                                               ] ,
                                                                                               [ rdf:type owl:Restriction ;
                                                                                                 owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/disease/for_disease> ;
                                                                                                 owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/disease/Disease>
                                                                                               ] ,
                                                                                               [ rdf:type owl:Restriction ;
                                                                                                 owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/disease/has_resistance_level> ;
                                                                                                 owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/disease/Resistance_Level>
                                                                                               ] ;
                                                                               rdfs:comment "An evaluation of a specific cultivar's genetic resistance to a specific disease, expressed on a standardised ordinal scale. This entity connects three things: the cultivar (who), the disease (which disease), and the resistance level (how resistant). A single cultivar may have different ratings for different diseases." ;
                                                                               rdfs:label "Disease Resistance Rating" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Severity
<https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Severity> rdf:type owl:Class ;
                                                                      rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Assessment> ;
                                                                      rdfs:comment "The proportion of plant tissue area that is visibly affected by disease symptoms, expressed as a percentage (0â€“100%). Severity is typically estimated using standard area diagrams or visual rating scales. It is the more informative metric for predicting yield loss because it reflects the actual amount of photosynthetic tissue destroyed." ;
                                                                      rdfs:label "Disease Severity" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Triangle
<https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Triangle> rdf:type owl:Class ;
                                                                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                        owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/disease/has_environment_component> ;
                                                                                        owl:someValuesFrom <https://gwsp.cs.ksu.edu/nutrient-management/environment/Environment>
                                                                                      ] ,
                                                                                      [ rdf:type owl:Restriction ;
                                                                                        owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/disease/has_host_component> ;
                                                                                        owl:someValuesFrom <https://gwsp.cs.ksu.edu/nutrient-management/nutrient/Cultivar>
                                                                                      ] ,
                                                                                      [ rdf:type owl:Restriction ;
                                                                                        owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/disease/has_pathogen_component> ;
                                                                                        owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen>
                                                                                      ] ;
                                                                      rdfs:comment "The foundational conceptual model of plant pathology: disease occurs when and only when three conditions are simultaneously met â€” (1) a susceptible Host is present, (2) a virulent Pathogen is present with sufficient inoculum, and (3) the Environment is favourable for infection and disease development. If any one vertex is absent or unfavourable, disease does not occur. Each management strategy (host resistance, chemical control, cultural practice) works by disrupting one or more vertices of the triangle." ;
                                                                      rdfs:label "Disease Triangle" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Fungal_Disease
<https://gwsp.cs.ksu.edu/disease-management/disease/Fungal_Disease> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/disease/Disease> ;
                                                                    rdfs:comment "A plant disease caused by a fungal pathogen. The largest category of crop diseases; includes rusts, smuts, blights, rots, and leaf spots. Fungal diseases are the primary targets of chemical control (fungicides) and host resistance breeding." ;
                                                                    rdfs:label "Fungal Disease" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Resistance_Level
<https://gwsp.cs.ksu.edu/disease-management/disease/Resistance_Level> rdf:type owl:Class ;
                                                                      rdfs:comment "An ordinal category on the standard 5-point resistance scale used in wheat disease nurseries and variety performance trials. Ranges from Resistant (minimal symptom development) to Susceptible (severe symptom development and yield loss)." ;
                                                                      rdfs:label "Resistance Level" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Viral_Disease
<https://gwsp.cs.ksu.edu/disease-management/disease/Viral_Disease> rdf:type owl:Class ;
                                                                   rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/disease/Disease> ;
                                                                   rdfs:comment "A plant disease caused by a viral pathogen. Characterised by mosaic patterns, stunting, and chlorosis. No curative treatments exist; management relies entirely on prevention: resistant cultivars, vector control (insecticide seed treatments), elimination of the green bridge, and certified virus-free seed." ;
                                                                   rdfs:label "Viral Disease" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Fungal_Disease
<https://gwsp.cs.ksu.edu/disease-management/disease/Wheat_Fungal_Disease> rdf:type owl:Class ;
                                                                          rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/disease/Fungal_Disease> ;
                                                                          rdfs:comment "A fungal disease that affects wheat (Triticum aestivum). This subclass groups the ten major fungal diseases of wheat modeled in this ontology. While the ontology is wheat-primary, the parent class (Fungal_Disease) is crop-agnostic and extensible." ;
                                                                          rdfs:label "Wheat Fungal Disease" .


###  https://gwsp.cs.ksu.edu/disease-management/disease/Yield_Loss
<https://gwsp.cs.ksu.edu/disease-management/disease/Yield_Loss> rdf:type owl:Class ;
                                                                rdfs:comment "The reduction in crop yield attributable to disease, expressed as a percentage of the disease-free yield potential or as an absolute quantity (kg/ha). Yield loss is the economic consequence of disease that drives management decisions: treatment is justified when the cost of yield loss exceeds the cost of control." ;
                                                                rdfs:label "Yield Loss" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Active_Ingredient
<https://gwsp.cs.ksu.edu/disease-management/management/Active_Ingredient> rdf:type owl:Class ;
                                                                          rdfs:comment "The specific chemical compound within a fungicide product that is responsible for its biological activity against the target pathogen. A single commercial product may contain one or more active ingredients, often from different FRAC groups to broaden the spectrum and delay resistance development." ;
                                                                          rdfs:label "Active Ingredient" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Application_Timing
<https://gwsp.cs.ksu.edu/disease-management/management/Application_Timing> rdf:type owl:Class ;
                                                                           rdfs:comment "The crop growth stage at which a fungicide is applied. Timing relative to infection is critical for efficacy: preventive applications must occur before spore germination; curative applications must occur within 24â€“72 hours after infection. Growth stages reuse concepts from the nutrient management ontology where applicable." ;
                                                                           rdfs:label "Application Timing" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Chemical_Control
<https://gwsp.cs.ksu.edu/disease-management/management/Chemical_Control> rdf:type owl:Class ;
                                                                         rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/management/Disease_Management_Strategy> ,
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/management/applies_fungicide> ;
                                                                                           owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide>
                                                                                         ] ;
                                                                         rdfs:comment "Disease management through the application of synthetic or biological chemical compounds (fungicides) that kill or inhibit pathogen growth. Chemical control disrupts the pathogen vertex of the disease triangle by directly reducing pathogen viability or preventing infection. Effective but must be integrated with other strategies to manage fungicide resistance." ;
                                                                         rdfs:label "Chemical Control" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Cultural_Control
<https://gwsp.cs.ksu.edu/disease-management/management/Cultural_Control> rdf:type owl:Class ;
                                                                         rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/management/Disease_Management_Strategy> ;
                                                                         rdfs:comment "Disease management through agronomic practices that reduce pathogen inoculum, break disease cycles, or create conditions unfavourable for infection â€” without applying chemical products. Cultural control disrupts the environment and/or pathogen vertices of the disease triangle. Often the most sustainable and cost-effective approach, especially for soilborne diseases where chemical options are limited." ;
                                                                         rdfs:label "Cultural Control" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Disease_Management_Strategy
<https://gwsp.cs.ksu.edu/disease-management/management/Disease_Management_Strategy> rdf:type owl:Class ;
                                                                                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/management/disrupts> ;
                                                                                                      owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/disease/Disease_Triangle>
                                                                                                    ] ,
                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/management/targets> ;
                                                                                                      owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/disease/Disease>
                                                                                                    ] ;
                                                                                    rdfs:comment "An intervention that prevents, reduces, or eliminates plant disease by disrupting one or more vertices of the disease triangle. Integrated disease management (IDM) combines multiple strategies â€” chemical, cultural, and genetic â€” to achieve durable control while minimising fungicide resistance risk and environmental impact." ;
                                                                                    rdfs:label "Disease Management Strategy" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Economic_Threshold
<https://gwsp.cs.ksu.edu/disease-management/management/Economic_Threshold> rdf:type owl:Class ;
                                                                           rdfs:comment "The disease severity or incidence level at which the cost of yield loss from the disease exceeds the cost of applying a fungicide treatment. Below the threshold, the disease is present but treatment is not economically justified. The threshold depends on fungicide cost, application cost, expected yield, grain price, and the efficacy of the fungicide against the specific disease." ;
                                                                           rdfs:label "Economic Threshold" .


###  https://gwsp.cs.ksu.edu/disease-management/management/FRAC_Group
<https://gwsp.cs.ksu.edu/disease-management/management/FRAC_Group> rdf:type owl:Class ;
                                                                   rdfs:comment "A classification category defined by the Fungicide Resistance Action Committee (FRAC) that groups fungicide active ingredients by their biochemical mode of action. Products within the same FRAC group share the same resistance risk: repeated use of a single group selects for resistant pathogen populations. Alternating or mixing FRAC groups is a core resistance management strategy." ;
                                                                   rdfs:label "FRAC Group" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Foliar_Fungicide
<https://gwsp.cs.ksu.edu/disease-management/management/Foliar_Fungicide> rdf:type owl:Class ;
                                                                         rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> ;
                                                                         rdfs:comment "A fungicide applied to the crop canopy as a spray to control foliar and head diseases (rusts, leaf spots, head blight). Applied at specific growth stages (flag leaf, flowering) using ground or aerial equipment. Subject to pre-harvest intervals that restrict the minimum time between application and harvest." ;
                                                                         rdfs:label "Foliar Fungicide" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Fungicide
<https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> rdf:type owl:Class ;
                                                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/management/has_active_ingredient> ;
                                                                                    owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/management/Active_Ingredient>
                                                                                  ] ,
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/management/has_application_timing> ;
                                                                                    owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/management/Application_Timing>
                                                                                  ] ,
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/management/has_frac_group> ;
                                                                                    owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/management/FRAC_Group>
                                                                                  ] ;
                                                                  rdfs:comment "A chemical product applied to control fungal diseases. Each fungicide contains one or more active ingredients, belongs to a FRAC mode-of-action group, and is applied at a specified rate and growth stage. Fungicides may be preventive (protectant), curative, or eradicant depending on their mode of action and timing relative to infection." ;
                                                                  rdfs:label "Fungicide" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Harvest_Restriction
<https://gwsp.cs.ksu.edu/disease-management/management/Harvest_Restriction> rdf:type owl:Class ;
                                                                            rdfs:comment "The minimum number of days (pre-harvest interval, PHI) that must elapse between the last fungicide application and crop harvest. Required by regulatory agencies to ensure pesticide residues decline to safe levels before grain enters the food or feed supply. PHI values are product-specific and stated on the fungicide label." ;
                                                                            rdfs:label "Harvest Restriction" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Host_Resistance
<https://gwsp.cs.ksu.edu/disease-management/management/Host_Resistance> rdf:type owl:Class ;
                                                                        rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/management/Disease_Management_Strategy> ,
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/management/evaluated_in> ;
                                                                                          owl:someValuesFrom <https://gwsp.cs.ksu.edu/nutrient-management/nutrient/Cultivar>
                                                                                        ] ,
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/management/has_resistance_type> ;
                                                                                          owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/management/Resistance_Type>
                                                                                        ] ;
                                                                        rdfs:comment "Disease management through the deployment of genetically resistant crop cultivars. Host resistance disrupts the host vertex of the disease triangle by reducing the plant's susceptibility to pathogen infection or colonisation. The most cost-effective and environmentally sound management strategy; requires no additional inputs once the resistant cultivar is selected." ;
                                                                        rdfs:label "Host Resistance" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Resistance_Type
<https://gwsp.cs.ksu.edu/disease-management/management/Resistance_Type> rdf:type owl:Class ;
                                                                        rdfs:comment "The genetic and mechanistic category of host resistance. The two fundamental types â€” vertical and horizontal â€” differ in their genetic basis, specificity, durability, and breeding implications." ;
                                                                        rdfs:label "Resistance Type" .


###  https://gwsp.cs.ksu.edu/disease-management/management/Seed_Treatment
<https://gwsp.cs.ksu.edu/disease-management/management/Seed_Treatment> rdf:type owl:Class ;
                                                                       rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/management/Fungicide> ;
                                                                       rdfs:comment "A fungicide applied directly to seed before planting to protect against seedborne and soilborne pathogens during germination and early seedling growth. Includes contact treatments (surface protection) and systemic treatments (absorbed and translocated within the seedling). Essential for bunt, smut, and seedling blight control." ;
                                                                       rdfs:label "Seed Treatment" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Bacterial_Pathogen
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Bacterial_Pathogen> rdf:type owl:Class ;
                                                                         rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen> ;
                                                                         rdfs:comment "A prokaryotic microorganism that causes disease in plants. Bacterial pathogens typically enter through natural openings (stomata, lenticels) or wounds, and often require free water on plant surfaces for infection. Managed primarily through copper-based bactericides, resistant cultivars, and cultural practices. Less common than fungal diseases in wheat but important in other crop systems." ;
                                                                         rdfs:label "Bacterial Pathogen" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Dispersal_Mechanism
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Dispersal_Mechanism> rdf:type owl:Class ;
                                                                          rdfs:comment "A physical or biological process by which pathogen inoculum (spores, cells, viral particles) is transported from its reservoir to a new host. Dispersal determines the spatial scale of disease spread: wind can move rust spores hundreds of kilometres, while rain-splash moves Septoria spores only a few metres vertically within the canopy." ;
                                                                          rdfs:label "Dispersal Mechanism" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Fungal_Pathogen
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Fungal_Pathogen> rdf:type owl:Class ;
                                                                      rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen> ;
                                                                      rdfs:comment "A eukaryotic, heterotrophic organism belonging to the kingdom Fungi that causes disease in plants. Fungal pathogens are the most important group of crop pathogens worldwide, responsible for roughly 70â€“80% of plant diseases with known causal agents. They reproduce via spores and may be obligate biotrophs (rusts, smuts) or necrotrophs (Fusarium, Rhizoctonia)." ;
                                                                      rdfs:label "Fungal Pathogen" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Infection_Condition
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Infection_Condition> rdf:type owl:Class ;
                                                                          rdfs:comment "An environmental factor that promotes or suppresses pathogen development and host infection. Infection conditions represent the environment vertex of the disease triangle as it affects the pathogen: temperature optima for spore germination, humidity thresholds for infection, and rainfall duration for leaf wetness. These are the same physical variables defined in the environment module of the nutrient management ontology but viewed through the lens of disease epidemiology." ;
                                                                          rdfs:label "Infection Condition" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Inoculum_Reservoir
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Inoculum_Reservoir> rdf:type owl:Class ;
                                                                         rdfs:comment "A substrate or environment in which a pathogen survives between crop seasons (the 'off-season'). The reservoir is the source of primary inoculum that initiates disease in the next crop. Understanding the reservoir is essential for cultural control strategies: if the pathogen survives in residue, residue management breaks the cycle; if it survives in seed, seed treatment is the intervention point." ;
                                                                         rdfs:label "Inoculum Reservoir" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen> rdf:type owl:Class ;
                                                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/pathogen/dispersed_by> ;
                                                                                 owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/pathogen/Dispersal_Mechanism>
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/pathogen/favoured_by> ;
                                                                                 owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/pathogen/Infection_Condition>
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://gwsp.cs.ksu.edu/disease-management/pathogen/survives_in> ;
                                                                                 owl:someValuesFrom <https://gwsp.cs.ksu.edu/disease-management/pathogen/Inoculum_Reservoir>
                                                                               ] ;
                                                               rdfs:comment "A biological agent capable of causing disease in a living host organism. In the context of this ontology, pathogens are microorganisms (fungi, bacteria, viruses) that infect crop plants and cause economically significant yield or quality losses. Pathogen is one vertex of the disease triangle." ;
                                                               rdfs:label "Pathogen" .


###  https://gwsp.cs.ksu.edu/disease-management/pathogen/Viral_Pathogen
<https://gwsp.cs.ksu.edu/disease-management/pathogen/Viral_Pathogen> rdf:type owl:Class ;
                                                                     rdfs:subClassOf <https://gwsp.cs.ksu.edu/disease-management/pathogen/Pathogen> ;
                                                                     rdfs:comment "An obligate intracellular parasite consisting of nucleic acid enclosed in a protein coat that causes disease in plants. Viral pathogens require a living host cell to replicate and are typically transmitted by insect vectors (aphids, leafhoppers), infected seed, or mechanical contact. No curative chemical treatments exist; management relies on resistant cultivars, vector control, and certified seed." ;
                                                                     rdfs:label "Viral Pathogen" .


###  https://gwsp.cs.ksu.edu/nutrient-management/environment/Environment
<https://gwsp.cs.ksu.edu/nutrient-management/environment/Environment> rdf:type owl:Class ;
                                                                      rdfs:comment "Stub â€” defined in environment module (nutrient management). The environmental context including weather, soil, and location." ;
                                                                      rdfs:label "Environment" .


###  https://gwsp.cs.ksu.edu/nutrient-management/environment/Precipitation
<https://gwsp.cs.ksu.edu/nutrient-management/environment/Precipitation> rdf:type owl:Class ;
                                                                        rdfs:comment "Stub â€” defined in environment module. Rainfall; provides leaf wetness for infection and rain-splash dispersal of spores." ;
                                                                        rdfs:label "Precipitation" .


###  https://gwsp.cs.ksu.edu/nutrient-management/environment/Relative_Humidity
<https://gwsp.cs.ksu.edu/nutrient-management/environment/Relative_Humidity> rdf:type owl:Class ;
                                                                            rdfs:comment "Stub â€” defined in environment module. Relative humidity; high values promote spore germination and foliar infection." ;
                                                                            rdfs:label "Relative Humidity" .


