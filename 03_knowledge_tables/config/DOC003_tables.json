      {"symptom_id": "SYM_609", "document_id": "DOC003", "disease_id": "DIS_115", "plant_id": "PLANT_017", "block_id": "DOC003_P032_B004", "quote": "Selain mosaik, pada helaian daun juga sering dijumpai bercak klorotik kecoklatan.", "review_status": "verified"}
