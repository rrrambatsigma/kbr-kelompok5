{
  "schema_version": "1.0.0",
  "document_id": "DOC003",
  "source_document": "porang.pdf",
  "description": "Skema knowledge table DOC003 (Tanaman Porang). Bab 6 membahas hama-penyakit Amorphophallus spp./suweg, bukan penyakit porang, sehingga penyakit disimpan di tabel terpisah amorphophallus_spp_diseases.",
  "tables": {
    "plants": {
      "file": "curated/DOC003/plants.csv",
      "primary_key": "plant_id",
      "columns": {
        "plant_id": {"type": "string", "pattern": "^PLANT_\\d{3}$"},
        "document_id": {"type": "string", "const": "DOC003"},
        "plant_name_id": {"type": "string"},
        "plant_name_en": {"type": "string", "nullable": true},
        "scientific_name": {"type": "string", "nullable": true},
        "scientific_name_page": {"type": "integer", "nullable": true},
        "chapter_number": {"type": "integer", "minimum": 1},
        "chapter_title": {"type": "string"},
        "page_start": {"type": "integer"},
        "page_end": {"type": "integer"},
        "evidence_chunk_id": {"type": "string"},
        "notes": {"type": "string", "nullable": true}
      }
    },
    "amorphophallus_spp_diseases": {
      "file": "curated/DOC003/amorphophallus_spp_diseases.csv",
      "primary_key": "disease_id",
      "columns": {
        "disease_id": {"type": "string", "pattern": "^DIS_\\d{3}$"},
        "document_id": {"type": "string", "const": "DOC003"},
        "plant_id": {"type": "string", "foreign_key": "plants.plant_id"},
        "host_verbatim": {"type": "string", "note": "Inang seperti tercetak: Amorphophallus spp. atau suweg."},
        "disease_name_verbatim": {"type": "string"},
        "disease_name_en_verbatim": {"type": "string", "nullable": true, "note": "Nama Inggris hanya bila tercetak dalam tanda kurung."},
        "pathogen_verbatim": {"type": "string"},
        "pathogen_id": {"type": "string", "foreign_key": "pathogens.pathogen_id"},
        "reference_verbatim": {"type": "string", "nullable": true, "note": "Referensi seperti tercetak pada Tabel 2; kosong bila prosa tidak menyebutnya."},
        "page_start": {"type": "integer"},
        "page_end": {"type": "integer"},
        "source_block_id": {"type": "string"},
        "chunk_id": {"type": "string"},
        "source_type": {"type": "enum", "values": ["table", "prose"]},
        "review_status": {"type": "enum", "values": ["auto_ok", "needs_review", "verified"]},
        "notes": {"type": "string", "nullable": true}
      }
    },
    "pathogens": {
      "file": "curated/DOC003/pathogens.csv",
      "primary_key": "pathogen_id",
      "columns": {
        "pathogen_id": {"type": "string", "pattern": "^PAT_\\d{3}$"},
        "document_id": {"type": "string", "const": "DOC003"},
        "scientific_name": {"type": "string", "note": "Verbatim; salah eja sumber dipertahankan di verbatim_text/note."},
        "verbatim_text": {"type": "string"},
        "taxon_group": {"type": "enum", "values": ["jamur", "bakteri", "virus", "nematoda", "fitoplasma", "oomycete", "unknown"]},
        "taxon_evidence_chunk_id": {"type": "string", "nullable": true},
        "taxon_evidence_quote": {"type": "string", "nullable": true},
        "page": {"type": "integer"},
        "chunk_id": {"type": "string"},
        "note": {"type": "string", "nullable": true},
        "review_status": {"type": "enum", "values": ["auto_ok", "needs_review", "verified"]}
      }
    },
    "disease_pathogen": {
      "file": "curated/DOC003/disease_pathogen.csv",
      "primary_key": ["disease_id", "pathogen_id"],
      "columns": {
        "disease_id": {"type": "string", "foreign_key": "amorphophallus_spp_diseases.disease_id"},
        "pathogen_id": {"type": "string", "foreign_key": "pathogens.pathogen_id"},
        "document_id": {"type": "string", "const": "DOC003"},
        "evidence_chunk_id": {"type": "string"},
        "relation_note": {"type": "string"},
        "review_status": {"type": "enum", "values": ["auto_ok", "needs_review", "verified"]}
      }
    },
    "symptoms": {
      "file": "curated/DOC003/symptoms.csv",
      "primary_key": "symptom_id",
      "columns": {
        "symptom_id": {"type": "string", "pattern": "^SYM_\\d{3}$"},
        "document_id": {"type": "string", "const": "DOC003"},
        "disease_id": {"type": "string", "foreign_key": "amorphophallus_spp_diseases.disease_id"},
        "plant_id": {"type": "string", "foreign_key": "plants.plant_id"},
        "verbatim_text": {"type": "string"},
        "chunk_id": {"type": "string"},
        "page_start": {"type": "integer"},
        "page_end": {"type": "integer"},
        "char_start": {"type": "integer"},
        "char_end": {"type": "integer"},
        "review_status": {"type": "enum", "values": ["auto_ok", "needs_review", "verified"]}
      }
    },
    "controls": {
      "file": "curated/DOC003/controls.csv",
      "primary_key": "control_id",
      "columns": {
        "control_id": {"type": "string", "pattern": "^CTL_\\d{3}$"},
        "document_id": {"type": "string", "const": "DOC003"},
        "disease_id": {"type": "string", "nullable": true, "foreign_key": "amorphophallus_spp_diseases.disease_id"},
        "plant_id": {"type": "string", "foreign_key": "plants.plant_id"},
        "verbatim_text": {"type": "string"},
        "chunk_id": {"type": "string"},
        "page_start": {"type": "integer"},
        "page_end": {"type": "integer"},
        "char_start": {"type": "integer"},
        "char_end": {"type": "integer"},
        "control_category": {"type": "string", "nullable": true},
        "scope": {"type": "enum", "values": ["disease", "chapter"]},
        "review_status": {"type": "enum", "values": ["auto_ok", "needs_review", "verified"]}
      }
    }
  },
  "invariants": [
    "Semua verbatim_text harus substring dari plain_text chunk yang dirujuk setelah normalisasi spasi.",
    "Setiap baris penyakit harus menunjuk blok sumber dan chunk yang memuatnya.",
    "Nama patogen disimpan seperti tercetak; koreksi hanya di note.",
    "Tabel ini tidak boleh digabung dengan penyakit porang karena sumber menyatakan bab ini merangkum penyakit suweg."
  ]
}
