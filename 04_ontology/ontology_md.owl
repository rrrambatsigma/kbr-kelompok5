  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KacangHijau">
    <kbr:memilikiVarietas rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasMerpati"/>
