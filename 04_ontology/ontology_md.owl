  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBusukHitamBlackRotUbiJalar3">
    <rdfs:label xml:lang="id">Bukti gejala Penyakit busuk hitam (black rot) (Ubi jalar)</rdfs:label>
    <ns1:identifierSumber>SYM_174</ns1:identifierSumber>
    <ns1:kutipanNormalisasi xml:lang="id">Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020).</ns1:kutipanNormalisasi>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit busuk hitam (black rot) (Ubi jalar)</skos:prefLabel>
    <ns1:kutipanSumber xml:lang="id">Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020).</ns1:kutipanSumber>
    <ns1:halamanSumber>87</ns1:halamanSumber>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:idChunkSumber>DOC002_C087_02</ns1:idChunkSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu">
    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuBercakT"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuNekrosi"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <skos:prefLabel xml:lang="id">Nekrosis pada titik tunas (Cassava bud necrosis)</skos:prefLabel>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu"/>
    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FungiJamur"/>
    <ns1:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pucuk"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas</rdfs:comment>
    <rdfs:label xml:lang="id">Nekrosis pada titik tunas (Cassava bud necrosis)</rdfs:label>
    <ns1:identifierSumber>DIS_039</ns1:identifierSumber>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiKayu"/>
    <ns1:deskripsiPenyakit xml:lang="id">Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas</ns1:deskripsiPenyakit>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#IklimLembapPadaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu"/>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanTinggiPadaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu"/>
  </rdf:Description>
