    <ns1:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <rdfs:label xml:lang="id">Penyakit Mosaik Kedelai (Soybean Mosaic Virus)</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiAdaTerinfeksiMakaSegeraDilakukan"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiSoybeanMosaic"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiHeadingSubsectionSoybeanMosaic"/>
    <skos:altLabel xml:lang="id">Soybean Mosaic Virus</skos:altLabel>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit mosaik kedelai (soybean mosaic virus) atau SMV disebabkan oleh infeksi patogen dari golongan virus. Dapat menyerang tanaman kedelai sejak dari benih disemai. Patogen SMV dapat terbawa oleh benih yang ditanam (seed borne disease). Oleh karena itu benih yang terinfeksi dan membawa patogen SMV merupakan sumber utama terjadinya penyakit. Penyakit akan berkembang pada lahan pertanaman kedelai yang ditularkan oleh serangga famili Aphididae seperti Aphis glycine, A. craccivora, A. fabae, A. gossypii, A. nasturtii dan A. nerii non persisten (Inayati and Yusnawan, 2017).</rdfs:comment>
    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <skos:prefLabel xml:lang="id">Penyakit Mosaik Kedelai (Soybean Mosaic Virus)</skos:prefLabel>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SanitasiLahan"/>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanInsektisida"/>
    <ns1:namaInggrisPenyakit>Soybean Mosaic Virus</ns1:namaInggrisPenyakit>
    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SoybeanMosaicVirus"/>
    <ns1:deskripsiPenyakit xml:lang="id">Penyakit mosaik kedelai (soybean mosaic virus) atau SMV disebabkan oleh infeksi patogen dari golongan virus. Dapat menyerang tanaman kedelai sejak dari benih disemai. Patogen SMV dapat terbawa oleh benih yang ditanam (seed borne disease). Oleh karena itu benih yang terinfeksi dan membawa patogen SMV merupakan sumber utama terjadinya penyakit. Penyakit akan berkembang pada lahan pertanaman kedelai yang ditularkan oleh serangga famili Aphididae seperti Aphis glycine, A. craccivora, A. fabae, A. gossypii, A. nasturtii dan A. nerii non persisten (Inayati and Yusnawan, 2017).</ns1:deskripsiPenyakit>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#LahanTegalanDiBawahTegakanPohonJatiPadaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelai"/>
  </rdf:Description>
