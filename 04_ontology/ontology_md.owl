    <ns1:identifierSumber>Results and discussion, temperature paragraph</ns1:identifierSumber>
    <ns1:kutipanSumber>Therefore temperature influenced the development of SPVD; low temperatures of 20 to 29°C produced more disease severities than high temperatures of 30 to 39oC.</ns1:kutipanSumber>
    <ns1:kutipanNormalisasi>Therefore temperature influenced the development of SPVD; low temperatures of 20 to 29°C produced more disease severities than high temperatures of 30 to 39oC.</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">confidence=medium; review_status=verified; relation_type=direct</ns1:catatanKualitas>
    <rdfs:comment xml:lang="id">Bukti sumber: Suhu 20–29°C pada Penyakit bercak kuning; SRC_EXT_025.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSuhuPadaPenyakitHawarDaunJagung">
