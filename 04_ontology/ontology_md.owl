    <ns1:idChunkSumber>DOC002_C106_02</ns1:idChunkSumber>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Bulai</skos:prefLabel>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:kutipanNormalisasi xml:lang="id">Pemberian pupuk kalium juga dapat menurunkan laju infeksi, kejadian dan keparahan penyakit bulai karena kalium membantu pengaturan membuka dan menutupnya stomata dan membentuk senyawa lignin sehingga dinding sel menjadi lebih tebal dan sulit ditembus oleh jamur patogen (Habibi et al., 2017).</ns1:kutipanNormalisasi>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:kutipanSumber xml:lang="id">Pemberian pupuk kalium juga dapat menurunkan laju infeksi, kejadian dan keparahan penyakit bulai karena kalium membantu pengaturan membuka dan menutupnya stomata dan membentuk senyawa lignin sehingga dinding sel menjadi lebih tebal dan sulit ditembus oleh jamur patogen (Habibi et al., 2017).</ns1:kutipanSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Bulai</rdfs:label>
  </rdf:Description>
