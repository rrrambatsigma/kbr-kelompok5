    <kbr:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKerdilRumputDanKerdilHampaPadi"/>
    <kbr:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitTungroPadi"/>
