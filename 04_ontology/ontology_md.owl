    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitEmbunPalsuDownyMildewKedelai"/>
    <skos:prefLabel xml:lang="id">Pertumbuhan abnormal pada Penyakit Embun Palsu (Downy mildew) (Kedelai)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBercakDaunKacangHijauBercakDaun">
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangHijau"/>
    <skos:prefLabel xml:lang="id">Bercak daun pada Penyakit Bercak Daun (Kacang hijau)</skos:prefLabel>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakDaun"/>
    <rdfs:comment xml:lang="id">Gejala bercak daun pada tanaman Kacang hijau: Bercak pada daun terinfeksi umumnya berbentuk agak bundar hingga tidak...</rdfs:comment>
    <rdfs:comment xml:lang="id">Bercak pada daun terinfeksi umumnya berbentuk agak bundar hingga tidak beraturan, dan umumnya berwarna coklat, bagian tengah berwarna keabu-abuan dan dikelilingi oleh bercak coklat kemerahan dengan bentuk permukaan agak tertekan (Gambar 21).</rdfs:comment>
    <ns1:deskripsiGejala xml:lang="id">Bercak pada daun terinfeksi umumnya berbentuk agak bundar hingga tidak beraturan, dan umumnya berwarna coklat, bagian tengah berwarna keabu-abuan dan dikelilingi oleh bercak coklat kemerahan dengan bentuk permukaan agak tertekan (Gambar 21).</ns1:deskripsiGejala>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bercak daun pada Penyakit Bercak Daun (Kacang hijau)</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBercakDaunKacangHijau"/>
  </rdf:Description>
