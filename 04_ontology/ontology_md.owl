  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PerlakuanKimiaTanah">
    <kbr:namaPengendalian xml:lang="id">Perlakuan kimia tanah</kbr:namaPengendalian>
    <skos:altLabel xml:lang="id">perlakuan kimia tanah</skos:altLabel>
    <rdfs:comment xml:lang="id">Tindakan kanonik perlakuan kimia tanah.</rdfs:comment>
    <skos:definition xml:lang="id">Memperlakukan tanah dengan bahan kimia untuk menekan patogen tular tanah.</skos:definition>
    <skos:prefLabel xml:lang="id">Perlakuan kimia tanah</skos:prefLabel>
    <rdfs:label xml:lang="id">Perlakuan kimia tanah</rdfs:label>
    <kbr:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBusukHitamBlackRotUbiJalar"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBusukHitamBlackRotUbiJalar3"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
