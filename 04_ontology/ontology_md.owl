  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBulaiJagungTepungDaun">
    <skos:prefLabel xml:lang="id">Tepung pada daun pada Penyakit Bulai (Jagung)</skos:prefLabel>
