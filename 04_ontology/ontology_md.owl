    <ns1:identifierSumber>DIS_125</ns1:identifierSumber>
    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC005"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitLayuKacangHijauMiseliaBerwarnaPutihTingkatLanjut"/>
