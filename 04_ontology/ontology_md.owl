  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitEmbunPalsuDownyMildewKedelai">
    <kbr:idChunkSumber>DOC002_C046_02</kbr:idChunkSumber>
    <kbr:halamanSumber>46</kbr:halamanSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <kbr:kutipanSumber xml:lang="id">Pengendalian dapat dilakukan dengan melakukan eradikasi dari sumber-sumber inokulum, menghilangkan tanaman inang alternatif untuk patogen P.</kbr:kutipanSumber>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
