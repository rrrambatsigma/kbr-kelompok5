    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PertumbuhanAbnormal"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Polong"/>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitAntraknosaKedelai"/>
    <skos:prefLabel xml:lang="id">Pertumbuhan abnormal pada Penyakit Antraknosa</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pada bagian daun biasanya bercak menyebabkan daun menjadi menggulung dan adanya nekrotik dan bercak coklat gelap pada daun (Gambar 2.10).</rdfs:comment>
