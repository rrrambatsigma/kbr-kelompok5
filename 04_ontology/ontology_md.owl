    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Rebah Semai</skos:prefLabel>
    <ns1:kutipanNormalisasi xml:lang="id">rolfsii adalah tanaman akan layu, kemudian daun menjadi layu dan menguning, kemudian pada bagian pangkal akar akan muncul tanda berupa kumpulan hifa jamur yang berwarna putih (Gambar 2.1).</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ns1:catatanKualitas>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Serealia">
    <rdfs:comment xml:lang="id">Kelompok tanaman pangan serealia dalam ruang lingkup.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pergiliran kacang tanah dengan kapas, kedelai, dan serealia (padi, jagung, sorgum, gandum, tebu) dapat memutus siklus perkembangan R. solanacearum di lahan setempat sehingga mengurangi kejadian penyakit layu.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="n695264d974974fe6a4344407a3a532dbb28"/>
    <rdfs:label xml:lang="id">Serealia</rdfs:label>
    <skos:prefLabel xml:lang="id">Serealia</skos:prefLabel>
