    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:kutipanNormalisasi xml:lang="id">Pemanjangan ruas batang yang berlebihan, sehingga batang terbentuk tipis dan lemah dibandingkan tanaman sehat. Gejala pada daun dan tangkai daun di batang muda, deformasi berkembang berasosisi dengan gejala kanker.</ns1:kutipanNormalisasi>
    <ns1:idBlokSumber>DOC002_P094_B001</ns1:idBlokSumber>
