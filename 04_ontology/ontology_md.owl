    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitTungroPadi3"/>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Padi"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Malai"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <skos:altLabel xml:lang="en">Tungro</skos:altLabel>
    <kbr:identifierSumber>DIS_004</kbr:identifierSumber>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SanitasiLahan"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengumpulanDanPemusnahan"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanMetarhizium"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianVektor"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanWaktuTanam"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanVarietasTahan"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengelolaanGulma"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <skos:prefLabel xml:lang="id">Penyakit Tungro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Tungro</skos:prefLabel>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <kbr:deskripsiPenyakit xml:lang="id">Asal kata tungro pada nama penyakit ini berasal dari bahasa Tagalog, Filipina yang mempunyai arti pertumbuhan yang terhambat. Meskipun sudah menjadi nama penyakit yang resmi dan berlaku di Indonesia. Penyakit ini juga mempunyai nama lokal di negara lain maupun di wilayah lain di Indonesia, seperti di Malaysia disebut dengan penyakit merah, di Thailand disebut yellow orange leaf disease, di Kalimantan Selatan disebut penyakit habang, di Sulawesi Selatan disebut penyakit cella pance, dan di Bali disebut penyakit kebebeng (Muhsin dan Widiarta 2009). Oleh karena itu, penyebaran penyakit sangat luas dengan luas serangan mencapai 3.650 ha per tahun di Indonesia pada periode 2001-2006 (Kusprayogie et al. 2001)</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#MusimHujanPadaPenyakitTungroPadi"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/RiceTungroViralDisease"/>
  </rdf:Description>
