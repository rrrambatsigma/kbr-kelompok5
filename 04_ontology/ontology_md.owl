  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitEmbunPalsuDownyMildewKedelaiBuluDiawaliMunculnyaPermukaanBagian">
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC005"/>
    <ns1:idChunkSumber>DOC005_C026_02</ns1:idChunkSumber>
    <ns1:halamanSumber>26</ns1:halamanSumber>
    <ns1:dokumenSumber>DOC005</ns1:dokumenSumber>
    <ns1:identifierSumber>SYM_612</ns1:identifierSumber>
    <ns1:kutipanNormalisasi xml:lang="id">Penyakit embun bulu diawali munculnya gejala pada permukaan daun bagian atas berupa bercak berwarna kuning pucat, kemudian berubah menjadi kuning kecoklatan dengan warna agak kekuningan di sekeliling bercak (Gambar 4).</ns1:kutipanNormalisasi>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Embun Palsu (Downy mildew)</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <ns1:kutipanSumber xml:lang="id">Penyakit embun bulu diawali munculnya gejala pada permukaan daun bagian atas berupa bercak berwarna kuning pucat, kemudian berubah menjadi kuning kecoklatan dengan warna agak kekuningan di sekeliling bercak (Gambar 4).</ns1:kutipanSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Embun Palsu (Downy mildew)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBuah">
    <skos:prefLabel xml:lang="id">Gejala Buah</skos:prefLabel>
    <rdfs:comment xml:lang="id">Gejala yang diamati pada buah.</rdfs:comment>
    <rdfs:comment xml:lang="id">flowchart TD subgraph A A1["Batang konidia pada permukaan atas daun"] --&gt; A2["Spora disebarkan oleh angin, percikan air dan serangga"] A2 --&gt; A3["Infeksi didalam jaringan tanaman inang"] A3 --&gt; A4["Miselium tanpa hauspora"] A4 --&gt; A5["Badan buah conidien pada sisi-sisi tanaman"] A5 --&gt; A6["Pseudothecium Mycosphaerella arachidia"] A6 --&gt; A7["Gejala bercak daun awal"] A7 --&gt; A8["Permukaan atas daun"] A8 --&gt; A1 end subgraph B B1["Batang konidia pada permukaan bawah daun"] --&gt; B2["Spora disebarkan oleh angin, percikan air dan serangga"] B2 --&gt; B3["Infeksi dari jaringan tanaman inang"] B3 --&gt; B4["Miselium didalam sel dengan hauspora"] B4 --&gt; B5["Badan buah conidien pada sisi-sisi tanaman"] B5 --&gt; B6["Pseudothecium Mycosphaerella berkoknyi"] B6 --&gt; B7["Gejala bercak daun lambat"] B7 --&gt; B8["Permukaan bawah daun"] B8 --&gt; B1 end</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="id">Gejala Buah</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKudisUbiJalarMenjadiTidakProduktifFotosintesisTingkat">
    <ns1:halamanSumber>83</ns1:halamanSumber>
    <ns1:kutipanNormalisasi xml:lang="id">Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997).</ns1:kutipanNormalisasi>
