    <rdfs:label xml:lang="id">Pengamatan gejala Penyakit Karat Daun</rdfs:label>
    <ns1:deskripsiGejala xml:lang="id">Gejala karat biasanya diawali dari daun bagian bawah dan berkembang ke daun bagian atas, umumnya muncul pada masa generatif (Puspawati and Sudarma, 2016).</ns1:deskripsiGejala>
    <skos:prefLabel xml:lang="id">Pengamatan gejala Penyakit Karat Daun</skos:prefLabel>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKaratDaunJagungBiasanyaDiawaliBagianBawahBerkembang"/>
