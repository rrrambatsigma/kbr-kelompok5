  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanLayuFusariumUbiJalarSelainTerjadiNekrosisBagianVaskular">
    <rdfs:label xml:lang="id">Pengamatan gejala layu fusarium</rdfs:label>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang belum dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Selain itu, terjadi nekrosis pada bagian vaskular batang dengan perubahan warna coklat menjadi ungu yang disertai pecahnya korteks batang dan miselium tumbuh pada permukaan batang yang terinfeksi (Gambar 1G dan F).</rdfs:comment>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaLayuFusariumUbiJalarSelainTerjadiNekrosisBagianVaskular"/>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#LayuFusariumUbiJalar"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <skos:prefLabel xml:lang="id">Pengamatan gejala layu fusarium</skos:prefLabel>
    <ns1:deskripsiGejala xml:lang="id">Selain itu, terjadi nekrosis pada bagian vaskular batang dengan perubahan warna coklat menjadi ungu yang disertai pecahnya korteks batang dan miselium tumbuh pada permukaan batang yang terinfeksi (Gambar 1G dan F).</ns1:deskripsiGejala>
  </rdf:Description>
