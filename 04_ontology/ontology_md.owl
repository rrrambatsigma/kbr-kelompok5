    <kbr:identifierSumber>SYM_113</kbr:identifierSumber>
    <kbr:idChunkSumber>DOC002_C059_01</kbr:idChunkSumber>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus) (Kedelai)</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
