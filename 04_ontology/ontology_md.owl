    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiLingkunganLayuFusariumUbiJalarPanenProdusenSeringMemanenBawah"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianLayuFusariumUbiJalarPengendalianDilakukanAntaranyaSanitasiPenanganan"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenLayuFusariumUbiJalarFusariumOxysporumPenyebabPermukaanSurface"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitLayuFusariumUbiJalarFusarium"/>
