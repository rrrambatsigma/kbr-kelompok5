  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitAntraknosaKedelaiKondisiLembapMenggulungGugurPolong">
    <ns1:dokumenSumber>DOC005</ns1:dokumenSumber>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Antraknosa</skos:prefLabel>
    <ns1:kutipanNormalisasi xml:lang="id">Pada kondisi lembap, daun akan menggulung dan mudah gugur, sedangkan pada polong akan terlihat acervuli yang membentuk pola cincin konsentris (Gambar 6b).</ns1:kutipanNormalisasi>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
