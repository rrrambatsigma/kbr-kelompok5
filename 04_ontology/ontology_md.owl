  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitAntraknosaKedelaiDiawaliMunculnyaLekukanBerwarnaHitam">
    <skos:prefLabel xml:lang="id">Pengamatan gejala Penyakit Antraknosa</skos:prefLabel>
    <ns1:deskripsiGejala xml:lang="id">Gejala diawali dengan munculnya lekukan bercak berwarna hitam dengan bentuk bercak yang tidak beraturan.</ns1:deskripsiGejala>
