    <rdfs:label xml:lang="id">Penyakit Layu</rdfs:label>
    <skos:altLabel xml:lang="id">LAYU</skos:altLabel>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanAgensHayati"/>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanEkstrakTanaman"/>
