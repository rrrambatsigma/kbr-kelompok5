  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaTanamanKerdilStuntUbiKayuKerdilTanaman">
    <kbr:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KerdilTanaman"/>
    <rdfs:label xml:lang="id">Kerdil tanaman</rdfs:label>
