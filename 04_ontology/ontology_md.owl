  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Oomycete">
    <rdfs:label xml:lang="id">Oomycete</rdfs:label>
    <skos:prefLabel xml:lang="id">Oomycete</skos:prefLabel>
