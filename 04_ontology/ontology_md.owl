    <rdfs:label xml:lang="id">Bercak pada tanaman pada Penyakit Rebah Semai (Kedelai)</rdfs:label>
    <ns1:deskripsiGejala xml:lang="id">Patogen ini mampu menginfeksi tanaman pada saat tanaman kedelai berumur 2-3 minggu setelah tanam yang ditandai dengan gejala bercak coklat pada bagian pangkal batang tanaman kedelai (Sofiani et al., 2016).</ns1:deskripsiGejala>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitRebahSemaiKedelai"/>
