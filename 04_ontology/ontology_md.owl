  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBiopestisida">
    <rdfs:label xml:lang="id">Penggunaan biopestisida</rdfs:label>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianBiologis"/>
    <skos:definition xml:lang="id">Menggunakan biopestisida berbahan aktif organisme atau metabolit alami.</skos:definition>
    <kbr:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLayuBakteriKacangTanah"/>
    <kbr:namaPengendalian xml:lang="id">Penggunaan biopestisida</kbr:namaPengendalian>
    <rdfs:comment xml:lang="id">Tindakan kanonik penggunaan biopestisida.</rdfs:comment>
    <kbr:deskripsiPengendalian xml:lang="id">Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati.</kbr:deskripsiPengendalian>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuBakteriKacangTanah3"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumKacangTanah28"/>
    <skos:altLabel xml:lang="id">penggunaan biopestisida</skos:altLabel>
    <skos:prefLabel xml:lang="id">Penggunaan biopestisida</skos:prefLabel>
  </rdf:Description>
