    <ns1:idChunkSumber>DOC002_C106_02</ns1:idChunkSumber>
    <ns1:kutipanNormalisasi xml:lang="id">Pengendalian penyakit bulai jagung dapat dilakukan dengan menggunakan varietas tahan seperti Jagung Asian Honey yang mempunyai kejadian penyakit lebih rendah (54.17%) dibandingkan dengan varietas Jagung Pioneer 21 (70.83%) dan Jagung Pacific 339 (79.17%).</ns1:kutipanNormalisasi>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Bulai</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <ns1:kutipanSumber xml:lang="id">Pengendalian penyakit bulai jagung dapat dilakukan dengan menggunakan varietas tahan seperti Jagung Asian Honey yang mempunyai kejadian penyakit lebih rendah (54.17%) dibandingkan dengan varietas Jagung Pioneer 21 (70.83%) dan Jagung Pacific 339 (79.17%).</ns1:kutipanSumber>
    <ns1:halamanSumber>106</ns1:halamanSumber>
  </rdf:Description>
