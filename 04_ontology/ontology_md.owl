  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuStewartJagungSelainRizobakteriaRambeEtAl">
    <ns1:identifierSumber>CTL_226</ns1:identifierSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <ns1:kutipanNormalisasi xml:lang="id">Selain menggunakan rizobakteria, (Rambe et al., 2020) memanfaatkan konsorsium bakteri endofit yang terdiri atas Alcaligenes faecalis, Bacillus cereus dan Serratia marcescens untuk menekan penyakit layu stewart.</ns1:kutipanNormalisasi>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:idChunkSumber>DOC002_C108_02</ns1:idChunkSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Layu Stewart</rdfs:label>
    <ns1:kutipanSumber xml:lang="id">Selain menggunakan rizobakteria, (Rambe et al., 2020) memanfaatkan konsorsium bakteri endofit yang terdiri atas Alcaligenes faecalis, Bacillus cereus dan Serratia marcescens untuk menekan penyakit layu stewart.</ns1:kutipanSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <ns1:halamanSumber>108</ns1:halamanSumber>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Layu Stewart</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanahBenih25MenyebabkanEndemis">
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Belang (Mottle)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:identifierSumber>CTL_150</ns1:identifierSumber>
    <ns1:kutipanNormalisasi xml:lang="id">Infeksi benih 2-5% dapat menyebabkan endemis penyakit saat panen.</ns1:kutipanNormalisasi>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
