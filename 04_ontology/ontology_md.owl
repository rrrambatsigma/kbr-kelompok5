    <ns1:deskripsiPengendalian xml:lang="id">Jerami dan sisa tunggul dari padi yang terinfeksi dibakar atau dikomposkan untuk mencegah adanya sumber inokulum bagi musim berikutnya.</ns1:deskripsiPengendalian>
