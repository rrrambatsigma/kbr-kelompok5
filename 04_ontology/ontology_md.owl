  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBiopestisida">
    <ns1:namaPengendalian xml:lang="id">Penggunaan biopestisida</ns1:namaPengendalian>
    <skos:prefLabel xml:lang="id">Penggunaan biopestisida</skos:prefLabel>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLayuBakteriKacangTanah"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuBakteriKacangTanahKeamananHayatiProdukPertanianSemakin"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumKacangTanahKeamananHayatiProdukPertanianSemakin"/>
    <rdfs:comment xml:lang="id">Tindakan kanonik penggunaan biopestisida.</rdfs:comment>
    <rdfs:comment xml:lang="id">Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianBiologis"/>
    <rdfs:label xml:lang="id">Penggunaan biopestisida</rdfs:label>
    <ns1:deskripsiPengendalian xml:lang="id">Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati.</ns1:deskripsiPengendalian>
  </rdf:Description>
