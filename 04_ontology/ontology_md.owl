    <ns1:halamanSumber>45</ns1:halamanSumber>
    <ns1:identifierSumber>SYM_057</ns1:identifierSumber>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Embun Tepung (Powdery Mildew)</rdfs:label>
    <ns1:kutipanNormalisasi xml:lang="id">diffusa menginfeksi daun kedelai bagian bawah sehingga pada permukaan daun bagian bawah terdapat bercak berwarna putih seperti tepung yang merupakan kumpulan dari konidia dan konidiofor patogen E.</ns1:kutipanNormalisasi>
