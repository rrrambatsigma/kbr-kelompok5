  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitRebahSemaiKedelaiKlorosisDaun">
    <rdfs:comment xml:lang="id">Gejala klorosis daun pada tanaman Kedelai: rolfsii adalah tanaman akan layu, kemudian daun menjadi layu dan...</rdfs:comment>
    <rdfs:comment xml:lang="id">rolfsii adalah tanaman akan layu, kemudian daun menjadi layu dan menguning, kemudian pada bagian pangkal akar akan muncul tanda berupa kumpulan hifa jamur yang berwarna putih (Gambar 2.1).</rdfs:comment>
    <rdfs:label xml:lang="id">Klorosis daun pada Penyakit Rebah Semai (Kedelai)</rdfs:label>
    <skos:prefLabel xml:lang="id">Klorosis daun pada Penyakit Rebah Semai (Kedelai)</skos:prefLabel>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitRebahSemaiKedelai4"/>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitRebahSemaiKedelai"/>
    <ns1:deskripsiGejala xml:lang="id">rolfsii adalah tanaman akan layu, kemudian daun menjadi layu dan menguning, kemudian pada bagian pangkal akar akan muncul tanda berupa kumpulan hifa jamur yang berwarna putih (Gambar 2.1).</ns1:deskripsiGejala>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KlorosisDaun"/>
  </rdf:Description>
