  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBusukPelepahJagung">
    <ns1:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Buah"/>
    <ns1:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ns1:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitBusukPelepahJagung"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitPenyakitBusukPelepahJagung"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBusukPelepahJagung"/>
    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RhizoctoniaSolani"/>
    <ns1:identifierSumber>DIS_048</ns1:identifierSumber>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBacillus"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBacillus"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit busuk pelepah disebabkan oleh jamur patogen Rhizoctonia solani. Patogen ini termasuk soil borne yang artinya merupakan patogen tular tanah sehingga dapat bertahan di tanah dan juga sisa tanaman dalam bentuk sklerotium. Sklerotium merupakan massa hifa yang mengumpul dan memadat yang awalnya berwarna putih dan kemudian berubah menjadi berwarna coklat. Jamur ini mempunyai banyak inang alternatif seperti tanaman kacang tanah, kedelai, kacang hijau dan sorgum (Soenartiningsih et al., 2015).</rdfs:comment>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="id">Penyakit Busuk Pelepah</skos:prefLabel>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBusukPelepahJagungBercakTanaman"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBusukPelepahJagungBusukBatang"/>
    <rdfs:label xml:lang="id">Penyakit Busuk Pelepah</rdfs:label>
    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Jagung"/>
    <ns1:deskripsiPenyakit xml:lang="id">Penyakit busuk pelepah disebabkan oleh jamur patogen Rhizoctonia solani. Patogen ini termasuk soil borne yang artinya merupakan patogen tular tanah sehingga dapat bertahan di tanah dan juga sisa tanaman dalam bentuk sklerotium. Sklerotium merupakan massa hifa yang mengumpul dan memadat yang awalnya berwarna putih dan kemudian berubah menjadi berwarna coklat. Jamur ini mempunyai banyak inang alternatif seperti tanaman kacang tanah, kedelai, kacang hijau dan sorgum (Soenartiningsih et al., 2015).</ns1:deskripsiPenyakit>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuMinimal30CPadaPenyakitBusukPelepahJagung"/>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanTinggiPadaPenyakitBusukPelepahJagung"/>
  </rdf:Description>
