  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKudisUbiJalarTimbulAkibatBagianBatangTerdapat">
    <ns1:kutipanNormalisasi xml:lang="id">Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010).</ns1:kutipanNormalisasi>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <ns1:identifierSumber>SYM_160</ns1:identifierSumber>
    <ns1:idChunkSumber>DOC002_C083_01</ns1:idChunkSumber>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit kudis</rdfs:label>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:halamanSumber>83</ns1:halamanSumber>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit kudis</skos:prefLabel>
    <ns1:kutipanSumber xml:lang="id">Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010).</ns1:kutipanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
