  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSuhuInfeksiOptimalPadaLayuFusariumUbiJalar">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Suhu infeksi optimal pada layu fusarium</rdfs:label>
    <kbr:dokumenSumber>SRC_EXT_023</kbr:dokumenSumber>
    <kbr:identifierSumber>Biology and ecology, paragraph 1</kbr:identifierSumber>
    <kbr:kutipanSumber>The optimum temperature for infection is around 30°C, but the disease can develop at lower temperature and across a wide range of soil moisture- from 28 to 75%. However, the highest damage occurs in fields where the moisture is low.</kbr:kutipanSumber>
    <kbr:kutipanNormalisasi>The optimum temperature for infection is around 30°C, but the disease can develop at lower temperature and across a wide range of soil moisture- from 28 to 75%. However, the highest damage occurs in fields where the moisture is low.</kbr:kutipanNormalisasi>
    <kbr:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=direct</kbr:catatanKualitas>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PublikasiSRCEXT023"/>
    <rdfs:comment xml:lang="id">Bukti sumber: Suhu infeksi optimal pada layu fusarium; SRC_EXT_023.</rdfs:comment>
  </rdf:Description>
