    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiIntensitasMakaMunculTerdapatDiikuti">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)</skos:prefLabel>
    <ns1:kutipanNormalisasi xml:lang="id">Pada intensitas serangan yang tinggi maka gejala yang muncul pada tanaman kedelai adalah terdapat mosaik pada daun yang diikuti dengan tonjolan pada permukaan daun dan terdapat blister di mana helai daun berwarna hijau tua, bentuk daun keriting, adanya mosaik kuning dan tanaman kedelai menjadi kerdil.</ns1:kutipanNormalisasi>
    <ns1:idChunkSumber>DOC002_C059_01</ns1:idChunkSumber>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)</rdfs:label>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:kutipanSumber xml:lang="id">Pada intensitas serangan yang tinggi maka gejala yang muncul pada tanaman kedelai adalah terdapat mosaik pada daun yang diikuti dengan tonjolan pada permukaan daun dan terdapat blister di mana helai daun berwarna hijau tua, bentuk daun keriting, adanya mosaik kuning dan tanaman kedelai menjadi kerdil.</ns1:kutipanSumber>
    <ns1:halamanSumber>59</ns1:halamanSumber>
    <ns1:identifierSumber>SYM_114</ns1:identifierSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun">
    <skos:prefLabel xml:lang="id">Daun</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BagianTanaman"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Bagian tanaman yang dapat menjadi lokasi gejala.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit bercak daun merupakan penyakit tular udara yang disebabkan oleh patogen (Cercospora arachidicola dan C. Personata).</rdfs:comment>
    <rdfs:label xml:lang="id">Daun</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitHawarPelepahDaunPadiBercakDaun">
    <rdfs:label xml:lang="id">Bercak daun pada Penyakit Hawar Pelepah Daun</rdfs:label>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
