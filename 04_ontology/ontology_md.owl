    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanFungisida"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PerlakuanBenih"/>
    <ns1:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Biji"/>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PerlakuanBenih"/>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanFungisida"/>
    <skos:prefLabel xml:lang="id">Penyakit Bercak Biji Ungu</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CercosporaKikuchii"/>
    <ns1:identifierSumber>DIS_015</ns1:identifierSumber>
    <rdfs:label xml:lang="id">Penyakit Bercak Biji Ungu</rdfs:label>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit bercak biji ungu atau juga dikenal dengan hawar daun Cercospora merupakan penyakit pada tanaman kedelai yang disebabkan oleh patogen Cercospora kikuchii. Penyakit bercak biji ungu atau hawar daun Cercospora merupakan penyakit yang penting juga pada tanaman kedelai karena dapat menyebabkan kehilangan hasil. Patogen C. kikuchii dapat menginfeksi bagian tanaman kedelai seperti daun, batang dan polong (Cai and Schneider, 2008). Gejala pada tanaman kedelai yang terinfeksi patogen C. kikuchii adalah adanya perubahan warna daun menjadi ungu muda pada permukaan daun atas yang biasanya dimulai pada bagian pinggir daun kemudian dapat melebar dan luas hingga menutupi seluruh permukaan daun tanaman kedelai berwarna ungu. Gejala ini biasanya dianggap sebagai gejala karena pengaruh cahaya matahari.</rdfs:comment>
    <ns1:deskripsiPenyakit xml:lang="id">Penyakit bercak biji ungu atau juga dikenal dengan hawar daun Cercospora merupakan penyakit pada tanaman kedelai yang disebabkan oleh patogen Cercospora kikuchii. Penyakit bercak biji ungu atau hawar daun Cercospora merupakan penyakit yang penting juga pada tanaman kedelai karena dapat menyebabkan kehilangan hasil. Patogen C. kikuchii dapat menginfeksi bagian tanaman kedelai seperti daun, batang dan polong (Cai and Schneider, 2008). Gejala pada tanaman kedelai yang terinfeksi patogen C. kikuchii adalah adanya perubahan warna daun menjadi ungu muda pada permukaan daun atas yang biasanya dimulai pada bagian pinggir daun kemudian dapat melebar dan luas hingga menutupi seluruh permukaan daun tanaman kedelai berwarna ungu. Gejala ini biasanya dianggap sebagai gejala karena pengaruh cahaya matahari.</ns1:deskripsiPenyakit>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanahPenggunaanBenihBerukuranMengurangiRisiko">
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Belang (Mottle)</rdfs:label>
    <ns1:kutipanNormalisasi xml:lang="id">oleh karena itu penggunaan benih berukuran normal dapat mengurangi risiko sumber inokulum penyakit.</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ns1:catatanKualitas>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Belang (Mottle)</skos:prefLabel>
