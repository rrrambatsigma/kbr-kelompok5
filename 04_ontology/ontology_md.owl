  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BagianTanaman">
    <owl:disjointWith rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
