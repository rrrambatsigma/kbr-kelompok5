  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai">
    <rdfs:label xml:lang="id">Klorosis daun pada Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus) (Kedelai)</rdfs:label>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KlorosisDaun"/>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai"/>
    <rdfs:comment xml:lang="id">Gejala klorosis daun pada tanaman Kedelai: Gejala yang ditunjukkan oleh patogen CMMV pada tanaman kedelai adalah...</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala yang ditunjukkan oleh patogen CMMV pada tanaman kedelai adalah pada daun tanaman terdapat belang secara sistemik, bagian tulang daun terdapat klorosis serta daun yang terinfeksi CMMV mengalami malformasi (Gambar 2.18).</rdfs:comment>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="id">Klorosis daun pada Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus) (Kedelai)</skos:prefLabel>
    <ns1:deskripsiGejala xml:lang="id">Gejala yang ditunjukkan oleh patogen CMMV pada tanaman kedelai adalah pada daun tanaman terdapat belang secara sistemik, bagian tulang daun terdapat klorosis serta daun yang terinfeksi CMMV mengalami malformasi (Gambar 2.18).</ns1:deskripsiGejala>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusK2"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKe"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSuhuPadaPenyakitBakteriPustulKedelai">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Suhu pada Penyakit Bakteri Pustul</rdfs:label>
    <ns1:dokumenSumber>SRC_EXT_002</ns1:dokumenSumber>
    <ns1:identifierSumber>Abstract</ns1:identifierSumber>
    <ns1:kutipanSumber>Disease development is strongly associated with temperatures of 26–30 °C, high relative humidity, and prolonged leaf wetness, conditions commonly observed during the rainy season in tropical agroecosystems.</ns1:kutipanSumber>
    <ns1:kutipanNormalisasi>Disease development is strongly associated with temperatures of 26–30 °C, high relative humidity, and prolonged leaf wetness, conditions commonly observed during the rainy season in tropical agroecosystems.</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=direct</ns1:catatanKualitas>
    <rdfs:comment xml:lang="id">Bukti sumber: Suhu pada Penyakit Bakteri Pustul; SRC_EXT_002.</rdfs:comment>
  </rdf:Description>
