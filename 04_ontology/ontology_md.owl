    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BagianTanaman"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiLingkunganPenyakitKudisUbiJalarInokulumBiasanyaBerasalBahanTanam">
    <ns1:kutipanNormalisasi xml:lang="id">Sumber inokulum penyakit kudis biasanya berasal dari bahan tanam (setek) yang terinfeksi jamur, penyakit ini menyebar lebih cepat ke tanaman yang sehat percikan air hujan yang disertai angin, lebih banyak terjadi serangan pada musim hujan (Saleh and Rahayuningsih, 2013).</ns1:kutipanNormalisasi>
    <ns1:idChunkSumber>DOC002_C083_01</ns1:idChunkSumber>
