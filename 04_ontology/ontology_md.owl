  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitTungroPadiKlorosisDaun">
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitTungroPadi"/>
    <kbr:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <kbr:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitTungroPadi"/>
    <kbr:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KlorosisDaun"/>
    <kbr:deskripsiGejala xml:lang="id">Indikasi adanya infeksi virus tungro pada tanaman padi dapat dilihat dari daun perubahan warna daun (diskolorasi) menjadi kuning hingga oranye.</kbr:deskripsiGejala>
    <skos:prefLabel xml:lang="id">Klorosis daun</skos:prefLabel>
    <rdfs:comment xml:lang="id">Gejala klorosis daun pada tanaman Padi: Indikasi adanya infeksi virus tungro pada tanaman padi dapat dilihat dari daun perubahan warna daun (diskolorasi) menjadi kuning hingga oranye.</rdfs:comment>
    <rdfs:comment xml:lang="id">Indikasi adanya infeksi virus tungro pada tanaman padi dapat dilihat dari daun perubahan warna daun (diskolorasi) menjadi kuning hingga oranye.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
