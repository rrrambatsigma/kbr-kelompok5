    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangTanah"/>
    <ns1:deskripsiGejala xml:lang="id">Gejala pertama muncul 10 hari setelah inokulasi berupa lesio kecil klorotik, selanjutnya lesio semakin meluas hingga diameter 1 - 10 mm berwarna semakin gelap.</ns1:deskripsiGejala>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KlorosisTanaman"/>
  </rdf:Description>
