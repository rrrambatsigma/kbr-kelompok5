    <ns1:idChunkSumber>DOC002_C073_04</ns1:idChunkSumber>
    <ns1:kutipanSumber xml:lang="id">Infeksi benih 2-5% dapat menyebabkan endemis penyakit saat panen.</ns1:kutipanSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Belang (Mottle)</rdfs:label>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Suhu">
    <skos:prefLabel xml:lang="id">Suhu</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorLingkungan"/>
    <rdfs:label xml:lang="id">Suhu</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="id">Faktor suhu lingkungan.</rdfs:comment>
    <rdfs:comment xml:lang="id">Selain itu perlakuan panas kering juga dapat menjadi alternatif lainnya, seperti perlakuan panas kering pada suhu 55oC yang dapat mengeliminasi Pantoea stewartii pada benih jagung (Nalis et al. 2015) ataupun perendaman benih pada air panas 57oC selama 10 menit (Kadir et al. 2009)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangTanahDemikianPenggunaanBahanBahanAlami">
    <ns1:identifierSumber>CTL_127</ns1:identifierSumber>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Bercak Daun</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:halamanSumber>68</ns1:halamanSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:kutipanNormalisasi xml:lang="id">Namun demikian, penggunaan bahan-bahan alami lebih dianjurkan didahului dengan upaya pencegahan.</ns1:kutipanNormalisasi>
    <ns1:idChunkSumber>DOC002_C068_01</ns1:idChunkSumber>
    <ns1:kutipanSumber xml:lang="id">Namun demikian, penggunaan bahan-bahan alami lebih dianjurkan didahului dengan upaya pencegahan.</ns1:kutipanSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Bercak Daun</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n695264d974974fe6a4344407a3a532dbb32">
