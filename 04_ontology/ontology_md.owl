    <skos:prefLabel xml:lang="id">Malai</skos:prefLabel>
    <rdfs:comment xml:lang="id">Bagian tanaman yang dapat menjadi lokasi gejala.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit blas menjadi salah satu penyakit utama tanaman padi karena dapat menyerang beberapa bagian tanaman seperti daun, buku batang, leher malai, bulir pada, bahkan kolar daun (BBPADI 2015).</rdfs:comment>
    <rdfs:label xml:lang="id">Malai</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#ColletotricumSpp">
    <skos:prefLabel xml:lang="id">Colletotricum spp</skos:prefLabel>
    <ns1:identifierSumber>PAT_102</ns1:identifierSumber>
    <ns1:namaIlmiahPatogen>Colletotricum spp</ns1:namaIlmiahPatogen>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Patogen"/>
