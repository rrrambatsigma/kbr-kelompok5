    <ns1:halamanSumber>31</ns1:halamanSumber>
    <ns1:kutipanSumber xml:lang="id">Pada kondisi lembap, daun akan menggulung dan mudah gugur, sedangkan pada polong akan terlihat acervuli yang membentuk pola cincin konsentris (Gambar 6b).</ns1:kutipanSumber>
