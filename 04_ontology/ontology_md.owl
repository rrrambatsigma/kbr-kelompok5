    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:kutipanSumber xml:lang="id">rolfsii adalah tanaman akan layu, kemudian daun menjadi layu dan menguning, kemudian pada bagian pangkal akar akan muncul tanda berupa kumpulan hifa jamur yang berwarna putih (Gambar 2.1).</ns1:kutipanSumber>
    <ns1:halamanSumber>38</ns1:halamanSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
