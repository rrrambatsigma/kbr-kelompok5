  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#DiplodiaSpp">
    <rdfs:label xml:lang="id">Diplodia spp</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenBusukPangkalBatangUbiKayuSelTabelT52BATANG2"/>
