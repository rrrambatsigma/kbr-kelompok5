    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKerdilKedelaiSoybeanStuntVirusKedelaiPengendalianDilakukanBenihBebasSSV"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangTanahPestisidaDigolongkanMenjadiMacamAntaranya"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiAplikasiInsektisidaDeltametrinDigabungkanPemakaian"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiAdaTerinfeksiMakaSegeraDilakukan"/>
    <ns1:namaPengendalian xml:lang="id">Penggunaan insektisida</ns1:namaPengendalian>
    <skos:prefLabel xml:lang="id">Penggunaan insektisida</skos:prefLabel>
    <rdfs:label xml:lang="id">Penggunaan insektisida</rdfs:label>
    <ns1:deskripsiPengendalian xml:lang="id">Apabila ada tanaman yang terinfeksi maka segera dilakukan eradikasi dan dimusnahkan agar tidak menjadi sumber inokulum, dan apabila perkembangan serangga vektor tinggi maka lakukan penyemprotan menggunakan insektisida berbahan aktif imidakloprid (Inayati and Yusnawan, 2017).</ns1:deskripsiPengendalian>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKimiawi"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Tindakan kanonik penggunaan insektisida.</rdfs:comment>
    <rdfs:comment xml:lang="id">Apabila ada tanaman yang terinfeksi maka segera dilakukan eradikasi dan dimusnahkan agar tidak menjadi sumber inokulum, dan apabila perkembangan serangga vektor tinggi maka lakukan penyemprotan menggunakan insektisida berbahan aktif imidakloprid (Inayati and Yusnawan, 2017).</rdfs:comment>
  </rdf:Description>
