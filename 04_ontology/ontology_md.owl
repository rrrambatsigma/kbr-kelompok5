    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Hawar Bakteri (Bacterial Blight)</rdfs:label>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:kutipanNormalisasi xml:lang="id">Menghilangkan tanaman yang dapat menjadi sumber inokulum dan melakukan seed treatment dengan bakterisida seperti streptomisin (Inayati and Yusnawan, 2017).</ns1:kutipanNormalisasi>
    <ns1:halamanSumber>55</ns1:halamanSumber>
    <ns1:kutipanSumber xml:lang="id">Menghilangkan tanaman yang dapat menjadi sumber inokulum dan melakukan seed treatment dengan bakterisida seperti streptomisin (Inayati and Yusnawan, 2017).</ns1:kutipanSumber>
    <ns1:idChunkSumber>DOC002_C055_02</ns1:idChunkSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PolyporusSulphureus">
    <skos:prefLabel xml:lang="id">Polyporus sulphureus</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Patogen"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Polyporus sulphureus</rdfs:label>
    <rdfs:comment xml:lang="id">Patogen yang tercatat pada sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Akar membusuk, terdapat tubuh buah (jamur) kecil berwarna keputihan dan menguning, di ujung akar dekat pangkal batang,</rdfs:comment>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenBusukAkarUbiKayuSelTabelT53AKAR"/>
    <ns1:menyebabkanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BusukAkarUbiKayu"/>
    <ns1:identifierSumber>PAT_112</ns1:identifierSumber>
    <ns1:namaIlmiahPatogen>Polyporus sulphureus</ns1:namaIlmiahPatogen>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBenih">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="id">Penggunaan Benih</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorBudidaya"/>
    <skos:prefLabel xml:lang="id">Penggunaan Benih</skos:prefLabel>
    <rdfs:comment xml:lang="id">Faktor mutu dan asal benih.</rdfs:comment>
    <rdfs:comment xml:lang="id">Kultur teknis, melalui penggunaan benih sehat, pencabutan tunggul yang terinfeksi, jerami dan gulma dari lahan yang terinfeksi dihilangkan, menghindari pemupukan nitrogen yang berlebihan dan pemberian pupuk K yang berimbang (Sudir et al. 2012; Naqvi 2019), tidak dianjurkan memotong bibit sebelum tanah supaya mencegah terjadinya infeksi patogen dan pola tanam dianjurkan memakai sistem legowo dengan sistem pengairan berselang.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitRebahKecambahKedelaiMunculBenihMembusukAkibatR">
