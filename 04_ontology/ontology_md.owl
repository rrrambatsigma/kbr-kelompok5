    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SolarisasiTanah"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanVarietasTahan"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RotasiTanaman"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanAgensHayati"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanTrichoderma"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBeauveria"/>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SclerotiumRolfsii"/>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:altLabel xml:lang="en">Damping-off</skos:altLabel>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <skos:prefLabel xml:lang="en">Damping-off</skos:prefLabel>
    <skos:prefLabel xml:lang="id">Penyakit Rebah Semai</skos:prefLabel>
    <skos:definition xml:lang="id">Penyakit Rebah Semai pada tanaman Kedelai, disebabkan oleh Sclerotium rolfsii, dengan gejala antara lain Bercak pada tanaman, Busuk batang, Klorosis daun, Layu daun.</skos:definition>
    <kbr:menyerangFase rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePembibitanTanaman"/>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <kbr:identifierSumber>DIS_006</kbr:identifierSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <kbr:deskripsiPenyakit xml:lang="id">Budidaya kedelai (G. max L. Merril) dapat diinfeksi oleh patogen sejak dari pembibitan. Adanya patogen tular tanah yang menginfeksi tanaman pada fase pembibitan menjadi permasalahan utama. Patogen yang menginfeksi kedelai pada persemaian salah satunya oleh jamur Sclerotium rolfsii (Abidin et al., 2015). Patogen S. rolfsii menyebabkan busuk batang atau rebah semai (dumping off). Patogen menginfeksi tanaman melalui akar tanaman kemudian menyebar pada batang tanaman. Gejala yang muncul pada tanaman yang terserang S. rolfsii adalah tanaman akan layu, kemudian daun menjadi layu dan menguning, kemudian pada bagian pangkal akar akan muncul tanda berupa kumpulan hifa jamur yang berwarna putih (Gambar 2.1). Gejala selanjutnya adalah batang tanaman menjadi busuk dan lama-lama tanaman akan mati (Astiko et al., 2017). Pada kondisi lembab jamur S. rolfsii dapat berkembang dan menginfeksi bagian daun dan batang tanaman yang berada di dekat tanah. Perkembangan penyakit terjadi apabila kelembaban tanah tinggi dan suhu</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#TanahJenuhAirDanKelembapanTinggiPadaPenyakitRebahSemaiKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakDaunBaurUbiKayu">
    <rdfs:label xml:lang="id">Bercak daun baur</rdfs:label>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitBercakDaunBaurUbiKayu"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenBercakDaunBaurUbiKayu"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT005"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT006"/>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiKayu"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <kbr:identifierSumber>DIS_029</kbr:identifierSumber>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBercakDaunBaurUbiKayuNekrosisDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBercakDaunBaurUbiKayuBercakDaun"/>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <skos:altLabel xml:lang="en">Cassava brown leaf spot</skos:altLabel>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:prefLabel xml:lang="id">Bercak daun baur</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Cassava brown leaf spot</skos:prefLabel>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <skos:definition xml:lang="id">Penyakit Bercak daun baur pada tanaman Ubi kayu, disebabkan oleh Cercospora. viscosae, dengan gejala antara lain Bercak daun.</skos:definition>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CercosporaViscosae"/>
    <kbr:deskripsiPenyakit xml:lang="id">Bercak berukuran besar, sering dijumpai pada ujung daun dan daun muda,bercak tanpa batas yang jelas, bercak pada permukaan atas daun berwarna coklat dan bagian bawah berwarna keabu-abuan (spora fungi)</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#IklimLembapDanHangatPadaBercakDaunBaurUbiKayu"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengelolaanGulma"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SanitasiLahan"/>
  </rdf:Description>
