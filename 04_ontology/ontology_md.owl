    <ns1:deskripsiGejala xml:lang="id">(2018) menjelaskan bahwa gejala awal ditandai dengan daun yang terinfeksi berwarna kuning pada bagian atas, diikuti menguningnya pada bagian bawah dan lebih cepat pada daun tua.</ns1:deskripsiGejala>
    <rdfs:label xml:lang="id">Klorosis daun pada layu fusarium</rdfs:label>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">(2018) menjelaskan bahwa gejala awal ditandai dengan daun yang terinfeksi berwarna kuning pada bagian atas, diikuti menguningnya pada bagian bawah dan lebih cepat pada daun tua.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitEmbunTepungPowderyMildewKedelaiDiffusaMenginfeksiBagianBawahPermukaan">
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
