    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PyriculariaGrisea"/>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#MagnaportheGrisea"/>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PyriculariaOryzae"/>
