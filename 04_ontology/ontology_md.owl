    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanFungisida"/>
    <rdfs:label xml:lang="id">Penyakit Bercak Daun Mata Katak (Frogeye Leaf Spot)</rdfs:label>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelaiPengaturanJarakTanamTidakMemengaruhi"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelaiBercakTanaman"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelaiBercakDaun"/>
    <ns1:identifierSumber>DIS_012</ns1:identifierSumber>
    <ns1:namaInggrisPenyakit>Frogeye Leaf Spot</ns1:namaInggrisPenyakit>
    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CercosporaSojina"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit bercak daun mata katak (frogeye leaf spot) disebabkan oleh patogen Cercospora sojina K. Hara. Patogen C. sojina menginfeksi pada bagian permukaan daun, batang maupun pada polong kedelai. Infeksi sering terlihat pada bagian permukaan daun. Patogen C. sojina memiliki konidia yang terbentuk pada ujung konidiofor. Konidia berwarna hialin dengan ukuran 5-7 µm x 39-70µm. Konidia merupakan sumber inokulum primer dan sekunder untuk perkembangan penyakit bercak daun mata katak. Gejala yang muncul pada tanaman adalah adanya bercak atau bintik-bintik kecil dengan bagian tengah pada bintik berwarna lebih terang. Bintik pada daun kemudian berkembang menjadi bercak yang lebih lebar dengan pinggiran berwarna lebih coklat sampai kemerahan (Gambar 2.8). Pada intensitas serangan yang bintik menjadi berkembang pada bagian daun hingga menutupi 30% bagian</rdfs:comment>
    <ns1:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <skos:prefLabel xml:lang="id">Penyakit Bercak Daun Mata Katak (Frogeye Leaf Spot)</skos:prefLabel>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <skos:altLabel xml:lang="id">Frogeye Leaf Spot</skos:altLabel>
    <ns1:deskripsiPenyakit xml:lang="id">Penyakit bercak daun mata katak (frogeye leaf spot) disebabkan oleh patogen Cercospora sojina K. Hara. Patogen C. sojina menginfeksi pada bagian permukaan daun, batang maupun pada polong kedelai. Infeksi sering terlihat pada bagian permukaan daun. Patogen C. sojina memiliki konidia yang terbentuk pada ujung konidiofor. Konidia berwarna hialin dengan ukuran 5-7 µm x 39-70µm. Konidia merupakan sumber inokulum primer dan sekunder untuk perkembangan penyakit bercak daun mata katak. Gejala yang muncul pada tanaman adalah adanya bercak atau bintik-bintik kecil dengan bagian tengah pada bintik berwarna lebih terang. Bintik pada daun kemudian berkembang menjadi bercak yang lebih lebar dengan pinggiran berwarna lebih coklat sampai kemerahan (Gambar 2.8). Pada intensitas serangan yang bintik menjadi berkembang pada bagian daun hingga menutupi 30% bagian</ns1:deskripsiPenyakit>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuOptimalPadaPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelai"/>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanRelatifDiAtas90PersenPadaPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelai"/>
  </rdf:Description>
