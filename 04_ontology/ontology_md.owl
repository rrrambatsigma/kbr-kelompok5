    <ns1:identifierSumber>DIS_001</ns1:identifierSumber>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Padi"/>
    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:deskripsiPenyakit xml:lang="id">Penyakit hawar daun bakteri (HDB) atau dikenal dengan nama penyakit kresek dalam bahasa lokal dan bacterial leaf blight dalam bahasa internasional menjadi salah satu penyakit penting pada padi. Kehilangan hasil yang disebabkan oleh penyakit ini dapat beragam dari 15-80% tergantung kondisi tanaman maupun lingkungannya (BBPOPT 2007; Lalitha et al. 2010).</ns1:deskripsiPenyakit>
    <ns1:tingkatKeparahan xml:lang="id">Kehilangan hasil yang disebabkan oleh penyakit ini dapat beragam dari 15-80% tergantung kondisi tanaman maupun lingkungannya (BBPOPT 2007; Lalitha et al. 2010).</ns1:tingkatKeparahan>
  </rdf:Description>
