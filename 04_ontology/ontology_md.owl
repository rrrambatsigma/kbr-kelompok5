  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasBondoyudo">
    <rdfs:comment xml:lang="id">Varietas tanaman yang disebut pada sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Berbagai strategi pengendalian penyakit tungro dijelaskan sebagai berikut meliputi pemusnahan tanaman terinfeksi, penggunaan varietas tahan seperti Tukad Unda, Tukad Balian, Kalimas, dan Bondoyudo, penanaman serempak minimal 20 ha luasan sawah, serta penanaman sebelum puncak kepadatan wereng hijau (Puslitbangtan 2005).</rdfs:comment>
    <ns1:merupakanVarietasDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Padi"/>
    <rdfs:label xml:lang="id">Bondoyudo</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas"/>
    <skos:prefLabel xml:lang="id">Bondoyudo</skos:prefLabel>
    <ns1:tahanTerhadap rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitTungroPadi"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiVarietasPadiBerbagaiStrategiPengendalianDijelaskanBerikut"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKaratDaunJagungBintilPecahSporaKeluarTerbawa">
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKaratDaunJagungBintilPecahSporaKeluarTerbawa"/>
    <ns1:deskripsiGejala xml:lang="id">Jika bintil pecah, spora akan keluar dan terbawa angin maupun percikan air hujan sehingga menjadi sumber inokulum baru dan dapat menginfeksi tanaman lain.</ns1:deskripsiGejala>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunJagung"/>
    <rdfs:label xml:lang="id">Pengamatan gejala Penyakit Karat Daun</rdfs:label>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang belum dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Jika bintil pecah, spora akan keluar dan terbawa angin maupun percikan air hujan sehingga menjadi sumber inokulum baru dan dapat menginfeksi tanaman lain.</rdfs:comment>
    <skos:prefLabel xml:lang="id">Pengamatan gejala Penyakit Karat Daun</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Biji">
    <skos:prefLabel xml:lang="id">Biji</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BagianTanaman"/>
    <rdfs:comment xml:lang="id">Bagian tanaman yang dapat menjadi lokasi gejala.</rdfs:comment>
    <rdfs:comment xml:lang="id">Senyawa fenolik, tanin, antosianin, dan isoflavon terkandung pada biji kedelai (Nurrahman, 2015).</rdfs:comment>
    <rdfs:label xml:lang="id">Biji</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBulaiJagungKecepatanAnginKelembaban90Suhu">
