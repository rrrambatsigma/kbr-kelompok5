  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBulaiJagungDisebabkanBervariasi1933Sampai">
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Bulai</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:halamanSumber>105</ns1:halamanSumber>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Bulai</rdfs:label>
    <ns1:kutipanNormalisasi xml:lang="id">Kejadian penyakit yang disebabkan penyakit bulai bervariasi antara 19.33% sampai 28.37% dan bergantung pada kondisi lingkungan tiap wilayah (Kurniawan et al., 2017).</ns1:kutipanNormalisasi>
    <ns1:identifierSumber>SYM_196</ns1:identifierSumber>
    <ns1:kutipanSumber xml:lang="id">Kejadian penyakit yang disebabkan penyakit bulai bervariasi antara 19.33% sampai 28.37% dan bergantung pada kondisi lingkungan tiap wilayah (Kurniawan et al., 2017).</ns1:kutipanSumber>
    <ns1:idChunkSumber>DOC002_C105_02</ns1:idChunkSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
