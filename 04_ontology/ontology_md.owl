    <kbr:namaInggrisPenyakit>Powdery Mildew</kbr:namaInggrisPenyakit>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:prefLabel xml:lang="en">Powdery Mildew</skos:prefLabel>
    <skos:prefLabel xml:lang="id">Penyakit Embun Tepung (Powdery Mildew)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <skos:definition xml:lang="id">Penyakit Embun Tepung (Powdery Mildew) pada tanaman Kedelai, disebabkan oleh Erysiphae diffusa, dengan gejala antara lain Bercak daun, Tepung pada daun.</skos:definition>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitEmbunTepungPowderyMildewKedelaiBercakDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitEmbunTepungPowderyMildewKedelaiTepungDaun"/>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <rdfs:label xml:lang="id">Penyakit Embun Tepung (Powdery Mildew)</rdfs:label>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#ErysiphaeDiffusa"/>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit ini disebabkan oleh cendawan Erysiphae diffusa yang menginfeksi tanaman kedelai. Patogen E. diffusa menginfeksi daun kedelai bagian bawah sehingga pada permukaan daun bagian bawah terdapat bercak berwarna putih seperti tepung yang merupakan kumpulan dari konidia dan konidiofor patogen</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuPadaPenyakitEmbunTepungPowderyMildewKedelai"/>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanRendahDenganDaunBasahTerbatasPadaPenyakitEmbunTepungPowderyMildewKedelai"/>
  </rdf:Description>
