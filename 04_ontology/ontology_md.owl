    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelaiBintikKemudianBerkembangMenjadiLebar">
