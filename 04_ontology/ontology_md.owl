    <kbr:identifierSumber>PLANT_006</kbr:identifierSumber>
    <rdfs:label xml:lang="id">Jagung</rdfs:label>
    <skos:altLabel xml:lang="id">Zea mays</skos:altLabel>
    <skos:altLabel xml:lang="id">jagung</skos:altLabel>
    <skos:definition xml:lang="id">Tanaman pangan serealia penghasil tongkol jagung yang digunakan sebagai bahan pangan dan pakan.</skos:definition>
    <rdfs:seeAlso rdf:resource="https://powo.science.kew.org/results?q=Zea%20mays"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:prefLabel xml:lang="id">Jagung</skos:prefLabel>
    <kbr:deskripsiTanaman xml:lang="id">Jagung merupakan salah satu komoditas pangan yang mempunyai nilai ekonomi penting di Indonesia dan menempati urutan kedua setelah padi. Sebagai salah satu alternatif tanaman pangan pengganti beras (upaya diversifikasi pangan), jagung mempunyai kandungan gizi yang hampir sama dengan beras, yaitu berupa karbohidrat, protein, lemak, serat dan gula. Pemanfaatan jagung di Indonesia umumnya untuk konsumsi langsung, benih, bahan baku industri pakan ternak, industri pangan dan non pangan, pakan ternak dan sebagai bahan bakar.</kbr:deskripsiTanaman>
    <kbr:memilikiKondisiTumbuh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiSuhuSedang"/>
    <kbr:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePerkecambahanJagung"/>
    <kbr:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaseVegetatifJagung"/>
    <kbr:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaseGeneratifJagung"/>
    <kbr:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePemasakanJagung"/>
  </rdf:Description>
