    <rdfs:comment xml:lang="id">Varietas tanaman yang disebut pada sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Namun, Ulhaq and Masnilah, (2019) mengatakan bahwa varietas Pioneer 21 termasuk agak rentan dan varietas yang tahan terhadap penyakit bulai adalah Pioneer 27.</rdfs:comment>
    <rdfs:label xml:lang="id">Pioneer 27</rdfs:label>
    <skos:prefLabel xml:lang="id">Pioneer 27</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
