    <skos:prefLabel xml:lang="id">Penggunaan benih sehat</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <skos:definition xml:lang="id">Menggunakan benih sehat, bersertifikat, atau bebas patogen untuk mencegah infeksi awal.</skos:definition>
    <rdfs:comment xml:lang="id">Tindakan kanonik penggunaan benih sehat atau bersertifikat.</rdfs:comment>
    <rdfs:label xml:lang="id">Penggunaan benih sehat</rdfs:label>
    <kbr:deskripsiPengendalian xml:lang="id">Penggunaan benih sehat yang bebas penyakit, dapat pula dilakukan perlakuan benih dengan larutan amonium sulfat maupun larutan garam untuk memisahkan benih yang cukup matang kemudian dilanjutkan dengan desinfeksi benih dengan fungisida Praktik budidaya diperhatikan untuk mencegah padi terinfeksi blas seperti pengaturan pengairan supaya tidak terjadi kekeringan karena padi rentan blas saat kekeringan.</kbr:deskripsiPengendalian>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:altLabel xml:lang="id">penggunaan benih sehat</skos:altLabel>
    <kbr:namaPengendalian xml:lang="id">Penggunaan benih sehat</kbr:namaPengendalian>
  </rdf:Description>
