    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBercakDaunKacangTanah"/>
    <ns1:deskripsiGejala xml:lang="id">Inang kedua patogen ini hanya kacang tanah, Cercospora personata bercak relatif lambat muncul, berukuran lebih kecil, berwarna coklat gelap sampai hitam, sporulasi cendawan lebih banyak di permukaan bawah daun.</ns1:deskripsiGejala>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Gejala bercak daun pada tanaman Kacang tanah: Inang kedua patogen ini hanya kacang tanah, Cercospora personata bercak...</rdfs:comment>
    <rdfs:comment xml:lang="id">Inang kedua patogen ini hanya kacang tanah, Cercospora personata bercak relatif lambat muncul, berukuran lebih kecil, berwarna coklat gelap sampai hitam, sporulasi cendawan lebih banyak di permukaan bawah daun.</rdfs:comment>
    <rdfs:label xml:lang="id">Bercak daun pada Penyakit Bercak Daun (Kacang tanah)</rdfs:label>
    <skos:prefLabel xml:lang="id">Bercak daun pada Penyakit Bercak Daun (Kacang tanah)</skos:prefLabel>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakDaun"/>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangTanah"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaseVegetatif">
    <rdfs:label xml:lang="id">Fase Vegetatif</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="id">Fase Vegetatif</skos:prefLabel>
    <rdfs:comment xml:lang="id">Fase pertumbuhan vegetatif.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit bulai menyerang tanaman pada fase vegetatif dan infeksi akan berkurang saat tanaman semakin tua karena semakin dewasa tanaman akan lebih tahan terhadap penyakit bulai (Purwanto et al., 2016).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePertumbuhan"/>
  </rdf:Description>
