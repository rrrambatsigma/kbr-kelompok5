  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitEmbunTepungPowderyMildewKedelai">
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SanitasiLahan"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PemupukanBerimbang"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanAgensHayati"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RotasiTanaman"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit ini disebabkan oleh cendawan Erysiphae diffusa yang menginfeksi tanaman kedelai. Patogen E. diffusa menginfeksi daun kedelai bagian bawah sehingga pada permukaan daun bagian bawah terdapat bercak berwarna putih seperti tepung yang merupakan kumpulan dari konidia dan konidiofor patogen</rdfs:comment>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:altLabel xml:lang="id">Powdery Mildew</skos:altLabel>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitEmbunTepungPowderyMildewKedelaiPengendalianDilakukanMelakukanRotasiMengganti"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitEmbunTepungPowderyMildewKedelaiMenekanTepungPepayaFirnandoEt"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitEmbunTepungPowderyMildewKedelaiDisebabkanCendawanErysiphaeDiffusaMenginfeksi"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitEmbunTepungPowderyMildewKedelaiMelakukanEradikasiMenjadiInokulum"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitPenyakitEmbunTepungPowderyMildewKedelaiTepungPowderyMildew"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitEmbunTepungPowderyMildewKedelaiAplikasiPupukKandangPemberianAgens"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitEmbunTepungPowderyMildewKedelaiPengendalianAgensHayatiCendawanLecanicillium"/>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanAgensHayati"/>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RotasiTanaman"/>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SanitasiLahan"/>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PemupukanBerimbang"/>
    <ns1:identifierSumber>DIS_010</ns1:identifierSumber>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#ErysiphaeDiffusa"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitEmbunTepungPowderyMildewKedelaiBercakDaun"/>
    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <rdfs:label xml:lang="id">Penyakit Embun Tepung (Powdery Mildew)</rdfs:label>
    <ns1:namaInggrisPenyakit>Powdery Mildew</ns1:namaInggrisPenyakit>
    <skos:prefLabel xml:lang="id">Penyakit Embun Tepung (Powdery Mildew)</skos:prefLabel>
    <ns1:deskripsiPenyakit xml:lang="id">Penyakit ini disebabkan oleh cendawan Erysiphae diffusa yang menginfeksi tanaman kedelai. Patogen E. diffusa menginfeksi daun kedelai bagian bawah sehingga pada permukaan daun bagian bawah terdapat bercak berwarna putih seperti tepung yang merupakan kumpulan dari konidia dan konidiofor patogen</ns1:deskripsiPenyakit>
  </rdf:Description>
