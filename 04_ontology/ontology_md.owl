  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBusukPelepahJagung">
    <skos:altLabel xml:lang="en">Sheath rot</skos:altLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Penyakit Busuk Pelepah</rdfs:label>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBusukPelepahJagungBusukBatang"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBusukPelepahJagungBercakTanaman"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBacillus"/>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Buah"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitPenyakitBusukPelepahJagung"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBusukPelepahJagung"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitBusukPelepahJagung"/>
    <skos:prefLabel xml:lang="id">Penyakit Busuk Pelepah</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Sheath rot</skos:prefLabel>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Jagung"/>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RhizoctoniaSolani"/>
    <skos:definition xml:lang="id">Penyakit Busuk Pelepah pada tanaman Jagung, disebabkan oleh Rhizoctonia solani, dengan gejala antara lain Bercak pada tanaman, Busuk batang.</skos:definition>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBacillus"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <kbr:identifierSumber>DIS_048</kbr:identifierSumber>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit busuk pelepah disebabkan oleh jamur patogen Rhizoctonia solani. Patogen ini termasuk soil borne yang artinya merupakan patogen tular tanah sehingga dapat bertahan di tanah dan juga sisa tanaman dalam bentuk sklerotium. Sklerotium merupakan massa hifa yang mengumpul dan memadat yang awalnya berwarna putih dan kemudian berubah menjadi berwarna coklat. Jamur ini mempunyai banyak inang alternatif seperti tanaman kacang tanah, kedelai, kacang hijau dan sorgum (Soenartiningsih et al., 2015).</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuMinimal30CPadaPenyakitBusukPelepahJagung"/>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanTinggiPadaPenyakitBusukPelepahJagung"/>
  </rdf:Description>
