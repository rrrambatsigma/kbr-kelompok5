  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanJarakTanam">
    <kbr:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitHawarPelepahDaunPadi"/>
    <kbr:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai"/>
    <kbr:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangHijau"/>
    <kbr:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunJagung"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKaratDaunJagung2"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumUbiKayu3"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangHijau3"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottle3"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarPelepahDaunPadi"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT032"/>
    <skos:definition xml:lang="id">Mengatur jarak atau kerapatan tanam agar sirkulasi udara dan cahaya lebih baik.</skos:definition>
    <kbr:deskripsiPengendalian xml:lang="id">Beberapa pengendalian penyakit hawar daun bakteri pada padi, di antaranya Kultur teknis, melalui pengaturan jarak tanam tidak terlalu rapat, pengeringan sawah beberapa hari pada saat anakan maksimum, pemusnahan atau pengomposan sisa-sisa tanaman yang terinfeksi (Puslitbangtan 2005).</kbr:deskripsiPengendalian>
    <skos:prefLabel xml:lang="id">Pengaturan jarak tanam</skos:prefLabel>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <rdfs:comment xml:lang="id">Tindakan kanonik pengaturan jarak atau kerapatan tanam.</rdfs:comment>
    <skos:altLabel xml:lang="id">pengaturan jarak tanam</skos:altLabel>
    <kbr:namaPengendalian xml:lang="id">Pengaturan jarak tanam</kbr:namaPengendalian>
    <rdfs:label xml:lang="id">Pengaturan jarak tanam</rdfs:label>
  </rdf:Description>
