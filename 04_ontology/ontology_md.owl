  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumKacangTanahSelainPestisidaNabatiMencegahSerangga">
    <ns1:idChunkSumber>DOC002_C067_01</ns1:idChunkSumber>
