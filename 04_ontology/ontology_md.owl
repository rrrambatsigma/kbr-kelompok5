  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKerdilKedelaiSoybeanStuntVirusKedelai">
    <skos:prefLabel xml:lang="id">Gejala pada Penyakit Kerdil Kedelai (Soybean Stunt Virus) (Kedelai): yang menusukkan alat mulut stylet pada tanaman sehat sehingga virus...</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Gejala pada Penyakit Kerdil Kedelai (Soybean Stunt Virus) (Kedelai): yang menusukkan alat mulut stylet pada tanaman sehat sehingga virus...</rdfs:label>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKerdilKedelaiSoybeanStuntVirusKedelai"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKerdilKedelaiSoybeanStuntVirusKedelai4"/>
    <rdfs:comment xml:lang="id">Gejala pada tanaman Kedelai: yang menusukkan alat mulut stylet pada tanaman sehat sehingga virus...</rdfs:comment>
    <rdfs:comment xml:lang="id">yang menusukkan alat mulut stylet pada tanaman sehat sehingga virus akan memperbanyak diri dan membentuk partikel virus yang baru pada tanaman yang sehat sehingga tanaman yang sehat akan terinfeksi dan menunjukkan gejala sesuai dengan virus yang ditularkan oleh serangga vektor.</rdfs:comment>
    <ns1:deskripsiGejala xml:lang="id">yang menusukkan alat mulut stylet pada tanaman sehat sehingga virus akan memperbanyak diri dan membentuk partikel virus yang baru pada tanaman yang sehat sehingga tanaman yang sehat akan terinfeksi dan menunjukkan gejala sesuai dengan virus yang ditularkan oleh serangga vektor.</ns1:deskripsiGejala>
  </rdf:Description>
