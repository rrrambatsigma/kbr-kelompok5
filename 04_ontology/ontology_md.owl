    <skos:altLabel xml:lang="en">Downy mildew</skos:altLabel>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <rdfs:label xml:lang="id">Penyakit Bulai</rdfs:label>
    <skos:prefLabel xml:lang="id">Penyakit Bulai</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Downy mildew</skos:prefLabel>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:identifierSumber>DIS_046</kbr:identifierSumber>
    <skos:definition xml:lang="id">Penyakit Bulai pada tanaman Jagung, disebabkan oleh Peronosclerospora maydis, Peronosclerospora sp, dengan gejala antara lain Kerdil tanaman, Klorosis daun, Pertumbuhan terhambat, Tepung pada daun.</skos:definition>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit bulai disebabkan oleh jamur patogen Peronosclerospora sp. (Rustiani et al., 2015) melaporkan bahwa jamur patogen penyebab penyakit bulai di Indonesia ada tiga jenis yaitu Peronosclerospora maydis, P. sorghi dan P. philippinensis.Konidia P.maydis berbentuk bulat dan ditemukan di wilayah</kbr:deskripsiPenyakit>
  </rdf:Description>
