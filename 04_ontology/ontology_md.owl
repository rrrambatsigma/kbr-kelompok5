    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#HelminthosporiumMaydis"/>
    <ns1:identifierSumber>DIS_044</ns1:identifierSumber>
    <ns1:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <skos:prefLabel xml:lang="id">Penyakit Hawar Daun</skos:prefLabel>
    <ns1:deskripsiPenyakit xml:lang="id">Penyakit hawar daun pada jagung disebabkan oleh jamur patogen Helminthosporium maydis Y. Nisik &amp; C.Miyake (Kuilya et al., 2018; Hamidson, Suwandi and Effendy, 2019) atau Helminthosporium turticum (Pass.) Leonard et Suggs (Faizah, 2017). Koloni Helinthosporium maydis yang ditumbuhkan pada media PDA awalnya berwarna keputihan kusam, coklat pucat, selanjutnya menjadi berwarna coklat agak gelap. Hifanya bersekat dengan sekat agak longgar. Konidia berdinding tipis dan mempunyai 7-10 sekat. Setelah 8 hari ditumbuhkan pada media PDA, panjang diameter mencapai 8.75 cm.</ns1:deskripsiPenyakit>
  </rdf:Description>
