  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaCassavaMosaicBegomovirusCMBsUbiKayuKlorosisDaun">
    <skos:prefLabel xml:lang="id">Klorosis daun</skos:prefLabel>
    <kbr:deskripsiGejala xml:lang="id">Tampak motif mosaik berwarna kuning atau pun keputihan pada daun hijau,serta menyebabkan daun keriting atau ukuran daun mengecil</kbr:deskripsiGejala>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
