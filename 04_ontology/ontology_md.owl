  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Begomovirus">
    <ns1:menyebabkanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#TanamanKerdilStuntUbiKayu"/>
    <ns1:menyebabkanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CassavaMosaicBegomovirusCMBsUbiKayu"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Patogen"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenCassavaMosaicBegomovirusCMBsUbiKayuSelTabelT51Baris"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenTanamanKerdilStuntUbiKayuSelTabelT52BATANG"/>
    <ns1:identifierSumber>PAT_105</ns1:identifierSumber>
    <ns1:namaIlmiahPatogen>Begomovirus</ns1:namaIlmiahPatogen>
    <skos:prefLabel xml:lang="id">Begomovirus</skos:prefLabel>
    <rdfs:comment xml:lang="id">Patogen yang tercatat pada sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pada tanaman yang terinfeksi *Begomovirus* yang menyebabkan gejala mosaik dan tanaman kerdil (stunt) diketahui mengakibatkan penghambatan pertumbuhan dan perkembangan akar serta menghambat pembentukan umbi.</rdfs:comment>
    <rdfs:label xml:lang="id">Begomovirus</rdfs:label>
  </rdf:Description>
