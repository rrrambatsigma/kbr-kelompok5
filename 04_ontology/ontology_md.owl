  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBusukHitamBlackRotUbiJalarPenyebaranHitamMelaluiLukaSetek">
    <ns1:idChunkSumber>DOC002_C087_02</ns1:idChunkSumber>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit busuk hitam (black rot)</rdfs:label>
    <ns1:halamanSumber>87</ns1:halamanSumber>
    <ns1:kutipanSumber xml:lang="id">Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020).</ns1:kutipanSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit busuk hitam (black rot)</skos:prefLabel>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:identifierSumber>SYM_174</ns1:identifierSumber>
    <ns1:kutipanNormalisasi xml:lang="id">Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020).</ns1:kutipanNormalisasi>
  </rdf:Description>
