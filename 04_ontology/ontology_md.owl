  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaHawarDaunBakteriUbiKayu">
    <kbr:kutipanNormalisasi xml:lang="id">Gejala khas berupa bercak atau lesi berair (eksudat seperti getah berwarna krem) pada tangkai daun tanaman terinfeksi. Pada daun gejala muncul urat atau tulang daun,tepi dan ujung bilah daun. Perkembangan infeksi lebih lanjut bercak tersebut menyatu membentuk hawar/bercak coklat besar, daun mengering atau layu, daun gugur.</kbr:kutipanNormalisasi>
    <rdfs:label xml:lang="id">Bukti gejala Hawar daun bakteri (Ubi kayu)</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:idBlokSumber>DOC002_P092_B001</kbr:idBlokSumber>
    <kbr:kutipanSumber xml:lang="id">Gejala khas berupa bercak atau lesi berair (eksudat seperti getah berwarna krem) pada tangkai daun tanaman terinfeksi. Pada daun gejala muncul urat atau tulang daun,tepi dan ujung bilah daun. Perkembangan infeksi lebih lanjut bercak tersebut menyatu membentuk hawar/bercak coklat besar, daun mengering atau layu, daun gugur.</kbr:kutipanSumber>
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <kbr:identifierSumber>T5.1_DAUN#6</kbr:identifierSumber>
    <skos:prefLabel xml:lang="id">Bukti gejala Hawar daun bakteri (Ubi kayu)</skos:prefLabel>
    <kbr:halamanSumber>92</kbr:halamanSumber>
  </rdf:Description>
