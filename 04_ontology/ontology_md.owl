    <rdfs:label xml:lang="id">Bercak daun pada Bercak daun baur (Ubi kayu)</rdfs:label>
    <ns1:deskripsiGejala xml:lang="id">Bercak berukuran besar, sering dijumpai pada ujung daun dan daun muda,bercak tanpa batas yang jelas, bercak pada permukaan atas daun berwarna coklat dan bagian bawah berwarna keabu-abuan (spora fungi)</ns1:deskripsiGejala>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakDaunBaurUbiKayu"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
  </rdf:Description>
