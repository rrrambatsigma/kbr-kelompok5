  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengairan">
    <rdfs:label xml:lang="id">Pengairan</rdfs:label>
    <skos:prefLabel xml:lang="id">Pengairan</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorBudidaya"/>
    <rdfs:comment xml:lang="id">Faktor pengairan.</rdfs:comment>
    <rdfs:comment xml:lang="id">Kultur teknis, melalui penggunaan benih sehat, pencabutan tunggul yang terinfeksi, jerami dan gulma dari lahan yang terinfeksi dihilangkan, menghindari pemupukan nitrogen yang berlebihan dan pemberian pupuk K yang berimbang (Sudir et al. 2012; Naqvi 2019), tidak dianjurkan memotong bibit sebelum tanah supaya mencegah terjadinya infeksi patogen dan pola tanam dianjurkan memakai sistem legowo dengan sistem pengairan berselang.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n654de723afb946cca3ef9aa2b4df114cb68">
    <rdf:rest rdf:nodeID="n654de723afb946cca3ef9aa2b4df114cb69"/>
    <rdf:first rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Bakteri"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n654de723afb946cca3ef9aa2b4df114cb34">
    <owl:oneOf rdf:nodeID="n654de723afb946cca3ef9aa2b4df114cb35"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBakteriPustulKedelaiDaunRontok">
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Polong"/>
    <rdfs:label xml:lang="id">Daun rontok pada Penyakit Bakteri Pustul</rdfs:label>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#DaunRontok"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBakteriPustulKedelaiSelanjutnyaTerinfeksiRontokAkibatIntensitas"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPolong"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <skos:prefLabel xml:lang="id">Daun rontok pada Penyakit Bakteri Pustul</skos:prefLabel>
    <ns1:deskripsiGejala xml:lang="id">Gejala selanjutnya adalah daun yang terinfeksi akan rontok akibat intensitas serangan yang tinggi sehingga akan mengganggu proses fotosintesis dan berpengaruh terhadap pengisian polong.</ns1:deskripsiGejala>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBakteriPustulKedelai"/>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala selanjutnya adalah daun yang terinfeksi akan rontok akibat intensitas serangan yang tinggi sehingga akan mengganggu proses fotosintesis dan berpengaruh terhadap pengisian polong.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RekomendasiPengendalian">
