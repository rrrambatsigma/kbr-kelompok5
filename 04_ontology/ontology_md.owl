  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBenihSehat">
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBlasPadiPenggunaanBenihSehatBebasPula"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanahBenihSehatBebasMerupakanAwal"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuBakteriKacangTanahSolanacearumMerupakanTerdiriAtasBeragam"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitEmbunPalsuDownyMildewKedelaiBenihSehatMembantuMenghambatTerjadinya"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarDaunBakteriPadiPengendalianAntaranyaKulturTeknisMelalui"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitAntraknosaKedelaiPenggunaanBenihSehatMenjaminTidak"/>
    <rdfs:comment xml:lang="id">Tindakan kanonik penggunaan benih sehat atau bersertifikat.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penggunaan benih sehat yang bebas penyakit, dapat pula dilakukan perlakuan benih dengan larutan amonium sulfat maupun larutan garam untuk memisahkan benih yang cukup matang kemudian dilanjutkan dengan desinfeksi benih dengan fungisida Praktik budidaya diperhatikan untuk mencegah padi terinfeksi blas seperti pengaturan pengairan supaya tidak terjadi kekeringan karena padi rentan blas saat kekeringan.</rdfs:comment>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitAntraknosaKedelai"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBlasPadi"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLayuBakteriKacangTanah"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitHawarDaunBakteriPadi"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBelangMottleKacangTanah"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitEmbunPalsuDownyMildewKedelai"/>
    <ns1:deskripsiPengendalian xml:lang="id">Penggunaan benih sehat yang bebas penyakit, dapat pula dilakukan perlakuan benih dengan larutan amonium sulfat maupun larutan garam untuk memisahkan benih yang cukup matang kemudian dilanjutkan dengan desinfeksi benih dengan fungisida Praktik budidaya diperhatikan untuk mencegah padi terinfeksi blas seperti pengaturan pengairan supaya tidak terjadi kekeringan karena padi rentan blas saat kekeringan.</ns1:deskripsiPengendalian>
    <rdfs:label xml:lang="id">Penggunaan benih sehat</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <ns1:namaPengendalian xml:lang="id">Penggunaan benih sehat</ns1:namaPengendalian>
    <skos:prefLabel xml:lang="id">Penggunaan benih sehat</skos:prefLabel>
  </rdf:Description>
