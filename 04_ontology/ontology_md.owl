  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarDaunBakteriPadi">
    <ns1:idChunkSumber>DOC002_C028_01</ns1:idChunkSumber>
    <ns1:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ns1:catatanKualitas>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:halamanSumber>28</ns1:halamanSumber>
    <ns1:kutipanSumber xml:lang="id">Beberapa pengendalian penyakit hawar daun bakteri pada padi, di antaranya Kultur teknis, melalui penggunaan benih sehat, pencabutan tunggul yang terinfeksi, jerami dan gulma dari lahan yang terinfeksi dihilangkan, menghindari pemupukan nitrogen yang berlebihan dan pemberian pupuk K yang berimbang (Sudir et al.</ns1:kutipanSumber>
    <ns1:identifierSumber>CTL_001</ns1:identifierSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
