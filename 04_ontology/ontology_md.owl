    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:kutipanNormalisasi xml:lang="id">Aplikasi air rimpang lengkuas mampu menekan perkembangan patogen pada benih kedelai sebesar 76,2% dengan konsentrasi 100% dibandingkan fungisida berbahan aktif metalaksil (Yulia et al., 2015).</kbr:kutipanNormalisasi>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Antraknosa (Kedelai)</skos:prefLabel>
    <kbr:idChunkSumber>DOC002_C050_02</kbr:idChunkSumber>
    <kbr:identifierSumber>CTL_079</kbr:identifierSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitLayuKacangHijau3">
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC005"/>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Layu (Kacang hijau)</skos:prefLabel>
    <kbr:halamanSumber>64</kbr:halamanSumber>
    <kbr:kutipanNormalisasi xml:lang="id">Miselia berwarna putih akan ditemukan di sekitar gejala, dan pada gejala tingkat lanjut akan ditemukan sejumlah sclerosia pada akar (Jin Hyeuk 2017) dan daun dekat permukaan tanah (Gambar 25).</kbr:kutipanNormalisasi>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Layu (Kacang hijau)</rdfs:label>
    <kbr:kutipanSumber xml:lang="id">Miselia berwarna putih akan ditemukan di sekitar gejala, dan pada gejala tingkat lanjut akan ditemukan sejumlah sclerosia pada akar (Jin Hyeuk 2017) dan daun dekat permukaan tanah (Gambar 25).</kbr:kutipanSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <kbr:dokumenSumber>DOC005</kbr:dokumenSumber>
    <kbr:idChunkSumber>DOC005_C064_03</kbr:idChunkSumber>
    <kbr:identifierSumber>SYM_626</kbr:identifierSumber>
  </rdf:Description>
