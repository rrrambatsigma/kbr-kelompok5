  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CurahHujan">
    <rdfs:label xml:lang="id">Curah Hujan</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="id">Curah Hujan</skos:prefLabel>
    <rdfs:comment xml:lang="id">Faktor curah hujan.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pengendalian patogen Fusarium spp. dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorLingkungan"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#terdapatPada">
    <skos:prefLabel xml:lang="id">terdapat pada</skos:prefLabel>
    <rdfs:comment xml:lang="id">Gejala diamati pada bagian tanaman tertentu.</rdfs:comment>
    <rdfs:domain rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="id">terdapat pada</rdfs:label>
    <rdfs:range rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BagianTanaman"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasKalimas">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Varietas tanaman yang disebut sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Berbagai strategi pengendalian penyakit tungro dijelaskan sebagai berikut meliputi pemusnahan tanaman terinfeksi, penggunaan varietas tahan seperti Tukad Unda, Tukad Balian, Kalimas, dan Bondoyudo, penanaman serempak minimal 20 ha luasan sawah, serta penanaman sebelum puncak kepadatan wereng hijau (Puslitbangtan 2005).</rdfs:comment>
    <rdfs:label xml:lang="id">Kalimas</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiVarietasPadi"/>
    <ns1:tahanTerhadap rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitTungroPadi"/>
    <ns1:merupakanVarietasDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Padi"/>
    <skos:prefLabel xml:lang="id">Kalimas</skos:prefLabel>
  </rdf:Description>
