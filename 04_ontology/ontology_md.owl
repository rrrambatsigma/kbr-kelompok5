    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBercakBijiUnguKedelaiHawarDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBercakBijiUnguKedelaiNekrosisDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBercakBijiUnguKedelaiBercakTanaman"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanFungisida"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PerlakuanBenih"/>
    <skos:prefLabel xml:lang="en">Purple seed stain</skos:prefLabel>
    <skos:prefLabel xml:lang="id">Penyakit Bercak Biji Ungu</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <skos:altLabel xml:lang="en">Purple seed stain</skos:altLabel>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanFungisida"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PerlakuanBenih"/>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <kbr:identifierSumber>DIS_015</kbr:identifierSumber>
    <rdfs:label xml:lang="id">Penyakit Bercak Biji Ungu</rdfs:label>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Biji"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CercosporaKikuchii"/>
    <skos:definition xml:lang="id">Penyakit Bercak Biji Ungu pada tanaman Kedelai, disebabkan oleh Cercospora kikuchii, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Hawar daun, Nekrosis daun.</skos:definition>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit bercak biji ungu atau juga dikenal dengan hawar daun Cercospora merupakan penyakit pada tanaman kedelai yang disebabkan oleh patogen Cercospora kikuchii. Penyakit bercak biji ungu atau hawar daun Cercospora merupakan penyakit yang penting juga pada tanaman kedelai karena dapat menyebabkan kehilangan hasil. Patogen C. kikuchii dapat menginfeksi bagian tanaman kedelai seperti daun, batang dan polong (Cai and Schneider, 2008). Gejala pada tanaman kedelai yang terinfeksi patogen C. kikuchii adalah adanya perubahan warna daun menjadi ungu muda pada permukaan daun atas yang biasanya dimulai pada bagian pinggir daun kemudian dapat melebar dan luas hingga menutupi seluruh permukaan daun tanaman kedelai berwarna ungu. Gejala ini biasanya dianggap sebagai gejala karena pengaruh cahaya matahari.</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanTinggiDanSuhuHangatPadaPenyakitBercakBijiUnguKedelai"/>
  </rdf:Description>
