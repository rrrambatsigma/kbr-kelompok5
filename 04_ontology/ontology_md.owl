    <ns1:deskripsiPengendalian xml:lang="id">Ruang penyimpanan diatur pada suhu 13-16° C dengan kelembaban 85% agar perkembangan penyakit lambat (Clark and Moyer, 2013).</ns1:deskripsiPengendalian>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#LayuFusariumUbiJalar"/>
