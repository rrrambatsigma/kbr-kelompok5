  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiTanahJenuhAirDanKelembapanTinggiPadaPenyakitRebahSemaiKedelai">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Tanah jenuh air dan kelembapan tinggi pada Penyakit Rebah Semai</rdfs:label>
    <ns1:dokumenSumber>SRC_EXT_028</ns1:dokumenSumber>
    <ns1:identifierSumber>Southern blight disease development</ns1:identifierSumber>
    <ns1:kutipanSumber>In addition to temperature effects, hyphal growth and sclerotia germination require a water-saturated soil. High humidity also favors fungal development.</ns1:kutipanSumber>
    <ns1:kutipanNormalisasi>In addition to temperature effects, hyphal growth and sclerotia germination require a water-saturated soil. High humidity also favors fungal development.</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=direct</ns1:catatanKualitas>
    <rdfs:comment xml:lang="id">Bukti sumber: Tanah jenuh air dan kelembapan tinggi pada Penyakit Rebah Semai; SRC_EXT_028.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBiji">
    <skos:prefLabel xml:lang="id">Gejala Biji</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdfs:label xml:lang="id">Gejala Biji</rdfs:label>
    <rdfs:comment xml:lang="id">Gejala yang diamati pada biji.</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala lanjut pada daun dapat menyebabkan bentuk dan warna daun tidak normal, biji mengalami distorsi, perubahan warna dan lesi, pada batang akan nampak gejala dieback, kerdil dan roset, sedangkan pada keseluruhan tanaman menjadi kerdil.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumKacangTanahKeamananHayatiProdukPertanianSemakin">
    <ns1:kutipanNormalisasi xml:lang="id">Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati.</ns1:kutipanNormalisasi>
    <rdfs:label xml:lang="id">Bukti pengendalian umum Kacang tanah</rdfs:label>
    <ns1:kutipanSumber xml:lang="id">Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati.</ns1:kutipanSumber>
    <ns1:idChunkSumber>DOC002_C077_02</ns1:idChunkSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
