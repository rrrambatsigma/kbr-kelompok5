    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <ns1:kutipanSumber xml:lang="id">Pemanjangan ruas batang yang berlebihan, sehingga batang terbentuk tipis dan lemah dibandingkan tanaman sehat. Gejala pada daun dan tangkai daun di batang muda, deformasi berkembang berasosisi dengan gejala kanker.</ns1:kutipanSumber>
    <skos:prefLabel xml:lang="id">Bukti gejala Superelongasi</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanLayuFusariumUbiJalarNekrosisTanaman">
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#NekrosisTanaman"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <skos:prefLabel xml:lang="id">Nekrosis pada tanaman pada layu fusarium</skos:prefLabel>
    <ns1:deskripsiGejala xml:lang="id">Selain itu, terjadi nekrosis pada bagian vaskular batang dengan perubahan warna coklat menjadi ungu yang disertai pecahnya korteks batang dan miselium tumbuh pada permukaan batang yang terinfeksi (Gambar 1G dan F).</ns1:deskripsiGejala>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaLayuFusariumUbiJalarSelainTerjadiNekrosisBagianVaskular"/>
    <rdfs:label xml:lang="id">Nekrosis pada tanaman pada layu fusarium</rdfs:label>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#LayuFusariumUbiJalar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Selain itu, terjadi nekrosis pada bagian vaskular batang dengan perubahan warna coklat menjadi ungu yang disertai pecahnya korteks batang dan miselium tumbuh pada permukaan batang yang terinfeksi (Gambar 1G dan F).</rdfs:comment>
  </rdf:Description>
