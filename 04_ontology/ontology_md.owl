  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitRebahKecambahKedelaiLekukanPangkalAkar">
    <rdfs:label xml:lang="id">Lekukan pada pangkal akar pada Penyakit Rebah Kecambah (Kedelai)</rdfs:label>
