    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitTungroPadi3"/>
    <kbr:deskripsiPengendalian xml:lang="id">Selain itu dapat juga diaplikasikan cendawan entomopatogen seperti Metarhizium dan Beuveria.</kbr:deskripsiPengendalian>
    <kbr:namaPengendalian xml:lang="id">Penggunaan Metarhizium</kbr:namaPengendalian>
    <skos:prefLabel xml:lang="id">Penggunaan Metarhizium</skos:prefLabel>
  </rdf:Description>
