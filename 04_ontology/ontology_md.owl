  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBakteriPustulKedelaiPengendalianDilakukanPenggunaanBenihBebas">
    <ns1:halamanSumber>56</ns1:halamanSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:identifierSumber>CTL_092</ns1:identifierSumber>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Bakteri Pustul</skos:prefLabel>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:kutipanNormalisasi xml:lang="id">Pengendalian dapat dilakukan dengan penggunaan benih yang bebas dari patogen, tindakan eradikasi terhadap sumber inokulum juga dapat menjadi salah satu tindakan penekanan perkembangan penyakit bakteri pustul pada tanaman kedelai (Inayati and Yusnawan, 2017).</ns1:kutipanNormalisasi>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Bakteri Pustul</rdfs:label>
    <ns1:kutipanSumber xml:lang="id">Pengendalian dapat dilakukan dengan penggunaan benih yang bebas dari patogen, tindakan eradikasi terhadap sumber inokulum juga dapat menjadi salah satu tindakan penekanan perkembangan penyakit bakteri pustul pada tanaman kedelai (Inayati and Yusnawan, 2017).</ns1:kutipanSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <ns1:idChunkSumber>DOC002_C056_02</ns1:idChunkSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBercakDaunKacangTanahTerinfeksiCendawanDitunjukkanAdanyaKecil">
    <ns1:identifierSumber>SYM_619</ns1:identifierSumber>
