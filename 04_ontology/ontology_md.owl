  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanSuhuPenyimpanan">
    <skos:prefLabel xml:lang="id">Pengaturan suhu penyimpanan</skos:prefLabel>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:deskripsiPengendalian xml:lang="id">Ruang penyimpanan diatur pada suhu 13-16° C dengan kelembaban 85% agar perkembangan penyakit lambat (Clark and Moyer, 2013).</kbr:deskripsiPengendalian>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianFisik"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianLayuFusariumUbiJalar5"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianLayuFusariumUbiJalar4"/>
    <rdfs:label xml:lang="id">Pengaturan suhu penyimpanan</rdfs:label>
    <rdfs:comment xml:lang="id">Tindakan kanonik pengaturan suhu penyimpanan.</rdfs:comment>
    <kbr:namaPengendalian xml:lang="id">Pengaturan suhu penyimpanan</kbr:namaPengendalian>
    <skos:altLabel xml:lang="id">pengaturan suhu penyimpanan</skos:altLabel>
    <skos:definition xml:lang="id">Mengatur suhu ruang penyimpanan agar perkembangan patogen pascapanen terhambat.</skos:definition>
    <kbr:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#LayuFusariumUbiJalar"/>
  </rdf:Description>
