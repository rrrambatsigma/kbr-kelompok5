  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiTanah">
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorLahan"/>
    <rdfs:comment xml:lang="id">Faktor kondisi tanah.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pada kondisi lembab jamur S. rolfsii dapat berkembang dan menginfeksi bagian daun dan batang tanaman yang berada di dekat tanah.</rdfs:comment>
    <rdfs:label xml:lang="id">Kondisi Tanah</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="id">Kondisi Tanah</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasTukadBalian">
    <ns1:tahanTerhadap rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitTungroPadi"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas"/>
    <rdfs:label xml:lang="id">Tukad Balian</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiVarietasPadiBerbagaiStrategiPengendalianDijelaskanBerikut"/>
    <rdfs:comment xml:lang="id">Varietas tanaman yang disebut pada sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Berbagai strategi pengendalian penyakit tungro dijelaskan sebagai berikut meliputi pemusnahan tanaman terinfeksi, penggunaan varietas tahan seperti Tukad Unda, Tukad Balian, Kalimas, dan Bondoyudo, penanaman serempak minimal 20 ha luasan sawah, serta penanaman sebelum puncak kepadatan wereng hijau (Puslitbangtan 2005).</rdfs:comment>
    <ns1:merupakanVarietasDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Padi"/>
    <skos:prefLabel xml:lang="id">Tukad Balian</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBlasPadiAkibatnyaLeherMalaiTidakLagi">
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Malai"/>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBlasPadi"/>
    <ns1:deskripsiGejala xml:lang="id">Akibatnya leher malai tidak akan mampu lagi menopang malai, bahkan menjadi patah (Tebeest et al., 2007).</ns1:deskripsiGejala>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBlasPadiAkibatnyaLeherMalaiTidakLagi"/>
    <rdfs:label xml:lang="id">Pengamatan gejala Penyakit Blas</rdfs:label>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang belum dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Akibatnya leher malai tidak akan mampu lagi menopang malai, bahkan menjadi patah (Tebeest et al., 2007).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaMalai"/>
    <skos:prefLabel xml:lang="id">Pengamatan gejala Penyakit Blas</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiTanahGembur">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorLingkungan"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Tanah gembur</rdfs:label>
    <rdfs:comment xml:lang="id">Tanaman ini dapat tumbuh di dataran rendah sampai dataran tinggi dan menginginkan tanah dengan aerasi yang baik, subur, gembur dengan pH berkisar antara 5-6.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangTanahHarzianumBerbagaiTempatDiisolasiTumbuh">
    <ns1:identifierSumber>CTL_118</ns1:identifierSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:halamanSumber>67</ns1:halamanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Bercak Daun</skos:prefLabel>
    <ns1:kutipanNormalisasi xml:lang="id">harzianum dapat ditemukan di berbagai tempat, mudah diisolasi dan tumbuh cepat pada berbagai substrat, mampu hidup dan berkembang di rhizosfer dan dekat struktur istirahat patogen, mampu beradaptasi terhadap kondisi untuk dapat diperbanyak secara massal, dapat berperan sebagai biofertilizer dan biostimulan, dapat berperan sebagai biokontrol dengan mekanisme mikoparasit, antibiosis, kompetisi nutrisi dan induksi ketahanan tanaman.</ns1:kutipanNormalisasi>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Bercak Daun</rdfs:label>
    <ns1:kutipanSumber xml:lang="id">harzianum dapat ditemukan di berbagai tempat, mudah diisolasi dan tumbuh cepat pada berbagai substrat, mampu hidup dan berkembang di rhizosfer dan dekat struktur istirahat patogen, mampu beradaptasi terhadap kondisi untuk dapat diperbanyak secara massal, dapat berperan sebagai biofertilizer dan biostimulan, dapat berperan sebagai biokontrol dengan mekanisme mikoparasit, antibiosis, kompetisi nutrisi dan induksi ketahanan tanaman.</ns1:kutipanSumber>
    <ns1:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ns1:catatanKualitas>
    <ns1:idChunkSumber>DOC002_C067_01</ns1:idChunkSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumKacangTanahWalaupunBakterisidaAntibiotikEfektivitasnyaDiterapkan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <ns1:kutipanNormalisasi xml:lang="id">Walaupun bakterisida atau antibiotik telah diketahui efektivitasnya terhadap layu bakteri, tetapi belum diterapkan pada kacang tanah diduga karena pertimbangan tingginya harga bakterisida sehingga tidak efisien.</ns1:kutipanNormalisasi>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:halamanSumber>77</ns1:halamanSumber>
    <ns1:idChunkSumber>DOC002_C077_02</ns1:idChunkSumber>
    <ns1:kutipanSumber xml:lang="id">Walaupun bakterisida atau antibiotik telah diketahui efektivitasnya terhadap layu bakteri, tetapi belum diterapkan pada kacang tanah diduga karena pertimbangan tingginya harga bakterisida sehingga tidak efisien.</ns1:kutipanSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian umum Kacang tanah</rdfs:label>
    <ns1:identifierSumber>CTL_487</ns1:identifierSumber>
    <skos:prefLabel xml:lang="id">Bukti pengendalian umum Kacang tanah</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBercakKuningUbiJalarBercakDaun">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018).</rdfs:comment>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakDaun"/>
    <ns1:deskripsiGejala xml:lang="id">Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018).</ns1:deskripsiGejala>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBercakKuningUbiJalarAdapunLapanganKadangKadangTidak"/>
    <skos:prefLabel xml:lang="id">Bercak daun pada Penyakit bercak kuning</skos:prefLabel>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakKuningUbiJalar"/>
    <rdfs:label xml:lang="id">Bercak daun pada Penyakit bercak kuning</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBulaiJagungDisebabkanBervariasi1933Sampai">
