    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#ElsinoeBrasiliensis"/>
    <skos:prefLabel xml:lang="id">Superelongasi</skos:prefLabel>
    <ns1:deskripsiPenyakit xml:lang="id">Pemanjangan ruas batang yang berlebihan, sehingga batang terbentuk tipis dan lemah dibandingkan tanaman sehat. Gejala pada daun dan tangkai daun di batang muda, deformasi berkembang berasosisi dengan gejala kanker.</ns1:deskripsiPenyakit>
  </rdf:Description>
