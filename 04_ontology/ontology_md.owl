    <rdfs:comment xml:lang="id">Gejala juga dapat muncul pada bagian tanaman seperti batang dan polong yang terinfeksi patogen C. cassiicola (López-Cardona et al., 2021).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="id">Gejala Polong</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitTungroPadiKlorosisDaun">
