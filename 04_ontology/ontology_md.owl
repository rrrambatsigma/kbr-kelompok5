    <rdfs:comment xml:lang="id">Balitkabi (2017) menginfokan varietas Vima 4 dan Vima 5 memiliki sifat agak tahan terhadap infeksi patogen tular tanah.</rdfs:comment>
    <skos:prefLabel xml:lang="id">Vima 5</skos:prefLabel>
  </rdf:Description>
