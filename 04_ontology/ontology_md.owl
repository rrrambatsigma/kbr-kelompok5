    <skos:definition xml:lang="id">Menggunakan bakterisida yang sesuai sasaran untuk menekan bakteri patogen.</skos:definition>
    <kbr:deskripsiPengendalian xml:lang="id">Pengendalian kimiawi dengan fungisida berbahan aktif risiklikol, pyroquilon, iprobenfos, benomyl, isoprothiolane, diclocymet, edifenphos, felimzone, probenazole, karpropamid, fenoxanil dan metominostrobin, dan antibiotik seperti blasticidin, kasugamycin dan dipotassium hidrogen fosfat (DHP) telah dilaporkan dapat mengurangi keparahan penyakit blas.</kbr:deskripsiPengendalian>
    <rdfs:label xml:lang="id">Penggunaan bakterisida</rdfs:label>
  </rdf:Description>
