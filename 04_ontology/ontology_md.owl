    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas"/>
    <skos:prefLabel xml:lang="id">Devon 1</skos:prefLabel>
    <rdfs:label xml:lang="id">Devon 1</rdfs:label>
  </rdf:Description>
