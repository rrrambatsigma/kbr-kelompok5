    <rdfs:label xml:lang="id">Penyakit Hawar Daun Bakteri</rdfs:label>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="id">Penyakit Hawar Daun Bakteri</skos:prefLabel>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit hawar daun bakteri (HDB) atau dikenal dengan nama penyakit kresek dalam bahasa lokal dan bacterial leaf blight dalam bahasa internasional menjadi salah satu penyakit penting pada padi. Kehilangan hasil yang disebabkan oleh penyakit ini dapat beragam dari 15-80% tergantung kondisi tanaman maupun lingkungannya (BBPOPT 2007; Lalitha et al. 2010).</rdfs:comment>
    <ns1:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ns1:deskripsiPenyakit xml:lang="id">Penyakit hawar daun bakteri (HDB) atau dikenal dengan nama penyakit kresek dalam bahasa lokal dan bacterial leaf blight dalam bahasa internasional menjadi salah satu penyakit penting pada padi. Kehilangan hasil yang disebabkan oleh penyakit ini dapat beragam dari 15-80% tergantung kondisi tanaman maupun lingkungannya (BBPOPT 2007; Lalitha et al. 2010).</ns1:deskripsiPenyakit>
    <ns1:tingkatKeparahan xml:lang="id">Kehilangan hasil yang disebabkan oleh penyakit ini dapat beragam dari 15-80% tergantung kondisi tanaman maupun lingkungannya (BBPOPT 2007; Lalitha et al. 2010).</ns1:tingkatKeparahan>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Suhu2534CPadaPenyakitHawarDaunBakteriPadi"/>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanRelatifDiAtas70PersenPadaPenyakitHawarDaunBakteriPadi"/>
