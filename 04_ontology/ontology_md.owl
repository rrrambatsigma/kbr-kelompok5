    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitLayuFusariumKedelai"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="id">Penyakit Layu Fusarium pada tanaman Kedelai, disebabkan oleh Fusarium spp, dengan gejala antara lain Busuk akar, Kematian tanaman, Layu daun, Nekrosis pada tanaman.</skos:definition>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Akar"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <skos:prefLabel xml:lang="id">Penyakit Layu Fusarium</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Fusarium wilt</skos:prefLabel>
    <skos:altLabel xml:lang="en">Fusarium wilt</skos:altLabel>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:identifierSumber>DIS_008</kbr:identifierSumber>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit layu Fusarium dikenal dengan penyakit busuk akar yang menginfeksi tanaman kedelai dan menyebabkan kematian (Bawa et al., 2018). Penyakit disebabkan oleh patogen Fusarium spp. Beberapa spesies dari patogen yang menginfeksi tanaman kedelai seperti F. solani (Bawa et al., 2018), F. virgulivorme (Baetsen-Young et al., 2020), F. sporotrichioides, F. graminearum, F. proliferatum (Okello et al., 2020). F. proliferatum juga menjadi masalah penting pada kedelai di Kanada (Chang et al., 2015).</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CuacaSejukDanBasahPadaPenyakitLayuFusariumKedelai"/>
  </rdf:Description>
