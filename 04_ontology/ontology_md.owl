  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiKelembapanTinggiDanDaunBasahPadaPenyakitBercakTargetKedelai">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Kelembapan tinggi dan daun basah pada Penyakit Bercak Target</rdfs:label>
    <ns1:dokumenSumber>SRC_EXT_011</ns1:dokumenSumber>
    <ns1:identifierSumber>Disease Cycle and Favorable Conditions for Disease, paragraph 1</ns1:identifierSumber>
    <ns1:kutipanSumber>Target spot generally requires very wet conditions, with free water resting on the leaves for infection to take place. Wet, warm conditions persisting for several days can result in a sudden increase in target spot infection.</ns1:kutipanSumber>
    <ns1:kutipanNormalisasi>Target spot generally requires very wet conditions, with free water resting on the leaves for infection to take place. Wet, warm conditions persisting for several days can result in a sudden increase in target spot infection.</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=direct</ns1:catatanKualitas>
    <rdfs:comment xml:lang="id">Bukti sumber: Kelembapan tinggi dan daun basah pada Penyakit Bercak Target; SRC_EXT_011.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPucuk">
    <skos:prefLabel xml:lang="id">Gejala Pucuk</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="id">Gejala yang diamati pada pucuk atau tunas.</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010).</rdfs:comment>
    <rdfs:label xml:lang="id">Gejala Pucuk</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
  </rdf:Description>
