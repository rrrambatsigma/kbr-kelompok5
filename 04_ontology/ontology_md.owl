  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkar">
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdfs:comment xml:lang="id">Gejala yang diamati pada akar.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pada tanaman yang terinfeksi *R. solani* akan menunjukkan gejala adanya lekukan coklat dan berkembang menjadi warna hitam pada pangkal akar muda yang terinfeksi (Muslim et al., 2019).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="id">Gejala Akar</skos:prefLabel>
    <rdfs:label xml:lang="id">Gejala Akar</rdfs:label>
  </rdf:Description>
