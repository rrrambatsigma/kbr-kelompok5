    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiJalar"/>
    <skos:altLabel xml:lang="en">Fusarium wilt</skos:altLabel>
    <skos:definition xml:lang="id">Penyakit layu fusarium pada tanaman Ubi jalar, disebabkan oleh Fusarium oxysporum, dengan gejala antara lain Bercak pada tanaman, Busuk pada tanaman, Kematian tanaman, Kerdil tanaman.</skos:definition>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianLayuFusariumUbiJalar4"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianLayuFusariumUbiJalar2"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianLayuFusariumUbiJalar3"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianLayuFusariumUbiJalar5"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitLayuFusariumUbiJalar"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenLayuFusariumUbiJalar"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianLayuFusariumUbiJalar"/>
    <skos:prefLabel xml:lang="en">Fusarium wilt</skos:prefLabel>
    <skos:prefLabel xml:lang="id">layu fusarium</skos:prefLabel>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaLayuFusariumUbiJalarKlorosisDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaLayuFusariumUbiJalarLayuDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaLayuFusariumUbiJalarKerdilTanaman"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaLayuFusariumUbiJalarBusukTanaman"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaLayuFusariumUbiJalarKematianTanaman"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaLayuFusariumUbiJalarMiseliumPadaTanaman"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaLayuFusariumUbiJalarBercakTanaman"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaLayuFusariumUbiJalarNekrosisTanaman"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanVarietasTahan"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SanitasiLahan"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanSuhuPenyimpanan"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanFungisida"/>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FusariumOxysporum"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">layu fusarium</rdfs:label>
    <kbr:identifierSumber>DIS_024</kbr:identifierSumber>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:deskripsiPenyakit xml:lang="id">Banyak dilaporkan bahwa Fusarium spp. menginfeksi ubi jalar di antaranya F. solani, F. proliferatum (Scruggs and Quesada-Ocampo, 2016), F. oxysporum (Scattolini, Hernandez and Gonzales, 2020), F. circinatum (Mousa et al., 2018), F. graminearum (Gaffoor et al., 2005). Genus Fusarium terkenal karena kemampuannya menghasilkan metabolit sekunder, beberapa di antaranya bersifat toksik pada manusia dan hewan (Desjardins, 2006). Berikut ini akan diuraikan F. oxysporum yang merupakan patogen penting pada ubi jalar.</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuInfeksiOptimalPadaLayuFusariumUbiJalar"/>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanTanah2875PersenPadaLayuFusariumUbiJalar"/>
  </rdf:Description>
