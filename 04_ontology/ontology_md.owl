    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <skos:definition xml:lang="id">Penyakit Hawar Daun pada tanaman Jagung, disebabkan oleh Helminthosporium maydis, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Hawar daun, Nekrosis daun.</skos:definition>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitHawarDaunJagungBercakTanaman"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitHawarDaunJagungBercakDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitHawarDaunJagungNekrosisDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitHawarDaunJagungHawarDaun"/>
    <rdfs:label xml:lang="id">Penyakit Hawar Daun</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <kbr:menyerangFase rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaseGeneratifUmum"/>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <kbr:identifierSumber>DIS_044</kbr:identifierSumber>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Jagung"/>
    <skos:altLabel xml:lang="en">Leaf blight</skos:altLabel>
    <kbr:tingkatKeparahan xml:lang="id">Keparahan penyakit hawar jagung terus meningkat pada setiap pengamatan dari 40.83% hingga 83.78%.</kbr:tingkatKeparahan>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit hawar daun pada jagung disebabkan oleh jamur patogen Helminthosporium maydis Y. Nisik &amp; C.Miyake (Kuilya et al., 2018; Hamidson, Suwandi and Effendy, 2019) atau Helminthosporium turticum (Pass.) Leonard et Suggs (Faizah, 2017). Koloni Helinthosporium maydis yang ditumbuhkan pada media PDA awalnya berwarna keputihan kusam, coklat pucat, selanjutnya menjadi berwarna coklat agak gelap. Hifanya bersekat dengan sekat agak longgar. Konidia berdinding tipis dan mempunyai 7-10 sekat. Setelah 8 hari ditumbuhkan pada media PDA, panjang diameter mencapai 8.75 cm.</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuPadaPenyakitHawarDaunJagung"/>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#DaunBasahPadaPenyakitHawarDaunJagung"/>
  </rdf:Description>
