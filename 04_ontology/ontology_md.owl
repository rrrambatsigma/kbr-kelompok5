  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang">
    <rdfs:label xml:lang="id">Gejala Batang</rdfs:label>
    <rdfs:comment xml:lang="id">Gejala yang diamati pada batang.</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala yang muncul setelah benih tumbuh pada permukaan tanah kemudian tanaman mati akibat pangkal batang pada permukaan tanah terdapat bercak coklat akibat terinfeksi patogen (post emergence damping off).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="id">Gejala Batang</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
  </rdf:Description>
