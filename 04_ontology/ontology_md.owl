  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Serealia">
    <rdfs:label xml:lang="id">Serealia</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#TanamanPangan"/>
    <skos:prefLabel xml:lang="id">Serealia</skos:prefLabel>
    <owl:equivalentClass rdf:nodeID="n654de723afb946cca3ef9aa2b4df114cb28"/>
    <rdfs:comment xml:lang="id">Kelompok tanaman pangan serealia dalam ruang lingkup.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pergiliran kacang tanah dengan kapas, kedelai, dan serealia (padi, jagung, sorgum, gandum, tebu) dapat memutus siklus perkembangan R. solanacearum di lahan setempat sehingga mengurangi kejadian penyakit layu.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanahPendekatanDilakukanMengurangiAkibatPStV">
    <ns1:kutipanSumber xml:lang="id">Pendekatan yang dapat dilakukan untuk mengurangi infeksi akibat PStV adalah dengan menanam tanaman yang toleran.</ns1:kutipanSumber>
