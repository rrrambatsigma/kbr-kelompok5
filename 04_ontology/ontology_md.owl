    <rdfs:comment xml:lang="id">Tindakan kanonik penggunaan bakterisida.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pengendalian kimiawi dengan fungisida berbahan aktif risiklikol, pyroquilon, iprobenfos, benomyl, isoprothiolane, diclocymet, edifenphos, felimzone, probenazole, karpropamid, fenoxanil dan metominostrobin, dan antibiotik seperti blasticidin, kasugamycin dan dipotassium hidrogen fosfat (DHP) telah dilaporkan dapat mengurangi keparahan penyakit blas.</rdfs:comment>
    <rdfs:label xml:lang="id">Penggunaan bakterisida</rdfs:label>
    <ns1:deskripsiPengendalian xml:lang="id">Pengendalian kimiawi dengan fungisida berbahan aktif risiklikol, pyroquilon, iprobenfos, benomyl, isoprothiolane, diclocymet, edifenphos, felimzone, probenazole, karpropamid, fenoxanil dan metominostrobin, dan antibiotik seperti blasticidin, kasugamycin dan dipotassium hidrogen fosfat (DHP) telah dilaporkan dapat mengurangi keparahan penyakit blas.</ns1:deskripsiPengendalian>
    <ns1:namaPengendalian xml:lang="id">Penggunaan bakterisida</ns1:namaPengendalian>
    <skos:prefLabel xml:lang="id">Penggunaan bakterisida</skos:prefLabel>
