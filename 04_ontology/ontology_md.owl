  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis">
    <rdfs:label xml:lang="id">Pengendalian Kultur Teknis</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <skos:prefLabel xml:lang="id">Pengendalian Kultur Teknis</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengendalian melalui praktik budidaya.</rdfs:comment>
    <rdfs:comment xml:lang="id">Menurut Inayati and Yusnawan, (2017) pengendalian penyakit yang disebabkan oleh R. solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:resource="https://gwsp.cs.ksu.edu/disease-management/management/Cultural_Control"/>
  </rdf:Description>
