  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiKelembapanTinggiPadaHawarBakteriUbiKayu">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Kelembapan tinggi pada Hawar bakteri</rdfs:label>
    <kbr:dokumenSumber>SRC_EXT_001</kbr:dokumenSumber>
    <kbr:identifierSumber>Section 2.2 Disease cycle, paragraph 1</kbr:identifierSumber>
    <kbr:kutipanSumber>When conditions are favourable, especially high humidity, multiplication of the pathogen increases around trichomes and penetration of the outer layer takes place (Daniel &amp; Boher, 1985a).</kbr:kutipanSumber>
    <kbr:kutipanNormalisasi>When conditions are favourable, especially high humidity, multiplication of the pathogen increases around trichomes and penetration of the outer layer takes place (Daniel &amp; Boher, 1985a).</kbr:kutipanNormalisasi>
    <kbr:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=direct</kbr:catatanKualitas>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#JurnalSRCEXT001"/>
    <rdfs:comment xml:lang="id">Bukti sumber: Kelembapan tinggi pada Hawar bakteri; SRC_EXT_001.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBlasPadi7">
    <kbr:identifierSumber>CTL_015</kbr:identifierSumber>
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
