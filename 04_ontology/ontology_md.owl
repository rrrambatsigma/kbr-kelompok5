    <kbr:memilikiVarietas rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasCangkuang"/>
    <skos:definition xml:lang="id">Tanaman pangan umbi-umbian penghasil umbi akar yang kaya karbohidrat.</skos:definition>
    <kbr:diserangPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBusukHitamBlackRotUbiJalar"/>
