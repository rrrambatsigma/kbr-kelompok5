  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitLayuStewartJagungKerdilTanaman">
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitLayuStewartJagung3"/>
    <kbr:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <skos:prefLabel xml:lang="id">Kerdil tanaman</skos:prefLabel>
