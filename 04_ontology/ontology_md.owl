    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Antraknosa</rdfs:label>
    <ns1:kutipanNormalisasi xml:lang="id">Aplikasi fungisida SAAF yaitu fungisida berbahan aktif Karbendazim 12% + fungisida berbahan aktif Mancozeb 63% dengan konsentrasi 2,5 gram/liter menekan perkembangan penyakit 29,67% (Subedi et al., 2015).</ns1:kutipanNormalisasi>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Antraknosa</skos:prefLabel>
    <ns1:halamanSumber>50</ns1:halamanSumber>
