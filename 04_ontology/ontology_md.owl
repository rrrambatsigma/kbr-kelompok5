    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePembungaan">
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePertumbuhan"/>
    <rdfs:comment xml:lang="id">Fase pembungaan.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pada fase perkecambahan akan berbeda dengan fase pembungaan dan pemasakan di mana suhu untuk perkecambahan kedelai berkisar 15-220C, fase pembentukan bunga suhu optimum berkisar 20-250C, dan fase pemasakan suhu optimumnya berkisar 15-220C (Taufiq and Sundari, 2014).</rdfs:comment>
    <rdfs:label xml:lang="id">Fase Pembungaan</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="id">Fase Pembungaan</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarDaunJagungHalDikarenakanIntensitasTerdapatDisemprot">
