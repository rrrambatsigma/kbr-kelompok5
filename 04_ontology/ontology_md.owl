    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Iklim lembap pada Nekrosis pada titik tunas (Cassava bud necrosis)</rdfs:label>
    <ns1:dokumenSumber>SRC_EXT_029</ns1:dokumenSumber>
    <ns1:identifierSumber>Cassava bud necrosis section</ns1:identifierSumber>
    <ns1:kutipanSumber>Bud necrosis is a fungal disease usually found in cassava growing areas with humid environments. Incidence of the disease is therefore higher in the humid forest zones compared to the drier savanna areas.</ns1:kutipanSumber>
    <ns1:kutipanNormalisasi>Bud necrosis is a fungal disease usually found in cassava growing areas with humid environments. Incidence of the disease is therefore higher in the humid forest zones compared to the drier savanna areas.</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=direct</ns1:catatanKualitas>
    <rdfs:comment xml:lang="id">Bukti sumber: Iklim lembap pada Nekrosis pada titik tunas (Cassava bud necrosis); SRC_EXT_029.</rdfs:comment>
  </rdf:Description>
