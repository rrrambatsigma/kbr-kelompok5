  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PanenTepatWaktu">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <skos:prefLabel xml:lang="id">Panen tepat waktu</skos:prefLabel>
    <skos:definition xml:lang="id">Melakukan panen pada waktu yang dianjurkan untuk mengurangi kehilangan hasil dan infeksi pascapanen.</skos:definition>
    <rdfs:label xml:lang="id">Panen tepat waktu</rdfs:label>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumUbiKayu5"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:altLabel xml:lang="id">panen tepat waktu</skos:altLabel>
    <rdfs:comment xml:lang="id">Tindakan kanonik panen pada waktu yang dianjurkan.</rdfs:comment>
    <kbr:deskripsiPengendalian xml:lang="id">Penyakit pada umbi yang terjadi pada pascapanen dapat dicegah dengan waktu panen pada usia tanaman dewasa (6-7 bulan setelah tanam), dan menghindari adanya pelukaan pada umbi pada waktu pemanenan.</kbr:deskripsiPengendalian>
    <kbr:namaPengendalian xml:lang="id">Panen tepat waktu</kbr:namaPengendalian>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanMetarhizium">
    <skos:definition xml:lang="id">Memanfaatkan jamur Metarhizium sebagai agens hayati pengendali serangga hama.</skos:definition>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianBiologis"/>
