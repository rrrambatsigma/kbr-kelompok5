    <rdfs:label xml:lang="id">Bukti sumber: Musim dingin ringan pada Penyakit Layu Stewart</rdfs:label>
    <ns1:dokumenSumber>SRC_EXT_021</ns1:dokumenSumber>
    <ns1:identifierSumber>Stewart's wilt, Favorable conditions</ns1:identifierSumber>
    <ns1:kutipanSumber>Favorable conditions: High temp., high levels of ammonium N &amp; P, low levels of Ca and K increase plant susceptibility; mild winters favor survival of flea beetles, hence increases chance of transmission.</ns1:kutipanSumber>
    <ns1:kutipanNormalisasi>Favorable conditions: High temp., high levels of ammonium N &amp; P, low levels of Ca and K increase plant susceptibility; mild winters favor survival of flea beetles, hence increases chance of transmission.</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=vector_mediated</ns1:catatanKualitas>
    <rdfs:comment xml:lang="id">Bukti sumber: Musim dingin ringan pada Penyakit Layu Stewart; SRC_EXT_021.</rdfs:comment>
  </rdf:Description>
