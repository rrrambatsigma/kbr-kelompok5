    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaKanonik"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:merupakanKanonikDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitHawarDaunBakteriPadiKresek"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <rdfs:comment xml:lang="id">Konsep kanonik untuk gejala kresek pada hawar daun bakteri padi.</rdfs:comment>
    <skos:prefLabel xml:lang="id">Kresek</skos:prefLabel>
    <skos:prefLabel xml:lang="en">kresek</skos:prefLabel>
    <skos:definition xml:lang="id">Gejala kresek pada daun padi berupa daun menguning, menggulung, dan mengering akibat hawar daun bakteri.</skos:definition>
    <rdfs:label xml:lang="id">Kresek</rdfs:label>
    <skos:altLabel xml:lang="id">hawar daun bakteri</skos:altLabel>
    <skos:altLabel xml:lang="id">kresek</skos:altLabel>
    <skos:broader rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KategoriNekrosis"/>
    <kbr:kodeGejala>Kresek</kbr:kodeGejala>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuBakteriKacangTanah">
    <kbr:kutipanSumber xml:lang="id">Pengendalian penyakit tanaman ditekankan melalui pengelolaan penyakit terpadu, dengan menerapkan beberapa komponen teknologi pengendalian yang efektif dan dapat diintegrasikan dengan teknis budidaya tanaman.</kbr:kutipanSumber>
