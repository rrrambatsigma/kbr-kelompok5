  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBusukHitamBlackRotUbiJalarBusukTanaman">
    <kbr:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BusukTanaman"/>
    <kbr:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBusukHitamBlackRotUbiJalar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdfs:comment xml:lang="id">Gejala busuk pada tanaman pada tanaman Ubi jalar: Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003).</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003).</rdfs:comment>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBusukHitamBlackRotUbiJalar"/>
    <skos:prefLabel xml:lang="id">Busuk pada tanaman</skos:prefLabel>
    <kbr:deskripsiGejala xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003).</kbr:deskripsiGejala>
    <kbr:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#TidakSpesifik"/>
    <rdfs:label xml:lang="id">Busuk pada tanaman</rdfs:label>
  </rdf:Description>
