  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBercakDaunKacangTanahKlorosisTanaman">
    <rdfs:label xml:lang="id">Klorosis pada tanaman pada Penyakit Bercak Daun (Kacang tanah)</rdfs:label>
    <skos:prefLabel xml:lang="id">Klorosis pada tanaman pada Penyakit Bercak Daun (Kacang tanah)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Gejala klorosis pada tanaman pada tanaman Kacang tanah: Gejala pertama muncul 10 hari setelah inokulasi berupa lesio kecil...</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala pertama muncul 10 hari setelah inokulasi berupa lesio kecil klorotik, selanjutnya lesio semakin meluas hingga diameter 1 - 10 mm berwarna semakin gelap.</rdfs:comment>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
