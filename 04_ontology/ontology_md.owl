    <rdfs:label xml:lang="id">Fase vegetatif padi</rdfs:label>
    <rdfs:comment xml:lang="id">Fase pertumbuhan tanaman yang disebut pada sumber.</rdfs:comment>
    <kbr:mulaiFase rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</kbr:mulaiFase>
    <kbr:selesaiFase rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">55.0</kbr:selesaiFase>
    <kbr:satuanFase>HST</kbr:satuanFase>
    <skos:definition xml:lang="id">Tahap pertumbuhan akar, batang, dan daun sebelum tanaman memasuki pembungaan atau pembuahan.</skos:definition>
