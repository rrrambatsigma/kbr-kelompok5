  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitAntraknosaKedelaiNekrosisTanaman">
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitAntraknosaKedelai7"/>
    <rdfs:label xml:lang="id">Nekrosis pada tanaman pada Penyakit Antraknosa (Kedelai)</rdfs:label>
    <ns1:deskripsiGejala xml:lang="id">truncatum dengan cara melakukan penetrasi pada jaringan tanaman dengan membentuk hifa primer dan diikuti dengan fase nekrotik di mana patogen memproduksi hifa sekunder yang menginfeksi jaringan tanaman secara intra dan interseluler sehingga menyebabkan kematian jaringan sel.</ns1:deskripsiGejala>
    <skos:prefLabel xml:lang="id">Nekrosis pada tanaman pada Penyakit Antraknosa (Kedelai)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Gejala nekrosis pada tanaman pada tanaman Kedelai: truncatum dengan cara melakukan penetrasi pada jaringan tanaman dengan...</rdfs:comment>
    <rdfs:comment xml:lang="id">truncatum dengan cara melakukan penetrasi pada jaringan tanaman dengan membentuk hifa primer dan diikuti dengan fase nekrotik di mana patogen memproduksi hifa sekunder yang menginfeksi jaringan tanaman secara intra dan interseluler sehingga menyebabkan kematian jaringan sel.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
