    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenTanamanKerdilStuntUbiKayuSelTabelT52BATANG"/>
    <ns1:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Begomovirus"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanTanamanKerdilStuntUbiKayuTidakTumbuhUmumnyaTerjadiMengalami"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <rdfs:label xml:lang="id">Tanaman kerdil (stunt)</rdfs:label>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Tanaman tidak tumbuh secara normal, gejala ini umumnya terjadi pada tanaman yang mengalami infeksi awal oleh virus ini. Tanaman yang terinfeksi virus ini umumnya akan memiliki batang yang berukuran kecil</rdfs:comment>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiKayu"/>
    <ns1:deskripsiPenyakit xml:lang="id">Tanaman tidak tumbuh secara normal, gejala ini umumnya terjadi pada tanaman yang mengalami infeksi awal oleh virus ini. Tanaman yang terinfeksi virus ini umumnya akan memiliki batang yang berukuran kecil</ns1:deskripsiPenyakit>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakit">
    <rdfs:comment xml:lang="id">Bukti untuk pernyataan penyakit.</rdfs:comment>
    <rdfs:comment xml:lang="id">Hasil penelitian Sunkad dan Kulkarni (2007) dan Arsule dan Pande (2011), membuktikan penyakit karat banyak terjadi selama bulan September.</rdfs:comment>
