    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitKerdilKedelaiSoybeanStuntVirusKedelaiDisebabkanPartikelSoybeanStuntSSV"/>
