  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBusukHitamBlackRotUbiJalarBercakTanaman">
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakTanaman"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkar"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaUmbi"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Umbi"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Akar"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBusukHitamBlackRotUbiJalar2"/>
    <rdfs:label xml:lang="id">Bercak pada tanaman pada Penyakit busuk hitam (black rot) (Ubi jalar)</rdfs:label>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBusukHitamBlackRotUbiJalar"/>
    <skos:prefLabel xml:lang="id">Bercak pada tanaman pada Penyakit busuk hitam (black rot) (Ubi jalar)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Gejala bercak pada tanaman pada tanaman Ubi jalar: fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau...</rdfs:comment>
    <rdfs:comment xml:lang="id">fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b).</rdfs:comment>
    <ns1:deskripsiGejala xml:lang="id">fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b).</ns1:deskripsiGejala>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKaratDaunKacangTanahKlorosisTanaman">
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKaratDaunKacangTanah2"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Gejala klorosis pada tanaman pada tanaman Kacang tanah: Pada bercak tersebut tumbuh pustul yang merupakan kumpulan spora...</rdfs:comment>
    <rdfs:comment xml:lang="id">Pada bercak tersebut tumbuh pustul yang merupakan kumpulan spora cendawan karat, berwarna kuning kecoklatan seperti karat besi, kalau dilihat lebih dekat tampak seperti adanya tekstur tepung.</rdfs:comment>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunKacangTanah"/>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KlorosisTanaman"/>
    <rdfs:label xml:lang="id">Klorosis pada tanaman pada Penyakit Karat Daun (Kacang tanah)</rdfs:label>
    <ns1:deskripsiGejala xml:lang="id">Pada bercak tersebut tumbuh pustul yang merupakan kumpulan spora cendawan karat, berwarna kuning kecoklatan seperti karat besi, kalau dilihat lebih dekat tampak seperti adanya tekstur tepung.</ns1:deskripsiGejala>
    <skos:prefLabel xml:lang="id">Klorosis pada tanaman pada Penyakit Karat Daun (Kacang tanah)</skos:prefLabel>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
  </rdf:Description>
