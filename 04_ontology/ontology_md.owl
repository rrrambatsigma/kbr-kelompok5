  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKaratDaunKacangTanahKlorosisDaun">
    <rdfs:label xml:lang="id">Klorosis daun</rdfs:label>
