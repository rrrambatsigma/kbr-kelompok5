  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitAntraknosaKedelaiNekrosisTanaman">
    <kbr:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#TidakSpesifik"/>
    <kbr:deskripsiGejala xml:lang="id">truncatum dengan cara melakukan penetrasi pada jaringan tanaman dengan membentuk hifa primer dan diikuti dengan fase nekrotik di mana patogen memproduksi hifa sekunder yang menginfeksi jaringan tanaman secara intra dan interseluler sehingga menyebabkan kematian jaringan sel.</kbr:deskripsiGejala>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitAntraknosaKedelai"/>
    <kbr:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#NekrosisTanaman"/>
    <rdfs:label xml:lang="id">Nekrosis pada tanaman</rdfs:label>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitAntraknosaKedelai7"/>
    <skos:prefLabel xml:lang="id">Nekrosis pada tanaman</skos:prefLabel>
    <rdfs:comment xml:lang="id">Gejala nekrosis pada tanaman pada tanaman Kedelai: truncatum dengan cara melakukan penetrasi pada jaringan tanaman dengan membentuk hifa primer dan diikuti dengan fase nekrotik di mana patogen memproduksi hifa sekunder yang menginfeksi jaringan tanaman secara intra dan interseluler sehingga menyebabkan kematian jaringan sel.</rdfs:comment>
    <rdfs:comment xml:lang="id">truncatum dengan cara melakukan penetrasi pada jaringan tanaman dengan membentuk hifa primer dan diikuti dengan fase nekrotik di mana patogen memproduksi hifa sekunder yang menginfeksi jaringan tanaman secara intra dan interseluler sehingga menyebabkan kematian jaringan sel.</rdfs:comment>
  </rdf:Description>
