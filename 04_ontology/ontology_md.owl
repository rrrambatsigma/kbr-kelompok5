    <ns1:idChunkSumber>DOC002_C096_03</ns1:idChunkSumber>
    <ns1:kutipanNormalisasi xml:lang="id">Secara umum pengendalian penyakit pada tanaman ubi kayu yaitu pada perbaikan cara atau teknik budidaya yang tepat sebagai upaya preventif, yang meliputi pengaturan jarak tanam, memperbaiki drainase pertanaman, rotasi tanaman, dan tumpang sari, penggunaan varietas tahan penyakit, serta bahan perbanyakan tanaman ubi kayu yang sehat.</ns1:kutipanNormalisasi>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
