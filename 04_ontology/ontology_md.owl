    <ns1:diserangPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunKacangTanah"/>
    <ns1:diserangPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBelangMottleKacangTanah"/>
