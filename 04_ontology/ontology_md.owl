  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PanenTepatWaktu">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:namaPengendalian xml:lang="id">Panen tepat waktu</ns1:namaPengendalian>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumUbiKayuUmbiTerjadiPascapanenDicegahWaktu"/>
    <skos:prefLabel xml:lang="id">Panen tepat waktu</skos:prefLabel>
    <rdfs:comment xml:lang="id">Tindakan kanonik panen pada waktu yang dianjurkan.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit pada umbi yang terjadi pada pascapanen dapat dicegah dengan waktu panen pada usia tanaman dewasa (6-7 bulan setelah tanam), dan menghindari adanya pelukaan pada umbi pada waktu pemanenan.</rdfs:comment>
    <rdfs:label xml:lang="id">Panen tepat waktu</rdfs:label>
    <ns1:deskripsiPengendalian xml:lang="id">Penyakit pada umbi yang terjadi pada pascapanen dapat dicegah dengan waktu panen pada usia tanaman dewasa (6-7 bulan setelah tanam), dan menghindari adanya pelukaan pada umbi pada waktu pemanenan.</ns1:deskripsiPengendalian>
  </rdf:Description>
