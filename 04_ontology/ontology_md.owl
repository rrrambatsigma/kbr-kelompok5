    <owl:disjointWith rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <owl:disjointWith rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorRisiko"/>
    <owl:disjointWith rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaKanonik"/>
