    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanSuperelongasiUbiKayuPertumbuhanAbnormal"/>
    <ns1:identifierSumber>DIS_037</ns1:identifierSumber>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Superelongasi</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenSuperelongasiUbiKayuSelTabelT52BATANG"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitSuperelongasiUbiKayuTanpaTeks"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pemanjangan ruas batang yang berlebihan, sehingga batang terbentuk tipis dan lemah dibandingkan tanaman sehat. Gejala pada daun dan tangkai daun di batang muda, deformasi berkembang berasosisi dengan gejala kanker.</rdfs:comment>
    <ns1:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiKayu"/>
    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <skos:prefLabel xml:lang="id">Superelongasi</skos:prefLabel>
    <ns1:deskripsiPenyakit xml:lang="id">Pemanjangan ruas batang yang berlebihan, sehingga batang terbentuk tipis dan lemah dibandingkan tanaman sehat. Gejala pada daun dan tangkai daun di batang muda, deformasi berkembang berasosisi dengan gejala kanker.</ns1:deskripsiPenyakit>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#MusimHujanPadaSuperelongasiUbiKayu"/>
  </rdf:Description>
