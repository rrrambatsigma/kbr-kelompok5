    <skos:prefLabel xml:lang="id">Pengamatan gejala Penyakit kudis</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarDaunJagungPengendalianDilakukanPengelolaanSanitasiLahan">
    <ns1:kutipanSumber xml:lang="id">Pengendalian hawar daun pada jagung dapat dilakukan dengan pengelolaan sanitasi lahan budidaya yang baik yaitu dengan membuang gulma secara rutin (Hamidson et al., 2019).</ns1:kutipanSumber>
