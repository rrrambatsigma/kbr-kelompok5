    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanEkstrakTanaman"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBakteriPustulKedelaiPengendalianDilakukanPenggunaanBenihBebas"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitPenyakitBakteriPustulKedelaiPustul"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitBakteriPustulKedelaiDisebabkanXanthomonasAxonopodisPv"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBakteriPustulKedelaiPengendalianPustulAgensHayatiAntagonis"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBakteriPustulKedelaiAplikasiEkstrakKunyitSirihMenekan"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit yang juga sering menyerang pada tanaman kedelai adalah penyakit bakteri pustul. Penyakit ini disebabkan oleh patogen Xanthomonas axonopodis pv. glycines. Patogen akan menginfeksi bagian daun tanaman. Gejala yang muncul akibat serangan patogen X. axonopodis pv. glycines diawali dengan adanya bercak-bercak pada bagian daun. Bercak berwarna hijau kekuningan. Kemudian bercak berkembang menjadi berwarna kuning kecokelatan. Pada awal munculnya bercak berukuran kecil. Kemudian pada serangan yang tinggi maka bercak menjadi berukuran besar (Gambar 2.16).</rdfs:comment>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBakteriPustulKedelaiMunculAkibatX"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBakteriPustulKedelaiAwalMunculnyaBerukuranKecil"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBakteriPustulKedelaiBercakDaun"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBakteriPustulKedelaiSepintasDitunjukkanHampirMenyerupaiPustul"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBakteriPustulKedelaiKemudianMakaMenjadiBerukuranBesar"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBakteriPustulKedelaiKemudianBerkembangMenjadiBerwarnaKuning"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBakteriPustulKedelaiSelanjutnyaTerinfeksiRontokAkibatIntensitas"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanAgensHayati"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBacillus"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanEkstrakTanaman"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SanitasiLahan"/>
    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#XanthomonasAxonopodis"/>
    <ns1:identifierSumber>DIS_017</ns1:identifierSumber>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <rdfs:label xml:lang="id">Penyakit Bakteri Pustul</rdfs:label>
    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <skos:prefLabel xml:lang="id">Penyakit Bakteri Pustul</skos:prefLabel>
    <ns1:deskripsiPenyakit xml:lang="id">Penyakit yang juga sering menyerang pada tanaman kedelai adalah penyakit bakteri pustul. Penyakit ini disebabkan oleh patogen Xanthomonas axonopodis pv. glycines. Patogen akan menginfeksi bagian daun tanaman. Gejala yang muncul akibat serangan patogen X. axonopodis pv. glycines diawali dengan adanya bercak-bercak pada bagian daun. Bercak berwarna hijau kekuningan. Kemudian bercak berkembang menjadi berwarna kuning kecokelatan. Pada awal munculnya bercak berukuran kecil. Kemudian pada serangan yang tinggi maka bercak menjadi berukuran besar (Gambar 2.16).</ns1:deskripsiPenyakit>
  </rdf:Description>
