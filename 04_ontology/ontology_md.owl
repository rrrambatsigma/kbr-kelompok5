    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakKuningUbiJalar"/>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala yang timbul akibat serangan penyakit ini pada planlet yang belum mengalami kultur meristem tunas pucuk berupa klorotik, nekrosis, daun kecil dan terlipat (Barahima and Purnomo, 2003).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiKhasRumputJumlahAnakanBentuk">
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Kerdil Rumput dan Kerdil Hampa</rdfs:label>
    <ns1:idChunkSumber>DOC002_C035_01</ns1:idChunkSumber>
    <ns1:kutipanSumber xml:lang="id">Gejala yang khas dari penyakit kerdil rumput yaitu kerdil dengan jumlah anakan banyak, bentuk daun pendek dan sempit, bagian batang tumbuh menjadi tegak dan kaku, serta diskolorasi daun (Gambar 1.7).</ns1:kutipanSumber>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Kerdil Rumput dan Kerdil Hampa</skos:prefLabel>
    <ns1:identifierSumber>SYM_029</ns1:identifierSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <ns1:kutipanNormalisasi xml:lang="id">Gejala yang khas dari penyakit kerdil rumput yaitu kerdil dengan jumlah anakan banyak, bentuk daun pendek dan sempit, bagian batang tumbuh menjadi tegak dan kaku, serta diskolorasi daun (Gambar 1.7).</ns1:kutipanNormalisasi>
    <ns1:halamanSumber>35</ns1:halamanSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanLayuFusariumUbiJalarMerambatBerwarnaKecokelatan1BE">
    <skos:prefLabel xml:lang="id">Pengamatan gejala layu fusarium</skos:prefLabel>
    <ns1:deskripsiGejala xml:lang="id">Tanaman merambat berwarna kecokelatan (1B dan E), tanaman yang mati sering terdapat miselium berwarna merah muda dengan makrokonidia dan mikrokonidia patogen (1C dan F).</ns1:deskripsiGejala>
    <rdfs:label xml:lang="id">Pengamatan gejala layu fusarium</rdfs:label>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang belum dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Tanaman merambat berwarna kecokelatan (1B dan E), tanaman yang mati sering terdapat miselium berwarna merah muda dengan makrokonidia dan mikrokonidia patogen (1C dan F).</rdfs:comment>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#LayuFusariumUbiJalar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaLayuFusariumUbiJalarMerambatBerwarnaKecokelatan1BE"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBulaiJagungMenyerangFaseVegetatifBerkurangSemakin">
    <ns1:identifierSumber>SYM_195</ns1:identifierSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Bulai</skos:prefLabel>
    <ns1:idChunkSumber>DOC002_C105_02</ns1:idChunkSumber>
    <ns1:kutipanSumber xml:lang="id">Penyakit bulai menyerang tanaman pada fase vegetatif dan infeksi akan berkurang saat tanaman semakin tua karena semakin dewasa tanaman akan lebih tahan terhadap penyakit bulai (Purwanto et al., 2016).</ns1:kutipanSumber>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Bulai</rdfs:label>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <ns1:kutipanNormalisasi xml:lang="id">Penyakit bulai menyerang tanaman pada fase vegetatif dan infeksi akan berkurang saat tanaman semakin tua karena semakin dewasa tanaman akan lebih tahan terhadap penyakit bulai (Purwanto et al., 2016).</ns1:kutipanNormalisasi>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:halamanSumber>105</ns1:halamanSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasLokal">
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas"/>
    <rdfs:label xml:lang="id">Varietas Lokal</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="id">Kategori varietas lokal.</rdfs:comment>
    <rdfs:comment xml:lang="id">Oleh karena itu, varietas ini dapat dikatakan mempunyai ketahanan lebih baik dari varietas lainnya (varietas Lokal Batu, P12, P31, NK 33, NK 22, Pertiwi 3, P23, P21 dan P27).</rdfs:comment>
    <skos:prefLabel xml:lang="id">Varietas Lokal</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasAbomourow">
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiVarietasUbiJalarMartantoTanatiAndBaan2016"/>
    <rdfs:label xml:lang="id">Abomourow</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas"/>
    <rdfs:comment xml:lang="id">Varietas tanaman yang disebut pada sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Menurut (Martanto, Tanati and Baan, 2016) varietas tahan dapat menggunakan Mouwebsi, Wonembai, Kuyage-2, Inanwatan-4, Abomourow, sedangkan Bonsasarai termasuk agak tahan.</rdfs:comment>
    <ns1:merupakanVarietasDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiJalar"/>
