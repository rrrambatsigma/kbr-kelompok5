  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaLayuFusariumUbiJalarSelainTerjadiNekrosisBagianVaskular">
    <ns1:identifierSumber>SYM_157</ns1:identifierSumber>
    <ns1:kutipanNormalisasi xml:lang="id">Selain itu, terjadi nekrosis pada bagian vaskular batang dengan perubahan warna coklat menjadi ungu yang disertai pecahnya korteks batang dan miselium tumbuh pada permukaan batang yang terinfeksi (Gambar 1G dan F).</ns1:kutipanNormalisasi>
    <rdfs:label xml:lang="id">Bukti gejala layu fusarium</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <skos:prefLabel xml:lang="id">Bukti gejala layu fusarium</skos:prefLabel>
    <ns1:kutipanSumber xml:lang="id">Selain itu, terjadi nekrosis pada bagian vaskular batang dengan perubahan warna coklat menjadi ungu yang disertai pecahnya korteks batang dan miselium tumbuh pada permukaan batang yang terinfeksi (Gambar 1G dan F).</ns1:kutipanSumber>
    <ns1:halamanSumber>80</ns1:halamanSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <ns1:idChunkSumber>DOC002_C080_01</ns1:idChunkSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#ObservasiPenyakitBulaiJagungKelembapan90Persen">
    <rdfs:label xml:lang="id">Kelembapan 90Persen pada Penyakit Bulai</rdfs:label>
    <rdfs:comment xml:lang="id">Observasi faktor lingkungan yang diekstrak dari sumber.</rdfs:comment>
    <ns1:memengaruhiPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBulaiJagung"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanUdara"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#ObservasiLingkungan"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiLingkunganPenyakitBulaiJagungKecepatanAnginKelembaban90Suhu"/>
    <ns1:nilaiTunggal rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">90.0</ns1:nilaiTunggal>
    <ns1:satuan>%</ns1:satuan>
    <skos:prefLabel xml:lang="id">Kelembapan 90Persen pada Penyakit Bulai</skos:prefLabel>
    <ns1:operatorNilai>&gt;</ns1:operatorNilai>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKaratDaunJagungLajuDitentukanKenaikanSuhuKelembaban">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdfs:label xml:lang="id">Pengamatan gejala Penyakit Karat Daun</rdfs:label>
    <ns1:deskripsiGejala xml:lang="id">Laju infeksi ditentukan oleh kenaikan suhu dan kelembaban, meningkatnya suhu dapat menurunkan laju infeksi dan sebaliknya meningkatnya kelembaban dapat meningkatkan laju infeksi (Puspawati and Sudarma, 2016).</ns1:deskripsiGejala>
    <skos:prefLabel xml:lang="id">Pengamatan gejala Penyakit Karat Daun</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang belum dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Laju infeksi ditentukan oleh kenaikan suhu dan kelembaban, meningkatnya suhu dapat menurunkan laju infeksi dan sebaliknya meningkatnya kelembaban dapat meningkatkan laju infeksi (Puspawati and Sudarma, 2016).</rdfs:comment>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKaratDaunJagungLajuDitentukanKenaikanSuhuKelembaban"/>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunJagung"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanBusukAkarDanUmbiUbiKayuPertumbuhanTerhambat">
