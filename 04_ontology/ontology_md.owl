    <skos:prefLabel xml:lang="id">Sapu setan (Witches broom)</skos:prefLabel>
    <ns1:deskripsiPenyakit xml:lang="id">Tanaman tumbuh kerdil (dwarf), ruas batang memendek, pada ujung tanaman tumbuh tunas yang banyak menyerupai sapu</ns1:deskripsiPenyakit>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKerdilRumputDanKerdilHampaPadiKerdilTanaman">
    <skos:prefLabel xml:lang="id">Kerdil tanaman pada Penyakit Kerdil Rumput dan Kerdil Hampa</skos:prefLabel>
    <rdfs:label xml:lang="id">Kerdil tanaman pada Penyakit Kerdil Rumput dan Kerdil Hampa</rdfs:label>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKerdilRumputDanKerdilHampaPadi"/>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala yang khas dari penyakit kerdil rumput yaitu kerdil dengan jumlah anakan banyak, bentuk daun pendek dan sempit, bagian batang tumbuh menjadi tegak dan kaku, serta diskolorasi daun (Gambar 1.7).</rdfs:comment>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSementaraHampaSelainMudaBergigi"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSelainPerubahanWarnaTampakPula"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiKhasRumputJumlahAnakanBentuk"/>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KerdilTanaman"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:deskripsiGejala xml:lang="id">Gejala yang khas dari penyakit kerdil rumput yaitu kerdil dengan jumlah anakan banyak, bentuk daun pendek dan sempit, bagian batang tumbuh menjadi tegak dan kaku, serta diskolorasi daun (Gambar 1.7).</ns1:deskripsiGejala>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumKacangTanahSelainMenekanPengendalianHayatiMeningkatkan">
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:halamanSumber>77</ns1:halamanSumber>
    <ns1:kutipanNormalisasi xml:lang="id">Selain menekan penyakit, pengendalian hayati tersebut dapat meningkatkan hasil polong kacang tanah hingga 2,71 t/ha sedangkan tanpa perlakuan pengendalian polong yang dihasilkan hanya 2 t/ha (Doan dan Nguyen 2006).</ns1:kutipanNormalisasi>
    <skos:prefLabel xml:lang="id">Bukti pengendalian umum Kacang tanah</skos:prefLabel>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <ns1:kutipanSumber xml:lang="id">Selain menekan penyakit, pengendalian hayati tersebut dapat meningkatkan hasil polong kacang tanah hingga 2,71 t/ha sedangkan tanpa perlakuan pengendalian polong yang dihasilkan hanya 2 t/ha (Doan dan Nguyen 2006).</ns1:kutipanSumber>
    <ns1:idChunkSumber>DOC002_C077_02</ns1:idChunkSumber>
    <ns1:identifierSumber>CTL_483</ns1:identifierSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian umum Kacang tanah</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitTungroPadiTerserangUmumnyaHidupHinggaStadia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:kutipanNormalisasi xml:lang="id">Tanaman padi yang terserang virus tungro umumnya hanya hidup hingga stadia pemasakan dengan gejala terhambatnya proses pembungaan, tidak sempurnanya malai dengan bulir yang tertutup bercak coklat (Puslitbang 2005).</ns1:kutipanNormalisasi>
    <ns1:identifierSumber>SYM_028</ns1:identifierSumber>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Tungro</rdfs:label>
    <ns1:idChunkSumber>DOC002_C034_01</ns1:idChunkSumber>
    <ns1:kutipanSumber xml:lang="id">Tanaman padi yang terserang virus tungro umumnya hanya hidup hingga stadia pemasakan dengan gejala terhambatnya proses pembungaan, tidak sempurnanya malai dengan bulir yang tertutup bercak coklat (Puslitbang 2005).</ns1:kutipanSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Tungro</skos:prefLabel>
    <ns1:halamanSumber>34</ns1:halamanSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PembersihanAlat">
    <skos:prefLabel xml:lang="id">Pembersihan alat</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
