    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Padi"/>
    <skos:altLabel xml:lang="en">Bacterial leaf blight</skos:altLabel>
    <skos:prefLabel xml:lang="id">Penyakit Hawar Daun Bakteri</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Bacterial leaf blight</skos:prefLabel>
    <kbr:identifierSumber>DIS_001</kbr:identifierSumber>
    <rdfs:label xml:lang="id">Penyakit Hawar Daun Bakteri</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#XanthomonasOryzae"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <skos:definition xml:lang="id">Penyakit Hawar Daun Bakteri pada tanaman Padi, disebabkan oleh Xanthomonas oryzae, dengan gejala antara lain Bercak daun, Hawar daun, Klorosis daun, Klorosis pada tanaman.</skos:definition>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit hawar daun bakteri (HDB) atau dikenal dengan nama penyakit kresek dalam bahasa lokal dan bacterial leaf blight dalam bahasa internasional menjadi salah satu penyakit penting pada padi. Kehilangan hasil yang disebabkan oleh penyakit ini dapat beragam dari 15-80% tergantung kondisi tanaman maupun lingkungannya (BBPOPT 2007; Lalitha et al. 2010).</kbr:deskripsiPenyakit>
    <kbr:tingkatKeparahan xml:lang="id">Kehilangan hasil yang disebabkan oleh penyakit ini dapat beragam dari 15-80% tergantung kondisi tanaman maupun lingkungannya (BBPOPT 2007; Lalitha et al. 2010).</kbr:tingkatKeparahan>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Suhu2534CPadaPenyakitHawarDaunBakteriPadi"/>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanRelatifDiAtas70PersenPadaPenyakitHawarDaunBakteriPadi"/>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#HujanLebatDanAnginKencangPadaPenyakitHawarDaunBakteriPadi"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/RiceBacterialBlightDisease"/>
  </rdf:Description>
