    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBacillus"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBenihSehat"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanAgensHayati"/>
    <skos:definition xml:lang="id">Penyakit Bakteri Pustul pada tanaman Kedelai, disebabkan oleh Xanthomonas axonopodis, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Daun rontok, Klorosis pada tanaman.</skos:definition>
    <skos:altLabel xml:lang="en">Bacterial pustule</skos:altLabel>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#XanthomonasAxonopodis"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBakteriPustulKedelaiBercakDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBakteriPustulKedelaiDaunRontok"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBakteriPustulKedelaiBercakTanaman"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBakteriPustulKedelaiKlorosisTanaman"/>
    <kbr:identifierSumber>DIS_017</kbr:identifierSumber>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <skos:prefLabel xml:lang="en">Bacterial pustule</skos:prefLabel>
    <skos:prefLabel xml:lang="id">Penyakit Bakteri Pustul</skos:prefLabel>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <rdfs:label xml:lang="id">Penyakit Bakteri Pustul</rdfs:label>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit yang juga sering menyerang pada tanaman kedelai adalah penyakit bakteri pustul. Penyakit ini disebabkan oleh patogen Xanthomonas axonopodis pv. glycines. Patogen akan menginfeksi bagian daun tanaman. Gejala yang muncul akibat serangan patogen X. axonopodis pv. glycines diawali dengan adanya bercak-bercak pada bagian daun. Bercak berwarna hijau kekuningan. Kemudian bercak berkembang menjadi berwarna kuning kecokelatan. Pada awal munculnya bercak berukuran kecil. Kemudian pada serangan yang tinggi maka bercak menjadi berukuran besar (Gambar 2.16).</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuPadaPenyakitBakteriPustulKedelai"/>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanTinggiDanDaunBasahPadaPenyakitBakteriPustulKedelai"/>
  </rdf:Description>
