    <ns1:idChunkSumber>DOC002_C067_01</ns1:idChunkSumber>
    <ns1:kutipanNormalisasi xml:lang="id">harzianum juga dapat memarasit miselium jamur lain dengan menembus dinding sel dan masuk ke dalam sel untuk mengambil zat makanan dari dalam sel sehingga jamur menjadi mati, dalam proses kompetisi jamur T.</ns1:kutipanNormalisasi>
