  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitEmbunTepungKacangHijauBahanFungisidaNabatiEkstrakBiji">
    <rdfs:label xml:lang="id">Bukti pengendalian EMBUN TEPUNG</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti pengendalian EMBUN TEPUNG</skos:prefLabel>
    <ns1:kutipanSumber xml:lang="id">Bahan fungisida nabati seperti ekstrak biji mimba, minyak cengkeh atau ekstrak bawang merah (Gambar 20) dapat menekan intensitas penyakit embun tepung.</ns1:kutipanSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
