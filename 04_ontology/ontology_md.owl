  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitRebahKecambahKedelaiSolaniDilakukanTeknikPengendalianKultur">
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Rebah Kecambah</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:idChunkSumber>DOC002_C041_02</ns1:idChunkSumber>
