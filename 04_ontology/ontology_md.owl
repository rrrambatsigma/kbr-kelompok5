  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitHawarDaunBakteriPadiKhasTepiBergelombangPenggulunganTerlihat">
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitHawarDaunBakteriPadiKhasTepiBergelombangPenggulunganTerlihat"/>
