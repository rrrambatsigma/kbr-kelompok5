    <ns1:halamanSumber>58</ns1:halamanSumber>
    <ns1:kutipanSumber xml:lang="id">Apabila ada tanaman yang terinfeksi maka segera dilakukan eradikasi dan dimusnahkan agar tidak menjadi sumber inokulum, dan apabila perkembangan serangga vektor tinggi maka lakukan penyemprotan menggunakan insektisida berbahan aktif imidakloprid (Inayati and Yusnawan, 2017).</ns1:kutipanSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Mosaik Kedelai (Soybean Mosaic Virus)</rdfs:label>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <ns1:identifierSumber>CTL_095</ns1:identifierSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Mosaik Kedelai (Soybean Mosaic Virus)</skos:prefLabel>
    <ns1:kutipanNormalisasi xml:lang="id">Apabila ada tanaman yang terinfeksi maka segera dilakukan eradikasi dan dimusnahkan agar tidak menjadi sumber inokulum, dan apabila perkembangan serangga vektor tinggi maka lakukan penyemprotan menggunakan insektisida berbahan aktif imidakloprid (Inayati and Yusnawan, 2017).</ns1:kutipanNormalisasi>
    <ns1:idChunkSumber>DOC002_C058_01</ns1:idChunkSumber>
  </rdf:Description>
