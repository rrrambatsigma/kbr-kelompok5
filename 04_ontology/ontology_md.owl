  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuNekrosi"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuBercakT"/>
    <skos:definition xml:lang="id">Penyakit Nekrosis pada titik tunas (Cassava bud necrosis) pada tanaman Ubi kayu, disebabkan oleh Fungi/Jamur, dengan gejala antara lain Bercak pada tanaman, Nekrosis pada tanaman.</skos:definition>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT031"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT032"/>
    <skos:prefLabel xml:lang="id">Nekrosis pada titik tunas (Cassava bud necrosis)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Cassava bud necrosis</skos:prefLabel>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:altLabel xml:lang="en">Cassava bud necrosis</skos:altLabel>
    <kbr:identifierSumber>DIS_039</kbr:identifierSumber>
    <rdfs:label xml:lang="id">Nekrosis pada titik tunas (Cassava bud necrosis)</rdfs:label>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pucuk"/>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FungiJamur"/>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiKayu"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <kbr:deskripsiPenyakit xml:lang="id">Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#IklimLembapPadaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu"/>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanTinggiPadaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SeleksiBahanTanam"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanJarakTanam"/>
  </rdf:Description>
