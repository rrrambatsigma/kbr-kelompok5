  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBulaiJagung">
    <kbr:halamanSumber>105</kbr:halamanSumber>
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Bulai (Jagung)</rdfs:label>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <kbr:kutipanNormalisasi xml:lang="id">Gejala bulai pada tanaman jagung ditandai dengan daun mengalami klorosis sejajar dengan tulang daun, pertumbuhan terhambat (kerdil), berbentuk kipas dan adanya lapisan tepung berwarna putih pada permukaan daun bagian bawah, yang biasanya hanya terlihat di pagi hari.</kbr:kutipanNormalisasi>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:idChunkSumber>DOC002_C105_02</kbr:idChunkSumber>
    <kbr:identifierSumber>SYM_192</kbr:identifierSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Bulai (Jagung)</skos:prefLabel>
    <kbr:kutipanSumber xml:lang="id">Gejala bulai pada tanaman jagung ditandai dengan daun mengalami klorosis sejajar dengan tulang daun, pertumbuhan terhambat (kerdil), berbentuk kipas dan adanya lapisan tepung berwarna putih pada permukaan daun bagian bawah, yang biasanya hanya terlihat di pagi hari.</kbr:kutipanSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PerlakuanAirPanas">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianFisik"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:namaPengendalian xml:lang="id">Perlakuan air panas</kbr:namaPengendalian>
    <skos:prefLabel xml:lang="id">Perlakuan air panas</skos:prefLabel>
    <skos:definition xml:lang="id">Merendam benih atau bahan tanam dalam air panas pada suhu dan waktu tertentu untuk membunuh patogen.</skos:definition>
