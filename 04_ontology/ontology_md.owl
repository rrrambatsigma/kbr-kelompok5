    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Musim dingin ringan pada Penyakit Layu Stewart</rdfs:label>
    <kbr:dokumenSumber>SRC_EXT_021</kbr:dokumenSumber>
    <kbr:identifierSumber>Stewart's wilt, Favorable conditions</kbr:identifierSumber>
    <kbr:kutipanSumber>Favorable conditions: High temp., high levels of ammonium N &amp; P, low levels of Ca and K increase plant susceptibility; mild winters favor survival of flea beetles, hence increases chance of transmission.</kbr:kutipanSumber>
    <kbr:kutipanNormalisasi>Favorable conditions: High temp., high levels of ammonium N &amp; P, low levels of Ca and K increase plant susceptibility; mild winters favor survival of flea beetles, hence increases chance of transmission.</kbr:kutipanNormalisasi>
    <kbr:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=vector_mediated</kbr:catatanKualitas>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PublikasiSRCEXT021"/>
    <rdfs:comment xml:lang="id">Bukti sumber: Musim dingin ringan pada Penyakit Layu Stewart; SRC_EXT_021.</rdfs:comment>
  </rdf:Description>
