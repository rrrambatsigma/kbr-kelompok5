    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:idChunkSumber>DOC002_C034_02</ns1:idChunkSumber>
    <ns1:kutipanSumber xml:lang="id">Berbagai strategi pengendalian penyakit tungro dijelaskan sebagai berikut meliputi pemusnahan tanaman terinfeksi, penggunaan varietas tahan seperti Tukad Unda, Tukad Balian, Kalimas, dan Bondoyudo, penanaman serempak minimal 20 ha luasan sawah, serta penanaman sebelum puncak kepadatan wereng hijau (Puslitbangtan 2005).</ns1:kutipanSumber>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Tungro</skos:prefLabel>
    <ns1:identifierSumber>CTL_021</ns1:identifierSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
