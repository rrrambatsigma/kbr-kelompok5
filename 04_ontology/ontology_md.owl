    <ns1:kutipanNormalisasi xml:lang="id">Selain itu, pestisida nabati juga dapat mencegah serangga memakan tanaman, menghambat reproduksi serangga, mengacaukan sistem hormon di dalam tubuh serangga, dan mengendalikan pertumbuhan jamur dan bakteri.</ns1:kutipanNormalisasi>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
