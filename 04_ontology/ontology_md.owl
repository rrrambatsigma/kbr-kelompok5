    <kbr:identifierSumber>DIS_019</kbr:identifierSumber>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit samar kacang tunggak disebabkan oleh virus Cowpea Mild Mottle Virus (CMMV). Patogen virus CMMV ini mampu menyerang pada beberapa tanaman seperti kedelai atau famili Leguminoceae, Solanaceae, Amaranthaceae, dan Chenopodiaceae. Gejala yang ditunjukkan oleh patogen CMMV pada tanaman kedelai adalah pada daun tanaman terdapat belang secara sistemik, bagian tulang daun terdapat klorosis serta daun yang terinfeksi CMMV mengalami malformasi (Gambar 2.18).</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CuacaMemengaruhiPopulasiBemisiaTabaciPadaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitLayuStewartJagung3">
    <kbr:identifierSumber>SYM_199</kbr:identifierSumber>
    <kbr:idChunkSumber>DOC002_C107_02</kbr:idChunkSumber>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Layu Stewart (Jagung)</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Layu Stewart (Jagung)</skos:prefLabel>
    <kbr:kutipanSumber xml:lang="id">Daun bergejala layu stewart berwarna hijau pucat hingga kekuningan dengan garis linier dengan tepi lurus maupun bergelombang yang sejajar tulang daun, layu dan kerdil (Rahma et al., 2014).</kbr:kutipanSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <kbr:halamanSumber>107</kbr:halamanSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <kbr:kutipanNormalisasi xml:lang="id">Daun bergejala layu stewart berwarna hijau pucat hingga kekuningan dengan garis linier dengan tepi lurus maupun bergelombang yang sejajar tulang daun, layu dan kerdil (Rahma et al., 2014).</kbr:kutipanNormalisasi>
  </rdf:Description>
