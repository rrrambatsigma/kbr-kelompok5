  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CercosporaHenningsii">
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenBercakDaunCoklatUbiKayuSelTabelT51Baris"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Patogen"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:menyebabkanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakDaunCoklatUbiKayu"/>
    <rdfs:label xml:lang="id">Cercospora henningsii</rdfs:label>
    <ns1:namaIlmiahPatogen>Cercospora henningsii</ns1:namaIlmiahPatogen>
    <skos:prefLabel xml:lang="id">Cercospora henningsii</skos:prefLabel>
    <ns1:identifierSumber>PAT_098</ns1:identifierSumber>
    <rdfs:comment xml:lang="id">Patogen yang tercatat pada sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pemberian pupuk KCl dengan penambahan ZincMicro diketahui mampu menekan keparahan penyakit bercak daun coklat (Cercospora henningsii) pada tanaman ubi kayu (Miarti et al., 2020).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Legum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n695264d974974fe6a4344407a3a532dbb34"/>
    <rdfs:comment xml:lang="id">Kelompok tanaman pangan legum dalam ruang lingkup.</rdfs:comment>
    <rdfs:comment xml:lang="id">Hal ini karena patogen *S. rolfsii* memiliki kisaran inang yang luas seperti famili *leguminoceae*, *Cruciferaceae*, *Cucurbitaceae*, tanaman pisang, jeruk, gandum, padi, tebu, bit, keladi, bahkan tanaman rempah (Sumartini, 2012).</rdfs:comment>
    <skos:prefLabel xml:lang="id">Legum</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#TanamanPangan"/>
    <rdfs:label xml:lang="id">Legum</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengairan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="id">Faktor pengairan.</rdfs:comment>
    <rdfs:comment xml:lang="id">Kultur teknis, melalui penggunaan benih sehat, pencabutan tunggul yang terinfeksi, jerami dan gulma dari lahan yang terinfeksi dihilangkan, menghindari pemupukan nitrogen yang berlebihan dan pemberian pupuk K yang berimbang (Sudir et al. 2012; Naqvi 2019), tidak dianjurkan memotong bibit sebelum tanah supaya mencegah terjadinya infeksi patogen dan pola tanam dianjurkan memakai sistem legowo dengan sistem pengairan berselang.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorBudidaya"/>
    <skos:prefLabel xml:lang="id">Pengairan</skos:prefLabel>
    <rdfs:label xml:lang="id">Pengairan</rdfs:label>
  </rdf:Description>
