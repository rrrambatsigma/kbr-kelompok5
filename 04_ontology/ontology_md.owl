    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:deskripsiPengendalian xml:lang="id">(2018) menjelaskan bahwa pengendalian pascapanen menggunakan perilladehyde (PAE) 100 μm/l dengan cara fumigasi dapat mengurangi perkembangan miselium C.</kbr:deskripsiPengendalian>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#TanamanKerdilStuntUbiKayu">
    <skos:altLabel xml:lang="en">Stunt</skos:altLabel>
    <skos:prefLabel xml:lang="id">Tanaman kerdil (stunt)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Stunt</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="id">Penyakit Tanaman kerdil (stunt) pada tanaman Ubi kayu, disebabkan oleh Begomovirus, dengan gejala antara lain Kerdil tanaman, Pertumbuhan terhambat.</skos:definition>
    <rdfs:label xml:lang="id">Tanaman kerdil (stunt)</rdfs:label>
    <kbr:identifierSumber>DIS_038</kbr:identifierSumber>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Begomovirus"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaTanamanKerdilStuntUbiKayuPertumbuhanTerhambat"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaTanamanKerdilStuntUbiKayuKerdilTanaman"/>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitTanamanKerdilStuntUbiKayu"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenTanamanKerdilStuntUbiKayu"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT027"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT028"/>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiKayu"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <kbr:deskripsiPenyakit xml:lang="id">Tanaman tidak tumbuh secara normal, gejala ini umumnya terjadi pada tanaman yang mengalami infeksi awal oleh virus ini. Tanaman yang terinfeksi virus ini umumnya akan memiliki batang yang berukuran kecil</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuCurahHujanDanAnginPadaTanamanKerdilStuntUbiKayu"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanVarietasTahan"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SeleksiBahanTanam"/>
  </rdf:Description>
