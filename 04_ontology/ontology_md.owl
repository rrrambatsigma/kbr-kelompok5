    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKaratDaunKacangTanahRotasiMengurangiPopulasiInokulumAwal"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKaratDaunKacangTanahTakar1Takar2"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKaratDaunKacangTanahSanitasiLingkunganPertanamanDiperlukanMengantisipasi"/>
