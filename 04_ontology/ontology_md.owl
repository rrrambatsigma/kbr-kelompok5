  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBusukHitamBlackRotUbiJalar">
    <kbr:kutipanSumber xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003).</kbr:kutipanSumber>
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit busuk hitam (black rot) (Ubi jalar)</rdfs:label>
    <kbr:halamanSumber>87</kbr:halamanSumber>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit busuk hitam (black rot) (Ubi jalar)</skos:prefLabel>
    <kbr:kutipanNormalisasi xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003).</kbr:kutipanNormalisasi>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <kbr:idChunkSumber>DOC002_C087_01</kbr:idChunkSumber>
    <kbr:identifierSumber>SYM_171</kbr:identifierSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiVarietasJagung">
    <kbr:halamanSumber>106</kbr:halamanSumber>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <skos:prefLabel xml:lang="id">Bukti varietas Penyakit Bulai (Jagung)</skos:prefLabel>
    <kbr:idChunkSumber>DOC002_C106_02</kbr:idChunkSumber>
    <kbr:kutipanNormalisasi xml:lang="id">Pengendalian penyakit bulai jagung dapat dilakukan dengan menggunakan varietas tahan seperti Jagung Asian Honey yang mempunyai kejadian penyakit lebih rendah (54.17%) dibandingkan dengan varietas Jagung Pioneer 21 (70.83%) dan Jagung Pacific 339 (79.17%).</kbr:kutipanNormalisasi>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <rdfs:label xml:lang="id">Bukti varietas Penyakit Bulai (Jagung)</rdfs:label>
    <kbr:identifierSumber>CTL_213</kbr:identifierSumber>
    <kbr:kutipanSumber xml:lang="id">Pengendalian penyakit bulai jagung dapat dilakukan dengan menggunakan varietas tahan seperti Jagung Asian Honey yang mempunyai kejadian penyakit lebih rendah (54.17%) dibandingkan dengan varietas Jagung Pioneer 21 (70.83%) dan Jagung Pacific 339 (79.17%).</kbr:kutipanSumber>
  </rdf:Description>
