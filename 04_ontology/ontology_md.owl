    <kbr:identifierSumber>DIS_034</kbr:identifierSumber>
    <kbr:deskripsiPenyakit xml:lang="id">Tampak motif mosaik berwarna kuning atau pun keputihan pada daun hijau,serta menyebabkan daun keriting atau ukuran daun mengecil</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuCurahHujanDanAnginPadaCassavaMosaicBegomovirusCMBsUbiKayu"/>
