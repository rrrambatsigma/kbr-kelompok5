  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasDena1">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Dena 1</rdfs:label>
    <ns1:merupakanVarietasDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <ns1:tahanTerhadap rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitRebahSemaiKedelai"/>
    <skos:prefLabel xml:lang="id">Dena 1</skos:prefLabel>
    <rdfs:comment xml:lang="id">Varietas tanaman yang disebut pada sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Hasil penelitian yang dilakukan oleh Fitria and Masnilah, (2020) pada beberapa varietas kedelai terhadap patogen *S. rolfsii* diketahui bahwa Varietas Dena 1 tingkat keparahan penyakitnya lebih rendah dibandingkan dengan varietas Anjasmoro, Devon 1, Dering 1, Grobogan, dan Dega 1 yaitu 30% yang termasuk ke dalam varietas tahan.</rdfs:comment>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiVarietasKedelaiRolfsiiBahwaDena1Tingkat"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKerdilKedelaiSoybeanStuntVirusKedelaiMosaikDaun">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="id">Mosaik daun pada Penyakit Kerdil Kedelai (Soybean Stunt Virus)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pada daun yang terinfeksi ukurannya menjadi lebih kecil dibandingkan pada daun yang normal, yang diikuti dengan adanya mosaik pada daun (Gambar 2.19).</rdfs:comment>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#MosaikDaun"/>
    <rdfs:label xml:lang="id">Mosaik daun pada Penyakit Kerdil Kedelai (Soybean Stunt Virus)</rdfs:label>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKerdilKedelaiSoybeanStuntVirusKedelai"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKerdilKedelaiSoybeanStuntVirusKedelaiTerinfeksiUkurannyaMenjadiKecilDibandingkan"/>
    <ns1:deskripsiGejala xml:lang="id">Pada daun yang terinfeksi ukurannya menjadi lebih kecil dibandingkan pada daun yang normal, yang diikuti dengan adanya mosaik pada daun (Gambar 2.19).</ns1:deskripsiGejala>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanRelatifDiAtas78PersenPadaPenyakitKaratDaunKacangTanah">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#ObservasiLingkungan"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanUdara"/>
    <rdfs:label xml:lang="id">Kelembapan relatif &gt;78% pada Penyakit Karat Daun</rdfs:label>
    <ns1:memengaruhiPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunKacangTanah"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiKelembapanRelatifDiAtas78PersenPadaPenyakitKaratDaunKacangTanah"/>
    <ns1:menggambarkanKondisi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiKelembapanUdaraTinggi"/>
    <ns1:satuan>%</ns1:satuan>
    <ns1:operatorNilai>&gt;</ns1:operatorNilai>
    <ns1:kondisi xml:lang="id">kelembapan relatif &gt;78%</ns1:kondisi>
    <ns1:klasifikasiTurunan xml:lang="id">Kelembapan relatif &gt;78%</ns1:klasifikasiTurunan>
    <rdfs:comment xml:lang="id">Observasi lingkungan: Kelembapan relatif &gt;78% pada Penyakit Karat Daun.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasAbomourow">
    <ns1:merupakanVarietasDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiJalar"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Varietas tanaman yang disebut pada sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Menurut (Martanto, Tanati and Baan, 2016) varietas tahan dapat menggunakan Mouwebsi, Wonembai, Kuyage-2, Inanwatan-4, Abomourow, sedangkan Bonsasarai termasuk agak tahan.</rdfs:comment>
