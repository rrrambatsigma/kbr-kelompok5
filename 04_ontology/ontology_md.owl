    <ns1:halamanSumber>94</ns1:halamanSumber>
    <ns1:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ns1:catatanKualitas>
    <ns1:kutipanNormalisasi xml:lang="id">Muncul eksudat bergetah berwarna krem atau coklat kekuningan pada bagian batang yang terinfeksi, dan batang akan mati, meskipun adakalanya pada batang yang terinfeksi dan mati juga dapat memunculkan tunas baru</ns1:kutipanNormalisasi>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
