    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenBusukPangkalBatangUbiKayuSelTabelT52BATANG3"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenBusukAkarDanUmbiUbiKayuSelTabelT53AKAR2"/>
