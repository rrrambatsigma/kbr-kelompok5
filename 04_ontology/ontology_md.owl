  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitAntraknosaKedelaiKondisiLembapMenggulungGugurPolong">
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitAntraknosaKedelai"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPolong"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Pengamatan gejala ANTRAKNOSA</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitAntraknosaKedelaiKondisiLembapMenggulungGugurPolong"/>
    <skos:prefLabel xml:lang="id">Pengamatan gejala ANTRAKNOSA</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang belum dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pada kondisi lembap, daun akan menggulung dan mudah gugur, sedangkan pada polong akan terlihat acervuli yang membentuk pola cincin konsentris (Gambar 6b).</rdfs:comment>
    <ns1:deskripsiGejala xml:lang="id">Pada kondisi lembap, daun akan menggulung dan mudah gugur, sedangkan pada polong akan terlihat acervuli yang membentuk pola cincin konsentris (Gambar 6b).</ns1:deskripsiGejala>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Polong"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitTungroPadiPertumbuhanTerhambat">
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitTungroPadi"/>
    <skos:prefLabel xml:lang="id">Pertumbuhan terhambat pada Penyakit Tungro</skos:prefLabel>
    <rdfs:label xml:lang="id">Pertumbuhan terhambat pada Penyakit Tungro</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaMalai"/>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PertumbuhanTerhambat"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Malai"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitTungroPadiTerserangUmumnyaHidupHinggaStadia"/>
    <ns1:deskripsiGejala xml:lang="id">Tanaman padi yang terserang virus tungro umumnya hanya hidup hingga stadia pemasakan dengan gejala terhambatnya proses pembungaan, tidak sempurnanya malai dengan bulir yang tertutup bercak coklat (Puslitbang 2005).</ns1:deskripsiGejala>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Tanaman padi yang terserang virus tungro umumnya hanya hidup hingga stadia pemasakan dengan gejala terhambatnya proses pembungaan, tidak sempurnanya malai dengan bulir yang tertutup bercak coklat (Puslitbang 2005).</rdfs:comment>
  </rdf:Description>
