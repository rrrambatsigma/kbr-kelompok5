  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianLayuFusariumUbiJalar">
    <rdfs:label xml:lang="id">Bukti pengendalian layu fusarium (Ubi jalar)</rdfs:label>
