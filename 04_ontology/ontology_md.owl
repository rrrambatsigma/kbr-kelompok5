    <owl:disjointWith rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Referensi"/>
    <skos:prefLabel xml:lang="id">Rekomendasi Pengendalian</skos:prefLabel>
    <rdfs:label xml:lang="id">Rekomendasi Pengendalian</rdfs:label>
    <rdfs:comment xml:lang="id">Rekomendasi pengendalian yang dihasilkan proses diagnosis.</rdfs:comment>
    <rdfs:comment xml:lang="id">Mengetahui gejala yang muncul akibat infeksi cendawan Menjelaskan faktor yang berpengaruh terhadap perkembangan penyakit Menjelaskan tentang siklus perkembangan penyakit yang disebabkan oleh infeksi cendawan Rekomendasi pengendalian untuk mencegah perkembangan atau penularan penyakit di lapang.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#EntitasKBR"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKerdilKedelaiSoybeanStuntVirusKedelaiPertumbuhanTerhambat">
    <ns1:deskripsiGejala xml:lang="id">Tanaman yang terinfeksi akan menunjukkan gejala terhambatnya pertumbuhan tanaman kedelai.</ns1:deskripsiGejala>
