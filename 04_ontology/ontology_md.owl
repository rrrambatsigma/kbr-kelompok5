  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumUbiKayuPengendalianPerbaikanTeknikBudidayaTepat">
    <ns1:kutipanSumber xml:lang="id">Secara umum pengendalian penyakit pada tanaman ubi kayu yaitu pada perbaikan cara atau teknik budidaya yang tepat sebagai upaya preventif, yang meliputi pengaturan jarak tanam, memperbaiki drainase pertanaman, rotasi tanaman, dan tumpang sari, penggunaan varietas tahan penyakit, serta bahan perbanyakan tanaman ubi kayu yang sehat.</ns1:kutipanSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian umum Ubi kayu</rdfs:label>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
