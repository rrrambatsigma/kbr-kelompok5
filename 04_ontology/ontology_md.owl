    <rdfs:label xml:lang="id">Penyakit Hawar Bakteri (Bacterial Blight)</rdfs:label>
    <kbr:namaInggrisPenyakit>Bacterial Blight</kbr:namaInggrisPenyakit>
    <skos:prefLabel xml:lang="id">Penyakit Hawar Bakteri (Bacterial Blight)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Bacterial Blight</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <kbr:menyerangFase rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePanenTanaman"/>
    <kbr:menyerangFase rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePembibitanTanaman"/>
    <skos:altLabel xml:lang="en">Bacterial Blight</skos:altLabel>
    <skos:altLabel xml:lang="id">Bacterial Blight</skos:altLabel>
    <kbr:tingkatKeparahan xml:lang="id">Patogen dapat menginfeksi dari fase pembibitan hingga panen dan menyebabkan kehilangan hasil mencapai 50-70% (Majid, 2016).</kbr:tingkatKeparahan>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitHawarBakteriBacterialBlightKedelaiDaunBerluban"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitHawarBakteriBacterialBlightKedelaiPertumbuhanT"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitHawarBakteriBacterialBlightKedelaiDaunRontok"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitHawarBakteriBacterialBlightKedelaiBercakDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitHawarBakteriBacterialBlightKedelaiBercakTanama"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitHawarBakteriBacterialBlightKedelaiKlorosisTana"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PseudomonasSyringae"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <kbr:identifierSumber>DIS_016</kbr:identifierSumber>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit hawar bakteri (bacterial blight) disebabkan oleh patogen bakteri Pseudomonas syringae pv. glycine. Penyakit hawar bakteri menjadi salah satu penyakit yang menjadi kendala utama pada budidaya tanaman kedelai. Gejala tanaman yang disebabkan oleh patogen P. syringae pv. glycine diawali dengan munculnya bercak yang awalnya berwarna coklat kekuningan dengan ukuran bercak kecil. Pada tingkat serangan yang tinggi bercak kemudian menjadi hawar yang ditandai dengan warna kecokelatan dilingkari dengan lingkaran kuning dan menyebar tidak beraturan (Gambar 2.14).</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuSejukDanHujanSeringPadaPenyakitHawarBakteriBacterialBlightKedelai"/>
  </rdf:Description>
