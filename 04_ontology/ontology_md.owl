    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunJagung"/>
    <ns1:deskripsiPengendalian xml:lang="id">Upaya pengendalian karat jagung dapat dilakukan dengan beberapa cara seperti jarak tanam yang tidak terlalu rapat dan penyiangan gulma rutin sehingga sirkulasi udara lebih baik dan kelembaban tidak terlalu tinggi.</ns1:deskripsiPengendalian>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangHijauMenjagaAgarLingkunganMikroBawah"/>
