  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuUtamaDitandaiMunculnyaGelapAbu">
    <ns1:identifierSumber>T5.2_BATANG#</ns1:identifierSumber>
