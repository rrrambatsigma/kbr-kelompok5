  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKudisUbiJalar4">
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKudisUbiJalar6"/>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKudisUbiJalar"/>
    <rdfs:label xml:lang="id">Gejala pada Penyakit kudis (Ubi jalar): Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar...</rdfs:label>
    <rdfs:comment xml:lang="id">Gejala pada tanaman Ubi jalar: Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar...</rdfs:comment>
    <rdfs:comment xml:lang="id">Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar membentuk lapisan gabus untuk mempertahankan diri dari serangan penyakit kudis (Gambar 3A dan B).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <skos:prefLabel xml:lang="id">Gejala pada Penyakit kudis (Ubi jalar): Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar...</skos:prefLabel>
    <ns1:deskripsiGejala xml:lang="id">Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar membentuk lapisan gabus untuk mempertahankan diri dari serangan penyakit kudis (Gambar 3A dan B).</ns1:deskripsiGejala>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasTukadBalian">
    <skos:prefLabel xml:lang="id">Tukad Balian</skos:prefLabel>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiVarietasPadi"/>
    <ns1:merupakanVarietasDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Padi"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Varietas tanaman yang disebut sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Berbagai strategi pengendalian penyakit tungro dijelaskan sebagai berikut meliputi pemusnahan tanaman terinfeksi, penggunaan varietas tahan seperti Tukad Unda, Tukad Balian, Kalimas, dan Bondoyudo, penanaman serempak minimal 20 ha luasan sawah, serta penanaman sebelum puncak kepadatan wereng hijau (Puslitbangtan 2005).</rdfs:comment>
    <ns1:tahanTerhadap rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitTungroPadi"/>
    <rdfs:label xml:lang="id">Tukad Balian</rdfs:label>
  </rdf:Description>
