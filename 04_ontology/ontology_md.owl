    <ns1:namaIlmiahPatogen>Diplodia spp</ns1:namaIlmiahPatogen>
    <rdfs:comment xml:lang="id">Patogen yang tercatat pada sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Busuk pada umbi ubi kayu di antaranya disebabkan oleh cendawan Neoscytalidium sp. (Miarti et al. 2020), Fusarium oxysporum serta beberapa jamur patogen yaitu Botryodiplodia sp., Fusarium spp. Colletotrichum sp., Sclerotium rolfsii, Cladosporium sp. dan Aspergillus spp. yang berasosiasi dengan penyakit tersebut.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Patogen"/>
    <ns1:identifierSumber>PAT_109</ns1:identifierSumber>
    <ns1:menyebabkanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BusukPangkalBatangUbiKayu"/>
    <ns1:menyebabkanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BusukAkarDanUmbiUbiKayu"/>
    <skos:prefLabel xml:lang="id">Diplodia spp</skos:prefLabel>
  </rdf:Description>
