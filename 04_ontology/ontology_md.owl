    <ns1:identifierSumber>CTL_170</ns1:identifierSumber>
    <ns1:halamanSumber>77</ns1:halamanSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Layu Bakteri</rdfs:label>
    <ns1:kutipanNormalisasi xml:lang="id">Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati.</ns1:kutipanNormalisasi>
    <ns1:idChunkSumber>DOC002_C077_02</ns1:idChunkSumber>
    <ns1:kutipanSumber xml:lang="id">Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati.</ns1:kutipanSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitRebahKecambahKedelaiLayuDaun">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkar"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Tanaman akan layu akibat akar tanaman busuk dan terinfeksi patogen kemudian menyebar pada pangkal batang sehingga menyebabkan rebah semai atau rebah kecambah (Gambar 2.3) (Hidayah and Yulianti, 2015).</rdfs:comment>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Akar"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitRebahKecambahKedelai"/>
    <ns1:deskripsiGejala xml:lang="id">Tanaman akan layu akibat akar tanaman busuk dan terinfeksi patogen kemudian menyebar pada pangkal batang sehingga menyebabkan rebah semai atau rebah kecambah (Gambar 2.3) (Hidayah and Yulianti, 2015).</ns1:deskripsiGejala>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitRebahKecambahKedelaiAkibatAkarTerinfeksiKemudianMenyebar"/>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#LayuDaun"/>
    <skos:prefLabel xml:lang="id">Layu daun pada Penyakit Rebah Kecambah</skos:prefLabel>
    <rdfs:label xml:lang="id">Layu daun pada Penyakit Rebah Kecambah</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#deskripsiPenyakit">
    <rdfs:label xml:lang="id">deskripsi penyakit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
