  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiKelembapanTanah2875PersenPadaLayuFusariumUbiJalar">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Kelembapan tanah 28–75% pada layu fusarium</rdfs:label>
    <ns1:dokumenSumber>SRC_EXT_023</ns1:dokumenSumber>
    <ns1:identifierSumber>Biology and ecology, paragraph 1</ns1:identifierSumber>
    <ns1:kutipanSumber>The optimum temperature for infection is around 30°C, but the disease can develop at lower temperature and across a wide range of soil moisture- from 28 to 75%. However, the highest damage occurs in fields where the moisture is low.</ns1:kutipanSumber>
    <ns1:kutipanNormalisasi>The optimum temperature for infection is around 30°C, but the disease can develop at lower temperature and across a wide range of soil moisture- from 28 to 75%. However, the highest damage occurs in fields where the moisture is low.</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=direct</ns1:catatanKualitas>
    <rdfs:comment xml:lang="id">Bukti sumber: Kelembapan tanah 28–75% pada layu fusarium; SRC_EXT_023.</rdfs:comment>
  </rdf:Description>
