  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengelolaanGulma">
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKaratDaunKacangTanahSanitasiLingkunganPertanamanDiperlukanMengantisipasi"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuStewartJagungDjaenuddinMuis2018MengatakanPengendalian"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarDaunBakteriPadiPengendalianAntaranyaKulturTeknisMelalui"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKerdilRumputDanKerdilHampaPadiKemudianSanitasiKeberadaanGulmaSinggang"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKaratDaunJagungUpayaPengendalianDilakukanJarakTanam"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitTungroPadiKemudianSanitasiKeberadaanGulmaSinggang"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKaratDaunJagungTingginyaDisebabkanBuruknyaSanitasiLahan"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangHijauMenjagaAgarLingkunganMikroBawah"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarDaunJagungHalKondisiSanitasiBurukBanyaknya"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarDaunJagungPengendalianDilakukanPengelolaanSanitasiLahan"/>
    <skos:prefLabel xml:lang="id">Pengelolaan gulma</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Tindakan kanonik pengelolaan gulma.</rdfs:comment>
    <rdfs:comment xml:lang="id">Kemudian sanitasi dari keberadaan gulma, singgang, dan ceceran gabah yang dapat menjadi inang alternatif bagi patogen maupun vektor, penanaman sistem jajar legowo yang dapat memanipulasi kondisi mikro iklim di bawah kanopi tidak sesuai untuk patogen, pengeringan sawah untuk menekan populasi nimfa wereng hijau.</rdfs:comment>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunKacangTanah"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLayuStewartJagung"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKerdilRumputDanKerdilHampaPadi"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangHijau"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitTungroPadi"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitHawarDaunJagung"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitHawarDaunBakteriPadi"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunJagung"/>
    <rdfs:label xml:lang="id">Pengelolaan gulma</rdfs:label>
    <ns1:deskripsiPengendalian xml:lang="id">Kemudian sanitasi dari keberadaan gulma, singgang, dan ceceran gabah yang dapat menjadi inang alternatif bagi patogen maupun vektor, penanaman sistem jajar legowo yang dapat memanipulasi kondisi mikro iklim di bawah kanopi tidak sesuai untuk patogen, pengeringan sawah untuk menekan populasi nimfa wereng hijau.</ns1:deskripsiPengendalian>
    <ns1:namaPengendalian xml:lang="id">Pengelolaan gulma</ns1:namaPengendalian>
  </rdf:Description>
