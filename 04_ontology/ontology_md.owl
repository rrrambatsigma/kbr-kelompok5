    <ns1:kutipanSumber xml:lang="id">Pengendalian penyakit bulai jagung dapat dilakukan dengan menggunakan varietas tahan seperti Jagung Asian Honey yang mempunyai kejadian penyakit lebih rendah (54.17%) dibandingkan dengan varietas Jagung Pioneer 21 (70.83%) dan Jagung Pacific 339 (79.17%).</ns1:kutipanSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
