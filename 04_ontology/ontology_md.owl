  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSuhuPadaPenyakitBakteriPustulKedelai">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Suhu pada Penyakit Bakteri Pustul</rdfs:label>
    <ns1:dokumenSumber>SRC_EXT_002</ns1:dokumenSumber>
    <ns1:identifierSumber>Abstract</ns1:identifierSumber>
    <ns1:kutipanSumber>Disease development is strongly associated with temperatures of 26–30 °C, high relative humidity, and prolonged leaf wetness, conditions commonly observed during the rainy season in tropical agroecosystems.</ns1:kutipanSumber>
    <ns1:kutipanNormalisasi>Disease development is strongly associated with temperatures of 26–30 °C, high relative humidity, and prolonged leaf wetness, conditions commonly observed during the rainy season in tropical agroecosystems.</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=direct</ns1:catatanKualitas>
    <rdfs:comment xml:lang="id">Bukti sumber: Suhu pada Penyakit Bakteri Pustul; SRC_EXT_002.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBercakBijiUnguKedelaiBercakDaun">
