    <ns1:identifierSumber>DIS_121</ns1:identifierSumber>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitKaratDaunKacangTanah"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKaratDaunKacangTanah3"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKaratDaunKacangTanah2"/>
