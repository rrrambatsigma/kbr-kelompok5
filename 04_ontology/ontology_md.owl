    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLayuStewartJagung"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangTanah"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBelangMottleKacangTanah"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai"/>
    <ns1:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKerdilKedelaiSoybeanStuntVirusKedelai"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumKacangTanahPestisidaDigolongkanMenjadiMacamAntaranya"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanahNonPersistenPenyemprotanInsektisidaTidak"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanahPengendalianDilakukanInsektisida"/>
