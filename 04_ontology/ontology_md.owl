  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuNekrosi">
    <skos:prefLabel xml:lang="id">Nekrosis pada tanaman pada Nekrosis pada titik tunas (Cassava bud necrosis) (Ubi kayu)</skos:prefLabel>
    <ns1:deskripsiGejala xml:lang="id">Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas</ns1:deskripsiGejala>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu"/>
