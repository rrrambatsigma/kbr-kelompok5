  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#JarakTanam">
    <rdfs:label xml:lang="id">Jarak Tanam</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorBudidaya"/>
    <skos:prefLabel xml:lang="id">Jarak Tanam</skos:prefLabel>
    <rdfs:comment xml:lang="id">Faktor jarak tanam.</rdfs:comment>
    <rdfs:comment xml:lang="id">Kultur teknis, melalui pengaturan jarak tanam tidak terlalu rapat, pengeringan sawah beberapa hari pada saat anakan maksimum, pemusnahan atau pengomposan sisa-sisa tanaman yang terinfeksi (Puslitbangtan 2005).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
