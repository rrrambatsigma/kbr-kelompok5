    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaLayuFusariumUbiJalar3"/>
    <rdfs:comment xml:lang="id">Gejala klorosis daun pada tanaman Ubi jalar: (2018) menjelaskan bahwa gejala awal ditandai dengan daun yang...</rdfs:comment>
    <rdfs:comment xml:lang="id">(2018) menjelaskan bahwa gejala awal ditandai dengan daun yang terinfeksi berwarna kuning pada bagian atas, diikuti menguningnya pada bagian bawah dan lebih cepat pada daun tua.</rdfs:comment>
    <rdfs:label xml:lang="id">Klorosis daun pada layu fusarium (Ubi jalar)</rdfs:label>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KlorosisDaun"/>
  </rdf:Description>
