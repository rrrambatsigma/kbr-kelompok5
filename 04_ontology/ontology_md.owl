    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:kutipanNormalisasi xml:lang="id">Penyakit bercak kuning pada ubi jalar disebabkan oleh Sweet Potato Feathery Mottle Virus (SPFMV) termasuk ke dalam genus Potyvirus, famili Potyviridae (Tugume, Mukasa and Valkonen, 2008).</kbr:kutipanNormalisasi>
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
  </rdf:Description>
