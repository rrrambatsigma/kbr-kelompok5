  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiKelembapanRelatifDiAtas90PersenPadaPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelai">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
