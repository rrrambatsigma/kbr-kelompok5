    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBusukHitamBlackRotUbiJalarFimbriataABPascapanenC"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBusukHitamBlackRotUbiJalarGambar46BentukMikroskopis"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBusukHitamBlackRotUbiJalarHitamBlackRotDisebabkanCeratocystis"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBusukHitamBlackRotUbiJalarBusukAkar"/>
    <ns1:identifierSumber>DIS_027</ns1:identifierSumber>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBusukHitamBlackRotUbiJalarAdapunPengendalianDilakukanLahanBebas"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitPenyakitBusukHitamBlackRotUbiJalarHitamBlackRot"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitBusukHitamBlackRotUbiJalarHitamBlackRotDisebabkanCeratocystis"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBusukHitamBlackRotUbiJalar2018MenjelaskanBahwaPengendalianPascapanen"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBusukHitamBlackRotUbiJalarSterilisasiAkarBahanDitanamPersemaian"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003). Wamalwa et al. (2015) melaporkan bahwa C. fimbriata dapat menginduksi fitoaleksin yang bersifat toksik pada hewan.</rdfs:comment>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiJalar"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <rdfs:label xml:lang="id">Penyakit busuk hitam (black rot)</rdfs:label>
    <skos:altLabel xml:lang="id">black rot</skos:altLabel>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PerlakuanKimiaTanah"/>
    <ns1:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RotasiTanaman"/>
    <skos:prefLabel xml:lang="id">Penyakit busuk hitam (black rot)</skos:prefLabel>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PerlakuanKimiaTanah"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RotasiTanaman"/>
    <ns1:namaInggrisPenyakit>black rot</ns1:namaInggrisPenyakit>
    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CeratocystisFimbriata"/>
    <ns1:deskripsiPenyakit xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003). Wamalwa et al. (2015) melaporkan bahwa C. fimbriata dapat menginduksi fitoaleksin yang bersifat toksik pada hewan.</ns1:deskripsiPenyakit>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiSuhuTinggi"/>
  </rdf:Description>
