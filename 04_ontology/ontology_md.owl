    <skos:definition xml:lang="id">Memanfaatkan organisme antagonis atau agens hayati untuk menekan patogen.</skos:definition>
    <rdfs:comment xml:lang="id">Tindakan kanonik penggunaan agens hayati.</rdfs:comment>
    <skos:altLabel xml:lang="id">penggunaan agens hayati</skos:altLabel>
  </rdf:Description>
