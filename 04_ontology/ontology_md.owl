  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengumpulanDanPemusnahan">
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBlasPadi3"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumUbiKayu4"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitTungroPadi"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarPelepahDaunPadi"/>
    <rdfs:comment xml:lang="id">Tindakan kanonik pengumpulan dan pemusnahan bagian tanaman terserang.</rdfs:comment>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:prefLabel xml:lang="id">Pengumpulan dan pemusnahan</skos:prefLabel>
    <skos:altLabel xml:lang="id">pengumpulan dan pemusnahan</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianMekanis"/>
    <kbr:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitTungroPadi"/>
    <kbr:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitHawarPelepahDaunPadi"/>
    <kbr:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBlasPadi"/>
