  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKaratDaunKedelaiBeratMenjadiRontokPengisianPolong">
    <ns1:identifierSumber>SYM_056</ns1:identifierSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
