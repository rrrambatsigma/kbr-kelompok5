  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBercakKuningUbiJalarPucukMati">
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pucuk"/>
    <rdfs:label xml:lang="id">Pucuk mati pada Penyakit bercak kuning</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBercakKuningUbiJalarTimbulAkibatPlanletMengalamiKultur"/>
    <ns1:deskripsiGejala xml:lang="id">Gejala yang timbul akibat serangan penyakit ini pada planlet yang belum mengalami kultur meristem tunas pucuk berupa klorotik, nekrosis, daun kecil dan terlipat (Barahima and Purnomo, 2003).</ns1:deskripsiGejala>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPucuk"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
