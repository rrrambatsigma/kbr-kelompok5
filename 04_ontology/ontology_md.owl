  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBusukHitamBlackRotUbiJalar">
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Akar"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Umbi"/>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CeratocystisFimbriata"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RotasiTanaman"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PerlakuanKimiaTanah"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanVarietasTahan"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PerlakuanKimiaTanah"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RotasiTanaman"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanVarietasTahan"/>
    <skos:definition xml:lang="id">Penyakit busuk hitam (black rot) pada tanaman Ubi jalar, disebabkan oleh Ceratocystis fimbriata, dengan gejala antara lain Bercak pada tanaman, Busuk akar, Busuk pada tanaman.</skos:definition>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBusukHitamBlackRotUbiJalarBusukTanaman"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBusukHitamBlackRotUbiJalarBusukAkar"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBusukHitamBlackRotUbiJalarBercakTanaman"/>
    <skos:altLabel xml:lang="id">black rot</skos:altLabel>
    <skos:altLabel xml:lang="en">black rot</skos:altLabel>
    <rdfs:label xml:lang="id">Penyakit busuk hitam (black rot)</rdfs:label>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitPenyakitBusukHitamBlackRotUbiJalar"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitBusukHitamBlackRotUbiJalar"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBusukHitamBlackRotUbiJalar3"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBusukHitamBlackRotUbiJalar2"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBusukHitamBlackRotUbiJalar"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:prefLabel xml:lang="en">black rot</skos:prefLabel>
    <skos:prefLabel xml:lang="id">Penyakit busuk hitam (black rot)</skos:prefLabel>
    <kbr:identifierSumber>DIS_027</kbr:identifierSumber>
    <kbr:namaInggrisPenyakit>black rot</kbr:namaInggrisPenyakit>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiJalar"/>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003). Wamalwa et al. (2015) melaporkan bahwa C. fimbriata dapat menginduksi fitoaleksin yang bersifat toksik pada hewan.</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuLapang2327CPadaPenyakitBusukHitamBlackRotUbiJalar"/>
  </rdf:Description>
