  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBulaiJagung8">
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Bulai (Jagung)</skos:prefLabel>
    <kbr:kutipanNormalisasi xml:lang="id">Pemberian pupuk kalium juga dapat menurunkan laju infeksi, kejadian dan keparahan penyakit bulai karena kalium membantu pengaturan membuka dan menutupnya stomata dan membentuk senyawa lignin sehingga dinding sel menjadi lebih tebal dan sulit ditembus oleh jamur patogen (Habibi et al., 2017).</kbr:kutipanNormalisasi>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Bulai (Jagung)</rdfs:label>
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <kbr:idChunkSumber>DOC002_C106_02</kbr:idChunkSumber>
    <kbr:kutipanSumber xml:lang="id">Pemberian pupuk kalium juga dapat menurunkan laju infeksi, kejadian dan keparahan penyakit bulai karena kalium membantu pengaturan membuka dan menutupnya stomata dan membentuk senyawa lignin sehingga dinding sel menjadi lebih tebal dan sulit ditembus oleh jamur patogen (Habibi et al., 2017).</kbr:kutipanSumber>
    <kbr:halamanSumber>106</kbr:halamanSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:identifierSumber>CTL_215</kbr:identifierSumber>
  </rdf:Description>
