    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:kutipanNormalisasi xml:lang="id">Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018).</kbr:kutipanNormalisasi>
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <kbr:halamanSumber>86</kbr:halamanSumber>
