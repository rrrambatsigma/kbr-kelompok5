  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitHawarDaunBakteriPadiNekrosisTanaman">
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitHawarDaunBakteriPadiKemudianBerubahMenjadiKuningPucat"/>
