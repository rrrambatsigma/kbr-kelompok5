    <rdfs:label xml:lang="id">Penyakit Tungro</rdfs:label>
    <skos:definition xml:lang="id">Penyakit Tungro pada tanaman Padi, disebabkan oleh Rice tungro bacillifor virus, Rice tungro spherical virus, dengan gejala antara lain Bercak pada tanaman, Kerdil tanaman, Klorosis daun, Pertumbuhan terhambat.</skos:definition>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RiceTungroBacilliforVirus"/>
