    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Iklim kering</rdfs:label>
    <rdfs:comment xml:lang="id">Selain bersuhu dingin, apel menghendaki iklim kering atau berhujan 1.000 – 2.500 mm tiap tahunnya dengan intensitas penyinaran matahari sekitar 50 – 60 % per hari.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanLayuFusariumUbiJalarKlorosisDaun">
    <ns1:deskripsiGejala xml:lang="id">(2018) menjelaskan bahwa gejala awal ditandai dengan daun yang terinfeksi berwarna kuning pada bagian atas, diikuti menguningnya pada bagian bawah dan lebih cepat pada daun tua.</ns1:deskripsiGejala>
