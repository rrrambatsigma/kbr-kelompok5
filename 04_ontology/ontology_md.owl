  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBiji">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="id">Gejala Biji</skos:prefLabel>
    <rdfs:comment xml:lang="id">Gejala yang diamati pada biji.</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala lanjut pada daun dapat menyebabkan bentuk dan warna daun tidak normal, biji mengalami distorsi, perubahan warna dan lesi, pada batang akan nampak gejala dieback, kerdil dan roset, sedangkan pada keseluruhan tanaman menjadi kerdil.</rdfs:comment>
    <rdfs:label xml:lang="id">Gejala Biji</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
  </rdf:Description>
