    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT023"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT024"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <skos:altLabel xml:lang="en">Cassava mosaic disease</skos:altLabel>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiKayu"/>
    <rdfs:label xml:lang="id">Cassava Mosaic Begomovirus (CMBs)</rdfs:label>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="id">Penyakit Cassava Mosaic Begomovirus (CMBs) pada tanaman Ubi kayu, disebabkan oleh Begomovirus, dengan gejala antara lain Klorosis daun, Mosaik daun.</skos:definition>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Begomovirus"/>
