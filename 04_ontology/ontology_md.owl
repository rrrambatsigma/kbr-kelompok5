    <skos:altLabel xml:lang="en">Bacterial leaf blight</skos:altLabel>
    <skos:prefLabel xml:lang="id">Hawar daun bakteri</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Bacterial leaf blight</skos:prefLabel>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaHawarDaunBakteriUbiKayuLayuDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaHawarDaunBakteriUbiKayuDaunRontok"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaHawarDaunBakteriUbiKayuHawarDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaHawarDaunBakteriUbiKayuBercakDaun"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenHawarDaunBakteriUbiKayu"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitHawarDaunBakteriUbiKayu"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT021"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT022"/>
    <skos:definition xml:lang="id">Penyakit Hawar daun bakteri pada tanaman Ubi kayu, disebabkan oleh Xanthomonas Campestrispv. Manihotis, dengan gejala antara lain Bercak daun, Daun rontok, Hawar daun, Layu daun.</skos:definition>
    <rdfs:label xml:lang="id">Hawar daun bakteri</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#XanthomonasCampestrispvManihotis"/>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiKayu"/>
    <kbr:identifierSumber>DIS_032</kbr:identifierSumber>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <kbr:deskripsiPenyakit xml:lang="id">Gejala khas berupa bercak atau lesi berair (eksudat seperti getah berwarna krem) pada tangkai daun tanaman terinfeksi. Pada daun gejala muncul urat atau tulang daun,tepi dan ujung bilah daun. Perkembangan infeksi lebih lanjut bercak tersebut menyatu membentuk hawar/bercak coklat besar, daun mengering atau layu, daun gugur.</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuPadaHawarDaunBakteriUbiKayu"/>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#MusimHujanPadaHawarDaunBakteriUbiKayu"/>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanTinggiPadaHawarDaunBakteriUbiKayu"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanVarietasTahan"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PencabutanTanaman"/>
  </rdf:Description>
