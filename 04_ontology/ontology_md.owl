  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#XanthomonasCampestrisPvManihotis">
    <kbr:identifierSumber>PAT_107</kbr:identifierSumber>
    <skos:prefLabel xml:lang="id">Xanthomonas campestris pv. Manihotis</skos:prefLabel>
