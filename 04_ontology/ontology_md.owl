  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBercakDaunKacangHijauTerinfeksiUmumnyaBerbentukBundarHingga">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <ns1:kutipanNormalisasi xml:lang="id">Bercak pada daun terinfeksi umumnya berbentuk agak bundar hingga tidak beraturan, dan umumnya berwarna coklat, bagian tengah berwarna keabu-abuan dan dikelilingi oleh bercak coklat kemerahan dengan bentuk permukaan agak tertekan (Gambar 21).</ns1:kutipanNormalisasi>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <skos:prefLabel xml:lang="id">Bukti gejala BERCAK DAUN</skos:prefLabel>
    <ns1:halamanSumber>59</ns1:halamanSumber>
    <ns1:kutipanSumber xml:lang="id">Bercak pada daun terinfeksi umumnya berbentuk agak bundar hingga tidak beraturan, dan umumnya berwarna coklat, bagian tengah berwarna keabu-abuan dan dikelilingi oleh bercak coklat kemerahan dengan bentuk permukaan agak tertekan (Gambar 21).</ns1:kutipanSumber>
    <ns1:identifierSumber>SYM_622</ns1:identifierSumber>
