  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiIklimLembapPadaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Iklim lembap pada Nekrosis pada titik tunas (Cassava bud necrosis)</rdfs:label>
    <kbr:dokumenSumber>SRC_EXT_029</kbr:dokumenSumber>
    <kbr:identifierSumber>Cassava bud necrosis section</kbr:identifierSumber>
    <kbr:kutipanSumber>Bud necrosis is a fungal disease usually found in cassava growing areas with humid environments. Incidence of the disease is therefore higher in the humid forest zones compared to the drier savanna areas.</kbr:kutipanSumber>
    <kbr:kutipanNormalisasi>Bud necrosis is a fungal disease usually found in cassava growing areas with humid environments. Incidence of the disease is therefore higher in the humid forest zones compared to the drier savanna areas.</kbr:kutipanNormalisasi>
    <kbr:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=direct</kbr:catatanKualitas>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PublikasiSRCEXT029"/>
    <rdfs:comment xml:lang="id">Bukti sumber: Iklim lembap pada Nekrosis pada titik tunas (Cassava bud necrosis); SRC_EXT_029.</rdfs:comment>
  </rdf:Description>
