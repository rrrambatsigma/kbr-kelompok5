    <ns1:identifierSumber>CTL_045</ns1:identifierSumber>
    <ns1:kutipanSumber xml:lang="id">solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian dengan hayati seperti pemanfaatan jamur antagonis Trichoderma virens.</ns1:kutipanSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Rebah Kecambah</rdfs:label>
    <ns1:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ns1:catatanKualitas>
