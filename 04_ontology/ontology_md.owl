  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitHawarDaunBakteriPadiKondisiParahMenjadiKeabuAbuan">
    <ns1:identifierSumber>SYM_011</ns1:identifierSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Hawar Daun Bakteri</rdfs:label>
    <ns1:idChunkSumber>DOC002_C027_03</ns1:idChunkSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <ns1:halamanSumber>27</ns1:halamanSumber>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Hawar Daun Bakteri</skos:prefLabel>
    <ns1:kutipanNormalisasi xml:lang="id">Dalam kondisi yang parah daun tanaman padi menjadi hijau keabu-abuan hingga keputihan dan tiba-tiba layu dan terkadang fase "kresek" penyakit terjadi pada tanaman dewasa.</ns1:kutipanNormalisasi>
