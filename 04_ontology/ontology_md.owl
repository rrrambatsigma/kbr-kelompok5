  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBusukHitamBlackRotUbiJalarBusukTanaman">
    <ns1:deskripsiGejala xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003).</ns1:deskripsiGejala>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003).</rdfs:comment>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBusukHitamBlackRotUbiJalar"/>
    <rdfs:label xml:lang="id">Busuk pada tanaman pada Penyakit busuk hitam (black rot)</rdfs:label>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBusukHitamBlackRotUbiJalarHitamBlackRotDisebabkanCeratocystis"/>
    <skos:prefLabel xml:lang="id">Busuk pada tanaman pada Penyakit busuk hitam (black rot)</skos:prefLabel>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BusukTanaman"/>
  </rdf:Description>
