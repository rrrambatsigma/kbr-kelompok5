  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKudisUbiJalarSelainPemanfaatanFungisidaNabatiEkstrak">
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
