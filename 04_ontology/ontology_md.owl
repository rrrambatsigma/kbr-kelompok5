  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKaratDaunKedelaiBercakDaun">
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKaratDaunKedelaiCendawanUmumnyaNampakMusimKemarau"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala infeksi cendawan umumnya nampak pada musim kemarau, gejala awal ditandai dengan munculnya bercak klorotik kecil yang tidak beraturan pada permukaan daun.</rdfs:comment>
    <rdfs:label xml:lang="id">Bercak daun pada KARAT</rdfs:label>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakDaun"/>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunKedelai"/>
    <skos:prefLabel xml:lang="id">Bercak daun pada KARAT</skos:prefLabel>
    <ns1:deskripsiGejala xml:lang="id">Gejala infeksi cendawan umumnya nampak pada musim kemarau, gejala awal ditandai dengan munculnya bercak klorotik kecil yang tidak beraturan pada permukaan daun.</ns1:deskripsiGejala>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuFusariumKedelaiDilakukanTeknikPengendalianMemperbaikiSaluran">
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <ns1:kutipanSumber xml:lang="id">dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017).</ns1:kutipanSumber>
    <ns1:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ns1:catatanKualitas>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Layu Fusarium</rdfs:label>
    <ns1:idChunkSumber>DOC002_C043_02</ns1:idChunkSumber>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Layu Fusarium</skos:prefLabel>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:identifierSumber>CTL_049</ns1:identifierSumber>
    <ns1:kutipanNormalisasi xml:lang="id">dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017).</ns1:kutipanNormalisasi>
    <ns1:halamanSumber>43</ns1:halamanSumber>
  </rdf:Description>
