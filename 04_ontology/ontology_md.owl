  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitHawarDaunJagungNekrosisDaun">
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <rdfs:label xml:lang="id">Nekrosis daun pada Penyakit Hawar Daun (Jagung)</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitHawarDaunJagung4"/>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#NekrosisDaun"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Gejala nekrosis daun pada tanaman Jagung: Selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan,...</rdfs:comment>
    <rdfs:comment xml:lang="id">Selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan, infeksi lebih lanjut bercak akan melebar dan bergabung dengan bercak lain dan menyebabkan jaringan daun mengalami nekrosis.</rdfs:comment>
    <skos:prefLabel xml:lang="id">Nekrosis daun pada Penyakit Hawar Daun (Jagung)</skos:prefLabel>
    <ns1:deskripsiGejala xml:lang="id">Selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan, infeksi lebih lanjut bercak akan melebar dan bergabung dengan bercak lain dan menyebabkan jaringan daun mengalami nekrosis.</ns1:deskripsiGejala>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitHawarDaunJagung"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangTanah17">
    <ns1:halamanSumber>67</ns1:halamanSumber>
    <ns1:kutipanSumber xml:lang="id">harzianum dapat ditemukan di berbagai tempat, mudah diisolasi dan tumbuh cepat pada berbagai substrat, mampu hidup dan berkembang di rhizosfer dan dekat struktur istirahat patogen, mampu beradaptasi terhadap kondisi untuk dapat diperbanyak secara massal, dapat berperan sebagai biofertilizer dan biostimulan, dapat berperan sebagai biokontrol dengan mekanisme mikoparasit, antibiosis, kompetisi nutrisi dan induksi ketahanan tanaman.</ns1:kutipanSumber>
    <ns1:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ns1:catatanKualitas>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <ns1:identifierSumber>CTL_118</ns1:identifierSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Bercak Daun (Kacang tanah)</rdfs:label>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Bercak Daun (Kacang tanah)</skos:prefLabel>
    <ns1:kutipanNormalisasi xml:lang="id">harzianum dapat ditemukan di berbagai tempat, mudah diisolasi dan tumbuh cepat pada berbagai substrat, mampu hidup dan berkembang di rhizosfer dan dekat struktur istirahat patogen, mampu beradaptasi terhadap kondisi untuk dapat diperbanyak secara massal, dapat berperan sebagai biofertilizer dan biostimulan, dapat berperan sebagai biokontrol dengan mekanisme mikoparasit, antibiosis, kompetisi nutrisi dan induksi ketahanan tanaman.</ns1:kutipanNormalisasi>
    <ns1:idChunkSumber>DOC002_C067_01</ns1:idChunkSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitEmbunPalsuDownyMildewKedelaiPertumbuhanAbnorma">
    <rdfs:comment xml:lang="id">Gejala pertumbuhan abnormal pada tanaman Kedelai: Pada tingkat serangan yang tinggi menyebabkan daun memiliki bentuk yang...</rdfs:comment>
    <rdfs:comment xml:lang="id">Pada tingkat serangan yang tinggi menyebabkan daun memiliki bentuk yang tidak normal.</rdfs:comment>
    <rdfs:label xml:lang="id">Pertumbuhan abnormal pada Penyakit Embun Palsu (Downy mildew) (Kedelai)</rdfs:label>
    <ns1:deskripsiGejala xml:lang="id">Pada tingkat serangan yang tinggi menyebabkan daun memiliki bentuk yang tidak normal.</ns1:deskripsiGejala>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
