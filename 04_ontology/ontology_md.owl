  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakTargetKedelai2">
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <kbr:kutipanSumber xml:lang="id">cassicola, eradikasi lahan dari sisa-sisa tanaman yang terinfeksi patogen dan melakukan sanitasi lahan, melakukan pergiliran tanaman dengan tanaman yang bukan inang patogen C.</kbr:kutipanSumber>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
