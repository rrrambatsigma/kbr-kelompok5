  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCurahHujanPadaCassavaBrownStreakDiseaseCBSDUbiKayu">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Curah hujan pada Cassava Brown Streak Disease (CBSD)</rdfs:label>
    <ns1:dokumenSumber>SRC_EXT_033</ns1:dokumenSumber>
    <ns1:identifierSumber>CBSD symptom expression paragraph</ns1:identifierSumber>
    <ns1:kutipanSumber>The symptom expression depends on the virus strain infecting cassava, cassava variety, and environmental factors (rainfall, temperature, soil nutrient).</ns1:kutipanSumber>
    <ns1:kutipanNormalisasi>The symptom expression depends on the virus strain infecting cassava, cassava variety, and environmental factors (rainfall, temperature, soil nutrient).</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">confidence=medium; review_status=verified; relation_type=direct</ns1:catatanKualitas>
    <rdfs:comment xml:lang="id">Bukti sumber: Curah hujan pada Cassava Brown Streak Disease (CBSD); SRC_EXT_033.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Bunga">
    <rdfs:comment xml:lang="id">Bagian tanaman yang dapat menjadi lokasi gejala.</rdfs:comment>
    <rdfs:comment xml:lang="id">Tanaman padi yang terserang virus tungro umumnya hanya hidup hingga stadia pemasakan dengan gejala terhambatnya proses pembungaan, tidak sempurnanya malai dengan bulir yang tertutup bercak coklat (Puslitbang 2005).</rdfs:comment>
