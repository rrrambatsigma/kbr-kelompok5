    <rdfs:comment xml:lang="id">Gejala penyakit embun tepung adalah adanya tepung putih yang merupakan kumpulan konidia dan konidiofor cendawan (Gambar 16a dan 16b).</rdfs:comment>
    <ns1:deskripsiGejala xml:lang="id">Gejala penyakit embun tepung adalah adanya tepung putih yang merupakan kumpulan konidia dan konidiofor cendawan (Gambar 16a dan 16b).</ns1:deskripsiGejala>
