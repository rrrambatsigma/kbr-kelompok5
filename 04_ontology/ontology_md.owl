    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakTargetKedelai3"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakTargetKedelai2"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitBercakTargetKedelai"/>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CorynesporaCassiicola"/>
    <kbr:identifierSumber>DIS_014</kbr:identifierSumber>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit bercak target (target spot) disebabkan oleh patogen jamur Corynespora cassiicola. Sumber inokulum berasal dari benih yang telah terinfeksi atau dari sisa-sisa tanaman yang tetap berada di lahan dan di dalam</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanTinggiDanDaunBasahPadaPenyakitBercakTargetKedelai"/>
  </rdf:Description>
