    <ns1:dokumenSumber>DOC005</ns1:dokumenSumber>
    <skos:prefLabel xml:lang="id">Bukti gejala KARAT</skos:prefLabel>
    <ns1:identifierSumber>SYM_610</ns1:identifierSumber>
    <ns1:halamanSumber>17</ns1:halamanSumber>
