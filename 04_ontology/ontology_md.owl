    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <rdfs:label xml:lang="id">Pengamatan gejala Penyakit Hawar Daun Bakteri</rdfs:label>
    <skos:prefLabel xml:lang="id">Pengamatan gejala Penyakit Hawar Daun Bakteri</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang belum dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala khas dari penyakit ini adalah tepi bergelombang atau penggulungan yang terlihat jelas pada helaian daun.</rdfs:comment>
    <ns1:deskripsiGejala xml:lang="id">Gejala khas dari penyakit ini adalah tepi bergelombang atau penggulungan yang terlihat jelas pada helaian daun.</ns1:deskripsiGejala>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitHawarDaunJagungSelanjutnyaBerkembangMenjadiBerbentukLonjong">
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <ns1:idChunkSumber>DOC002_C101_02</ns1:idChunkSumber>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Hawar Daun</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Hawar Daun</skos:prefLabel>
    <ns1:kutipanSumber xml:lang="id">Selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan, infeksi lebih lanjut bercak akan melebar dan bergabung dengan bercak lain dan menyebabkan jaringan daun mengalami nekrosis.</ns1:kutipanSumber>
    <ns1:halamanSumber>101</ns1:halamanSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:identifierSumber>SYM_179</ns1:identifierSumber>
    <ns1:kutipanNormalisasi xml:lang="id">Selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan, infeksi lebih lanjut bercak akan melebar dan bergabung dengan bercak lain dan menyebabkan jaringan daun mengalami nekrosis.</ns1:kutipanNormalisasi>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKaratDaunKacangTanahKlorosisDaun">
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Gejala awal penyakit karat di kacang tanah ditandai dengan munculnya bercak klorotik kecil pada permukaan bawah daun, yang bentuknya tidak beraturan.</rdfs:comment>
    <ns1:deskripsiGejala xml:lang="id">Gejala awal penyakit karat di kacang tanah ditandai dengan munculnya bercak klorotik kecil pada permukaan bawah daun, yang bentuknya tidak beraturan.</ns1:deskripsiGejala>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KlorosisDaun"/>
    <skos:prefLabel xml:lang="id">Klorosis daun pada KARAT</skos:prefLabel>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunKacangTanah"/>
    <rdfs:label xml:lang="id">Klorosis daun pada KARAT</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKaratDaunKacangTanahAwalDitandaiMunculnyaKlorotikKecil"/>
  </rdf:Description>
