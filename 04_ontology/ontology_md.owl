  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitAntraknosaKedelai7">
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Antraknosa (Kedelai)</rdfs:label>
    <kbr:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</kbr:catatanKualitas>
    <kbr:kutipanSumber xml:lang="id">truncatum dengan cara melakukan penetrasi pada jaringan tanaman dengan membentuk hifa primer dan diikuti dengan fase nekrotik di mana patogen memproduksi hifa sekunder yang menginfeksi jaringan tanaman secara intra dan interseluler sehingga menyebabkan kematian jaringan sel.</kbr:kutipanSumber>
    <kbr:idChunkSumber>DOC002_C050_02</kbr:idChunkSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:halamanSumber>50</kbr:halamanSumber>
    <kbr:kutipanNormalisasi xml:lang="id">truncatum dengan cara melakukan penetrasi pada jaringan tanaman dengan membentuk hifa primer dan diikuti dengan fase nekrotik di mana patogen memproduksi hifa sekunder yang menginfeksi jaringan tanaman secara intra dan interseluler sehingga menyebabkan kematian jaringan sel.</kbr:kutipanNormalisasi>
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Antraknosa (Kedelai)</skos:prefLabel>
