  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBusukHitamBlackRotUbiJalarHitamBlackRotDisebabkanCeratocystis">
    <ns1:identifierSumber>SYM_171</ns1:identifierSumber>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit busuk hitam (black rot)</skos:prefLabel>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit busuk hitam (black rot)</rdfs:label>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <ns1:kutipanNormalisasi xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003).</ns1:kutipanNormalisasi>
    <ns1:idChunkSumber>DOC002_C087_01</ns1:idChunkSumber>
    <ns1:kutipanSumber xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003).</ns1:kutipanSumber>
    <ns1:halamanSumber>87</ns1:halamanSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitRebahSemaiKedelaiBercakTanaman">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitRebahSemaiKedelaiMenginfeksiBerumur23Minggu"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Patogen ini mampu menginfeksi tanaman pada saat tanaman kedelai berumur 2-3 minggu setelah tanam yang ditandai dengan gejala bercak coklat pada bagian pangkal batang tanaman kedelai (Sofiani et al., 2016).</rdfs:comment>
    <rdfs:label xml:lang="id">Bercak pada tanaman pada Penyakit Rebah Semai</rdfs:label>
    <ns1:deskripsiGejala xml:lang="id">Patogen ini mampu menginfeksi tanaman pada saat tanaman kedelai berumur 2-3 minggu setelah tanam yang ditandai dengan gejala bercak coklat pada bagian pangkal batang tanaman kedelai (Sofiani et al., 2016).</ns1:deskripsiGejala>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakTanaman"/>
    <skos:prefLabel xml:lang="id">Bercak pada tanaman pada Penyakit Rebah Semai</skos:prefLabel>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitRebahSemaiKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiKelembapanRelatifDiAtas78PersenPadaPenyakitKaratDaunKacangTanah">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Kelembapan relatif &gt;78% pada Penyakit Karat Daun</rdfs:label>
    <ns1:dokumenSumber>SRC_EXT_015</ns1:dokumenSumber>
    <ns1:identifierSumber>3.1 Epidemiology, paragraph 3</ns1:identifierSumber>
    <ns1:kutipanSumber>Studies indicate that the disease thrives under sustained high humidity (&gt;78%) and warm temperatures (20–30 °C) [5,20].</ns1:kutipanSumber>
    <ns1:kutipanNormalisasi>Studies indicate that the disease thrives under sustained high humidity (&gt;78%) and warm temperatures (20–30 °C) [5,20].</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=direct</ns1:catatanKualitas>
    <rdfs:comment xml:lang="id">Bukti sumber: Kelembapan relatif &gt;78% pada Penyakit Karat Daun; SRC_EXT_015.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKudisUbiJalarMartanto2010MenjelaskanBahwaMembentuk">
