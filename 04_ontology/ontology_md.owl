    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:namaPengendalian xml:lang="id">Penggunaan insektisida</kbr:namaPengendalian>
    <skos:definition xml:lang="id">Menggunakan insektisida untuk mengendalikan serangga vektor atau hama.</skos:definition>
    <kbr:deskripsiPengendalian xml:lang="id">Apabila ada tanaman yang terinfeksi maka segera dilakukan eradikasi dan dimusnahkan agar tidak menjadi sumber inokulum, dan apabila perkembangan serangga vektor tinggi maka lakukan penyemprotan menggunakan insektisida berbahan aktif imidakloprid (Inayati and Yusnawan, 2017).</kbr:deskripsiPengendalian>
    <skos:altLabel xml:lang="id">penggunaan insektisida</skos:altLabel>
  </rdf:Description>
