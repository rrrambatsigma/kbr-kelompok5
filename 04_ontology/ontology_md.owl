    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Hawar Bakteri (Bacterial Blight) (Kedelai)</rdfs:label>
    <ns1:halamanSumber>55</ns1:halamanSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
