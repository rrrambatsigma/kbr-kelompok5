  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiKondisiTropisDenganPadiSepanjangTahunPadaPenyakitKerdilRumputDanKerdilHampaPadi">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Kondisi tropis dengan padi sepanjang tahun pada Penyakit Kerdil Rumput dan Kerdil Hampa</rdfs:label>
    <kbr:dokumenSumber>SRC_EXT_020</kbr:dokumenSumber>
    <kbr:identifierSumber>Why and where it occurs, paragraph 1</kbr:identifierSumber>
    <kbr:kutipanSumber>Rice ragged stunt virus infection is particularly high in tropical conditions where rice is planted all-year-around and provides a continuous host for the brown plant hopper vector.</kbr:kutipanSumber>
    <kbr:kutipanNormalisasi>Rice ragged stunt virus infection is particularly high in tropical conditions where rice is planted all-year-around and provides a continuous host for the brown plant hopper vector.</kbr:kutipanNormalisasi>
    <kbr:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=vector_mediated</kbr:catatanKualitas>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PublikasiSRCEXT020"/>
    <rdfs:comment xml:lang="id">Bukti sumber: Kondisi tropis dengan padi sepanjang tahun pada Penyakit Kerdil Rumput dan Kerdil Hampa; SRC_EXT_020.</rdfs:comment>
  </rdf:Description>
