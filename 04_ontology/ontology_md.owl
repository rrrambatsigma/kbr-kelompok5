    <kbr:namaPengendalian xml:lang="id">Penggunaan Pseudomonas</kbr:namaPengendalian>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianBiologis"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:altLabel xml:lang="id">penggunaan pseudomonas</skos:altLabel>
    <skos:prefLabel xml:lang="id">Penggunaan Pseudomonas</skos:prefLabel>
    <kbr:deskripsiPengendalian xml:lang="id">Pengendalian hayati dengan agens biokontrol yang telah dilaporkan mampu menekan penyakit hawar daun bakteri di antaranya mikoriza, Paeobacillus polymyxa, Pseudomonas sp.</kbr:deskripsiPengendalian>
    <skos:definition xml:lang="id">Memanfaatkan bakteri Pseudomonas sebagai agens hayati pengendali patogen.</skos:definition>
    <rdfs:label xml:lang="id">Penggunaan Pseudomonas</rdfs:label>
