  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBusukHitamBlackRotUbiJalar2">
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <kbr:idChunkSumber>DOC002_C087_01</kbr:idChunkSumber>
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <kbr:halamanSumber>87</kbr:halamanSumber>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <kbr:kutipanSumber xml:lang="id">fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b).</kbr:kutipanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</kbr:catatanKualitas>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit busuk hitam (black rot) (Ubi jalar)</rdfs:label>
    <kbr:kutipanNormalisasi xml:lang="id">fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b).</kbr:kutipanNormalisasi>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit busuk hitam (black rot) (Ubi jalar)</skos:prefLabel>
    <kbr:identifierSumber>SYM_173</kbr:identifierSumber>
  </rdf:Description>
