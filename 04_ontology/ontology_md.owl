  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT032">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti pengendalian Nekrosis pada titik tunas (Cassava bud necrosis) - Pengaturan jarak tanam</rdfs:label>
    <rdfs:comment xml:lang="id">Bukti sumber untuk tindakan pengendalian eksternal.</rdfs:comment>
    <kbr:kutipanSumber>Incidence and severity of bud necrosis is significantly reduced on farms when good planting distances that allow free movement of air around plants are maintained.</kbr:kutipanSumber>
    <kbr:kutipanNormalisasi>Incidence and severity of bud necrosis is significantly reduced on farms when good planting distances that allow free movement of air around plants are maintained.</kbr:kutipanNormalisasi>
    <kbr:dokumenSumber>SRC_EXT_029</kbr:dokumenSumber>
    <kbr:identifierSumber>Cassava Bud Necrosis &gt; Control &gt; Good Farm Practices</kbr:identifierSumber>
    <kbr:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=relation_type=direct; plant=UbiKayu</kbr:catatanKualitas>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PublikasiSRCEXT029"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0d148dd2c4547eb9ef0a7852664bcc6b32">
