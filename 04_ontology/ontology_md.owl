  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitMosaikKedelaiSoybeanMosaicVirusKedelai">
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitMosaikKedelaiSoybeanMosaicVirusKedelai"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitMosaikKedelaiSoybeanMosaicVirusKede"/>
    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitPenyakitMosaikKedelaiSoybeanMosaicVirusKedelai"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SanitasiLahan"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanInsektisida"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <skos:definition xml:lang="id">Penyakit Mosaik Kedelai (Soybean Mosaic Virus) pada tanaman Kedelai, disebabkan oleh Soybean Mosaic Virus, dengan gejala antara lain Belang pada tanaman, Kerdil tanaman, Klorosis daun, Mosaik daun.</skos:definition>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiKerdilTa"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiBelangTa"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiPertumbu"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiMosaikDa"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiKlorosis"/>
    <kbr:namaInggrisPenyakit>Soybean Mosaic Virus</kbr:namaInggrisPenyakit>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <skos:altLabel xml:lang="id">Soybean Mosaic Virus</skos:altLabel>
    <skos:altLabel xml:lang="en">Soybean Mosaic Virus</skos:altLabel>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SanitasiLahan"/>
    <kbr:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanInsektisida"/>
    <rdfs:label xml:lang="id">Penyakit Mosaik Kedelai (Soybean Mosaic Virus)</rdfs:label>
    <kbr:identifierSumber>DIS_018</kbr:identifierSumber>
    <skos:prefLabel xml:lang="en">Soybean Mosaic Virus</skos:prefLabel>
    <skos:prefLabel xml:lang="id">Penyakit Mosaik Kedelai (Soybean Mosaic Virus)</skos:prefLabel>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SoybeanMosaicVirus"/>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit mosaik kedelai (soybean mosaic virus) atau SMV disebabkan oleh infeksi patogen dari golongan virus. Dapat menyerang tanaman kedelai sejak dari benih disemai. Patogen SMV dapat terbawa oleh benih yang ditanam (seed borne disease). Oleh karena itu benih yang terinfeksi dan membawa patogen SMV merupakan sumber utama terjadinya penyakit. Penyakit akan berkembang pada lahan pertanaman kedelai yang ditularkan oleh serangga famili Aphididae seperti Aphis glycine, A. craccivora, A. fabae, A. gossypii, A. nasturtii dan A. nerii non persisten (Inayati and Yusnawan, 2017).</kbr:deskripsiPenyakit>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#LahanTegalanDiBawahTegakanPohonJatiPadaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiCTLEXT030">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
