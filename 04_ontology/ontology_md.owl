    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <kbr:identifierSumber>DIS_003</kbr:identifierSumber>
    <kbr:menyerangFase rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaseAnakanTanaman"/>
    <kbr:menyerangFase rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaseMatangSusu"/>
    <skos:prefLabel xml:lang="id">Penyakit Hawar Pelepah Daun</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Sheath blight</skos:prefLabel>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Padi"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RhizoctoniaSolani"/>
    <skos:definition xml:lang="id">Penyakit Hawar Pelepah Daun pada tanaman Padi, disebabkan oleh Rhizoctonia solani, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Busuk batang.</skos:definition>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit hawar pelepah daun (HDP) dapat ditemukan pada tiap musim tanam padi. Meskipun tidak sebesar akibat infeksi penyakit HDB dan blas, kehilangan hasil akibat penyakit HDP berkisar antara 20-35% di beberapa negara penghasil beras dunia (Inagaki 2001). Sementara itu, di Indonesia kehilangan hasil yang dilaporkan mencapai 20% (Suparyono dan Sudir 1999).</kbr:deskripsiPenyakit>
    <kbr:tingkatKeparahan xml:lang="id">Meskipun tidak sebesar akibat infeksi penyakit HDB dan blas, kehilangan hasil akibat penyakit HDP berkisar antara 20-35% di beberapa negara penghasil beras dunia (Inagaki 2001).</kbr:tingkatKeparahan>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanRelatifPadaPenyakitHawarPelepahDaunPadi"/>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuPadaPenyakitHawarPelepahDaunPadi"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/RiceSheathBlightFungalDisease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangTanah17">
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Bercak Daun (Kacang tanah)</rdfs:label>
    <kbr:idChunkSumber>DOC002_C067_01</kbr:idChunkSumber>
    <kbr:kutipanNormalisasi xml:lang="id">harzianum dapat ditemukan di berbagai tempat, mudah diisolasi dan tumbuh cepat pada berbagai substrat, mampu hidup dan berkembang di rhizosfer dan dekat struktur istirahat patogen, mampu beradaptasi terhadap kondisi untuk dapat diperbanyak secara massal, dapat berperan sebagai biofertilizer dan biostimulan, dapat berperan sebagai biokontrol dengan mekanisme mikoparasit, antibiosis, kompetisi nutrisi dan induksi ketahanan tanaman.</kbr:kutipanNormalisasi>
    <kbr:dokumenSumber>DOC002</kbr:dokumenSumber>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <kbr:identifierSumber>CTL_118</kbr:identifierSumber>
    <kbr:kutipanSumber xml:lang="id">harzianum dapat ditemukan di berbagai tempat, mudah diisolasi dan tumbuh cepat pada berbagai substrat, mampu hidup dan berkembang di rhizosfer dan dekat struktur istirahat patogen, mampu beradaptasi terhadap kondisi untuk dapat diperbanyak secara massal, dapat berperan sebagai biofertilizer dan biostimulan, dapat berperan sebagai biokontrol dengan mekanisme mikoparasit, antibiosis, kompetisi nutrisi dan induksi ketahanan tanaman.</kbr:kutipanSumber>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Bercak Daun (Kacang tanah)</skos:prefLabel>
