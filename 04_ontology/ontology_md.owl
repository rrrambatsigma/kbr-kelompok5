    <skos:definition xml:lang="id">Penyakit Bercak Target pada tanaman Kedelai, disebabkan oleh Corynespora cassiicola, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Klorosis pada tanaman.</skos:definition>
    <skos:altLabel xml:lang="en">Target spot</skos:altLabel>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <rdfs:label xml:lang="id">Penyakit Bercak Target</rdfs:label>
