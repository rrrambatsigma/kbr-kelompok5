    <rdfs:label xml:lang="id">Bukti gejala BERCAK DAUN</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiPertumbuhanTerhambat">
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiSMVMenunjukkanAdanyaUkuranMenjadi"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <skos:prefLabel xml:lang="id">Pertumbuhan terhambat pada Penyakit Mosaik Kedelai (Soybean Mosaic Virus)</skos:prefLabel>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitMosaikKedelaiSoybeanMosaicVirusKedelai"/>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PertumbuhanTerhambat"/>
    <rdfs:label xml:lang="id">Pertumbuhan terhambat pada Penyakit Mosaik Kedelai (Soybean Mosaic Virus)</rdfs:label>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <rdfs:comment xml:lang="id">Secara umum infeksi patogen SMV pada tanaman akan menunjukkan gejala pada daun adanya mosaik, ukuran daun menjadi kecil, permukaannya tidak rata, daun seperti menggulung ke dalam dan adanya klorosis pada bagian tepi daun dan tanaman kadang-kadang menjadi terhambat pertumbuhannya atau kerdil (Gambar 2.17) (Andayanie, 2012).</rdfs:comment>
    <ns1:deskripsiGejala xml:lang="id">Secara umum infeksi patogen SMV pada tanaman akan menunjukkan gejala pada daun adanya mosaik, ukuran daun menjadi kecil, permukaannya tidak rata, daun seperti menggulung ke dalam dan adanya klorosis pada bagian tepi daun dan tanaman kadang-kadang menjadi terhambat pertumbuhannya atau kerdil (Gambar 2.17) (Andayanie, 2012).</ns1:deskripsiGejala>
  </rdf:Description>
