    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian umum Ubi kayu</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitEmbunPalsuDownyMildewKedelaiPengendalianDilakukanMelakukanEradikasiInokulum">
