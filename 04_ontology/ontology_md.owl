    <kbr:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePembungaanKacangTanah"/>
    <kbr:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePengisianPolongKacangTanah"/>
    <kbr:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePemasakanKacangTanah"/>
  </rdf:Description>
