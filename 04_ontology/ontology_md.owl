  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangHijau">
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBercakDaunKacangHijauBercakDaun"/>
    <ns1:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBercakDaunKacangHijauMenyebabkanDefoliasiPrematurPenguranganUkuran"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CercosporaCanescens"/>
    <ns1:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CercosporaCruenta"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Bercak daun merupakan salah satu penyakit utama kacang hijau. Tidak hanya di Indonesia, tetapi juga di Asia seperti Filipina, Malaysia, Thailand, India, Bangladesh, dan Pakistan. Di Indonesia penyakit ini diketahui di seluruh sentra produksi kacang hijau. Infeksi C. canescens pada kacang hijau menyebabkan kehilangan hasil 46-61% di lahan (Iqbal et al. 1995; Kapadi dan Dhuruj 1999, Sompong et al. 2011).</rdfs:comment>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangHijauPesticidaNabatiSatunyaObatObatan"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangHijauMenjagaAgarLingkunganMikroBawah"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangHijauPenyemprotanEkstrakLengkuasUmur4"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitBercakDaunKacangHijauKedua"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenPenyakitBercakDaunKacangHijauUtama"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakitPenyakitBercakDaunKacangHijauTanpaTeks"/>
    <skos:prefLabel xml:lang="id">Penyakit Bercak Daun</skos:prefLabel>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KacangHijau"/>
    <ns1:identifierSumber>DIS_124</ns1:identifierSumber>
    <skos:altLabel xml:lang="id">BERCAK DAUN</skos:altLabel>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanJarakTanam"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengelolaanGulma"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanEkstrakTanaman"/>
    <ns1:dikendalikanDengan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanKelembapan"/>
