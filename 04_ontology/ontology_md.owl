    <rdfs:label xml:lang="id">Pengumpulan dan pemusnahan</rdfs:label>
    <skos:definition xml:lang="id">Mengumpulkan dan memusnahkan bagian tanaman terserang untuk mengurangi sumber inokulum.</skos:definition>
    <kbr:deskripsiPengendalian xml:lang="id">Jerami dan sisa tunggul dari padi yang terinfeksi dibakar atau dikomposkan untuk mencegah adanya sumber inokulum bagi musim berikutnya.</kbr:deskripsiPengendalian>
  </rdf:Description>
