    <ns1:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <skos:prefLabel xml:lang="id">Penyakit Embun Tepung (Powdery Mildew)</skos:prefLabel>
    <ns1:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ns1:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <ns1:namaInggrisPenyakit>Powdery Mildew</ns1:namaInggrisPenyakit>
    <ns1:identifierSumber>DIS_010</ns1:identifierSumber>
    <rdfs:label xml:lang="id">Penyakit Embun Tepung (Powdery Mildew)</rdfs:label>
    <skos:altLabel xml:lang="id">Powdery Mildew</skos:altLabel>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit ini disebabkan oleh cendawan Erysiphae diffusa yang menginfeksi tanaman kedelai. Patogen E. diffusa menginfeksi daun kedelai bagian bawah sehingga pada permukaan daun bagian bawah terdapat bercak berwarna putih seperti tepung yang merupakan kumpulan dari konidia dan konidiofor patogen</rdfs:comment>
    <ns1:deskripsiPenyakit xml:lang="id">Penyakit ini disebabkan oleh cendawan Erysiphae diffusa yang menginfeksi tanaman kedelai. Patogen E. diffusa menginfeksi daun kedelai bagian bawah sehingga pada permukaan daun bagian bawah terdapat bercak berwarna putih seperti tepung yang merupakan kumpulan dari konidia dan konidiofor patogen</ns1:deskripsiPenyakit>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuPadaPenyakitEmbunTepungPowderyMildewKedelai"/>
    <ns1:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanRendahDenganDaunBasahTerbatasPadaPenyakitEmbunTepungPowderyMildewKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitRebahKecambahKedelaiLayuDaun">
    <skos:prefLabel xml:lang="id">Layu daun pada Penyakit Rebah Kecambah (Kedelai)</skos:prefLabel>
    <ns1:deskripsiGejala xml:lang="id">Tanaman akan layu akibat akar tanaman busuk dan terinfeksi patogen kemudian menyebar pada pangkal batang sehingga menyebabkan rebah semai atau rebah kecambah (Gambar 2.3) (Hidayah and Yulianti, 2015).</ns1:deskripsiGejala>
    <rdfs:comment xml:lang="id">Gejala layu daun pada tanaman Kedelai: Tanaman akan layu akibat akar tanaman busuk dan terinfeksi patogen...</rdfs:comment>
    <rdfs:comment xml:lang="id">Tanaman akan layu akibat akar tanaman busuk dan terinfeksi patogen kemudian menyebar pada pangkal batang sehingga menyebabkan rebah semai atau rebah kecambah (Gambar 2.3) (Hidayah and Yulianti, 2015).</rdfs:comment>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitRebahKecambahKedelai"/>
    <ns1:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitRebahKecambahKedelai5"/>
    <rdfs:label xml:lang="id">Layu daun pada Penyakit Rebah Kecambah (Kedelai)</rdfs:label>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#LayuDaun"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkar">
    <rdfs:label xml:lang="id">Gejala Akar</rdfs:label>
    <skos:prefLabel xml:lang="id">Gejala Akar</skos:prefLabel>
    <rdfs:comment xml:lang="id">Gejala yang diamati pada akar.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pada tanaman yang terinfeksi *R. solani* akan menunjukkan gejala adanya lekukan coklat dan berkembang menjadi warna hitam pada pangkal akar muda yang terinfeksi (Muslim et al., 2019).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
