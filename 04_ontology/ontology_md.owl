  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#ElsinoeBrasiliensis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Patogen"/>
    <skos:prefLabel xml:lang="id">Elsinoe brasiliensis</skos:prefLabel>
    <rdfs:comment xml:lang="id">Patogen yang tercatat pada sumber.</rdfs:comment>
    <rdfs:comment xml:lang="id">Pemanjangan ruas batang yang berlebihan, sehingga batang terbentuk tipis dan lemah dibandingkan tanaman sehat. Gejala pada daun dan tangkai daun di batang muda, deformasi berkembang berasosisi dengan gejala kanker.</rdfs:comment>
    <rdfs:label xml:lang="id">Elsinoe brasiliensis</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogenSuperelongasiUbiKayuSelTabelT52BATANG"/>
    <ns1:identifierSumber>PAT_108</ns1:identifierSumber>
    <ns1:menyebabkanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuperelongasiUbiKayu"/>
    <ns1:namaIlmiahPatogen>Elsinoe brasiliensis</ns1:namaIlmiahPatogen>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Drainase">
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorBudidaya"/>
    <rdfs:label xml:lang="id">Drainase</rdfs:label>
    <skos:prefLabel xml:lang="id">Drainase</skos:prefLabel>
    <rdfs:comment xml:lang="id">Faktor pengaturan drainase.</rdfs:comment>
    <rdfs:comment xml:lang="id">Penyakit yang disebabkan oleh S. rolfsii di lahan yang saluran air atau drainasenya tidak bagus (Saputri et al., 2015).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
