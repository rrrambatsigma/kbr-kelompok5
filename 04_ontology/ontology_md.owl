  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiKondisiTropisDenganPadiSepanjangTahunPadaPenyakitKerdilRumputDanKerdilHampaPadi">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Kondisi tropis dengan padi sepanjang tahun pada Penyakit Kerdil Rumput dan Kerdil Hampa</rdfs:label>
    <ns1:dokumenSumber>SRC_EXT_020</ns1:dokumenSumber>
    <ns1:identifierSumber>Why and where it occurs, paragraph 1</ns1:identifierSumber>
    <ns1:kutipanSumber>Rice ragged stunt virus infection is particularly high in tropical conditions where rice is planted all-year-around and provides a continuous host for the brown plant hopper vector.</ns1:kutipanSumber>
    <ns1:kutipanNormalisasi>Rice ragged stunt virus infection is particularly high in tropical conditions where rice is planted all-year-around and provides a continuous host for the brown plant hopper vector.</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=vector_mediated</ns1:catatanKualitas>
    <rdfs:comment xml:lang="id">Bukti sumber: Kondisi tropis dengan padi sepanjang tahun pada Penyakit Kerdil Rumput dan Kerdil Hampa; SRC_EXT_020.</rdfs:comment>
  </rdf:Description>
