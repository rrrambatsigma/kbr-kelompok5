    <skos:prefLabel xml:lang="id">Kedelai</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Legum"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#TanamanPangan"/>
    <ns1:namaIlmiah>Glycine max L. Merril</ns1:namaIlmiah>
    <ns1:memilikiKondisiTumbuh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiCahayaSedang"/>
    <ns1:memilikiKondisiTumbuh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiSuhuDingin"/>
    <ns1:memilikiKondisiTumbuh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiSuhuSedang"/>
    <ns1:deskripsiTanaman xml:lang="id">Tanaman kedelai (Glycine max L. Merril) salah satu tanaman pangan yang menjadi unggulan pemerintah setelah padi dan jagung (Chamzurni et al., 2011). Kedelai merupakan tanaman yang memiliki kandungan protein yang tinggi untuk memenuhi kebutuhan gizi (Fitria and Masnilah, 2020). Kedelai dapat dijadikan menjadi berbagai olahan pangan bagi masyarakat. Produk olahan dari kedelai dapat berupa makanan ringan atau camilan dan sebagai bahan pembuatan lauk pauk (Krisnawati, 2017). Senyawa fenolik, tanin, antosianin, dan isoflavon terkandung pada biji kedelai (Nurrahman, 2015).</ns1:deskripsiTanaman>
    <ns1:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePerkecambahanKedelai"/>
    <ns1:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaseVegetatifKedelai"/>
    <ns1:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePembungaanKedelai"/>
    <ns1:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePembentukanPolongKedelai"/>
    <ns1:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePembentukanBijiKedelai"/>
    <ns1:memilikiFasePertumbuhan rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePemasakanKedelai"/>
  </rdf:Description>
