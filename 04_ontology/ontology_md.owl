  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitHawarBakteriBacterialBlightKedelaiGlycineDiawaliMunculnyaAwalnyaBerwarna">
