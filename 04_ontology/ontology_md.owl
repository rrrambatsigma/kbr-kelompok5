    <kbr:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiMetadataSeverityPenyakitKaratDaunJagung"/>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <rdfs:label xml:lang="id">Penyakit Karat Daun</rdfs:label>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiSuhuRendah"/>
    <kbr:dipengaruhiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#ObservasiPenyakitKaratDaunJagungSuhu25Koma2Sampai28Koma8Celsius"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <skos:altLabel xml:lang="en">Rust</skos:altLabel>
    <kbr:tingkatKeparahan xml:lang="id">Keparahan penyakit yang disebabkan karat daun dapat berkisar antara 26.67% hingga 90.91%.</kbr:tingkatKeparahan>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanVarietasTahan"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengelolaanGulma"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanKelembapan"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SanitasiLahan"/>
    <kbr:berkaitanPengendalian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanJarakTanam"/>
    <skos:definition xml:lang="id">Penyakit Karat Daun pada tanaman Jagung, disebabkan oleh Puccinia polysora, dengan gejala antara lain Bercak pada tanaman, Klorosis daun.</skos:definition>
    <kbr:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <kbr:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <kbr:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Jagung"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKaratDaunJagungKlorosisDaun"/>
    <kbr:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKaratDaunJagungBercakTanaman"/>
    <kbr:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PucciniaPolysora"/>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <kbr:menyerangFase rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaseGeneratifUmum"/>
    <kbr:deskripsiPenyakit xml:lang="id">Penyakit karat daun pada tanaman jagung disebabkan oleh Puccinia polysora Underw. Jamur patogen ini biasanya menimbulkan gejala pada bagian permukaan daun bagian atas, tidak pada bagian bawah daun. Keparahan lebih lanjut menyebabkan jaringan tanaman mengering dan nekrosis (Debnath et al., 2019).</kbr:deskripsiPenyakit>
  </rdf:Description>
