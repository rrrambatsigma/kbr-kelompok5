  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CassavaMosaicBegomovirusCMBsUbiKayu">
    <skos:prefLabel xml:lang="id">Cassava Mosaic Begomovirus (CMBs)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Cassava mosaic disease</skos:prefLabel>
