    <rdfs:comment xml:lang="id">Selain faktor lingkungan yang menjadi pembatas produksi kedelai, faktor biotik seperti patogen juga menjadi salah satu pembatas menurunnya produksi kedelai.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorRisiko"/>
    <rdfs:label xml:lang="id">Faktor Lingkungan</rdfs:label>
