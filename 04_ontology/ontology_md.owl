    <ns1:idChunkSumber>DOC002_C087_01</ns1:idChunkSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <ns1:identifierSumber>SYM_173</ns1:identifierSumber>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit busuk hitam (black rot) (Ubi jalar)</skos:prefLabel>
    <ns1:halamanSumber>87</ns1:halamanSumber>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ns1:catatanKualitas>
    <ns1:kutipanNormalisasi xml:lang="id">fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b).</ns1:kutipanNormalisasi>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanRelatifDiAtas78PersenPadaPenyakitKaratDaunKacangTanah">
