    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="id">Bukti sumber: Suhu optimal pada Penyakit Bercak Daun Mata Katak (Frogeye Leaf Spot)</rdfs:label>
    <kbr:dokumenSumber>SRC_EXT_010</kbr:dokumenSumber>
    <kbr:identifierSumber>Disease Cycle and Conditions Favorable for Disease, paragraph 1</kbr:identifierSumber>
    <kbr:kutipanSumber>FLS is favored by warm, humid conditions. Frequent rainfall or high humidity (greater than 90% RH) with a temperature range of 77-86°F (25-30°C) are optimal for disease development.</kbr:kutipanSumber>
    <kbr:kutipanNormalisasi>FLS is favored by warm, humid conditions. Frequent rainfall or high humidity (greater than 90% RH) with a temperature range of 77-86°F (25-30°C) are optimal for disease development.</kbr:kutipanNormalisasi>
    <kbr:catatanKualitas xml:lang="id">confidence=high; review_status=verified; relation_type=direct</kbr:catatanKualitas>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PublikasiSRCEXT010"/>
    <rdfs:comment xml:lang="id">Bukti sumber: Suhu optimal pada Penyakit Bercak Daun Mata Katak (Frogeye Leaf Spot); SRC_EXT_010.</rdfs:comment>
  </rdf:Description>
