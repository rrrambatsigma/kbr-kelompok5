  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitEmbunPalsuDownyMildewKedelaiKlorosisTanaman">
    <ns1:deskripsiGejala xml:lang="id">Bercak kemudian berkembang menjadi berwarna kuning ke abuan dan kuning kecokelatan.</ns1:deskripsiGejala>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitEmbunPalsuDownyMildewKedelai2"/>
