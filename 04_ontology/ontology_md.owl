    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKudisUbiJalar"/>
    <rdfs:label xml:lang="id">Gejala pada Penyakit kudis (Ubi jalar): Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat...</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKudisUbiJalar3"/>
    <skos:prefLabel xml:lang="id">Gejala pada Penyakit kudis (Ubi jalar): Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat...</skos:prefLabel>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:deskripsiGejala xml:lang="id">Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997).</ns1:deskripsiGejala>
    <rdfs:comment xml:lang="id">Gejala pada tanaman Ubi jalar: Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat...</rdfs:comment>
    <rdfs:comment xml:lang="id">Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997).</rdfs:comment>
  </rdf:Description>
