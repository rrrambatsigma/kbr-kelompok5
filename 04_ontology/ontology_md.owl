  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKaratDaunJagung6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <ns1:deskripsiGejala xml:lang="id">Laju infeksi ditentukan oleh kenaikan suhu dan kelembaban, meningkatnya suhu dapat menurunkan laju infeksi dan sebaliknya meningkatnya kelembaban dapat meningkatkan laju infeksi (Puspawati and Sudarma, 2016).</ns1:deskripsiGejala>
    <rdfs:label xml:lang="id">Gejala pada Penyakit Karat Daun (Jagung): Laju infeksi ditentukan oleh kenaikan suhu dan kelembaban, meningkatnya...</rdfs:label>
    <ns1:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKaratDaunJagung9"/>
    <skos:prefLabel xml:lang="id">Gejala pada Penyakit Karat Daun (Jagung): Laju infeksi ditentukan oleh kenaikan suhu dan kelembaban, meningkatnya...</skos:prefLabel>
    <rdfs:comment xml:lang="id">Gejala pada tanaman Jagung: Laju infeksi ditentukan oleh kenaikan suhu dan kelembaban, meningkatnya...</rdfs:comment>
    <rdfs:comment xml:lang="id">Laju infeksi ditentukan oleh kenaikan suhu dan kelembaban, meningkatnya suhu dapat menurunkan laju infeksi dan sebaliknya meningkatnya kelembaban dapat meningkatkan laju infeksi (Puspawati and Sudarma, 2016).</rdfs:comment>
    <ns1:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunJagung"/>
  </rdf:Description>
