    <rdfs:range rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakTargetKedelaiCassicolaEradikasiLahanSisaSisa">
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ns1:kutipanNormalisasi xml:lang="id">cassicola, eradikasi lahan dari sisa-sisa tanaman yang terinfeksi patogen dan melakukan sanitasi lahan, melakukan pergiliran tanaman dengan tanaman yang bukan inang patogen C.</ns1:kutipanNormalisasi>
    <ns1:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ns1:catatanKualitas>
    <ns1:halamanSumber>52</ns1:halamanSumber>
    <ns1:identifierSumber>CTL_083</ns1:identifierSumber>
    <ns1:idChunkSumber>DOC002_C052_02</ns1:idChunkSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Bercak Target</skos:prefLabel>
    <ns1:kutipanSumber xml:lang="id">cassicola, eradikasi lahan dari sisa-sisa tanaman yang terinfeksi patogen dan melakukan sanitasi lahan, melakukan pergiliran tanaman dengan tanaman yang bukan inang patogen C.</ns1:kutipanSumber>
    <ns1:dokumenSumber>DOC002</ns1:dokumenSumber>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Bercak Target</rdfs:label>
  </rdf:Description>
