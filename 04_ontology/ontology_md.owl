  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumKacangTanahTingginyaHargaAntibiotikAdanyaPermintaan">
    <ns1:idChunkSumber>DOC002_C077_02</ns1:idChunkSumber>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
