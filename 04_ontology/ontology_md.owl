    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
    <ns1:halamanSumber>67</ns1:halamanSumber>
    <ns1:kutipanSumber xml:lang="id">harzianum juga dapat memarasit miselium jamur lain dengan menembus dinding sel dan masuk ke dalam sel untuk mengambil zat makanan dari dalam sel sehingga jamur menjadi mati, dalam proses kompetisi jamur T.</ns1:kutipanSumber>
