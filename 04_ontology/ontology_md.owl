    <rdfs:label xml:lang="id">Grobogan</rdfs:label>
    <skos:prefLabel xml:lang="id">Grobogan</skos:prefLabel>
    <ns1:merupakanVarietasDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiVarietasKedelaiRolfsiiBahwaDena1Tingkat">
    <ns1:kutipanNormalisasi xml:lang="id">rolfsii diketahui bahwa Varietas Dena 1 tingkat keparahan penyakitnya lebih rendah dibandingkan dengan varietas Anjasmoro, Devon 1, Dering 1, Grobogan, dan Dega 1 yaitu 30% yang termasuk ke dalam varietas tahan.</ns1:kutipanNormalisasi>
