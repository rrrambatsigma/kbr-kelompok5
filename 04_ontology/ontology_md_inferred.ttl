                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Embun Palsu (Downy mildew)"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitEmbunTepungKacangHijau
:PenyakitEmbunTepungKacangHijau rdf:type owl:NamedIndividual ,
                                         :EntitasKBR ,
                                         :Penyakit ,
                                         :PenyakitJamur ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :disebabkanOleh ;
                                           owl:someValuesFrom :Jamur
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :memilikiGejala ;
                                           owl:someValuesFrom :Gejala
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :menyerangTanaman ;
                                           owl:someValuesFrom :TanamanPangan
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :disebabkanOleh ;
                                           owl:allValuesFrom :Patogen
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :memilikiReferensi ;
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :Referensi
                                         ] ;
                                :berkaitanPengendalian :PenggunaanAgensHayati ,
                                                       :PenggunaanEkstrakTanaman ,
                                                       :PenggunaanFungisida ,
                                                       :PenggunaanPestisidaNabati ,
                                                       :PenggunaanVarietasTahan ;
                                :didukungOleh :BuktiPatogenPenyakitEmbunTepungKacangHijau ,
                                              :BuktiPengendalianPenyakitEmbunTepungKacangHijau ,
                                              :BuktiPengendalianPenyakitEmbunTepungKacangHijau2 ,
                                              :BuktiPengendalianPenyakitEmbunTepungKacangHijau3 ,
                                              :BuktiPenyakitPenyakitEmbunTepungKacangHijau ;
                                :dikendalikanDengan :PenggunaanAgensHayati ,
                                                    :PenggunaanEkstrakTanaman ,
                                                    :PenggunaanFungisida ,
                                                    :PenggunaanPestisidaNabati ,
                                                    :PenggunaanVarietasTahan ;
                                :dipengaruhiOleh :KelembapanTinggiPadaPenyakitEmbunTepungKacangHijau ,
                                                 :SuhuPadaPenyakitEmbunTepungKacangHijau ;
                                :disebabkanOleh :ErysiphePolygoni ;
                                :memilikiGejala :GejalaPenyakitEmbunTepungKacangHijauTepungDaun ;
                                :memilikiReferensi :BukuDOC005 ;
                                :menyerangBagian :Daun ;
                                :menyerangTanaman :KacangHijau ;
                                :deskripsiPenyakit "Salah satu penyakit utama pada kacang hijau adalah embun tepung. Meskipun telah lama diketahui namun jarang dikendalikan karena keterbatasan pengetahuan petani terhadap penyakit tersebut. Penyakit embun tepung tersebar luas di seluruh negara sentra produksi kacang hijau, meliputi India, Pakistan, Thailand, China, Myanmar, dan Indonesia (Khodaparast dan Abbasi 2009, Nair et al. 2014). Penurunan hasil kacang hijau akibat penyakit embun tepung di Thailand mencapai 26,2% (Tantanapornkul et al. 2005). Petani jarang mengendalikan penyakit embun tepung, dan jika dikendalikan masih menggunakan fungisida yang tidak ramah lingkungan."@id ;
                                :identifierSumber "DIS_123" ;
                                :tingkatKeparahan "Penurunan hasil kacang hijau akibat penyakit embun tepung di Thailand mencapai 26,2% (Tantanapornkul et al. 2005)."@id ;
                                rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                             "Salah satu penyakit utama pada kacang hijau adalah embun tepung. Meskipun telah lama diketahui namun jarang dikendalikan karena keterbatasan pengetahuan petani terhadap penyakit tersebut. Penyakit embun tepung tersebar luas di seluruh negara sentra produksi kacang hijau, meliputi India, Pakistan, Thailand, China, Myanmar, dan Indonesia (Khodaparast dan Abbasi 2009, Nair et al. 2014). Penurunan hasil kacang hijau akibat penyakit embun tepung di Thailand mencapai 26,2% (Tantanapornkul et al. 2005). Petani jarang mengendalikan penyakit embun tepung, dan jika dikendalikan masih menggunakan fungisida yang tidak ramah lingkungan."@id ;
                                rdfs:label "Penyakit Embun Tepung"@id ;
                                <http://www.w3.org/2004/02/skos/core#altLabel> "EMBUN TEPUNG"@id ;
                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Embun Tepung"@id .


