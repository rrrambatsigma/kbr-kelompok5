###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Legum
:Legum rdf:type owl:Class ;
       owl:equivalentClass [ rdf:type owl:Class ;
                             owl:oneOf ( :KacangHijau
                                         :KacangTanah
                                         :Kedelai
                                       )
                           ] ;
       rdfs:subClassOf :TanamanPangan ,
                       [ rdf:type owl:Class ;
                         owl:oneOf ( :KacangHijau
                                     :KacangTanah
                                     :Kedelai
                                   )
                       ] ;
       owl:disjointWith :Musim ,
                        :Observasi ,
                        :ObservasiLingkungan ,
                        :Oomycete ,
                        :Patogen ,
                        :Pengendalian ,
                        :PengendalianBiologis ,
                        :PengendalianFisik ,
                        :PengendalianKimiawi ,
                        :PengendalianKulturTeknis ,
                        :PengendalianMekanis ,
                        :PengendalianTerpadu ,
                        :Penyakit ,
                        :PenyakitBakteri ,
                        :PenyakitFitoplasma ,
                        :PenyakitJamur ,
                        :PenyakitOomycete ,
                        :PenyakitVirus ,
                        :PublikasiInstansi ,
                        :Referensi ,
                        :Serealia ,
                        :Suhu ,
                        :TeksturTanah ,
                        :UmbiUmbian ,
                        :Varietas ,
                        :VarietasUnggul ,
                        :Virus ;
       rdfs:comment "Hal ini karena patogen *S. rolfsii* memiliki kisaran inang yang luas seperti famili *leguminoceae*, *Cruciferaceae*, *Cucurbitaceae*, tanaman pisang, jeruk, gandum, padi, tebu, bit, keladi, bahkan tanaman rempah (Sumartini, 2012)."@id ,
                    "Kelompok tanaman pangan legum dalam ruang lingkup."@id ;
       rdfs:label "Legum"@id ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Legum"@id .


