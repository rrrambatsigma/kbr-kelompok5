                                                                     :Umbi ;
                                                       :deskripsiGejala "fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b)."@id ;
                                                       rdfs:comment "Gejala bercak pada tanaman pada tanaman Ubi jalar: fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau..."@id ,
                                                                    "fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b)."@id ;
                                                       rdfs:label "Bercak pada tanaman pada Penyakit busuk hitam (black rot) (Ubi jalar)"@id ;
                                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Bercak pada tanaman pada Penyakit busuk hitam (black rot) (Ubi jalar)"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBusukHitamBlackRotUbiJalarBusukAkar
:GejalaPenyakitBusukHitamBlackRotUbiJalarBusukAkar rdf:type owl:NamedIndividual ,
                                                            :EntitasKBR ,
                                                            :Gejala ,
                                                            :GejalaAkar ;
                                                   :didukungOleh :BuktiGejalaPenyakitBusukHitamBlackRotUbiJalar3 ;
                                                   :memilikiGejalaKanonik :BusukAkar ;
                                                   :merupakanGejalaDari :PenyakitBusukHitamBlackRotUbiJalar ;
                                                   :terdapatPada :Akar ;
                                                   :deskripsiGejala "Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020)."@id ;
                                                   rdfs:comment "Gejala busuk akar pada tanaman Ubi jalar: Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok..."@id ,
                                                                "Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020)."@id ;
                                                   rdfs:label "Busuk akar pada Penyakit busuk hitam (black rot) (Ubi jalar)"@id ;
                                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Busuk akar pada Penyakit busuk hitam (black rot) (Ubi jalar)"@id .


