                         :dipengaruhiOleh :KondisiSuhuRendah ,
                                          :ObservasiPenyakitKaratDaunJagungSuhu25Koma2Sampai28Koma8Celsius ;
                         :disebabkanOleh :PucciniaPolysora ;
                         :memilikiGejala :GejalaPenyakitKaratDaunJagung ,
                                         :GejalaPenyakitKaratDaunJagung2 ,
                                         :GejalaPenyakitKaratDaunJagung3 ,
                                         :GejalaPenyakitKaratDaunJagung4 ,
                                         :GejalaPenyakitKaratDaunJagung5 ,
                                         :GejalaPenyakitKaratDaunJagung6 ,
