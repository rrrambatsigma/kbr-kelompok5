[ owl:intersectionOf ( :Penyakit
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :disebabkanOleh ;
                         owl:someValuesFrom :Virus
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :Penyakit
] .


[ owl:intersectionOf ( :Penyakit
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :disebabkanOleh ;
                         owl:someValuesFrom :Virus
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :PenyakitVirus
] .


[ rdf:type owl:Class ;
  owl:oneOf ( :Jagung
              :Padi
            ) ;
  rdfs:subClassOf :Serealia
] .


[ rdf:type owl:Class ;
  owl:oneOf ( :Jagung
              :Padi
            ) ;
  rdfs:subClassOf :TanamanPangan
] .


[ rdf:type owl:Class ;
  owl:oneOf ( :KacangHijau
              :KacangTanah
              :Kedelai
            ) ;
  rdfs:subClassOf :Legum
] .


[ rdf:type owl:Class ;
  owl:oneOf ( :KacangHijau
              :KacangTanah
              :Kedelai
            ) ;
  rdfs:subClassOf :TanamanPangan
] .


[ rdf:type owl:Class ;
  owl:oneOf ( :UbiJalar
              :UbiKayu
            ) ;
  rdfs:subClassOf :TanamanPangan
] .


[ rdf:type owl:Class ;
  owl:oneOf ( :UbiJalar
              :UbiKayu
            ) ;
  rdfs:subClassOf :UmbiUmbian
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Bakteri
                :Fitoplasma
                :Jamur
                :Oomycete
                :Virus
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Buku
                :JurnalIlmiah
                :PublikasiInstansi
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :FaseAnakan
                :FaseGeneratif
                :FasePanen
                :FasePemasakan
                :FasePembibitan
                :FaseVegetatif
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Legum
                :Serealia
                :UmbiUmbian
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :PengendalianBiologis
                :PengendalianFisik
                :PengendalianKimiawi
                :PengendalianKulturTeknis
                :PengendalianMekanis
                :PengendalianTerpadu
              )
