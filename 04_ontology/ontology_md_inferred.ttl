                                 :menyerangBagian :Daun ;
                                 :menyerangTanaman :KacangTanah ;
                                 :deskripsiPenyakit "Penyakit belang merupakan penyakit yang disebabkan oleh virus. Virus yang menyerang yaitu Peanut mottle virus (PeMoV) maupun Peanut stripe virus (PStV). Serangga vektor yang membawa virus menginfeksi tanaman kacang tanah adalah Aphids sp. Aphis dengan tipe mulut mencucuk menghisap merupakan vektor PStV yang efisien. Silet Aphis dalam waktu singkat dapat menghisap cairan daun yang berada di jaringan epidermis dan endodermis. Ukuran tubuh yang kecil dan ringan menyebabkan penyebaran hama ini terjadi secara pasif dengan bantuan angin. Secara alami, penyebaran Aphis dapat mencapai 50-100."@id ;
                                 :identifierSumber "DIS_022" ;
                                 :namaInggrisPenyakit "Mottle" ;
                                 rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                              "Penyakit belang merupakan penyakit yang disebabkan oleh virus. Virus yang menyerang yaitu Peanut mottle virus (PeMoV) maupun Peanut stripe virus (PStV). Serangga vektor yang membawa virus menginfeksi tanaman kacang tanah adalah Aphids sp. Aphis dengan tipe mulut mencucuk menghisap merupakan vektor PStV yang efisien. Silet Aphis dalam waktu singkat dapat menghisap cairan daun yang berada di jaringan epidermis dan endodermis. Ukuran tubuh yang kecil dan ringan menyebabkan penyebaran hama ini terjadi secara pasif dengan bantuan angin. Secara alami, penyebaran Aphis dapat mencapai 50-100."@id ;
                                 rdfs:label "Penyakit Belang (Mottle)"@id ;
                                 <http://www.w3.org/2004/02/skos/core#altLabel> "Mottle"@id ;
                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Belang (Mottle)"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakBijiUnguKedelai
:PenyakitBercakBijiUnguKedelai rdf:type owl:NamedIndividual ,
                                        :EntitasKBR ,
                                        :Penyakit ,
                                        :PenyakitJamur ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :disebabkanOleh ;
                                          owl:someValuesFrom :Jamur
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :memilikiGejala ;
                                          owl:someValuesFrom :Gejala
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :menyerangTanaman ;
                                          owl:someValuesFrom :TanamanPangan
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :disebabkanOleh ;
                                          owl:allValuesFrom :Patogen
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :memilikiReferensi ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass :Referensi
                                        ] ;
                               :berkaitanPengendalian :PenggunaanFungisida ,
                                                      :PerlakuanBenih ;
                               :didukungOleh :BuktiPatogenPenyakitBercakBijiUnguKedelai ,
                                             :BuktiPengendalianPenyakitBercakBijiUnguKedelai ,
                                             :BuktiPenyakitPenyakitBercakBijiUnguKedelai ;
                               :dikendalikanDengan :PenggunaanFungisida ,
                                                   :PerlakuanBenih ;
                               :dipengaruhiOleh :KelembapanTinggiDanSuhuHangatPadaPenyakitBercakBijiUnguKedelai ;
                               :disebabkanOleh :CercosporaKikuchii ;
                               :memilikiGejala :GejalaPenyakitBercakBijiUnguKedelai ,
                                               :GejalaPenyakitBercakBijiUnguKedelai2 ,
                                               :GejalaPenyakitBercakBijiUnguKedelai3 ,
                                               :GejalaPenyakitBercakBijiUnguKedelai4 ,
                                               :GejalaPenyakitBercakBijiUnguKedelaiBercakDaun ,
                                               :GejalaPenyakitBercakBijiUnguKedelaiBercakTanaman ,
                                               :GejalaPenyakitBercakBijiUnguKedelaiHawarDaun ,
                                               :GejalaPenyakitBercakBijiUnguKedelaiNekrosisDaun ;
                               :memilikiReferensi :BukuDOC002 ;
                               :menyerangBagian :Biji ;
                               :menyerangTanaman :Kedelai ;
                               :deskripsiPenyakit "Penyakit bercak biji ungu atau juga dikenal dengan hawar daun Cercospora merupakan penyakit pada tanaman kedelai yang disebabkan oleh patogen Cercospora kikuchii. Penyakit bercak biji ungu atau hawar daun Cercospora merupakan penyakit yang penting juga pada tanaman kedelai karena dapat menyebabkan kehilangan hasil. Patogen C. kikuchii dapat menginfeksi bagian tanaman kedelai seperti daun, batang dan polong (Cai and Schneider, 2008). Gejala pada tanaman kedelai yang terinfeksi patogen C. kikuchii adalah adanya perubahan warna daun menjadi ungu muda pada permukaan daun atas yang biasanya dimulai pada bagian pinggir daun kemudian dapat melebar dan luas hingga menutupi seluruh permukaan daun tanaman kedelai berwarna ungu. Gejala ini biasanya dianggap sebagai gejala karena pengaruh cahaya matahari."@id ;
                               :identifierSumber "DIS_015" ;
                               rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                            "Penyakit bercak biji ungu atau juga dikenal dengan hawar daun Cercospora merupakan penyakit pada tanaman kedelai yang disebabkan oleh patogen Cercospora kikuchii. Penyakit bercak biji ungu atau hawar daun Cercospora merupakan penyakit yang penting juga pada tanaman kedelai karena dapat menyebabkan kehilangan hasil. Patogen C. kikuchii dapat menginfeksi bagian tanaman kedelai seperti daun, batang dan polong (Cai and Schneider, 2008). Gejala pada tanaman kedelai yang terinfeksi patogen C. kikuchii adalah adanya perubahan warna daun menjadi ungu muda pada permukaan daun atas yang biasanya dimulai pada bagian pinggir daun kemudian dapat melebar dan luas hingga menutupi seluruh permukaan daun tanaman kedelai berwarna ungu. Gejala ini biasanya dianggap sebagai gejala karena pengaruh cahaya matahari."@id ;
                               rdfs:label "Penyakit Bercak Biji Ungu"@id ;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Bercak Biji Ungu"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangHijau
