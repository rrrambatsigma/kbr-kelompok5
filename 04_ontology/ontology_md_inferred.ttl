                           :memilikiReferensi :BukuDOC002 ,
                                              :BukuDOC005 ;
                           :menyerangBagian :Batang ,
                                            :Daun ,
                                            :Polong ;
                           :menyerangFase :FaseVegetatifUmum ;
                           :menyerangTanaman :Kedelai ;
                           :deskripsiPenyakit "Penyakit antraknosa menjadi masalah pada semua negara yang mengembangkan komoditi kedelai. Penyakit antraknosa disebabkan oleh patogen Colletotrichum dengan spesies yang berbeda-beda. Beberapa spesies Colletotrichum yang dapat menginfeksi tanaman kedelai seperti C. acutatum,"@id ;
                           :identifierSumber "DIS_013" ,
                                             "DIS_120" ;
                           rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                        "Penyakit antraknosa menjadi masalah pada semua negara yang mengembangkan komoditi kedelai. Penyakit antraknosa disebabkan oleh patogen Colletotrichum dengan spesies yang berbeda-beda. Beberapa spesies Colletotrichum yang dapat menginfeksi tanaman kedelai seperti C. acutatum,"@id ;
