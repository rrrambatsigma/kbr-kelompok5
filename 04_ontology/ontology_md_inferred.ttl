               rdfs:label "tahan terhadap"@id ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "tahan terhadap"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#terdapatPada
:terdapatPada rdf:type owl:ObjectProperty ;
              rdfs:domain :EntitasKBR ,
                          :Gejala ;
              rdfs:range :BagianTanaman ,
