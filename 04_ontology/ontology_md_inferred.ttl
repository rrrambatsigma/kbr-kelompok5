                                             :SanitasiLahan ;
                         :dipengaruhiOleh :DaunBasahPadaPenyakitHawarDaunJagung ,
                                          :SuhuPadaPenyakitHawarDaunJagung ;
                         :disebabkanOleh :HelminthosporiumMaydis ;
                         :memilikiGejala :GejalaPenyakitHawarDaunJagungBercakDaun ,
                                         :GejalaPenyakitHawarDaunJagungBercakTanaman ,
                                         :GejalaPenyakitHawarDaunJagungHawarDaun ,
                                         :GejalaPenyakitHawarDaunJagungNekrosisDaun ;
                         :memilikiReferensi :BukuDOC002 ;
                         :menyerangBagian :Daun ;
                         :menyerangFase :FaseGeneratifUmum ;
                         :menyerangTanaman :Jagung ;
                         :deskripsiPenyakit "Penyakit hawar daun pada jagung disebabkan oleh jamur patogen Helminthosporium maydis Y. Nisik & C.Miyake (Kuilya et al., 2018; Hamidson, Suwandi and Effendy, 2019) atau Helminthosporium turticum (Pass.) Leonard et Suggs (Faizah, 2017). Koloni Helinthosporium maydis yang ditumbuhkan pada media PDA awalnya berwarna keputihan kusam, coklat pucat, selanjutnya menjadi berwarna coklat agak gelap. Hifanya bersekat dengan sekat agak longgar. Konidia berdinding tipis dan mempunyai 7-10 sekat. Setelah 8 hari ditumbuhkan pada media PDA, panjang diameter mencapai 8.75 cm."@id ;
                         :identifierSumber "DIS_044" ;
                         :tingkatKeparahan "Keparahan penyakit hawar jagung terus meningkat pada setiap pengamatan dari 40.83% hingga 83.78%."@id ;
                         rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                      "Penyakit hawar daun pada jagung disebabkan oleh jamur patogen Helminthosporium maydis Y. Nisik & C.Miyake (Kuilya et al., 2018; Hamidson, Suwandi and Effendy, 2019) atau Helminthosporium turticum (Pass.) Leonard et Suggs (Faizah, 2017). Koloni Helinthosporium maydis yang ditumbuhkan pada media PDA awalnya berwarna keputihan kusam, coklat pucat, selanjutnya menjadi berwarna coklat agak gelap. Hifanya bersekat dengan sekat agak longgar. Konidia berdinding tipis dan mempunyai 7-10 sekat. Setelah 8 hari ditumbuhkan pada media PDA, panjang diameter mencapai 8.75 cm."@id ;
                         rdfs:label "Penyakit Hawar Daun"@id ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Hawar Daun"@id .


