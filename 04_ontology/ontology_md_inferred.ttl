###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#LayuFusariumUbiJalar
:LayuFusariumUbiJalar rdf:type owl:NamedIndividual ,
                               :EntitasKBR ,
                               :Penyakit ,
                               :PenyakitJamur ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :disebabkanOleh ;
                                 owl:someValuesFrom :Jamur
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :memilikiGejala ;
                                 owl:someValuesFrom :Gejala
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :menyerangTanaman ;
                                 owl:someValuesFrom :TanamanPangan
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :disebabkanOleh ;
                                 owl:allValuesFrom :Patogen
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :memilikiReferensi ;
                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Referensi
                               ] ;
                      :berkaitanPengendalian :PengaturanSuhuPenyimpanan ,
                                             :PenggunaanFungisida ,
                                             :PenggunaanVarietasTahan ,
                                             :SanitasiLahan ;
                      :didukungOleh :BuktiPatogenLayuFusariumUbiJalar ,
                                    :BuktiPengendalianLayuFusariumUbiJalar ,
                                    :BuktiPengendalianLayuFusariumUbiJalar2 ,
                                    :BuktiPengendalianLayuFusariumUbiJalar3 ,
                                    :BuktiPengendalianLayuFusariumUbiJalar4 ,
                                    :BuktiPengendalianLayuFusariumUbiJalar5 ,
                                    :BuktiPenyakitLayuFusariumUbiJalar ;
                      :dikendalikanDengan :PengaturanSuhuPenyimpanan ,
                                          :PenggunaanFungisida ,
                                          :PenggunaanVarietasTahan ,
                                          :SanitasiLahan ;
                      :dipengaruhiOleh :KelembapanTanah2875PersenPadaLayuFusariumUbiJalar ,
                                       :SuhuInfeksiOptimalPadaLayuFusariumUbiJalar ;
                      :disebabkanOleh :FusariumOxysporum ;
                      :memilikiGejala :GejalaLayuFusariumUbiJalar ,
                                      :GejalaLayuFusariumUbiJalarBusukTanaman ,
                                      :GejalaLayuFusariumUbiJalarKematianTanaman ,
                                      :GejalaLayuFusariumUbiJalarKerdilTanaman ,
                                      :GejalaLayuFusariumUbiJalarKlorosisDaun ,
                                      :GejalaLayuFusariumUbiJalarLayuDaun ,
                                      :GejalaLayuFusariumUbiJalarMiseliumPadaTanaman ,
                                      :GejalaLayuFusariumUbiJalarNekrosisTanaman ;
                      :memilikiReferensi :BukuDOC002 ;
                      :menyerangBagian :Batang ,
                                       :Daun ,
                                       :Umbi ;
                      :menyerangTanaman :UbiJalar ;
                      :deskripsiPenyakit "Banyak dilaporkan bahwa Fusarium spp. menginfeksi ubi jalar di antaranya F. solani, F. proliferatum (Scruggs and Quesada-Ocampo, 2016), F. oxysporum (Scattolini, Hernandez and Gonzales, 2020), F. circinatum (Mousa et al., 2018), F. graminearum (Gaffoor et al., 2005). Genus Fusarium terkenal karena kemampuannya menghasilkan metabolit sekunder, beberapa di antaranya bersifat toksik pada manusia dan hewan (Desjardins, 2006). Berikut ini akan diuraikan F. oxysporum yang merupakan patogen penting pada ubi jalar."@id ;
                      :identifierSumber "DIS_024" ;
                      rdfs:comment "Banyak dilaporkan bahwa Fusarium spp. menginfeksi ubi jalar di antaranya F. solani, F. proliferatum (Scruggs and Quesada-Ocampo, 2016), F. oxysporum (Scattolini, Hernandez and Gonzales, 2020), F. circinatum (Mousa et al., 2018), F. graminearum (Gaffoor et al., 2005). Genus Fusarium terkenal karena kemampuannya menghasilkan metabolit sekunder, beberapa di antaranya bersifat toksik pada manusia dan hewan (Desjardins, 2006). Berikut ini akan diuraikan F. oxysporum yang merupakan patogen penting pada ubi jalar."@id ,
                                   "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ;
                      rdfs:label "layu fusarium"@id ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "layu fusarium"@id .


