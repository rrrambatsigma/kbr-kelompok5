###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu
:NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu rdf:type owl:NamedIndividual ,
                                                          :EntitasKBR ,
                                                          :Penyakit ,
                                                          :PenyakitJamur ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :disebabkanOleh ;
                                                            owl:someValuesFrom :Jamur
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :memilikiGejala ;
                                                            owl:someValuesFrom :Gejala
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :menyerangTanaman ;
                                                            owl:someValuesFrom :TanamanPangan
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :disebabkanOleh ;
                                                            owl:allValuesFrom :Patogen
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :memilikiReferensi ;
                                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onClass :Referensi
                                                          ] ;
                                                 :didukungOleh :BuktiPatogenNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu ,
                                                               :BuktiPenyakitNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu ;
                                                 :dipengaruhiOleh :IklimLembapPadaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu ,
                                                                  :KelembapanTinggiPadaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu ;
                                                 :disebabkanOleh :FungiJamur ;
                                                 :memilikiGejala :GejalaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuBercakT ,
                                                                 :GejalaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuNekrosi ;
                                                 :memilikiReferensi :BukuDOC002 ;
                                                 :menyerangBagian :Pucuk ;
                                                 :menyerangTanaman :UbiKayu ;
                                                 :deskripsiPenyakit "Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas"@id ;
                                                 :identifierSumber "DIS_039" ;
                                                 rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                                              "Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas"@id ;
                                                 rdfs:label "Nekrosis pada titik tunas (Cassava bud necrosis)"@id ;
                                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Nekrosis pada titik tunas (Cassava bud necrosis)"@id .


