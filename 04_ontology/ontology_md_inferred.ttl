             :identifierSumber "PAT_105" ;
             :namaIlmiahPatogen "Begomovirus" ;
             rdfs:comment "Patogen yang tercatat pada sumber."@id ;
             rdfs:label "Begomovirus"@id ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Begomovirus"@id .


