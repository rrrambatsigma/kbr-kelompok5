###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#TanamanKerdilStuntUbiKayu
:TanamanKerdilStuntUbiKayu rdf:type owl:NamedIndividual ,
                                    :EntitasKBR ,
                                    :Penyakit ,
                                    :PenyakitVirus ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :disebabkanOleh ;
                                      owl:someValuesFrom :Virus
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :memilikiGejala ;
                                      owl:someValuesFrom :Gejala
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :menyerangTanaman ;
                                      owl:someValuesFrom :TanamanPangan
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :disebabkanOleh ;
                                      owl:allValuesFrom :Patogen
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :memilikiReferensi ;
                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :Referensi
                                    ] ;
                           :didukungOleh :BuktiPatogenTanamanKerdilStuntUbiKayu ,
                                         :BuktiPenyakitTanamanKerdilStuntUbiKayu ;
                           :dipengaruhiOleh :SuhuCurahHujanDanAnginPadaTanamanKerdilStuntUbiKayu ;
                           :disebabkanOleh :Begomovirus ;
                           :memilikiGejala :GejalaTanamanKerdilStuntUbiKayu ;
                           :memilikiReferensi :BukuDOC002 ;
                           :menyerangBagian :Batang ;
                           :menyerangTanaman :UbiKayu ;
                           :deskripsiPenyakit "Tanaman tidak tumbuh secara normal, gejala ini umumnya terjadi pada tanaman yang mengalami infeksi awal oleh virus ini. Tanaman yang terinfeksi virus ini umumnya akan memiliki batang yang berukuran kecil"@id ;
                           :identifierSumber "DIS_038" ;
                           rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                        "Tanaman tidak tumbuh secara normal, gejala ini umumnya terjadi pada tanaman yang mengalami infeksi awal oleh virus ini. Tanaman yang terinfeksi virus ini umumnya akan memiliki batang yang berukuran kecil"@id ;
                           rdfs:label "Tanaman kerdil (stunt)"@id ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Tanaman kerdil (stunt)"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#TepungDaun
:TepungDaun rdf:type owl:NamedIndividual ,
                     :EntitasKBR ,
