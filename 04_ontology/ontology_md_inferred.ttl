             :memilikiKondisiTumbuh :KondisiSuhuHangat ;
             :memilikiVarietas :VarietasBadak ,
                               :VarietasBison ,
                               :VarietasDomba ,
                               :VarietasJerapah ,
                               :VarietasKelinci ,
                               :VarietasPanther ,
