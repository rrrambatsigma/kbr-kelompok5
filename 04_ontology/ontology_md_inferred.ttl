###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitTungroPadiBercakTanaman
:GejalaPenyakitTungroPadiBercakTanaman rdf:type owl:NamedIndividual ,
                                                :EntitasKBR ,
                                                :Gejala ,
                                                :GejalaMalai ;
                                       :didukungOleh :BuktiGejalaPenyakitTungroPadi3 ;
                                       :memilikiGejalaKanonik :BercakTanaman ;
                                       :merupakanGejalaDari :PenyakitTungroPadi ;
                                       :terdapatPada :Malai ;
                                       :deskripsiGejala "Tanaman padi yang terserang virus tungro umumnya hanya hidup hingga stadia pemasakan dengan gejala terhambatnya proses pembungaan, tidak sempurnanya malai dengan bulir yang tertutup bercak coklat (Puslitbang 2005)."@id ;
                                       rdfs:comment "Gejala bercak pada tanaman pada tanaman Padi: Tanaman padi yang terserang virus tungro umumnya hanya hidup hingga..."@id ,
                                                    "Tanaman padi yang terserang virus tungro umumnya hanya hidup hingga stadia pemasakan dengan gejala terhambatnya proses pembungaan, tidak sempurnanya malai dengan bulir yang tertutup bercak coklat (Puslitbang 2005)."@id ;
                                       rdfs:label "Bercak pada tanaman pada Penyakit Tungro (Padi)"@id ;
