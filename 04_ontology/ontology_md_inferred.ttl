###  http://www.w3.org/ns/prov#wasDerivedFrom
<http://www.w3.org/ns/prov#wasDerivedFrom> rdf:type owl:ObjectProperty ;
                                           rdfs:domain :EntitasKBR ;
                                           rdfs:range :EntitasKBR ;
                                           rdfs:comment "Entitas diturunkan dari sumber atau entitas lain."@id ;
                                           rdfs:label "was derived from"@id ;
                                           <http://www.w3.org/2004/02/skos/core#prefLabel> "was derived from"@id .


