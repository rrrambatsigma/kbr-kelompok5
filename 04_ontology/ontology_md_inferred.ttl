###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#SapuSetanWitchesBroomUbiKayu
:SapuSetanWitchesBroomUbiKayu rdf:type owl:NamedIndividual ,
                                       :EntitasKBR ,
                                       :Penyakit ,
                                       :PenyakitFitoplasma ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :disebabkanOleh ;
                                         owl:someValuesFrom :Fitoplasma
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :memilikiGejala ;
                                         owl:someValuesFrom :Gejala
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :menyerangTanaman ;
                                         owl:someValuesFrom :TanamanPangan
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :disebabkanOleh ;
                                         owl:allValuesFrom :Patogen
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :memilikiReferensi ;
                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :Referensi
                                       ] ;
                              :didukungOleh :BuktiMetadataEnglishSapuSetanWitchesBroomUbiKayu ,
                                            :BuktiPatogenSapuSetanWitchesBroomUbiKayu ,
                                            :BuktiPenyakitSapuSetanWitchesBroomUbiKayu ;
                              :dipengaruhiOleh :MusimKemarauPadaSapuSetanWitchesBroomUbiKayu ;
                              :disebabkanOleh :PatogenFitoplasma ;
                              :memilikiGejala :GejalaSapuSetanWitchesBroomUbiKayuKerdilTanaman ;
                              :memilikiReferensi :BukuDOC002 ;
                              :menyerangBagian :Batang ;
                              :menyerangTanaman :UbiKayu ;
                              :deskripsiPenyakit "Tanaman tumbuh kerdil (dwarf), ruas batang memendek, pada ujung tanaman tumbuh tunas yang banyak menyerupai sapu"@id ;
                              :identifierSumber "DIS_033" ;
                              :namaInggrisPenyakit "Witches broom" ;
                              rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                           "Tanaman tumbuh kerdil (dwarf), ruas batang memendek, pada ujung tanaman tumbuh tunas yang banyak menyerupai sapu"@id ;
                              rdfs:label "Sapu setan (Witches broom)"@id ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Sapu setan (Witches broom)"@id .


