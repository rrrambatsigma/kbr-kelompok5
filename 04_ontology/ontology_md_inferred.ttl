                              :disebabkanOleh :RhizoctoniaSolani ;
                              :memilikiGejala :GejalaPenyakitRebahKecambahKedelaiBercakTanaman ,
                                              :GejalaPenyakitRebahKecambahKedelaiBusukAkar ,
                                              :GejalaPenyakitRebahKecambahKedelaiBusukBatang ,
                                              :GejalaPenyakitRebahKecambahKedelaiBusukTanaman ,
                                              :GejalaPenyakitRebahKecambahKedelaiKematianTanaman ,
                                              :GejalaPenyakitRebahKecambahKedelaiLayuDaun ,
                                              :GejalaPenyakitRebahKecambahKedelaiLekukanPangkalAkar ;
