                                           :PenggunaanPestisidaNabati ,
                                           :PenggunaanTanamanBukanInang ,
                                           :PenggunaanVarietasTahan ,
                                           :RotasiTanaman ,
                                           :SanitasiLahan ;
                       :dipengaruhiOleh :KondisiMusimHujan ,
                                        :KondisiSuhuRendah ;
                       :disebabkanOleh :ElsinoeBatatas ,
                                       :SpacelomaBatatas ;
                       :memilikiGejala :GejalaPenyakitKudisUbiJalar ,
                                       :GejalaPenyakitKudisUbiJalar2 ,
