                                          owl:onProperty :disebabkanOleh ;
                                          owl:allValuesFrom :Patogen
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :memilikiReferensi ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass :Referensi
                                        ] ;
                               :berkaitanPengendalian :PengaturanJarakTanam ,
                                                      :PengaturanKelembapan ,
                                                      :PengelolaanGulma ,
                                                      :PenggunaanEkstrakTanaman ,
                                                      :PenggunaanPestisidaNabati ;
                               :didukungOleh :BuktiMetadataPhasePenyakitBercakDaunKacangHijau ,
                                             :BuktiPatogenPenyakitBercakDaunKacangHijau ,
                                             :BuktiPatogenPenyakitBercakDaunKacangHijau2 ,
                                             :BuktiPengendalianPenyakitBercakDaunKacangHijau ,
                                             :BuktiPengendalianPenyakitBercakDaunKacangHijau2 ,
                                             :BuktiPengendalianPenyakitBercakDaunKacangHijau3 ,
                                             :BuktiPenyakitPenyakitBercakDaunKacangHijau ;
                               :dikendalikanDengan :PengaturanJarakTanam ,
                                                   :PengaturanKelembapan ,
                                                   :PengelolaanGulma ,
                                                   :PenggunaanEkstrakTanaman ,
                                                   :PenggunaanPestisidaNabati ;
                               :dipengaruhiOleh :KelembapanRelatif98100PersenPadaPenyakitBercakDaunKacangHijau ,
                                                :Suhu2530CPadaPenyakitBercakDaunKacangHijau ;
                               :disebabkanOleh :CercosporaCanescens ,
                                               :CercosporaCruenta ;
                               :memilikiGejala :GejalaPenyakitBercakDaunKacangHijau ,
                                               :GejalaPenyakitBercakDaunKacangHijauBercakDaun ;
                               :memilikiReferensi :BukuDOC005 ;
                               :menyerangBagian :Daun ;
                               :menyerangFase :FaseGeneratifUmum ;
                               :menyerangTanaman :KacangHijau ;
                               :deskripsiPenyakit "Bercak daun merupakan salah satu penyakit utama kacang hijau. Tidak hanya di Indonesia, tetapi juga di Asia seperti Filipina, Malaysia, Thailand, India, Bangladesh, dan Pakistan. Di Indonesia penyakit ini diketahui di seluruh sentra produksi kacang hijau. Infeksi C. canescens pada kacang hijau menyebabkan kehilangan hasil 46-61% di lahan (Iqbal et al. 1995; Kapadi dan Dhuruj 1999, Sompong et al. 2011)."@id ;
                               :identifierSumber "DIS_124" ;
                               :tingkatKeparahan "Infeksi C. canescens pada kacang hijau menyebabkan kehilangan hasil 46-61% di lahan (Iqbal et al. 1995; Kapadi dan Dhuruj 1999, Sompong et al. 2011)."@id ;
                               rdfs:comment "Bercak daun merupakan salah satu penyakit utama kacang hijau. Tidak hanya di Indonesia, tetapi juga di Asia seperti Filipina, Malaysia, Thailand, India, Bangladesh, dan Pakistan. Di Indonesia penyakit ini diketahui di seluruh sentra produksi kacang hijau. Infeksi C. canescens pada kacang hijau menyebabkan kehilangan hasil 46-61% di lahan (Iqbal et al. 1995; Kapadi dan Dhuruj 1999, Sompong et al. 2011)."@id ,
                                            "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ;
                               rdfs:label "Penyakit Bercak Daun"@id ;
                               <http://www.w3.org/2004/02/skos/core#altLabel> "BERCAK DAUN"@id ;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Bercak Daun"@id .


