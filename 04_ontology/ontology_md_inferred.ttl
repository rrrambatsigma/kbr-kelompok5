                                                       owl:someValuesFrom :Gejala
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :menyerangTanaman ;
                                                       owl:someValuesFrom :TanamanPangan
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :disebabkanOleh ;
                                                       owl:allValuesFrom :Patogen
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :memilikiReferensi ;
                                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onClass :Referensi
                                                     ] ;
                                            :berkaitanPengendalian :PenggunaanAgensHayati ,
                                                                   :PenggunaanBacillus ,
                                                                   :PenggunaanBakterisida ,
                                                                   :PenggunaanPseudomonas ,
                                                                   :PerlakuanBenih ,
                                                                   :RotasiTanaman ;
                                            :didukungOleh :BuktiMetadataPhasePenyakitHawarBakteriBacterialBlightKedelai ,
                                                          :BuktiMetadataSeverityPenyakitHawarBakteriBacterialBlightKede ,
                                                          :BuktiPatogenPenyakitHawarBakteriBacterialBlightKedelai ,
                                                          :BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai ,
                                                          :BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai2 ,
                                                          :BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai3 ,
                                                          :BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai4 ,
                                                          :BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai5 ,
                                                          :BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai6 ,
                                                          :BuktiPenyakitPenyakitHawarBakteriBacterialBlightKedelai ;
                                            :dikendalikanDengan :PenggunaanAgensHayati ,
                                                                :PenggunaanBacillus ,
                                                                :PenggunaanBakterisida ,
                                                                :PenggunaanPseudomonas ,
                                                                :PerlakuanBenih ,
                                                                :RotasiTanaman ;
                                            :dipengaruhiOleh :SuhuSejukDanHujanSeringPadaPenyakitHawarBakteriBacterialBlightKedelai ;
                                            :disebabkanOleh :PseudomonasSyringae ;
                                            :memilikiGejala :GejalaPenyakitHawarBakteriBacterialBlightKedelai ,
                                                            :GejalaPenyakitHawarBakteriBacterialBlightKedelai2 ,
                                                            :GejalaPenyakitHawarBakteriBacterialBlightKedelaiBercakDaun ,
                                                            :GejalaPenyakitHawarBakteriBacterialBlightKedelaiBercakTanama ,
                                                            :GejalaPenyakitHawarBakteriBacterialBlightKedelaiDaunBerluban ,
                                                            :GejalaPenyakitHawarBakteriBacterialBlightKedelaiDaunRontok ,
                                                            :GejalaPenyakitHawarBakteriBacterialBlightKedelaiKlorosisTana ;
                                            :memilikiReferensi :BukuDOC002 ;
                                            :menyerangBagian :Daun ,
                                                             :Polong ;
                                            :menyerangFase :FasePanenTanaman ,
                                                           :FasePembibitanTanaman ;
                                            :menyerangTanaman :Kedelai ;
                                            :deskripsiPenyakit "Penyakit hawar bakteri (bacterial blight) disebabkan oleh patogen bakteri Pseudomonas syringae pv. glycine. Penyakit hawar bakteri menjadi salah satu penyakit yang menjadi kendala utama pada budidaya tanaman kedelai. Gejala tanaman yang disebabkan oleh patogen P. syringae pv. glycine diawali dengan munculnya bercak yang awalnya berwarna coklat kekuningan dengan ukuran bercak kecil. Pada tingkat serangan yang tinggi bercak kemudian menjadi hawar yang ditandai dengan warna kecokelatan dilingkari dengan lingkaran kuning dan menyebar tidak beraturan (Gambar 2.14)."@id ;
                                            :identifierSumber "DIS_016" ;
                                            :namaInggrisPenyakit "Bacterial Blight" ;
                                            :tingkatKeparahan "Patogen dapat menginfeksi dari fase pembibitan hingga panen dan menyebabkan kehilangan hasil mencapai 50-70% (Majid, 2016)."@id ;
                                            rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                                         "Penyakit hawar bakteri (bacterial blight) disebabkan oleh patogen bakteri Pseudomonas syringae pv. glycine. Penyakit hawar bakteri menjadi salah satu penyakit yang menjadi kendala utama pada budidaya tanaman kedelai. Gejala tanaman yang disebabkan oleh patogen P. syringae pv. glycine diawali dengan munculnya bercak yang awalnya berwarna coklat kekuningan dengan ukuran bercak kecil. Pada tingkat serangan yang tinggi bercak kemudian menjadi hawar yang ditandai dengan warna kecokelatan dilingkari dengan lingkaran kuning dan menyebar tidak beraturan (Gambar 2.14)."@id ;
                                            rdfs:label "Penyakit Hawar Bakteri (Bacterial Blight)"@id ;
                                            <http://www.w3.org/2004/02/skos/core#altLabel> "Bacterial Blight"@id ;
                                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Hawar Bakteri (Bacterial Blight)"@id .


