                        :EntitasKBR ,
                        :Varietas ;
               :didukungOleh :BuktiVarietasKacangTanah2 ;
               :merupakanVarietasDari :KacangTanah ;
               :tahanTerhadap :PenyakitBercakDaunKacangTanah ;
               rdfs:comment "Beberapa varietas kacang tanah di Balitkabi memiliki sifat tahan terhadap bercak daun yakni varietas Panther dan Domba, sedangkan yang agak tahan adalah Bison, Jerapah, Kelinci, dan Badak (Purnomo et al. 2004)."@id ,
                            "Varietas tanaman yang disebut sumber."@id ;
               rdfs:label "Bison"@id ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Bison"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasBondoyudo
:VarietasBondoyudo rdf:type owl:NamedIndividual ,
                            :EntitasKBR ,
                            :Varietas ;
                   :didukungOleh :BuktiVarietasPadi ;
                   :merupakanVarietasDari :Padi ;
                   :tahanTerhadap :PenyakitTungroPadi ;
                   rdfs:comment "Berbagai strategi pengendalian penyakit tungro dijelaskan sebagai berikut meliputi pemusnahan tanaman terinfeksi, penggunaan varietas tahan seperti Tukad Unda, Tukad Balian, Kalimas, dan Bondoyudo, penanaman serempak minimal 20 ha luasan sawah, serta penanaman sebelum puncak kepadatan wereng hijau (Puslitbangtan 2005)."@id ,
                                "Varietas tanaman yang disebut sumber."@id ;
                   rdfs:label "Bondoyudo"@id ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Bondoyudo"@id .


