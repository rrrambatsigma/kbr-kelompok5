###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakDaunBaurUbiKayu
:BercakDaunBaurUbiKayu rdf:type owl:NamedIndividual ,
                                :EntitasKBR ,
                                :Penyakit ,
                                :PenyakitJamur ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :disebabkanOleh ;
                                  owl:someValuesFrom :Jamur
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :memilikiGejala ;
                                  owl:someValuesFrom :Gejala
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :menyerangTanaman ;
                                  owl:someValuesFrom :TanamanPangan
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :disebabkanOleh ;
                                  owl:allValuesFrom :Patogen
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :memilikiReferensi ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Referensi
                                ] ;
                       :didukungOleh :BuktiPatogenBercakDaunBaurUbiKayu ,
                                     :BuktiPenyakitBercakDaunBaurUbiKayu ;
                       :dipengaruhiOleh :IklimLembapDanHangatPadaBercakDaunBaurUbiKayu ;
                       :disebabkanOleh :CercosporaViscosae ;
                       :memilikiGejala :GejalaBercakDaunBaurUbiKayuBercakDaun ;
                       :memilikiReferensi :BukuDOC002 ;
                       :menyerangBagian :Daun ;
                       :menyerangTanaman :UbiKayu ;
                       :deskripsiPenyakit "Bercak berukuran besar, sering dijumpai pada ujung daun dan daun muda,bercak tanpa batas yang jelas, bercak pada permukaan atas daun berwarna coklat dan bagian bawah berwarna keabu-abuan (spora fungi)"@id ;
                       :identifierSumber "DIS_029" ;
                       rdfs:comment "Bercak berukuran besar, sering dijumpai pada ujung daun dan daun muda,bercak tanpa batas yang jelas, bercak pada permukaan atas daun berwarna coklat dan bagian bawah berwarna keabu-abuan (spora fungi)"@id ,
                                    "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ;
                       rdfs:label "Bercak daun baur"@id ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Bercak daun baur"@id .


