                           :dipengaruhiOleh :CuacaHangatDanLembapPadaPenyakitAntraknosaKedelai ;
                           :disebabkanOleh :Colletotrichum ,
                                           :ColletotrichumTruncatum ;
                           :memilikiGejala :GejalaPenyakitAntraknosaKedelai ,
                                           :GejalaPenyakitAntraknosaKedelaiBercakDaun ,
                                           :GejalaPenyakitAntraknosaKedelaiBercakTanaman ,
                                           :GejalaPenyakitAntraknosaKedelaiDaunRontok ,
