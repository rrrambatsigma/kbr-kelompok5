                          :dipengaruhiOleh :KondisiCurahHujanTinggi ,
                                           :KondisiMusimKemarau ;
                          :disebabkanOleh :PhakopsoraMeibomiae ,
                                          :PhakopsoraPachyrhizi ,
                                          :PhakopsporaPachyrhizi ;
                          :memilikiGejala :GejalaPenyakitKaratDaunKedelai ,
                                          :GejalaPenyakitKaratDaunKedelai2 ,
                                          :GejalaPenyakitKaratDaunKedelaiBercakDaun ,
                                          :GejalaPenyakitKaratDaunKedelaiBercakTanaman ,
                                          :GejalaPenyakitKaratDaunKedelaiDaunKering ,
                                          :GejalaPenyakitKaratDaunKedelaiDaunRontok ,
                                          :GejalaPenyakitKaratDaunKedelaiKlorosisDaun ,
                                          :GejalaPenyakitKaratDaunKedelaiKlorosisTanaman ;
                          :memilikiReferensi :BukuDOC002 ,
                                             :BukuDOC005 ;
                          :menyerangBagian :Daun ,
                                           :Polong ;
                          :menyerangTanaman :Kedelai ;
                          :deskripsiPenyakit "Penyakit karat daun yang disebabkan oleh patogen Phakopspora pachyrhizi merupakan penyakit penting pada tanaman kedelai. Akibat serangan oleh patogen ini menyebabkan penurunan produksi polong kedelai mencapai 30- 60%. Patogen bersifat parasit obligat. Kondisi lingkungan yang mendukung untuk perkembangan patogen ini adalah pada suhu 27,50C. Perkembangan penyakit tidak akan terjadi apabila suhu yang ada di lahan lebih dari 27,50C. Faktor curah hujan yang tinggi sangat memengaruhi perkembangan penyakit menjadi lebih tinggi (Utama and Sjamsijah, 2019). Inayati and Yusnawan, (2017) menyatakan bahwa perkembangan penyakit karat daun tinggi pada"@id ;
                          :identifierSumber "DIS_009" ,
                                            "DIS_118" ;
                          :tingkatKeparahan "Di Indonesia, infeksi cendawan ini pada kedelai dan mengakibatkan kehilangan hasil mencapai 90% (Sudjono et al. 1985), di Thailand 10–40% pada varietas lokal, di Taiwan 23–50% (Sinclair dan Shurtleff 1980), di Brasil 75% (Yorinori et al. 2005) dan di Argentina 28% (Formento 2008)."@id ;
                          rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                       "Penyakit karat daun yang disebabkan oleh patogen Phakopspora pachyrhizi merupakan penyakit penting pada tanaman kedelai. Akibat serangan oleh patogen ini menyebabkan penurunan produksi polong kedelai mencapai 30- 60%. Patogen bersifat parasit obligat. Kondisi lingkungan yang mendukung untuk perkembangan patogen ini adalah pada suhu 27,50C. Perkembangan penyakit tidak akan terjadi apabila suhu yang ada di lahan lebih dari 27,50C. Faktor curah hujan yang tinggi sangat memengaruhi perkembangan penyakit menjadi lebih tinggi (Utama and Sjamsijah, 2019). Inayati and Yusnawan, (2017) menyatakan bahwa perkembangan penyakit karat daun tinggi pada"@id ;
                          rdfs:label "Penyakit Karat Daun"@id ;
                          <http://www.w3.org/2004/02/skos/core#altLabel> "KARAT"@id ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Karat Daun"@id .


