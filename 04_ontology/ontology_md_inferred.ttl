###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKimiawi
:PengendalianKimiawi rdf:type owl:Class ;
                     rdfs:subClassOf :EntitasKBR ,
                                     :Pengendalian ;
                     owl:disjointWith :PengendalianKulturTeknis ,
                                      :PengendalianMekanis ,
                                      :PengendalianTerpadu ,
                                      :Penyakit ,
                                      :PenyakitBakteri ,
                                      :PenyakitFitoplasma ,
                                      :PenyakitJamur ,
                                      :PenyakitOomycete ,
                                      :PenyakitVirus ,
                                      :PublikasiInstansi ,
                                      :Referensi ,
                                      :Serealia ,
                                      :Suhu ,
                                      :TanamanPangan ,
                                      :TeksturTanah ,
                                      :UmbiUmbian ,
                                      :Varietas ,
                                      :VarietasUnggul ,
                                      :Virus ;
                     rdfs:comment "Pengendalian dengan bahan kimia atau pestisida."@id ,
                                  "Pengendalian kimiawi dengan fungisida berbahan aktif risiklikol, pyroquilon, iprobenfos, benomyl, isoprothiolane, diclocymet, edifenphos, felimzone, probenazole, karpropamid, fenoxanil dan metominostrobin, dan antibiotik seperti blasticidin, kasugamycin dan dipotassium hidrogen fosfat (DHP) telah dilaporkan dapat mengurangi keparahan penyakit blas."@id ;
                     rdfs:label "Pengendalian Kimiawi"@id ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Pengendalian Kimiawi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis
:PengendalianKulturTeknis rdf:type owl:Class ;
                          rdfs:subClassOf :EntitasKBR ,
                                          :Pengendalian ;
                          owl:disjointWith :PengendalianMekanis ,
                                           :PengendalianTerpadu ,
                                           :Penyakit ,
                                           :PenyakitBakteri ,
                                           :PenyakitFitoplasma ,
                                           :PenyakitJamur ,
                                           :PenyakitOomycete ,
                                           :PenyakitVirus ,
                                           :PublikasiInstansi ,
                                           :Referensi ,
                                           :Serealia ,
                                           :Suhu ,
                                           :TanamanPangan ,
                                           :TeksturTanah ,
                                           :UmbiUmbian ,
                                           :Varietas ,
                                           :VarietasUnggul ,
                                           :Virus ;
                          rdfs:comment "Menurut Inayati and Yusnawan, (2017) pengendalian penyakit yang disebabkan oleh R. solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian"@id ,
                                       "Pengendalian melalui praktik budidaya."@id ;
                          rdfs:label "Pengendalian Kultur Teknis"@id ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Pengendalian Kultur Teknis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianMekanis
:PengendalianMekanis rdf:type owl:Class ;
                     rdfs:subClassOf :EntitasKBR ,
                                     :Pengendalian ;
                     owl:disjointWith :PengendalianTerpadu ,
                                      :Penyakit ,
                                      :PenyakitBakteri ,
                                      :PenyakitFitoplasma ,
                                      :PenyakitJamur ,
                                      :PenyakitOomycete ,
                                      :PenyakitVirus ,
