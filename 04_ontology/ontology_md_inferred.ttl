###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuperelongasiUbiKayu
:SuperelongasiUbiKayu rdf:type owl:NamedIndividual ,
                               :EntitasKBR ,
                               :Penyakit ,
                               :PenyakitJamur ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :disebabkanOleh ;
                                 owl:someValuesFrom :Jamur
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :memilikiGejala ;
                                 owl:someValuesFrom :Gejala
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :menyerangTanaman ;
                                 owl:someValuesFrom :TanamanPangan
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :disebabkanOleh ;
                                 owl:allValuesFrom :Patogen
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :memilikiReferensi ;
                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Referensi
                               ] ;
                      :didukungOleh :BuktiPatogenSuperelongasiUbiKayu ,
                                    :BuktiPenyakitSuperelongasiUbiKayu ;
                      :dipengaruhiOleh :MusimHujanPadaSuperelongasiUbiKayu ;
                      :disebabkanOleh :ElsinoeBrasiliensis ;
                      :memilikiGejala :GejalaSuperelongasiUbiKayuPertumbuhanAbnormal ;
                      :memilikiReferensi :BukuDOC002 ;
                      :menyerangBagian :Batang ,
                                       :Daun ;
                      :menyerangTanaman :UbiKayu ;
                      :deskripsiPenyakit "Pemanjangan ruas batang yang berlebihan, sehingga batang terbentuk tipis dan lemah dibandingkan tanaman sehat. Gejala pada daun dan tangkai daun di batang muda, deformasi berkembang berasosisi dengan gejala kanker."@id ;
                      :identifierSumber "DIS_037" ;
                      rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                   "Pemanjangan ruas batang yang berlebihan, sehingga batang terbentuk tipis dan lemah dibandingkan tanaman sehat. Gejala pada daun dan tangkai daun di batang muda, deformasi berkembang berasosisi dengan gejala kanker."@id ;
                      rdfs:label "Superelongasi"@id ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Superelongasi"@id .


