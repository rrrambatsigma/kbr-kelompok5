                                      owl:onProperty :disebabkanOleh ;
                                      owl:allValuesFrom :Patogen
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :memilikiReferensi ;
                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :Referensi
                                    ] ;
                           :berkaitanPengendalian :PengelolaanGulma ,
                                                  :PenggunaanAgensHayati ,
                                                  :PenggunaanBacillus ,
                                                  :PenggunaanBenihSehat ,
                                                  :PenggunaanInsektisida ,
                                                  :PenggunaanPseudomonas ,
                                                  :PenggunaanVarietasTahan ,
                                                  :PerlakuanBenih ,
                                                  :SanitasiLahan ;
                           :didukungOleh :BuktiMetadataPhasePenyakitLayuStewartJagung ,
                                         :BuktiMetadataSeverityPenyakitLayuStewartJagung ,
                                         :BuktiPatogenPenyakitLayuStewartJagung ,
                                         :BuktiPengendalianPenyakitLayuStewartJagung ,
                                         :BuktiPengendalianPenyakitLayuStewartJagung10 ,
                                         :BuktiPengendalianPenyakitLayuStewartJagung2 ,
                                         :BuktiPengendalianPenyakitLayuStewartJagung3 ,
                                         :BuktiPengendalianPenyakitLayuStewartJagung4 ,
                                         :BuktiPengendalianPenyakitLayuStewartJagung5 ,
                                         :BuktiPengendalianPenyakitLayuStewartJagung6 ,
                                         :BuktiPengendalianPenyakitLayuStewartJagung7 ,
                                         :BuktiPengendalianPenyakitLayuStewartJagung8 ,
                                         :BuktiPengendalianPenyakitLayuStewartJagung9 ,
                                         :BuktiPenyakitPenyakitLayuStewartJagung ;
                           :dikendalikanDengan :PengelolaanGulma ,
                                               :PenggunaanAgensHayati ,
                                               :PenggunaanBacillus ,
                                               :PenggunaanBenihSehat ,
                                               :PenggunaanInsektisida ,
                                               :PenggunaanPseudomonas ,
                                               :PenggunaanVarietasTahan ,
                                               :PerlakuanBenih ,
                                               :SanitasiLahan ;
                           :dipengaruhiOleh :MusimDinginRinganPadaPenyakitLayuStewartJagung ;
                           :disebabkanOleh :PantoeaStewartii ;
                           :memilikiGejala :GejalaPenyakitLayuStewartJagungKerdilTanaman ,
                                           :GejalaPenyakitLayuStewartJagungKlorosisDaun ,
                                           :GejalaPenyakitLayuStewartJagungLayuDaun ,
                                           :GejalaPenyakitLayuStewartJagungPertumbuhanAbnormal ;
                           :memilikiReferensi :BukuDOC002 ;
                           :menyerangBagian :Batang ,
                                            :Daun ;
                           :menyerangFase :FaseGeneratifUmum ;
                           :menyerangTanaman :Jagung ;
                           :deskripsiPenyakit "Penyakit layu stewart disebabkan oleh bakteri Pantoea stewartii subsp. stewartii. Penyakit ini termasuk patogen tular benih. Pertama kali dilaporkan ada di Bogor, Indonesia oleh (Rahma et al., 2014) dengan kejadian penyakit antara 23.67% hingga 31.45%. Bakteri patogen P. stewartii termasuk bakteri gram negatif dan mempunyai koloni berwarna kuning, mengilat, cembung, berukuran 1-4 mm jika ditumbuhkan pada media TSA (Trypticase Soy Agar). Gejala layu stewart hampir mirip dengan penyakit bulai. Daun bergejala layu stewart berwarna hijau pucat hingga kekuningan dengan garis linier dengan tepi lurus maupun bergelombang yang sejajar tulang daun, layu dan kerdil (Rahma et al., 2014)."@id ;
                           :identifierSumber "DIS_047" ;
                           :tingkatKeparahan "Pertama kali dilaporkan ada di Bogor, Indonesia oleh (Rahma et al., 2014) dengan kejadian penyakit antara 23.67% hingga 31.45%."@id ;
                           rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                        "Penyakit layu stewart disebabkan oleh bakteri Pantoea stewartii subsp. stewartii. Penyakit ini termasuk patogen tular benih. Pertama kali dilaporkan ada di Bogor, Indonesia oleh (Rahma et al., 2014) dengan kejadian penyakit antara 23.67% hingga 31.45%. Bakteri patogen P. stewartii termasuk bakteri gram negatif dan mempunyai koloni berwarna kuning, mengilat, cembung, berukuran 1-4 mm jika ditumbuhkan pada media TSA (Trypticase Soy Agar). Gejala layu stewart hampir mirip dengan penyakit bulai. Daun bergejala layu stewart berwarna hijau pucat hingga kekuningan dengan garis linier dengan tepi lurus maupun bergelombang yang sejajar tulang daun, layu dan kerdil (Rahma et al., 2014)."@id ;
                           rdfs:label "Penyakit Layu Stewart"@id ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Layu Stewart"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitMosaikKedelaiSoybeanMosaicVirusKedelai
:PenyakitMosaikKedelaiSoybeanMosaicVirusKedelai rdf:type owl:NamedIndividual ,
                                                         :EntitasKBR ,
                                                         :Penyakit ,
                                                         :PenyakitVirus ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :disebabkanOleh ;
                                                           owl:someValuesFrom :Virus
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :memilikiGejala ;
                                                           owl:someValuesFrom :Gejala
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :menyerangTanaman ;
                                                           owl:someValuesFrom :TanamanPangan
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :disebabkanOleh ;
                                                           owl:allValuesFrom :Patogen
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :memilikiReferensi ;
                                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onClass :Referensi
                                                         ] ;
                                                :berkaitanPengendalian :PenggunaanInsektisida ,
                                                                       :SanitasiLahan ;
                                                :didukungOleh :BuktiPatogenPenyakitMosaikKedelaiSoybeanMosaicVirusKedelai ,
                                                              :BuktiPengendalianPenyakitMosaikKedelaiSoybeanMosaicVirusKede ,
                                                              :BuktiPenyakitPenyakitMosaikKedelaiSoybeanMosaicVirusKedelai ;
                                                :dikendalikanDengan :PenggunaanInsektisida ,
                                                                    :SanitasiLahan ;
                                                :dipengaruhiOleh :LahanTegalanDiBawahTegakanPohonJatiPadaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelai ;
                                                :disebabkanOleh :SoybeanMosaicVirus ;
                                                :memilikiGejala :GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelai ,
                                                                :GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelai2 ,
                                                                :GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiBelangTa ,
                                                                :GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiKerdilTa ,
                                                                :GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiKlorosis ,
                                                                :GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiMosaikDa ,
                                                                :GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiPertumbu ;
                                                :memilikiReferensi :BukuDOC002 ;
                                                :menyerangBagian :Batang ,
                                                                 :Daun ;
                                                :menyerangTanaman :Kedelai ;
                                                :deskripsiPenyakit "Penyakit mosaik kedelai (soybean mosaic virus) atau SMV disebabkan oleh infeksi patogen dari golongan virus. Dapat menyerang tanaman kedelai sejak dari benih disemai. Patogen SMV dapat terbawa oleh benih yang ditanam (seed borne disease). Oleh karena itu benih yang terinfeksi dan membawa patogen SMV merupakan sumber utama terjadinya penyakit. Penyakit akan berkembang pada lahan pertanaman kedelai yang ditularkan oleh serangga famili Aphididae seperti Aphis glycine, A. craccivora, A. fabae, A. gossypii, A. nasturtii dan A. nerii non persisten (Inayati and Yusnawan, 2017)."@id ;
                                                :identifierSumber "DIS_018" ;
                                                :namaInggrisPenyakit "Soybean Mosaic Virus" ;
                                                rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                                             "Penyakit mosaik kedelai (soybean mosaic virus) atau SMV disebabkan oleh infeksi patogen dari golongan virus. Dapat menyerang tanaman kedelai sejak dari benih disemai. Patogen SMV dapat terbawa oleh benih yang ditanam (seed borne disease). Oleh karena itu benih yang terinfeksi dan membawa patogen SMV merupakan sumber utama terjadinya penyakit. Penyakit akan berkembang pada lahan pertanaman kedelai yang ditularkan oleh serangga famili Aphididae seperti Aphis glycine, A. craccivora, A. fabae, A. gossypii, A. nasturtii dan A. nerii non persisten (Inayati and Yusnawan, 2017)."@id ;
                                                rdfs:label "Penyakit Mosaik Kedelai (Soybean Mosaic Virus)"@id ;
                                                <http://www.w3.org/2004/02/skos/core#altLabel> "Soybean Mosaic Virus"@id ;
                                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Mosaik Kedelai (Soybean Mosaic Virus)"@id .


