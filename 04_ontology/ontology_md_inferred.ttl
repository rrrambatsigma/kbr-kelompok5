###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumKacangTanah8
:BuktiPengendalianUmumKacangTanah8 rdf:type owl:NamedIndividual ,
                                            :BuktiPengendalian ,
                                            :BuktiSumber ,
                                            :EntitasKBR ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty <http://www.w3.org/ns/prov#wasDerivedFrom> ;
