                                :VarietasUnggul ,
                                :Virus ;
               rdfs:comment "Di Indonesia, penyakit virus belang diketahui telah tersebar luas di sentra tanaman kacang tanah."@id ,
                            "Penyakit yang disebabkan oleh patogen kelompok virus."@id ;
               rdfs:label "Penyakit Virus"@id ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Virus"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PublikasiInstansi
:PublikasiInstansi rdf:type owl:Class ;
                   rdfs:subClassOf :EntitasKBR ,
                                   :Referensi ;
                   owl:disjointWith :Serealia ,
                                    :Suhu ,
                                    :TanamanPangan ,
                                    :TeksturTanah ,
                                    :UmbiUmbian ,
                                    :Varietas ,
                                    :VarietasUnggul ,
                                    :Virus ;
                   rdfs:comment "Referensi terbitan instansi."@id ;
                   rdfs:label "Publikasi Instansi"@id ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Publikasi Instansi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Referensi
:Referensi rdf:type owl:Class ;
           rdfs:subClassOf :EntitasKBR ;
           owl:disjointWith :Serealia ,
                            :Suhu ,
                            :TanamanPangan ,
                            :TeksturTanah ,
                            :UmbiUmbian ,
                            :Varietas ,
                            :VarietasUnggul ,
                            :Virus ;
           rdfs:comment "Harapannya buku ini dapat menjadi buku referensi tidak hanya dilingkungan akademis, tetapi juga bagi praktisi pertanian."@id ,
                        "Sumber bibliografis yang mendukung data."@id ;
           rdfs:label "Referensi"@id ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Referensi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Serealia
:Serealia rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Class ;
                                owl:oneOf ( :Jagung
                                            :Padi
                                          )
                              ] ;
          rdfs:subClassOf :TanamanPangan ,
                          [ rdf:type owl:Class ;
                            owl:oneOf ( :Jagung
                                        :Padi
                                      )
                          ] ;
          owl:disjointWith :Suhu ,
                           :TeksturTanah ,
                           :UmbiUmbian ,
                           :Varietas ,
                           :VarietasUnggul ,
                           :Virus ;
          rdfs:comment "Kelompok tanaman pangan serealia dalam ruang lingkup."@id ,
                       "Pergiliran kacang tanah dengan kapas, kedelai, dan serealia (padi, jagung, sorgum, gandum, tebu) dapat memutus siklus perkembangan R. solanacearum di lahan setempat sehingga mengurangi kejadian penyakit layu."@id ;
          rdfs:label "Serealia"@id ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Serealia"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Suhu
:Suhu rdf:type owl:Class ;
      rdfs:subClassOf :EntitasKBR ,
                      :FaktorLingkungan ,
                      :FaktorRisiko ;
      owl:disjointWith :TanamanPangan ,
                       :TeksturTanah ,
                       :UmbiUmbian ,
                       :Varietas ,
                       :VarietasUnggul ,
                       :Virus ;
      rdfs:comment "Faktor suhu lingkungan."@id ,
                   "Selain itu perlakuan panas kering juga dapat menjadi alternatif lainnya, seperti perlakuan panas kering pada suhu 55oC yang dapat mengeliminasi Pantoea stewartii pada benih jagung (Nalis et al. 2015) ataupun perendaman benih pada air panas 57oC selama 10 menit (Kadir et al. 2009)"@id ;
      rdfs:label "Suhu"@id ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Suhu"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#TanamanPangan
:TanamanPangan rdf:type owl:Class ;
               rdfs:subClassOf :EntitasKBR ;
               owl:disjointWith :TeksturTanah ,
                                :Varietas ,
                                :VarietasUnggul ,
                                :Virus ;
               rdfs:comment "Tanaman pangan dalam ruang lingkup knowledge base."@id ,
                            "Tidak hanya di Indonesia, di sebagian besar negara Asia pun padi menjadi tanaman pangan utama."@id ;
               rdfs:label "Tanaman Pangan"@id ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Tanaman Pangan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#TeksturTanah
:TeksturTanah rdf:type owl:Class ;
              rdfs:subClassOf :EntitasKBR ,
                              :FaktorLahan ,
                              :FaktorRisiko ;
              owl:disjointWith :UmbiUmbian ,
                               :Varietas ,
                               :VarietasUnggul ,
                               :Virus ;
              rdfs:comment "Faktor tekstur tanah."@id ,
                           "Karakter tanah ideal bagi apel adalah bertekstur sedang, gembur dengan kedalaman efektif lebih dari 50 cm, berdrainase baik dengan pH tanah berkisar 5,5 – 7 (Jackson, 2003)."@id ;
              rdfs:label "Tekstur Tanah"@id ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Tekstur Tanah"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#UmbiUmbian
:UmbiUmbian rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Class ;
                                  owl:oneOf ( :UbiJalar
                                              :UbiKayu
                                            )
                                ] ;
            rdfs:subClassOf :TanamanPangan ,
                            [ rdf:type owl:Class ;
                              owl:oneOf ( :UbiJalar
                                          :UbiKayu
                                        )
                            ] ;
            owl:disjointWith :Varietas ,
                             :VarietasUnggul ,
                             :Virus ;
            rdfs:comment "Hasil pengujian 120 genotipe koleksi plasma nutfah kacang tanah di Balai Penelitian Tanaman Kacang- kacangan dan Umbi-umbian, didapatkan satu genotipe yang tahan yaitu Mlg A-0099, tidak ditemukan genotipe agak tahan, 59 genotipe agak rentan, dan 60 genotipe rentan."@id ,
                         "Kelompok tanaman pangan umbi-umbian dalam ruang lingkup."@id ;
            rdfs:label "Umbi-Umbian"@id ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Umbi-Umbian"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas
:Varietas rdf:type owl:Class ;
          rdfs:subClassOf :EntitasKBR ;
          owl:disjointWith :Virus ;
          rdfs:comment "Pengendalian dengan varietas tahan menjadi salah satu pengendalian yang efektif."@id ,
                       "Varietas tanaman pangan yang disebut sumber."@id ;
          rdfs:label "Varietas"@id ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Varietas"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasUnggul
:VarietasUnggul rdf:type owl:Class ;
                rdfs:subClassOf :EntitasKBR ,
                                :Varietas ;
                owl:disjointWith :Virus ;
                rdfs:comment "Hampir beberapa varietas unggul kedelai dapat dipatahkan ketahanannya oleh ras patogen yang baru."@id ,
                             "Kategori varietas unggul."@id ;
                rdfs:label "Varietas Unggul"@id ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Varietas Unggul"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Virus
:Virus rdf:type owl:Class ;
       rdfs:subClassOf :EntitasKBR ,
                       :Patogen ;
       rdfs:comment "Benih sehat bebas virus merupakan awal dari budidaya tanaman sehat bebas virus PStV."@id ,
                    "Patogen kelompok virus."@id ;
       rdfs:label "Virus"@id ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Virus"@id .


#################################################################
#    Individuals
#################################################################

###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Akar
:Akar rdf:type owl:NamedIndividual ,
               :BagianTanaman ,
               :EntitasKBR ;
      rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id ,
                   "Tanaman akan layu akibat akar tanaman busuk dan terinfeksi patogen kemudian menyebar pada pangkal batang sehingga menyebabkan rebah semai atau rebah kecambah (Gambar 2.3) (Hidayah and Yulianti, 2015)."@id ;
      rdfs:label "Akar"@id ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Akar"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#AntraknosaUbiKayuBatang
:AntraknosaUbiKayuBatang rdf:type owl:NamedIndividual ,
                                  :EntitasKBR ,
                                  :Penyakit ,
                                  :PenyakitJamur ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :disebabkanOleh ;
                                    owl:someValuesFrom :Jamur
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :memilikiGejala ;
                                    owl:someValuesFrom :Gejala
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :menyerangTanaman ;
                                    owl:someValuesFrom :TanamanPangan
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :disebabkanOleh ;
                                    owl:allValuesFrom :Patogen
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :memilikiReferensi ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Referensi
                                  ] ;
                         :didukungOleh :BuktiPatogenAntraknosaUbiKayuBatang ,
                                       :BuktiPenyakitAntraknosaUbiKayuBatang ;
                         :dipengaruhiOleh :CurahHujanDanKelembapanRelatifPadaAntraknosaUbiKayuBatang ;
                         :disebabkanOleh :CollectothricumGloeosporioides ;
                         :memilikiGejala :GejalaAntraknosaUbiKayuBatangPucukMati ;
                         :memilikiReferensi :BukuDOC002 ;
                         :menyerangBagian :Batang ;
                         :menyerangTanaman :UbiKayu ;
                         :deskripsiPenyakit "Infeksi pada batang akan menimbulkan retakan berupa kanker batang, gejala mati pucuk, dan pucuk atau batang akan patah."@id ;
                         :identifierSumber "DIS_110" ;
                         rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                      "Infeksi pada batang akan menimbulkan retakan berupa kanker batang, gejala mati pucuk, dan pucuk atau batang akan patah."@id ;
                         rdfs:label "Antraknosa"@id ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Antraknosa"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#AntraknosaUbiKayuDaun
:AntraknosaUbiKayuDaun rdf:type owl:NamedIndividual ,
                                :EntitasKBR ,
                                :Penyakit ,
                                :PenyakitJamur ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :disebabkanOleh ;
                                  owl:someValuesFrom :Jamur
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :memilikiGejala ;
                                  owl:someValuesFrom :Gejala
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :menyerangTanaman ;
                                  owl:someValuesFrom :TanamanPangan
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :disebabkanOleh ;
                                  owl:allValuesFrom :Patogen
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :memilikiReferensi ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Referensi
                                ] ;
                       :didukungOleh :BuktiPatogenAntraknosaUbiKayuDaun ,
                                     :BuktiPenyakitAntraknosaUbiKayuDaun ;
                       :dipengaruhiOleh :CurahHujanDanKelembapanRelatifPadaAntraknosaUbiKayuDaun ;
                       :disebabkanOleh :ColletotricumSpp ;
                       :memilikiGejala :GejalaAntraknosaUbiKayuDaunLayuDaun ;
                       :memilikiReferensi :BukuDOC002 ;
                       :menyerangBagian :Daun ;
                       :menyerangTanaman :UbiKayu ;
                       :deskripsiPenyakit "Pada tangkai daun muncul retakan jaringan berupa kanker, infeksi lebih lanjut mengakibatkan tanaman layu yang disertai defoliasi"@id ;
                       :identifierSumber "DIS_031" ;
                       rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                    "Pada tangkai daun muncul retakan jaringan berupa kanker, infeksi lebih lanjut mengakibatkan tanaman layu yang disertai defoliasi"@id ;
                       rdfs:label "Antraknosa"@id ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Antraknosa"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang
:Batang rdf:type owl:NamedIndividual ,
                 :BagianTanaman ,
                 :EntitasKBR ;
        rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id ,
                     "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
        rdfs:label "Batang"@id ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Batang"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Begomovirus
