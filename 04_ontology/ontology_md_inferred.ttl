###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#HawarBakteriUbiKayu
:HawarBakteriUbiKayu rdf:type owl:NamedIndividual ,
                              :EntitasKBR ,
                              :Penyakit ,
                              :PenyakitBakteri ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :disebabkanOleh ;
                                owl:someValuesFrom :Bakteri
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :memilikiGejala ;
                                owl:someValuesFrom :Gejala
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :menyerangTanaman ;
                                owl:someValuesFrom :TanamanPangan
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :disebabkanOleh ;
                                owl:allValuesFrom :Patogen
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :memilikiReferensi ;
                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Referensi
                              ] ;
                     :didukungOleh :BuktiPatogenHawarBakteriUbiKayu ,
                                   :BuktiPenyakitHawarBakteriUbiKayu ;
                     :dipengaruhiOleh :KelembapanTinggiPadaHawarBakteriUbiKayu ,
                                      :MusimHujanPadaHawarBakteriUbiKayu ,
                                      :SuhuOptimalPadaHawarBakteriUbiKayu ;
                     :disebabkanOleh :XanthomonasCampestrisPvManihotis ,
                                     :XanthomonasCampestrispvManihotis ;
                     :memilikiGejala :GejalaHawarBakteriUbiKayuKlorosisTanaman ,
                                     :GejalaHawarBakteriUbiKayuPucukMati ;
                     :memilikiReferensi :BukuDOC002 ;
                     :menyerangBagian :Batang ,
                                      :Pucuk ;
                     :menyerangTanaman :UbiKayu ;
                     :deskripsiPenyakit "Muncul eksudat bergetah berwarna krem atau coklat kekuningan pada bagian batang yang terinfeksi, dan batang akan mati, meskipun adakalanya pada batang yang terinfeksi dan mati juga dapat memunculkan tunas baru"@id ;
                     :identifierSumber "DIS_036" ;
                     rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                  "Muncul eksudat bergetah berwarna krem atau coklat kekuningan pada bagian batang yang terinfeksi, dan batang akan mati, meskipun adakalanya pada batang yang terinfeksi dan mati juga dapat memunculkan tunas baru"@id ;
                     rdfs:label "Hawar bakteri"@id ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Hawar bakteri"@id .


