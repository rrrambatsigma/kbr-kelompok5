                              :disebabkanOleh :SweetPotatoChloroticFleckVirus ,
                                              :SweetPotatoFeatheryMottleVirus ,
                                              :SweetPotatoMildMottleVirus ;
                              :memilikiGejala :GejalaPenyakitBercakKuningUbiJalar ,
                                              :GejalaPenyakitBercakKuningUbiJalar2 ,
                                              :GejalaPenyakitBercakKuningUbiJalarBelangTanaman ,
