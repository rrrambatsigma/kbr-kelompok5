                                            :BuktiPenyakitPenyakitKaratDaunKacangTanah ;
                              :dikendalikanDengan :PengelolaanGulma ,
                                                  :PenggunaanVarietasTahan ,
                                                  :RotasiTanaman ,
                                                  :SanitasiLahan ;
                              :dipengaruhiOleh :KelembapanRelatifDiAtas78PersenPadaPenyakitKaratDaunKacangTanah ,
                                               :SuhuPadaPenyakitKaratDaunKacangTanah ;
                              :disebabkanOleh :PucciniaArachidis ;
                              :memilikiGejala :GejalaPenyakitKaratDaunKacangTanahBercakDaun ,
                                              :GejalaPenyakitKaratDaunKacangTanahBercakTanaman ,
                                              :GejalaPenyakitKaratDaunKacangTanahKlorosisDaun ,
                                              :GejalaPenyakitKaratDaunKacangTanahKlorosisTanaman ,
                                              :GejalaPenyakitKaratDaunKacangTanahTepungDaun ;
                              :memilikiReferensi :BukuDOC005 ;
                              :menyerangBagian :Daun ;
                              :menyerangTanaman :KacangTanah ;
                              :deskripsiPenyakit "Di Indonesia, penyakit karat pada kacang tanah merupakan penyakit penting ke dua setelah bercak daun. Penyakit ini tersebar luas di daerah sentra penghasil kacang tanah seperti Jawa Timur, Bali, dan Nusa Tenggara Barat. Kehilangan hasil mencapai 57% (Semangun 1991). Kehilangan hasil yang diakibatkan penyakit karat dapat mencapai 6–57% (Subramanyam dan Mc Donald 1984)."@id ;
                              :identifierSumber "DIS_121" ;
                              :tingkatKeparahan "Kehilangan hasil mencapai 57% (Semangun 1991)."@id ;
                              rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                           "Di Indonesia, penyakit karat pada kacang tanah merupakan penyakit penting ke dua setelah bercak daun. Penyakit ini tersebar luas di daerah sentra penghasil kacang tanah seperti Jawa Timur, Bali, dan Nusa Tenggara Barat. Kehilangan hasil mencapai 57% (Semangun 1991). Kehilangan hasil yang diakibatkan penyakit karat dapat mencapai 6–57% (Subramanyam dan Mc Donald 1984)."@id ;
                              rdfs:label "Penyakit Karat Daun"@id ;
                              <http://www.w3.org/2004/02/skos/core#altLabel> "KARAT"@id ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Karat Daun"@id .


