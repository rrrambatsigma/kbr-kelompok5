                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :Referensi
                                     ] ;
                            :berkaitanPengendalian :PenggunaanBacillus ;
                            :didukungOleh :BuktiPatogenPenyakitBusukPelepahJagung ,
                                          :BuktiPengendalianPenyakitBusukPelepahJagung ,
                                          :BuktiPenyakitPenyakitBusukPelepahJagung ;
                            :dikendalikanDengan :PenggunaanBacillus ;
                            :dipengaruhiOleh :KelembapanTinggiPadaPenyakitBusukPelepahJagung ,
                                             :SuhuMinimal30CPadaPenyakitBusukPelepahJagung ;
                            :disebabkanOleh :RhizoctoniaSolani ;
                            :memilikiGejala :GejalaPenyakitBusukPelepahJagungBercakTanaman ,
                                            :GejalaPenyakitBusukPelepahJagungBusukBatang ;
                            :memilikiReferensi :BukuDOC002 ;
                            :menyerangBagian :Batang ,
                                             :Buah ,
                                             :Daun ;
                            :menyerangTanaman :Jagung ;
                            :deskripsiPenyakit "Penyakit busuk pelepah disebabkan oleh jamur patogen Rhizoctonia solani. Patogen ini termasuk soil borne yang artinya merupakan patogen tular tanah sehingga dapat bertahan di tanah dan juga sisa tanaman dalam bentuk sklerotium. Sklerotium merupakan massa hifa yang mengumpul dan memadat yang awalnya berwarna putih dan kemudian berubah menjadi berwarna coklat. Jamur ini mempunyai banyak inang alternatif seperti tanaman kacang tanah, kedelai, kacang hijau dan sorgum (Soenartiningsih et al., 2015)."@id ;
                            :identifierSumber "DIS_048" ;
                            rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                         "Penyakit busuk pelepah disebabkan oleh jamur patogen Rhizoctonia solani. Patogen ini termasuk soil borne yang artinya merupakan patogen tular tanah sehingga dapat bertahan di tanah dan juga sisa tanaman dalam bentuk sklerotium. Sklerotium merupakan massa hifa yang mengumpul dan memadat yang awalnya berwarna putih dan kemudian berubah menjadi berwarna coklat. Jamur ini mempunyai banyak inang alternatif seperti tanaman kacang tanah, kedelai, kacang hijau dan sorgum (Soenartiningsih et al., 2015)."@id ;
                            rdfs:label "Penyakit Busuk Pelepah"@id ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Busuk Pelepah"@id .


