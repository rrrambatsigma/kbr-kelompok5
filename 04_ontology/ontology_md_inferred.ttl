@prefix : <http://kbr.kelompok5.org/penyakit-tanaman-pangan#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://kbr.kelompok5.org/penyakit-tanaman-pangan#> .

<http://kbr.kelompok5.org/penyakit-tanaman-pangan#> rdf:type owl:Ontology ;
                                                     rdfs:comment "Knowledge base penyakit tanaman pangan Indonesia untuk tujuh tanaman: padi, jagung, kedelai, kacang hijau, kacang tanah, ubi kayu, dan ubi jalar."@id ;
                                                     rdfs:label "Ontologi Penyakit Tanaman Pangan Indonesia"@id .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#argument1
<http://www.w3.org/2003/11/swrl#argument1> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#argument2
<http://www.w3.org/2003/11/swrl#argument2> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#arguments
<http://www.w3.org/2003/11/swrl#arguments> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#body
<http://www.w3.org/2003/11/swrl#body> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#builtin
<http://www.w3.org/2003/11/swrl#builtin> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#classPredicate
<http://www.w3.org/2003/11/swrl#classPredicate> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#head
<http://www.w3.org/2003/11/swrl#head> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#propertyPredicate
<http://www.w3.org/2003/11/swrl#propertyPredicate> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#bagianDari
:bagianDari rdf:type owl:ObjectProperty ,
                     owl:TransitiveProperty ;
            rdfs:domain :BagianTanaman ,
                        :EntitasKBR ;
            rdfs:range :BagianTanaman ,
                       :EntitasKBR ;
            rdfs:comment "Bagian tanaman merupakan bagian dari bagian tanaman lain."@id ;
            rdfs:label "bagian dari"@id ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "bagian dari"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#berkaitanPengendalian
:berkaitanPengendalian rdf:type owl:ObjectProperty ;
                       rdfs:domain :EntitasKBR ;
                       rdfs:range :EntitasKBR ,
                                  :Pengendalian ;
                       rdfs:comment "Superproperti yang menghubungkan entitas dengan tindakan pengendalian."@id ;
                       rdfs:label "berkaitan pengendalian"@id ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "berkaitan pengendalian"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#didukungOleh
:didukungOleh rdf:type owl:ObjectProperty ;
              rdfs:domain :EntitasKBR ;
              rdfs:range :BuktiSumber ,
                         :EntitasKBR ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty <http://www.w3.org/ns/prov#wasDerivedFrom> ;
                           owl:someValuesFrom :Referensi
                         ] ;
              rdfs:comment "Entitas didukung oleh node bukti sumber."@id ;
              rdfs:label "didukung oleh"@id ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "didukung oleh"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#dijelaskanDalam
:dijelaskanDalam rdf:type owl:ObjectProperty ;
                 owl:inverseOf :memilikiReferensi ;
                 rdfs:domain :EntitasKBR ,
                             :Referensi ;
                 rdfs:range :EntitasKBR ,
                            :Penyakit ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :memilikiGejala ;
                              owl:someValuesFrom :Gejala
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :menyerangTanaman ;
                              owl:someValuesFrom :TanamanPangan
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :disebabkanOleh ;
                              owl:allValuesFrom :Patogen
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :memilikiReferensi ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Referensi
                            ] ;
                 rdfs:comment "Kebalikan dari memilikiReferensi."@id ;
                 rdfs:label "dijelaskan dalam"@id ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "dijelaskan dalam"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#dikendalikanDengan
:dikendalikanDengan rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :berkaitanPengendalian ;
                    owl:inverseOf :mengendalikanPenyakit ;
                    rdfs:domain :EntitasKBR ,
                                :Penyakit ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :memilikiGejala ;
                                  owl:someValuesFrom :Gejala
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :menyerangTanaman ;
                                  owl:someValuesFrom :TanamanPangan
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :disebabkanOleh ;
                                  owl:allValuesFrom :Patogen
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :memilikiReferensi ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Referensi
                                ] ;
                    rdfs:range :EntitasKBR ,
                               :Pengendalian ;
                    rdfs:comment "Tindakan pengendalian yang direkomendasikan untuk penyakit."@id ;
                    rdfs:label "dikendalikan dengan"@id ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "dikendalikan dengan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#dipengaruhiOleh
:dipengaruhiOleh rdf:type owl:ObjectProperty ;
                 owl:inverseOf :memengaruhiPenyakit ;
                 rdfs:domain :EntitasKBR ,
                             :Penyakit ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :memilikiGejala ;
                               owl:someValuesFrom :Gejala
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :menyerangTanaman ;
                               owl:someValuesFrom :TanamanPangan
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :disebabkanOleh ;
                               owl:allValuesFrom :Patogen
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :memilikiReferensi ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Referensi
                             ] ;
                 rdfs:range :EntitasKBR ,
                            :FaktorRisiko ;
                 rdfs:comment "Penyakit dipengaruhi oleh faktor risiko atau observasi lingkungan."@id ;
                 rdfs:label "dipengaruhi oleh"@id ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "dipengaruhi oleh"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#disebabkanOleh
:disebabkanOleh rdf:type owl:ObjectProperty ;
                owl:inverseOf :menyebabkanPenyakit ;
                rdfs:domain :EntitasKBR ,
                            :Penyakit ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :memilikiGejala ;
                              owl:someValuesFrom :Gejala
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :menyerangTanaman ;
                              owl:someValuesFrom :TanamanPangan
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :disebabkanOleh ;
                              owl:allValuesFrom :Patogen
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :memilikiReferensi ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Referensi
                            ] ;
                rdfs:range :EntitasKBR ,
                           :Patogen ;
                rdfs:comment "Penyakit disebabkan oleh patogen."@id ;
                rdfs:label "disebabkan oleh"@id ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "disebabkan oleh"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#diserangPenyakit
:diserangPenyakit rdf:type owl:ObjectProperty ;
                  owl:inverseOf :menyerangTanaman ;
                  rdfs:domain :EntitasKBR ,
                              :TanamanPangan ;
                  rdfs:range :EntitasKBR ,
                             :Penyakit ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :memilikiGejala ;
                               owl:someValuesFrom :Gejala
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :menyerangTanaman ;
                               owl:someValuesFrom :TanamanPangan
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :disebabkanOleh ;
                               owl:allValuesFrom :Patogen
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :memilikiReferensi ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Referensi
                             ] ;
                  rdfs:comment "Kebalikan dari menyerangTanaman."@id ;
                  rdfs:label "diserang penyakit"@id ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "diserang penyakit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#kandidatKuat
:kandidatKuat rdf:type owl:ObjectProperty ;
              rdfs:domain :Diagnosis ,
                          :EntitasKBR ;
              rdfs:range :EntitasKBR ,
                         :Penyakit ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :memilikiGejala ;
                           owl:someValuesFrom :Gejala
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :menyerangTanaman ;
                           owl:someValuesFrom :TanamanPangan
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :disebabkanOleh ;
                           owl:allValuesFrom :Patogen
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :memilikiReferensi ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Referensi
                         ] ;
              rdfs:comment "Diagnosis memiliki kandidat penyakit yang didukung minimal dua gejala kanonik berbeda."@id ;
              rdfs:label "kandidat kuat"@id ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "kandidat kuat"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#memengaruhiPenyakit
:memengaruhiPenyakit rdf:type owl:ObjectProperty ;
                     rdfs:domain :EntitasKBR ,
                                 :FaktorRisiko ;
                     rdfs:range :EntitasKBR ,
                                :Penyakit ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :memilikiGejala ;
                                  owl:someValuesFrom :Gejala
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :menyerangTanaman ;
                                  owl:someValuesFrom :TanamanPangan
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :disebabkanOleh ;
                                  owl:allValuesFrom :Patogen
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :memilikiReferensi ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Referensi
                                ] ;
                     rdfs:comment "Kebalikan dari dipengaruhiOleh."@id ;
                     rdfs:label "memengaruhi penyakit"@id ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "memengaruhi penyakit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#memilikiGejala
:memilikiGejala rdf:type owl:ObjectProperty ;
                owl:inverseOf :merupakanGejalaDari ;
                rdfs:domain :EntitasKBR ,
                            :Penyakit ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :memilikiGejala ;
                              owl:someValuesFrom :Gejala
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :menyerangTanaman ;
                              owl:someValuesFrom :TanamanPangan
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :disebabkanOleh ;
                              owl:allValuesFrom :Patogen
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :memilikiReferensi ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Referensi
                            ] ;
                rdfs:range :EntitasKBR ,
                           :Gejala ;
                rdfs:comment "Penyakit memiliki pengamatan gejala tertentu."@id ;
                rdfs:label "memiliki gejala"@id ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "memiliki gejala"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#memilikiGejalaKanonik
:memilikiGejalaKanonik rdf:type owl:ObjectProperty ;
                       owl:inverseOf :merupakanKanonikDari ;
                       rdfs:domain :EntitasKBR ,
                                   :Gejala ;
                       rdfs:range :EntitasKBR ,
                                  :GejalaKanonik ;
                       rdfs:comment "Pengamatan gejala dipetakan ke konsep gejala kanonik."@id ;
                       rdfs:label "memiliki gejala kanonik"@id ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "memiliki gejala kanonik"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#memilikiKondisiTumbuh
:memilikiKondisiTumbuh rdf:type owl:ObjectProperty ;
                       rdfs:domain :EntitasKBR ,
                                   :TanamanPangan ;
                       rdfs:range :EntitasKBR ,
                                  :FaktorRisiko ;
                       rdfs:comment "Tanaman pangan memiliki kondisi lingkungan tumbuh yang terkontrol."@id ;
                       rdfs:label "memiliki kondisi tumbuh"@id ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "memiliki kondisi tumbuh"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#memilikiObservasi
:memilikiObservasi rdf:type owl:ObjectProperty ;
                   rdfs:domain :Diagnosis ,
                               :EntitasKBR ;
                   rdfs:range :EntitasKBR ;
                   rdfs:comment "Diagnosis memiliki observasi gejala atau faktor lingkungan."@id ;
                   rdfs:label "memiliki observasi"@id ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "memiliki observasi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#memilikiReferensi
:memilikiReferensi rdf:type owl:ObjectProperty ;
                   rdfs:domain :EntitasKBR ,
                               :Penyakit ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :memilikiGejala ;
                                 owl:someValuesFrom :Gejala
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :menyerangTanaman ;
                                 owl:someValuesFrom :TanamanPangan
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :disebabkanOleh ;
                                 owl:allValuesFrom :Patogen
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :memilikiReferensi ;
                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Referensi
                               ] ;
                   rdfs:range :EntitasKBR ,
                              :Referensi ;
                   rdfs:comment "Penyakit didukung oleh referensi sumber."@id ;
                   rdfs:label "memiliki referensi"@id ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "memiliki referensi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#memilikiTanaman
:memilikiTanaman rdf:type owl:ObjectProperty ;
                 rdfs:domain :Diagnosis ,
                             :EntitasKBR ;
                 rdfs:range :EntitasKBR ,
                            :TanamanPangan ;
                 rdfs:comment "Diagnosis memiliki tanaman yang diamati."@id ;
                 rdfs:label "memiliki tanaman"@id ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "memiliki tanaman"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#memilikiVarietas
:memilikiVarietas rdf:type owl:ObjectProperty ;
                  owl:inverseOf :merupakanVarietasDari ;
                  rdfs:domain :EntitasKBR ,
                              :TanamanPangan ;
                  rdfs:range :EntitasKBR ,
                             :Varietas ;
                  rdfs:comment "Tanaman pangan memiliki varietas tertentu."@id ;
                  rdfs:label "memiliki varietas"@id ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "memiliki varietas"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#menandaiRisikoLingkungan
:menandaiRisikoLingkungan rdf:type owl:ObjectProperty ;
                          rdfs:domain :Diagnosis ,
                                      :EntitasKBR ;
                          rdfs:range :EntitasKBR ,
                                     :Penyakit ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :memilikiGejala ;
                                       owl:someValuesFrom :Gejala
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :menyerangTanaman ;
                                       owl:someValuesFrom :TanamanPangan
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :disebabkanOleh ;
                                       owl:allValuesFrom :Patogen
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :memilikiReferensi ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :Referensi
                                     ] ;
                          rdfs:comment "Diagnosis menandai penyakit yang risikonya meningkat oleh kondisi lingkungan."@id ;
                          rdfs:label "menandai risiko lingkungan"@id ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "menandai risiko lingkungan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#mengendalikanPenyakit
:mengendalikanPenyakit rdf:type owl:ObjectProperty ;
                       rdfs:domain :EntitasKBR ,
                                   :Pengendalian ;
                       rdfs:range :EntitasKBR ,
                                  :Penyakit ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :memilikiGejala ;
                                    owl:someValuesFrom :Gejala
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :menyerangTanaman ;
                                    owl:someValuesFrom :TanamanPangan
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :disebabkanOleh ;
                                    owl:allValuesFrom :Patogen
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :memilikiReferensi ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Referensi
                                  ] ;
                       rdfs:comment "Kebalikan dari dikendalikanDengan."@id ;
                       rdfs:label "mengendalikan penyakit"@id ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "mengendalikan penyakit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#menggambarkanKondisi
:menggambarkanKondisi rdf:type owl:ObjectProperty ;
                      rdfs:domain :EntitasKBR ,
                                  :FaktorLingkungan ,
                                  :FaktorRisiko ,
                                  :ObservasiLingkungan ;
                      rdfs:range :EntitasKBR ,
                                 :FaktorRisiko ;
                      rdfs:comment "Observasi lingkungan menggambarkan kondisi lingkungan yang terkontrol."@id ;
                      rdfs:label "menggambarkan kondisi"@id ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "menggambarkan kondisi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#menghasilkanPenyakit
:menghasilkanPenyakit rdf:type owl:ObjectProperty ;
                      rdfs:domain :Diagnosis ,
                                  :EntitasKBR ;
                      rdfs:range :EntitasKBR ,
                                 :Penyakit ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :memilikiGejala ;
                                   owl:someValuesFrom :Gejala
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :menyerangTanaman ;
                                   owl:someValuesFrom :TanamanPangan
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :disebabkanOleh ;
                                   owl:allValuesFrom :Patogen
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :memilikiReferensi ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Referensi
                                 ] ;
                      rdfs:comment "Diagnosis atau kandidat diagnosis menghasilkan penyakit."@id ;
                      rdfs:label "menghasilkan penyakit"@id ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "menghasilkan penyakit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#menyebabkanPenyakit
:menyebabkanPenyakit rdf:type owl:ObjectProperty ;
                     rdfs:domain :EntitasKBR ,
                                 :Patogen ;
                     rdfs:range :EntitasKBR ,
                                :Penyakit ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :memilikiGejala ;
                                  owl:someValuesFrom :Gejala
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :menyerangTanaman ;
                                  owl:someValuesFrom :TanamanPangan
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :disebabkanOleh ;
                                  owl:allValuesFrom :Patogen
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :memilikiReferensi ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Referensi
                                ] ;
                     rdfs:comment "Kebalikan dari disebabkanOleh."@id ;
                     rdfs:label "menyebabkan penyakit"@id ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "menyebabkan penyakit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#menyerangBagian
:menyerangBagian rdf:type owl:ObjectProperty ,
                          owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain :EntitasKBR ,
                             :Penyakit ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :memilikiGejala ;
                               owl:someValuesFrom :Gejala
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :menyerangTanaman ;
                               owl:someValuesFrom :TanamanPangan
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :disebabkanOleh ;
                               owl:allValuesFrom :Patogen
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :memilikiReferensi ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Referensi
                             ] ;
                 rdfs:range :BagianTanaman ,
                            :EntitasKBR ;
                 owl:propertyChainAxiom ( :memilikiGejala
                                          :terdapatPada
                                        ) ;
                 rdfs:comment "Bagian tanaman yang terserang penyakit."@id ;
                 rdfs:label "menyerang bagian"@id ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "menyerang bagian"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#menyerangFase
:menyerangFase rdf:type owl:ObjectProperty ;
               rdfs:domain :EntitasKBR ,
                           :Penyakit ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :memilikiGejala ;
                             owl:someValuesFrom :Gejala
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :menyerangTanaman ;
                             owl:someValuesFrom :TanamanPangan
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :disebabkanOleh ;
                             owl:allValuesFrom :Patogen
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :memilikiReferensi ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Referensi
                           ] ;
               rdfs:range :EntitasKBR ,
                          :FasePertumbuhan ;
               rdfs:comment "Fase pertumbuhan tanaman yang diserang penyakit."@id ;
               rdfs:label "menyerang fase"@id ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "menyerang fase"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#menyerangTanaman
:menyerangTanaman rdf:type owl:ObjectProperty ;
                  rdfs:domain :EntitasKBR ,
                              :Penyakit ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :memilikiGejala ;
                                owl:someValuesFrom :Gejala
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :menyerangTanaman ;
