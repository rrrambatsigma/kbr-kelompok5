###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKudisUbiJalar2
:BuktiPengendalianPenyakitKudisUbiJalar2 rdf:type owl:NamedIndividual ,
                                                  :BuktiPengendalian ,
                                                  :BuktiSumber ,
                                                  :EntitasKBR ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://www.w3.org/ns/prov#wasDerivedFrom> ;
                                                    owl:someValuesFrom :Referensi
                                                  ] ;
                                         <http://www.w3.org/ns/prov#wasDerivedFrom> :BukuDOC002 ;
                                         :catatanKualitas "Kutipan sumber berupa fragmen atau kalimat terpotong."@id ;
                                         :dokumenSumber "DOC002" ;
                                         :halamanSumber "84" ;
                                         :idChunkSumber "DOC002_C084_04" ;
                                         :identifierSumber "CTL_189" ;
                                         :kutipanNormalisasi "batatas misalnya jagung, padi, kacang-kacangan, penanaman varietas campuran misalnya varietas yang tahan dengan yang agak tahan, sanitasi lahan dengan cara membakar atau mengubur dalam tanah sisa-sisa tanaman yang terinfeksi, menggunakan fungisida kimiawi misalnya menggunakan bahan aktif benomyl (dosis 400 g ba/ha), chlorotalonil (1.300 g ba/ha), captafol (1.520 g ba/ha), fentin hidraxide (300 g ba/ha), tembaga oxiklorida (1.500 g ba/ha), dan mancozeb, dapat juga menggunakan fungisida nabati (Saleh and Rahayuningsih, 2013)."@id ;
                                         :kutipanSumber "batatas misalnya jagung, padi, kacang-kacangan, penanaman varietas campuran misalnya varietas yang tahan dengan yang agak tahan, sanitasi lahan dengan cara membakar atau mengubur dalam tanah sisa-sisa tanaman yang terinfeksi, menggunakan fungisida kimiawi misalnya menggunakan bahan aktif benomyl (dosis 400 g ba/ha), chlorotalonil (1.300 g ba/ha), captafol (1.520 g ba/ha), fentin hidraxide (300 g ba/ha), tembaga oxiklorida (1.500 g ba/ha), dan mancozeb, dapat juga menggunakan fungisida nabati (Saleh and Rahayuningsih, 2013)."@id ;
                                         rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
                                         rdfs:label "Bukti pengendalian Penyakit kudis (Ubi jalar)"@id ;
                                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Bukti pengendalian Penyakit kudis (Ubi jalar)"@id .


