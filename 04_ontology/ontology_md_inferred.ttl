###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#satuan
:satuan rdf:type owl:DatatypeProperty ;
        rdfs:domain :EntitasKBR ,
                    :FaktorLingkungan ,
                    :FaktorRisiko ,
                    :ObservasiLingkungan ;
        rdfs:range xsd:string ;
