###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangTanah17
:BuktiPengendalianPenyakitBercakDaunKacangTanah17 rdf:type owl:NamedIndividual ,
                                                           :BuktiPengendalian ,
                                                           :BuktiSumber ,
                                                           :EntitasKBR ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://www.w3.org/ns/prov#wasDerivedFrom> ;
                                                             owl:someValuesFrom :Referensi
                                                           ] ;
                                                  <http://www.w3.org/ns/prov#wasDerivedFrom> :BukuDOC002 ;
                                                  :catatanKualitas "Kutipan sumber berupa fragmen atau kalimat terpotong."@id ;
