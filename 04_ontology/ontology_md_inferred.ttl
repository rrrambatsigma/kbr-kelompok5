                                    :memilikiReferensi :BukuDOC002 ;
                                    :menyerangBagian :Akar ,
                                                     :Umbi ;
                                    :menyerangTanaman :UbiJalar ;
                                    :deskripsiPenyakit "Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003). Wamalwa et al. (2015) melaporkan bahwa C. fimbriata dapat menginduksi fitoaleksin yang bersifat toksik pada hewan."@id ;
                                    :identifierSumber "DIS_027" ;
                                    :namaInggrisPenyakit "black rot" ;
                                    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                                 "Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003). Wamalwa et al. (2015) melaporkan bahwa C. fimbriata dapat menginduksi fitoaleksin yang bersifat toksik pada hewan."@id ;
                                    rdfs:label "Penyakit busuk hitam (black rot)"@id ;
                                    <http://www.w3.org/2004/02/skos/core#altLabel> "black rot"@id ;
                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit busuk hitam (black rot)"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBusukPelepahJagung
