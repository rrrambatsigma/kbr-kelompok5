###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#rentanTerhadap
:rentanTerhadap rdf:type owl:ObjectProperty ;
                rdfs:domain :EntitasKBR ,
                            :Varietas ;
                rdfs:range :EntitasKBR ,
                           :Penyakit ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :memilikiGejala ;
                             owl:someValuesFrom :Gejala
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :menyerangTanaman ;
                             owl:someValuesFrom :TanamanPangan
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :disebabkanOleh ;
                             owl:allValuesFrom :Patogen
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :memilikiReferensi ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Referensi
                           ] ;
                rdfs:comment "Varietas dinyatakan rentan atau peka terhadap penyakit."@id ;
                rdfs:label "rentan terhadap"@id ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "rentan terhadap"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#tahanTerhadap
:tahanTerhadap rdf:type owl:ObjectProperty ;
               rdfs:domain :EntitasKBR ,
                           :Varietas ;
               rdfs:range :EntitasKBR ,
                          :Penyakit ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :memilikiGejala ;
                            owl:someValuesFrom :Gejala
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :menyerangTanaman ;
                            owl:someValuesFrom :TanamanPangan
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :disebabkanOleh ;
                            owl:allValuesFrom :Patogen
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :memilikiReferensi ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Referensi
                          ] ;
