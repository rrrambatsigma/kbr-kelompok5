                                :dikendalikanDengan :PengelolaanTerpadu ,
                                                    :PenggunaanAgensHayati ,
                                                    :PenggunaanBacillus ,
                                                    :PenggunaanBakterisida ,
                                                    :PenggunaanBenihSehat ,
                                                    :PenggunaanBiopestisida ,
                                                    :PenggunaanPestisidaNabati ,
                                                    :PenggunaanPseudomonas ,
                                                    :PenggunaanTanamanBukanInang ,
                                                    :PenggunaanVarietasTahan ,
                                                    :RotasiTanaman ;
                                :dipengaruhiOleh :Suhu2537CPadaPenyakitLayuBakteriKacangTanah ,
                                                 :TanahBasahPadaPenyakitLayuBakteriKacangTanah ;
                                :disebabkanOleh :RalstoniaSolanacearum ;
                                :memilikiGejala :GejalaPenyakitLayuBakteriKacangTanahKematianTanaman ,
                                                :GejalaPenyakitLayuBakteriKacangTanahLayuDaun ;
                                :memilikiReferensi :BukuDOC002 ;
                                :menyerangBagian :Daun ;
                                :menyerangTanaman :KacangTanah ;
                                :deskripsiPenyakit "Kacang tanah umumnya kurang rentan dibandingkan tomat, kentang, tembakau dan terung. Insiden penyakit 4-8% pada kultivar kacang tanah resisten dan 10-30% pada yang rentan. Gejala awal berupa kelayuan tidak permanen, tanaman segar kembali malam atau pagi hari. Daun yang layu melengkung ke atas. Gejala ini diikuti oleh kematian sebagian atau seluruh cabang dalam satu tanaman. Jaringan xylem dan pith mengalami perubahan warna. Pada kondisi ini sistem perakaran tidak berfungsi sehingga tanaman layu dan mati."@id ;
                                :identifierSumber "DIS_023" ;
                                rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                             "Kacang tanah umumnya kurang rentan dibandingkan tomat, kentang, tembakau dan terung. Insiden penyakit 4-8% pada kultivar kacang tanah resisten dan 10-30% pada yang rentan. Gejala awal berupa kelayuan tidak permanen, tanaman segar kembali malam atau pagi hari. Daun yang layu melengkung ke atas. Gejala ini diikuti oleh kematian sebagian atau seluruh cabang dalam satu tanaman. Jaringan xylem dan pith mengalami perubahan warna. Pada kondisi ini sistem perakaran tidak berfungsi sehingga tanaman layu dan mati."@id ;
                                rdfs:label "Penyakit Layu Bakteri"@id ;
                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Layu Bakteri"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLayuFusariumKedelai
:PenyakitLayuFusariumKedelai rdf:type owl:NamedIndividual ,
                                      :EntitasKBR ,
                                      :Penyakit ,
                                      :PenyakitJamur ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :disebabkanOleh ;
                                        owl:someValuesFrom :Jamur
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :memilikiGejala ;
                                        owl:someValuesFrom :Gejala
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :menyerangTanaman ;
                                        owl:someValuesFrom :TanamanPangan
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :disebabkanOleh ;
                                        owl:allValuesFrom :Patogen
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :memilikiReferensi ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :Referensi
                                      ] ;
                             :berkaitanPengendalian :PemupukanBerimbang ,
                                                    :PenggunaanAgensHayati ,
                                                    :PenggunaanFungisida ,
                                                    :PenggunaanMulsa ,
                                                    :PenggunaanTrichoderma ,
                                                    :PerlakuanBenih ,
                                                    :SolarisasiTanah ;
                             :didukungOleh :BuktiPatogenPenyakitLayuFusariumKedelai ,
                                           :BuktiPengendalianPenyakitLayuFusariumKedelai ,
                                           :BuktiPengendalianPenyakitLayuFusariumKedelai2 ,
                                           :BuktiPengendalianPenyakitLayuFusariumKedelai3 ,
                                           :BuktiPengendalianPenyakitLayuFusariumKedelai4 ,
                                           :BuktiPenyakitPenyakitLayuFusariumKedelai ;
                             :dikendalikanDengan :PemupukanBerimbang ,
                                                 :PenggunaanAgensHayati ,
                                                 :PenggunaanFungisida ,
                                                 :PenggunaanMulsa ,
                                                 :PenggunaanTrichoderma ,
                                                 :PerlakuanBenih ,
                                                 :SolarisasiTanah ;
                             :dipengaruhiOleh :CuacaSejukDanBasahPadaPenyakitLayuFusariumKedelai ;
                             :disebabkanOleh :FusariumSpp ;
                             :memilikiGejala :GejalaPenyakitLayuFusariumKedelai ,
                                             :GejalaPenyakitLayuFusariumKedelaiBusukAkar ,
                                             :GejalaPenyakitLayuFusariumKedelaiKematianTanaman ,
                                             :GejalaPenyakitLayuFusariumKedelaiLayuDaun ,
                                             :GejalaPenyakitLayuFusariumKedelaiNekrosisTanaman ;
                             :memilikiReferensi :BukuDOC002 ;
                             :menyerangBagian :Akar ,
                                              :Daun ;
                             :menyerangTanaman :Kedelai ;
                             :deskripsiPenyakit "Penyakit layu Fusarium dikenal dengan penyakit busuk akar yang menginfeksi tanaman kedelai dan menyebabkan kematian (Bawa et al., 2018). Penyakit disebabkan oleh patogen Fusarium spp. Beberapa spesies dari patogen yang menginfeksi tanaman kedelai seperti F. solani (Bawa et al., 2018), F. virgulivorme (Baetsen-Young et al., 2020), F. sporotrichioides, F. graminearum, F. proliferatum (Okello et al., 2020). F. proliferatum juga menjadi masalah penting pada kedelai di Kanada (Chang et al., 2015)."@id ;
                             :identifierSumber "DIS_008" ;
                             rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                          "Penyakit layu Fusarium dikenal dengan penyakit busuk akar yang menginfeksi tanaman kedelai dan menyebabkan kematian (Bawa et al., 2018). Penyakit disebabkan oleh patogen Fusarium spp. Beberapa spesies dari patogen yang menginfeksi tanaman kedelai seperti F. solani (Bawa et al., 2018), F. virgulivorme (Baetsen-Young et al., 2020), F. sporotrichioides, F. graminearum, F. proliferatum (Okello et al., 2020). F. proliferatum juga menjadi masalah penting pada kedelai di Kanada (Chang et al., 2015)."@id ;
                             rdfs:label "Penyakit Layu Fusarium"@id ;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Layu Fusarium"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLayuKacangHijau
:PenyakitLayuKacangHijau rdf:type owl:NamedIndividual ,
                                  :EntitasKBR ,
                                  :Penyakit ,
                                  :PenyakitJamur ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :disebabkanOleh ;
                                    owl:someValuesFrom :Jamur
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :memilikiGejala ;
                                    owl:someValuesFrom :Gejala
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :menyerangTanaman ;
                                    owl:someValuesFrom :TanamanPangan
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :disebabkanOleh ;
                                    owl:allValuesFrom :Patogen
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :memilikiReferensi ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Referensi
                                  ] ;
                         :berkaitanPengendalian :PenggunaanAgensHayati ,
                                                :PenggunaanEkstrakTanaman ,
                                                :PenggunaanPestisidaNabati ,
                                                :PenggunaanVarietasTahan ,
                                                :SolarisasiTanah ;
                         :didukungOleh :BuktiMetadataPhasePenyakitLayuKacangHijau ,
                                       :BuktiPatogenPenyakitLayuKacangHijau ,
                                       :BuktiPengendalianPenyakitLayuKacangHijau ,
                                       :BuktiPengendalianPenyakitLayuKacangHijau2 ,
                                       :BuktiPengendalianPenyakitLayuKacangHijau3 ,
                                       :BuktiPengendalianPenyakitLayuKacangHijau4 ,
                                       :BuktiPenyakitPenyakitLayuKacangHijau ;
                         :dikendalikanDengan :PenggunaanAgensHayati ,
                                             :PenggunaanEkstrakTanaman ,
                                             :PenggunaanPestisidaNabati ,
                                             :PenggunaanVarietasTahan ,
                                             :SolarisasiTanah ;
                         :dipengaruhiOleh :Suhu2735CPadaPenyakitLayuKacangHijau ,
                                          :TanahJenuhAirDanKelembapanTinggiPadaPenyakitLayuKacangHijau ;
                         :disebabkanOleh :SclerotiumRolfsii ;
                         :memilikiGejala :GejalaPenyakitLayuKacangHijauBusukTanaman ,
                                         :GejalaPenyakitLayuKacangHijauLayuDaun ,
                                         :GejalaPenyakitLayuKacangHijauMiseliumPadaTanaman ;
                         :memilikiReferensi :BukuDOC005 ;
                         :menyerangBagian :Akar ,
                                          :Daun ;
                         :menyerangFase :FaseGeneratifUmum ;
                         :menyerangTanaman :KacangHijau ;
                         :deskripsiPenyakit "Gejala penyakit layu berupa ruam pada bagian terinfeksi, seperti pengaruh penggenangan air. Bagian yang ruam berwarna coklat muda dan berkembang menjadi coklat tua. Tanaman terinfeksi selanjutnya akan menjadi busuk dan akhirnya mati. Miselia berwarna putih akan ditemukan di sekitar gejala, dan pada gejala tingkat lanjut akan ditemukan sejumlah sclerosia pada akar (Jin Hyeuk 2017) dan daun dekat permukaan tanah (Gambar 25). Selain gejala layu, infeksi cendawan ini juga menyebabkan busuk akar dan polong, serta rebah kecambah (damping off) (Akram et al. 2007). Infeksi pada tanaman dapat terjadi pada stadia awal sebelum benih berkecambah hingga fase generatif akhir. Namun demikian fase awal pertumbuhan tanaman merupakan fase rentan infeksi cendawan ini."@id ;
                         :identifierSumber "DIS_125" ;
                         rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                      "Gejala penyakit layu berupa ruam pada bagian terinfeksi, seperti pengaruh penggenangan air. Bagian yang ruam berwarna coklat muda dan berkembang menjadi coklat tua. Tanaman terinfeksi selanjutnya akan menjadi busuk dan akhirnya mati. Miselia berwarna putih akan ditemukan di sekitar gejala, dan pada gejala tingkat lanjut akan ditemukan sejumlah sclerosia pada akar (Jin Hyeuk 2017) dan daun dekat permukaan tanah (Gambar 25). Selain gejala layu, infeksi cendawan ini juga menyebabkan busuk akar dan polong, serta rebah kecambah (damping off) (Akram et al. 2007). Infeksi pada tanaman dapat terjadi pada stadia awal sebelum benih berkecambah hingga fase generatif akhir. Namun demikian fase awal pertumbuhan tanaman merupakan fase rentan infeksi cendawan ini."@id ;
                         rdfs:label "Penyakit Layu"@id ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "LAYU"@id ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Layu"@id .


