###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKudisUbiJalar
:BuktiGejalaPenyakitKudisUbiJalar rdf:type owl:NamedIndividual ,
                                           :BuktiGejala ,
                                           :BuktiSumber ,
                                           :EntitasKBR ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <http://www.w3.org/ns/prov#wasDerivedFrom> ;
                                             owl:someValuesFrom :Referensi
                                           ] ;
                                  <http://www.w3.org/ns/prov#wasDerivedFrom> :BukuDOC002 ;
                                  :dokumenSumber "DOC002" ;
                                  :halamanSumber "83" ;
                                  :idChunkSumber "DOC002_C083_01" ;
                                  :identifierSumber "SYM_160" ;
                                  :kutipanNormalisasi "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
                                  :kutipanSumber "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
                                  rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
                                  rdfs:label "Bukti gejala Penyakit kudis (Ubi jalar)"@id ;
                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Bukti gejala Penyakit kudis (Ubi jalar)"@id .


