                                                      rdfs:label "Busuk pada tanaman pada Penyakit busuk hitam (black rot) (Ubi jalar)"@id ;
                                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Busuk pada tanaman pada Penyakit busuk hitam (black rot) (Ubi jalar)"@id .


