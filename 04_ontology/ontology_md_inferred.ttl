                    :dipengaruhiOleh :MusimHujanPadaPenyakitTungroPadi ;
                    :disebabkanOleh :RiceTungroBacilliforVirus ,
                                    :RiceTungroSphericalVirus ;
                    :memilikiGejala :GejalaPenyakitTungroPadiBercakTanaman ,
                                    :GejalaPenyakitTungroPadiKerdilTanaman ,
