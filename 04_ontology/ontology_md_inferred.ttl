###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#tahunTerbit
:tahunTerbit rdf:type owl:DatatypeProperty ;
             rdfs:domain :EntitasKBR ,
                         :Referensi ;
             rdfs:range xsd:integer ;
             rdfs:comment "Tahun publikasi referensi."@id ;
             rdfs:label "tahun terbit"@id ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "tahun terbit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#tingkatKeparahan
:tingkatKeparahan rdf:type owl:DatatypeProperty ;
                  rdfs:domain :EntitasKBR ,
                              :Penyakit ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :memilikiGejala ;
                                owl:someValuesFrom :Gejala
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :menyerangTanaman ;
                                owl:someValuesFrom :TanamanPangan
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :disebabkanOleh ;
                                owl:allValuesFrom :Patogen
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :memilikiReferensi ;
                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Referensi
                              ] ;
                  rdfs:range rdf:PlainLiteral ;
                  rdfs:comment "Kategori keparahan penyakit bila tersedia di sumber."@id ;
                  rdfs:label "tingkat keparahan"@id ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "tingkat keparahan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#urlReferensi
:urlReferensi rdf:type owl:DatatypeProperty ;
              rdfs:domain :EntitasKBR ,
                          :Referensi ;
              rdfs:range xsd:anyURI ;
              rdfs:comment "Tautan sumber referensi bila tersedia."@id ;
              rdfs:label "url referensi"@id ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "url referensi"@id .


