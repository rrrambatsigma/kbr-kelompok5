            :merupakanKanonikDari :GejalaPenyakitBulaiJagungTepungDaun ,
                                  :GejalaPenyakitEmbunTepungKacangHijauTepungDaun ,
                                  :GejalaPenyakitEmbunTepungPowderyMildewKedelaiTepungDaun ,
                                  :GejalaPenyakitKaratDaunKacangTanahTepungDaun ;
            :kodeGejala "TepungDaun" ;
            rdfs:comment "Konsep kanonik untuk gejala berupa lapisan tepung pada permukaan daun."@id ;
            rdfs:label "Tepung pada daun"@id ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "tepung pada daun"@id ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Tepung pada daun"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiJalar
:UbiJalar rdf:type owl:NamedIndividual ,
                   :EntitasKBR ,
                   :TanamanPangan ,
                   :UmbiUmbian ,
                   [ rdf:type owl:Class ;
                     owl:oneOf ( :UbiJalar
                                 :UbiKayu
                               )
                   ] ;
          :diserangPenyakit :LayuFusariumUbiJalar ,
                            :PenyakitBercakKuningUbiJalar ,
                            :PenyakitBusukHitamBlackRotUbiJalar ,
                            :PenyakitKudisUbiJalar ;
          :memilikiKondisiTumbuh :KondisiTanahGembur ;
          :memilikiVarietas :VarietasAbomourow ,
                            :VarietasBonsasarai ,
                            :VarietasInanwatan4 ,
                            :VarietasKuyage2 ,
                            :VarietasMouwebsi ,
                            :VarietasWonembai ;
          :deskripsiTanaman "Ubi jalar (Ipomoea batatas L. (Lam) adalah salah satu komoditas pangan penting di dunia yang menduduki urutan ketujuh (FAOSTAT, 2009), setelah gandum, beras, jagung, kentang, barley, dan ubi kayu (Aguoru, Uhia and Olasan, 2015). Produksi terbesar di Asia sebanyak 76.1% dari produksi di dunia pada tahun 2013, diikuti Afrika dan terdapat 5 negara produsen terbesar di dunia yang memproduksi ubi jalar pada tahun 2014 yaitu Cina, Nigeria, Uganda, Indonesia, dan United Republic dari Tanzania (FAOSTAT 2015 dalam Okada et al. 2017). Sebagai sumber karbohidrat, ubi jalar memiliki potensi untuk dikembangkan dalam menunjang program diversifikasi pangan (Barahima and Purnomo, 2003). Selain itu, ubi jalar banyak mengandung pro- vitamin, vitamin C, potasium, besi, dan kalsium (Clark et al., 2013)."@id ;
          :identifierSumber "PLANT_004" ;
          :namaIlmiah "Ipomoea batatas L. (Lam)" ;
          rdfs:comment "Tanaman pangan dalam ruang lingkup knowledge base."@id ,
                       "Ubi jalar (Ipomoea batatas L. (Lam) adalah salah satu komoditas pangan penting di dunia yang menduduki urutan ketujuh (FAOSTAT, 2009), setelah gandum, beras, jagung, kentang, barley, dan ubi kayu (Aguoru, Uhia and Olasan, 2015). Produksi terbesar di Asia sebanyak 76.1% dari produksi di dunia pada tahun 2013, diikuti Afrika dan terdapat 5 negara produsen terbesar di dunia yang memproduksi ubi jalar pada tahun 2014 yaitu Cina, Nigeria, Uganda, Indonesia, dan United Republic dari Tanzania (FAOSTAT 2015 dalam Okada et al. 2017). Sebagai sumber karbohidrat, ubi jalar memiliki potensi untuk dikembangkan dalam menunjang program diversifikasi pangan (Barahima and Purnomo, 2003). Selain itu, ubi jalar banyak mengandung pro- vitamin, vitamin C, potasium, besi, dan kalsium (Clark et al., 2013)."@id ;
          rdfs:label "Ubi jalar"@id ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Ubi jalar"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiKayu
:UbiKayu rdf:type owl:NamedIndividual ,
                  :EntitasKBR ,
                  :TanamanPangan ,
                  :UmbiUmbian ,
                  [ rdf:type owl:Class ;
                    owl:oneOf ( :UbiJalar
                                :UbiKayu
                              )
                  ] ;
         :berkaitanPengendalian :KarantinaTanaman ,
                                :PanenTepatWaktu ,
                                :PemupukanBerimbang ,
                                :PengairanDanDrainase ,
                                :PengaturanJarakTanam ,
                                :PenggunaanVarietasTahan ,
                                :PengumpulanDanPemusnahan ,
                                :RotasiTanaman ,
                                :SanitasiLahan ,
                                :SeleksiBahanTanam ;
         :didukungOleh :BuktiPengendalianUmumUbiKayu ,
                       :BuktiPengendalianUmumUbiKayu2 ,
                       :BuktiPengendalianUmumUbiKayu3 ,
                       :BuktiPengendalianUmumUbiKayu4 ,
                       :BuktiPengendalianUmumUbiKayu5 ;
         :diserangPenyakit :AntraknosaUbiKayuBatang ,
                           :AntraknosaUbiKayuDaun ,
                           :BercakDaunBaurUbiKayu ,
                           :BercakDaunCoklatUbiKayu ,
                           :BercakDaunPutihUbiKayu ,
                           :BusukAkarDanUmbiUbiKayu ,
                           :BusukAkarUbiKayu ,
                           :BusukPangkalBatangUbiKayu ,
                           :BusukUmbiUbiKayu ,
                           :CassavaBrownStreakDiseaseCBSDUbiKayu ,
                           :CassavaMosaicBegomovirusCMBsUbiKayu ,
                           :HawarBakteriUbiKayu ,
                           :HawarDaunBakteriUbiKayu ,
                           :NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu ,
                           :SapuSetanWitchesBroomUbiKayu ,
                           :SuperelongasiUbiKayu ,
                           :TanamanKerdilStuntUbiKayu ;
         :memilikiKondisiTumbuh :KondisiTanahSubur ;
         :pengendalianUmum :KarantinaTanaman ,
                           :PanenTepatWaktu ,
                           :PemupukanBerimbang ,
                           :PengairanDanDrainase ,
                           :PengaturanJarakTanam ,
                           :PenggunaanVarietasTahan ,
                           :PengumpulanDanPemusnahan ,
                           :RotasiTanaman ,
                           :SanitasiLahan ,
                           :SeleksiBahanTanam ;
         :deskripsiTanaman "Indonesia dengan keragaman budayanya turut membentuk keragaman makanan pokok masyarakatnya yang disebabkan oleh kearifan lokal serta adat. Hal ini mengakibatkan masyarakat membudidayakan tanaman pangan tersebut, meskipun pada kalangan masyarakat Indonesia secara umum saat ini identik dengan nasi sebagai makanan pokok atau utama. Pola konsumsi yang diperkenalkan oleh para leluhur dan terjadi secara turun temurun, menyebabkan masyarakat adat membudidayakan tanaman-tanaman tersebut sebagai sumber pangan yang juga dimanfaatkan sebagai makanan pokok. Tanaman pangan yang dimanfaatkan sebagai makanan pokok di Indonesia di antaranya yaitu merupakan kelompok umbi-umbian, antara lain ubi kayu, ubi jalar, gembili, ganyong."@id ;
         :identifierSumber "PLANT_005" ;
         :namaIlmiah "Manihot esculenta Crantz" ;
         rdfs:comment "Indonesia dengan keragaman budayanya turut membentuk keragaman makanan pokok masyarakatnya yang disebabkan oleh kearifan lokal serta adat. Hal ini mengakibatkan masyarakat membudidayakan tanaman pangan tersebut, meskipun pada kalangan masyarakat Indonesia secara umum saat ini identik dengan nasi sebagai makanan pokok atau utama. Pola konsumsi yang diperkenalkan oleh para leluhur dan terjadi secara turun temurun, menyebabkan masyarakat adat membudidayakan tanaman-tanaman tersebut sebagai sumber pangan yang juga dimanfaatkan sebagai makanan pokok. Tanaman pangan yang dimanfaatkan sebagai makanan pokok di Indonesia di antaranya yaitu merupakan kelompok umbi-umbian, antara lain ubi kayu, ubi jalar, gembili, ganyong."@id ,
                      "Tanaman pangan dalam ruang lingkup knowledge base."@id ;
         rdfs:label "Ubi kayu"@id ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Ubi kayu"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Umbi
:Umbi rdf:type owl:NamedIndividual ,
               :BagianTanaman ,
               :EntitasKBR ;
      rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id ,
                   "Selain itu, kerusakan daun akibat serangan penyakit dapat menyebabkan penurunan aktivitas fotosintesis yang dapat berakibat pada penurunan hasil dan kualitas umbi akar."@id ;
      rdfs:label "Umbi"@id ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Umbi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasAbomourow
:VarietasAbomourow rdf:type owl:NamedIndividual ,
                            :EntitasKBR ,
                            :Varietas ;
                   :didukungOleh :BuktiVarietasUbiJalar ;
                   :merupakanVarietasDari :UbiJalar ;
                   :tahanTerhadap :PenyakitKudisUbiJalar ;
                   rdfs:comment "Menurut (Martanto, Tanati and Baan, 2016) varietas tahan dapat menggunakan Mouwebsi, Wonembai, Kuyage-2, Inanwatan-4, Abomourow, sedangkan Bonsasarai termasuk agak tahan."@id ,
                                "Varietas tanaman yang disebut sumber."@id ;
                   rdfs:label "Abomourow"@id ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Abomourow"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasAnjasmoro
:VarietasAnjasmoro rdf:type owl:NamedIndividual ,
                            :EntitasKBR ,
                            :Varietas ;
                   :didukungOleh :BuktiMetadataVarietyPenyakitEmbunTepungPowderyMildewKedelai ,
                                 :BuktiVarietasKedelai ,
                                 :BuktiVarietasKedelai2 ;
                   :merupakanVarietasDari :Kedelai ;
                   :rentanTerhadap :PenyakitEmbunTepungPowderyMildewKedelai ;
                   :tahanTerhadap :PenyakitKaratDaunKedelai ,
                                  :PenyakitRebahSemaiKedelai ;
                   rdfs:comment "Hasil penelitian yang dilakukan oleh Fitria and Masnilah, (2020) pada beberapa varietas kedelai terhadap patogen *S. rolfsii* diketahui bahwa Varietas Dena 1 tingkat keparahan penyakitnya lebih rendah dibandingkan dengan varietas Anjasmoro, Devon 1, Dering 1, Grobogan, dan Dega 1 yaitu 30% yang termasuk ke dalam varietas tahan."@id ,
                                "Varietas tanaman yang disebut pada sumber."@id ,
                                "Varietas tanaman yang disebut sumber."@id ;
                   rdfs:label "Anjasmoro"@id ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Anjasmoro"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasAsianHoney
:VarietasAsianHoney rdf:type owl:NamedIndividual ,
                             :EntitasKBR ,
                             :Varietas ;
                    :didukungOleh :BuktiVarietasJagung ,
                                  :BuktiVarietasJagung2 ;
                    :merupakanVarietasDari :Jagung ;
                    :tahanTerhadap :PenyakitBulaiJagung ;
                    rdfs:comment "Pengendalian penyakit bulai jagung dapat dilakukan dengan menggunakan varietas tahan seperti Jagung Asian Honey yang mempunyai kejadian penyakit lebih rendah (54.17%) dibandingkan dengan varietas Jagung Pioneer 21 (70.83%) dan Jagung Pacific 339 (79.17%)."@id ,
                                 "Varietas tanaman yang disebut sumber."@id ;
                    rdfs:label "Asian Honey"@id ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Asian Honey"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasBadak
:VarietasBadak rdf:type owl:NamedIndividual ,
                        :EntitasKBR ,
                        :Varietas ;
               :didukungOleh :BuktiVarietasKacangTanah2 ;
               :merupakanVarietasDari :KacangTanah ;
               :tahanTerhadap :PenyakitBercakDaunKacangTanah ;
               rdfs:comment "Beberapa varietas kacang tanah di Balitkabi memiliki sifat tahan terhadap bercak daun yakni varietas Panther dan Domba, sedangkan yang agak tahan adalah Bison, Jerapah, Kelinci, dan Badak (Purnomo et al. 2004)."@id ,
                            "Varietas tanaman yang disebut sumber."@id ;
               rdfs:label "Badak"@id ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Badak"@id .


