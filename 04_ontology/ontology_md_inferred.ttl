#################################################################
#    General axioms
#################################################################

[ owl:intersectionOf ( :Penyakit
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :disebabkanOleh ;
                         owl:someValuesFrom :Bakteri
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :Penyakit
] .


[ owl:intersectionOf ( :Penyakit
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :disebabkanOleh ;
                         owl:someValuesFrom :Bakteri
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :PenyakitBakteri
] .


[ owl:intersectionOf ( :Penyakit
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :disebabkanOleh ;
                         owl:someValuesFrom :Fitoplasma
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :Penyakit
] .


[ owl:intersectionOf ( :Penyakit
