###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Jagung
:Jagung rdf:type owl:NamedIndividual ,
                 :EntitasKBR ,
                 :Serealia ,
                 :TanamanPangan ,
                 [ rdf:type owl:Class ;
                   owl:oneOf ( :Jagung
                               :Padi
                             )
                 ] ;
        :diserangPenyakit :PenyakitBulaiJagung ,
                          :PenyakitBusukPelepahJagung ,
                          :PenyakitHawarDaunJagung ,
                          :PenyakitKaratDaunJagung ,
                          :PenyakitLayuStewartJagung ;
        :memilikiKondisiTumbuh :KondisiSuhuSedang ;
        :memilikiVarietas :VarietasAsianHoney ,
                          :VarietasPioneer21 ,
                          :VarietasPioneer27 ;
        :deskripsiTanaman "Jagung merupakan salah satu komoditas pangan yang mempunyai nilai ekonomi penting di Indonesia dan menempati urutan kedua setelah padi. Sebagai salah satu alternatif tanaman pangan pengganti beras (upaya diversifikasi pangan), jagung mempunyai kandungan gizi yang hampir sama dengan beras, yaitu berupa karbohidrat, protein, lemak, serat dan gula. Pemanfaatan jagung di Indonesia umumnya untuk konsumsi langsung, benih, bahan baku industri pakan ternak, industri pangan dan non pangan, pakan ternak dan sebagai bahan bakar."@id ;
        :identifierSumber "PLANT_006" ;
        :namaIlmiah "Zea mays L." ;
        rdfs:comment "Jagung merupakan salah satu komoditas pangan yang mempunyai nilai ekonomi penting di Indonesia dan menempati urutan kedua setelah padi. Sebagai salah satu alternatif tanaman pangan pengganti beras (upaya diversifikasi pangan), jagung mempunyai kandungan gizi yang hampir sama dengan beras, yaitu berupa karbohidrat, protein, lemak, serat dan gula. Pemanfaatan jagung di Indonesia umumnya untuk konsumsi langsung, benih, bahan baku industri pakan ternak, industri pangan dan non pangan, pakan ternak dan sebagai bahan bakar."@id ,
                     "Nama ilmiah dilengkapi dari Plants of the World Online (Kew) karena tidak tercantum pada sumber utama."@id ,
                     "Tanaman pangan dalam ruang lingkup knowledge base."@id ;
        rdfs:label "Jagung"@id ;
        rdfs:seeAlso <https://powo.science.kew.org/results?q=Zea%20mays> ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Jagung"@id .


