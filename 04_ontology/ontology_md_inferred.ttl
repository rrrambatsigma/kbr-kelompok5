###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBakteriPustulKedelai
:PenyakitBakteriPustulKedelai rdf:type owl:NamedIndividual ,
                                       :EntitasKBR ,
                                       :Penyakit ,
                                       :PenyakitBakteri ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :disebabkanOleh ;
                                         owl:someValuesFrom :Bakteri
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :memilikiGejala ;
                                         owl:someValuesFrom :Gejala
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :menyerangTanaman ;
                                         owl:someValuesFrom :TanamanPangan
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :disebabkanOleh ;
                                         owl:allValuesFrom :Patogen
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :memilikiReferensi ;
                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :Referensi
                                       ] ;
                              :berkaitanPengendalian :PenggunaanAgensHayati ,
                                                     :PenggunaanBacillus ,
                                                     :PenggunaanBenihSehat ,
                                                     :PenggunaanEkstrakTanaman ,
                                                     :SanitasiLahan ;
                              :didukungOleh :BuktiPatogenPenyakitBakteriPustulKedelai ,
                                            :BuktiPengendalianPenyakitBakteriPustulKedelai ,
                                            :BuktiPengendalianPenyakitBakteriPustulKedelai2 ,
                                            :BuktiPengendalianPenyakitBakteriPustulKedelai3 ,
                                            :BuktiPenyakitPenyakitBakteriPustulKedelai ;
                              :dikendalikanDengan :PenggunaanAgensHayati ,
                                                  :PenggunaanBacillus ,
                                                  :PenggunaanBenihSehat ,
                                                  :PenggunaanEkstrakTanaman ,
                                                  :SanitasiLahan ;
                              :dipengaruhiOleh :KelembapanTinggiDanDaunBasahPadaPenyakitBakteriPustulKedelai ,
                                               :SuhuPadaPenyakitBakteriPustulKedelai ;
                              :disebabkanOleh :XanthomonasAxonopodis ;
                              :memilikiGejala :GejalaPenyakitBakteriPustulKedelai ,
                                              :GejalaPenyakitBakteriPustulKedelaiBercakDaun ,
                                              :GejalaPenyakitBakteriPustulKedelaiBercakTanaman ,
                                              :GejalaPenyakitBakteriPustulKedelaiDaunRontok ,
                                              :GejalaPenyakitBakteriPustulKedelaiKlorosisTanaman ;
                              :memilikiReferensi :BukuDOC002 ;
                              :menyerangBagian :Daun ;
                              :menyerangTanaman :Kedelai ;
                              :deskripsiPenyakit "Penyakit yang juga sering menyerang pada tanaman kedelai adalah penyakit bakteri pustul. Penyakit ini disebabkan oleh patogen Xanthomonas axonopodis pv. glycines. Patogen akan menginfeksi bagian daun tanaman. Gejala yang muncul akibat serangan patogen X. axonopodis pv. glycines diawali dengan adanya bercak-bercak pada bagian daun. Bercak berwarna hijau kekuningan. Kemudian bercak berkembang menjadi berwarna kuning kecokelatan. Pada awal munculnya bercak berukuran kecil. Kemudian pada serangan yang tinggi maka bercak menjadi berukuran besar (Gambar 2.16)."@id ;
                              :identifierSumber "DIS_017" ;
                              rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                           "Penyakit yang juga sering menyerang pada tanaman kedelai adalah penyakit bakteri pustul. Penyakit ini disebabkan oleh patogen Xanthomonas axonopodis pv. glycines. Patogen akan menginfeksi bagian daun tanaman. Gejala yang muncul akibat serangan patogen X. axonopodis pv. glycines diawali dengan adanya bercak-bercak pada bagian daun. Bercak berwarna hijau kekuningan. Kemudian bercak berkembang menjadi berwarna kuning kecokelatan. Pada awal munculnya bercak berukuran kecil. Kemudian pada serangan yang tinggi maka bercak menjadi berukuran besar (Gambar 2.16)."@id ;
                              rdfs:label "Penyakit Bakteri Pustul"@id ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Penyakit Bakteri Pustul"@id .


