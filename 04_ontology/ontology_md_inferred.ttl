###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#HawarDaunBakteriUbiKayu
:HawarDaunBakteriUbiKayu rdf:type owl:NamedIndividual ,
                                  :EntitasKBR ,
                                  :Penyakit ,
                                  :PenyakitBakteri ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :disebabkanOleh ;
                                    owl:someValuesFrom :Bakteri
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :memilikiGejala ;
                                    owl:someValuesFrom :Gejala
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :menyerangTanaman ;
                                    owl:someValuesFrom :TanamanPangan
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :disebabkanOleh ;
                                    owl:allValuesFrom :Patogen
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :memilikiReferensi ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Referensi
                                  ] ;
                         :didukungOleh :BuktiPatogenHawarDaunBakteriUbiKayu ,
                                       :BuktiPenyakitHawarDaunBakteriUbiKayu ;
                         :dipengaruhiOleh :KelembapanTinggiPadaHawarDaunBakteriUbiKayu ,
                                          :MusimHujanPadaHawarDaunBakteriUbiKayu ,
                                          :SuhuPadaHawarDaunBakteriUbiKayu ;
                         :disebabkanOleh :XanthomonasCampestrisPvManihotis ,
                                         :XanthomonasCampestrispvManihotis ;
                         :memilikiGejala :GejalaHawarDaunBakteriUbiKayuBercakDaun ,
                                         :GejalaHawarDaunBakteriUbiKayuDaunRontok ,
                                         :GejalaHawarDaunBakteriUbiKayuHawarDaun ,
                                         :GejalaHawarDaunBakteriUbiKayuLayuDaun ;
                         :memilikiReferensi :BukuDOC002 ;
                         :menyerangBagian :Daun ;
                         :menyerangTanaman :UbiKayu ;
                         :deskripsiPenyakit "Gejala khas berupa bercak atau lesi berair (eksudat seperti getah berwarna krem) pada tangkai daun tanaman terinfeksi. Pada daun gejala muncul urat atau tulang daun,tepi dan ujung bilah daun. Perkembangan infeksi lebih lanjut bercak tersebut menyatu membentuk hawar/bercak coklat besar, daun mengering atau layu, daun gugur."@id ;
                         :identifierSumber "DIS_032" ;
                         rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                      "Gejala khas berupa bercak atau lesi berair (eksudat seperti getah berwarna krem) pada tangkai daun tanaman terinfeksi. Pada daun gejala muncul urat atau tulang daun,tepi dan ujung bilah daun. Perkembangan infeksi lebih lanjut bercak tersebut menyatu membentuk hawar/bercak coklat besar, daun mengering atau layu, daun gugur."@id ;
                         rdfs:label "Hawar daun bakteri"@id ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Hawar daun bakteri"@id .


