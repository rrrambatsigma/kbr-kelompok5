    ns1:dipengaruhiOleh ns1:KondisiMusimHujan,
        ns1:KondisiMusimKemarau ;
    ns1:disebabkanOleh ns1:PeanutMottleVirus,
        ns1:PeanutStripeVirus ;
    ns1:identifierSumber "DIS_022" ;
    ns1:memilikiGejala ns1:GejalaPenyakitBelangMottleKacangTanah,
        ns1:GejalaPenyakitBelangMottleKacangTanah2,
        ns1:GejalaPenyakitBelangMottleKacangTanahBelangTanaman,
        ns1:GejalaPenyakitBelangMottleKacangTanahKlorosisDaun,
        ns1:GejalaPenyakitBelangMottleKacangTanahKlorosisTanaman,
        ns1:GejalaPenyakitBelangMottleKacangTanahMosaikDaun ;
