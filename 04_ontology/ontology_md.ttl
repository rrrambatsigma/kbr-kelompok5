###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKerdilRumputDanKerdilHampaPadiBenderaMenyebabkanMenjadiAbnormalMana
ns1:PengamatanPenyakitKerdilRumputDanKerdilHampaPadiBenderaMenyebabkanMenjadiAbnormalMana rdf:type owl:NamedIndividual ,
                                                                                                   ns1:GejalaDaun ;
                                                                                          ns1:didukungOleh ns1:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiBenderaMenyebabkanMenjadiAbnormalMana ;
                                                                                          ns1:merupakanGejalaDari ns1:PenyakitKerdilRumputDanKerdilHampaPadi ;
                                                                                          ns1:terdapatPada ns1:Daun ;
                                                                                          ns1:deskripsiGejala "Infeksi pada daun bendera dapat menyebabkan daun menjadi abnormal di mana daun akan terpelintir dan memendek seperti pada Gambar 1.8."@id ;
                                                                                          rdfs:comment "Infeksi pada daun bendera dapat menyebabkan daun menjadi abnormal di mana daun akan terpelintir dan memendek seperti pada Gambar 1.8."@id ,
                                                                                                       "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ;
                                                                                          rdfs:label "Pengamatan gejala Penyakit Kerdil Rumput dan Kerdil Hampa"@id ;
                                                                                          skos:prefLabel "Pengamatan gejala Penyakit Kerdil Rumput dan Kerdil Hampa"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKerdilRumputDanKerdilHampaPadiBercakDaun
ns1:PengamatanPenyakitKerdilRumputDanKerdilHampaPadiBercakDaun rdf:type owl:NamedIndividual ,
                                                                        ns1:GejalaDaun ;
                                                               ns1:didukungOleh ns1:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSelainPerubahanWarnaTampakPula ;
                                                               ns1:memilikiGejalaKanonik ns1:BercakDaun ;
                                                               ns1:merupakanGejalaDari ns1:PenyakitKerdilRumputDanKerdilHampaPadi ;
                                                               ns1:terdapatPada ns1:Daun ;
                                                               ns1:deskripsiGejala "Selain perubahan warna, tampak pula bintik-bintik atau bercak coklat tua pada daun yang bergejala kerdil hampa bila pupuk nitrogen yang diberikan tidak berimbang (Sari, 2019)."@id ;
                                                               rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ,
                                                                            "Selain perubahan warna, tampak pula bintik-bintik atau bercak coklat tua pada daun yang bergejala kerdil hampa bila pupuk nitrogen yang diberikan tidak berimbang (Sari, 2019)."@id ;
                                                               rdfs:label "Bercak daun pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id ;
                                                               skos:prefLabel "Bercak daun pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKerdilRumputDanKerdilHampaPadiKerdilTanaman
ns1:PengamatanPenyakitKerdilRumputDanKerdilHampaPadiKerdilTanaman rdf:type owl:NamedIndividual ,
                                                                           ns1:GejalaBatang ,
                                                                           ns1:GejalaDaun ;
                                                                  ns1:didukungOleh ns1:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiKhasRumputJumlahAnakanBentuk ,
                                                                                   ns1:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSelainPerubahanWarnaTampakPula ,
                                                                                   ns1:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSementaraHampaSelainMudaBergigi ;
                                                                  ns1:memilikiGejalaKanonik ns1:KerdilTanaman ;
                                                                  ns1:merupakanGejalaDari ns1:PenyakitKerdilRumputDanKerdilHampaPadi ;
                                                                  ns1:terdapatPada ns1:Batang ,
                                                                                   ns1:Daun ;
                                                                  ns1:deskripsiGejala "Gejala yang khas dari penyakit kerdil rumput yaitu kerdil dengan jumlah anakan banyak, bentuk daun pendek dan sempit, bagian batang tumbuh menjadi tegak dan kaku, serta diskolorasi daun (Gambar 1.7)."@id ;
                                                                  rdfs:comment "Gejala yang khas dari penyakit kerdil rumput yaitu kerdil dengan jumlah anakan banyak, bentuk daun pendek dan sempit, bagian batang tumbuh menjadi tegak dan kaku, serta diskolorasi daun (Gambar 1.7)."@id ,
                                                                               "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
                                                                  rdfs:label "Kerdil tanaman pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id ;
                                                                  skos:prefLabel "Kerdil tanaman pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKerdilRumputDanKerdilHampaPadiKlorosisDaun
ns1:PengamatanPenyakitKerdilRumputDanKerdilHampaPadiKlorosisDaun rdf:type owl:NamedIndividual ,
                                                                          ns1:GejalaDaun ;
                                                                 ns1:didukungOleh ns1:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSementaraHampaSelainMudaBergigi ;
                                                                 ns1:memilikiGejalaKanonik ns1:KlorosisDaun ;
                                                                 ns1:merupakanGejalaDari ns1:PenyakitKerdilRumputDanKerdilHampaPadi ;
                                                                 ns1:terdapatPada ns1:Daun ;
                                                                 ns1:deskripsiGejala "Sementara itu, gejala penyakit kerdil hampa yaitu selain kerdil, pada tanaman padi yang masih muda daun akan bergigi, tidak rata, klorotik, dan pecah-pecah."@id ;
                                                                 rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ,
                                                                              "Sementara itu, gejala penyakit kerdil hampa yaitu selain kerdil, pada tanaman padi yang masih muda daun akan bergigi, tidak rata, klorotik, dan pecah-pecah."@id ;
                                                                 rdfs:label "Klorosis daun pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id ;
                                                                 skos:prefLabel "Klorosis daun pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKudisUbiJalarBercakDaun
ns1:PengamatanPenyakitKudisUbiJalarBercakDaun rdf:type owl:NamedIndividual ,
                                                       ns1:GejalaBatang ,
                                                       ns1:GejalaDaun ,
                                                       ns1:GejalaPucuk ;
                                              ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalarTimbulAkibatBagianBatangTerdapat ;
                                              ns1:memilikiGejalaKanonik ns1:BercakDaun ;
                                              ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                              ns1:terdapatPada ns1:Batang ,
                                                               ns1:Daun ,
                                                               ns1:Pucuk ;
                                              ns1:deskripsiGejala "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
                                              rdfs:comment "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ,
                                                           "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
                                              rdfs:label "Bercak daun pada Penyakit kudis"@id ;
                                              skos:prefLabel "Bercak daun pada Penyakit kudis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKudisUbiJalarBercakTanaman
ns1:PengamatanPenyakitKudisUbiJalarBercakTanaman rdf:type owl:NamedIndividual ,
                                                          ns1:Gejala ;
                                                 ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalarAwalnyaBerwarnaKuningCoklatKekuningan ;
                                                 ns1:memilikiGejalaKanonik ns1:BercakTanaman ;
                                                 ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                                 ns1:deskripsiGejala "Pada awalnya bercak berwarna kuning coklat kekuningan, coklat kemerahan dan akhirnya menjadi coklat kehitaman (Martanto, Tanati and Baan, 2016)."@id ;
                                                 rdfs:comment "Pada awalnya bercak berwarna kuning coklat kekuningan, coklat kemerahan dan akhirnya menjadi coklat kehitaman (Martanto, Tanati and Baan, 2016)."@id ,
                                                              "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
                                                 rdfs:label "Bercak pada tanaman pada Penyakit kudis"@id ;
                                                 skos:prefLabel "Bercak pada tanaman pada Penyakit kudis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKudisUbiJalarInokulumBiasanyaBerasalBahanTanam
ns1:PengamatanPenyakitKudisUbiJalarInokulumBiasanyaBerasalBahanTanam rdf:type owl:NamedIndividual ,
                                                                              ns1:Gejala ;
                                                                     ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalarInokulumBiasanyaBerasalBahanTanam ;
                                                                     ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                                                     ns1:deskripsiGejala "Sumber inokulum penyakit kudis biasanya berasal dari bahan tanam (setek) yang terinfeksi jamur, penyakit ini menyebar lebih cepat ke tanaman yang sehat percikan air hujan yang disertai angin, lebih banyak terjadi serangan pada musim hujan (Saleh and Rahayuningsih, 2013)."@id ;
                                                                     rdfs:comment "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ,
                                                                                  "Sumber inokulum penyakit kudis biasanya berasal dari bahan tanam (setek) yang terinfeksi jamur, penyakit ini menyebar lebih cepat ke tanaman yang sehat percikan air hujan yang disertai angin, lebih banyak terjadi serangan pada musim hujan (Saleh and Rahayuningsih, 2013)."@id ;
                                                                     rdfs:label "Pengamatan gejala Penyakit kudis"@id ;
                                                                     skos:prefLabel "Pengamatan gejala Penyakit kudis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKudisUbiJalarKlorosisTanaman
ns1:PengamatanPenyakitKudisUbiJalarKlorosisTanaman rdf:type owl:NamedIndividual ,
                                                            ns1:Gejala ;
                                                   ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalarAwalnyaBerwarnaKuningCoklatKekuningan ;
                                                   ns1:memilikiGejalaKanonik ns1:KlorosisTanaman ;
                                                   ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                                   ns1:deskripsiGejala "Pada awalnya bercak berwarna kuning coklat kekuningan, coklat kemerahan dan akhirnya menjadi coklat kehitaman (Martanto, Tanati and Baan, 2016)."@id ;
                                                   rdfs:comment "Pada awalnya bercak berwarna kuning coklat kekuningan, coklat kemerahan dan akhirnya menjadi coklat kehitaman (Martanto, Tanati and Baan, 2016)."@id ,
                                                                "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
                                                   rdfs:label "Klorosis pada tanaman pada Penyakit kudis"@id ;
                                                   skos:prefLabel "Klorosis pada tanaman pada Penyakit kudis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKudisUbiJalarMartanto2010MenjelaskanBahwaMembentuk
ns1:PengamatanPenyakitKudisUbiJalarMartanto2010MenjelaskanBahwaMembentuk rdf:type owl:NamedIndividual ,
                                                                                  ns1:Gejala ;
                                                                         ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalarMartanto2010MenjelaskanBahwaMembentuk ;
                                                                         ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                                                         ns1:deskripsiGejala "Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar membentuk lapisan gabus untuk mempertahankan diri dari serangan penyakit kudis (Gambar 3A dan B)."@id ;
                                                                         rdfs:comment "Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar membentuk lapisan gabus untuk mempertahankan diri dari serangan penyakit kudis (Gambar 3A dan B)."@id ,
                                                                                      "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ;
                                                                         rdfs:label "Pengamatan gejala Penyakit kudis"@id ;
                                                                         skos:prefLabel "Pengamatan gejala Penyakit kudis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKudisUbiJalarMenjadiTidakProduktifFotosintesisTingkat
ns1:PengamatanPenyakitKudisUbiJalarMenjadiTidakProduktifFotosintesisTingkat rdf:type owl:NamedIndividual ,
                                                                                     ns1:GejalaDaun ;
                                                                            ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalarMenjadiTidakProduktifFotosintesisTingkat ;
                                                                            ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                                                            ns1:terdapatPada ns1:Daun ;
                                                                            ns1:deskripsiGejala "Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997)."@id ;
                                                                            rdfs:comment "Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997)."@id ,
                                                                                         "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ;
                                                                            rdfs:label "Pengamatan gejala Penyakit kudis"@id ;
                                                                            skos:prefLabel "Pengamatan gejala Penyakit kudis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKudisUbiJalarSelainFaktorLingkunganMemengaruhiPerubahan
ns1:PengamatanPenyakitKudisUbiJalarSelainFaktorLingkunganMemengaruhiPerubahan rdf:type owl:NamedIndividual ,
                                                                                       ns1:Gejala ;
                                                                              ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalarSelainFaktorLingkunganMemengaruhiPerubahan ;
                                                                              ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                                                              ns1:deskripsiGejala "Selain itu, faktor lingkungan juga memengaruhi perubahan ketahanan ubi jalar terhadap penyakit kudis (Roosda et al., 20013), sehingga kultivar yang tahan dapat berubah menjadi tidak tahan dan periode inkubasi juga memengaruhi munculnya gejala penyakit (Samiyarsih, Juwarno and Muljowati, 2018)."@id ;
                                                                              rdfs:comment "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ,
                                                                                           "Selain itu, faktor lingkungan juga memengaruhi perubahan ketahanan ubi jalar terhadap penyakit kudis (Roosda et al., 20013), sehingga kultivar yang tahan dapat berubah menjadi tidak tahan dan periode inkubasi juga memengaruhi munculnya gejala penyakit (Samiyarsih, Juwarno and Muljowati, 2018)."@id ;
                                                                              rdfs:label "Pengamatan gejala Penyakit kudis"@id ;
                                                                              skos:prefLabel "Pengamatan gejala Penyakit kudis"@id .


