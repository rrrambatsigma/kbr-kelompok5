###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#SapuSetanWitchesBroomUbiKayu
ns1:SapuSetanWitchesBroomUbiKayu rdf:type owl:NamedIndividual ,
                                          ns1:EntitasKBR ,
                                          ns1:Penyakit ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ns1:disebabkanOleh ;
                                            owl:someValuesFrom ns1:Fitoplasma
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ns1:memilikiGejala ;
                                            owl:someValuesFrom ns1:Gejala
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ns1:menyerangTanaman ;
                                            owl:someValuesFrom ns1:TanamanPangan
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ns1:disebabkanOleh ;
                                            owl:allValuesFrom ns1:Patogen
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ns1:memilikiReferensi ;
                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass ns1:Referensi
                                          ] ;
                                 ns1:didukungOleh ns1:BuktiMetadataEnglishSapuSetanWitchesBroomUbiKayu ,
                                                  ns1:BuktiPatogenSapuSetanWitchesBroomUbiKayu ,
                                                  ns1:BuktiPenyakitSapuSetanWitchesBroomUbiKayu ;
                                 ns1:dipengaruhiOleh ns1:MusimKemarauPadaSapuSetanWitchesBroomUbiKayu ;
                                 ns1:disebabkanOleh ns1:PatogenFitoplasma ;
                                 ns1:memilikiGejala ns1:GejalaSapuSetanWitchesBroomUbiKayuKerdilTanaman ;
                                 ns1:memilikiReferensi ns1:BukuDOC002 ;
                                 ns1:menyerangBagian ns1:Batang ;
                                 ns1:menyerangTanaman ns1:UbiKayu ;
                                 ns1:deskripsiPenyakit "Tanaman tumbuh kerdil (dwarf), ruas batang memendek, pada ujung tanaman tumbuh tunas yang banyak menyerupai sapu"@id ;
                                 ns1:identifierSumber "DIS_033" ;
                                 ns1:namaInggrisPenyakit "Witches broom" ;
                                 rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                              "Tanaman tumbuh kerdil (dwarf), ruas batang memendek, pada ujung tanaman tumbuh tunas yang banyak menyerupai sapu"@id ;
                                 rdfs:label "Sapu setan (Witches broom)"@id ;
                                 skos:prefLabel "Sapu setan (Witches broom)"@id .


