ns1:PenyakitLayuStewartJagung a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Layu Stewart"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianAplikasiDilakukanDenganPerendamanBenih_b96f0a77,
        ns1:PengendalianDjaenuddinDanMuis2018Mengatakan_8858881d,
        ns1:PengendalianHasilnyaMenunjukkanBahwaPerkembanganPenyakit_5fff7920,
        ns1:PengendalianIsolatYangTidakMenunjukkanReaksi_c33b65e5,
        ns1:PengendalianPengendalianPenyakitLayuStewartDapat_7560dba3,
        ns1:PengendalianRahmaEtAl2016Mengisolasi_9f6fe501,
        ns1:PengendalianRizobakteriaDikenalSebagaiBakteriYang_5ce32807,
        ns1:PengendalianSedangkanUntukAlternatifTerakhirMenggunakan_36ef8bcd,
        ns1:PengendalianSelainItuHarusMenggunakanBenih_534133fb,
        ns1:PengendalianSelainMenggunakanRizobakteriaRambeEt_945d52cf ;
    ns1:deskripsiPenyakit "Penyakit layu stewart disebabkan oleh bakteri Pantoea stewartii subsp. stewartii. Penyakit ini termasuk patogen tular benih. Pertama kali dilaporkan ada di Bogor, Indonesia oleh (Rahma et al., 2014) dengan kejadian penyakit antara 23.67% hingga 31.45%. Bakteri patogen P. stewartii termasuk bakteri gram negatif dan mempunyai koloni berwarna kuning, mengilat, cembung, berukuran 1-4 mm jika ditumbuhkan pada media TSA (Trypticase Soy Agar). Gejala layu stewart hampir mirip dengan penyakit bulai. Daun bergejala layu stewart berwarna hijau pucat hingga kekuningan dengan garis linier dengan tepi lurus maupun bergelombang yang sejajar tulang daun, layu dan kerdil (Rahma et al., 2014)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianAplikasiDilakukanDenganPerendamanBenih_b96f0a77,
