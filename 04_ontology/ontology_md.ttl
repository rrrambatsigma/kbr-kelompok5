    skos:prefLabel "Hawar daun"@id .

kbr:GejalaPenyakitHawarDaunJagungNekrosisDaun a kbr:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Nekrosis daun"@id ;
    kbr:deskripsiGejala "Selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan, infeksi lebih lanjut bercak akan melebar dan bergabung dengan bercak lain dan menyebabkan jaringan daun mengalami nekrosis."@id ;
    kbr:didukungOleh kbr:BuktiGejalaPenyakitHawarDaunJagung4 ;
    kbr:memilikiGejalaKanonik kbr:NekrosisDaun ;
