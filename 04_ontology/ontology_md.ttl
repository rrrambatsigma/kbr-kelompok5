kbr:GejalaPenyakitBercakKuningUbiJalarBelangTanaman a kbr:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Belang pada tanaman"@id ;
    kbr:deskripsiGejala "Penyakit bercak kuning pada ubi jalar disebabkan oleh Sweet Potato Feathery Mottle Virus (SPFMV) termasuk ke dalam genus Potyvirus, famili Potyviridae (Tugume, Mukasa and Valkonen, 2008)."@id ;
