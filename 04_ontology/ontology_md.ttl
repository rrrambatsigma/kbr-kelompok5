ns1:PenyakitRebahKecambahKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Rebah Kecambah"@id ;
    ns1:berkaitanPengendalian ns1:PengairanDanDrainase,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanFungisida,
        ns1:PenggunaanTrichoderma,
        ns1:PerlakuanBenih,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    ns1:deskripsiPenyakit "Penyakit rebah kecambah pada tanaman kedelai disebabkan oleh jamur Rhizoctonia solani. Patogen ini mampu menginfeksi tanaman kedelai sejak benih ditanam di lahan. Pada benih yang terinfeksi patogen R. solani maka benih tidak akan berkecambah atau mati. Akibatnya tanaman mati sebelum muncul pada permukaan tanah atau yang disebut dengan pre emergence damping off. Gejala yang muncul adalah benih membusuk akibat infeksi R. solani. Gejala yang muncul setelah benih tumbuh pada permukaan tanah kemudian tanaman mati akibat pangkal batang pada permukaan tanah terdapat bercak coklat akibat terinfeksi patogen (post emergence damping off)."@id ;
    ns1:didukungOleh ns1:BuktiLingkunganPenyakitRebahKecambahKedelaiSolaniDilakukanTeknikPengendalianKultur,
        ns1:BuktiPatogenPenyakitRebahKecambahKedelaiRebahKecambahDisebabkanRhizoctoniaSolani,
        ns1:BuktiPengendalianPenyakitRebahKecambahKedelaiAplikasiRizobakteriPemacuTumbuhMenekan,
        ns1:BuktiPengendalianPenyakitRebahKecambahKedelaiFajarfika2021PerlakuanBenihFungisida,
        ns1:BuktiPengendalianPenyakitRebahKecambahKedelaiInayatiAndYusnawan2017Pengendalian,
        ns1:BuktiPengendalianPenyakitRebahKecambahKedelaiPenggunaanAgensHayatiAntagonisBacillus,
        ns1:BuktiPengendalianPenyakitRebahKecambahKedelaiSolaniDilakukanTeknikPengendalianKultur,
        ns1:BuktiPenyakitPenyakitRebahKecambahKedelaiRebahKecambah ;
    ns1:dikendalikanDengan ns1:PengairanDanDrainase,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanFungisida,
        ns1:PenggunaanTrichoderma,
        ns1:PerlakuanBenih,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:KondisiMusimHujan ;
    ns1:disebabkanOleh ns1:RhizoctoniaSolani ;
    ns1:identifierSumber "DIS_007" ;
    ns1:memilikiGejala ns1:PengamatanPenyakitRebahKecambahKedelaiAkibatnyaMatiMunculPermukaanPre,
        ns1:PengamatanPenyakitRebahKecambahKedelaiBusukAkar,
        ns1:PengamatanPenyakitRebahKecambahKedelaiBusukBatang,
        ns1:PengamatanPenyakitRebahKecambahKedelaiLayuDaun,
        ns1:PengamatanPenyakitRebahKecambahKedelaiMunculBenihMembusukAkibatR,
        ns1:PengamatanPenyakitRebahKecambahKedelaiMunculSetelahBenihTumbuhPermukaan,
        ns1:PengamatanPenyakitRebahKecambahKedelaiSolaniMakaBenihTidakBerkecambah,
        ns1:PengamatanPenyakitRebahKecambahKedelaiSolaniMenunjukkanAdanyaLekukanCoklat ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangTanaman ns1:Kedelai ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit rebah kecambah pada tanaman kedelai disebabkan oleh jamur Rhizoctonia solani. Patogen ini mampu menginfeksi tanaman kedelai sejak benih ditanam di lahan. Pada benih yang terinfeksi patogen R. solani maka benih tidak akan berkecambah atau mati. Akibatnya tanaman mati sebelum muncul pada permukaan tanah atau yang disebut dengan pre emergence damping off. Gejala yang muncul adalah benih membusuk akibat infeksi R. solani. Gejala yang muncul setelah benih tumbuh pada permukaan tanah kemudian tanaman mati akibat pangkal batang pada permukaan tanah terdapat bercak coklat akibat terinfeksi patogen (post emergence damping off)."@id ;
    skos:prefLabel "Penyakit Rebah Kecambah"@id .

ns1:PenyakitKaratDaunJagung a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Karat Daun"@id ;
