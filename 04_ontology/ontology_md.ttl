ns1:CurahHujan a owl:Class ;
    rdfs:label "Curah Hujan"@id ;
    rdfs:comment "Faktor curah hujan."@id,
        "Pengendalian patogen Fusarium spp. dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017)."@id ;
    rdfs:subClassOf ns1:FaktorLingkungan ;
    skos:prefLabel "Curah Hujan"@id .

ns1:FaktorLahan a owl:Class ;
    rdfs:label "Faktor Lahan"@id ;
    rdfs:comment "Faktor kondisi lahan."@id,
        "Perkembangan penyakit bakteri pustul dipengaruhi oleh faktor suhu dan kelembaban di lahan."@id ;
    rdfs:subClassOf ns1:FaktorRisiko ;
    skos:prefLabel "Faktor Lahan"@id .

ns1:FasePanen a owl:Class ;
    rdfs:label "Fase Panen"@id ;
    rdfs:comment "Fase menjelang atau saat panen."@id,
        "Patogen dapat menginfeksi dari fase pembibitan hingga panen dan menyebabkan kehilangan hasil mencapai 50-70% (Majid, 2016)."@id ;
    rdfs:subClassOf ns1:FasePertumbuhan ;
    skos:prefLabel "Fase Panen"@id .

ns1:FasePembibitan a owl:Class ;
    rdfs:label "Fase Pembibitan"@id ;
    rdfs:comment "Adanya patogen tular tanah yang menginfeksi tanaman pada fase pembibitan menjadi permasalahan utama."@id,
        "Fase pembibitan."@id ;
    rdfs:subClassOf ns1:FasePertumbuhan ;
    skos:prefLabel "Fase Pembibitan"@id .

ns1:GejalaBiji a owl:Class ;
    rdfs:label "Gejala Biji"@id ;
    rdfs:comment "Gejala lanjut pada daun dapat menyebabkan bentuk dan warna daun tidak normal, biji mengalami distorsi, perubahan warna dan lesi, pada batang akan nampak gejala dieback, kerdil dan roset, sedangkan pada keseluruhan tanaman menjadi kerdil."@id,
        "Gejala yang diamati pada biji."@id ;
    rdfs:subClassOf ns1:Gejala ;
    skos:prefLabel "Gejala Biji"@id .

ns1:HawarDaun a ns1:GejalaKanonik,
        owl:NamedIndividual ;
    rdfs:label "Hawar daun"@id ;
    ns1:kodeGejala "HawarDaun" ;
    ns1:merupakanKanonikDari ns1:GejalaHawarDaunBakteriUbiKayuHawarDaun,
        ns1:GejalaPenyakitBercakBijiUnguKedelaiHawarDaun,
        ns1:GejalaPenyakitHawarDaunBakteriPadiHawarDaun,
        ns1:GejalaPenyakitHawarDaunJagungHawarDaun ;
    rdfs:comment "Konsep kanonik untuk gejala hawar pada daun atau pelepah."@id ;
    skos:altLabel "hawar daun"@id ;
    skos:prefLabel "Hawar daun"@id .

ns1:KondisiTanah a owl:Class ;
    rdfs:label "Kondisi Tanah"@id ;
    rdfs:comment "Faktor kondisi tanah."@id,
        "Pada kondisi lembab jamur S. rolfsii dapat berkembang dan menginfeksi bagian daun dan batang tanaman yang berada di dekat tanah."@id ;
    rdfs:subClassOf ns1:FaktorLahan ;
    skos:prefLabel "Kondisi Tanah"@id .

ns1:KulturMeristem a ns1:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Kultur meristem"@id ;
    ns1:deskripsiPengendalian "Benih sehat bebas virus merupakan awal dari budidaya tanaman sehat bebas virus PStV."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitBelangMottleKacangTanah8,
        ns1:BuktiPengendalianPenyakitBercakKuningUbiJalar,
        ns1:BuktiPengendalianPenyakitBercakKuningUbiJalar2 ;
    ns1:mengendalikanPenyakit ns1:PenyakitBelangMottleKacangTanah,
        ns1:PenyakitBercakKuningUbiJalar ;
    ns1:namaPengendalian "Kultur meristem"@id ;
    rdfs:comment "Benih sehat bebas virus merupakan awal dari budidaya tanaman sehat bebas virus PStV."@id,
        "Tindakan kanonik perbanyakan jaringan meristem untuk memperoleh bahan tanam bebas virus."@id ;
    skos:prefLabel "Kultur meristem"@id .

ns1:Legum a owl:Class ;
    rdfs:label "Legum"@id ;
    rdfs:comment "Hal ini karena patogen *S. rolfsii* memiliki kisaran inang yang luas seperti famili *leguminoceae*, *Cruciferaceae*, *Cucurbitaceae*, tanaman pisang, jeruk, gandum, padi, tebu, bit, keladi, bahkan tanaman rempah (Sumartini, 2012)."@id,
        "Kelompok tanaman pangan legum dalam ruang lingkup."@id ;
    rdfs:subClassOf ns1:TanamanPangan ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:Kedelai ns1:KacangTanah ns1:KacangHijau ) ] ;
    skos:prefLabel "Legum"@id .

ns1:Oomycete a owl:Class ;
    rdfs:label "Oomycete"@id ;
    rdfs:comment "Patogen kelompok oomycete."@id ;
    rdfs:subClassOf ns1:Patogen ;
    skos:prefLabel "Oomycete"@id .

ns1:PenerapanPengendalianKimiawi a ns1:PengendalianKimiawi,
        owl:NamedIndividual ;
    rdfs:label "Penerapan pengendalian kimiawi"@id ;
    ns1:deskripsiPengendalian "Pengendalian kimia yaitu upaya pengendalian patogen dengan pestisida sintetis."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitBercakDaunKacangTanah19,
        ns1:BuktiPengendalianPenyakitBercakDaunKacangTanah28,
        ns1:BuktiPengendalianPenyakitBercakDaunKacangTanah30,
        ns1:BuktiPengendalianPenyakitBercakDaunKacangTanah31,
        ns1:BuktiPengendalianPenyakitBercakDaunKacangTanah32,
        ns1:BuktiPengendalianPenyakitBercakDaunKacangTanah35,
        ns1:BuktiPengendalianPenyakitBercakDaunKacangTanah8,
        ns1:BuktiPengendalianPenyakitBercakDaunKacangTanah9,
        ns1:BuktiPengendalianUmumKacangTanah10,
        ns1:BuktiPengendalianUmumKacangTanah19,
        ns1:BuktiPengendalianUmumKacangTanah21,
        ns1:BuktiPengendalianUmumKacangTanah22,
        ns1:BuktiPengendalianUmumKacangTanah23,
        ns1:BuktiPengendalianUmumKacangTanah26 ;
    ns1:mengendalikanPenyakit ns1:PenyakitBercakDaunKacangTanah ;
    ns1:namaPengendalian "Penerapan pengendalian kimiawi"@id ;
    rdfs:comment "Pengendalian kimia yaitu upaya pengendalian patogen dengan pestisida sintetis."@id,
        "Tindakan kanonik penerapan pengendalian kimiawi secara umum."@id ;
    skos:prefLabel "Penerapan pengendalian kimiawi"@id .

ns1:PengaturanKelembapan a ns1:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Pengaturan kelembapan"@id ;
    ns1:deskripsiPengendalian "Upaya pengendalian karat jagung dapat dilakukan dengan beberapa cara seperti jarak tanam yang tidak terlalu rapat dan penyiangan gulma rutin sehingga sirkulasi udara lebih baik dan kelembaban tidak terlalu tinggi."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitBercakDaunKacangHijau3,
        ns1:BuktiPengendalianPenyakitKaratDaunJagung2 ;
    ns1:mengendalikanPenyakit ns1:PenyakitBercakDaunKacangHijau,
        ns1:PenyakitKaratDaunJagung ;
    ns1:namaPengendalian "Pengaturan kelembapan"@id ;
    rdfs:comment "Tindakan kanonik pengaturan kelembapan dan sirkulasi udara."@id,
        "Upaya pengendalian karat jagung dapat dilakukan dengan beberapa cara seperti jarak tanam yang tidak terlalu rapat dan penyiangan gulma rutin sehingga sirkulasi udara lebih baik dan kelembaban tidak terlalu tinggi."@id ;
    skos:prefLabel "Pengaturan kelembapan"@id .

ns1:PenggunaanBeauveria a ns1:PengendalianBiologis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan Beauveria"@id ;
    ns1:deskripsiPengendalian "Pengendalian wereng coklat dapat dengan penggunaan cendawan entomopatogen seperti Metarhizium dan Beauveria."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitKerdilRumputDanKerdilHampaPadi3,
        ns1:BuktiPengendalianPenyakitRebahSemaiKedelai13 ;
    ns1:mengendalikanPenyakit ns1:PenyakitKerdilRumputDanKerdilHampaPadi,
        ns1:PenyakitRebahSemaiKedelai ;
    ns1:namaPengendalian "Penggunaan Beauveria"@id ;
    rdfs:comment "Pengendalian wereng coklat dapat dengan penggunaan cendawan entomopatogen seperti Metarhizium dan Beauveria."@id,
        "Tindakan kanonik penggunaan Beauveria."@id ;
    skos:prefLabel "Penggunaan Beauveria"@id .

ns1:PenggunaanBiopestisida a ns1:PengendalianBiologis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan biopestisida"@id ;
    ns1:deskripsiPengendalian "Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitLayuBakteriKacangTanah3,
        ns1:BuktiPengendalianUmumKacangTanah28 ;
    ns1:mengendalikanPenyakit ns1:PenyakitLayuBakteriKacangTanah ;
    ns1:namaPengendalian "Penggunaan biopestisida"@id ;
    rdfs:comment "Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati."@id,
        "Tindakan kanonik penggunaan biopestisida."@id ;
    skos:prefLabel "Penggunaan biopestisida"@id .

ns1:PenggunaanHerbisida a ns1:PengendalianKimiawi,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan herbisida"@id ;
    ns1:deskripsiPengendalian "Pestisida digolongkan menjadi beberapa macam di antaranya insektisida, fungisida, herbisida, rodentisida, dan nematosida."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitBercakDaunKacangTanah29,
        ns1:BuktiPengendalianUmumKacangTanah20 ;
    ns1:mengendalikanPenyakit ns1:PenyakitBercakDaunKacangTanah ;
    ns1:namaPengendalian "Penggunaan herbisida"@id ;
    rdfs:comment "Pestisida digolongkan menjadi beberapa macam di antaranya insektisida, fungisida, herbisida, rodentisida, dan nematosida."@id,
        "Tindakan kanonik penggunaan herbisida."@id ;
    skos:prefLabel "Penggunaan herbisida"@id .

ns1:PenggunaanMetarhizium a ns1:PengendalianBiologis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan Metarhizium"@id ;
    ns1:deskripsiPengendalian "Selain itu dapat juga diaplikasikan cendawan entomopatogen seperti Metarhizium dan Beuveria."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitKerdilRumputDanKerdilHampaPadi3,
        ns1:BuktiPengendalianPenyakitTungroPadi3 ;
    ns1:mengendalikanPenyakit ns1:PenyakitKerdilRumputDanKerdilHampaPadi,
        ns1:PenyakitTungroPadi ;
    ns1:namaPengendalian "Penggunaan Metarhizium"@id ;
    rdfs:comment "Selain itu dapat juga diaplikasikan cendawan entomopatogen seperti Metarhizium dan Beuveria."@id,
        "Tindakan kanonik penggunaan Metarhizium."@id ;
    skos:prefLabel "Penggunaan Metarhizium"@id .

ns1:SclerotiumRolfsii a ns1:Jamur,
        owl:NamedIndividual ;
    rdfs:label "Sclerotium rolfsii"@id ;
    ns1:didukungOleh ns1:BuktiPatogenBusukAkarDanUmbiUbiKayu3,
        ns1:BuktiPatogenBusukPangkalBatangUbiKayu4,
        ns1:BuktiPatogenPenyakitLayuKacangHijau,
        ns1:BuktiPatogenPenyakitRebahSemaiKedelai ;
    ns1:identifierSumber "PAT_008" ;
    ns1:menyebabkanPenyakit ns1:BusukAkarDanUmbiUbiKayu,
        ns1:BusukPangkalBatangUbiKayu,
        ns1:PenyakitLayuKacangHijau,
        ns1:PenyakitRebahSemaiKedelai ;
    ns1:namaIlmiahPatogen "Sclerotium rolfsii" ;
    rdfs:comment "Patogen yang tercatat pada sumber."@id ;
    skos:prefLabel "Sclerotium rolfsii"@id .

ns1:SeleksiBahanTanam a ns1:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Seleksi bahan tanam"@id ;
    ns1:deskripsiPengendalian "Pengendalian yang dapat dilakukan dengan cara menggunakan varietas tahan, menggunakan bibit, setek atau bahan tanam yang bebas virus, rotasi tanaman, sanitasi dan eradikasi tanaman, serta mengendalikan serangga vektor (Saleh et al., 2015)."@id ;
