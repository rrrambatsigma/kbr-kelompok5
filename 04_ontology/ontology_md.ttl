                                                      ns1:didukungOleh ns1:BuktiPatogenPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelaiMataKatakFrogeyeLeafSpot ,
                                                                       ns1:BuktiPengendalianPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelaiInayatiAndYusnawan2017Pengendalian ,
                                                                       ns1:BuktiPengendalianPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelaiPengendalianDilakukanC ,
