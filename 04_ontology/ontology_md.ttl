        ns1:PenyakitBakteriPustulKedelai,
        ns1:PenyakitBelangMottleKacangTanah,
        ns1:PenyakitBercakTargetKedelai,
        ns1:PenyakitBlasPadi,
        ns1:PenyakitEmbunPalsuDownyMildewKedelai,
        ns1:PenyakitHawarDaunBakteriPadi,
        ns1:PenyakitKerdilKedelaiSoybeanStuntVirusKedelai,
        ns1:PenyakitLayuBakteriKacangTanah,
        ns1:PenyakitLayuStewartJagung ;
    ns1:namaPengendalian "Penggunaan benih sehat"@id ;
    rdfs:comment "Penggunaan benih sehat yang bebas penyakit, dapat pula dilakukan perlakuan benih dengan larutan amonium sulfat maupun larutan garam untuk memisahkan benih yang cukup matang kemudian dilanjutkan dengan desinfeksi benih dengan fungisida Praktik budidaya diperhatikan untuk mencegah padi terinfeksi blas seperti pengaturan pengairan supaya tidak terjadi kekeringan karena padi rentan blas saat kekeringan."@id,
        "Tindakan kanonik penggunaan benih sehat atau bersertifikat."@id ;
    skos:prefLabel "Penggunaan benih sehat"@id .

ns1:PenyakitTungroPadi a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Tungro"@id ;
    ns1:berkaitanPengendalian ns1:PengaturanWaktuTanam,
        ns1:PengelolaanGulma,
        ns1:PengendalianVektor,
        ns1:PenggunaanMetarhizium,
        ns1:PenggunaanVarietasTahan,
        ns1:PengumpulanDanPemusnahan,
        ns1:SanitasiLahan ;
    ns1:deskripsiPenyakit "Asal kata tungro pada nama penyakit ini berasal dari bahasa Tagalog, Filipina yang mempunyai arti pertumbuhan yang terhambat. Meskipun sudah menjadi nama penyakit yang resmi dan berlaku di Indonesia. Penyakit ini juga mempunyai nama lokal di negara lain maupun di wilayah lain di Indonesia, seperti di Malaysia disebut dengan penyakit merah, di Thailand disebut yellow orange leaf disease, di Kalimantan Selatan disebut penyakit habang, di Sulawesi Selatan disebut penyakit cella pance, dan di Bali disebut penyakit kebebeng (Muhsin dan Widiarta 2009). Oleh karena itu, penyebaran penyakit sangat luas dengan luas serangan mencapai 3.650 ha per tahun di Indonesia pada periode 2001-2006 (Kusprayogie et al. 2001)"@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitTungroPadi,
        ns1:BuktiPatogenPenyakitTungroPadi2,
        ns1:BuktiPengendalianPenyakitTungroPadi,
        ns1:BuktiPengendalianPenyakitTungroPadi2,
        ns1:BuktiPengendalianPenyakitTungroPadi3,
        ns1:BuktiPengendalianPenyakitTungroPadi4,
        ns1:BuktiPenyakitPenyakitTungroPadi ;
    ns1:dikendalikanDengan ns1:PengaturanWaktuTanam,
        ns1:PengelolaanGulma,
        ns1:PengendalianVektor,
        ns1:PenggunaanMetarhizium,
        ns1:PenggunaanVarietasTahan,
        ns1:PengumpulanDanPemusnahan,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:MusimHujanPadaPenyakitTungroPadi ;
    ns1:disebabkanOleh ns1:RiceTungroBacilliforVirus,
        ns1:RiceTungroSphericalVirus ;
    ns1:identifierSumber "DIS_004" ;
    ns1:memilikiGejala ns1:GejalaPenyakitTungroPadiBercakTanaman,
        ns1:GejalaPenyakitTungroPadiKerdilTanaman,
        ns1:GejalaPenyakitTungroPadiKlorosisDaun,
        ns1:GejalaPenyakitTungroPadiPertumbuhanTerhambat ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Batang,
        ns1:Daun,
        ns1:Malai ;
    ns1:menyerangTanaman ns1:Padi ;
    rdfs:comment "Asal kata tungro pada nama penyakit ini berasal dari bahasa Tagalog, Filipina yang mempunyai arti pertumbuhan yang terhambat. Meskipun sudah menjadi nama penyakit yang resmi dan berlaku di Indonesia. Penyakit ini juga mempunyai nama lokal di negara lain maupun di wilayah lain di Indonesia, seperti di Malaysia disebut dengan penyakit merah, di Thailand disebut yellow orange leaf disease, di Kalimantan Selatan disebut penyakit habang, di Sulawesi Selatan disebut penyakit cella pance, dan di Bali disebut penyakit kebebeng (Muhsin dan Widiarta 2009). Oleh karena itu, penyebaran penyakit sangat luas dengan luas serangan mencapai 3.650 ha per tahun di Indonesia pada periode 2001-2006 (Kusprayogie et al. 2001)"@id,
        "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ;
    skos:prefLabel "Penyakit Tungro"@id .

ns1:p a ns2:Variable .

ns1:Akar a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Akar"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id,
        "Tanaman akan layu akibat akar tanaman busuk dan terinfeksi patogen kemudian menyebar pada pangkal batang sehingga menyebabkan rebah semai atau rebah kecambah (Gambar 2.3) (Hidayah and Yulianti, 2015)."@id ;
    skos:prefLabel "Akar"@id .

ns1:FasePertumbuhan a owl:Class ;
    rdfs:label "Fase Pertumbuhan"@id ;
    rdfs:comment "Biasanya cendawan C. arachidicola menginfeksi kacang tanah pada fase pertumbuhan yang lebih awal daripada C. personata."@id,
        "Fase pertumbuhan tanaman."@id ;
    rdfs:subClassOf ns1:EntitasKBR ;
    owl:disjointWith ns1:BagianTanaman,
        ns1:BuktiSumber,
        ns1:Diagnosis,
        ns1:FaktorRisiko,
        ns1:Gejala,
        ns1:GejalaKanonik,
        ns1:Observasi,
        ns1:Patogen,
        ns1:Pengendalian,
        ns1:Penyakit,
        ns1:Referensi,
        ns1:TanamanPangan,
        ns1:Varietas ;
    skos:prefLabel "Fase Pertumbuhan"@id .

ns1:PengendalianKulturTeknis a owl:Class ;
    rdfs:label "Pengendalian Kultur Teknis"@id ;
    rdfs:comment "Menurut Inayati and Yusnawan, (2017) pengendalian penyakit yang disebabkan oleh R. solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian"@id,
        "Pengendalian melalui praktik budidaya."@id ;
    rdfs:subClassOf ns1:Pengendalian ;
    skos:prefLabel "Pengendalian Kultur Teknis"@id .

ns1:PenyakitBelangMottleKacangTanah a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Belang (Mottle)"@id ;
    ns1:berkaitanPengendalian ns1:KulturMeristem,
        ns1:PemupukanBerimbang,
        ns1:PengaturanWaktuTanam,
        ns1:PengendalianVektor,
        ns1:PenggunaanBenihSehat,
        ns1:PenggunaanInsektisida,
        ns1:PenggunaanMulsa,
        ns1:PenggunaanVarietasTahan,
        ns1:RotasiTanaman ;
    ns1:deskripsiPenyakit "Penyakit belang merupakan penyakit yang disebabkan oleh virus. Virus yang menyerang yaitu Peanut mottle virus (PeMoV) maupun Peanut stripe virus (PStV). Serangga vektor yang membawa virus menginfeksi tanaman kacang tanah adalah Aphids sp. Aphis dengan tipe mulut mencucuk menghisap merupakan vektor PStV yang efisien. Silet Aphis dalam waktu singkat dapat menghisap cairan daun yang berada di jaringan epidermis dan endodermis. Ukuran tubuh yang kecil dan ringan menyebabkan penyebaran hama ini terjadi secara pasif dengan bantuan angin. Secara alami, penyebaran Aphis dapat mencapai 50-100."@id ;
    ns1:didukungOleh ns1:BuktiLingkunganPenyakitBelangMottleKacangTanah,
        ns1:BuktiPatogenPenyakitBelangMottleKacangTanah,
