        ns1:BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai6,
        ns1:BuktiPengendalianPenyakitHawarDaunBakteriPadi6,
        ns1:BuktiPengendalianPenyakitHawarDaunBakteriPadi7,
        ns1:BuktiPengendalianPenyakitKerdilKedelaiSoybeanStuntVirusKedel,
        ns1:BuktiPengendalianPenyakitLayuFusariumKedelai,
        ns1:BuktiPengendalianPenyakitLayuStewartJagung,
        ns1:BuktiPengendalianPenyakitLayuStewartJagung6,
        ns1:BuktiPengendalianPenyakitRebahKecambahKedelai3 ;
    ns1:mengendalikanPenyakit ns1:PenyakitAntraknosaKedelai,
        ns1:PenyakitBercakBijiUnguKedelai,
