    ns1:halamanSumber "34" ;
    ns1:idChunkSumber "DOC002_C034_02" ;
    ns1:identifierSumber "CTL_021" ;
    ns1:kutipanNormalisasi "Berbagai strategi pengendalian penyakit tungro dijelaskan sebagai berikut meliputi pemusnahan tanaman terinfeksi, penggunaan varietas tahan seperti Tukad Unda, Tukad Balian, Kalimas, dan Bondoyudo, penanaman serempak minimal 20 ha luasan sawah, serta penanaman sebelum puncak kepadatan wereng hijau (Puslitbangtan 2005)."@id ;
    ns1:kutipanSumber "Berbagai strategi pengendalian penyakit tungro dijelaskan sebagai berikut meliputi pemusnahan tanaman terinfeksi, penggunaan varietas tahan seperti Tukad Unda, Tukad Balian, Kalimas, dan Bondoyudo, penanaman serempak minimal 20 ha luasan sawah, serta penanaman sebelum puncak kepadatan wereng hijau (Puslitbangtan 2005)."@id ;
    rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
    skos:prefLabel "Bukti varietas Penyakit Tungro"@id ;
    prov:wasDerivedFrom ns1:BukuDOC002 .

