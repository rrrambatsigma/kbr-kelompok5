                                    ns1:BuktiPengendalianPenyakitBercakDaunMataKatakFrogeyeLeafSpot4 ,
                                    ns1:BuktiPengendalianPenyakitBlasPadi4 ,
                                    ns1:BuktiPengendalianPenyakitEmbunPalsuDownyMildewKedelai4 ,
                                    ns1:BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai6 ,
