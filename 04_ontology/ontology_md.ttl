    skos:prefLabel "Musim hujan"@id .

ns1:Musim a owl:Class ;
    rdfs:label "Musim"@id ;
    rdfs:comment "Faktor musim."@id,
        "Lebih lanjut Saleh dan Hardaningsih (1997) menyatakan bahwa pengendalian penyakit bercak daun dan karat dengan tiofanat metil pada kacang tanah yang tahan cukup dua kali dalam musim yaitu pada umur 49 dan 63 hari, sedangkan untuk yang rentan penyemprotan dilakukan setidaknya empat kali."@id ;
    rdfs:subClassOf ns1:FaktorLingkungan ;
    skos:prefLabel "Musim"@id .

ns1:PengendalianKimiawi a owl:Class ;
    rdfs:label "Pengendalian Kimiawi"@id ;
    rdfs:comment "Pengendalian dengan bahan kimia atau pestisida."@id,
        "Pengendalian kimiawi dengan fungisida berbahan aktif risiklikol, pyroquilon, iprobenfos, benomyl, isoprothiolane, diclocymet, edifenphos, felimzone, probenazole, karpropamid, fenoxanil dan metominostrobin, dan antibiotik seperti blasticidin, kasugamycin dan dipotassium hidrogen fosfat (DHP) telah dilaporkan dapat mengurangi keparahan penyakit blas."@id ;
    rdfs:subClassOf ns1:Pengendalian ;
    skos:prefLabel "Pengendalian Kimiawi"@id .

ns1:Pucuk a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Pucuk"@id ;
    ns1:bagianDari ns1:Batang ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id,
        "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
    skos:prefLabel "Pucuk"@id .

ns1:Umbi a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Umbi"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id,
        "Selain itu, kerusakan daun akibat serangan penyakit dapat menyebabkan penurunan aktivitas fotosintesis yang dapat berakibat pada penurunan hasil dan kualitas umbi akar."@id ;
    skos:prefLabel "Umbi"@id .

ns1:FaktorLingkungan a owl:Class ;
    rdfs:label "Faktor Lingkungan"@id ;
    rdfs:comment "Faktor lingkungan abiotik atau iklim."@id,
        "Selain faktor lingkungan yang menjadi pembatas produksi kedelai, faktor biotik seperti patogen juga menjadi salah satu pembatas menurunnya produksi kedelai."@id ;
    rdfs:subClassOf ns1:FaktorRisiko ;
    skos:prefLabel "Faktor Lingkungan"@id .

ns1:KelembapanTanah a owl:Class ;
    rdfs:label "Kelembapan Tanah"@id ;
    rdfs:comment "Faktor kelembapan tanah."@id,
        "Kelembapan tanah juga mempengaruhi kejadian penyakit di lapang."@id ;
    rdfs:subClassOf ns1:FaktorLingkungan ;
    skos:prefLabel "Kelembapan Tanah"@id .

ns1:KondisiIklimBasah a ns1:Iklim,
        owl:NamedIndividual ;
    rdfs:label "Iklim basah"@id ;
    rdfs:comment "Kategori faktor lingkungan untuk iklim basah."@id .

ns1:PengaturanJarakTanam a ns1:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Pengaturan jarak tanam"@id ;
    ns1:deskripsiPengendalian "Beberapa pengendalian penyakit hawar daun bakteri pada padi, di antaranya Kultur teknis, melalui pengaturan jarak tanam tidak terlalu rapat, pengeringan sawah beberapa hari pada saat anakan maksimum, pemusnahan atau pengomposan sisa-sisa tanaman yang terinfeksi (Puslitbangtan 2005)."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitBercakDaunKacangHijau3,
        ns1:BuktiPengendalianPenyakitHawarPelepahDaunPadi,
        ns1:BuktiPengendalianPenyakitKaratDaunJagung2,
        ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottle3,
        ns1:BuktiPengendalianUmumUbiKayu3 ;
    ns1:mengendalikanPenyakit ns1:PenyakitBercakDaunKacangHijau,
        ns1:PenyakitHawarPelepahDaunPadi,
        ns1:PenyakitKaratDaunJagung,
        ns1:PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai ;
    ns1:namaPengendalian "Pengaturan jarak tanam"@id ;
    rdfs:comment "Beberapa pengendalian penyakit hawar daun bakteri pada padi, di antaranya Kultur teknis, melalui pengaturan jarak tanam tidak terlalu rapat, pengeringan sawah beberapa hari pada saat anakan maksimum, pemusnahan atau pengomposan sisa-sisa tanaman yang terinfeksi (Puslitbangtan 2005)."@id,
        "Tindakan kanonik pengaturan jarak atau kerapatan tanam."@id ;
    skos:prefLabel "Pengaturan jarak tanam"@id .

ns1:PengendalianBiologis a owl:Class ;
    rdfs:label "Pengendalian Biologis"@id ;
    rdfs:comment "Pengendalian dengan agens hayati atau biopestisida."@id ;
    rdfs:subClassOf ns1:Pengendalian ;
    skos:prefLabel "Pengendalian Biologis"@id .

