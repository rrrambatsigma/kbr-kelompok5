                                  ns1:dipengaruhiOleh ns1:KelembapanRelatifDiAtas90PersenPadaPenyakitBercakDaunKacangTanah ,
                                                      ns1:SuhuPadaPenyakitBercakDaunKacangTanah ;
                                  ns1:disebabkanOleh ns1:CercosporaArachidicola ,
                                                     ns1:CercosporaPersonata ,
                                                     ns1:PucciniaArachidis ;
                                  ns1:memilikiGejala ns1:PengamatanPenyakitBercakDaunKacangTanahBerbedaBedaTergantungSpesiesPatogennya ,
                                                     ns1:PengamatanPenyakitBercakDaunKacangTanahBercakDaun ,
                                                     ns1:PengamatanPenyakitBercakDaunKacangTanahBercakTanaman ,
                                                     ns1:PengamatanPenyakitBercakDaunKacangTanahBerdampakPenguranganJumlahPolongBerat ,
                                                     ns1:PengamatanPenyakitBercakDaunKacangTanahDaunBerlubang ,
                                                     ns1:PengamatanPenyakitBercakDaunKacangTanahDaunKering ,
