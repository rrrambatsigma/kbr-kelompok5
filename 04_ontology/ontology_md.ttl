        owl:NamedIndividual ;
    rdfs:label "Busuk pangkal batang"@id ;
    ns1:deskripsiPenyakit "Infeksi patogen pada bagian batang dekat permukaan tanah (pangkal batang), dan menyebabkan pangkal batang membusuk sehingga tanaman layu."@id ;
