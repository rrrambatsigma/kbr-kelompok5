    ns1:menyerangTanaman ns1:Kedelai .

ns1:PenyakitKaratDaunJagung a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Karat Daun"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianSelainItuPenggunaanVarietasTahan_1ab06ea2,
