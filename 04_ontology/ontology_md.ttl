    rdfs:comment "Kemudian penanaman lebih awal selama musim hujan."@id,
        "Tindakan kanonik pengaturan waktu atau keserempakan tanam."@id ;
    skos:prefLabel "Pengaturan waktu tanam"@id .

ns1:PengumpulanDanPemusnahan a ns1:PengendalianMekanis,
        owl:NamedIndividual ;
    rdfs:label "Pengumpulan dan pemusnahan"@id ;
    ns1:deskripsiPengendalian "Jerami dan sisa tunggul dari padi yang terinfeksi dibakar atau dikomposkan untuk mencegah adanya sumber inokulum bagi musim berikutnya."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitBlasPadi3,
        ns1:BuktiPengendalianPenyakitHawarPelepahDaunPadi,
        ns1:BuktiPengendalianPenyakitTungroPadi,
        ns1:BuktiPengendalianUmumUbiKayu4 ;
    ns1:mengendalikanPenyakit ns1:PenyakitBlasPadi,
        ns1:PenyakitHawarPelepahDaunPadi,
        ns1:PenyakitTungroPadi ;
    ns1:namaPengendalian "Pengumpulan dan pemusnahan"@id ;
    rdfs:comment "Jerami dan sisa tunggul dari padi yang terinfeksi dibakar atau dikomposkan untuk mencegah adanya sumber inokulum bagi musim berikutnya."@id,
        "Tindakan kanonik pengumpulan dan pemusnahan bagian tanaman terserang."@id ;
    skos:prefLabel "Pengumpulan dan pemusnahan"@id .

ns1:PenyakitBusukPelepahJagung a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Busuk Pelepah"@id ;
    ns1:berkaitanPengendalian ns1:PenggunaanBacillus ;
    ns1:deskripsiPenyakit "Penyakit busuk pelepah disebabkan oleh jamur patogen Rhizoctonia solani. Patogen ini termasuk soil borne yang artinya merupakan patogen tular tanah sehingga dapat bertahan di tanah dan juga sisa tanaman dalam bentuk sklerotium. Sklerotium merupakan massa hifa yang mengumpul dan memadat yang awalnya berwarna putih dan kemudian berubah menjadi berwarna coklat. Jamur ini mempunyai banyak inang alternatif seperti tanaman kacang tanah, kedelai, kacang hijau dan sorgum (Soenartiningsih et al., 2015)."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitBusukPelepahJagung,
        ns1:BuktiPengendalianPenyakitBusukPelepahJagung,
        ns1:BuktiPenyakitPenyakitBusukPelepahJagung ;
    ns1:dikendalikanDengan ns1:PenggunaanBacillus ;
    ns1:dipengaruhiOleh ns1:KelembapanTinggiPadaPenyakitBusukPelepahJagung,
        ns1:SuhuMinimal30CPadaPenyakitBusukPelepahJagung ;
    ns1:disebabkanOleh ns1:RhizoctoniaSolani ;
    ns1:identifierSumber "DIS_048" ;
    ns1:memilikiGejala ns1:GejalaPenyakitBusukPelepahJagungBercakTanaman,
        ns1:GejalaPenyakitBusukPelepahJagungBusukBatang ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Batang,
        ns1:Buah,
        ns1:Daun ;
    ns1:menyerangTanaman ns1:Jagung ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit busuk pelepah disebabkan oleh jamur patogen Rhizoctonia solani. Patogen ini termasuk soil borne yang artinya merupakan patogen tular tanah sehingga dapat bertahan di tanah dan juga sisa tanaman dalam bentuk sklerotium. Sklerotium merupakan massa hifa yang mengumpul dan memadat yang awalnya berwarna putih dan kemudian berubah menjadi berwarna coklat. Jamur ini mempunyai banyak inang alternatif seperti tanaman kacang tanah, kedelai, kacang hijau dan sorgum (Soenartiningsih et al., 2015)."@id ;
    skos:prefLabel "Penyakit Busuk Pelepah"@id .

