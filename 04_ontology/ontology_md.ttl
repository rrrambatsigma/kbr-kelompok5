        ns1:PenggunaanBacillus,
        ns1:PenggunaanBakterisida,
        ns1:PenggunaanBenihSehat,
        ns1:PenggunaanBiopestisida,
        ns1:PenggunaanPestisidaNabati,
        ns1:PenggunaanVarietasTahan,
        ns1:RotasiTanaman ;
    ns1:disebabkanOleh ns1:RalstoniaSolanacearum ;
    ns1:identifierSumber "DIS_023" ;
    ns1:memilikiGejala ns1:PengamatanPenyakitLayuBakteriKacangTanahDiikutiKematianSebagianSeluruhCabang,
        ns1:PengamatanPenyakitLayuBakteriKacangTanahLayuDaun ;
