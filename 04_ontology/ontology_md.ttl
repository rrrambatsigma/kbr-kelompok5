#################################################################
#    Rules
#################################################################

<d> rdf:type ns2:Variable .

<t> rdf:type ns2:Variable .

<o> rdf:type ns2:Variable .

<f> rdf:type ns2:Variable .

<p> rdf:type ns2:Variable .

<eo> rdf:type ns2:Variable .

<g> rdf:type ns2:Variable .

<gp> rdf:type ns2:Variable .

<c> rdf:type ns2:Variable .

<o2> rdf:type ns2:Variable .

<g2> rdf:type ns2:Variable .

<gn> rdf:type ns2:Variable .

<gn2> rdf:type ns2:Variable .

<gp2> rdf:type ns2:Variable .

<v> rdf:type ns2:Variable .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Tujuan: menandai penyakit yang risikonya meningkat oleh kondisi lingkungan diagnosis." ;
   rdfs:label "RuleRisikoLingkungan" ;
   rdf:type ns2:Imp ;
   ns2:body [ rdf:type ns2:AtomList ;
              rdf:first [ rdf:type ns2:ClassAtom ;
                          ns2:classPredicate ns1:Diagnosis ;
                          ns2:argument1 <d>
                        ] ;
              rdf:rest [ rdf:type ns2:AtomList ;
                         rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                     ns2:propertyPredicate ns1:memilikiTanaman ;
                                     ns2:argument1 <d> ;
                                     ns2:argument2 <t>
                                   ] ;
                         rdf:rest [ rdf:type ns2:AtomList ;
                                    rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                ns2:propertyPredicate ns1:memilikiObservasi ;
                                                ns2:argument1 <d> ;
                                                ns2:argument2 <o>
                                              ] ;
                                    rdf:rest [ rdf:type ns2:AtomList ;
                                               rdf:first [ rdf:type ns2:ClassAtom ;
                                                           ns2:classPredicate ns1:ObservasiLingkungan ;
                                                           ns2:argument1 <o>
                                                         ] ;
                                               rdf:rest [ rdf:type ns2:AtomList ;
                                                          rdf:first [ rdf:type ns2:DatavaluedPropertyAtom ;
                                                                      ns2:propertyPredicate ns1:klasifikasiTurunan ;
                                                                      ns2:argument1 <o> ;
                                                                      ns2:argument2 <f>
                                                                    ] ;
                                                          rdf:rest [ rdf:type ns2:AtomList ;
                                                                     rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                 ns2:propertyPredicate ns1:dipengaruhiOleh ;
                                                                                 ns2:argument1 <p> ;
                                                                                 ns2:argument2 <eo>
                                                                               ] ;
                                                                     rdf:rest [ rdf:type ns2:AtomList ;
                                                                                rdf:first [ rdf:type ns2:DatavaluedPropertyAtom ;
                                                                                            ns2:propertyPredicate ns1:klasifikasiTurunan ;
                                                                                            ns2:argument1 <eo> ;
                                                                                            ns2:argument2 <f>
                                                                                          ] ;
                                                                                rdf:rest [ rdf:type ns2:AtomList ;
                                                                                           rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                                       ns2:propertyPredicate ns1:menyerangTanaman ;
                                                                                                       ns2:argument1 <p> ;
                                                                                                       ns2:argument2 <t>
                                                                                                     ] ;
                                                                                           rdf:rest rdf:nil
                                                                                         ]
                                                                              ]
                                                                   ]
                                                        ]
                                             ]
                                  ]
                       ]
            ] ;
   ns2:head [ rdf:type ns2:AtomList ;
              rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                          ns2:propertyPredicate ns1:menandaiRisikoLingkungan ;
                          ns2:argument1 <d> ;
                          ns2:argument2 <p>
                        ] ;
              rdf:rest rdf:nil
            ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Tujuan: diagnosis menghasilkan kandidat penyakit berdasarkan faktor lingkungan yang sama." ;
   rdfs:label "RuleKandidatLingkungan" ;
   rdf:type ns2:Imp ;
   ns2:body [ rdf:type ns2:AtomList ;
              rdf:first [ rdf:type ns2:ClassAtom ;
                          ns2:classPredicate ns1:Diagnosis ;
                          ns2:argument1 <d>
                        ] ;
              rdf:rest [ rdf:type ns2:AtomList ;
                         rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                     ns2:propertyPredicate ns1:memilikiTanaman ;
                                     ns2:argument1 <d> ;
                                     ns2:argument2 <t>
                                   ] ;
                         rdf:rest [ rdf:type ns2:AtomList ;
                                    rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                ns2:propertyPredicate ns1:memilikiObservasi ;
                                                ns2:argument1 <d> ;
                                                ns2:argument2 <o>
                                              ] ;
                                    rdf:rest [ rdf:type ns2:AtomList ;
                                               rdf:first [ rdf:type ns2:ClassAtom ;
                                                           ns2:classPredicate ns1:ObservasiLingkungan ;
                                                           ns2:argument1 <o>
                                                         ] ;
                                               rdf:rest [ rdf:type ns2:AtomList ;
                                                          rdf:first [ rdf:type ns2:DatavaluedPropertyAtom ;
                                                                      ns2:propertyPredicate ns1:klasifikasiTurunan ;
                                                                      ns2:argument1 <o> ;
                                                                      ns2:argument2 <f>
                                                                    ] ;
                                                          rdf:rest [ rdf:type ns2:AtomList ;
                                                                     rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                 ns2:propertyPredicate ns1:dipengaruhiOleh ;
                                                                                 ns2:argument1 <p> ;
                                                                                 ns2:argument2 <eo>
                                                                               ] ;
                                                                     rdf:rest [ rdf:type ns2:AtomList ;
                                                                                rdf:first [ rdf:type ns2:DatavaluedPropertyAtom ;
                                                                                            ns2:propertyPredicate ns1:klasifikasiTurunan ;
                                                                                            ns2:argument1 <eo> ;
                                                                                            ns2:argument2 <f>
                                                                                          ] ;
                                                                                rdf:rest [ rdf:type ns2:AtomList ;
                                                                                           rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                                       ns2:propertyPredicate ns1:menyerangTanaman ;
                                                                                                       ns2:argument1 <p> ;
                                                                                                       ns2:argument2 <t>
                                                                                                     ] ;
                                                                                           rdf:rest rdf:nil
                                                                                         ]
                                                                              ]
                                                                   ]
                                                        ]
                                             ]
                                  ]
                       ]
            ] ;
   ns2:head [ rdf:type ns2:AtomList ;
              rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                          ns2:propertyPredicate ns1:menghasilkanPenyakit ;
                          ns2:argument1 <d> ;
                          ns2:argument2 <p>
                        ] ;
              rdf:rest rdf:nil
            ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Tujuan: diagnosis menghasilkan kandidat penyakit berdasarkan gejala kanonik yang sama." ;
   rdfs:label "RuleKandidatGejala" ;
   rdf:type ns2:Imp ;
