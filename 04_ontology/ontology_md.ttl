    ns1:berkaitanPengendalian ns1:Pengendalian2018MenjelaskanBahwaPengendalianPascapanen_ffe39a4f,
        ns1:PengendalianAdapunPengendalianYangDapatDilakukan_d27acf2c,
        ns1:PengendalianSterilisasiAkarAtauBahanSebelum_552cd22d ;
    ns1:deskripsiPenyakit "Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003). Wamalwa et al. (2015) melaporkan bahwa C. fimbriata dapat menginduksi fitoaleksin yang bersifat toksik pada hewan."@id ;
    ns1:dikendalikanDengan ns1:Pengendalian2018MenjelaskanBahwaPengendalianPascapanen_ffe39a4f,
        ns1:PengendalianAdapunPengendalianYangDapatDilakukan_d27acf2c,
