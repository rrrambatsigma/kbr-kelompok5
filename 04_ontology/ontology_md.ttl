kbr:ObservasiPenyakitBulaiJagungKelembapan90Persen a kbr:KelembapanUdara,
        kbr:ObservasiLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Kelembapan 90Persen pada Penyakit Bulai"@id ;
    kbr:didukungOleh kbr:BuktiLingkunganPenyakitBulaiJagung ;
    kbr:memengaruhiPenyakit kbr:PenyakitBulaiJagung ;
    kbr:nilaiTunggal 90.0 ;
    kbr:operatorNilai ">" ;
    kbr:satuan "%" ;
    dcterms:source "Turunan relasi ontology"@id ;
    rdfs:comment "Observasi faktor lingkungan yang diekstrak dari sumber."@id ;
    skos:definition "Observasi Kelembapan 90Persen yang memengaruhi penyakit Penyakit Bulai."@id ;
    skos:prefLabel "Kelembapan 90Persen pada Penyakit Bulai"@id .

