ns1:SuperelongasiUbiKayu a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Superelongasi"@id ;
    ns1:deskripsiPenyakit "Pemanjangan ruas batang yang berlebihan, sehingga batang terbentuk tipis dan lemah dibandingkan tanaman sehat. Gejala pada daun dan tangkai daun di batang muda, deformasi berkembang berasosisi dengan gejala kanker."@id ;
    ns1:didukungOleh ns1:BuktiPatogenSuperelongasiUbiKayuSelTabelT52BATANG,
        ns1:BuktiPenyakitSuperelongasiUbiKayuTanpaTeks ;
    ns1:disebabkanOleh ns1:ElsinoeBrasiliensis ;
    ns1:identifierSumber "DIS_037" ;
    ns1:memilikiGejala ns1:PengamatanSuperelongasiUbiKayuPemanjanganRuasBatangBerlebihanBatang ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Batang ;
    ns1:menyerangTanaman ns1:UbiKayu ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Pemanjangan ruas batang yang berlebihan, sehingga batang terbentuk tipis dan lemah dibandingkan tanaman sehat. Gejala pada daun dan tangkai daun di batang muda, deformasi berkembang berasosisi dengan gejala kanker."@id ;
    skos:prefLabel "Superelongasi"@id .

ns1:TanamanKerdilStuntUbiKayu a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Tanaman kerdil (stunt)"@id ;
    ns1:deskripsiPenyakit "Tanaman tidak tumbuh secara normal, gejala ini umumnya terjadi pada tanaman yang mengalami infeksi awal oleh virus ini. Tanaman yang terinfeksi virus ini umumnya akan memiliki batang yang berukuran kecil"@id ;
    ns1:didukungOleh ns1:BuktiPatogenTanamanKerdilStuntUbiKayuSelTabelT52BATANG,
        ns1:BuktiPenyakitTanamanKerdilStuntUbiKayuStunt ;
    ns1:disebabkanOleh ns1:Begomovirus ;
    ns1:identifierSumber "DIS_038" ;
    ns1:memilikiGejala ns1:PengamatanTanamanKerdilStuntUbiKayuTidakTumbuhUmumnyaTerjadiMengalami ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Batang ;
    ns1:menyerangTanaman ns1:UbiKayu ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Tanaman tidak tumbuh secara normal, gejala ini umumnya terjadi pada tanaman yang mengalami infeksi awal oleh virus ini. Tanaman yang terinfeksi virus ini umumnya akan memiliki batang yang berukuran kecil"@id ;
    skos:prefLabel "Tanaman kerdil (stunt)"@id .

ns1:BercakDaunCoklatUbiKayu a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun Coklat"@id ;
    ns1:deskripsiPenyakit "bercak daun berwarna cokelat, berbentuk bulat kecil (Miarti et al. 2020)"@id ;
