    ns1:terdapatPada ns1:Daun ;
    rdfs:comment "Kemudian akan berubah warna menjadi putih kekuningan dan meluas di satu sisi atau dua sisi daun."@id,
        "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Klorosis daun pada Penyakit Hawar Daun Bakteri"@id .

ns1:PengamatanPenyakitHawarDaunBakteriPadiLayuDaun a ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Layu daun pada Penyakit Hawar Daun Bakteri"@id ;
