    ns1:menyerangTanaman ns1:UbiKayu ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Tanaman tumbuh kerdil (dwarf), ruas batang memendek, pada ujung tanaman tumbuh tunas yang banyak menyerupai sapu"@id ;
    skos:prefLabel "Sapu setan (Witches broom)"@id .

ns1:SclerotiumRolfsii a ns1:Jamur,
        owl:NamedIndividual ;
    rdfs:label "Sclerotium rolfsii"@id ;
    ns1:didukungOleh ns1:BuktiPatogenBusukAkarDanUmbiUbiKayuSelTabelT53AKAR3,
