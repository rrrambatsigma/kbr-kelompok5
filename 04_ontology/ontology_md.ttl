kbr:PenyakitBercakKuningUbiJalar a kbr:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit bercak kuning"@id ;
    kbr:berkaitanPengendalian kbr:KulturMeristem,
