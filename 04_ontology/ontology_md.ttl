kbr:PenyakitBakteri a owl:Class ;
    rdfs:label "Penyakit Bakteri"@id ;
    dcterms:source "Dokumentasi TBox"@id ;
    rdfs:comment "Penyakit yang disebabkan oleh patogen kelompok bakteri."@id ;
    rdfs:subClassOf kbr:Penyakit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( kbr:Penyakit [ a owl:Restriction ;
                        owl:onProperty kbr:disebabkanOleh ;
                        owl:someValuesFrom kbr:Bakteri ] ) ],
        <https://gwsp.cs.ksu.edu/disease-management/disease/Bacterial_Disease> ;
    skos:definition "Penyakit yang disebabkan oleh patogen kelompok bakteri."@id ;
    skos:prefLabel "Penyakit Bakteri"@id .

