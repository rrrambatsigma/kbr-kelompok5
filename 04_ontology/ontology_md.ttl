        ns1:GejalaInformasiPenelitianDiIndonesiaTerkait_8ee11e4c,
        ns1:GejalaMenurutCooperAndJones2006_c959a1b0,
        ns1:GejalaPenyakitBercakKuningPadaUbi_2ed05050 ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Daun ;
    ns1:menyerangTanaman ns1:UbiJalar .

ns1:PenyakitBusukHitamBlackRotUbiJalar a ns1:Penyakit,
