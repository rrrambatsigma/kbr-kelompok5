                                        ns1:GejalaPenyakitBercakDaunKacangHijauBercakDaun ,
                                        ns1:GejalaPenyakitBercakDaunKacangTanahBercakDaun ,
                                        ns1:GejalaPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelaiBerca ,
