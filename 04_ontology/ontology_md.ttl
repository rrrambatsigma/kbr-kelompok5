        ns1:PenggunaanMetarhizium,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:KondisiTropisDenganPadiSepanjangTahunPadaPenyakitKerdilRumputDanKerdilHampaPadi ;
    ns1:disebabkanOleh ns1:RiceGrassyStuntVirus,
        ns1:RiceRaggedStuntVirus ;
    ns1:identifierSumber "DIS_005" ;
    ns1:memilikiGejala ns1:GejalaPenyakitKerdilRumputDanKerdilHampaPadi,
        ns1:GejalaPenyakitKerdilRumputDanKerdilHampaPadiBercakDaun,
        ns1:GejalaPenyakitKerdilRumputDanKerdilHampaPadiKerdilTanaman,
        ns1:GejalaPenyakitKerdilRumputDanKerdilHampaPadiKlorosisDaun ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Batang,
        ns1:Daun ;
    ns1:menyerangTanaman ns1:Padi ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit kerdil rumput disebabkan oleh virus kerdil rumput tipe 1 dan virus kerdil rumput tipe 2, sedangkan penyakit kerdil hampa disebabkan oleh virus kerdil hampa. Kedua virus tersebut dapat ditularkan oleh wereng coklat (Nilaparvata lugens) (Senewe et al. 2020). Wereng yang menjadi carrier bagi"@id ;
    skos:prefLabel "Penyakit Kerdil Rumput dan Kerdil Hampa"@id .

ns1:GejalaAkar a owl:Class ;
    rdfs:label "Gejala Akar"@id ;
    rdfs:comment "Gejala yang diamati pada akar."@id,
        "Pada tanaman yang terinfeksi *R. solani* akan menunjukkan gejala adanya lekukan coklat dan berkembang menjadi warna hitam pada pangkal akar muda yang terinfeksi (Muslim et al., 2019)."@id ;
    rdfs:subClassOf ns1:Gejala ;
    skos:prefLabel "Gejala Akar"@id .

ns1:Padi a ns1:Serealia,
        ns1:TanamanPangan,
        owl:NamedIndividual ;
    rdfs:label "Padi"@id ;
    ns1:deskripsiTanaman "Padi merupakan tanaman pangan yang paling banyak dibudidayakan, sebab menjadi sumber pangan pokok bagi masyarakat Indonesia. Tidak hanya di Indonesia, di sebagian besar negara Asia pun padi menjadi tanaman pangan utama. Adapun 4 negara yang mengonsumsi beras paling besar yaitu Cina, India, Indonesia, dan Bangladesh dengan jumlah konsumsi berturut-turut sebesar 200 juta ton, 170 juta ton, 50 juta ton, dan 20 juta ton (FAO 2016). Berdasarkan jumlah konsumsi beras yang begitu besar, maka perlu upaya untuk peningkatan produksi beras untuk mencukup kebutuhan tersebut. Upaya peningkatan produksi dapat dilakukan dengan berbagai cara, termasuk dengan proteksi tanaman terhadap gangguan organisme pengganggu tanaman (OPT). OPT merupakan faktor biotik yang dapat mengakibatkan kehilangan hasil dari padi, sehingga produksi tanaman dapat menurun bahkan menimbulkan kerugian ekonomi."@id ;
    ns1:diserangPenyakit ns1:PenyakitBlasPadi,
        ns1:PenyakitHawarDaunBakteriPadi,
        ns1:PenyakitHawarPelepahDaunPadi,
        ns1:PenyakitKerdilRumputDanKerdilHampaPadi,
        ns1:PenyakitTungroPadi ;
    ns1:identifierSumber "PLANT_001" ;
    ns1:memilikiFasePertumbuhan ns1:FasePematanganPadi,
        ns1:FaseReproduktifPadi,
        ns1:FaseVegetatifPadi ;
    ns1:memilikiKondisiTumbuh ns1:KondisiCurahHujanTinggi ;
    ns1:memilikiVarietas ns1:VarietasBondoyudo,
        ns1:VarietasKalimas,
        ns1:VarietasTukadBalian,
        ns1:VarietasTukadUnda ;
    ns1:namaIlmiah "Oryza sativa L." ;
    rdfs:comment "Nama ilmiah dilengkapi dari Plants of the World Online (Kew) karena tidak tercantum pada sumber utama."@id,
        "Padi merupakan tanaman pangan yang paling banyak dibudidayakan, sebab menjadi sumber pangan pokok bagi masyarakat Indonesia. Tidak hanya di Indonesia, di sebagian besar negara Asia pun padi menjadi tanaman pangan utama. Adapun 4 negara yang mengonsumsi beras paling besar yaitu Cina, India, Indonesia, dan Bangladesh dengan jumlah konsumsi berturut-turut sebesar 200 juta ton, 170 juta ton, 50 juta ton, dan 20 juta ton (FAO 2016). Berdasarkan jumlah konsumsi beras yang begitu besar, maka perlu upaya untuk peningkatan produksi beras untuk mencukup kebutuhan tersebut. Upaya peningkatan produksi dapat dilakukan dengan berbagai cara, termasuk dengan proteksi tanaman terhadap gangguan organisme pengganggu tanaman (OPT). OPT merupakan faktor biotik yang dapat mengakibatkan kehilangan hasil dari padi, sehingga produksi tanaman dapat menurun bahkan menimbulkan kerugian ekonomi."@id,
        "Tanaman pangan dalam ruang lingkup knowledge base."@id ;
    rdfs:seeAlso <https://powo.science.kew.org/results?q=Oryza%20sativa> ;
    skos:prefLabel "Padi"@id .

ns1:PenyakitBakteriPustulKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Bakteri Pustul"@id ;
    ns1:berkaitanPengendalian ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanBenihSehat,
        ns1:PenggunaanEkstrakTanaman,
        ns1:SanitasiLahan ;
    ns1:deskripsiPenyakit "Penyakit yang juga sering menyerang pada tanaman kedelai adalah penyakit bakteri pustul. Penyakit ini disebabkan oleh patogen Xanthomonas axonopodis pv. glycines. Patogen akan menginfeksi bagian daun tanaman. Gejala yang muncul akibat serangan patogen X. axonopodis pv. glycines diawali dengan adanya bercak-bercak pada bagian daun. Bercak berwarna hijau kekuningan. Kemudian bercak berkembang menjadi berwarna kuning kecokelatan. Pada awal munculnya bercak berukuran kecil. Kemudian pada serangan yang tinggi maka bercak menjadi berukuran besar (Gambar 2.16)."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitBakteriPustulKedelai,
        ns1:BuktiPengendalianPenyakitBakteriPustulKedelai,
        ns1:BuktiPengendalianPenyakitBakteriPustulKedelai2,
        ns1:BuktiPengendalianPenyakitBakteriPustulKedelai3,
        ns1:BuktiPenyakitPenyakitBakteriPustulKedelai ;
    ns1:dikendalikanDengan ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanBenihSehat,
        ns1:PenggunaanEkstrakTanaman,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:KelembapanTinggiDanDaunBasahPadaPenyakitBakteriPustulKedelai,
        ns1:SuhuPadaPenyakitBakteriPustulKedelai ;
    ns1:disebabkanOleh ns1:XanthomonasAxonopodis ;
    ns1:identifierSumber "DIS_017" ;
    ns1:memilikiGejala ns1:GejalaPenyakitBakteriPustulKedelai,
        ns1:GejalaPenyakitBakteriPustulKedelaiBercakDaun,
        ns1:GejalaPenyakitBakteriPustulKedelaiBercakTanaman,
        ns1:GejalaPenyakitBakteriPustulKedelaiDaunRontok,
        ns1:GejalaPenyakitBakteriPustulKedelaiKlorosisTanaman ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Daun ;
    ns1:menyerangTanaman ns1:Kedelai ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit yang juga sering menyerang pada tanaman kedelai adalah penyakit bakteri pustul. Penyakit ini disebabkan oleh patogen Xanthomonas axonopodis pv. glycines. Patogen akan menginfeksi bagian daun tanaman. Gejala yang muncul akibat serangan patogen X. axonopodis pv. glycines diawali dengan adanya bercak-bercak pada bagian daun. Bercak berwarna hijau kekuningan. Kemudian bercak berkembang menjadi berwarna kuning kecokelatan. Pada awal munculnya bercak berukuran kecil. Kemudian pada serangan yang tinggi maka bercak menjadi berukuran besar (Gambar 2.16)."@id ;
    skos:prefLabel "Penyakit Bakteri Pustul"@id .

ns1:PenyakitLayuKacangHijau a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Layu"@id ;
    ns1:berkaitanPengendalian ns1:PenggunaanAgensHayati,
        ns1:PenggunaanEkstrakTanaman,
        ns1:PenggunaanPestisidaNabati,
        ns1:PenggunaanVarietasTahan,
        ns1:SolarisasiTanah ;
    ns1:deskripsiPenyakit "Gejala penyakit layu berupa ruam pada bagian terinfeksi, seperti pengaruh penggenangan air. Bagian yang ruam berwarna coklat muda dan berkembang menjadi coklat tua. Tanaman terinfeksi selanjutnya akan menjadi busuk dan akhirnya mati. Miselia berwarna putih akan ditemukan di sekitar gejala, dan pada gejala tingkat lanjut akan ditemukan sejumlah sclerosia pada akar (Jin Hyeuk 2017) dan daun dekat permukaan tanah (Gambar 25). Selain gejala layu, infeksi cendawan ini juga menyebabkan busuk akar dan polong, serta rebah kecambah (damping off) (Akram et al. 2007). Infeksi pada tanaman dapat terjadi pada stadia awal sebelum benih berkecambah hingga fase generatif akhir. Namun demikian fase awal pertumbuhan tanaman merupakan fase rentan infeksi cendawan ini."@id ;
    ns1:didukungOleh ns1:BuktiMetadataPhasePenyakitLayuKacangHijau,
        ns1:BuktiPatogenPenyakitLayuKacangHijau,
        ns1:BuktiPengendalianPenyakitLayuKacangHijau,
        ns1:BuktiPengendalianPenyakitLayuKacangHijau2,
        ns1:BuktiPengendalianPenyakitLayuKacangHijau3,
        ns1:BuktiPengendalianPenyakitLayuKacangHijau4,
        ns1:BuktiPenyakitPenyakitLayuKacangHijau ;
    ns1:dikendalikanDengan ns1:PenggunaanAgensHayati,
        ns1:PenggunaanEkstrakTanaman,
        ns1:PenggunaanPestisidaNabati,
        ns1:PenggunaanVarietasTahan,
        ns1:SolarisasiTanah ;
    ns1:dipengaruhiOleh ns1:Suhu2735CPadaPenyakitLayuKacangHijau,
        ns1:TanahJenuhAirDanKelembapanTinggiPadaPenyakitLayuKacangHijau ;
    ns1:disebabkanOleh ns1:SclerotiumRolfsii ;
    ns1:identifierSumber "DIS_125" ;
    ns1:memilikiGejala ns1:GejalaPenyakitLayuKacangHijauBusukTanaman,
        ns1:GejalaPenyakitLayuKacangHijauLayuDaun,
        ns1:GejalaPenyakitLayuKacangHijauMiseliumPadaTanaman ;
    ns1:memilikiReferensi ns1:BukuDOC005 ;
    ns1:menyerangBagian ns1:Akar,
        ns1:Daun ;
    ns1:menyerangFase ns1:FaseGeneratifUmum ;
    ns1:menyerangTanaman ns1:KacangHijau ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Gejala penyakit layu berupa ruam pada bagian terinfeksi, seperti pengaruh penggenangan air. Bagian yang ruam berwarna coklat muda dan berkembang menjadi coklat tua. Tanaman terinfeksi selanjutnya akan menjadi busuk dan akhirnya mati. Miselia berwarna putih akan ditemukan di sekitar gejala, dan pada gejala tingkat lanjut akan ditemukan sejumlah sclerosia pada akar (Jin Hyeuk 2017) dan daun dekat permukaan tanah (Gambar 25). Selain gejala layu, infeksi cendawan ini juga menyebabkan busuk akar dan polong, serta rebah kecambah (damping off) (Akram et al. 2007). Infeksi pada tanaman dapat terjadi pada stadia awal sebelum benih berkecambah hingga fase generatif akhir. Namun demikian fase awal pertumbuhan tanaman merupakan fase rentan infeksi cendawan ini."@id ;
    skos:altLabel "LAYU"@id ;
    skos:prefLabel "Penyakit Layu"@id .

ns1:UbiJalar a ns1:TanamanPangan,
        ns1:UmbiUmbian,
        owl:NamedIndividual ;
    rdfs:label "Ubi jalar"@id ;
    ns1:deskripsiTanaman "Ubi jalar (Ipomoea batatas L. (Lam) adalah salah satu komoditas pangan penting di dunia yang menduduki urutan ketujuh (FAOSTAT, 2009), setelah gandum, beras, jagung, kentang, barley, dan ubi kayu (Aguoru, Uhia and Olasan, 2015). Produksi terbesar di Asia sebanyak 76.1% dari produksi di dunia pada tahun 2013, diikuti Afrika dan terdapat 5 negara produsen terbesar di dunia yang memproduksi ubi jalar pada tahun 2014 yaitu Cina, Nigeria, Uganda, Indonesia, dan United Republic dari Tanzania (FAOSTAT 2015 dalam Okada et al. 2017). Sebagai sumber karbohidrat, ubi jalar memiliki potensi untuk dikembangkan dalam menunjang program diversifikasi pangan (Barahima and Purnomo, 2003). Selain itu, ubi jalar banyak mengandung pro- vitamin, vitamin C, potasium, besi, dan kalsium (Clark et al., 2013)."@id ;
    ns1:diserangPenyakit ns1:LayuFusariumUbiJalar,
        ns1:PenyakitBercakKuningUbiJalar,
        ns1:PenyakitBusukHitamBlackRotUbiJalar,
        ns1:PenyakitKudisUbiJalar ;
    ns1:identifierSumber "PLANT_004" ;
    ns1:memilikiFasePertumbuhan ns1:FaseAwalPertumbuhanUbiJalar,
        ns1:FasePembentukanUmbiUbiJalar ;
    ns1:memilikiKondisiTumbuh ns1:KondisiTanahGembur ;
    ns1:memilikiVarietas ns1:VarietasAbomourow,
        ns1:VarietasAntin1,
        ns1:VarietasBonsasarai,
        ns1:VarietasCangkuang,
        ns1:VarietasInanwatan4,
        ns1:VarietasKuyage2,
        ns1:VarietasMouwebsi,
        ns1:VarietasPapuaPattipi,
        ns1:VarietasPapuaSalossa,
        ns1:VarietasSari,
        ns1:VarietasSawentar,
        ns1:VarietasSukuh,
        ns1:VarietasWonembai ;
    ns1:namaIlmiah "Ipomoea batatas L. (Lam)" ;
    rdfs:comment "Tanaman pangan dalam ruang lingkup knowledge base."@id,
        "Ubi jalar (Ipomoea batatas L. (Lam) adalah salah satu komoditas pangan penting di dunia yang menduduki urutan ketujuh (FAOSTAT, 2009), setelah gandum, beras, jagung, kentang, barley, dan ubi kayu (Aguoru, Uhia and Olasan, 2015). Produksi terbesar di Asia sebanyak 76.1% dari produksi di dunia pada tahun 2013, diikuti Afrika dan terdapat 5 negara produsen terbesar di dunia yang memproduksi ubi jalar pada tahun 2014 yaitu Cina, Nigeria, Uganda, Indonesia, dan United Republic dari Tanzania (FAOSTAT 2015 dalam Okada et al. 2017). Sebagai sumber karbohidrat, ubi jalar memiliki potensi untuk dikembangkan dalam menunjang program diversifikasi pangan (Barahima and Purnomo, 2003). Selain itu, ubi jalar banyak mengandung pro- vitamin, vitamin C, potasium, besi, dan kalsium (Clark et al., 2013)."@id ;
    skos:prefLabel "Ubi jalar"@id .

ns1:KondisiSuhuHangat a ns1:Suhu,
        owl:NamedIndividual ;
    rdfs:label "Suhu hangat"@id ;
    rdfs:comment "Lingkungan yang mendukung untuk perkembangan patogen adalah kondisi lingkungan yang lembab yaitu > 85% selama 5-7 hari dan suhu hangat."@id .

ns1:PengelolaanGulma a ns1:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Pengelolaan gulma"@id ;
    ns1:deskripsiPengendalian "Kemudian sanitasi dari keberadaan gulma, singgang, dan ceceran gabah yang dapat menjadi inang alternatif bagi patogen maupun vektor, penanaman sistem jajar legowo yang dapat memanipulasi kondisi mikro iklim di bawah kanopi tidak sesuai untuk patogen, pengeringan sawah untuk menekan populasi nimfa wereng hijau."@id ;
