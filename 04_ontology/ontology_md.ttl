    kbr:menyerangTanaman kbr:KacangHijau ;
    dcterms:source "Kurasi pakar"@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ;
    skos:altLabel "Wilt"@en,
        "LAYU"@id ;
    skos:definition "Penyakit Layu pada tanaman Kacang hijau, disebabkan oleh Sclerotium rolfsii, dengan gejala antara lain Busuk pada tanaman, Layu daun, Miselium pada tanaman."@id ;
    skos:prefLabel "Wilt"@en,
        "Penyakit Layu"@id .

kbr:UbiJalar a kbr:TanamanPangan,
        kbr:UmbiUmbian,
        owl:NamedIndividual ;
    rdfs:label "Ubi jalar"@id ;
    kbr:deskripsiTanaman "Ubi jalar (Ipomoea batatas L. (Lam) adalah salah satu komoditas pangan penting di dunia yang menduduki urutan ketujuh (FAOSTAT, 2009), setelah gandum, beras, jagung, kentang, barley, dan ubi kayu (Aguoru, Uhia and Olasan, 2015). Produksi terbesar di Asia sebanyak 76.1% dari produksi di dunia pada tahun 2013, diikuti Afrika dan terdapat 5 negara produsen terbesar di dunia yang memproduksi ubi jalar pada tahun 2014 yaitu Cina, Nigeria, Uganda, Indonesia, dan United Republic dari Tanzania (FAOSTAT 2015 dalam Okada et al. 2017). Sebagai sumber karbohidrat, ubi jalar memiliki potensi untuk dikembangkan dalam menunjang program diversifikasi pangan (Barahima and Purnomo, 2003). Selain itu, ubi jalar banyak mengandung pro- vitamin, vitamin C, potasium, besi, dan kalsium (Clark et al., 2013)."@id ;
    kbr:diserangPenyakit kbr:LayuFusariumUbiJalar,
        kbr:PenyakitBercakKuningUbiJalar,
        kbr:PenyakitBusukHitamBlackRotUbiJalar,
        kbr:PenyakitKudisUbiJalar ;
    kbr:identifierSumber "PLANT_004" ;
    kbr:memilikiFasePertumbuhan kbr:FaseAwalPertumbuhanUbiJalar,
        kbr:FasePembentukanUmbiUbiJalar ;
    kbr:memilikiKondisiTumbuh kbr:KondisiTanahGembur ;
    kbr:memilikiVarietas kbr:VarietasAbomourow,
        kbr:VarietasAntin1,
        kbr:VarietasBonsasarai,
        kbr:VarietasCangkuang,
        kbr:VarietasInanwatan4,
        kbr:VarietasKuyage2,
        kbr:VarietasMouwebsi,
        kbr:VarietasPapuaPattipi,
        kbr:VarietasPapuaSalossa,
        kbr:VarietasSari,
        kbr:VarietasSawentar,
        kbr:VarietasSukuh,
        kbr:VarietasWonembai ;
    kbr:namaIlmiah "Ipomoea batatas L. (Lam)" ;
    dcterms:source "Kurasi pakar"@id ;
    rdfs:comment "Tanaman pangan dalam ruang lingkup knowledge base."@id ;
    skos:altLabel "Ipomoea batatas"@id,
        "ubi jalar"@id ;
    skos:definition "Tanaman pangan umbi-umbian penghasil umbi akar yang kaya karbohidrat."@id ;
    skos:prefLabel "Ubi jalar"@id .

