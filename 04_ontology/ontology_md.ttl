@prefix ns1: <http://kbr.kelompok5.org/penyakit-tanaman-pangan#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://kbr.kelompok5.org/penyakit-tanaman-pangan> a owl:Ontology ;
    rdfs:label "Ontologi Penyakit Tanaman Pangan Indonesia"@id ;
    rdfs:comment "Knowledge base penyakit tanaman pangan Indonesia (padi, kedelai, jagung, ubi jalar, ubi kayu, kacang tanah, kacang hijau) untuk penalaran OWL 2 minimal SROIQ(D) di Protégé."@id .

ns1:ArtikelIlmiah a owl:Class ;
    rdfs:label "Artikel Ilmiah"@id ;
    rdfs:subClassOf ns1:Referensi .

ns1:DrainaseBuruk a owl:Class ;
    rdfs:label "Drainase Buruk"@id ;
    rdfs:subClassOf ns1:FaktorBudidaya .

ns1:JurnalIlmiah a owl:Class ;
    rdfs:label "Jurnal Ilmiah"@id ;
    rdfs:subClassOf ns1:Referensi .

ns1:KondisiCahayaRendah a ns1:FaktorLingkungan ;
    rdfs:label "Cahaya rendah"@id .

ns1:KondisiCahayaTinggi a ns1:FaktorLingkungan ;
    rdfs:label "Cahaya tinggi"@id .

ns1:KondisiCurahHujanRendah a ns1:FaktorLingkungan ;
    rdfs:label "Curah hujan rendah"@id .

ns1:KondisiCurahHujanSedang a ns1:FaktorLingkungan ;
    rdfs:label "Curah hujan sedang"@id .

ns1:KondisiCurahHujanTinggi a ns1:FaktorLingkungan ;
    rdfs:label "Curah hujan tinggi"@id .

ns1:KondisiDataranRendah a ns1:FaktorLingkungan ;
    rdfs:label "Dataran rendah"@id .

ns1:KondisiDataranTinggi a ns1:FaktorLingkungan ;
    rdfs:label "Dataran tinggi"@id .

ns1:KondisiDrainase a owl:Class ;
    rdfs:label "Kondisi Drainase"@id ;
    rdfs:subClassOf ns1:FaktorLahan .

ns1:KondisiDrainaseBaik a ns1:FaktorLingkungan ;
    rdfs:label "Drainase baik"@id .

ns1:KondisiDrainaseBuruk a ns1:FaktorLingkungan ;
    rdfs:label "Drainase buruk"@id .

ns1:KondisiIklimBasah a ns1:FaktorLingkungan ;
    rdfs:label "Iklim basah"@id .

ns1:KondisiIklimKering a ns1:FaktorLingkungan ;
    rdfs:label "Iklim kering"@id .

ns1:KondisiKelembapanUdaraRendah a ns1:FaktorLingkungan ;
    rdfs:label "Kelembapan udara rendah"@id .

ns1:KondisiKelembapanUdaraSedang a ns1:FaktorLingkungan ;
    rdfs:label "Kelembapan udara sedang"@id .

ns1:KondisiKelembapanUdaraTinggi a ns1:FaktorLingkungan ;
    rdfs:label "Kelembapan udara tinggi"@id .

ns1:KondisiSuhuHangat a ns1:FaktorLingkungan ;
    rdfs:label "Suhu hangat"@id .

ns1:KondisiTanah a owl:Class ;
    rdfs:label "Kondisi Tanah"@id ;
    rdfs:subClassOf ns1:FaktorLahan .

ns1:KondisiTanahAsam a ns1:FaktorLingkungan ;
    rdfs:label "Tanah asam"@id .

ns1:KondisiTanahBasa a ns1:FaktorLingkungan ;
    rdfs:label "Tanah basa"@id .

ns1:KondisiTanahBerpasir a ns1:FaktorLingkungan ;
    rdfs:label "Tanah berpasir"@id .

ns1:KondisiTanahGembur a ns1:FaktorLingkungan ;
    rdfs:label "Tanah gembur"@id .

ns1:KondisiTanahLiat a ns1:FaktorLingkungan ;
    rdfs:label "Tanah liat"@id .

ns1:KondisiTanahNetral a ns1:FaktorLingkungan ;
    rdfs:label "Tanah netral"@id .

ns1:Legum a owl:Class ;
    rdfs:label "Legum"@id ;
    rdfs:subClassOf ns1:TanamanPangan ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:KacangHijau ns1:KacangTanah ns1:Kedelai ) ] .

ns1:PenggunaanBenihTerinfeksi a owl:Class ;
    rdfs:label "Penggunaan Benih Terinfeksi"@id ;
    rdfs:subClassOf ns1:FaktorBudidaya .

ns1:PenyakitBakteri a owl:Class ;
    rdfs:label "Penyakit Bakteri"@id ;
    rdfs:subClassOf ns1:Penyakit ;
    owl:disjointWith ns1:PenyakitJamur,
        ns1:PenyakitLainnya,
        ns1:PenyakitVirus ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Penyakit [ a owl:Restriction ;
                        owl:onProperty ns1:disebabkanOleh ;
                        owl:someValuesFrom ns1:Bakteri ] ) ] .

ns1:PublikasiInstansi a owl:Class ;
    rdfs:label "Publikasi Instansi"@id ;
    rdfs:subClassOf ns1:Referensi .

ns1:SanitasiLahanBuruk a owl:Class ;
    rdfs:label "Sanitasi Lahan Buruk"@id ;
    rdfs:subClassOf ns1:FaktorBudidaya .

ns1:Serealia a owl:Class ;
    rdfs:label "Serealia"@id ;
    rdfs:subClassOf ns1:TanamanPangan ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:Jagung ns1:Padi ) ] .

ns1:deskripsiGejala a owl:DatatypeProperty ;
    rdfs:label "deskripsi gejala"@id ;
    rdfs:comment "Penjelasan gejala menurut sumber."@id ;
    rdfs:domain ns1:Gejala .

ns1:deskripsiPengendalian a owl:DatatypeProperty ;
    rdfs:label "deskripsi pengendalian"@id ;
    rdfs:comment "Penjelasan metode pengendalian menurut sumber."@id ;
    rdfs:domain ns1:Pengendalian .

ns1:deskripsiPenyakit a owl:DatatypeProperty ;
    rdfs:label "deskripsi penyakit"@id ;
    rdfs:comment "Penjelasan penyakit menurut sumber."@id ;
    rdfs:domain ns1:Penyakit .

ns1:deskripsiTanaman a owl:DatatypeProperty ;
    rdfs:label "deskripsi tanaman"@id ;
    rdfs:comment "Deskripsi tanaman pangan."@id ;
    rdfs:domain ns1:TanamanPangan .

ns1:dijelaskanDalam a owl:ObjectProperty ;
    rdfs:label "dijelaskan dalam"@id ;
    rdfs:comment "Referensi menjelaskan penyakit; kebalikan dari memilikiReferensi."@id ;
    rdfs:domain ns1:Referensi ;
    rdfs:range ns1:Penyakit ;
    owl:inverseOf ns1:memilikiReferensi .

ns1:dikendalikanDengan a owl:ObjectProperty ;
    rdfs:label "dikendalikan dengan"@id ;
    rdfs:comment "Metode pengendalian yang direkomendasikan untuk penyakit."@id ;
    rdfs:domain ns1:Penyakit ;
    rdfs:range ns1:Pengendalian ;
    rdfs:subPropertyOf ns1:berkaitanPengendalian ;
    owl:inverseOf ns1:mengendalikanPenyakit .

ns1:dipengaruhiOleh a owl:ObjectProperty ;
    rdfs:label "dipengaruhi oleh"@id ;
    rdfs:comment "Faktor risiko lingkungan/budidaya yang memengaruhi kemunculan penyakit."@id ;
    rdfs:domain ns1:Penyakit ;
    rdfs:range ns1:FaktorRisiko .

ns1:diserangPenyakit a owl:ObjectProperty ;
    rdfs:label "diserang penyakit"@id ;
    rdfs:comment "Kebalikan dari menyerangTanaman."@id ;
    rdfs:domain ns1:TanamanPangan ;
    rdfs:range ns1:Penyakit ;
    owl:inverseOf ns1:menyerangTanaman .

ns1:judulReferensi a owl:DatatypeProperty ;
    rdfs:label "judul referensi"@id ;
    rdfs:comment "Judul sumber referensi."@id ;
    rdfs:domain ns1:Referensi .

ns1:memilikiKondisiTumbuh a owl:ObjectProperty ;
    rdfs:label "memiliki kondisi tumbuh"@id ;
    rdfs:comment "Tanaman pangan memiliki kondisi lingkungan tumbuh yang terkontrol."@id ;
    rdfs:domain ns1:TanamanPangan ;
    rdfs:range ns1:FaktorLingkungan .

ns1:memilikiVarietas a owl:ObjectProperty ;
    rdfs:label "memiliki varietas"@id ;
    rdfs:comment "Tanaman pangan memiliki varietas tertentu."@id ;
    rdfs:domain ns1:TanamanPangan ;
    rdfs:range ns1:Varietas ;
    owl:inverseOf ns1:merupakanVarietasDari .

ns1:menyerangBagian a owl:ObjectProperty ;
    rdfs:label "menyerang bagian"@id ;
    rdfs:comment "Bagian tanaman (daun, batang, akar, umbi) yang terserang penyakit."@id ;
    rdfs:domain ns1:Penyakit ;
    rdfs:range ns1:BagianTanaman ;
    owl:propertyChainAxiom ( ns1:memilikiGejala ns1:terdapatPada ) .

ns1:menyerangFase a owl:ObjectProperty ;
    rdfs:label "menyerang fase"@id ;
    rdfs:comment "Fase pertumbuhan tanaman yang diserang penyakit."@id ;
    rdfs:domain ns1:Penyakit ;
    rdfs:range ns1:FasePertumbuhan .

ns1:namaIlmiah a owl:DatatypeProperty ;
    rdfs:label "nama ilmiah"@id ;
    rdfs:comment "Nama ilmiah tanaman pangan."@id ;
    rdfs:domain ns1:TanamanPangan .

ns1:namaIlmiahPatogen a owl:DatatypeProperty ;
    rdfs:label "nama ilmiah patogen"@id ;
    rdfs:comment "Nama ilmiah patogen penyebab penyakit."@id ;
    rdfs:domain ns1:Patogen .

ns1:namaPengendalian a owl:DatatypeProperty ;
    rdfs:label "nama pengendalian"@id ;
    rdfs:comment "Nama metode pengendalian."@id ;
    rdfs:domain ns1:Pengendalian .

ns1:namaPenulis a owl:DatatypeProperty ;
    rdfs:label "nama penulis"@id ;
    rdfs:comment "Penulis referensi."@id ;
    rdfs:domain ns1:Referensi .

ns1:pengendalianUmum a owl:ObjectProperty ;
    rdfs:label "pengendalian umum"@id ;
    rdfs:comment "Pengendalian umum per tanaman yang berlaku lintas penyakit."@id ;
    rdfs:domain ns1:TanamanPangan ;
    rdfs:range ns1:Pengendalian ;
    rdfs:subPropertyOf ns1:berkaitanPengendalian .

ns1:tahanTerhadap a owl:ObjectProperty ;
    rdfs:label "tahan terhadap"@id ;
    rdfs:comment "Varietas tahan/resisten terhadap penyakit tertentu."@id ;
    rdfs:domain ns1:Varietas ;
    rdfs:range ns1:Penyakit .

ns1:tingkatKeparahan a owl:DatatypeProperty ;
    rdfs:label "tingkat keparahan"@id ;
    rdfs:comment "Kategori keparahan penyakit bila tersedia di sumber."@id ;
    rdfs:domain ns1:Penyakit .

ns1:urlReferensi a owl:DatatypeProperty ;
    rdfs:label "url referensi"@id ;
    rdfs:comment "Tautan sumber referensi."@id ;
    rdfs:domain ns1:Referensi .

