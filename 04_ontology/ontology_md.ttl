[] a ns1:Imp ;
    rdfs:label "RuleKandidatKuat" ;
    ns2:isRuleEnabled true ;
    rdfs:comment "Kandidat kuat dari dua gejala kanonik berbeda"@id ;
    ns1:body [ a ns1:AtomList ;
            rdf:first [ a ns1:ClassAtom ;
                    ns1:argument1 kbr:d ;
                    ns1:classPredicate kbr:Diagnosis ] ;
            rdf:rest [ a ns1:AtomList ;
                    rdf:first [ a ns1:IndividualPropertyAtom ;
                            ns1:argument1 kbr:d ;
                            ns1:argument2 kbr:t ;
                            ns1:propertyPredicate kbr:memilikiTanaman ] ;
                    rdf:rest [ a ns1:AtomList ;
                            rdf:first [ a ns1:IndividualPropertyAtom ;
                                    ns1:argument1 kbr:p ;
                                    ns1:argument2 kbr:t ;
                                    ns1:propertyPredicate kbr:menyerangTanaman ] ;
                            rdf:rest [ a ns1:AtomList ;
                                    rdf:first [ a ns1:IndividualPropertyAtom ;
                                            ns1:argument1 kbr:d ;
                                            ns1:argument2 kbr:o ;
                                            ns1:propertyPredicate kbr:memilikiObservasi ] ;
                                    rdf:rest [ a ns1:AtomList ;
                                            rdf:first [ a ns1:IndividualPropertyAtom ;
                                                    ns1:argument1 kbr:o ;
                                                    ns1:argument2 kbr:g ;
                                                    ns1:propertyPredicate kbr:memilikiGejalaKanonik ] ;
                                            rdf:rest [ a ns1:AtomList ;
                                                    rdf:first [ a ns1:IndividualPropertyAtom ;
                                                            ns1:argument1 kbr:d ;
                                                            ns1:argument2 kbr:o2 ;
                                                            ns1:propertyPredicate kbr:memilikiObservasi ] ;
                                                    rdf:rest [ a ns1:AtomList ;
                                                            rdf:first [ a ns1:IndividualPropertyAtom ;
                                                                    ns1:argument1 kbr:o2 ;
                                                                    ns1:argument2 kbr:g2 ;
                                                                    ns1:propertyPredicate kbr:memilikiGejalaKanonik ] ;
                                                            rdf:rest [ a ns1:AtomList ;
                                                                    rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                                            ns1:argument1 kbr:g ;
                                                                            ns1:argument2 kbr:gn ;
                                                                            ns1:propertyPredicate kbr:kodeGejala ] ;
                                                                    rdf:rest [ a ns1:AtomList ;
                                                                            rdf:first [ a ns1:DatavaluedPropertyAtom ;
                                                                                    ns1:argument1 kbr:g2 ;
                                                                                    ns1:argument2 kbr:gn2 ;
                                                                                    ns1:propertyPredicate kbr:kodeGejala ] ;
                                                                            rdf:rest [ a ns1:AtomList ;
                                                                                    rdf:first [ a ns1:BuiltinAtom ;
                                                                                            ns1:arguments ( kbr:gn kbr:gn2 ) ;
                                                                                            ns1:builtin <http://www.w3.org/2003/11/swrlb#notEqual> ] ;
                                                                                    rdf:rest [ a ns1:AtomList ;
                                                                                            rdf:first [ a ns1:IndividualPropertyAtom ;
                                                                                                    ns1:argument1 kbr:p ;
                                                                                                    ns1:argument2 kbr:gp ;
                                                                                                    ns1:propertyPredicate kbr:memilikiGejala ] ;
                                                                                            rdf:rest [ a ns1:AtomList ;
                                                                                                    rdf:first [ a ns1:IndividualPropertyAtom ;
                                                                                                            ns1:argument1 kbr:gp ;
                                                                                                            ns1:argument2 kbr:g ;
                                                                                                            ns1:propertyPredicate kbr:memilikiGejalaKanonik ] ;
                                                                                                    rdf:rest [ a ns1:AtomList ;
                                                                                                            rdf:first [ a ns1:IndividualPropertyAtom ;
                                                                                                                    ns1:argument1 kbr:p ;
                                                                                                                    ns1:argument2 kbr:gp2 ;
