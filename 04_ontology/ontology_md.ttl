kbr:PengaturanKelembapan a kbr:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Pengaturan kelembapan"@id ;
    kbr:deskripsiPengendalian "Upaya pengendalian karat jagung dapat dilakukan dengan beberapa cara seperti jarak tanam yang tidak terlalu rapat dan penyiangan gulma rutin sehingga sirkulasi udara lebih baik dan kelembaban tidak terlalu tinggi."@id ;
