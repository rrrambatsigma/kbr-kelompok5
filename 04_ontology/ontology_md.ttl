                                   ns1:dikendalikanDengan ns1:PenggunaanAgensHayati ,
                                                          ns1:PenggunaanEkstrakTanaman ,
                                                          ns1:PenggunaanFungisida ,
                                                          ns1:PenggunaanPestisidaNabati ,
                                                          ns1:PenggunaanVarietasTahan ;
                                   ns1:dipengaruhiOleh ns1:KelembapanTinggiPadaPenyakitEmbunTepungKacangHijau ,
                                                       ns1:SuhuPadaPenyakitEmbunTepungKacangHijau ;
                                   ns1:disebabkanOleh ns1:ErysiphePolygoni ;
                                   ns1:memilikiGejala ns1:PengamatanPenyakitEmbunTepungKacangHijauTepungDaun ;
                                   ns1:memilikiReferensi ns1:BukuDOC005 ;
                                   ns1:menyerangBagian ns1:Biji ;
                                   ns1:menyerangTanaman ns1:KacangHijau ;
                                   ns1:deskripsiPenyakit "Salah satu penyakit utama pada kacang hijau adalah embun tepung. Meskipun telah lama diketahui namun jarang dikendalikan karena keterbatasan pengetahuan petani terhadap penyakit tersebut. Penyakit embun tepung tersebar luas di seluruh negara sentra produksi kacang hijau, meliputi India, Pakistan, Thailand, China, Myanmar, dan Indonesia (Khodaparast dan Abbasi 2009, Nair et al. 2014). Penurunan hasil kacang hijau akibat penyakit embun tepung di Thailand mencapai 26,2% (Tantanapornkul et al. 2005). Petani jarang mengendalikan penyakit embun tepung, dan jika dikendalikan masih menggunakan fungisida yang tidak ramah lingkungan."@id ;
                                   ns1:identifierSumber "DIS_123" ;
                                   ns1:tingkatKeparahan "Penurunan hasil kacang hijau akibat penyakit embun tepung di Thailand mencapai 26,2% (Tantanapornkul et al. 2005)."@id ;
                                   rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                                "Salah satu penyakit utama pada kacang hijau adalah embun tepung. Meskipun telah lama diketahui namun jarang dikendalikan karena keterbatasan pengetahuan petani terhadap penyakit tersebut. Penyakit embun tepung tersebar luas di seluruh negara sentra produksi kacang hijau, meliputi India, Pakistan, Thailand, China, Myanmar, dan Indonesia (Khodaparast dan Abbasi 2009, Nair et al. 2014). Penurunan hasil kacang hijau akibat penyakit embun tepung di Thailand mencapai 26,2% (Tantanapornkul et al. 2005). Petani jarang mengendalikan penyakit embun tepung, dan jika dikendalikan masih menggunakan fungisida yang tidak ramah lingkungan."@id ;
                                   rdfs:label "Penyakit Embun Tepung"@id ;
                                   skos:altLabel "EMBUN TEPUNG"@id ;
                                   skos:prefLabel "Penyakit Embun Tepung"@id .


