ns1:PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianAplikasiInsektisidaDeltametrinYangDigabungkan_a9060a54,
        ns1:PengendalianEradikasiTerhadapSumberSumberInokulumMenjadi_18cee9a2,
