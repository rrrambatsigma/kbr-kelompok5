ns1:UbiKayu a ns1:TanamanPangan,
        ns1:UmbiUmbian,
        owl:NamedIndividual ;
    rdfs:label "Ubi kayu"@id ;
    ns1:berkaitanPengendalian ns1:KarantinaTanaman,
        ns1:PanenTepatWaktu,
        ns1:PemupukanBerimbang,
        ns1:PengairanDanDrainase,
        ns1:PengaturanJarakTanam,
        ns1:PenggunaanVarietasTahan,
        ns1:PengumpulanDanPemusnahan,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    ns1:deskripsiTanaman "Indonesia dengan keragaman budayanya turut membentuk keragaman makanan pokok masyarakatnya yang disebabkan oleh kearifan lokal serta adat. Hal ini mengakibatkan masyarakat membudidayakan tanaman pangan tersebut, meskipun pada kalangan masyarakat Indonesia secara umum saat ini identik dengan nasi sebagai makanan pokok atau utama. Pola konsumsi yang diperkenalkan oleh para leluhur dan terjadi secara turun temurun, menyebabkan masyarakat adat membudidayakan tanaman-tanaman tersebut sebagai sumber pangan yang juga dimanfaatkan sebagai makanan pokok. Tanaman pangan yang dimanfaatkan sebagai makanan pokok di Indonesia di antaranya yaitu merupakan kelompok umbi-umbian, antara lain ubi kayu, ubi jalar, gembili, ganyong."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianUmumUbiKayuPemberianPupukKClPenambahanZincMicro,
        ns1:BuktiPengendalianUmumUbiKayuPengendalianPerbaikanTeknikBudidayaTepat,
        ns1:BuktiPengendalianUmumUbiKayuSelainTindakanPengendalianDilakukanMelalui,
        ns1:BuktiPengendalianUmumUbiKayuUmbiTerjadiPascapanenDicegahWaktu,
        ns1:BuktiPengendalianUmumUbiKayuUpayaMengurangiKehilanganPanenPenurunan ;
    ns1:diserangPenyakit ns1:AntraknosaUbiKayuBatang,
        ns1:AntraknosaUbiKayuDaun,
        ns1:BercakDaunBaurUbiKayu,
        ns1:BercakDaunCoklatUbiKayu,
        ns1:BercakDaunPutihUbiKayu,
        ns1:BusukAkarDanUmbiUbiKayu,
        ns1:BusukAkarUbiKayu,
        ns1:BusukPangkalBatangUbiKayu,
        ns1:BusukUmbiUbiKayu,
        ns1:CassavaBrownStreakDiseaseCBSDUbiKayu,
        ns1:CassavaMosaicBegomovirusCMBsUbiKayu,
        ns1:HawarBakteriUbiKayu,
        ns1:HawarDaunBakteriUbiKayu,
        ns1:NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu,
        ns1:SapuSetanWitchesBroomUbiKayu,
        ns1:SuperelongasiUbiKayu,
        ns1:TanamanKerdilStuntUbiKayu ;
    ns1:identifierSumber "PLANT_005" ;
    ns1:memilikiKondisiTumbuh ns1:KondisiTanahSubur ;
    ns1:namaIlmiah "Manihot esculenta Crantz" ;
    ns1:pengendalianUmum ns1:KarantinaTanaman,
        ns1:PanenTepatWaktu,
        ns1:PemupukanBerimbang,
        ns1:PengairanDanDrainase,
        ns1:PengaturanJarakTanam,
        ns1:PenggunaanVarietasTahan,
        ns1:PengumpulanDanPemusnahan,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    rdfs:comment "Indonesia dengan keragaman budayanya turut membentuk keragaman makanan pokok masyarakatnya yang disebabkan oleh kearifan lokal serta adat. Hal ini mengakibatkan masyarakat membudidayakan tanaman pangan tersebut, meskipun pada kalangan masyarakat Indonesia secara umum saat ini identik dengan nasi sebagai makanan pokok atau utama. Pola konsumsi yang diperkenalkan oleh para leluhur dan terjadi secara turun temurun, menyebabkan masyarakat adat membudidayakan tanaman-tanaman tersebut sebagai sumber pangan yang juga dimanfaatkan sebagai makanan pokok. Tanaman pangan yang dimanfaatkan sebagai makanan pokok di Indonesia di antaranya yaitu merupakan kelompok umbi-umbian, antara lain ubi kayu, ubi jalar, gembili, ganyong."@id,
        "Tanaman pangan dalam ruang lingkup knowledge base."@id ;
    skos:prefLabel "Ubi kayu"@id .

ns1:Akar a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Akar"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id,
