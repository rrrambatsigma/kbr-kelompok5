    ns1:memilikiGejala ns1:GejalaPenyakitKaratDaunKacangTanahBercakDaun,
        ns1:GejalaPenyakitKaratDaunKacangTanahBercakTanaman,
        ns1:GejalaPenyakitKaratDaunKacangTanahKlorosisDaun,
        ns1:GejalaPenyakitKaratDaunKacangTanahKlorosisTanaman,
        ns1:GejalaPenyakitKaratDaunKacangTanahTepungDaun ;
    ns1:memilikiReferensi ns1:BukuDOC005 ;
    ns1:menyerangBagian ns1:Daun ;
    ns1:menyerangTanaman ns1:KacangTanah ;
    ns1:tingkatKeparahan "Kehilangan hasil mencapai 57% (Semangun 1991)."@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Di Indonesia, penyakit karat pada kacang tanah merupakan penyakit penting ke dua setelah bercak daun. Penyakit ini tersebar luas di daerah sentra penghasil kacang tanah seperti Jawa Timur, Bali, dan Nusa Tenggara Barat. Kehilangan hasil mencapai 57% (Semangun 1991). Kehilangan hasil yang diakibatkan penyakit karat dapat mencapai 6–57% (Subramanyam dan Mc Donald 1984)."@id ;
    skos:altLabel "KARAT"@id ;
    skos:prefLabel "Penyakit Karat Daun"@id .

ns1:PenyakitLayuFusariumKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Layu Fusarium"@id ;
    ns1:berkaitanPengendalian ns1:PemupukanBerimbang,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanFungisida,
        ns1:PenggunaanMulsa,
        ns1:PenggunaanTrichoderma,
        ns1:PerlakuanBenih,
        ns1:SolarisasiTanah ;
    ns1:deskripsiPenyakit "Penyakit layu Fusarium dikenal dengan penyakit busuk akar yang menginfeksi tanaman kedelai dan menyebabkan kematian (Bawa et al., 2018). Penyakit disebabkan oleh patogen Fusarium spp. Beberapa spesies dari patogen yang menginfeksi tanaman kedelai seperti F. solani (Bawa et al., 2018), F. virgulivorme (Baetsen-Young et al., 2020), F. sporotrichioides, F. graminearum, F. proliferatum (Okello et al., 2020). F. proliferatum juga menjadi masalah penting pada kedelai di Kanada (Chang et al., 2015)."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitLayuFusariumKedelai,
        ns1:BuktiPengendalianPenyakitLayuFusariumKedelai,
        ns1:BuktiPengendalianPenyakitLayuFusariumKedelai2,
        ns1:BuktiPengendalianPenyakitLayuFusariumKedelai3,
        ns1:BuktiPengendalianPenyakitLayuFusariumKedelai4,
        ns1:BuktiPenyakitPenyakitLayuFusariumKedelai ;
    ns1:dikendalikanDengan ns1:PemupukanBerimbang,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanFungisida,
        ns1:PenggunaanMulsa,
        ns1:PenggunaanTrichoderma,
        ns1:PerlakuanBenih,
        ns1:SolarisasiTanah ;
    ns1:dipengaruhiOleh ns1:CuacaSejukDanBasahPadaPenyakitLayuFusariumKedelai ;
    ns1:disebabkanOleh ns1:FusariumSpp ;
    ns1:identifierSumber "DIS_008" ;
    ns1:memilikiGejala ns1:GejalaPenyakitLayuFusariumKedelai,
        ns1:GejalaPenyakitLayuFusariumKedelaiBusukAkar,
        ns1:GejalaPenyakitLayuFusariumKedelaiKematianTanaman,
        ns1:GejalaPenyakitLayuFusariumKedelaiLayuDaun,
        ns1:GejalaPenyakitLayuFusariumKedelaiNekrosisTanaman ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Akar,
        ns1:Daun ;
    ns1:menyerangTanaman ns1:Kedelai ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit layu Fusarium dikenal dengan penyakit busuk akar yang menginfeksi tanaman kedelai dan menyebabkan kematian (Bawa et al., 2018). Penyakit disebabkan oleh patogen Fusarium spp. Beberapa spesies dari patogen yang menginfeksi tanaman kedelai seperti F. solani (Bawa et al., 2018), F. virgulivorme (Baetsen-Young et al., 2020), F. sporotrichioides, F. graminearum, F. proliferatum (Okello et al., 2020). F. proliferatum juga menjadi masalah penting pada kedelai di Kanada (Chang et al., 2015)."@id ;
    skos:prefLabel "Penyakit Layu Fusarium"@id .

