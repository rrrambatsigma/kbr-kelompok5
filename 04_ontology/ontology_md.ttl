ns1:PengamatanPenyakitKudisUbiJalarInokulumBiasanyaBerasalBahanTanam a ns1:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala Penyakit kudis"@id ;
    ns1:deskripsiGejala "Sumber inokulum penyakit kudis biasanya berasal dari bahan tanam (setek) yang terinfeksi jamur, penyakit ini menyebar lebih cepat ke tanaman yang sehat percikan air hujan yang disertai angin, lebih banyak terjadi serangan pada musim hujan (Saleh and Rahayuningsih, 2013)."@id ;
    ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalarInokulumBiasanyaBerasalBahanTanam ;
    ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
