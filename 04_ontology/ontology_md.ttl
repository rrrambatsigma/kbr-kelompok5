    skos:prefLabel "Kerdil tanaman pada Penyakit Tungro (Padi)"@id .

ns1:GejalaSapuSetanWitchesBroomUbiKayuKerdilTanaman a ns1:GejalaBatang,
        owl:NamedIndividual ;
