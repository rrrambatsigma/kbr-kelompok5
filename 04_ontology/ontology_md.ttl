        ns1:GejalaTanamanAkanLayuAkibatAkar_181af0f3 ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangTanaman ns1:Kedelai .

ns1:PenyakitHawarDaunJagung a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Hawar Daun"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianAplikasiDilakukanSebanyakEnamKali_91b2b9bd,
        ns1:PengendalianBerdasarkanLimaTingkatKonsentrasiTribac_ffc282fd,
        ns1:PengendalianDanBakteriAntagonisCorynebacteriumDengan_a4108ad8,
        ns1:PengendalianHalIniDikarenakanIntensitasPenyakit_f0a3fccc,
        ns1:PengendalianHalIniKarenaKondisiSanitasi_22754534,
        ns1:PengendalianPemanfaatanAgensHayatiUntukMenekan_5004f5cf,
        ns1:PengendalianPengendalianHawarDaunPadaJagung_d6d52ce4,
        ns1:PengendalianSelainItuJugaDapatDilakukan_dd7aed86 ;
    ns1:deskripsiPenyakit "Penyakit hawar daun pada jagung disebabkan oleh jamur patogen Helminthosporium maydis Y. Nisik & C.Miyake (Kuilya et al., 2018; Hamidson, Suwandi and Effendy, 2019) atau Helminthosporium turticum (Pass.) Leonard et Suggs (Faizah, 2017). Koloni Helinthosporium maydis yang ditumbuhkan pada media PDA awalnya berwarna keputihan kusam, coklat pucat, selanjutnya menjadi berwarna coklat agak gelap. Hifanya bersekat dengan sekat agak longgar. Konidia berdinding tipis dan mempunyai 7-10 sekat. Setelah 8 hari ditumbuhkan pada media PDA, panjang diameter mencapai 8.75 cm."@id ;
    ns1:dikendalikanDengan ns1:PengendalianAplikasiDilakukanSebanyakEnamKali_91b2b9bd,
        ns1:PengendalianBerdasarkanLimaTingkatKonsentrasiTribac_ffc282fd,
        ns1:PengendalianDanBakteriAntagonisCorynebacteriumDengan_a4108ad8,
