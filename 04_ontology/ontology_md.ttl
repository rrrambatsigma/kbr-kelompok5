    skos:prefLabel "Busuk akar pada Penyakit Rebah Kecambah (Kedelai)"@id .

ns1:GejalaPenyakitRebahSemaiKedelaiBercakTanaman a ns1:GejalaBatang,
        owl:NamedIndividual ;
    rdfs:label "Bercak pada tanaman pada Penyakit Rebah Semai (Kedelai)"@id ;
    ns1:deskripsiGejala "Patogen ini mampu menginfeksi tanaman pada saat tanaman kedelai berumur 2-3 minggu setelah tanam yang ditandai dengan gejala bercak coklat pada bagian pangkal batang tanaman kedelai (Sofiani et al., 2016)."@id ;
