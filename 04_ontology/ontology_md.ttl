        ns1:ObservasiPenyakitKaratDaunJagungSuhu25Koma2Sampai28Koma8Celsius ;
    ns1:disebabkanOleh ns1:PucciniaPolysora ;
    ns1:identifierSumber "DIS_045" ;
    ns1:memilikiGejala ns1:PengamatanPenyakitKaratDaunJagungBerkembangSuhuKelembaban,
        ns1:PengamatanPenyakitKaratDaunJagungBiasanyaDiawaliBagianBawahBerkembang,
        ns1:PengamatanPenyakitKaratDaunJagungBintilBerbentukBulatOvalSaling,
        ns1:PengamatanPenyakitKaratDaunJagungBintilPecahSporaKeluarTerbawa,
        ns1:PengamatanPenyakitKaratDaunJagungDisebabkanBerkisar2667Hingga,
        ns1:PengamatanPenyakitKaratDaunJagungHamidsonEtAl2019Mencapai,
        ns1:PengamatanPenyakitKaratDaunJagungKlorosisDaun,
