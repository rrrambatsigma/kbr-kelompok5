###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#KacangHijau
ns1:KacangHijau rdf:type owl:NamedIndividual ,
                         ns1:EntitasKBR ,
                         ns1:Legum ,
                         ns1:TanamanPangan ,
                         [ rdf:type owl:Class ;
                           owl:oneOf ( ns1:KacangHijau
                                       ns1:KacangTanah
                                       ns1:Kedelai
                                     )
                         ] ;
                ns1:diserangPenyakit ns1:PenyakitBercakDaunKacangHijau ,
                                     ns1:PenyakitEmbunTepungKacangHijau ,
                                     ns1:PenyakitLayuKacangHijau ;
                ns1:memilikiKondisiTumbuh ns1:KondisiSuhuHangat ;
                ns1:memilikiVarietas ns1:VarietasVima4 ,
                                     ns1:VarietasVima5 ;
                ns1:deskripsiTanaman "Kacang hijau (Vigna radiata) adalah tanaman legum berumur pendek yang termasuk dalam famili Leguminosae (Wilczek, 1954; Verdcourt, 1970). Kacang hijau berasal dari India (De Candole, 1886; Zhukovsky, 1950; Bailey, 1970) atau wilayah Indo-Burma (Vavilov, 1951; H.B. Singh et al., 1970; Jain dan Mehra, 1980). Tanaman ini diproduksi dalam skala besar di Asia bagian selatan dan timur. Kacang hijau merupakan sumber pangan penting bagi protein dan nutrisi esensial lainnya di Asia Selatan dan Barat, serta Afrika Utara dan Timur. Kacang hijau mengandung 26% protein, serta 51% karbohidrat, 10% kadar air, 4% mineral, dan 3% vitamin. Biji kacang hijau mengandung lisin, asam amino esensial yang hanya ditemukan dalam kadar rendah pada protein serealia. Kacang hijau adalah pangan manusia yang bernilai, kebanyakan dikonsumsi dalam bentuk biji kering, juga digunakan sebagai pakan ternak, dan umumnya ditanam sebagai tanaman rotasi setelah serealia untuk memperkaya tanah melalui kemampuannya mengikat nitrogen. Produksi kacang hijau terutama (90%) berada di Asia: India adalah produsen terbesar dengan lebih dari 50% produksi dunia, tetapi mengonsumsi hampir seluruh produksinya sendiri. Tiongkok memproduksi kacang hijau dalam jumlah besar, yang mewakili 19% dari produksi legumnya."@id ;
                ns1:identifierSumber "PLANT_020" ;
                ns1:namaIlmiah "Vigna radiata (L.) R. Wilczek" ;
                rdfs:comment "Kacang hijau (Vigna radiata) adalah tanaman legum berumur pendek yang termasuk dalam famili Leguminosae (Wilczek, 1954; Verdcourt, 1970). Kacang hijau berasal dari India (De Candole, 1886; Zhukovsky, 1950; Bailey, 1970) atau wilayah Indo-Burma (Vavilov, 1951; H.B. Singh et al., 1970; Jain dan Mehra, 1980). Tanaman ini diproduksi dalam skala besar di Asia bagian selatan dan timur. Kacang hijau merupakan sumber pangan penting bagi protein dan nutrisi esensial lainnya di Asia Selatan dan Barat, serta Afrika Utara dan Timur. Kacang hijau mengandung 26% protein, serta 51% karbohidrat, 10% kadar air, 4% mineral, dan 3% vitamin. Biji kacang hijau mengandung lisin, asam amino esensial yang hanya ditemukan dalam kadar rendah pada protein serealia. Kacang hijau adalah pangan manusia yang bernilai, kebanyakan dikonsumsi dalam bentuk biji kering, juga digunakan sebagai pakan ternak, dan umumnya ditanam sebagai tanaman rotasi setelah serealia untuk memperkaya tanah melalui kemampuannya mengikat nitrogen. Produksi kacang hijau terutama (90%) berada di Asia: India adalah produsen terbesar dengan lebih dari 50% produksi dunia, tetapi mengonsumsi hampir seluruh produksinya sendiri. Tiongkok memproduksi kacang hijau dalam jumlah besar, yang mewakili 19% dari produksi legumnya."@id ,
                             "Nama ilmiah dilengkapi dari Plants of the World Online (Kew) karena tidak tercantum pada sumber utama."@id ,
                             "Tanaman pangan dalam ruang lingkup knowledge base."@id ;
                rdfs:label "Kacang hijau"@id ;
                rdfs:seeAlso <https://powo.science.kew.org/results?q=Vigna%20radiata> ;
                skos:prefLabel "Kacang hijau"@id .


