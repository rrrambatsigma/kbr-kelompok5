kbr:PenyakitBusukPelepahJagung a kbr:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Busuk Pelepah"@id ;
    kbr:berkaitanPengendalian kbr:PenggunaanBacillus ;
    kbr:deskripsiPenyakit "Penyakit busuk pelepah disebabkan oleh jamur patogen Rhizoctonia solani. Patogen ini termasuk soil borne yang artinya merupakan patogen tular tanah sehingga dapat bertahan di tanah dan juga sisa tanaman dalam bentuk sklerotium. Sklerotium merupakan massa hifa yang mengumpul dan memadat yang awalnya berwarna putih dan kemudian berubah menjadi berwarna coklat. Jamur ini mempunyai banyak inang alternatif seperti tanaman kacang tanah, kedelai, kacang hijau dan sorgum (Soenartiningsih et al., 2015)."@id ;
    kbr:didukungOleh kbr:BuktiPatogenPenyakitBusukPelepahJagung,
        kbr:BuktiPengendalianPenyakitBusukPelepahJagung,
        kbr:BuktiPenyakitPenyakitBusukPelepahJagung ;
    kbr:dikendalikanDengan kbr:PenggunaanBacillus ;
    kbr:dipengaruhiOleh kbr:KelembapanTinggiPadaPenyakitBusukPelepahJagung,
        kbr:SuhuMinimal30CPadaPenyakitBusukPelepahJagung ;
    kbr:disebabkanOleh kbr:RhizoctoniaSolani ;
    kbr:identifierSumber "DIS_048" ;
    kbr:memilikiGejala kbr:GejalaPenyakitBusukPelepahJagungBercakTanaman,
        kbr:GejalaPenyakitBusukPelepahJagungBusukBatang ;
    kbr:memilikiReferensi kbr:BukuDOC002 ;
    kbr:menyerangBagian kbr:Batang,
        kbr:Buah,
        kbr:Daun ;
    kbr:menyerangTanaman kbr:Jagung ;
    dcterms:source "Kurasi pakar"@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ;
    skos:altLabel "Sheath rot"@en ;
    skos:definition "Penyakit Busuk Pelepah pada tanaman Jagung, disebabkan oleh Rhizoctonia solani, dengan gejala antara lain Bercak pada tanaman, Busuk batang."@id ;
    skos:prefLabel "Sheath rot"@en,
        "Penyakit Busuk Pelepah"@id .

