        owl:NamedIndividual ;
    rdfs:label "Penyakit Karat Daun"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianBeberapaVarietasYangAgakTahan_d34c4fac,
        ns1:PengendalianHampirBeberapaVarietasUnggulKedelai_a8764255,
        ns1:PengendalianPachyrhiziAdalahVarietasAnjasmoroTanggamus_17fb648e,
        ns1:PengendalianPachyrhiziMelaluiAntibiosisHiperparasitDan_2f5ee622,
        ns1:PengendalianPemanfaatanAgensHayatiSepertiBacillus_6921bd45,
        ns1:PengendalianPemanfaatanMinyakCengkehSebagaiPestisida_c64b92ef,
        ns1:PengendalianPenanamanVarietasToleranJugaMenjadi_a1e7e85a,
        ns1:PengendalianPengendalianDapatDilakukanDenganMenanam_750e50f1,
        ns1:PengendalianPengendalianDapatDilakukanDenganMenanam_86e2c55a,
        ns1:PengendalianPengendalianDenganFungisidaBerbahanAktif_4fab6da6,
        ns1:PengendalianVarietasKedelaiYangToleranSeperti_da5d2a15 ;
    ns1:deskripsiPenyakit "Penyakit karat daun yang disebabkan oleh patogen Phakopspora pachyrhizi merupakan penyakit penting pada tanaman kedelai. Akibat serangan oleh patogen ini menyebabkan penurunan produksi polong kedelai mencapai 30- 60%. Patogen bersifat parasit obligat. Kondisi lingkungan yang mendukung untuk perkembangan patogen ini adalah pada suhu 27,50C. Perkembangan penyakit tidak akan terjadi apabila suhu yang ada di lahan lebih dari 27,50C. Faktor curah hujan yang tinggi sangat memengaruhi perkembangan penyakit menjadi lebih tinggi (Utama and Sjamsijah, 2019). Inayati and Yusnawan, (2017) menyatakan bahwa perkembangan penyakit karat daun tinggi pada"@id ;
    ns1:dikendalikanDengan ns1:PengendalianBeberapaVarietasYangAgakTahan_d34c4fac,
        ns1:PengendalianHampirBeberapaVarietasUnggulKedelai_a8764255,
