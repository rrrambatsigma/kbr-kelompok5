    skos:definition "Penyakit yang disebabkan oleh patogen kelompok oomycete."@id ;
    skos:prefLabel "Penyakit Oomycete"@id .

kbr:PenyakitVirus a owl:Class ;
    rdfs:label "Penyakit Virus"@id ;
