                                    ns1:memilikiGejala ns1:PengamatanPenyakitBelangMottleKacangTanahBelangTanaman ,
                                                       ns1:PengamatanPenyakitBelangMottleKacangTanahKlorosisDaun ,
                                                       ns1:PengamatanPenyakitBelangMottleKacangTanahKlorosisTanaman ,
                                                       ns1:PengamatanPenyakitBelangMottleKacangTanahMakroskopisDitunjukkanGambar4 ,
                                                       ns1:PengamatanPenyakitBelangMottleKacangTanahMosaikDaun ,
                                                       ns1:PengamatanPenyakitBelangMottleKacangTanahUmumnyaKeduaSukarDibedakan ;
                                    ns1:memilikiReferensi ns1:BukuDOC002 ;
                                    ns1:menyerangBagian ns1:Daun ;
                                    ns1:menyerangTanaman ns1:KacangTanah ;
                                    ns1:deskripsiPenyakit "Penyakit belang merupakan penyakit yang disebabkan oleh virus. Virus yang menyerang yaitu Peanut mottle virus (PeMoV) maupun Peanut stripe virus (PStV). Serangga vektor yang membawa virus menginfeksi tanaman kacang tanah adalah Aphids sp. Aphis dengan tipe mulut mencucuk menghisap merupakan vektor PStV yang efisien. Silet Aphis dalam waktu singkat dapat menghisap cairan daun yang berada di jaringan epidermis dan endodermis. Ukuran tubuh yang kecil dan ringan menyebabkan penyebaran hama ini terjadi secara pasif dengan bantuan angin. Secara alami, penyebaran Aphis dapat mencapai 50-100."@id ;
                                    ns1:identifierSumber "DIS_022" ;
                                    ns1:namaInggrisPenyakit "Mottle" ;
                                    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                                 "Penyakit belang merupakan penyakit yang disebabkan oleh virus. Virus yang menyerang yaitu Peanut mottle virus (PeMoV) maupun Peanut stripe virus (PStV). Serangga vektor yang membawa virus menginfeksi tanaman kacang tanah adalah Aphids sp. Aphis dengan tipe mulut mencucuk menghisap merupakan vektor PStV yang efisien. Silet Aphis dalam waktu singkat dapat menghisap cairan daun yang berada di jaringan epidermis dan endodermis. Ukuran tubuh yang kecil dan ringan menyebabkan penyebaran hama ini terjadi secara pasif dengan bantuan angin. Secara alami, penyebaran Aphis dapat mencapai 50-100."@id ;
                                    rdfs:label "Penyakit Belang (Mottle)"@id ;
                                    skos:altLabel "Mottle"@id ;
                                    skos:prefLabel "Penyakit Belang (Mottle)"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakBijiUnguKedelai
ns1:PenyakitBercakBijiUnguKedelai rdf:type owl:NamedIndividual ,
