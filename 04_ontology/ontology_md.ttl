###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanJarakTanam
ns1:PengaturanJarakTanam rdf:type owl:NamedIndividual ,
                                  ns1:PengendalianKulturTeknis ;
                         ns1:didukungOleh ns1:BuktiPengendalianPenyakitBercakDaunKacangHijauMenjagaAgarLingkunganMikroBawah ,
                                          ns1:BuktiPengendalianPenyakitHawarPelepahDaunPadiPengendalianAntaranyaKulturTeknisMelalui ,
                                          ns1:BuktiPengendalianPenyakitKaratDaunJagungUpayaPengendalianDilakukanJarakTanam ,
                                          ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiPengaturanWaktuTanamJarakTanam ,
                                          ns1:BuktiPengendalianUmumUbiKayuPengendalianPerbaikanTeknikBudidayaTepat ;
                         ns1:mengendalikanPenyakit ns1:PenyakitBercakDaunKacangHijau ,
                                                   ns1:PenyakitHawarPelepahDaunPadi ,
                                                   ns1:PenyakitKaratDaunJagung ,
                                                   ns1:PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai ;
                         ns1:deskripsiPengendalian "Beberapa pengendalian penyakit hawar daun bakteri pada padi, di antaranya Kultur teknis, melalui pengaturan jarak tanam tidak terlalu rapat, pengeringan sawah beberapa hari pada saat anakan maksimum, pemusnahan atau pengomposan sisa-sisa tanaman yang terinfeksi (Puslitbangtan 2005)."@id ;
                         ns1:namaPengendalian "Pengaturan jarak tanam"@id ;
                         rdfs:comment "Beberapa pengendalian penyakit hawar daun bakteri pada padi, di antaranya Kultur teknis, melalui pengaturan jarak tanam tidak terlalu rapat, pengeringan sawah beberapa hari pada saat anakan maksimum, pemusnahan atau pengomposan sisa-sisa tanaman yang terinfeksi (Puslitbangtan 2005)."@id ,
                                      "Tindakan kanonik pengaturan jarak atau kerapatan tanam."@id ;
                         rdfs:label "Pengaturan jarak tanam"@id ;
                         skos:prefLabel "Pengaturan jarak tanam"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanKelembapan
ns1:PengaturanKelembapan rdf:type owl:NamedIndividual ,
                                  ns1:PengendalianKulturTeknis ;
                         ns1:didukungOleh ns1:BuktiPengendalianPenyakitBercakDaunKacangHijauMenjagaAgarLingkunganMikroBawah ,
                                          ns1:BuktiPengendalianPenyakitKaratDaunJagungUpayaPengendalianDilakukanJarakTanam ;
                         ns1:mengendalikanPenyakit ns1:PenyakitBercakDaunKacangHijau ,
                                                   ns1:PenyakitKaratDaunJagung ;
                         ns1:deskripsiPengendalian "Upaya pengendalian karat jagung dapat dilakukan dengan beberapa cara seperti jarak tanam yang tidak terlalu rapat dan penyiangan gulma rutin sehingga sirkulasi udara lebih baik dan kelembaban tidak terlalu tinggi."@id ;
                         ns1:namaPengendalian "Pengaturan kelembapan"@id ;
                         rdfs:comment "Tindakan kanonik pengaturan kelembapan dan sirkulasi udara."@id ,
                                      "Upaya pengendalian karat jagung dapat dilakukan dengan beberapa cara seperti jarak tanam yang tidak terlalu rapat dan penyiangan gulma rutin sehingga sirkulasi udara lebih baik dan kelembaban tidak terlalu tinggi."@id ;
                         rdfs:label "Pengaturan kelembapan"@id ;
                         skos:prefLabel "Pengaturan kelembapan"@id .


