ns1:Buku a owl:Class ;
    rdfs:label "Buku"@id ;
    rdfs:comment "Penyakit blas menjadi salah satu penyakit utama tanaman padi karena dapat menyerang beberapa bagian tanaman seperti daun, buku batang, leher malai, bulir pada, bahkan kolar daun (BBPADI 2015)."@id,
        "Referensi berbentuk buku."@id ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDatatype xsd:integer ;
            owl:onProperty ns1:tahunTerbit ],
        ns1:Referensi ;
    skos:prefLabel "Buku"@id .

