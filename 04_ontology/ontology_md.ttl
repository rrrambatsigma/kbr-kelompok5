    ns1:kutipanSumber "pachyrhizi adalah varietas Anjasmoro, Tanggamus, Kaba, dan Sinabung yang diketahui tingkat ketahanan agak tahan."@id ;
    rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
    skos:prefLabel "Bukti varietas Penyakit Karat Daun"@id ;
