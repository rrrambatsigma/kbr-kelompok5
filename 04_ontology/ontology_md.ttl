kbr:GejalaPenyakitAntraknosaKedelaiDaunRontok a kbr:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Daun rontok"@id ;
    kbr:deskripsiGejala "Pada kondisi lembap, daun akan menggulung dan mudah gugur, sedangkan pada polong akan terlihat acervuli yang membentuk pola cincin konsentris (Gambar 6b)."@id ;
