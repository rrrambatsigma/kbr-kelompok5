                              ns1:dipengaruhiOleh ns1:TanahJenuhAirDanKelembapanTinggiPadaPenyakitRebahSemaiKedelai ;
                              ns1:disebabkanOleh ns1:SclerotiumRolfsii ;
                              ns1:memilikiGejala ns1:GejalaPenyakitRebahSemaiKedelai ,
                                                 ns1:GejalaPenyakitRebahSemaiKedelaiBercakTanaman ,
                                                 ns1:GejalaPenyakitRebahSemaiKedelaiBusukBatang ,
                                                 ns1:GejalaPenyakitRebahSemaiKedelaiKlorosisDaun ,
                                                 ns1:GejalaPenyakitRebahSemaiKedelaiLayuDaun ;
