kbr:GejalaLayuFusariumUbiJalarMiseliumPadaTanaman a kbr:GejalaBatang,
        owl:NamedIndividual ;
    rdfs:label "Miselium pada tanaman"@id ;
    kbr:deskripsiGejala "Selain itu, terjadi nekrosis pada bagian vaskular batang dengan perubahan warna coklat menjadi ungu yang disertai pecahnya korteks batang dan miselium tumbuh pada permukaan batang yang terinfeksi (Gambar 1G dan F)."@id ;
    kbr:didukungOleh kbr:BuktiGejalaLayuFusariumUbiJalar4,
        kbr:BuktiGejalaLayuFusariumUbiJalar5 ;
