kbr:PenyakitKaratDaunJagung a kbr:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Karat Daun"@id ;
    kbr:berkaitanPengendalian kbr:PengaturanJarakTanam,
        kbr:PengaturanKelembapan,
        kbr:PengelolaanGulma,
        kbr:PenggunaanVarietasTahan,
        kbr:SanitasiLahan ;
    kbr:deskripsiPenyakit "Penyakit karat daun pada tanaman jagung disebabkan oleh Puccinia polysora Underw. Jamur patogen ini biasanya menimbulkan gejala pada bagian permukaan daun bagian atas, tidak pada bagian bawah daun. Keparahan lebih lanjut menyebabkan jaringan tanaman mengering dan nekrosis (Debnath et al., 2019)."@id ;
    kbr:didukungOleh kbr:BuktiLingkunganPenyakitKaratDaunJagung,
        kbr:BuktiLingkunganPenyakitKaratDaunJagung2,
        kbr:BuktiMetadataPhasePenyakitKaratDaunJagung,
        kbr:BuktiMetadataSeverityPenyakitKaratDaunJagung,
        kbr:BuktiPatogenPenyakitKaratDaunJagung,
        kbr:BuktiPengendalianPenyakitKaratDaunJagung,
        kbr:BuktiPengendalianPenyakitKaratDaunJagung2,
        kbr:BuktiPengendalianPenyakitKaratDaunJagung3,
        kbr:BuktiPenyakitPenyakitKaratDaunJagung ;
    kbr:dikendalikanDengan kbr:PengaturanJarakTanam,
        kbr:PengaturanKelembapan,
        kbr:PengelolaanGulma,
        kbr:PenggunaanVarietasTahan,
        kbr:SanitasiLahan ;
    kbr:dipengaruhiOleh kbr:KondisiSuhuRendah,
        kbr:ObservasiPenyakitKaratDaunJagungSuhu25Koma2Sampai28Koma8Celsius ;
    kbr:disebabkanOleh kbr:PucciniaPolysora ;
    kbr:identifierSumber "DIS_045" ;
    kbr:memilikiGejala kbr:GejalaPenyakitKaratDaunJagungBercakTanaman,
        kbr:GejalaPenyakitKaratDaunJagungKlorosisDaun ;
    kbr:memilikiReferensi kbr:BukuDOC002 ;
    kbr:menyerangBagian kbr:Daun ;
    kbr:menyerangFase kbr:FaseGeneratifUmum ;
    kbr:menyerangTanaman kbr:Jagung ;
    kbr:tingkatKeparahan "Keparahan penyakit yang disebabkan karat daun dapat berkisar antara 26.67% hingga 90.91%."@id ;
    dcterms:source "Kurasi pakar"@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ;
    skos:altLabel "Rust"@en ;
    skos:definition "Penyakit Karat Daun pada tanaman Jagung, disebabkan oleh Puccinia polysora, dengan gejala antara lain Bercak pada tanaman, Klorosis daun."@id ;
    skos:prefLabel "Rust"@en,
        "Penyakit Karat Daun"@id .

