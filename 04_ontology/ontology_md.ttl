        ns1:BuktiPenyakitPenyakitLayuBakteriKacangTanah ;
    ns1:dikendalikanDengan ns1:PengelolaanTerpadu,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
