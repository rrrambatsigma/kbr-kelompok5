                                 ns1:memilikiGejala ns1:PengamatanPenyakitBakteriPustulKedelaiBercakDaun ,
                                                    ns1:PengamatanPenyakitBakteriPustulKedelaiBercakTanaman ,
                                                    ns1:PengamatanPenyakitBakteriPustulKedelaiDaunRontok ,
