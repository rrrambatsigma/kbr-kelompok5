ns1:PenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Bercak Daun Mata Katak (Frogeye Leaf Spot)"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianMenurutInayatiAndYusnawan2017_cb6bf717,
        ns1:PengendalianPengendalianPenyakitIniDapatDilakukan_06c6f376,
        ns1:PengendalianPerlakuanBenihMenggunakanFungisidaBerbahan_02eba179,
        ns1:PengendalianSiklusPenyakitTerjadiMelaluiPenggunaan_ba257fdf,
        ns1:PengendalianSojinaDanMengaplikasikanFungisidaMian_b45b0901,
        ns1:PengendalianSojinaDapatDilakukanMenanamKedelai_6033c932 ;
    ns1:deskripsiPenyakit "Penyakit bercak daun mata katak (frogeye leaf spot) disebabkan oleh patogen Cercospora sojina K. Hara. Patogen C. sojina menginfeksi pada bagian permukaan daun, batang maupun pada polong kedelai. Infeksi sering terlihat pada bagian permukaan daun. Patogen C. sojina memiliki konidia yang terbentuk pada ujung konidiofor. Konidia berwarna hialin dengan ukuran 5-7 µm x 39-70µm. Konidia merupakan sumber inokulum primer dan sekunder untuk perkembangan penyakit bercak daun mata katak. Gejala yang muncul pada tanaman adalah adanya bercak atau bintik-bintik kecil dengan bagian tengah pada bintik berwarna lebih terang. Bintik pada daun kemudian berkembang menjadi bercak yang lebih lebar dengan pinggiran berwarna lebih coklat sampai kemerahan (Gambar 2.8). Pada intensitas serangan yang bintik menjadi berkembang pada bagian daun hingga menutupi 30% bagian"@id ;
    ns1:dikendalikanDengan ns1:PengendalianMenurutInayatiAndYusnawan2017_cb6bf717,
        ns1:PengendalianPengendalianPenyakitIniDapatDilakukan_06c6f376,
        ns1:PengendalianPerlakuanBenihMenggunakanFungisidaBerbahan_02eba179,
        ns1:PengendalianSiklusPenyakitTerjadiMelaluiPenggunaan_ba257fdf,
        ns1:PengendalianSojinaDanMengaplikasikanFungisidaMian_b45b0901,
        ns1:PengendalianSojinaDapatDilakukanMenanamKedelai_6033c932 ;
    ns1:dipengaruhiOleh ns1:KondisiSuhu ;
    ns1:disebabkanOleh ns1:CercosporaSojina ;
