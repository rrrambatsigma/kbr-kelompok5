    ns1:namaPengendalian "Penerapan pengendalian mekanis"@id ;
    rdfs:comment "Tindakan kanonik penerapan pengendalian mekanis secara umum."@id ;
    skos:prefLabel "Penerapan pengendalian mekanis"@id .

ns1:PengaturanKelembapan a ns1:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Pengaturan kelembapan"@id ;
    ns1:deskripsiPengendalian "Upaya pengendalian karat jagung dapat dilakukan dengan beberapa cara seperti jarak tanam yang tidak terlalu rapat dan penyiangan gulma rutin sehingga sirkulasi udara lebih baik dan kelembaban tidak terlalu tinggi."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitBercakDaunKacangHijauMenjagaAgarLingkunganMikroBawah,
        ns1:BuktiPengendalianPenyakitKaratDaunJagungUpayaPengendalianDilakukanJarakTanam ;
    ns1:mengendalikanPenyakit ns1:PenyakitBercakDaunKacangHijau,
        ns1:PenyakitKaratDaunJagung ;
    ns1:namaPengendalian "Pengaturan kelembapan"@id ;
    rdfs:comment "Tindakan kanonik pengaturan kelembapan dan sirkulasi udara."@id,
        "Upaya pengendalian karat jagung dapat dilakukan dengan beberapa cara seperti jarak tanam yang tidak terlalu rapat dan penyiangan gulma rutin sehingga sirkulasi udara lebih baik dan kelembaban tidak terlalu tinggi."@id ;
    skos:prefLabel "Pengaturan kelembapan"@id .

ns1:PenggunaanBeauveria a ns1:PengendalianBiologis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan Beauveria"@id ;
    ns1:deskripsiPengendalian "Pengendalian wereng coklat dapat dengan penggunaan cendawan entomopatogen seperti Metarhizium dan Beauveria."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitKerdilRumputDanKerdilHampaPadiPengendalianWerengCoklatPenggunaanCendawan,
        ns1:BuktiPengendalianPenyakitRebahSemaiKedelaiHarzianumBeauveriaBassianaMenginduksiTingkat ;
    ns1:mengendalikanPenyakit ns1:PenyakitKerdilRumputDanKerdilHampaPadi,
        ns1:PenyakitRebahSemaiKedelai ;
    ns1:namaPengendalian "Penggunaan Beauveria"@id ;
    rdfs:comment "Pengendalian wereng coklat dapat dengan penggunaan cendawan entomopatogen seperti Metarhizium dan Beauveria."@id,
        "Tindakan kanonik penggunaan Beauveria."@id ;
    skos:prefLabel "Penggunaan Beauveria"@id .

ns1:PenggunaanBiopestisida a ns1:PengendalianBiologis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan biopestisida"@id ;
    ns1:deskripsiPengendalian "Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitLayuBakteriKacangTanahKeamananHayatiProdukPertanianSemakin,
        ns1:BuktiPengendalianUmumKacangTanahKeamananHayatiProdukPertanianSemakin ;
    ns1:mengendalikanPenyakit ns1:PenyakitLayuBakteriKacangTanah ;
    ns1:namaPengendalian "Penggunaan biopestisida"@id ;
    rdfs:comment "Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati."@id,
        "Tindakan kanonik penggunaan biopestisida."@id ;
    skos:prefLabel "Penggunaan biopestisida"@id .

ns1:PenggunaanHerbisida a ns1:PengendalianKimiawi,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan herbisida"@id ;
    ns1:deskripsiPengendalian "Pestisida digolongkan menjadi beberapa macam di antaranya insektisida, fungisida, herbisida, rodentisida, dan nematosida."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitBercakDaunKacangTanahPestisidaDigolongkanMenjadiMacamAntaranya,
        ns1:BuktiPengendalianUmumKacangTanahPestisidaDigolongkanMenjadiMacamAntaranya ;
    ns1:mengendalikanPenyakit ns1:PenyakitBercakDaunKacangTanah ;
    ns1:namaPengendalian "Penggunaan herbisida"@id ;
    rdfs:comment "Pestisida digolongkan menjadi beberapa macam di antaranya insektisida, fungisida, herbisida, rodentisida, dan nematosida."@id,
        "Tindakan kanonik penggunaan herbisida."@id ;
    skos:prefLabel "Penggunaan herbisida"@id .

ns1:PenggunaanMetarhizium a ns1:PengendalianBiologis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan Metarhizium"@id ;
    ns1:deskripsiPengendalian "Selain itu dapat juga diaplikasikan cendawan entomopatogen seperti Metarhizium dan Beuveria."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianPenyakitKerdilRumputDanKerdilHampaPadiPengendalianWerengCoklatPenggunaanCendawan,
