ns1:PenggunaanVarietasTahan a ns1:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan varietas tahan"@id ;
    ns1:deskripsiPengendalian "Berbagai strategi pengendalian penyakit tungro dijelaskan sebagai berikut meliputi pemusnahan tanaman terinfeksi, penggunaan varietas tahan seperti Tukad Unda, Tukad Balian, Kalimas, dan Bondoyudo, penanaman serempak minimal 20 ha luasan sawah, serta penanaman sebelum puncak kepadatan wereng hijau (Puslitbangtan 2005)."@id ;
