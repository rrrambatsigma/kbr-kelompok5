kbr:BuktiPengendalianPenyakitKudisUbiJalar2 a kbr:BuktiPengendalian,
        owl:NamedIndividual ;
    rdfs:label "Bukti pengendalian Penyakit kudis (Ubi jalar)"@id ;
    kbr:catatanKualitas "Kutipan sumber berupa fragmen atau kalimat terpotong."@id ;
    kbr:dokumenSumber "DOC002" ;
    kbr:halamanSumber "84" ;
    kbr:idChunkSumber "DOC002_C084_04" ;
    kbr:identifierSumber "CTL_189" ;
    kbr:kutipanNormalisasi "batatas misalnya jagung, padi, kacang-kacangan, penanaman varietas campuran misalnya varietas yang tahan dengan yang agak tahan, sanitasi lahan dengan cara membakar atau mengubur dalam tanah sisa-sisa tanaman yang terinfeksi, menggunakan fungisida kimiawi misalnya menggunakan bahan aktif benomyl (dosis 400 g ba/ha), chlorotalonil (1.300 g ba/ha), captafol (1.520 g ba/ha), fentin hidraxide (300 g ba/ha), tembaga oxiklorida (1.500 g ba/ha), dan mancozeb, dapat juga menggunakan fungisida nabati (Saleh and Rahayuningsih, 2013)."@id ;
    kbr:kutipanSumber "batatas misalnya jagung, padi, kacang-kacangan, penanaman varietas campuran misalnya varietas yang tahan dengan yang agak tahan, sanitasi lahan dengan cara membakar atau mengubur dalam tanah sisa-sisa tanaman yang terinfeksi, menggunakan fungisida kimiawi misalnya menggunakan bahan aktif benomyl (dosis 400 g ba/ha), chlorotalonil (1.300 g ba/ha), captafol (1.520 g ba/ha), fentin hidraxide (300 g ba/ha), tembaga oxiklorida (1.500 g ba/ha), dan mancozeb, dapat juga menggunakan fungisida nabati (Saleh and Rahayuningsih, 2013)."@id ;
    rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
    skos:prefLabel "Bukti pengendalian Penyakit kudis (Ubi jalar)"@id ;
    prov:wasDerivedFrom kbr:BukuDOC002 .

kbr:BuktiPengendalianPenyakitLayuFusariumKedelai a kbr:BuktiPengendalian,
