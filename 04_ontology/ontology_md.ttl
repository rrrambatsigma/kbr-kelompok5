                                             ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                             ns1:deskripsiGejala "Pada awalnya bercak berwarna kuning coklat kekuningan, coklat kemerahan dan akhirnya menjadi coklat kehitaman (Martanto, Tanati and Baan, 2016)."@id ;
                                             rdfs:comment "Gejala bercak pada tanaman pada tanaman Ubi jalar: Pada awalnya bercak berwarna kuning coklat kekuningan, coklat kemerahan..."@id ,
                                                          "Pada awalnya bercak berwarna kuning coklat kekuningan, coklat kemerahan dan akhirnya menjadi coklat kehitaman (Martanto, Tanati and Baan, 2016)."@id ;
                                             rdfs:label "Bercak pada tanaman pada Penyakit kudis (Ubi jalar)"@id ;
                                             skos:prefLabel "Bercak pada tanaman pada Penyakit kudis (Ubi jalar)"@id .


