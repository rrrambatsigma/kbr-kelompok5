ns1:PenyakitHawarBakteriBacterialBlightKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Hawar Bakteri (Bacterial Blight)"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianBakteriBacillusSubtilisDanPseudomonas_be55974f,
        ns1:PengendalianMelakukanPergiliranTanamanAgarSiklus_7fcd06ec,
        ns1:PengendalianMenghilangkanTanamanYangDapatMenjadi_aacfc9fd,
        ns1:PengendalianPengendalianPenyakitIniDapatDitekan_2b9f7ff9,
        ns1:PengendalianSyringaeMenjadiAwalPengelolaanPerkembangan_1320c39a,
        ns1:PengendalianSyringaePadaTanamanKedelaiMajid_82b124e4 ;
    ns1:deskripsiPenyakit "Penyakit hawar bakteri (bacterial blight) disebabkan oleh patogen bakteri Pseudomonas syringae pv. glycine. Penyakit hawar bakteri menjadi salah satu penyakit yang menjadi kendala utama pada budidaya tanaman kedelai. Gejala tanaman yang disebabkan oleh patogen P. syringae pv. glycine diawali dengan munculnya bercak yang awalnya berwarna coklat kekuningan dengan ukuran bercak kecil. Pada tingkat serangan yang tinggi bercak kemudian menjadi hawar yang ditandai dengan warna kecokelatan dilingkari dengan lingkaran kuning dan menyebar tidak beraturan (Gambar 2.14)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianBakteriBacillusSubtilisDanPseudomonas_be55974f,
        ns1:PengendalianMelakukanPergiliranTanamanAgarSiklus_7fcd06ec,
