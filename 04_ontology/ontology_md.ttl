        ns1:BuktiPenyakitPenyakitEmbunTepungPowderyMildewKedelai ;
    ns1:dikendalikanDengan ns1:PemupukanBerimbang,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanTanamanBukanInang,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:KelembapanRendahDenganDaunBasahTerbatasPadaPenyakitEmbunTepungPowderyMildewKedelai,
        ns1:SuhuPadaPenyakitEmbunTepungPowderyMildewKedelai ;
    ns1:disebabkanOleh ns1:ErysiphaeDiffusa ;
    ns1:identifierSumber "DIS_010" ;
    ns1:memilikiGejala ns1:GejalaPenyakitEmbunTepungPowderyMildewKedelaiBercakDaun,
        ns1:GejalaPenyakitEmbunTepungPowderyMildewKedelaiTepungDaun ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Daun ;
    ns1:menyerangTanaman ns1:Kedelai ;
    ns1:namaInggrisPenyakit "Powdery Mildew" ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit ini disebabkan oleh cendawan Erysiphae diffusa yang menginfeksi tanaman kedelai. Patogen E. diffusa menginfeksi daun kedelai bagian bawah sehingga pada permukaan daun bagian bawah terdapat bercak berwarna putih seperti tepung yang merupakan kumpulan dari konidia dan konidiofor patogen"@id ;
    skos:altLabel "Powdery Mildew"@id ;
    skos:prefLabel "Penyakit Embun Tepung (Powdery Mildew)"@id .

ns1:PenyakitHawarDaunJagung a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Hawar Daun"@id ;
    ns1:berkaitanPengendalian ns1:PengelolaanGulma,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanTrichoderma,
        ns1:PenggunaanVarietasTahan,
        ns1:SanitasiLahan ;
    ns1:deskripsiPenyakit "Penyakit hawar daun pada jagung disebabkan oleh jamur patogen Helminthosporium maydis Y. Nisik & C.Miyake (Kuilya et al., 2018; Hamidson, Suwandi and Effendy, 2019) atau Helminthosporium turticum (Pass.) Leonard et Suggs (Faizah, 2017). Koloni Helinthosporium maydis yang ditumbuhkan pada media PDA awalnya berwarna keputihan kusam, coklat pucat, selanjutnya menjadi berwarna coklat agak gelap. Hifanya bersekat dengan sekat agak longgar. Konidia berdinding tipis dan mempunyai 7-10 sekat. Setelah 8 hari ditumbuhkan pada media PDA, panjang diameter mencapai 8.75 cm."@id ;
    ns1:didukungOleh ns1:BuktiMetadataPhasePenyakitHawarDaunJagung,
        ns1:BuktiMetadataSeverityPenyakitHawarDaunJagung,
        ns1:BuktiPatogenPenyakitHawarDaunJagung,
        ns1:BuktiPengendalianPenyakitHawarDaunJagung,
        ns1:BuktiPengendalianPenyakitHawarDaunJagung2,
        ns1:BuktiPengendalianPenyakitHawarDaunJagung3,
        ns1:BuktiPengendalianPenyakitHawarDaunJagung4,
        ns1:BuktiPengendalianPenyakitHawarDaunJagung5,
        ns1:BuktiPengendalianPenyakitHawarDaunJagung6,
        ns1:BuktiPengendalianPenyakitHawarDaunJagung7,
        ns1:BuktiPengendalianPenyakitHawarDaunJagung8,
        ns1:BuktiPenyakitPenyakitHawarDaunJagung ;
    ns1:dikendalikanDengan ns1:PengelolaanGulma,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanTrichoderma,
        ns1:PenggunaanVarietasTahan,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:DaunBasahPadaPenyakitHawarDaunJagung,
        ns1:SuhuPadaPenyakitHawarDaunJagung ;
    ns1:disebabkanOleh ns1:HelminthosporiumMaydis ;
    ns1:identifierSumber "DIS_044" ;
    ns1:memilikiGejala ns1:GejalaPenyakitHawarDaunJagungBercakDaun,
        ns1:GejalaPenyakitHawarDaunJagungBercakTanaman,
        ns1:GejalaPenyakitHawarDaunJagungHawarDaun,
        ns1:GejalaPenyakitHawarDaunJagungNekrosisDaun ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Daun ;
    ns1:menyerangFase ns1:FaseGeneratifUmum ;
    ns1:menyerangTanaman ns1:Jagung ;
    ns1:tingkatKeparahan "Keparahan penyakit hawar jagung terus meningkat pada setiap pengamatan dari 40.83% hingga 83.78%."@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit hawar daun pada jagung disebabkan oleh jamur patogen Helminthosporium maydis Y. Nisik & C.Miyake (Kuilya et al., 2018; Hamidson, Suwandi and Effendy, 2019) atau Helminthosporium turticum (Pass.) Leonard et Suggs (Faizah, 2017). Koloni Helinthosporium maydis yang ditumbuhkan pada media PDA awalnya berwarna keputihan kusam, coklat pucat, selanjutnya menjadi berwarna coklat agak gelap. Hifanya bersekat dengan sekat agak longgar. Konidia berdinding tipis dan mempunyai 7-10 sekat. Setelah 8 hari ditumbuhkan pada media PDA, panjang diameter mencapai 8.75 cm."@id ;
    skos:prefLabel "Penyakit Hawar Daun"@id .

