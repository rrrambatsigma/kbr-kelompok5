ns1:PenyakitEmbunPalsuDownyMildewKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Embun Palsu (Downy mildew)"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianPengendalianDapatDilakukanDenganMelakukan_744af160,
        ns1:PengendalianPengendalianMenggunakanKaliumFosfitMampu_53b46cd9 ;
    ns1:deskripsiPenyakit "Penyakit embun madu atau downy mildew atau disebut juga dengan penyakit bulai disebabkan oleh patogen dari jamur Peronospora manshurica (Inayati and Yusnawan, 2017). Patogen merupakan parasit obligat. Patogen P. manshurica memiliki kisaran inang seperti tanaman Cucurbitaceae seperti timun, labu kuning, melon, dan timun suri (Anggraini et al., 2019)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianPengendalianDapatDilakukanDenganMelakukan_744af160,
        ns1:PengendalianPengendalianMenggunakanKaliumFosfitMampu_53b46cd9 ;
    ns1:dipengaruhiOleh ns1:KondisiSuhu ;
    ns1:disebabkanOleh ns1:PeronosporaManshurica ;
