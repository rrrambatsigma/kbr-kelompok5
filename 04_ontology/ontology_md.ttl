                                                      skos:prefLabel "Bercak daun pada Penyakit Bercak Daun"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBercakDaunKacangTanahBercakTanaman
ns1:PengamatanPenyakitBercakDaunKacangTanahBercakTanaman rdf:type owl:NamedIndividual ,
                                                                  ns1:Gejala ;
