[] a ns2:Imp ;
    rdfs:label "RuleKandidatLingkungan" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "Kandidat penyakit dari faktor lingkungan" ;
    ns2:body [ a ns2:AtomList ;
            rdf:first [ a ns2:ClassAtom ;
                    ns2:argument1 ns1:d ;
                    ns2:classPredicate ns1:Diagnosis ] ;
            rdf:rest [ a ns2:AtomList ;
                    rdf:first [ a ns2:IndividualPropertyAtom ;
                            ns2:argument1 ns1:d ;
                            ns2:argument2 ns1:t ;
                            ns2:propertyPredicate ns1:memilikiTanaman ] ;
                    rdf:rest [ a ns2:AtomList ;
                            rdf:first [ a ns2:IndividualPropertyAtom ;
                                    ns2:argument1 ns1:d ;
                                    ns2:argument2 ns1:o ;
                                    ns2:propertyPredicate ns1:memilikiObservasi ] ;
                            rdf:rest [ a ns2:AtomList ;
                                    rdf:first [ a ns2:ClassAtom ;
                                            ns2:argument1 ns1:o ;
                                            ns2:classPredicate ns1:ObservasiLingkungan ] ;
                                    rdf:rest [ a ns2:AtomList ;
                                            rdf:first [ a ns2:DatavaluedPropertyAtom ;
                                                    ns2:argument1 ns1:o ;
                                                    ns2:argument2 ns1:f ;
                                                    ns2:propertyPredicate ns1:klasifikasiTurunan ] ;
                                            rdf:rest [ a ns2:AtomList ;
                                                    rdf:first [ a ns2:IndividualPropertyAtom ;
                                                            ns2:argument1 ns1:p ;
                                                            ns2:argument2 ns1:eo ;
                                                            ns2:propertyPredicate ns1:dipengaruhiOleh ] ;
                                                    rdf:rest [ a ns2:AtomList ;
                                                            rdf:first [ a ns2:DatavaluedPropertyAtom ;
                                                                    ns2:argument1 ns1:eo ;
                                                                    ns2:argument2 ns1:f ;
                                                                    ns2:propertyPredicate ns1:klasifikasiTurunan ] ;
                                                            rdf:rest [ a ns2:AtomList ;
                                                                    rdf:first [ a ns2:IndividualPropertyAtom ;
                                                                            ns2:argument1 ns1:p ;
                                                                            ns2:argument2 ns1:t ;
                                                                            ns2:propertyPredicate ns1:menyerangTanaman ] ;
                                                                    rdf:rest () ] ] ] ] ] ] ] ] ;
    ns2:head [ a ns2:AtomList ;
            rdf:first [ a ns2:IndividualPropertyAtom ;
                    ns2:argument1 ns1:d ;
                    ns2:argument2 ns1:p ;
                    ns2:propertyPredicate ns1:menghasilkanPenyakit ] ;
            rdf:rest () ] .

[] a ns2:Imp ;
    rdfs:label "RuleKandidatKuat" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "Kandidat kuat dari dua gejala kanonik berbeda" ;
    ns2:body [ a ns2:AtomList ;
            rdf:first [ a ns2:ClassAtom ;
                    ns2:argument1 ns1:d ;
                    ns2:classPredicate ns1:Diagnosis ] ;
            rdf:rest [ a ns2:AtomList ;
                    rdf:first [ a ns2:IndividualPropertyAtom ;
                            ns2:argument1 ns1:d ;
                            ns2:argument2 ns1:t ;
                            ns2:propertyPredicate ns1:memilikiTanaman ] ;
                    rdf:rest [ a ns2:AtomList ;
                            rdf:first [ a ns2:IndividualPropertyAtom ;
                                    ns2:argument1 ns1:p ;
                                    ns2:argument2 ns1:t ;
                                    ns2:propertyPredicate ns1:menyerangTanaman ] ;
                            rdf:rest [ a ns2:AtomList ;
                                    rdf:first [ a ns2:IndividualPropertyAtom ;
                                            ns2:argument1 ns1:d ;
                                            ns2:argument2 ns1:o ;
                                            ns2:propertyPredicate ns1:memilikiObservasi ] ;
                                    rdf:rest [ a ns2:AtomList ;
                                            rdf:first [ a ns2:IndividualPropertyAtom ;
                                                    ns2:argument1 ns1:o ;
                                                    ns2:argument2 ns1:g ;
                                                    ns2:propertyPredicate ns1:memilikiGejalaKanonik ] ;
                                            rdf:rest [ a ns2:AtomList ;
                                                    rdf:first [ a ns2:IndividualPropertyAtom ;
                                                            ns2:argument1 ns1:d ;
                                                            ns2:argument2 ns1:o2 ;
                                                            ns2:propertyPredicate ns1:memilikiObservasi ] ;
                                                    rdf:rest [ a ns2:AtomList ;
                                                            rdf:first [ a ns2:IndividualPropertyAtom ;
                                                                    ns2:argument1 ns1:o2 ;
                                                                    ns2:argument2 ns1:g2 ;
                                                                    ns2:propertyPredicate ns1:memilikiGejalaKanonik ] ;
                                                            rdf:rest [ a ns2:AtomList ;
                                                                    rdf:first [ a ns2:DatavaluedPropertyAtom ;
                                                                            ns2:argument1 ns1:g ;
                                                                            ns2:argument2 ns1:gn ;
                                                                            ns2:propertyPredicate ns1:kodeGejala ] ;
                                                                    rdf:rest [ a ns2:AtomList ;
                                                                            rdf:first [ a ns2:DatavaluedPropertyAtom ;
                                                                                    ns2:argument1 ns1:g2 ;
                                                                                    ns2:argument2 ns1:gn2 ;
                                                                                    ns2:propertyPredicate ns1:kodeGejala ] ;
                                                                            rdf:rest [ a ns2:AtomList ;
                                                                                    rdf:first [ a ns2:BuiltinAtom ;
                                                                                            ns2:arguments ( ns1:gn ns1:gn2 ) ;
                                                                                            ns2:builtin <http://www.w3.org/2003/11/swrlb#notEqual> ] ;
                                                                                    rdf:rest [ a ns2:AtomList ;
                                                                                            rdf:first [ a ns2:IndividualPropertyAtom ;
                                                                                                    ns2:argument1 ns1:p ;
                                                                                                    ns2:argument2 ns1:gp ;
                                                                                                    ns2:propertyPredicate ns1:memilikiGejala ] ;
                                                                                            rdf:rest [ a ns2:AtomList ;
                                                                                                    rdf:first [ a ns2:IndividualPropertyAtom ;
                                                                                                            ns2:argument1 ns1:gp ;
                                                                                                            ns2:argument2 ns1:g ;
                                                                                                            ns2:propertyPredicate ns1:memilikiGejalaKanonik ] ;
                                                                                                    rdf:rest [ a ns2:AtomList ;
                                                                                                            rdf:first [ a ns2:IndividualPropertyAtom ;
                                                                                                                    ns2:argument1 ns1:p ;
                                                                                                                    ns2:argument2 ns1:gp2 ;
                                                                                                                    ns2:propertyPredicate ns1:memilikiGejala ] ;
                                                                                                            rdf:rest [ a ns2:AtomList ;
                                                                                                                    rdf:first [ a ns2:IndividualPropertyAtom ;
                                                                                                                            ns2:argument1 ns1:gp2 ;
                                                                                                                            ns2:argument2 ns1:g2 ;
                                                                                                                            ns2:propertyPredicate ns1:memilikiGejalaKanonik ] ;
                                                                                                                    rdf:rest () ] ] ] ] ] ] ] ] ] ] ] ] ] ] ;
    ns2:head [ a ns2:AtomList ;
            rdf:first [ a ns2:IndividualPropertyAtom ;
                    ns2:argument1 ns1:d ;
                    ns2:argument2 ns1:p ;
                    ns2:propertyPredicate ns1:kandidatKuat ] ;
            rdf:rest () ] .

[] a ns2:Imp ;
    rdfs:label "RuleRekomendasiVarietasTahan" ;
    ns3:isRuleEnabled true ;
    rdfs:comment "Rekomendasi varietas tahan" ;
    ns2:body [ a ns2:AtomList ;
            rdf:first [ a ns2:ClassAtom ;
                    ns2:argument1 ns1:d ;
                    ns2:classPredicate ns1:Diagnosis ] ;
            rdf:rest [ a ns2:AtomList ;
                    rdf:first [ a ns2:IndividualPropertyAtom ;
                            ns2:argument1 ns1:d ;
                            ns2:argument2 ns1:p ;
                            ns2:propertyPredicate ns1:menghasilkanPenyakit ] ;
                    rdf:rest [ a ns2:AtomList ;
                            rdf:first [ a ns2:IndividualPropertyAtom ;
                                    ns2:argument1 ns1:p ;
                                    ns2:argument2 ns1:t ;
                                    ns2:propertyPredicate ns1:menyerangTanaman ] ;
                            rdf:rest [ a ns2:AtomList ;
                                    rdf:first [ a ns2:IndividualPropertyAtom ;
                                            ns2:argument1 ns1:t ;
                                            ns2:argument2 ns1:v ;
                                            ns2:propertyPredicate ns1:memilikiVarietas ] ;
                                    rdf:rest [ a ns2:AtomList ;
                                            rdf:first [ a ns2:IndividualPropertyAtom ;
                                                    ns2:argument1 ns1:v ;
                                                    ns2:argument2 ns1:p ;
                                                    ns2:propertyPredicate ns1:tahanTerhadap ] ;
                                            rdf:rest () ] ] ] ] ] ;
    ns2:head [ a ns2:AtomList ;
            rdf:first [ a ns2:IndividualPropertyAtom ;
                    ns2:argument1 ns1:d ;
                    ns2:argument2 ns1:v ;
                    ns2:propertyPredicate ns1:merekomendasikanVarietas ] ;
            rdf:rest () ] .

