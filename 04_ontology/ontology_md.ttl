ns1:NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Nekrosis pada titik tunas (Cassava bud necrosis)"@id ;
    ns1:deskripsiPenyakit "Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas"@id ;
    ns1:didukungOleh ns1:BuktiPenyakitNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuNekrosisCassavaBudNecrosis ;
    ns1:identifierSumber "DIS_039" ;
    ns1:memilikiGejala ns1:PengamatanNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuUtamaDitandaiMunculnyaGelapAbu ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Batang ;
    ns1:menyerangTanaman ns1:UbiKayu ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas"@id ;
    skos:prefLabel "Nekrosis pada titik tunas (Cassava bud necrosis)"@id .

