ns1:PenyakitBusukHitamBlackRotUbiJalar a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit busuk hitam (black rot)"@id ;
    ns1:berkaitanPengendalian ns1:PerlakuanKimiaTanah,
        ns1:RotasiTanaman ;
    ns1:deskripsiPenyakit "Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003). Wamalwa et al. (2015) melaporkan bahwa C. fimbriata dapat menginduksi fitoaleksin yang bersifat toksik pada hewan."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitBusukHitamBlackRotUbiJalarHitamBlackRotDisebabkanCeratocystis,
        ns1:BuktiPengendalianPenyakitBusukHitamBlackRotUbiJalar2018MenjelaskanBahwaPengendalianPascapanen,
        ns1:BuktiPengendalianPenyakitBusukHitamBlackRotUbiJalarAdapunPengendalianDilakukanLahanBebas,
        ns1:BuktiPengendalianPenyakitBusukHitamBlackRotUbiJalarSterilisasiAkarBahanDitanamPersemaian,
        ns1:BuktiPenyakitPenyakitBusukHitamBlackRotUbiJalarHitamBlackRot ;
    ns1:dikendalikanDengan ns1:PerlakuanKimiaTanah,
        ns1:RotasiTanaman ;
    ns1:dipengaruhiOleh ns1:KondisiSuhuTinggi ;
    ns1:disebabkanOleh ns1:CeratocystisFimbriata ;
    ns1:identifierSumber "DIS_027" ;
    ns1:memilikiGejala ns1:PengamatanPenyakitBusukHitamBlackRotUbiJalar2018MenjelaskanBahwaC,
        ns1:PengamatanPenyakitBusukHitamBlackRotUbiJalarBusukAkar,
        ns1:PengamatanPenyakitBusukHitamBlackRotUbiJalarFimbriataABPascapanenC,
        ns1:PengamatanPenyakitBusukHitamBlackRotUbiJalarFimbriataUmbiTahapAwalTerdapat,
        ns1:PengamatanPenyakitBusukHitamBlackRotUbiJalarGambar46BentukMikroskopis,
        ns1:PengamatanPenyakitBusukHitamBlackRotUbiJalarHitamBlackRotDisebabkanCeratocystis ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangTanaman ns1:UbiJalar ;
    ns1:namaInggrisPenyakit "black rot" ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2003). Wamalwa et al. (2015) melaporkan bahwa C. fimbriata dapat menginduksi fitoaleksin yang bersifat toksik pada hewan."@id ;
    skos:altLabel "black rot"@id ;
    skos:prefLabel "Penyakit busuk hitam (black rot)"@id .

ns1:Polong a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Polong"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id,
