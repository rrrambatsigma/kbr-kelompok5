ns1:PengamatanPenyakitBercakKuningUbiJalarBercakDaun a ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun pada Penyakit bercak kuning"@id ;
    ns1:deskripsiGejala "Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018)."@id ;
    ns1:didukungOleh ns1:BuktiGejalaPenyakitBercakKuningUbiJalarAdapunLapanganKadangKadangTidak ;
