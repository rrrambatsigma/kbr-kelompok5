ns1:HawarDaunBakteriUbiKayu a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Hawar daun bakteri"@id ;
    ns1:deskripsiPenyakit "Gejala khas berupa bercak atau lesi berair (eksudat seperti getah berwarna krem) pada tangkai daun tanaman terinfeksi. Pada daun gejala muncul urat atau tulang daun,tepi dan ujung bilah daun. Perkembangan infeksi lebih lanjut bercak tersebut menyatu membentuk hawar/bercak coklat besar, daun mengering atau layu, daun gugur."@id ;
    ns1:didukungOleh ns1:BuktiPatogenHawarDaunBakteriUbiKayuSelTabelT51Baris,
        ns1:BuktiPenyakitHawarDaunBakteriUbiKayuTanpaTeks ;
