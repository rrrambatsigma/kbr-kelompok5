        kbr:PenyakitBercakTargetKedelai,
        kbr:PenyakitEmbunPalsuDownyMildewKedelai,
        kbr:PenyakitEmbunTepungPowderyMildewKedelai,
        kbr:PenyakitHawarBakteriBacterialBlightKedelai,
        kbr:PenyakitKaratDaunKedelai,
        kbr:PenyakitKerdilKedelaiSoybeanStuntVirusKedelai,
        kbr:PenyakitLayuFusariumKedelai,
        kbr:PenyakitMosaikKedelaiSoybeanMosaicVirusKedelai,
        kbr:PenyakitRebahKecambahKedelai,
        kbr:PenyakitRebahSemaiKedelai,
        kbr:PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai ;
