                                                                          ns1:SuhuOptimalPadaPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelai ;
                                                      ns1:disebabkanOleh ns1:CercosporaSojina ;
                                                      ns1:memilikiGejala ns1:GejalaPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelai ,
                                                                         ns1:GejalaPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelaiBerc2 ,
                                                                         ns1:GejalaPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelaiBerca ;
                                                      ns1:memilikiReferensi ns1:BukuDOC002 ;
                                                      ns1:menyerangBagian ns1:Daun ;
                                                      ns1:menyerangTanaman ns1:Kedelai ;
                                                      ns1:deskripsiPenyakit "Penyakit bercak daun mata katak (frogeye leaf spot) disebabkan oleh patogen Cercospora sojina K. Hara. Patogen C. sojina menginfeksi pada bagian permukaan daun, batang maupun pada polong kedelai. Infeksi sering terlihat pada bagian permukaan daun. Patogen C. sojina memiliki konidia yang terbentuk pada ujung konidiofor. Konidia berwarna hialin dengan ukuran 5-7 µm x 39-70µm. Konidia merupakan sumber inokulum primer dan sekunder untuk perkembangan penyakit bercak daun mata katak. Gejala yang muncul pada tanaman adalah adanya bercak atau bintik-bintik kecil dengan bagian tengah pada bintik berwarna lebih terang. Bintik pada daun kemudian berkembang menjadi bercak yang lebih lebar dengan pinggiran berwarna lebih coklat sampai kemerahan (Gambar 2.8). Pada intensitas serangan yang bintik menjadi berkembang pada bagian daun hingga menutupi 30% bagian"@id ;
                                                      ns1:identifierSumber "DIS_012" ;
                                                      ns1:namaInggrisPenyakit "Frogeye Leaf Spot" ;
                                                      rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                                                   "Penyakit bercak daun mata katak (frogeye leaf spot) disebabkan oleh patogen Cercospora sojina K. Hara. Patogen C. sojina menginfeksi pada bagian permukaan daun, batang maupun pada polong kedelai. Infeksi sering terlihat pada bagian permukaan daun. Patogen C. sojina memiliki konidia yang terbentuk pada ujung konidiofor. Konidia berwarna hialin dengan ukuran 5-7 µm x 39-70µm. Konidia merupakan sumber inokulum primer dan sekunder untuk perkembangan penyakit bercak daun mata katak. Gejala yang muncul pada tanaman adalah adanya bercak atau bintik-bintik kecil dengan bagian tengah pada bintik berwarna lebih terang. Bintik pada daun kemudian berkembang menjadi bercak yang lebih lebar dengan pinggiran berwarna lebih coklat sampai kemerahan (Gambar 2.8). Pada intensitas serangan yang bintik menjadi berkembang pada bagian daun hingga menutupi 30% bagian"@id ;
                                                      rdfs:label "Penyakit Bercak Daun Mata Katak (Frogeye Leaf Spot)"@id ;
                                                      skos:altLabel "Frogeye Leaf Spot"@id ;
                                                      skos:prefLabel "Penyakit Bercak Daun Mata Katak (Frogeye Leaf Spot)"@id .


