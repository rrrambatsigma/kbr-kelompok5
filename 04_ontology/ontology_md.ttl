ns1:PenyakitBercakBijiUnguKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Bercak Biji Ungu"@id ;
    ns1:berkaitanPengendalian ns1:PenggunaanFungisida,
        ns1:PerlakuanBenih ;
    ns1:deskripsiPenyakit "Penyakit bercak biji ungu atau juga dikenal dengan hawar daun Cercospora merupakan penyakit pada tanaman kedelai yang disebabkan oleh patogen Cercospora kikuchii. Penyakit bercak biji ungu atau hawar daun Cercospora merupakan penyakit yang penting juga pada tanaman kedelai karena dapat menyebabkan kehilangan hasil. Patogen C. kikuchii dapat menginfeksi bagian tanaman kedelai seperti daun, batang dan polong (Cai and Schneider, 2008). Gejala pada tanaman kedelai yang terinfeksi patogen C. kikuchii adalah adanya perubahan warna daun menjadi ungu muda pada permukaan daun atas yang biasanya dimulai pada bagian pinggir daun kemudian dapat melebar dan luas hingga menutupi seluruh permukaan daun tanaman kedelai berwarna ungu. Gejala ini biasanya dianggap sebagai gejala karena pengaruh cahaya matahari."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitBercakBijiUnguKedelai,
        ns1:BuktiPengendalianPenyakitBercakBijiUnguKedelai,
        ns1:BuktiPenyakitPenyakitBercakBijiUnguKedelai ;
    ns1:dikendalikanDengan ns1:PenggunaanFungisida,
        ns1:PerlakuanBenih ;
    ns1:dipengaruhiOleh ns1:KelembapanTinggiDanSuhuHangatPadaPenyakitBercakBijiUnguKedelai ;
    ns1:disebabkanOleh ns1:CercosporaKikuchii ;
    ns1:identifierSumber "DIS_015" ;
    ns1:memilikiGejala ns1:GejalaPenyakitBercakBijiUnguKedelai,
        ns1:GejalaPenyakitBercakBijiUnguKedelai2,
        ns1:GejalaPenyakitBercakBijiUnguKedelai3,
        ns1:GejalaPenyakitBercakBijiUnguKedelai4,
        ns1:GejalaPenyakitBercakBijiUnguKedelaiBercakDaun,
        ns1:GejalaPenyakitBercakBijiUnguKedelaiBercakTanaman,
        ns1:GejalaPenyakitBercakBijiUnguKedelaiHawarDaun,
        ns1:GejalaPenyakitBercakBijiUnguKedelaiNekrosisDaun ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Biji ;
    ns1:menyerangTanaman ns1:Kedelai ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit bercak biji ungu atau juga dikenal dengan hawar daun Cercospora merupakan penyakit pada tanaman kedelai yang disebabkan oleh patogen Cercospora kikuchii. Penyakit bercak biji ungu atau hawar daun Cercospora merupakan penyakit yang penting juga pada tanaman kedelai karena dapat menyebabkan kehilangan hasil. Patogen C. kikuchii dapat menginfeksi bagian tanaman kedelai seperti daun, batang dan polong (Cai and Schneider, 2008). Gejala pada tanaman kedelai yang terinfeksi patogen C. kikuchii adalah adanya perubahan warna daun menjadi ungu muda pada permukaan daun atas yang biasanya dimulai pada bagian pinggir daun kemudian dapat melebar dan luas hingga menutupi seluruh permukaan daun tanaman kedelai berwarna ungu. Gejala ini biasanya dianggap sebagai gejala karena pengaruh cahaya matahari."@id ;
    skos:prefLabel "Penyakit Bercak Biji Ungu"@id .

ns1:PenyakitEmbunTepungPowderyMildewKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Embun Tepung (Powdery Mildew)"@id ;
    ns1:berkaitanPengendalian ns1:PemupukanBerimbang,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanTanamanBukanInang,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    ns1:deskripsiPenyakit "Penyakit ini disebabkan oleh cendawan Erysiphae diffusa yang menginfeksi tanaman kedelai. Patogen E. diffusa menginfeksi daun kedelai bagian bawah sehingga pada permukaan daun bagian bawah terdapat bercak berwarna putih seperti tepung yang merupakan kumpulan dari konidia dan konidiofor patogen"@id ;
