                                                                   "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
                                                      rdfs:label "Bercak daun pada BERCAK DAUN"@id ;
                                                      skos:prefLabel "Bercak daun pada BERCAK DAUN"@id .


