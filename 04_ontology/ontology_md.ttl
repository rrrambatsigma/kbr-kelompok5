###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKudisUbiJalar
ns1:GejalaPenyakitKudisUbiJalar rdf:type owl:NamedIndividual ,
                                         ns1:EntitasKBR ,
                                         ns1:Gejala ,
                                         ns1:GejalaDaun ;
                                ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalar3 ;
                                ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                ns1:terdapatPada ns1:Daun ;
                                ns1:deskripsiGejala "Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997)."@id ;
                                rdfs:comment "Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997)."@id ,
                                             "Gejala pada tanaman Ubi jalar: Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat..."@id ;
                                rdfs:label "Gejala pada Penyakit kudis (Ubi jalar): Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat..."@id ;
                                skos:prefLabel "Gejala pada Penyakit kudis (Ubi jalar): Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat..."@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKudisUbiJalar2
ns1:GejalaPenyakitKudisUbiJalar2 rdf:type owl:NamedIndividual ,
                                          ns1:EntitasKBR ,
                                          ns1:Gejala ;
                                 ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalar4 ;
                                 ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                 ns1:deskripsiGejala "Sumber inokulum penyakit kudis biasanya berasal dari bahan tanam (setek) yang terinfeksi jamur, penyakit ini menyebar lebih cepat ke tanaman yang sehat percikan air hujan yang disertai angin, lebih banyak terjadi serangan pada musim hujan (Saleh and Rahayuningsih, 2013)."@id ;
                                 rdfs:comment "Gejala pada tanaman Ubi jalar: Sumber inokulum penyakit kudis biasanya berasal dari bahan tanam..."@id ,
                                              "Sumber inokulum penyakit kudis biasanya berasal dari bahan tanam (setek) yang terinfeksi jamur, penyakit ini menyebar lebih cepat ke tanaman yang sehat percikan air hujan yang disertai angin, lebih banyak terjadi serangan pada musim hujan (Saleh and Rahayuningsih, 2013)."@id ;
                                 rdfs:label "Gejala pada Penyakit kudis (Ubi jalar): Sumber inokulum penyakit kudis biasanya berasal dari bahan tanam..."@id ;
                                 skos:prefLabel "Gejala pada Penyakit kudis (Ubi jalar): Sumber inokulum penyakit kudis biasanya berasal dari bahan tanam..."@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKudisUbiJalar3
ns1:GejalaPenyakitKudisUbiJalar3 rdf:type owl:NamedIndividual ,
                                          ns1:EntitasKBR ,
                                          ns1:Gejala ;
                                 ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalar5 ;
                                 ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                 ns1:deskripsiGejala "Selain itu, faktor lingkungan juga memengaruhi perubahan ketahanan ubi jalar terhadap penyakit kudis (Roosda et al., 20013), sehingga kultivar yang tahan dapat berubah menjadi tidak tahan dan periode inkubasi juga memengaruhi munculnya gejala penyakit (Samiyarsih, Juwarno and Muljowati, 2018)."@id ;
                                 rdfs:comment "Gejala pada tanaman Ubi jalar: Selain itu, faktor lingkungan juga memengaruhi perubahan ketahanan ubi..."@id ,
                                              "Selain itu, faktor lingkungan juga memengaruhi perubahan ketahanan ubi jalar terhadap penyakit kudis (Roosda et al., 20013), sehingga kultivar yang tahan dapat berubah menjadi tidak tahan dan periode inkubasi juga memengaruhi munculnya gejala penyakit (Samiyarsih, Juwarno and Muljowati, 2018)."@id ;
                                 rdfs:label "Gejala pada Penyakit kudis (Ubi jalar): Selain itu, faktor lingkungan juga memengaruhi perubahan ketahanan ubi..."@id ;
                                 skos:prefLabel "Gejala pada Penyakit kudis (Ubi jalar): Selain itu, faktor lingkungan juga memengaruhi perubahan ketahanan ubi..."@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKudisUbiJalar4
ns1:GejalaPenyakitKudisUbiJalar4 rdf:type owl:NamedIndividual ,
                                          ns1:EntitasKBR ,
                                          ns1:Gejala ;
                                 ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalar6 ;
                                 ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                 ns1:deskripsiGejala "Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar membentuk lapisan gabus untuk mempertahankan diri dari serangan penyakit kudis (Gambar 3A dan B)."@id ;
                                 rdfs:comment "Gejala pada tanaman Ubi jalar: Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar..."@id ,
                                              "Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar membentuk lapisan gabus untuk mempertahankan diri dari serangan penyakit kudis (Gambar 3A dan B)."@id ;
                                 rdfs:label "Gejala pada Penyakit kudis (Ubi jalar): Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar..."@id ;
                                 skos:prefLabel "Gejala pada Penyakit kudis (Ubi jalar): Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar..."@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKudisUbiJalarBercakDaun
ns1:GejalaPenyakitKudisUbiJalarBercakDaun rdf:type owl:NamedIndividual ,
                                                   ns1:EntitasKBR ,
                                                   ns1:Gejala ,
                                                   ns1:GejalaDaun ;
                                          ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalar ;
                                          ns1:memilikiGejalaKanonik ns1:BercakDaun ;
                                          ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
                                          ns1:terdapatPada ns1:Daun ;
                                          ns1:deskripsiGejala "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
                                          rdfs:comment "Gejala bercak daun pada tanaman Ubi jalar: Gejala yang timbul akibat serangan penyakit kudis pada bagian batang..."@id ,
                                                       "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
                                          rdfs:label "Bercak daun pada Penyakit kudis (Ubi jalar)"@id ;
                                          skos:prefLabel "Bercak daun pada Penyakit kudis (Ubi jalar)"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitKudisUbiJalarBercakTanaman
ns1:GejalaPenyakitKudisUbiJalarBercakTanaman rdf:type owl:NamedIndividual ,
                                                      ns1:EntitasKBR ,
                                                      ns1:Gejala ;
