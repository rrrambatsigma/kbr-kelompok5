ns1:Gejala2018MenjelaskanBahwaGejalaAwal_5c05bed5 a ns1:Gejala,
        ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "(2018) menjelaskan bahwa gejala awal ditandai dengan daun yang terinfeksi berwarna kuning pada bagian atas, diikuti menguningnya pada bagian bawah dan lebih cepat pada daun tua."@id ;
    ns1:deskripsiGejala "(2018) menjelaskan bahwa gejala awal ditandai dengan daun yang terinfeksi berwarna kuning pada bagian atas, diikuti menguningnya pada bagian bawah dan lebih cepat pada daun tua."@id ;
    ns1:merupakanGejalaDari ns1:LayuFusariumUbiJalar ;
    ns1:terdapatPada ns1:Daun .

ns1:Gejala2018MenjelaskanBahwaGejalaSerangan_a1bd3ac9 a ns1:Gejala,
        owl:NamedIndividual ;
    rdfs:label "(2018) menjelaskan bahwa gejala serangan C."@id ;
    ns1:deskripsiGejala "(2018) menjelaskan bahwa gejala serangan C."@id ;
    ns1:merupakanGejalaDari ns1:PenyakitBusukHitamBlackRotUbiJalar .

ns1:GejalaAdapunBentukBercakSendiriDapat_626f021f a ns1:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Adapun bentuk bercak sendiri dapat berupa bulat lonjong dengan panjang 2 – 3 cm yang kemudian akan meluas."@id ;
    ns1:deskripsiGejala "Adapun bentuk bercak sendiri dapat berupa bulat lonjong dengan panjang 2 – 3 cm yang kemudian akan meluas."@id ;
    ns1:merupakanGejalaDari ns1:PenyakitHawarPelepahDaunPadi .

ns1:GejalaAdapunBentukWarnaDanUkuran_f8023518 a ns1:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Adapun bentuk, warna dan ukuran dari bercak dapat bervariasi tergantung dari umur dan ketahanan varietas tanaman serta umur dari bercak (Ou 1985)."@id ;
    ns1:deskripsiGejala "Adapun bentuk, warna dan ukuran dari bercak dapat bervariasi tergantung dari umur dan ketahanan varietas tanaman serta umur dari bercak (Ou 1985)."@id ;
    ns1:merupakanGejalaDari ns1:PenyakitBlasPadi .

ns1:GejalaAdapunGejalaDiLapanganPada_b6b7db6c a ns1:Gejala,
        ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018)."@id ;
    ns1:deskripsiGejala "Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018)."@id ;
    ns1:merupakanGejalaDari ns1:PenyakitBercakKuningUbiJalar ;
    ns1:terdapatPada ns1:Daun .

ns1:GejalaAkarMembusukTerdapatTubuhBuah_0f535eca a ns1:Gejala,
        ns1:GejalaAkar,
        ns1:GejalaBatang,
        owl:NamedIndividual ;
    rdfs:label "Akar membusuk, terdapat tubuh buah (jamur) kecil berwarna keputihan dan menguning, di ujung akar dekat pangkal batang,"@id ;
    ns1:deskripsiGejala "Akar membusuk, terdapat tubuh buah (jamur) kecil berwarna keputihan dan menguning, di ujung akar dekat pangkal batang,"@id ;
    ns1:merupakanGejalaDari ns1:BusukAkarUbiKayu ;
    ns1:terdapatPada ns1:Akar,
        ns1:Batang,
        ns1:Buah .

ns1:GejalaAkarMengalamiKerusakanAkarPembentukan_99e28980 a ns1:Gejala,
        ns1:GejalaAkar,
        ns1:GejalaUmbi,
        owl:NamedIndividual ;
    rdfs:label "Akar mengalami kerusakan akar, pembentukan dan pembesaran umbi ubi kayu terhambat, serta busuk"@id ;
    ns1:deskripsiGejala "Akar mengalami kerusakan akar, pembentukan dan pembesaran umbi ubi kayu terhambat, serta busuk"@id ;
    ns1:merupakanGejalaDari ns1:BusukAkarDanUmbiUbiKayu ;
    ns1:terdapatPada ns1:Akar,
        ns1:Umbi .

ns1:GejalaAkibatDariInfeksiIniMaka_b83a2e23 a ns1:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Akibat dari infeksi ini maka tanaman menunjukkan gejala kematian mendadak pada tanaman kedelai (Chang et al., 2018)."@id ;
