    ns1:identifierSumber "DIS_016" ;
    ns1:memilikiGejala ns1:PengamatanPenyakitHawarBakteriBacterialBlightKedelaiAkibatMakaBenihDihasilkanMenjadi,
        ns1:PengamatanPenyakitHawarBakteriBacterialBlightKedelaiBercakDaun,
        ns1:PengamatanPenyakitHawarBakteriBacterialBlightKedelaiDisebabkanP,
        ns1:PengamatanPenyakitHawarBakteriBacterialBlightKedelaiGlycineDiawaliMunculnyaAwalnyaBerwarna,
        ns1:PengamatanPenyakitHawarBakteriBacterialBlightKedelaiPolongTerinfeksiMenunjukkanBerwarnaHitam,
        ns1:PengamatanPenyakitHawarBakteriBacterialBlightKedelaiTingkatKemudianMenjadiDitandaiWarna ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangTanaman ns1:Kedelai ;
    ns1:namaInggrisPenyakit "Bacterial Blight" ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit hawar bakteri (bacterial blight) disebabkan oleh patogen bakteri Pseudomonas syringae pv. glycine. Penyakit hawar bakteri menjadi salah satu penyakit yang menjadi kendala utama pada budidaya tanaman kedelai. Gejala tanaman yang disebabkan oleh patogen P. syringae pv. glycine diawali dengan munculnya bercak yang awalnya berwarna coklat kekuningan dengan ukuran bercak kecil. Pada tingkat serangan yang tinggi bercak kemudian menjadi hawar yang ditandai dengan warna kecokelatan dilingkari dengan lingkaran kuning dan menyebar tidak beraturan (Gambar 2.14)."@id ;
    skos:altLabel "Bacterial Blight"@id ;
    skos:prefLabel "Penyakit Hawar Bakteri (Bacterial Blight)"@id .

ns1:PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)"@id ;
    ns1:berkaitanPengendalian ns1:PengaturanJarakTanam,
        ns1:PengaturanWaktuTanam,
        ns1:PenggunaanInsektisida,
        ns1:PenggunaanMulsa,
        ns1:PenggunaanVarietasTahan,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    ns1:deskripsiPenyakit "Penyakit samar kacang tunggak disebabkan oleh virus Cowpea Mild Mottle Virus (CMMV). Patogen virus CMMV ini mampu menyerang pada beberapa tanaman seperti kedelai atau famili Leguminoceae, Solanaceae, Amaranthaceae, dan Chenopodiaceae. Gejala yang ditunjukkan oleh patogen CMMV pada tanaman kedelai adalah pada daun tanaman terdapat belang secara sistemik, bagian tulang daun terdapat klorosis serta daun yang terinfeksi CMMV mengalami malformasi (Gambar 2.18)."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiSamarTunggakDisebabkanCowpeaMild,
        ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiAplikasiInsektisidaDeltametrinDigabungkanPemakaian,
        ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiEradikasiInokulumMenjadiTindakanMenekan,
        ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiPengaturanWaktuTanamJarakTanam,
        ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiPengendalianDilakukanCMMV,
        ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiPengendalianRotasiTanamBukanCMMV,
        ns1:BuktiPenyakitPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiSamarTunggakCowpeaMildMottle ;
    ns1:dikendalikanDengan ns1:PengaturanJarakTanam,
        ns1:PengaturanWaktuTanam,
        ns1:PenggunaanInsektisida,
        ns1:PenggunaanMulsa,
        ns1:PenggunaanVarietasTahan,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    ns1:disebabkanOleh ns1:CowpeaMildMottleVirus ;
    ns1:identifierSumber "DIS_019" ;
    ns1:memilikiGejala ns1:PengamatanPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiKerdilTanaman,
        ns1:PengamatanPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiKlorosisDaun,
        ns1:PengamatanPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiMosaikDaun,
        ns1:PengamatanPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiParahMakaMenunjukkanSemakinBeragam,
        ns1:PengamatanPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiSemakinBerkembangSeiringMeningkatnyaUmur ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangTanaman ns1:Kedelai ;
    ns1:namaInggrisPenyakit "Cowpea Mild Mottle Virus" ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit samar kacang tunggak disebabkan oleh virus Cowpea Mild Mottle Virus (CMMV). Patogen virus CMMV ini mampu menyerang pada beberapa tanaman seperti kedelai atau famili Leguminoceae, Solanaceae, Amaranthaceae, dan Chenopodiaceae. Gejala yang ditunjukkan oleh patogen CMMV pada tanaman kedelai adalah pada daun tanaman terdapat belang secara sistemik, bagian tulang daun terdapat klorosis serta daun yang terinfeksi CMMV mengalami malformasi (Gambar 2.18)."@id ;
    skos:altLabel "Cowpea Mild Mottle Virus"@id ;
    skos:prefLabel "Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)"@id .

