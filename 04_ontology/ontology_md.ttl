        ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottle3,
        ns1:BuktiPengendalianPenyakitTungroPadi ;
    ns1:mengendalikanPenyakit ns1:PenyakitBelangMottleKacangTanah,
        ns1:PenyakitBlasPadi,
        ns1:PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai,
        ns1:PenyakitTungroPadi ;
