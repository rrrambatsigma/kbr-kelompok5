    kbr:memilikiFasePertumbuhan kbr:FaseGeneratifJagung,
        kbr:FasePemasakanJagung,
        kbr:FasePerkecambahanJagung,
        kbr:FaseVegetatifJagung ;
    kbr:memilikiKondisiTumbuh kbr:KondisiSuhuSedang ;
    kbr:memilikiVarietas kbr:VarietasAsianHoney,
        kbr:VarietasBima1,
        kbr:VarietasBima10,
