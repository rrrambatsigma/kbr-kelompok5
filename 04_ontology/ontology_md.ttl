ns1:PenyakitHawarBakteriBacterialBlightKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Hawar Bakteri (Bacterial Blight)"@id ;
    ns1:berkaitanPengendalian ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanBakterisida,
        ns1:PenggunaanPseudomonas,
        ns1:PerlakuanBenih,
        ns1:RotasiTanaman ;
    ns1:deskripsiPenyakit "Penyakit hawar bakteri (bacterial blight) disebabkan oleh patogen bakteri Pseudomonas syringae pv. glycine. Penyakit hawar bakteri menjadi salah satu penyakit yang menjadi kendala utama pada budidaya tanaman kedelai. Gejala tanaman yang disebabkan oleh patogen P. syringae pv. glycine diawali dengan munculnya bercak yang awalnya berwarna coklat kekuningan dengan ukuran bercak kecil. Pada tingkat serangan yang tinggi bercak kemudian menjadi hawar yang ditandai dengan warna kecokelatan dilingkari dengan lingkaran kuning dan menyebar tidak beraturan (Gambar 2.14)."@id ;
    ns1:didukungOleh ns1:BuktiMetadataPhasePenyakitHawarBakteriBacterialBlightKedelai,
        ns1:BuktiMetadataSeverityPenyakitHawarBakteriBacterialBlightKede,
        ns1:BuktiPatogenPenyakitHawarBakteriBacterialBlightKedelai,
        ns1:BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai,
        ns1:BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai2,
        ns1:BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai3,
        ns1:BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai4,
        ns1:BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai5,
        ns1:BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai6,
        ns1:BuktiPenyakitPenyakitHawarBakteriBacterialBlightKedelai ;
    ns1:dikendalikanDengan ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanBakterisida,
        ns1:PenggunaanPseudomonas,
        ns1:PerlakuanBenih,
        ns1:RotasiTanaman ;
    ns1:dipengaruhiOleh ns1:SuhuSejukDanHujanSeringPadaPenyakitHawarBakteriBacterialBlightKedelai ;
    ns1:disebabkanOleh ns1:PseudomonasSyringae ;
    ns1:identifierSumber "DIS_016" ;
    ns1:memilikiGejala ns1:GejalaPenyakitHawarBakteriBacterialBlightKedelai,
        ns1:GejalaPenyakitHawarBakteriBacterialBlightKedelai2,
        ns1:GejalaPenyakitHawarBakteriBacterialBlightKedelaiBercakDaun,
        ns1:GejalaPenyakitHawarBakteriBacterialBlightKedelaiBercakTanama,
        ns1:GejalaPenyakitHawarBakteriBacterialBlightKedelaiDaunBerluban,
        ns1:GejalaPenyakitHawarBakteriBacterialBlightKedelaiDaunRontok,
        ns1:GejalaPenyakitHawarBakteriBacterialBlightKedelaiKlorosisTana ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Daun,
        ns1:Polong ;
    ns1:menyerangFase ns1:FasePanenTanaman,
        ns1:FasePembibitanTanaman ;
    ns1:menyerangTanaman ns1:Kedelai ;
    ns1:namaInggrisPenyakit "Bacterial Blight" ;
    ns1:tingkatKeparahan "Patogen dapat menginfeksi dari fase pembibitan hingga panen dan menyebabkan kehilangan hasil mencapai 50-70% (Majid, 2016)."@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit hawar bakteri (bacterial blight) disebabkan oleh patogen bakteri Pseudomonas syringae pv. glycine. Penyakit hawar bakteri menjadi salah satu penyakit yang menjadi kendala utama pada budidaya tanaman kedelai. Gejala tanaman yang disebabkan oleh patogen P. syringae pv. glycine diawali dengan munculnya bercak yang awalnya berwarna coklat kekuningan dengan ukuran bercak kecil. Pada tingkat serangan yang tinggi bercak kemudian menjadi hawar yang ditandai dengan warna kecokelatan dilingkari dengan lingkaran kuning dan menyebar tidak beraturan (Gambar 2.14)."@id ;
    skos:altLabel "Bacterial Blight"@id ;
    skos:prefLabel "Penyakit Hawar Bakteri (Bacterial Blight)"@id .

ns1:PenyakitHawarPelepahDaunPadi a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Hawar Pelepah Daun"@id ;
    ns1:berkaitanPengendalian ns1:PengaturanJarakTanam,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanFungisida,
        ns1:PenggunaanPseudomonas,
        ns1:PenggunaanTrichoderma,
        ns1:PengumpulanDanPemusnahan,
        ns1:SanitasiLahan ;
    ns1:deskripsiPenyakit "Penyakit hawar pelepah daun (HDP) dapat ditemukan pada tiap musim tanam padi. Meskipun tidak sebesar akibat infeksi penyakit HDB dan blas, kehilangan hasil akibat penyakit HDP berkisar antara 20-35% di beberapa negara penghasil beras dunia (Inagaki 2001). Sementara itu, di Indonesia kehilangan hasil yang dilaporkan mencapai 20% (Suparyono dan Sudir 1999)."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitHawarPelepahDaunPadi,
        ns1:BuktiPengendalianPenyakitHawarPelepahDaunPadi,
