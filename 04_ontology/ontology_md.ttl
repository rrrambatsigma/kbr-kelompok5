###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu
ns1:NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu rdf:type owl:NamedIndividual ,
                                                             ns1:EntitasKBR ,
                                                             ns1:Penyakit ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ns1:disebabkanOleh ;
                                                               owl:someValuesFrom ns1:Jamur
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ns1:memilikiGejala ;
                                                               owl:someValuesFrom ns1:Gejala
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ns1:menyerangTanaman ;
                                                               owl:someValuesFrom ns1:TanamanPangan
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ns1:disebabkanOleh ;
                                                               owl:allValuesFrom ns1:Patogen
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ns1:memilikiReferensi ;
                                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass ns1:Referensi
                                                             ] ;
                                                    ns1:didukungOleh ns1:BuktiPatogenNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu ,
                                                                     ns1:BuktiPenyakitNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu ;
                                                    ns1:dipengaruhiOleh ns1:IklimLembapPadaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu ,
                                                                        ns1:KelembapanTinggiPadaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu ;
                                                    ns1:disebabkanOleh ns1:FungiJamur ;
                                                    ns1:memilikiGejala ns1:GejalaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuBercakT ,
                                                                       ns1:GejalaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuNekrosi ;
                                                    ns1:memilikiReferensi ns1:BukuDOC002 ;
                                                    ns1:menyerangBagian ns1:Pucuk ;
                                                    ns1:menyerangTanaman ns1:UbiKayu ;
                                                    ns1:deskripsiPenyakit "Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas"@id ;
                                                    ns1:identifierSumber "DIS_039" ;
                                                    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                                                 "Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas"@id ;
                                                    rdfs:label "Nekrosis pada titik tunas (Cassava bud necrosis)"@id ;
                                                    skos:prefLabel "Nekrosis pada titik tunas (Cassava bud necrosis)"@id .


