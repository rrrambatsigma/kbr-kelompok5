        ns1:GejalaPenyakitHawarPelepahDaunPadiBercakTanaman,
        ns1:GejalaPenyakitHawarPelepahDaunPadiBusukBatang ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Daun ;
    ns1:menyerangFase ns1:FaseAnakanTanaman,
        ns1:FaseMatangSusu ;
    ns1:menyerangTanaman ns1:Padi ;
    ns1:tingkatKeparahan "Meskipun tidak sebesar akibat infeksi penyakit HDB dan blas, kehilangan hasil akibat penyakit HDP berkisar antara 20-35% di beberapa negara penghasil beras dunia (Inagaki 2001)."@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit hawar pelepah daun (HDP) dapat ditemukan pada tiap musim tanam padi. Meskipun tidak sebesar akibat infeksi penyakit HDB dan blas, kehilangan hasil akibat penyakit HDP berkisar antara 20-35% di beberapa negara penghasil beras dunia (Inagaki 2001). Sementara itu, di Indonesia kehilangan hasil yang dilaporkan mencapai 20% (Suparyono dan Sudir 1999)."@id ;
    skos:prefLabel "Penyakit Hawar Pelepah Daun"@id .

ns1:PenyakitLayuStewartJagung a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Layu Stewart"@id ;
    ns1:berkaitanPengendalian ns1:PengelolaanGulma,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanBenihSehat,
        ns1:PenggunaanInsektisida,
        ns1:PenggunaanPseudomonas,
        ns1:PenggunaanVarietasTahan,
        ns1:PerlakuanBenih,
        ns1:SanitasiLahan ;
    ns1:deskripsiPenyakit "Penyakit layu stewart disebabkan oleh bakteri Pantoea stewartii subsp. stewartii. Penyakit ini termasuk patogen tular benih. Pertama kali dilaporkan ada di Bogor, Indonesia oleh (Rahma et al., 2014) dengan kejadian penyakit antara 23.67% hingga 31.45%. Bakteri patogen P. stewartii termasuk bakteri gram negatif dan mempunyai koloni berwarna kuning, mengilat, cembung, berukuran 1-4 mm jika ditumbuhkan pada media TSA (Trypticase Soy Agar). Gejala layu stewart hampir mirip dengan penyakit bulai. Daun bergejala layu stewart berwarna hijau pucat hingga kekuningan dengan garis linier dengan tepi lurus maupun bergelombang yang sejajar tulang daun, layu dan kerdil (Rahma et al., 2014)."@id ;
    ns1:didukungOleh ns1:BuktiMetadataPhasePenyakitLayuStewartJagung,
        ns1:BuktiMetadataSeverityPenyakitLayuStewartJagung,
        ns1:BuktiPatogenPenyakitLayuStewartJagung,
        ns1:BuktiPengendalianPenyakitLayuStewartJagung,
        ns1:BuktiPengendalianPenyakitLayuStewartJagung10,
        ns1:BuktiPengendalianPenyakitLayuStewartJagung2,
        ns1:BuktiPengendalianPenyakitLayuStewartJagung3,
        ns1:BuktiPengendalianPenyakitLayuStewartJagung4,
        ns1:BuktiPengendalianPenyakitLayuStewartJagung5,
        ns1:BuktiPengendalianPenyakitLayuStewartJagung6,
        ns1:BuktiPengendalianPenyakitLayuStewartJagung7,
        ns1:BuktiPengendalianPenyakitLayuStewartJagung8,
        ns1:BuktiPengendalianPenyakitLayuStewartJagung9,
        ns1:BuktiPenyakitPenyakitLayuStewartJagung ;
    ns1:dikendalikanDengan ns1:PengelolaanGulma,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanBenihSehat,
        ns1:PenggunaanInsektisida,
        ns1:PenggunaanPseudomonas,
        ns1:PenggunaanVarietasTahan,
        ns1:PerlakuanBenih,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:MusimDinginRinganPadaPenyakitLayuStewartJagung ;
    ns1:disebabkanOleh ns1:PantoeaStewartii ;
