    ns1:dikendalikanDengan ns1:PengelolaanGulma,
        ns1:PenggunaanVarietasTahan,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:KelembapanRelatifDiAtas78PersenPadaPenyakitKaratDaunKacangTanah,
        ns1:SuhuPadaPenyakitKaratDaunKacangTanah ;
    ns1:disebabkanOleh ns1:PucciniaArachidis ;
