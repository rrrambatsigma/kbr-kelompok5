        ns1:BuktiPengendalianPenyakitBelangMottleKacangTanah8,
        ns1:BuktiPengendalianPenyakitBercakTargetKedelai,
        ns1:BuktiPengendalianPenyakitBlasPadi4,
        ns1:BuktiPengendalianPenyakitEmbunPalsuDownyMildewKedelai3,
        ns1:BuktiPengendalianPenyakitHawarDaunBakteriPadi,
        ns1:BuktiPengendalianPenyakitKerdilKedelaiSoybeanStuntVirusKedel,
        ns1:BuktiPengendalianPenyakitLayuBakteriKacangTanah2,
