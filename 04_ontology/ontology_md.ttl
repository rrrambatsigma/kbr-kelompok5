    ns1:namaPengendalian "Penggunaan Metarhizium"@id ;
    rdfs:comment "Selain itu dapat juga diaplikasikan cendawan entomopatogen seperti Metarhizium dan Beuveria."@id,
        "Tindakan kanonik penggunaan Metarhizium."@id ;
    skos:prefLabel "Penggunaan Metarhizium"@id .

ns1:SapuSetanWitchesBroomUbiKayu a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Sapu setan (Witches broom)"@id ;
    ns1:deskripsiPenyakit "Tanaman tumbuh kerdil (dwarf), ruas batang memendek, pada ujung tanaman tumbuh tunas yang banyak menyerupai sapu"@id ;
    ns1:didukungOleh ns1:BuktiPatogenSapuSetanWitchesBroomUbiKayuSelTabelT51Baris,
