###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasAnjasmoro
ns1:VarietasAnjasmoro rdf:type owl:NamedIndividual ,
                               ns1:EntitasKBR ,
                               ns1:Varietas ;
                      ns1:didukungOleh ns1:BuktiMetadataVarietyPenyakitEmbunTepungPowderyMildewKedelai ,
                                       ns1:BuktiVarietasKedelai ,
