###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiJalar
ns1:UbiJalar rdf:type owl:NamedIndividual ,
                      ns1:EntitasKBR ,
                      ns1:TanamanPangan ,
                      ns1:UmbiUmbian ,
                      [ rdf:type owl:Class ;
                        owl:oneOf ( ns1:UbiJalar
                                    ns1:UbiKayu
                                  )
                      ] ;
             ns1:diserangPenyakit ns1:LayuFusariumUbiJalar ,
                                  ns1:PenyakitBercakKuningUbiJalar ,
                                  ns1:PenyakitBusukHitamBlackRotUbiJalar ,
                                  ns1:PenyakitKudisUbiJalar ;
             ns1:memilikiKondisiTumbuh ns1:KondisiTanahGembur ;
             ns1:memilikiVarietas ns1:VarietasAbomourow ,
                                  ns1:VarietasBonsasarai ,
                                  ns1:VarietasInanwatan4 ,
                                  ns1:VarietasKuyage2 ,
                                  ns1:VarietasMouwebsi ,
                                  ns1:VarietasWonembai ;
             ns1:deskripsiTanaman "Ubi jalar (Ipomoea batatas L. (Lam) adalah salah satu komoditas pangan penting di dunia yang menduduki urutan ketujuh (FAOSTAT, 2009), setelah gandum, beras, jagung, kentang, barley, dan ubi kayu (Aguoru, Uhia and Olasan, 2015). Produksi terbesar di Asia sebanyak 76.1% dari produksi di dunia pada tahun 2013, diikuti Afrika dan terdapat 5 negara produsen terbesar di dunia yang memproduksi ubi jalar pada tahun 2014 yaitu Cina, Nigeria, Uganda, Indonesia, dan United Republic dari Tanzania (FAOSTAT 2015 dalam Okada et al. 2017). Sebagai sumber karbohidrat, ubi jalar memiliki potensi untuk dikembangkan dalam menunjang program diversifikasi pangan (Barahima and Purnomo, 2003). Selain itu, ubi jalar banyak mengandung pro- vitamin, vitamin C, potasium, besi, dan kalsium (Clark et al., 2013)."@id ;
             ns1:identifierSumber "PLANT_004" ;
             ns1:namaIlmiah "Ipomoea batatas L. (Lam)" ;
             rdfs:comment "Tanaman pangan dalam ruang lingkup knowledge base."@id ,
                          "Ubi jalar (Ipomoea batatas L. (Lam) adalah salah satu komoditas pangan penting di dunia yang menduduki urutan ketujuh (FAOSTAT, 2009), setelah gandum, beras, jagung, kentang, barley, dan ubi kayu (Aguoru, Uhia and Olasan, 2015). Produksi terbesar di Asia sebanyak 76.1% dari produksi di dunia pada tahun 2013, diikuti Afrika dan terdapat 5 negara produsen terbesar di dunia yang memproduksi ubi jalar pada tahun 2014 yaitu Cina, Nigeria, Uganda, Indonesia, dan United Republic dari Tanzania (FAOSTAT 2015 dalam Okada et al. 2017). Sebagai sumber karbohidrat, ubi jalar memiliki potensi untuk dikembangkan dalam menunjang program diversifikasi pangan (Barahima and Purnomo, 2003). Selain itu, ubi jalar banyak mengandung pro- vitamin, vitamin C, potasium, besi, dan kalsium (Clark et al., 2013)."@id ;
             rdfs:label "Ubi jalar"@id ;
             skos:prefLabel "Ubi jalar"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#UbiKayu
ns1:UbiKayu rdf:type owl:NamedIndividual ,
                     ns1:EntitasKBR ,
                     ns1:TanamanPangan ,
                     ns1:UmbiUmbian ,
                     [ rdf:type owl:Class ;
                       owl:oneOf ( ns1:UbiJalar
                                   ns1:UbiKayu
                                 )
                     ] ;
            ns1:berkaitanPengendalian ns1:KarantinaTanaman ,
                                      ns1:PanenTepatWaktu ,
                                      ns1:PemupukanBerimbang ,
                                      ns1:PengairanDanDrainase ,
                                      ns1:PengaturanJarakTanam ,
                                      ns1:PenggunaanVarietasTahan ,
                                      ns1:PengumpulanDanPemusnahan ,
                                      ns1:RotasiTanaman ,
                                      ns1:SanitasiLahan ,
                                      ns1:SeleksiBahanTanam ;
            ns1:didukungOleh ns1:BuktiPengendalianUmumUbiKayu ,
                             ns1:BuktiPengendalianUmumUbiKayu2 ,
                             ns1:BuktiPengendalianUmumUbiKayu3 ,
                             ns1:BuktiPengendalianUmumUbiKayu4 ,
                             ns1:BuktiPengendalianUmumUbiKayu5 ;
            ns1:diserangPenyakit ns1:AntraknosaUbiKayuBatang ,
                                 ns1:AntraknosaUbiKayuDaun ,
                                 ns1:BercakDaunBaurUbiKayu ,
                                 ns1:BercakDaunCoklatUbiKayu ,
                                 ns1:BercakDaunPutihUbiKayu ,
                                 ns1:BusukAkarDanUmbiUbiKayu ,
                                 ns1:BusukAkarUbiKayu ,
                                 ns1:BusukPangkalBatangUbiKayu ,
                                 ns1:BusukUmbiUbiKayu ,
                                 ns1:CassavaBrownStreakDiseaseCBSDUbiKayu ,
                                 ns1:CassavaMosaicBegomovirusCMBsUbiKayu ,
                                 ns1:HawarBakteriUbiKayu ,
                                 ns1:HawarDaunBakteriUbiKayu ,
                                 ns1:NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu ,
                                 ns1:SapuSetanWitchesBroomUbiKayu ,
                                 ns1:SuperelongasiUbiKayu ,
                                 ns1:TanamanKerdilStuntUbiKayu ;
            ns1:memilikiKondisiTumbuh ns1:KondisiTanahSubur ;
            ns1:pengendalianUmum ns1:KarantinaTanaman ,
                                 ns1:PanenTepatWaktu ,
                                 ns1:PemupukanBerimbang ,
                                 ns1:PengairanDanDrainase ,
                                 ns1:PengaturanJarakTanam ,
                                 ns1:PenggunaanVarietasTahan ,
                                 ns1:PengumpulanDanPemusnahan ,
                                 ns1:RotasiTanaman ,
                                 ns1:SanitasiLahan ,
                                 ns1:SeleksiBahanTanam ;
            ns1:deskripsiTanaman "Indonesia dengan keragaman budayanya turut membentuk keragaman makanan pokok masyarakatnya yang disebabkan oleh kearifan lokal serta adat. Hal ini mengakibatkan masyarakat membudidayakan tanaman pangan tersebut, meskipun pada kalangan masyarakat Indonesia secara umum saat ini identik dengan nasi sebagai makanan pokok atau utama. Pola konsumsi yang diperkenalkan oleh para leluhur dan terjadi secara turun temurun, menyebabkan masyarakat adat membudidayakan tanaman-tanaman tersebut sebagai sumber pangan yang juga dimanfaatkan sebagai makanan pokok. Tanaman pangan yang dimanfaatkan sebagai makanan pokok di Indonesia di antaranya yaitu merupakan kelompok umbi-umbian, antara lain ubi kayu, ubi jalar, gembili, ganyong."@id ;
            ns1:identifierSumber "PLANT_005" ;
            ns1:namaIlmiah "Manihot esculenta Crantz" ;
            rdfs:comment "Indonesia dengan keragaman budayanya turut membentuk keragaman makanan pokok masyarakatnya yang disebabkan oleh kearifan lokal serta adat. Hal ini mengakibatkan masyarakat membudidayakan tanaman pangan tersebut, meskipun pada kalangan masyarakat Indonesia secara umum saat ini identik dengan nasi sebagai makanan pokok atau utama. Pola konsumsi yang diperkenalkan oleh para leluhur dan terjadi secara turun temurun, menyebabkan masyarakat adat membudidayakan tanaman-tanaman tersebut sebagai sumber pangan yang juga dimanfaatkan sebagai makanan pokok. Tanaman pangan yang dimanfaatkan sebagai makanan pokok di Indonesia di antaranya yaitu merupakan kelompok umbi-umbian, antara lain ubi kayu, ubi jalar, gembili, ganyong."@id ,
                         "Tanaman pangan dalam ruang lingkup knowledge base."@id ;
            rdfs:label "Ubi kayu"@id ;
            skos:prefLabel "Ubi kayu"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Umbi
ns1:Umbi rdf:type owl:NamedIndividual ,
                  ns1:BagianTanaman ,
                  ns1:EntitasKBR ;
         rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id ,
                      "Selain itu, kerusakan daun akibat serangan penyakit dapat menyebabkan penurunan aktivitas fotosintesis yang dapat berakibat pada penurunan hasil dan kualitas umbi akar."@id ;
         rdfs:label "Umbi"@id ;
         skos:prefLabel "Umbi"@id .


