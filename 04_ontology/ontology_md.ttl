kbr:GejalaPenyakitHawarDaunBakteriPadiBercakDaun a kbr:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun"@id ;
    kbr:deskripsiGejala "Xoo dapat menyerang semua fase tanaman padi melalui pori-pori air yang berada di tepi daun, sehingga lesi akan muncul mulai dari tepi daun."@id ;
