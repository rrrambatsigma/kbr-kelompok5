        ns1:Varietas ;
    skos:prefLabel "Gejala Kanonik"@id .

ns1:PenyakitKaratDaunJagung a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Karat Daun"@id ;
    ns1:berkaitanPengendalian ns1:PengaturanJarakTanam,
        ns1:PengaturanKelembapan,
        ns1:PengelolaanGulma,
        ns1:PenggunaanVarietasTahan,
        ns1:SanitasiLahan ;
    ns1:deskripsiPenyakit "Penyakit karat daun pada tanaman jagung disebabkan oleh Puccinia polysora Underw. Jamur patogen ini biasanya menimbulkan gejala pada bagian permukaan daun bagian atas, tidak pada bagian bawah daun. Keparahan lebih lanjut menyebabkan jaringan tanaman mengering dan nekrosis (Debnath et al., 2019)."@id ;
    ns1:didukungOleh ns1:BuktiLingkunganPenyakitKaratDaunJagung,
        ns1:BuktiLingkunganPenyakitKaratDaunJagung2,
        ns1:BuktiMetadataPhasePenyakitKaratDaunJagung,
        ns1:BuktiMetadataSeverityPenyakitKaratDaunJagung,
        ns1:BuktiPatogenPenyakitKaratDaunJagung,
        ns1:BuktiPengendalianPenyakitKaratDaunJagung,
        ns1:BuktiPengendalianPenyakitKaratDaunJagung2,
        ns1:BuktiPengendalianPenyakitKaratDaunJagung3,
        ns1:BuktiPenyakitPenyakitKaratDaunJagung ;
    ns1:dikendalikanDengan ns1:PengaturanJarakTanam,
        ns1:PengaturanKelembapan,
        ns1:PengelolaanGulma,
        ns1:PenggunaanVarietasTahan,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:KondisiSuhuRendah,
        ns1:ObservasiPenyakitKaratDaunJagungSuhu25Koma2Sampai28Koma8Celsius ;
    ns1:disebabkanOleh ns1:PucciniaPolysora ;
    ns1:identifierSumber "DIS_045" ;
    ns1:memilikiGejala ns1:GejalaPenyakitKaratDaunJagung,
        ns1:GejalaPenyakitKaratDaunJagung2,
        ns1:GejalaPenyakitKaratDaunJagung3,
        ns1:GejalaPenyakitKaratDaunJagung4,
        ns1:GejalaPenyakitKaratDaunJagung5,
        ns1:GejalaPenyakitKaratDaunJagung6,
        ns1:GejalaPenyakitKaratDaunJagung7,
        ns1:GejalaPenyakitKaratDaunJagung8,
        ns1:GejalaPenyakitKaratDaunJagungBercakTanaman,
        ns1:GejalaPenyakitKaratDaunJagungKlorosisDaun ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Daun ;
    ns1:menyerangFase ns1:FaseGeneratifUmum ;
    ns1:menyerangTanaman ns1:Jagung ;
    ns1:tingkatKeparahan "Keparahan penyakit yang disebabkan karat daun dapat berkisar antara 26.67% hingga 90.91%."@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit karat daun pada tanaman jagung disebabkan oleh Puccinia polysora Underw. Jamur patogen ini biasanya menimbulkan gejala pada bagian permukaan daun bagian atas, tidak pada bagian bawah daun. Keparahan lebih lanjut menyebabkan jaringan tanaman mengering dan nekrosis (Debnath et al., 2019)."@id ;
    skos:prefLabel "Penyakit Karat Daun"@id .

ns1:Batang a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Batang"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id,
        "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
    skos:prefLabel "Batang"@id .

