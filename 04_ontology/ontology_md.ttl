ns1:GejalaBuah a owl:Class ;
    rdfs:label "Gejala Buah"@id ;
    rdfs:comment "Gejala yang diamati pada buah."@id,
        "flowchart TD subgraph A A1[\"Batang konidia pada permukaan atas daun\"] --> A2[\"Spora disebarkan oleh angin, percikan air dan serangga\"] A2 --> A3[\"Infeksi didalam jaringan tanaman inang\"] A3 --> A4[\"Miselium tanpa hauspora\"] A4 --> A5[\"Badan buah conidien pada sisi-sisi tanaman\"] A5 --> A6[\"Pseudothecium Mycosphaerella arachidia\"] A6 --> A7[\"Gejala bercak daun awal\"] A7 --> A8[\"Permukaan atas daun\"] A8 --> A1 end subgraph B B1[\"Batang konidia pada permukaan bawah daun\"] --> B2[\"Spora disebarkan oleh angin, percikan air dan serangga\"] B2 --> B3[\"Infeksi dari jaringan tanaman inang\"] B3 --> B4[\"Miselium didalam sel dengan hauspora\"] B4 --> B5[\"Badan buah conidien pada sisi-sisi tanaman\"] B5 --> B6[\"Pseudothecium Mycosphaerella berkoknyi\"] B6 --> B7[\"Gejala bercak daun lambat\"] B7 --> B8[\"Permukaan bawah daun\"] B8 --> B1 end"@id ;
    rdfs:subClassOf ns1:Gejala ;
    skos:prefLabel "Gejala Buah"@id .

