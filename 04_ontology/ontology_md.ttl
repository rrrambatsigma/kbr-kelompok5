@prefix ns1: <http://kbr.kelompok5.org/penyakit-tanaman-pangan#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://kbr.kelompok5.org/penyakit-tanaman-pangan> a owl:Ontology ;
    rdfs:label "Ontologi Penyakit Tanaman Pangan Indonesia"@id ;
    rdfs:comment "Knowledge base penyakit tanaman pangan Indonesia untuk tujuh tanaman: padi, jagung, kedelai, kacang hijau, kacang tanah, ubi kayu, dan ubi jalar."@id .

ns1:Bunga a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Bunga"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id,
        "Tanaman padi yang terserang virus tungro umumnya hanya hidup hingga stadia pemasakan dengan gejala terhambatnya proses pembungaan, tidak sempurnanya malai dengan bulir yang tertutup bercak coklat (Puslitbang 2005)."@id ;
    skos:prefLabel "Bunga"@id .

ns1:Drainase a owl:Class ;
    rdfs:label "Drainase"@id ;
    rdfs:comment "Faktor pengaturan drainase."@id,
        "Penyakit yang disebabkan oleh S. rolfsii di lahan yang saluran air atau drainasenya tidak bagus (Saputri et al., 2015)."@id ;
    rdfs:subClassOf ns1:FaktorBudidaya ;
    skos:prefLabel "Drainase"@id .

ns1:FaktorRotasiTanaman a owl:Class ;
    rdfs:label "Faktor Rotasi Tanaman"@id ;
    rdfs:comment "Berdasarkan faktor-faktor di atas maka penting untuk melakukan modifikasi lingkungan tanam, dengan menjaga tingkat kelembapan dan pH tanah, sehingga menjadi tidak kondusif untuk perkembangan penyakit. b) Tanaman inang Cendawan ini diketahui memiliki kisaran inang yang luas, di antaranya berbagai famili tanaman budidaya dan gulma, sehingga budidaya secara polikultur atau rotasi tanaman tidak dapat membantu menekan perkembangan inokulum di lapang. c) Ketersediaan sumber inokulum Inokulum S.rolfsii terutama berada di dalam tanah dan sisa tanaman terinfeksi."@id,
        "Faktor pergiliran tanaman."@id ;
    rdfs:subClassOf ns1:FaktorBudidaya ;
    skos:prefLabel "Faktor Rotasi Tanaman"@id .

ns1:FaktorSanitasiLahan a owl:Class ;
    rdfs:label "Faktor Sanitasi Lahan"@id ;
    rdfs:comment "Faktor kebersihan lahan dan sisa tanaman."@id ;
    rdfs:subClassOf ns1:FaktorBudidaya ;
    skos:prefLabel "Faktor Sanitasi Lahan"@id .

ns1:GejalaBunga a owl:Class ;
    rdfs:label "Gejala Bunga"@id ;
    rdfs:comment "Gejala yang diamati pada bunga."@id,
        "Tanaman padi yang terserang virus tungro umumnya hanya hidup hingga stadia pemasakan dengan gejala terhambatnya proses pembungaan, tidak sempurnanya malai dengan bulir yang tertutup bercak coklat (Puslitbang 2005)."@id ;
    rdfs:subClassOf ns1:Gejala ;
    skos:prefLabel "Gejala Bunga"@id .

ns1:Iklim a owl:Class ;
    rdfs:label "Iklim"@id ;
    rdfs:comment "Faktor iklim umum."@id,
        "Kemudian sanitasi dari keberadaan gulma, singgang, dan ceceran gabah yang dapat menjadi inang alternatif bagi patogen maupun vektor, penanaman sistem jajar legowo yang dapat memanipulasi kondisi mikro iklim di bawah kanopi tidak sesuai untuk patogen, pengeringan sawah untuk menekan populasi nimfa wereng hijau."@id ;
    rdfs:subClassOf ns1:FaktorLingkungan ;
    skos:prefLabel "Iklim"@id .

ns1:IntensitasCahaya a owl:Class ;
    rdfs:label "Intensitas Cahaya"@id ;
    rdfs:comment "Faktor intensitas cahaya."@id,
        "Menurut Sudjono (1979), penjemuran daun kedelai yang terinfeksi di bawah sinar matahari dengan intensitas cahaya 700 lux dapat menurunkan daya kecambah urediospora yang hanya mampu bertahan selama 6 jam, selain itu sinar ultra violet juga menurunkan daya kecambah urediospora."@id ;
    rdfs:subClassOf ns1:FaktorLingkungan ;
    skos:prefLabel "Intensitas Cahaya"@id .

ns1:JarakTanam a owl:Class ;
    rdfs:label "Jarak Tanam"@id ;
    rdfs:comment "Faktor jarak tanam."@id,
        "Kultur teknis, melalui pengaturan jarak tanam tidak terlalu rapat, pengeringan sawah beberapa hari pada saat anakan maksimum, pemusnahan atau pengomposan sisa-sisa tanaman yang terinfeksi (Puslitbangtan 2005)."@id ;
    rdfs:subClassOf ns1:FaktorBudidaya ;
    skos:prefLabel "Jarak Tanam"@id .

ns1:KelembapanTanah a owl:Class ;
    rdfs:label "Kelembapan Tanah"@id ;
    rdfs:comment "Faktor kelembapan tanah."@id,
        "Kelembapan tanah juga mempengaruhi kejadian penyakit di lapang."@id ;
    rdfs:subClassOf ns1:FaktorLingkungan ;
    skos:prefLabel "Kelembapan Tanah"@id .

ns1:KetinggianTempat a owl:Class ;
    rdfs:label "Ketinggian Tempat"@id ;
    rdfs:comment "Faktor ketinggian tempat."@id ;
    rdfs:subClassOf ns1:FaktorLingkungan ;
    skos:prefLabel "Ketinggian Tempat"@id .

ns1:KondisiCahayaRendah a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Cahaya rendah"@id ;
    rdfs:comment "Tanaman kedelai yang diberi perlakuan tanpa cahaya matahari maka pertumbuhan atau tinggi tanaman lebih cepat tetapi berat kering atau biomassa tanaman menjadi rendah yang juga berpengaruh terhadap ukuran polong menjadi lebih kecil (Syach et al., 2019)."@id .

ns1:KondisiCahayaTinggi a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Cahaya tinggi"@id ;
    rdfs:comment "Pada lingkungan dengan naungan yang tinggi maka berpengaruh cahaya yang diterima tanaman kedelai."@id .

ns1:KondisiCurahHujanRendah a ns1:CurahHujan,
        ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Curah hujan rendah"@id ;
    rdfs:comment "Kondisi lingkungan kualitatif terkait penyakit tanaman."@id ;
    skos:prefLabel "Curah hujan rendah"@id .

ns1:KondisiCurahHujanSedang a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Curah hujan sedang"@id ;
    rdfs:comment "Wilayah Mbeya mempunyai keparahan penyakit paling tinggi karena suhu minimum (13.9°C) dan maksimum (23.7°C) yang rendah dan kelembaban relatif sedang (67%) dan curah hujan 386.1 mm dalam dua musim tanam."@id .

ns1:KondisiDataranRendah a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Dataran rendah"@id ;
    rdfs:comment "Perbedaan dapat dilihat wilayah yang dataran tinggi berbeda dengan dataran rendah dalam proses penyiraman."@id .

ns1:KondisiDataranTinggi a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Dataran tinggi"@id ;
    rdfs:comment "Perbedaan dapat dilihat wilayah yang dataran tinggi berbeda dengan dataran rendah dalam proses penyiraman."@id .

ns1:KondisiDrainase a owl:Class ;
    rdfs:label "Kondisi Drainase"@id ;
    rdfs:comment "Faktor kondisi drainase lahan."@id ;
    rdfs:subClassOf ns1:FaktorLahan ;
    skos:prefLabel "Kondisi Drainase"@id .

ns1:KondisiDrainaseBaik a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Drainase baik"@id ;
    rdfs:comment "Karakter tanah ideal bagi apel adalah bertekstur sedang, gembur dengan kedalaman efektif lebih dari 50 cm, berdrainase baik dengan pH tanah berkisar 5,5 – 7 (Jackson, 2003)."@id .

ns1:KondisiDrainaseBuruk a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Drainase buruk"@id ;
    rdfs:comment "Misalnya, lahan tergenang, drainase yang buruk, serta pemupukan yang tidak tepat."@id .

ns1:KondisiIklimBasah a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Iklim basah"@id .

ns1:KondisiIklimKering a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Iklim kering"@id ;
    rdfs:comment "Selain bersuhu dingin, apel menghendaki iklim kering atau berhujan 1.000 – 2.500 mm tiap tahunnya dengan intensitas penyinaran matahari sekitar 50 – 60 % per hari."@id .

ns1:KondisiKelembapanRendah a ns1:KelembapanUdara,
        owl:NamedIndividual ;
    rdfs:label "Kelembapan rendah"@id ;
    rdfs:comment "Kondisi lingkungan kualitatif terkait penyakit tanaman."@id ;
    skos:prefLabel "Kelembapan rendah"@id .

ns1:KondisiKelembapanUdaraRendah a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Kelembapan udara rendah"@id .

ns1:KondisiKelembapanUdaraSedang a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Kelembapan udara sedang"@id .

ns1:KondisiKelembapanUdaraTinggi a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Kelembapan udara tinggi"@id .

ns1:KondisiSuhuHangat a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Suhu hangat"@id ;
    rdfs:comment "Lingkungan yang mendukung untuk perkembangan patogen adalah kondisi lingkungan yang lembab yaitu > 85% selama 5-7 hari dan suhu hangat."@id .

ns1:KondisiTanah a owl:Class ;
    rdfs:label "Kondisi Tanah"@id ;
    rdfs:comment "Faktor kondisi tanah."@id,
        "Pada kondisi lembab jamur S. rolfsii dapat berkembang dan menginfeksi bagian daun dan batang tanaman yang berada di dekat tanah."@id ;
    rdfs:subClassOf ns1:FaktorLahan ;
    skos:prefLabel "Kondisi Tanah"@id .

ns1:KondisiTanahAsam a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Tanah asam"@id ;
    rdfs:comment """Selain itu kandungan riboflavin dan asam

askorbat mempengaruhi ketahanan kacang tanah."""@id .

ns1:KondisiTanahBasa a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Tanah basa"@id .

ns1:KondisiTanahBerpasir a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Tanah berpasir"@id .

ns1:KondisiTanahGembur a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Tanah gembur"@id ;
    rdfs:comment "Tanaman ini dapat tumbuh di dataran rendah sampai dataran tinggi dan menginginkan tanah dengan aerasi yang baik, subur, gembur dengan pH berkisar antara 5-6."@id .

ns1:KondisiTanahLiat a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Tanah liat"@id .

ns1:KondisiTanahNetral a ns1:FaktorLingkungan,
        owl:NamedIndividual ;
    rdfs:label "Tanah netral"@id .

ns1:MalaiKosong a ns1:GejalaKanonik,
        owl:NamedIndividual ;
    rdfs:label "Malai kosong"@id ;
    rdfs:comment "Konsep kanonik untuk malai kosong atau hampa."@id ;
    skos:altLabel "malai kosong"@id ;
    skos:prefLabel "Malai kosong"@id .

ns1:PemangkasanTanaman a ns1:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Pemangkasan tanaman"@id ;
    ns1:namaPengendalian "Pemangkasan tanaman"@id ;
    rdfs:comment "Tindakan kanonik pemangkasan bagian tanaman."@id ;
    skos:prefLabel "Pemangkasan tanaman"@id .

ns1:PembersihanAlat a ns1:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Pembersihan alat"@id ;
    ns1:namaPengendalian "Pembersihan alat"@id ;
    rdfs:comment "Tindakan kanonik pembersihan dan sterilisasi alat."@id ;
    skos:prefLabel "Pembersihan alat"@id .

ns1:Pemupukan a owl:Class ;
    rdfs:label "Pemupukan"@id ;
    rdfs:comment "Faktor pemupukan."@id,
        "Kultur teknis, melalui penggunaan benih sehat, pencabutan tunggul yang terinfeksi, jerami dan gulma dari lahan yang terinfeksi dihilangkan, menghindari pemupukan nitrogen yang berlebihan dan pemberian pupuk K yang berimbang (Sudir et al. 2012; Naqvi 2019), tidak dianjurkan memotong bibit sebelum tanah supaya mencegah terjadinya infeksi patogen dan pola tanam dianjurkan memakai sistem legowo dengan sistem pengairan berselang."@id ;
    rdfs:subClassOf ns1:FaktorBudidaya ;
    skos:prefLabel "Pemupukan"@id .

ns1:PenerapanKulturTeknis a ns1:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Penerapan kultur teknis"@id ;
    ns1:namaPengendalian "Penerapan kultur teknis"@id ;
    rdfs:comment "Tindakan kanonik penerapan kultur teknis secara umum."@id ;
    skos:prefLabel "Penerapan kultur teknis"@id .

ns1:PenerapanPengendalianBiologis a ns1:PengendalianBiologis,
        owl:NamedIndividual ;
    rdfs:label "Penerapan pengendalian biologis"@id ;
    ns1:namaPengendalian "Penerapan pengendalian biologis"@id ;
    rdfs:comment "Tindakan kanonik penerapan pengendalian biologis secara umum."@id ;
    skos:prefLabel "Penerapan pengendalian biologis"@id .

ns1:PenerapanPengendalianKimiawi a ns1:PengendalianKimiawi,
        owl:NamedIndividual ;
    rdfs:label "Penerapan pengendalian kimiawi"@id ;
    ns1:namaPengendalian "Penerapan pengendalian kimiawi"@id ;
    rdfs:comment "Tindakan kanonik penerapan pengendalian kimiawi secara umum."@id ;
    skos:prefLabel "Penerapan pengendalian kimiawi"@id .

ns1:Pengairan a owl:Class ;
    rdfs:label "Pengairan"@id ;
    rdfs:comment "Faktor pengairan."@id,
        "Kultur teknis, melalui penggunaan benih sehat, pencabutan tunggul yang terinfeksi, jerami dan gulma dari lahan yang terinfeksi dihilangkan, menghindari pemupukan nitrogen yang berlebihan dan pemberian pupuk K yang berimbang (Sudir et al. 2012; Naqvi 2019), tidak dianjurkan memotong bibit sebelum tanah supaya mencegah terjadinya infeksi patogen dan pola tanam dianjurkan memakai sistem legowo dengan sistem pengairan berselang."@id ;
    rdfs:subClassOf ns1:FaktorBudidaya ;
    skos:prefLabel "Pengairan"@id .

ns1:PengaturanSuhuPenyimpanan a ns1:PengendalianFisik,
        owl:NamedIndividual ;
    rdfs:label "Pengaturan suhu penyimpanan"@id ;
    ns1:namaPengendalian "Pengaturan suhu penyimpanan"@id ;
    rdfs:comment "Tindakan kanonik pengaturan suhu penyimpanan."@id ;
    skos:prefLabel "Pengaturan suhu penyimpanan"@id .

ns1:PengelolaanTerpadu a ns1:PengendalianTerpadu,
        owl:NamedIndividual ;
    rdfs:label "Pengelolaan terpadu"@id ;
    ns1:namaPengendalian "Pengelolaan terpadu"@id ;
    rdfs:comment "Tindakan kanonik pengelolaan terpadu."@id ;
    skos:prefLabel "Pengelolaan terpadu"@id .

ns1:PengendalianHamaTerpadu a ns1:PengendalianTerpadu,
        owl:NamedIndividual ;
    rdfs:label "Pengendalian hama terpadu"@id ;
    ns1:namaPengendalian "Pengendalian hama terpadu"@id ;
    rdfs:comment "Tindakan kanonik pengendalian hama terpadu."@id ;
    skos:prefLabel "Pengendalian hama terpadu"@id .

ns1:PenggunaanBenih a owl:Class ;
    rdfs:label "Penggunaan Benih"@id ;
    rdfs:comment "Faktor mutu dan asal benih."@id,
        "Kultur teknis, melalui penggunaan benih sehat, pencabutan tunggul yang terinfeksi, jerami dan gulma dari lahan yang terinfeksi dihilangkan, menghindari pemupukan nitrogen yang berlebihan dan pemberian pupuk K yang berimbang (Sudir et al. 2012; Naqvi 2019), tidak dianjurkan memotong bibit sebelum tanah supaya mencegah terjadinya infeksi patogen dan pola tanam dianjurkan memakai sistem legowo dengan sistem pengairan berselang."@id ;
    rdfs:subClassOf ns1:FaktorBudidaya ;
    skos:prefLabel "Penggunaan Benih"@id .

ns1:PenggunaanPerangkap a ns1:PengendalianMekanis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan perangkap"@id ;
    ns1:namaPengendalian "Penggunaan perangkap"@id ;
    rdfs:comment "Tindakan kanonik penggunaan perangkap."@id ;
    skos:prefLabel "Penggunaan perangkap"@id .

ns1:PenyakitBakteri a owl:Class ;
    rdfs:label "Penyakit Bakteri"@id ;
    rdfs:comment "Penyakit yang disebabkan oleh patogen kelompok bakteri."@id,
        "Penyakit yang juga sering menyerang pada tanaman kedelai adalah penyakit bakteri pustul."@id ;
    rdfs:subClassOf ns1:Penyakit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Penyakit [ a owl:Restriction ;
                        owl:onProperty ns1:disebabkanOleh ;
                        owl:someValuesFrom ns1:Bakteri ] ) ] ;
    skos:prefLabel "Penyakit Bakteri"@id .

ns1:PenyakitFitoplasma a owl:Class ;
    rdfs:label "Penyakit Fitoplasma"@id ;
    rdfs:comment "Manihotis, serta penyakit-penyakit yang disebabkan oleh virus dan fitoplasma."@id,
        "Penyakit yang disebabkan oleh patogen kelompok fitoplasma."@id ;
    rdfs:subClassOf ns1:Penyakit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Penyakit [ a owl:Restriction ;
                        owl:onProperty ns1:disebabkanOleh ;
                        owl:someValuesFrom ns1:Fitoplasma ] ) ] ;
    skos:prefLabel "Penyakit Fitoplasma"@id .

ns1:PenyakitJamur a owl:Class ;
    rdfs:label "Penyakit Jamur"@id ;
    rdfs:comment "Pengendalian menggunakan agens hayati seperti jamur dan bakteri antagonis dapat dilakukan untuk menekan perkembangan penyakit."@id,
        "Penyakit yang disebabkan oleh patogen kelompok jamur."@id ;
    rdfs:subClassOf ns1:Penyakit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Penyakit [ a owl:Restriction ;
                        owl:onProperty ns1:disebabkanOleh ;
                        owl:someValuesFrom ns1:Jamur ] ) ] ;
    skos:prefLabel "Penyakit Jamur"@id .

ns1:PenyakitNematoda a owl:Class ;
    rdfs:label "Penyakit Nematoda"@id ;
    rdfs:comment "Penyakit yang disebabkan oleh patogen kelompok nematoda."@id,
        "Seperti halnya tanaman lain, kelapa sawit mudah terserang penyakit tanaman yang disebabkan oleh jamur, bakteri, virus, nematoda, viroid dan *fitoplasm*a (Nurrashyeda et al., 2018)."@id ;
    rdfs:subClassOf ns1:Penyakit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Penyakit [ a owl:Restriction ;
                        owl:onProperty ns1:disebabkanOleh ;
                        owl:someValuesFrom ns1:Nematoda ] ) ] ;
    skos:prefLabel "Penyakit Nematoda"@id .

ns1:PenyakitOomycete a owl:Class ;
    rdfs:label "Penyakit Oomycete"@id ;
    rdfs:comment "Penyakit yang disebabkan oleh patogen kelompok oomycete."@id ;
    rdfs:subClassOf ns1:Penyakit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Penyakit [ a owl:Restriction ;
                        owl:onProperty ns1:disebabkanOleh ;
                        owl:someValuesFrom ns1:Oomycete ] ) ] ;
    skos:prefLabel "Penyakit Oomycete"@id .

ns1:PenyakitPenyebabTidakDiketahui a owl:Class ;
    rdfs:label "Penyakit dengan Penyebab Tidak Diketahui"@id ;
    rdfs:comment "Penyakit yang sumbernya menyatakan penyebab belum diketahui."@id ;
    rdfs:subClassOf ns1:Penyakit ;
    skos:prefLabel "Penyakit dengan Penyebab Tidak Diketahui"@id .

ns1:PenyakitVirus a owl:Class ;
    rdfs:label "Penyakit Virus"@id ;
    rdfs:comment "Di Indonesia, penyakit virus belang diketahui telah tersebar luas di sentra tanaman kacang tanah."@id,
        "Penyakit yang disebabkan oleh patogen kelompok virus."@id ;
    rdfs:subClassOf ns1:Penyakit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Penyakit [ a owl:Restriction ;
                        owl:onProperty ns1:disebabkanOleh ;
                        owl:someValuesFrom ns1:Virus ] ) ] ;
    skos:prefLabel "Penyakit Virus"@id .

ns1:PerlakuanRadiasi a ns1:PengendalianFisik,
        owl:NamedIndividual ;
    rdfs:label "Perlakuan radiasi"@id ;
    ns1:namaPengendalian "Perlakuan radiasi"@id ;
    rdfs:comment "Tindakan kanonik perlakuan radiasi."@id ;
    skos:prefLabel "Perlakuan radiasi"@id .

ns1:TeksturTanah a owl:Class ;
    rdfs:label "Tekstur Tanah"@id ;
    rdfs:comment "Faktor tekstur tanah."@id,
        "Karakter tanah ideal bagi apel adalah bertekstur sedang, gembur dengan kedalaman efektif lebih dari 50 cm, berdrainase baik dengan pH tanah berkisar 5,5 – 7 (Jackson, 2003)."@id ;
    rdfs:subClassOf ns1:FaktorLahan ;
    skos:prefLabel "Tekstur Tanah"@id .

ns1:alasanKecocokan a owl:DatatypeProperty ;
    rdfs:label "alasan kecocokan"@id ;
    rdfs:comment "Alasan kecocokan kandidat diagnosis."@id ;
    rdfs:domain ns1:KandidatDiagnosis ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "alasan kecocokan"@id .

ns1:catatanKualitas a owl:DatatypeProperty ;
    rdfs:label "catatan kualitas"@id ;
    rdfs:comment "Catatan kualitas atau keterbatasan kutipan sumber."@id ;
    rdfs:domain ns1:BuktiSumber ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "catatan kualitas"@id .

ns1:deskripsiGejala a owl:DatatypeProperty ;
    rdfs:label "deskripsi gejala"@id ;
    rdfs:comment "Deskripsi pengamatan gejala menurut sumber."@id ;
    rdfs:domain ns1:Gejala ;
