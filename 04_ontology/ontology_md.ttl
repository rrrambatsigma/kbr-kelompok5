kbr:KarantinaTanaman a kbr:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Karantina tanaman"@id ;
    kbr:deskripsiPengendalian "Selain itu, tindakan pengendalian penyakit tanaman ubi kayu pada kejadian penyakit yang tinggi perlu dilakukan melalui penggunaan pestisida secara tepat guna dan sesuai dosis yang dianjurkan, eradikasi atau pemusnahan dengan membakar sisa-sisa tanaman yang sakit, serta karantina lokasi untuk mencegah penyebaran dan outbreak patogen."@id ;
    kbr:didukungOleh kbr:BuktiPengendalianUmumUbiKayu4 ;
    kbr:namaPengendalian "Karantina tanaman"@id ;
    dcterms:source "Kurasi pakar"@id ;
    rdfs:comment "Tindakan kanonik karantina atau isolasi tanaman."@id ;
    skos:altLabel "karantina tanaman"@id ;
    skos:definition "Mengisolasi tanaman atau bahan tanam yang terinfeksi untuk mencegah penyebaran penyakit."@id ;
    skos:prefLabel "Karantina tanaman"@id .

