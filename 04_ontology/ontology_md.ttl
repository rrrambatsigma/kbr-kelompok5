###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#LayuFusariumUbiJalar
ns1:LayuFusariumUbiJalar rdf:type owl:NamedIndividual ,
                                  ns1:EntitasKBR ,
                                  ns1:Penyakit ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:disebabkanOleh ;
                                    owl:someValuesFrom ns1:Jamur
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:memilikiGejala ;
                                    owl:someValuesFrom ns1:Gejala
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:menyerangTanaman ;
                                    owl:someValuesFrom ns1:TanamanPangan
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:disebabkanOleh ;
                                    owl:allValuesFrom ns1:Patogen
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:memilikiReferensi ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass ns1:Referensi
                                  ] ;
                         ns1:berkaitanPengendalian ns1:PengaturanSuhuPenyimpanan ,
                                                   ns1:PenggunaanFungisida ,
                                                   ns1:PenggunaanVarietasTahan ,
                                                   ns1:SanitasiLahan ;
                         ns1:didukungOleh ns1:BuktiPatogenLayuFusariumUbiJalar ,
                                          ns1:BuktiPengendalianLayuFusariumUbiJalar ,
                                          ns1:BuktiPengendalianLayuFusariumUbiJalar2 ,
                                          ns1:BuktiPengendalianLayuFusariumUbiJalar3 ,
                                          ns1:BuktiPengendalianLayuFusariumUbiJalar4 ,
                                          ns1:BuktiPengendalianLayuFusariumUbiJalar5 ,
                                          ns1:BuktiPenyakitLayuFusariumUbiJalar ;
                         ns1:dikendalikanDengan ns1:PengaturanSuhuPenyimpanan ,
                                                ns1:PenggunaanFungisida ,
                                                ns1:PenggunaanVarietasTahan ,
                                                ns1:SanitasiLahan ;
                         ns1:dipengaruhiOleh ns1:KelembapanTanah2875PersenPadaLayuFusariumUbiJalar ,
                                             ns1:SuhuInfeksiOptimalPadaLayuFusariumUbiJalar ;
                         ns1:disebabkanOleh ns1:FusariumOxysporum ;
                         ns1:memilikiGejala ns1:GejalaLayuFusariumUbiJalar ,
                                            ns1:GejalaLayuFusariumUbiJalarBusukTanaman ,
                                            ns1:GejalaLayuFusariumUbiJalarKematianTanaman ,
                                            ns1:GejalaLayuFusariumUbiJalarKerdilTanaman ,
                                            ns1:GejalaLayuFusariumUbiJalarKlorosisDaun ,
                                            ns1:GejalaLayuFusariumUbiJalarLayuDaun ,
                                            ns1:GejalaLayuFusariumUbiJalarMiseliumPadaTanaman ,
                                            ns1:GejalaLayuFusariumUbiJalarNekrosisTanaman ;
                         ns1:memilikiReferensi ns1:BukuDOC002 ;
                         ns1:menyerangBagian ns1:Batang ,
                                             ns1:Daun ;
                         ns1:menyerangTanaman ns1:UbiJalar ;
                         ns1:deskripsiPenyakit "Banyak dilaporkan bahwa Fusarium spp. menginfeksi ubi jalar di antaranya F. solani, F. proliferatum (Scruggs and Quesada-Ocampo, 2016), F. oxysporum (Scattolini, Hernandez and Gonzales, 2020), F. circinatum (Mousa et al., 2018), F. graminearum (Gaffoor et al., 2005). Genus Fusarium terkenal karena kemampuannya menghasilkan metabolit sekunder, beberapa di antaranya bersifat toksik pada manusia dan hewan (Desjardins, 2006). Berikut ini akan diuraikan F. oxysporum yang merupakan patogen penting pada ubi jalar."@id ;
                         ns1:identifierSumber "DIS_024" ;
                         rdfs:comment "Banyak dilaporkan bahwa Fusarium spp. menginfeksi ubi jalar di antaranya F. solani, F. proliferatum (Scruggs and Quesada-Ocampo, 2016), F. oxysporum (Scattolini, Hernandez and Gonzales, 2020), F. circinatum (Mousa et al., 2018), F. graminearum (Gaffoor et al., 2005). Genus Fusarium terkenal karena kemampuannya menghasilkan metabolit sekunder, beberapa di antaranya bersifat toksik pada manusia dan hewan (Desjardins, 2006). Berikut ini akan diuraikan F. oxysporum yang merupakan patogen penting pada ubi jalar."@id ,
                                      "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ;
                         rdfs:label "layu fusarium"@id ;
                         skos:prefLabel "layu fusarium"@id .


