    skos:altLabel "penggunaan beauveria"@id ;
    skos:definition "Memanfaatkan jamur Beauveria sebagai agens hayati pengendali serangga hama."@id ;
    skos:prefLabel "Penggunaan Beauveria"@id .

kbr:PenggunaanBiopestisida a kbr:PengendalianBiologis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan biopestisida"@id ;
    kbr:deskripsiPengendalian "Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati."@id ;
    kbr:didukungOleh kbr:BuktiPengendalianPenyakitLayuBakteriKacangTanah3,
        kbr:BuktiPengendalianUmumKacangTanah28 ;
    kbr:mengendalikanPenyakit kbr:PenyakitLayuBakteriKacangTanah ;
    kbr:namaPengendalian "Penggunaan biopestisida"@id ;
