        kbr:TanamanPangan ;
    skos:closeMatch <https://gwsp.cs.ksu.edu/nutrient-management/nutrient/Cultivar> ;
    skos:definition "Varietas tanaman yang disebut sumber, termasuk status tahan atau rentan."@id ;
