ns1:EMBUNBULUKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "EMBUN BULU"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianMenanamBenihSehatSangatMembantu_3446f4e4,
        ns1:PengendalianPenyemprotanDaunDenganFungisidaYang_bbd1f9cc,
        ns1:PengendalianPerlakuanBenihSebelumPenanamanSangat_af82962f ;
    ns1:deskripsiPenyakit "Penyakit embun bulu tersebar luas di sentra produksi kedelai dunia, meliputi China, Korea, Malaysia, Thailand, Brazil, Rumania, dan USA. Di Indonesia diketahui di pulau Jawa dan beberapa provinsi di pulau Sumatera. Kehilangan hasil akibat penyakit ini mencapai 6–18%. Meskipun kehilangan hasil tidak begitu tinggi, namun menyebabkan penurunan kualitas benih yang dihasilkan (Balitkabi 2018)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianMenanamBenihSehatSangatMembantu_3446f4e4,
        ns1:PengendalianPenyemprotanDaunDenganFungisidaYang_bbd1f9cc,
        ns1:PengendalianPerlakuanBenihSebelumPenanamanSangat_af82962f ;
    ns1:dipengaruhiOleh ns1:KondisiSuhu ;
    ns1:disebabkanOleh ns1:PeronosporaManshurica ;
    ns1:memilikiGejala ns1:GejalaPadaPermukaanBawahDaunWarna_af60e4dc,
        ns1:GejalaPenyakitEmbunBuluDiawaliMunculnya_71fb418c ;
    ns1:memilikiReferensi ns1:BukuDOC005 ;
    ns1:menyerangBagian ns1:Buah,
        ns1:Daun ;
    ns1:menyerangTanaman ns1:Kedelai ;
    ns1:tingkatKeparahan "Kehilangan hasil akibat penyakit ini mencapai 6–18%."@id .

ns1:EMBUNTEPUNGKacangHijau a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "EMBUN TEPUNG"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianBahanFungisidaNabatiSepertiEkstrak_07aff872,
        ns1:PengendalianCendawanAmpelomycesQuisqualisMerupakanAntagonis_bdb8ce93,
        ns1:PengendalianMenanamVarietasTahanMerupakanCara_b45c86a5 ;
    ns1:deskripsiPenyakit "Salah satu penyakit utama pada kacang hijau adalah embun tepung. Meskipun telah lama diketahui namun jarang dikendalikan karena keterbatasan pengetahuan petani terhadap penyakit tersebut. Penyakit embun tepung tersebar luas di seluruh negara sentra produksi kacang hijau, meliputi India, Pakistan, Thailand, China, Myanmar, dan Indonesia (Khodaparast dan Abbasi 2009, Nair et al. 2014). Penurunan hasil kacang hijau akibat penyakit embun tepung di Thailand mencapai 26,2% (Tantanapornkul et al. 2005). Petani jarang mengendalikan penyakit embun tepung, dan jika dikendalikan masih menggunakan fungisida yang tidak ramah lingkungan."@id ;
    ns1:dikendalikanDengan ns1:PengendalianBahanFungisidaNabatiSepertiEkstrak_07aff872,
        ns1:PengendalianCendawanAmpelomycesQuisqualisMerupakanAntagonis_bdb8ce93,
        ns1:PengendalianMenanamVarietasTahanMerupakanCara_b45c86a5 ;
    ns1:disebabkanOleh ns1:ErysiphePolygoni ;
    ns1:memilikiGejala ns1:GejalaGejalaPenyakitEmbunTepungAdalah_b6972aa3,
        ns1:GejalaGejalaTersebutHampirSamaDengan_407f348f ;
    ns1:memilikiReferensi ns1:BukuDOC005 ;
    ns1:menyerangTanaman ns1:KacangHijau ;
    ns1:tingkatKeparahan "Penurunan hasil kacang hijau akibat penyakit embun tepung di Thailand mencapai 26,2% (Tantanapornkul et al. 2005)."@id .

ns1:PenyakitBusukPelepahJagung a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Busuk Pelepah"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianHalIniDapatTerjadiKarena_59735700 ;
    ns1:deskripsiPenyakit "Penyakit busuk pelepah disebabkan oleh jamur patogen Rhizoctonia solani. Patogen ini termasuk soil borne yang artinya merupakan patogen tular tanah sehingga dapat bertahan di tanah dan juga sisa tanaman dalam bentuk sklerotium. Sklerotium merupakan massa hifa yang mengumpul dan memadat yang awalnya berwarna putih dan kemudian berubah menjadi berwarna coklat. Jamur ini mempunyai banyak inang alternatif seperti tanaman kacang tanah, kedelai, kacang hijau dan sorgum (Soenartiningsih et al., 2015)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianHalIniDapatTerjadiKarena_59735700 ;
    ns1:dipengaruhiOleh ns1:KondisiSuhu ;
    ns1:disebabkanOleh ns1:RhizoctoniaSolani ;
    ns1:memilikiGejala ns1:GejalaGambar67GejalaBusukPelepah_b6852739,
        ns1:GejalaGejalaBusukPelepahDitandaiAdanya_35e1280b,
        ns1:GejalaInfeksiLebihLanjutBercakDapat_15b24113,
        ns1:GejalaPenyakitBusukPelepahDisebabkanOleh_18cd86ad ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangTanaman ns1:Jagung .

ns1:PenyakitKerdilKedelaiSoybeanStuntVirusKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Kerdil Kedelai (Soybean Stunt Virus)"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianPengendalianDapatDilakukanDenganBenih_5483ea6d ;
    ns1:deskripsiPenyakit "Penyakit kerdil kedelai disebabkan oleh partikel virus Soybean Stunt Virus atau SSV yang menginfeksi tanaman kedelai. Tanaman yang terinfeksi akan menunjukkan gejala terhambatnya pertumbuhan tanaman kedelai. Tanaman"@id ;
    ns1:dikendalikanDengan ns1:PengendalianPengendalianDapatDilakukanDenganBenih_5483ea6d ;
    ns1:disebabkanOleh ns1:SoybeanStuntVirus ;
    ns1:memilikiGejala ns1:GejalaPadaDaunYangTerinfeksiUkurannya_fd28fa44,
        ns1:GejalaPenyakitKerdilKedelaiDisebabkanOleh_72be029c,
        ns1:GejalaTanamanYangTerinfeksiAkanMenunjukkan_186c4417,
        ns1:GejalaYangMenusukkanAlatMulutStylet_75b5db3e ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangTanaman ns1:Kedelai .

ns1:ANTRAKNOSAKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "ANTRAKNOSA"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianAgensiaHayatiTrichodermaHarzianumTrichoderma_330c5271,
        ns1:PengendalianCTruncatumDapatBertahanPada_58cbf4dc,
        ns1:PengendalianPenggunaanBenihSehatAkanMenjamin_d5eab104,
        ns1:PengendalianSalahSatuCaraMemutusRantai_f689b396 ;
    ns1:deskripsiPenyakit "Gejala penyakit antraknosa pada kedelai dapat ditemukan pada bagian batang, tangkai daun, daun, dan polong. Gejala awal terjadi pada bagian pangkal batang yakni adanya hifa berwarna putih, pada perkembangan lebih lanjut terbentuk struktur khusus acervuli pada batang yang dekat dengan permukaan tanah (Gambar 6a). Gejala ini akan berkembang pada bagian batang dan tangkai daun. Pada kondisi lembap, daun akan menggulung dan mudah gugur, sedangkan pada polong akan terlihat acervuli yang membentuk pola cincin konsentris (Gambar 6b). Infeksi pada fase vegetatif akan mengakibatkan pertumbuhan tanaman menjadi terhambat, tanaman tumbuh lebih pendek dan menyebabkan polong hampa (CABI 2015). Benih terinfeksi berakibat kehilangan hasil lebih tinggi, dibandingkan infeksi pada batang. Jika infeksi terjadi sejak awal pertumbuhan, maka tanaman akan menghasilkan benih yang berukuran kecil atau polong tidak berisi (Jeschke 2015)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianAgensiaHayatiTrichodermaHarzianumTrichoderma_330c5271,
        ns1:PengendalianCTruncatumDapatBertahanPada_58cbf4dc,
        ns1:PengendalianPenggunaanBenihSehatAkanMenjamin_d5eab104,
        ns1:PengendalianSalahSatuCaraMemutusRantai_f689b396 ;
    ns1:dipengaruhiOleh ns1:KondisiSuhu ;
    ns1:disebabkanOleh ns1:ColletotrichumTruncatum ;
    ns1:memilikiGejala ns1:GejalaGejalaPenyakitAntraknosaPadaKedelai_9344da2f,
        ns1:GejalaPadaKondisiLembapDaunAkan_03ac457f ;
    ns1:memilikiReferensi ns1:BukuDOC005 ;
    ns1:menyerangBagian ns1:Batang,
        ns1:Daun ;
    ns1:menyerangTanaman ns1:Kedelai .

ns1:BERCAKDAUNKacangHijau a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "BERCAK DAUN"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianMenjagaAgarLingkunganMikroDi_7307f322,
        ns1:PengendalianPenyemprotanEkstrakLengkuasPadaUmur_8afdf37f,
        ns1:PengendalianPesticidaNabatiSalahSatunyaAdalah_f435f87d ;
    ns1:deskripsiPenyakit "Bercak daun merupakan salah satu penyakit utama kacang hijau. Tidak hanya di Indonesia, tetapi juga di Asia seperti Filipina, Malaysia, Thailand, India, Bangladesh, dan Pakistan. Di Indonesia penyakit ini diketahui di seluruh sentra produksi kacang hijau. Infeksi C. canescens pada kacang hijau menyebabkan kehilangan hasil 46-61% di lahan (Iqbal et al. 1995; Kapadi dan Dhuruj 1999, Sompong et al. 2011)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianMenjagaAgarLingkunganMikroDi_7307f322,
        ns1:PengendalianPenyemprotanEkstrakLengkuasPadaUmur_8afdf37f,
        ns1:PengendalianPesticidaNabatiSalahSatunyaAdalah_f435f87d ;
    ns1:disebabkanOleh ns1:CercosporaCanescens,
        ns1:CercosporaCruenta ;
    ns1:memilikiGejala ns1:GejalaBercakPadaDaunTerinfeksiUmumnya_0652b3a3,
        ns1:GejalaPadaVarietasRentanMenyebabkanGejala_56d1e6fb ;
    ns1:memilikiReferensi ns1:BukuDOC005 ;
    ns1:menyerangBagian ns1:Biji,
        ns1:Daun ;
    ns1:menyerangTanaman ns1:KacangHijau ;
    ns1:tingkatKeparahan "Infeksi C. canescens pada kacang hijau menyebabkan kehilangan hasil 46-61% di lahan (Iqbal et al. 1995; Kapadi dan Dhuruj 1999, Sompong et al. 2011)."@id .

ns1:Jagung a ns1:TanamanPangan,
        owl:NamedIndividual ;
    rdfs:label "Jagung"@id ;
    ns1:deskripsiTanaman "Jagung merupakan salah satu komoditas pangan yang mempunyai nilai ekonomi penting di Indonesia dan menempati urutan kedua setelah padi. Sebagai salah satu alternatif tanaman pangan pengganti beras (upaya diversifikasi pangan), jagung mempunyai kandungan gizi yang hampir sama dengan beras, yaitu berupa karbohidrat, protein, lemak, serat dan gula. Pemanfaatan jagung di Indonesia umumnya untuk konsumsi langsung, benih, bahan baku industri pakan ternak, industri pangan dan non pangan, pakan ternak dan sebagai bahan bakar."@id ;
    ns1:diserangPenyakit ns1:PenyakitBulaiJagung,
        ns1:PenyakitBusukPelepahJagung,
        ns1:PenyakitHawarDaunJagung,
        ns1:PenyakitKaratDaunJagung,
        ns1:PenyakitLayuStewartJagung ;
    ns1:memilikiVarietas ns1:VarietasAsianHoney,
        ns1:VarietasPioneer21,
        ns1:VarietasPioneer27 .

ns1:KARATKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "KARAT"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianMenanamVarietasKedelaiYangTahan_cb395a19,
        ns1:PengendalianPengendalianDenganAgensHayatiAdalah_0876a343,
        ns1:PengendalianPengendalianPenyakitSaatIniLebih_9527afc4 ;
    ns1:deskripsiPenyakit "Penyakit karat pada kedelai merupakan penyakit penting yang sering ditemukan di lapang. Penyakit ini telah tersebar luas di sentra produksi kedelai di dunia, seperti Australia, Afrika, Amerika Tengah, dan Selatan (tropis), Asia Timur, Asia Tenggara, termasuk di Indonesia (Semangun 2008). Di Indonesia, penyakit ini akan mudah ditemukan pada musim kemarau. Sebaran penyakit ini pertama kali dilaporkan di Jawa Tengah (Yogyakarta dan Surakarta) (Raciborski 1900). Di Indonesia, infeksi cendawan ini pada kedelai dan mengakibatkan kehilangan hasil mencapai 90% (Sudjono et al. 1985), di Thailand 10–40% pada varietas lokal, di Taiwan 23–50% (Sinclair dan Shurtleff 1980), di Brasil 75% (Yorinori et al. 2005) dan di Argentina 28% (Formento 2008)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianMenanamVarietasKedelaiYangTahan_cb395a19,
        ns1:PengendalianPengendalianDenganAgensHayatiAdalah_0876a343,
        ns1:PengendalianPengendalianPenyakitSaatIniLebih_9527afc4 ;
    ns1:dipengaruhiOleh ns1:KondisiMusimKemarau,
        ns1:KondisiSuhu ;
    ns1:disebabkanOleh ns1:PhakopsoraMeibomiae,
        ns1:PhakopsoraPachyrhizi ;
    ns1:memilikiGejala ns1:GejalaGejalaInfeksiCendawanUmumnyaNampak_ba5d558e,
        ns1:GejalaPenyakitKaratMenyebabkanDaunKedelai_d2adf295 ;
    ns1:memilikiReferensi ns1:BukuDOC005 ;
    ns1:menyerangBagian ns1:Daun ;
    ns1:menyerangTanaman ns1:Kedelai ;
    ns1:tingkatKeparahan "Di Indonesia, infeksi cendawan ini pada kedelai dan mengakibatkan kehilangan hasil mencapai 90% (Sudjono et al. 1985), di Thailand 10–40% pada varietas lokal, di Taiwan 23–50% (Sinclair dan Shurtleff 1980), di Brasil 75% (Yorinori et al. 2005) dan di Argentina 28% (Formento 2008)."@id .

ns1:PenyakitMosaikKedelaiSoybeanMosaicVirusKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Mosaik Kedelai (Soybean Mosaic Virus)"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianApabilaAdaTanamanYangTerinfeksi_dfe1da62 ;
    ns1:deskripsiPenyakit "Penyakit mosaik kedelai (soybean mosaic virus) atau SMV disebabkan oleh infeksi patogen dari golongan virus. Dapat menyerang tanaman kedelai sejak dari benih disemai. Patogen SMV dapat terbawa oleh benih yang ditanam (seed borne disease). Oleh karena itu benih yang terinfeksi dan membawa patogen SMV merupakan sumber utama terjadinya penyakit. Penyakit akan berkembang pada lahan pertanaman kedelai yang ditularkan oleh serangga famili Aphididae seperti Aphis glycine, A. craccivora, A. fabae, A. gossypii, A. nasturtii dan A. nerii non persisten (Inayati and Yusnawan, 2017)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianApabilaAdaTanamanYangTerinfeksi_dfe1da62 ;
    ns1:disebabkanOleh ns1:SoybeanMosaicVirus ;
    ns1:memilikiGejala ns1:GejalaHalIniDipengaruhiOlehBeberapa_6ce2df7f,
        ns1:GejalaPadaBenihYangTerinfeksiSMV_76d74cc2,
        ns1:GejalaPenyakitMosaikKedelaiSoybeanMosaic_637a1f30,
        ns1:GejalaSecaraUmumInfeksiPatogenSMV_f53fce91,
        ns1:GejalaTanamanDapatMenunjukkanGejalaYang_183e6268 ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangTanaman ns1:Kedelai .

