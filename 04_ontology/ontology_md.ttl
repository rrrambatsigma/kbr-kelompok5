                                                                                          ns1:GejalaDaun ;
                                                                                 ns1:didukungOleh ns1:BuktiGejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiDitunjukkanCMMVTerdapatBelangSistemik ,
