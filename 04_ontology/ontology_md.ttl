ns1:GejalaPenyakitKudisUbiJalar a ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Gejala pada Penyakit kudis (Ubi jalar): Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat..."@id ;
    ns1:deskripsiGejala "Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997)."@id ;
    ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalar3 ;
    ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
