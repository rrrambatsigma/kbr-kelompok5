ns1:PengamatanPenyakitBercakDaunKacangTanahBercakDaun a ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun pada Penyakit Bercak Daun"@id ;
    ns1:deskripsiGejala "Inang kedua patogen ini hanya kacang tanah, Cercospora personata bercak relatif lambat muncul, berukuran lebih kecil, berwarna coklat gelap sampai hitam, sporulasi cendawan lebih banyak di permukaan bawah daun."@id ;
