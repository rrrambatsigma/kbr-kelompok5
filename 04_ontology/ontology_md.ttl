                                                                 skos:prefLabel "Pengamatan gejala layu fusarium"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanLayuFusariumUbiJalarNekrosisTanaman
ns1:PengamatanLayuFusariumUbiJalarNekrosisTanaman rdf:type owl:NamedIndividual ,
                                                           ns1:GejalaBatang ;
                                                  ns1:didukungOleh ns1:BuktiGejalaLayuFusariumUbiJalarSelainTerjadiNekrosisBagianVaskular ;
                                                  ns1:memilikiGejalaKanonik ns1:NekrosisTanaman ;
                                                  ns1:merupakanGejalaDari ns1:LayuFusariumUbiJalar ;
                                                  ns1:terdapatPada ns1:Batang ;
                                                  ns1:deskripsiGejala "Selain itu, terjadi nekrosis pada bagian vaskular batang dengan perubahan warna coklat menjadi ungu yang disertai pecahnya korteks batang dan miselium tumbuh pada permukaan batang yang terinfeksi (Gambar 1G dan F)."@id ;
                                                  rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ,
                                                               "Selain itu, terjadi nekrosis pada bagian vaskular batang dengan perubahan warna coklat menjadi ungu yang disertai pecahnya korteks batang dan miselium tumbuh pada permukaan batang yang terinfeksi (Gambar 1G dan F)."@id ;
                                                  rdfs:label "Nekrosis pada tanaman pada layu fusarium"@id ;
                                                  skos:prefLabel "Nekrosis pada tanaman pada layu fusarium"@id .


