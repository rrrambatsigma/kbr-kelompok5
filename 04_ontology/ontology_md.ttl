ns1:PengendalianKulturTeknis a owl:Class ;
    rdfs:label "Pengendalian Kultur Teknis"@id ;
    rdfs:comment "Menurut Inayati and Yusnawan, (2017) pengendalian penyakit yang disebabkan oleh R. solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian"@id,
        "Pengendalian melalui praktik budidaya."@id ;
    rdfs:subClassOf ns1:Pengendalian ;
    skos:prefLabel "Pengendalian Kultur Teknis"@id .

