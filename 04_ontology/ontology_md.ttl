ns1:HawarBakteriUbiKayu a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Hawar bakteri"@id ;
    ns1:deskripsiPenyakit "Muncul eksudat bergetah berwarna krem atau coklat kekuningan pada bagian batang yang terinfeksi, dan batang akan mati, meskipun adakalanya pada batang yang terinfeksi dan mati juga dapat memunculkan tunas baru"@id ;
