ns1:LayuFusariumUbiJalar a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "layu fusarium"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianOxysporumScattoliniHernandezAndGonzales_e6eada76,
        ns1:PengendalianPengendalianYangDapatDilakukanDi_e4bfb039,
        ns1:PengendalianRuangPenyimpananDiaturPadaSuhu_18abed67,
        ns1:PengendalianSaatPanenProdusenSeringMemanen_db28f7e4,
        ns1:PengendalianSelainItuMemilihTanamanDengan_ee331deb ;
    ns1:deskripsiPenyakit "Banyak dilaporkan bahwa Fusarium spp. menginfeksi ubi jalar di antaranya F. solani, F. proliferatum (Scruggs and Quesada-Ocampo, 2016), F. oxysporum (Scattolini, Hernandez and Gonzales, 2020), F. circinatum (Mousa et al., 2018), F. graminearum (Gaffoor et al., 2005). Genus Fusarium terkenal karena kemampuannya menghasilkan metabolit sekunder, beberapa di antaranya bersifat toksik pada manusia dan hewan (Desjardins, 2006). Berikut ini akan diuraikan F. oxysporum yang merupakan patogen penting pada ubi jalar."@id ;
    ns1:dikendalikanDengan ns1:PengendalianOxysporumScattoliniHernandezAndGonzales_e6eada76,
        ns1:PengendalianPengendalianYangDapatDilakukanDi_e4bfb039,
