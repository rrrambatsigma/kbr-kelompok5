kbr:Padi a kbr:Serealia,
        kbr:TanamanPangan,
        owl:NamedIndividual ;
    rdfs:label "Padi"@id ;
    kbr:deskripsiTanaman "Padi merupakan tanaman pangan yang paling banyak dibudidayakan, sebab menjadi sumber pangan pokok bagi masyarakat Indonesia. Tidak hanya di Indonesia, di sebagian besar negara Asia pun padi menjadi tanaman pangan utama. Adapun 4 negara yang mengonsumsi beras paling besar yaitu Cina, India, Indonesia, dan Bangladesh dengan jumlah konsumsi berturut-turut sebesar 200 juta ton, 170 juta ton, 50 juta ton, dan 20 juta ton (FAO 2016). Berdasarkan jumlah konsumsi beras yang begitu besar, maka perlu upaya untuk peningkatan produksi beras untuk mencukup kebutuhan tersebut. Upaya peningkatan produksi dapat dilakukan dengan berbagai cara, termasuk dengan proteksi tanaman terhadap gangguan organisme pengganggu tanaman (OPT). OPT merupakan faktor biotik yang dapat mengakibatkan kehilangan hasil dari padi, sehingga produksi tanaman dapat menurun bahkan menimbulkan kerugian ekonomi."@id ;
    kbr:diserangPenyakit kbr:PenyakitBlasPadi,
        kbr:PenyakitHawarDaunBakteriPadi,
        kbr:PenyakitHawarPelepahDaunPadi,
        kbr:PenyakitKerdilRumputDanKerdilHampaPadi,
        kbr:PenyakitTungroPadi ;
    kbr:identifierSumber "PLANT_001" ;
    kbr:memilikiFasePertumbuhan kbr:FasePematanganPadi,
        kbr:FaseReproduktifPadi,
        kbr:FaseVegetatifPadi ;
    kbr:memilikiKondisiTumbuh kbr:KondisiCurahHujanTinggi ;
    kbr:memilikiVarietas kbr:VarietasBondoyudo,
        kbr:VarietasKalimas,
        kbr:VarietasTukadBalian,
        kbr:VarietasTukadUnda ;
    kbr:namaIlmiah "Oryza sativa L." ;
    dcterms:source "Kurasi pakar"@id ;
    rdfs:comment "Nama ilmiah dilengkapi dari Plants of the World Online (Kew) karena tidak tercantum pada sumber utama."@id,
        "Tanaman pangan dalam ruang lingkup knowledge base."@id ;
    rdfs:seeAlso <https://powo.science.kew.org/results?q=Oryza%20sativa> ;
    skos:altLabel "Oryza sativa"@id,
        "padi"@id ;
    skos:definition "Tanaman pangan serealia penghasil beras yang dibudidayakan di lahan sawah atau lahan kering."@id ;
