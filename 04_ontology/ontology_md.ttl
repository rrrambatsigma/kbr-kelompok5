ns1:PengamatanPenyakitHawarDaunJagungBercakDaun a ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun pada Penyakit Hawar Daun"@id ;
    ns1:deskripsiGejala "Selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan, infeksi lebih lanjut bercak akan melebar dan bergabung dengan bercak lain dan menyebabkan jaringan daun mengalami nekrosis."@id ;
