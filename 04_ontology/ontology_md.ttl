ns1:PengamatanPenyakitKudisUbiJalarSelainFaktorLingkunganMemengaruhiPerubahan a ns1:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala Penyakit kudis"@id ;
    ns1:deskripsiGejala "Selain itu, faktor lingkungan juga memengaruhi perubahan ketahanan ubi jalar terhadap penyakit kudis (Roosda et al., 20013), sehingga kultivar yang tahan dapat berubah menjadi tidak tahan dan periode inkubasi juga memengaruhi munculnya gejala penyakit (Samiyarsih, Juwarno and Muljowati, 2018)."@id ;
    ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalarSelainFaktorLingkunganMemengaruhiPerubahan ;
    ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
    rdfs:comment "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id,
        "Selain itu, faktor lingkungan juga memengaruhi perubahan ketahanan ubi jalar terhadap penyakit kudis (Roosda et al., 20013), sehingga kultivar yang tahan dapat berubah menjadi tidak tahan dan periode inkubasi juga memengaruhi munculnya gejala penyakit (Samiyarsih, Juwarno and Muljowati, 2018)."@id ;
    skos:prefLabel "Pengamatan gejala Penyakit kudis"@id .

