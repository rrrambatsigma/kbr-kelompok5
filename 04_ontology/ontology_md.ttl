kbr:Penyakit a owl:Class ;
    rdfs:label "Penyakit"@id ;
    dcterms:source "Dokumentasi TBox"@id ;
    rdfs:comment "Penyakit tanaman pangan yang dicatat dalam sumber."@id ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty kbr:memilikiGejala ;
            owl:someValuesFrom kbr:Gejala ],
        [ a owl:Restriction ;
            owl:onProperty kbr:menyerangTanaman ;
            owl:someValuesFrom kbr:TanamanPangan ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass kbr:Referensi ;
            owl:onProperty kbr:memilikiReferensi ],
        [ a owl:Restriction ;
            owl:allValuesFrom kbr:Patogen ;
            owl:onProperty kbr:disebabkanOleh ],
        <https://gwsp.cs.ksu.edu/disease-management/disease/Disease> ;
    owl:disjointWith kbr:BagianTanaman,
        kbr:BuktiSumber,
        kbr:Diagnosis,
        kbr:FaktorRisiko,
        kbr:FasePertumbuhan,
        kbr:Gejala,
        kbr:GejalaKanonik,
        kbr:Observasi,
        kbr:Patogen,
        kbr:Pengendalian,
        kbr:Referensi,
        kbr:TanamanPangan,
        kbr:Varietas ;
    skos:definition "Penyakit tanaman pangan yang tercatat pada sumber."@id ;
    skos:prefLabel "Penyakit"@id .

