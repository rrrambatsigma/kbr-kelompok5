        ns1:BuktiPengendalianPenyakitKaratDaunKacangTanahTakar1Takar2,
        ns1:BuktiPenyakitPenyakitKaratDaunKacangTanahTanpaTeks ;
    ns1:dikendalikanDengan ns1:PengelolaanGulma,
        ns1:PenggunaanVarietasTahan,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    ns1:disebabkanOleh ns1:PucciniaArachidis ;
    ns1:identifierSumber "DIS_121" ;
    ns1:memilikiGejala ns1:PengamatanPenyakitKaratDaunKacangTanahBercakDaun,
        ns1:PengamatanPenyakitKaratDaunKacangTanahKlorosisDaun,
        ns1:PengamatanPenyakitKaratDaunKacangTanahTumbuhPustulMerupakanKumpulanSpora ;
    ns1:memilikiReferensi ns1:BukuDOC005 ;
    ns1:menyerangTanaman ns1:KacangTanah ;
    ns1:tingkatKeparahan "Kehilangan hasil mencapai 57% (Semangun 1991)."@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Di Indonesia, penyakit karat pada kacang tanah merupakan penyakit penting ke dua setelah bercak daun. Penyakit ini tersebar luas di daerah sentra penghasil kacang tanah seperti Jawa Timur, Bali, dan Nusa Tenggara Barat. Kehilangan hasil mencapai 57% (Semangun 1991). Kehilangan hasil yang diakibatkan penyakit karat dapat mencapai 6–57% (Subramanyam dan Mc Donald 1984)."@id ;
    skos:altLabel "KARAT"@id ;
    skos:prefLabel "Penyakit Karat Daun"@id .

ns1:PenyakitLayuStewartJagung a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Layu Stewart"@id ;
    ns1:berkaitanPengendalian ns1:PengelolaanGulma,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanInsektisida,
        ns1:PerlakuanBenih,
        ns1:SanitasiLahan ;
    ns1:deskripsiPenyakit "Penyakit layu stewart disebabkan oleh bakteri Pantoea stewartii subsp. stewartii. Penyakit ini termasuk patogen tular benih. Pertama kali dilaporkan ada di Bogor, Indonesia oleh (Rahma et al., 2014) dengan kejadian penyakit antara 23.67% hingga 31.45%. Bakteri patogen P. stewartii termasuk bakteri gram negatif dan mempunyai koloni berwarna kuning, mengilat, cembung, berukuran 1-4 mm jika ditumbuhkan pada media TSA (Trypticase Soy Agar). Gejala layu stewart hampir mirip dengan penyakit bulai. Daun bergejala layu stewart berwarna hijau pucat hingga kekuningan dengan garis linier dengan tepi lurus maupun bergelombang yang sejajar tulang daun, layu dan kerdil (Rahma et al., 2014)."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitLayuStewartJagungStewartDisebabkanPantoeaStewartiiSubsp,
        ns1:BuktiPengendalianPenyakitLayuStewartJagungAlternatifTerakhirPerlakuanKimiaPestisida,
        ns1:BuktiPengendalianPenyakitLayuStewartJagungAplikasiDilakukanPerendamanBenihSelama,
        ns1:BuktiPengendalianPenyakitLayuStewartJagungDjaenuddinMuis2018MengatakanPengendalian,
        ns1:BuktiPengendalianPenyakitLayuStewartJagungHasilnyaMenunjukkanBahwaPerkembanganTerhambat,
        ns1:BuktiPengendalianPenyakitLayuStewartJagungPengendalianStewartDilakukanMemberikanPerlakuan,
        ns1:BuktiPengendalianPenyakitLayuStewartJagungRahmaEtAl2016Mengisolasi,
        ns1:BuktiPengendalianPenyakitLayuStewartJagungRizobakteriaMeningkatkanPertumbuhanTerdapatBerperan,
        ns1:BuktiPengendalianPenyakitLayuStewartJagungSelainBenihBersertifikatBebasMemanfaatkan,
        ns1:BuktiPengendalianPenyakitLayuStewartJagungSelainRizobakteriaRambeEtAl,
        ns1:BuktiPengendalianPenyakitLayuStewartJagungTidakMenunjukkanReaksiHipersensitifDikelompokkan,
        ns1:BuktiPenyakitPenyakitLayuStewartJagungStewart ;
    ns1:dikendalikanDengan ns1:PengelolaanGulma,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanInsektisida,
        ns1:PerlakuanBenih,
        ns1:SanitasiLahan ;
    ns1:disebabkanOleh ns1:PantoeaStewartii ;
    ns1:identifierSumber "DIS_047" ;
    ns1:memilikiGejala ns1:PengamatanPenyakitLayuStewartJagungKerdilTanaman,
        ns1:PengamatanPenyakitLayuStewartJagungKlorosisDaun,
        ns1:PengamatanPenyakitLayuStewartJagungLayuDaun ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangTanaman ns1:Jagung ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit layu stewart disebabkan oleh bakteri Pantoea stewartii subsp. stewartii. Penyakit ini termasuk patogen tular benih. Pertama kali dilaporkan ada di Bogor, Indonesia oleh (Rahma et al., 2014) dengan kejadian penyakit antara 23.67% hingga 31.45%. Bakteri patogen P. stewartii termasuk bakteri gram negatif dan mempunyai koloni berwarna kuning, mengilat, cembung, berukuran 1-4 mm jika ditumbuhkan pada media TSA (Trypticase Soy Agar). Gejala layu stewart hampir mirip dengan penyakit bulai. Daun bergejala layu stewart berwarna hijau pucat hingga kekuningan dengan garis linier dengan tepi lurus maupun bergelombang yang sejajar tulang daun, layu dan kerdil (Rahma et al., 2014)."@id ;
    skos:prefLabel "Penyakit Layu Stewart"@id .

ns1:KacangTanah a ns1:Legum,
        ns1:TanamanPangan,
        owl:NamedIndividual ;
    rdfs:label "Kacang tanah"@id ;
    ns1:berkaitanPengendalian ns1:PenerapanPengendalianMekanis,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanBakterisida,
        ns1:PenggunaanBiopestisida,
        ns1:PenggunaanEkstrakTanaman,
        ns1:PenggunaanFungisida,
        ns1:PenggunaanHerbisida,
        ns1:PenggunaanInsektisida,
        ns1:PenggunaanPestisidaNabati,
        ns1:PenggunaanTrichoderma ;
    ns1:deskripsiTanaman "Kacang-kacangan merupakan komoditas sumber protein nabati yang berguna dalam pemenuhan makanan bergizi tinggi yang dibutuhkan untuk meningkatkan kualitas sumber daya manusia. Kebutuhan produksi kacang- kacangan, seperti kacang kedelai, kacang hijau dan kacang tanah meningkat setiap tahunnya seiring dengan pertumbuhan jumlah penduduk dan berkembangnya industri pangan. Tanaman kacang tanah tergolong tanaman yang mudah dibudidayakan. Namun demikian bukan berarti tidak ada kendala dalam budidaya tanaman kacang tanah. Tanaman kacang tanah memiliki beberapa jenis penyakit yang dapat menimbulkan kerusakan. Penyakit tanaman disebabkan oleh serangan patogen tanaman. Patogen dapat menginfeksi tanaman sehingga tanaman menjadi sakit atau rusak. Kerusakan inilah yang dapat menyebabkan penurunan hasil."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianUmumKacangTanahAeroginosaBulkholderiaCepaciaBacillusSubtilis,
