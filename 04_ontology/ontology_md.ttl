        ns1:GejalaBercakMunculPadaPermukaanDaun_232521a2,
        ns1:GejalaDaunMenjadiKakuSepertiGejala_7923f958,
        ns1:GejalaGejalaYangMunculPadaTanaman_031d3582,
        ns1:GejalaKemudianBercakAkanBerkembangMenjadi_5244770f,
        ns1:GejalaManshuricaPadaAwalnyaTerdapatAdanya_b18bc75b,
        ns1:GejalaPadaTingkatSeranganYangTinggi_26cdb050,
        ns1:GejalaPenyakitDownyMildewJugaPada_e506d013 ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangTanaman ns1:Kedelai .

ns1:PenyakitHawarPelepahDaunPadi a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Hawar Pelepah Daun"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianBeberapaPengendalianPenyakitHawarDaun_8bce23da,
        ns1:PengendalianFajarfika2021DanPGPRDari_fae4b100,
        ns1:PengendalianPengendalianHayatiDenganAgensBiokontrol_52af804f,
        ns1:PengendalianPerlakuanKimiaBerupaFungisidaDapat_4a38645b ;
    ns1:deskripsiPenyakit "Penyakit hawar pelepah daun (HDP) dapat ditemukan pada tiap musim tanam padi. Meskipun tidak sebesar akibat infeksi penyakit HDB dan blas, kehilangan hasil akibat penyakit HDP berkisar antara 20-35% di beberapa negara penghasil beras dunia (Inagaki 2001). Sementara itu, di Indonesia kehilangan hasil yang dilaporkan mencapai 20% (Suparyono dan Sudir 1999)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianBeberapaPengendalianPenyakitHawarDaun_8bce23da,
        ns1:PengendalianFajarfika2021DanPGPRDari_fae4b100,
        ns1:PengendalianPengendalianHayatiDenganAgensBiokontrol_52af804f,
        ns1:PengendalianPerlakuanKimiaBerupaFungisidaDapat_4a38645b ;
    ns1:disebabkanOleh ns1:RhizoctoniaSolani ;
    ns1:memilikiGejala ns1:GejalaAdapunBentukBercakSendiriDapat_626f021f,
        ns1:GejalaBercakAkanBerubahMenjadiPutih_79c9368d,
        ns1:GejalaGejalaPenyakitHDPDapatDilihat_258f91b0,
        ns1:GejalaGejalaTersebutDapatDitemukanPada_c27bfec8,
        ns1:GejalaPadaBagianTersebutAkanTerdapat_2aab4b44,
        ns1:GejalaPadaSaatKondisiLembabBercak_1b3af449 ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Daun ;
    ns1:menyerangFase ns1:FaseAnakan,
        ns1:FaseMatangSusu ;
    ns1:menyerangTanaman ns1:Padi ;
    ns1:tingkatKeparahan "Meskipun tidak sebesar akibat infeksi penyakit HDB dan blas, kehilangan hasil akibat penyakit HDP berkisar antara 20-35% di beberapa negara penghasil beras dunia (Inagaki 2001)."@id .

ns1:PenyakitLayuFusariumKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Layu Fusarium"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianAplikasiPupukHayatiDenganKandungan_b895c77c,
        ns1:PengendalianDapatDilakukanDenganBeberapaTeknik_3f233d91,
        ns1:PengendalianHarzianumAzotobacterPupukOrganikCair_59357b87,
        ns1:PengendalianOxysporumMengurangiIntensitasPatogenKaya_4c058e3a ;
    ns1:deskripsiPenyakit "Penyakit layu Fusarium dikenal dengan penyakit busuk akar yang menginfeksi tanaman kedelai dan menyebabkan kematian (Bawa et al., 2018). Penyakit disebabkan oleh patogen Fusarium spp. Beberapa spesies dari patogen yang menginfeksi tanaman kedelai seperti F. solani (Bawa et al., 2018), F. virgulivorme (Baetsen-Young et al., 2020), F. sporotrichioides, F. graminearum, F. proliferatum (Okello et al., 2020). F. proliferatum juga menjadi masalah penting pada kedelai di Kanada (Chang et al., 2015)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianAplikasiPupukHayatiDenganKandungan_b895c77c,
        ns1:PengendalianDapatDilakukanDenganBeberapaTeknik_3f233d91,
        ns1:PengendalianHarzianumAzotobacterPupukOrganikCair_59357b87,
        ns1:PengendalianOxysporumMengurangiIntensitasPatogenKaya_4c058e3a ;
    ns1:dipengaruhiOleh ns1:KondisiCurahHujan ;
    ns1:disebabkanOleh ns1:FusariumSpp ;
    ns1:memilikiGejala ns1:GejalaAkibatDariInfeksiIniMaka_b83a2e23,
        ns1:GejalaAkibatInfeksiPadaAkarMenyebabkan_5af2b70e,
        ns1:GejalaGejalaPenyakitYangDisebabkanOleh_741bcbf3,
        ns1:GejalaMenginfeksiTanamanSejakTanamanBerada_4bed2d02,
        ns1:GejalaPenyakitLayuFusariumDikenalDengan_6b4eead5,
        ns1:GejalaYaituAdanyaNekrosisPadaBagian_4a1baa6d ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangTanaman ns1:Kedelai .

ns1:BERCAKDAUNKacangTanah a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "BERCAK DAUN"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianBeberapaVarietasKacangTanahDi_f4ca6d8e,
        ns1:PengendalianSifatCendawanYangDapatBertahan_92c45935 ;
    ns1:deskripsiPenyakit "Penyakit bercak daun sebagai penyakit utama kacang tanah tersebar di seluruh negara-negara produksi kacang tanah di dunia, termasuk Indonesia. Penyakit ini umumnya terjadi pada fase generatif, dan serangan terparah pada fase pengisian polong. Petani sering beranggapan bercak daun bukan penyakit yang perlu dikendalikan, dan dianggap tanda tanaman kacang tanah sudah waktunya dipanen. Di Indonesia bercak daun telah tersebar luas di Pulau Jawa, Sumatera, Kalimantan, Sulawesi, Bali, dan Lombok. Kehilangan hasil kacang tanah akibat infeksi bercak daun berkisar 15-80% (Siddaramaiah et al. 1977). Di Indonesia, kehilangan hasil pada varietas lokal mencapai 50% (Semangun 1991), sedangkan varietas unggul berkisar antara 12–22% seperti pada Tabel 1 (Purnomo et al. 2004)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianBeberapaVarietasKacangTanahDi_f4ca6d8e,
        ns1:PengendalianSifatCendawanYangDapatBertahan_92c45935 ;
    ns1:dipengaruhiOleh ns1:KondisiSuhu ;
    ns1:disebabkanOleh ns1:CercosporaArachidicola,
        ns1:CercosporaPersonata ;
    ns1:memilikiGejala ns1:GejalaGejalaBercakTerdapatPadaDaunDaun_b744e777,
        ns1:GejalaGejalaTanamanYangTerinfeksiCendawan_756d0178 ;
    ns1:memilikiReferensi ns1:BukuDOC005 ;
    ns1:menyerangBagian ns1:Daun ;
    ns1:menyerangTanaman ns1:KacangTanah ;
    ns1:tingkatKeparahan "Kehilangan hasil kacang tanah akibat infeksi bercak daun berkisar 15-80% (Siddaramaiah et al. 1977)."@id .

