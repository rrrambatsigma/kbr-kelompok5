ns1:PengamatanLayuFusariumUbiJalarFusariumUmbiBerupaKankerMelingkar rdf:type owl:NamedIndividual ,
                                                                             ns1:GejalaUmbi ;
                                                                    ns1:didukungOleh ns1:BuktiGejalaLayuFusariumUbiJalarFusariumUmbiBerupaKankerMelingkar ;
                                                                    ns1:merupakanGejalaDari ns1:LayuFusariumUbiJalar ;
                                                                    ns1:terdapatPada ns1:Umbi ;
                                                                    ns1:deskripsiGejala "Gejala serangan Fusarium pada umbi ubi jalar berupa kanker melingkar permukaan yang minimal memengaruhi jaringan di bawahnya, berwarna coklat pucat sampai kehitaman kering, rerata diameter awalnya 2-4 mm, luka dapat tumbuh dan berkembang menghasilkan area gelap yang lebih luas (Gambar 2A)."@id ;
                                                                    rdfs:comment "Gejala serangan Fusarium pada umbi ubi jalar berupa kanker melingkar permukaan yang minimal memengaruhi jaringan di bawahnya, berwarna coklat pucat sampai kehitaman kering, rerata diameter awalnya 2-4 mm, luka dapat tumbuh dan berkembang menghasilkan area gelap yang lebih luas (Gambar 2A)."@id ,
                                                                                 "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ;
                                                                    rdfs:label "Pengamatan gejala layu fusarium"@id ;
                                                                    skos:prefLabel "Pengamatan gejala layu fusarium"@id .


