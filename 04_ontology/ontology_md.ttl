 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Tujuan: kandidat kuat jika ada dua gejala kanonik berbeda yang dimiliki penyakit yang sama." ;
   rdfs:label "RuleKandidatKuat" ;
   rdf:type ns2:Imp ;
   ns2:body [ rdf:type ns2:AtomList ;
              rdf:first [ rdf:type ns2:ClassAtom ;
                          ns2:classPredicate ns1:Diagnosis ;
                          ns2:argument1 <d>
                        ] ;
              rdf:rest [ rdf:type ns2:AtomList ;
                         rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                     ns2:propertyPredicate ns1:memilikiTanaman ;
                                     ns2:argument1 <d> ;
                                     ns2:argument2 <t>
                                   ] ;
                         rdf:rest [ rdf:type ns2:AtomList ;
                                    rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                ns2:propertyPredicate ns1:menyerangTanaman ;
                                                ns2:argument1 <p> ;
                                                ns2:argument2 <t>
                                              ] ;
                                    rdf:rest [ rdf:type ns2:AtomList ;
                                               rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                           ns2:propertyPredicate ns1:memilikiObservasi ;
                                                           ns2:argument1 <d> ;
                                                           ns2:argument2 <o>
                                                         ] ;
                                               rdf:rest [ rdf:type ns2:AtomList ;
                                                          rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                      ns2:propertyPredicate ns1:memilikiGejalaKanonik ;
                                                                      ns2:argument1 <o> ;
                                                                      ns2:argument2 <g>
                                                                    ] ;
                                                          rdf:rest [ rdf:type ns2:AtomList ;
                                                                     rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                 ns2:propertyPredicate ns1:memilikiObservasi ;
                                                                                 ns2:argument1 <d> ;
                                                                                 ns2:argument2 <o2>
                                                                               ] ;
                                                                     rdf:rest [ rdf:type ns2:AtomList ;
                                                                                rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                            ns2:propertyPredicate ns1:memilikiGejalaKanonik ;
                                                                                            ns2:argument1 <o2> ;
                                                                                            ns2:argument2 <g2>
                                                                                          ] ;
                                                                                rdf:rest [ rdf:type ns2:AtomList ;
                                                                                           rdf:first [ rdf:type ns2:DatavaluedPropertyAtom ;
                                                                                                       ns2:propertyPredicate ns1:kodeGejala ;
                                                                                                       ns2:argument1 <g> ;
                                                                                                       ns2:argument2 <gn>
                                                                                                     ] ;
                                                                                           rdf:rest [ rdf:type ns2:AtomList ;
                                                                                                      rdf:first [ rdf:type ns2:DatavaluedPropertyAtom ;
                                                                                                                  ns2:propertyPredicate ns1:kodeGejala ;
                                                                                                                  ns2:argument1 <g2> ;
                                                                                                                  ns2:argument2 <gn2>
                                                                                                                ] ;
                                                                                                      rdf:rest [ rdf:type ns2:AtomList ;
                                                                                                                 rdf:first [ rdf:type ns2:BuiltinAtom ;
                                                                                                                             ns2:builtin <http://www.w3.org/2003/11/swrlb#notEqual> ;
                                                                                                                             ns2:arguments ( <gn>
                                                                                                                                             <gn2>
                                                                                                                                           )
                                                                                                                           ] ;
                                                                                                                 rdf:rest [ rdf:type ns2:AtomList ;
                                                                                                                            rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                                                                        ns2:propertyPredicate ns1:memilikiGejala ;
                                                                                                                                        ns2:argument1 <p> ;
                                                                                                                                        ns2:argument2 <gp>
                                                                                                                                      ] ;
                                                                                                                            rdf:rest [ rdf:type ns2:AtomList ;
                                                                                                                                       rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                                                                                   ns2:propertyPredicate ns1:memilikiGejalaKanonik ;
                                                                                                                                                   ns2:argument1 <gp> ;
                                                                                                                                                   ns2:argument2 <g>
                                                                                                                                                 ] ;
                                                                                                                                       rdf:rest [ rdf:type ns2:AtomList ;
                                                                                                                                                  rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                                                                                              ns2:propertyPredicate ns1:memilikiGejala ;
                                                                                                                                                              ns2:argument1 <p> ;
                                                                                                                                                              ns2:argument2 <gp2>
                                                                                                                                                            ] ;
                                                                                                                                                  rdf:rest [ rdf:type ns2:AtomList ;
                                                                                                                                                             rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                                                                                                         ns2:propertyPredicate ns1:memilikiGejalaKanonik ;
                                                                                                                                                                         ns2:argument1 <gp2> ;
                                                                                                                                                                         ns2:argument2 <g2>
                                                                                                                                                                       ] ;
                                                                                                                                                             rdf:rest rdf:nil
                                                                                                                                                           ]
                                                                                                                                                ]
                                                                                                                                     ]
                                                                                                                          ]
                                                                                                               ]
                                                                                                    ]
                                                                                         ]
                                                                              ]
                                                                   ]
                                                        ]
                                             ]
                                  ]
                       ]
            ] ;
   ns2:head [ rdf:type ns2:AtomList ;
              rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                          ns2:propertyPredicate ns1:kandidatKuat ;
                          ns2:argument1 <d> ;
                          ns2:argument2 <p>
                        ] ;
              rdf:rest rdf:nil
            ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Tujuan: merekomendasikan varietas yang tahan terhadap penyakit kandidat." ;
   rdfs:label "RuleRekomendasiVarietasTahan" ;
   rdf:type ns2:Imp ;
   ns2:body [ rdf:type ns2:AtomList ;
              rdf:first [ rdf:type ns2:ClassAtom ;
