        ns1:GejalaPenyakitLayuStewartJagungKlorosisDaun,
        ns1:GejalaPenyakitLayuStewartJagungLayuDaun,
        ns1:GejalaPenyakitLayuStewartJagungPertumbuhanAbnormal ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Batang,
        ns1:Daun ;
    ns1:menyerangFase ns1:FaseGeneratifUmum ;
    ns1:menyerangTanaman ns1:Jagung ;
    ns1:tingkatKeparahan "Pertama kali dilaporkan ada di Bogor, Indonesia oleh (Rahma et al., 2014) dengan kejadian penyakit antara 23.67% hingga 31.45%."@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit layu stewart disebabkan oleh bakteri Pantoea stewartii subsp. stewartii. Penyakit ini termasuk patogen tular benih. Pertama kali dilaporkan ada di Bogor, Indonesia oleh (Rahma et al., 2014) dengan kejadian penyakit antara 23.67% hingga 31.45%. Bakteri patogen P. stewartii termasuk bakteri gram negatif dan mempunyai koloni berwarna kuning, mengilat, cembung, berukuran 1-4 mm jika ditumbuhkan pada media TSA (Trypticase Soy Agar). Gejala layu stewart hampir mirip dengan penyakit bulai. Daun bergejala layu stewart berwarna hijau pucat hingga kekuningan dengan garis linier dengan tepi lurus maupun bergelombang yang sejajar tulang daun, layu dan kerdil (Rahma et al., 2014)."@id ;
    skos:prefLabel "Penyakit Layu Stewart"@id .

ns1:PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)"@id ;
    ns1:berkaitanPengendalian ns1:PengaturanJarakTanam,
        ns1:PengaturanWaktuTanam,
        ns1:PenggunaanInsektisida,
        ns1:PenggunaanMulsa,
        ns1:PenggunaanTanamanBukanInang,
        ns1:PenggunaanVarietasTahan,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    ns1:deskripsiPenyakit "Penyakit samar kacang tunggak disebabkan oleh virus Cowpea Mild Mottle Virus (CMMV). Patogen virus CMMV ini mampu menyerang pada beberapa tanaman seperti kedelai atau famili Leguminoceae, Solanaceae, Amaranthaceae, dan Chenopodiaceae. Gejala yang ditunjukkan oleh patogen CMMV pada tanaman kedelai adalah pada daun tanaman terdapat belang secara sistemik, bagian tulang daun terdapat klorosis serta daun yang terinfeksi CMMV mengalami malformasi (Gambar 2.18)."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitSamarKacangTunggakCowpeaMildMottleVirusK,
        ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottle2,
