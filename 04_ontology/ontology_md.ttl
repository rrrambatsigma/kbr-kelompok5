    ns1:menyerangBagian ns1:Biji,
        ns1:Daun ;
    ns1:menyerangTanaman ns1:KacangTanah ;
    ns1:tingkatKeparahan "Serangan penyakit berdampak pada pengurangan jumlah polong dan berat biji per tanaman sehingga dapat mengakibatkan penurunan hasil dan produksi sebesar 50%."@id .

ns1:PengendalianBiologis a owl:Class ;
    rdfs:label "Pengendalian Biologis"@id ;
    rdfs:subClassOf ns1:Pengendalian .

ns1:PengendalianKimiawi a owl:Class ;
    rdfs:label "Pengendalian Kimiawi"@id ;
    rdfs:subClassOf ns1:Pengendalian .

ns1:Patogen a owl:Class ;
    rdfs:label "Patogen"@id ;
    owl:disjointWith ns1:Pengendalian,
        ns1:Penyakit,
        ns1:Referensi,
        ns1:TanamanPangan,
        ns1:Varietas .

ns1:PengendalianKulturTeknis a owl:Class ;
    rdfs:label "Pengendalian Kultur Teknis"@id ;
    rdfs:subClassOf ns1:Pengendalian .

ns1:Penyakit a owl:Class ;
    rdfs:label "Penyakit"@id ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Patogen ;
            owl:onProperty ns1:disebabkanOleh ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Referensi ;
            owl:onProperty ns1:memilikiReferensi ],
        [ a owl:Restriction ;
            owl:onProperty ns1:memilikiGejala ;
            owl:someValuesFrom ns1:Gejala ],
        [ a owl:Restriction ;
            owl:onProperty ns1:menyerangTanaman ;
            owl:someValuesFrom ns1:TanamanPangan ] ;
    owl:disjointWith ns1:Referensi,
        ns1:TanamanPangan,
        ns1:Varietas .

ns1:GejalaDaun a owl:Class ;
    rdfs:label "Gejala Daun"@id ;
    rdfs:subClassOf ns1:Gejala .

ns1:Daun a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Daun"@id .

ns1:Gejala a owl:Class ;
    rdfs:label "Gejala"@id ;
    owl:disjointWith ns1:Patogen,
        ns1:Pengendalian,
        ns1:Penyakit,
        ns1:Referensi,
        ns1:TanamanPangan,
        ns1:Varietas .

ns1:Pengendalian a owl:Class ;
    rdfs:label "Pengendalian"@id ;
    owl:disjointWith ns1:Penyakit,
        ns1:Referensi,
        ns1:TanamanPangan,
        ns1:Varietas .

