kbr:GejalaPenyakitBercakKuningUbiJalarBercakDaun a kbr:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun"@id ;
    kbr:deskripsiGejala "Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018)."@id ;
