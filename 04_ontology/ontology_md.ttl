ns1:PenyakitTungroPadi a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Tungro"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianBerbagaiStrategiPengendalianPenyakitTungro_55feb199,
        ns1:PengendalianKemudianSanitasiDariKeberadaanGulma_0875260e,
        ns1:PengendalianSelainItuDapatJugaDiaplikasikan_fca0edb4,
        ns1:PengendalianTindakanAlternatifTerakhirYaituDengan_41430043 ;
    ns1:deskripsiPenyakit "Asal kata tungro pada nama penyakit ini berasal dari bahasa Tagalog, Filipina yang mempunyai arti pertumbuhan yang terhambat. Meskipun sudah menjadi nama penyakit yang resmi dan berlaku di Indonesia. Penyakit ini juga mempunyai nama lokal di negara lain maupun di wilayah lain di Indonesia, seperti di Malaysia disebut dengan penyakit merah, di Thailand disebut yellow orange leaf disease, di Kalimantan Selatan disebut penyakit habang, di Sulawesi Selatan disebut penyakit cella pance, dan di Bali disebut penyakit kebebeng (Muhsin dan Widiarta 2009). Oleh karena itu, penyebaran penyakit sangat luas dengan luas serangan mencapai 3.650 ha per tahun di Indonesia pada periode 2001-2006 (Kusprayogie et al. 2001)"@id ;
    ns1:dikendalikanDengan ns1:PengendalianBerbagaiStrategiPengendalianPenyakitTungro_55feb199,
        ns1:PengendalianKemudianSanitasiDariKeberadaanGulma_0875260e,
        ns1:PengendalianSelainItuDapatJugaDiaplikasikan_fca0edb4,
        ns1:PengendalianTindakanAlternatifTerakhirYaituDengan_41430043 ;
    ns1:disebabkanOleh ns1:RiceTungroBacilliforVirus,
        ns1:RiceTungroSphericalVirus ;
    ns1:memilikiGejala ns1:GejalaIndikasiAdanyaInfeksiVirusTungro_02918429,
        ns1:GejalaKemudianPadaBeberapaHelaiDaun_579f61f7,
        ns1:GejalaTanamanPadiYangTerserangVirus_b93b875c ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Daun ;
    ns1:menyerangTanaman ns1:Padi .

