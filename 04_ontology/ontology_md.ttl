ns1:PenyakitLayuBakteriKacangTanah a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Layu Bakteri"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianAeroginosaBulkholderiaCepaciaSertaBacillus_b7c945fd,
        ns1:PengendalianAgensHayatiDariJenisBakteri_2ea7be64,
        ns1:PengendalianBeberapaBakteriAntagonisSepertiPsedomonas_577cd405,
