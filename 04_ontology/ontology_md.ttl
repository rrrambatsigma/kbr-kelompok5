                                                                              skos:prefLabel "Pengamatan gejala Penyakit Hawar Daun Bakteri"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitHawarDaunJagungBercakDaun
ns1:PengamatanPenyakitHawarDaunJagungBercakDaun rdf:type owl:NamedIndividual ,
                                                         ns1:GejalaDaun ;
                                                ns1:didukungOleh ns1:BuktiGejalaPenyakitHawarDaunJagungSelanjutnyaBerkembangMenjadiBerbentukLonjong ;
                                                ns1:memilikiGejalaKanonik ns1:BercakDaun ;
                                                ns1:merupakanGejalaDari ns1:PenyakitHawarDaunJagung ;
                                                ns1:terdapatPada ns1:Daun ;
                                                ns1:deskripsiGejala "Selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan, infeksi lebih lanjut bercak akan melebar dan bergabung dengan bercak lain dan menyebabkan jaringan daun mengalami nekrosis."@id ;
                                                rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ,
                                                             "Selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan, infeksi lebih lanjut bercak akan melebar dan bergabung dengan bercak lain dan menyebabkan jaringan daun mengalami nekrosis."@id ;
                                                rdfs:label "Bercak daun pada Penyakit Hawar Daun"@id ;
                                                skos:prefLabel "Bercak daun pada Penyakit Hawar Daun"@id .


