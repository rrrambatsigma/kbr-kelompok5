ns1:BuktiPengendalianPenyakitKerdilKedelaiSoybeanStuntVirusKedel a ns1:BuktiPengendalian,
        owl:NamedIndividual ;
    rdfs:label "Bukti pengendalian Penyakit Kerdil Kedelai (Soybean Stunt Virus) (Kedelai)"@id ;
    ns1:dokumenSumber "DOC002" ;
    ns1:halamanSumber "61" ;
    ns1:idChunkSumber "DOC002_C061_02" ;
    ns1:identifierSumber "CTL_101" ;
    ns1:kutipanNormalisasi "Pengendalian dapat dilakukan dengan benih yang bebas dari patogen SSV, melakukan pergiliran tanaman pada daerah endemik, pada benih yang akan ditanam sebaiknya diberikan seed treatment dengan insektisida thiamethoxam dan mengendalikan populasi serangga vektor dengan pestisida kimia yaitu insektisida berbahan aktif imidakloprid secara tepat dan bijaksana (Inayati and Yusnawan, 2017)."@id ;
    ns1:kutipanSumber "Pengendalian dapat dilakukan dengan benih yang bebas dari patogen SSV, melakukan pergiliran tanaman pada daerah endemik, pada benih yang akan ditanam sebaiknya diberikan seed treatment dengan insektisida thiamethoxam dan mengendalikan populasi serangga vektor dengan pestisida kimia yaitu insektisida berbahan aktif imidakloprid secara tepat dan bijaksana (Inayati and Yusnawan, 2017)."@id ;
    rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
    skos:prefLabel "Bukti pengendalian Penyakit Kerdil Kedelai (Soybean Stunt Virus) (Kedelai)"@id ;
    prov:wasDerivedFrom ns1:BukuDOC002 .

ns1:BuktiPengendalianPenyakitKudisUbiJalar2 a ns1:BuktiPengendalian,
        owl:NamedIndividual ;
    rdfs:label "Bukti pengendalian Penyakit kudis (Ubi jalar)"@id ;
    ns1:catatanKualitas "Kutipan sumber berupa fragmen atau kalimat terpotong."@id ;
    ns1:dokumenSumber "DOC002" ;
    ns1:halamanSumber "84" ;
    ns1:idChunkSumber "DOC002_C084_04" ;
    ns1:identifierSumber "CTL_189" ;
    ns1:kutipanNormalisasi "batatas misalnya jagung, padi, kacang-kacangan, penanaman varietas campuran misalnya varietas yang tahan dengan yang agak tahan, sanitasi lahan dengan cara membakar atau mengubur dalam tanah sisa-sisa tanaman yang terinfeksi, menggunakan fungisida kimiawi misalnya menggunakan bahan aktif benomyl (dosis 400 g ba/ha), chlorotalonil (1.300 g ba/ha), captafol (1.520 g ba/ha), fentin hidraxide (300 g ba/ha), tembaga oxiklorida (1.500 g ba/ha), dan mancozeb, dapat juga menggunakan fungisida nabati (Saleh and Rahayuningsih, 2013)."@id ;
    ns1:kutipanSumber "batatas misalnya jagung, padi, kacang-kacangan, penanaman varietas campuran misalnya varietas yang tahan dengan yang agak tahan, sanitasi lahan dengan cara membakar atau mengubur dalam tanah sisa-sisa tanaman yang terinfeksi, menggunakan fungisida kimiawi misalnya menggunakan bahan aktif benomyl (dosis 400 g ba/ha), chlorotalonil (1.300 g ba/ha), captafol (1.520 g ba/ha), fentin hidraxide (300 g ba/ha), tembaga oxiklorida (1.500 g ba/ha), dan mancozeb, dapat juga menggunakan fungisida nabati (Saleh and Rahayuningsih, 2013)."@id ;
    rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
    skos:prefLabel "Bukti pengendalian Penyakit kudis (Ubi jalar)"@id ;
    prov:wasDerivedFrom ns1:BukuDOC002 .

ns1:BuktiPengendalianPenyakitLayuFusariumKedelai a ns1:BuktiPengendalian,
        owl:NamedIndividual ;
    rdfs:label "Bukti pengendalian Penyakit Layu Fusarium (Kedelai)"@id ;
    ns1:catatanKualitas "Kutipan sumber berupa fragmen atau kalimat terpotong."@id ;
    ns1:dokumenSumber "DOC002" ;
    ns1:halamanSumber "43" ;
    ns1:idChunkSumber "DOC002_C043_02" ;
    ns1:identifierSumber "CTL_049" ;
    ns1:kutipanNormalisasi "dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017)."@id ;
    ns1:kutipanSumber "dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017)."@id ;
    rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
    skos:prefLabel "Bukti pengendalian Penyakit Layu Fusarium (Kedelai)"@id ;
    prov:wasDerivedFrom ns1:BukuDOC002 .

