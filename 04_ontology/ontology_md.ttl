ns1:GejalaBiji a owl:Class ;
    rdfs:label "Gejala Biji"@id ;
    rdfs:comment "Gejala lanjut pada daun dapat menyebabkan bentuk dan warna daun tidak normal, biji mengalami distorsi, perubahan warna dan lesi, pada batang akan nampak gejala dieback, kerdil dan roset, sedangkan pada keseluruhan tanaman menjadi kerdil."@id,
        "Gejala yang diamati pada biji."@id ;
    rdfs:subClassOf ns1:Gejala ;
    skos:prefLabel "Gejala Biji"@id .

ns1:GejalaPucuk a owl:Class ;
    rdfs:label "Gejala Pucuk"@id ;
    rdfs:comment "Gejala yang diamati pada pucuk atau tunas."@id,
        "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
    rdfs:subClassOf ns1:Gejala ;
    skos:prefLabel "Gejala Pucuk"@id .

ns1:Pucuk a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Pucuk"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id,
        "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
    skos:prefLabel "Pucuk"@id .

ns1:Suhu a owl:Class ;
    rdfs:label "Suhu"@id ;
    rdfs:comment "Faktor suhu lingkungan."@id,
        "Selain itu perlakuan panas kering juga dapat menjadi alternatif lainnya, seperti perlakuan panas kering pada suhu 55oC yang dapat mengeliminasi Pantoea stewartii pada benih jagung (Nalis et al. 2015) ataupun perendaman benih pada air panas 57oC selama 10 menit (Kadir et al. 2009)"@id ;
    rdfs:subClassOf ns1:FaktorLingkungan ;
    skos:prefLabel "Suhu"@id .

ns1:Biji a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Biji"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id,
        "Senyawa fenolik, tanin, antosianin, dan isoflavon terkandung pada biji kedelai (Nurrahman, 2015)."@id ;
    skos:prefLabel "Biji"@id .

