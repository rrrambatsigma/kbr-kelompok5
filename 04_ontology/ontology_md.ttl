                                                 ns1:KondisiMusimKemarau ;
                             ns1:disebabkanOleh ns1:PhakopsoraMeibomiae ,
                                                ns1:PhakopsoraPachyrhizi ,
                                                ns1:PhakopsporaPachyrhizi ;
                             ns1:memilikiGejala ns1:GejalaPenyakitKaratDaunKedelai ,
                                                ns1:GejalaPenyakitKaratDaunKedelai2 ,
                                                ns1:GejalaPenyakitKaratDaunKedelaiBercakDaun ,
                                                ns1:GejalaPenyakitKaratDaunKedelaiBercakTanaman ,
                                                ns1:GejalaPenyakitKaratDaunKedelaiDaunKering ,
                                                ns1:GejalaPenyakitKaratDaunKedelaiDaunRontok ,
