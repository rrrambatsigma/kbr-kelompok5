    skos:prefLabel "Pengamatan gejala Penyakit kudis"@id .

ns1:PengamatanPenyakitKudisUbiJalarMartanto2010MenjelaskanBahwaMembentuk a ns1:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala Penyakit kudis"@id ;
    ns1:deskripsiGejala "Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar membentuk lapisan gabus untuk mempertahankan diri dari serangan penyakit kudis (Gambar 3A dan B)."@id ;
    ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalarMartanto2010MenjelaskanBahwaMembentuk ;
