        ns1:BuktiPengendalianPenyakitEmbunPalsuDownyMildewKedelaiPerlakuanBenihMembantuMenekanTerjadinya,
        ns1:BuktiPenyakitPenyakitEmbunPalsuDownyMildewKedelaiBULU,
        ns1:BuktiPenyakitPenyakitEmbunPalsuDownyMildewKedelaiPalsuDownyMildew ;
    ns1:dikendalikanDengan ns1:PenggunaanBenihSehat,
        ns1:PenggunaanFungisida,
        ns1:PerlakuanBenih,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:KondisiKelembapanTinggi,
        ns1:KondisiSuhuRendah ;
    ns1:disebabkanOleh ns1:PeronosporaManshurica ;
    ns1:identifierSumber "DIS_011",
        "DIS_119" ;
    ns1:memilikiGejala ns1:PengamatanPenyakitEmbunPalsuDownyMildewKedelaiBercakDaun,
        ns1:PengamatanPenyakitEmbunPalsuDownyMildewKedelaiKemudianBerkembangMenjadiBerwarnaKuning,
        ns1:PengamatanPenyakitEmbunPalsuDownyMildewKedelaiKlorosisDaun,
        ns1:PengamatanPenyakitEmbunPalsuDownyMildewKedelaiManshuricaAwalnyaTerdapatAdanya,
        ns1:PengamatanPenyakitEmbunPalsuDownyMildewKedelaiMenjadiKakuTerinfeksi,
        ns1:PengamatanPenyakitEmbunPalsuDownyMildewKedelaiMunculTerinfeksiP,
        ns1:PengamatanPenyakitEmbunPalsuDownyMildewKedelaiPermukaanBawahWarnaCoklatTerdapat,
        ns1:PengamatanPenyakitEmbunPalsuDownyMildewKedelaiTingkatMenyebabkanBentukTidak ;
    ns1:memilikiReferensi ns1:BukuDOC002,
        ns1:BukuDOC005 ;
    ns1:menyerangTanaman ns1:Kedelai ;
    ns1:namaInggrisPenyakit "Downy mildew" ;
    ns1:tingkatKeparahan "Kehilangan hasil akibat penyakit ini mencapai 6–18%."@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit embun madu atau downy mildew atau disebut juga dengan penyakit bulai disebabkan oleh patogen dari jamur Peronospora manshurica (Inayati and Yusnawan, 2017). Patogen merupakan parasit obligat. Patogen P. manshurica memiliki kisaran inang seperti tanaman Cucurbitaceae seperti timun, labu kuning, melon, dan timun suri (Anggraini et al., 2019)."@id ;
    skos:altLabel "Downy mildew"@id,
        "EMBUN BULU"@id ;
    skos:prefLabel "Penyakit Embun Palsu (Downy mildew)"@id .

ns1:PenyakitHawarPelepahDaunPadi a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Hawar Pelepah Daun"@id ;
    ns1:berkaitanPengendalian ns1:PengaturanJarakTanam,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanFungisida,
        ns1:PenggunaanPseudomonas,
        ns1:PenggunaanTrichoderma,
        ns1:PengumpulanDanPemusnahan ;
    ns1:deskripsiPenyakit "Penyakit hawar pelepah daun (HDP) dapat ditemukan pada tiap musim tanam padi. Meskipun tidak sebesar akibat infeksi penyakit HDB dan blas, kehilangan hasil akibat penyakit HDP berkisar antara 20-35% di beberapa negara penghasil beras dunia (Inagaki 2001). Sementara itu, di Indonesia kehilangan hasil yang dilaporkan mencapai 20% (Suparyono dan Sudir 1999)."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitHawarPelepahDaunPadiPenyebabHPDCendawanRhizoctoniaSolani,
        ns1:BuktiPengendalianPenyakitHawarPelepahDaunPadiFajarfika2021PGPRKelompokPseudomonas,
        ns1:BuktiPengendalianPenyakitHawarPelepahDaunPadiPengendalianAntaranyaKulturTeknisMelalui,
        ns1:BuktiPengendalianPenyakitHawarPelepahDaunPadiPengendalianHayatiAgensBiokontrolMenekan,
        ns1:BuktiPengendalianPenyakitHawarPelepahDaunPadiPerlakuanKimiaBerupaFungisidaAlternatif,
        ns1:BuktiPenyakitPenyakitHawarPelepahDaunPadiTanpaTeks ;
    ns1:dikendalikanDengan ns1:PengaturanJarakTanam,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanFungisida,
        ns1:PenggunaanPseudomonas,
        ns1:PenggunaanTrichoderma,
        ns1:PengumpulanDanPemusnahan ;
    ns1:disebabkanOleh ns1:RhizoctoniaSolani ;
    ns1:identifierSumber "DIS_003" ;
    ns1:memilikiGejala ns1:PengamatanPenyakitHawarPelepahDaunPadiAdapunBentukSendiriBerupaBulat,
        ns1:PengamatanPenyakitHawarPelepahDaunPadiBagianTerdapatBerwarnaCoklatKemerahan,
        ns1:PengamatanPenyakitHawarPelepahDaunPadiBercakDaun,
        ns1:PengamatanPenyakitHawarPelepahDaunPadiBerubahMenjadiPutihKelabuTepi,
        ns1:PengamatanPenyakitHawarPelepahDaunPadiBusukBatang,
        ns1:PengamatanPenyakitHawarPelepahDaunPadiFaseAnakanSampaiFaseMatang,
        ns1:PengamatanPenyakitHawarPelepahDaunPadiHDPDilihatSelubung ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangFase ns1:FaseAnakanTanaman,
        ns1:FaseMatangSusu ;
    ns1:menyerangTanaman ns1:Padi ;
    ns1:tingkatKeparahan "Meskipun tidak sebesar akibat infeksi penyakit HDB dan blas, kehilangan hasil akibat penyakit HDP berkisar antara 20-35% di beberapa negara penghasil beras dunia (Inagaki 2001)."@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit hawar pelepah daun (HDP) dapat ditemukan pada tiap musim tanam padi. Meskipun tidak sebesar akibat infeksi penyakit HDB dan blas, kehilangan hasil akibat penyakit HDP berkisar antara 20-35% di beberapa negara penghasil beras dunia (Inagaki 2001). Sementara itu, di Indonesia kehilangan hasil yang dilaporkan mencapai 20% (Suparyono dan Sudir 1999)."@id ;
    skos:prefLabel "Penyakit Hawar Pelepah Daun"@id .

ns1:PenyakitTungroPadi a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Tungro"@id ;
    ns1:berkaitanPengendalian ns1:PengaturanWaktuTanam,
        ns1:PengelolaanGulma,
        ns1:PenggunaanMetarhizium,
        ns1:PenggunaanVarietasTahan,
        ns1:PengumpulanDanPemusnahan,
        ns1:SanitasiLahan ;
    ns1:deskripsiPenyakit "Asal kata tungro pada nama penyakit ini berasal dari bahasa Tagalog, Filipina yang mempunyai arti pertumbuhan yang terhambat. Meskipun sudah menjadi nama penyakit yang resmi dan berlaku di Indonesia. Penyakit ini juga mempunyai nama lokal di negara lain maupun di wilayah lain di Indonesia, seperti di Malaysia disebut dengan penyakit merah, di Thailand disebut yellow orange leaf disease, di Kalimantan Selatan disebut penyakit habang, di Sulawesi Selatan disebut penyakit cella pance, dan di Bali disebut penyakit kebebeng (Muhsin dan Widiarta 2009). Oleh karena itu, penyebaran penyakit sangat luas dengan luas serangan mencapai 3.650 ha per tahun di Indonesia pada periode 2001-2006 (Kusprayogie et al. 2001)"@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitTungroPadiDisebabkanBerbedaRiceBacilliforRTBV,
        ns1:BuktiPatogenPenyakitTungroPadiDisebabkanBerbedaRiceBacilliforRTBV2,
        ns1:BuktiPengendalianPenyakitTungroPadiBerbagaiStrategiPengendalianDijelaskanBerikut,
        ns1:BuktiPengendalianPenyakitTungroPadiKemudianSanitasiKeberadaanGulmaSinggang,
        ns1:BuktiPengendalianPenyakitTungroPadiSelainDiaplikasikanCendawanEntomopatogenMetarhizium,
        ns1:BuktiPengendalianPenyakitTungroPadiTindakanAlternatifTerakhirPenggunaanPestisida,
        ns1:BuktiPenyakitPenyakitTungroPadiTanpaTeks ;
    ns1:dikendalikanDengan ns1:PengaturanWaktuTanam,
        ns1:PengelolaanGulma,
        ns1:PenggunaanMetarhizium,
        ns1:PenggunaanVarietasTahan,
        ns1:PengumpulanDanPemusnahan,
        ns1:SanitasiLahan ;
    ns1:disebabkanOleh ns1:RiceTungroBacilliforVirus,
        ns1:RiceTungroSphericalVirus ;
    ns1:identifierSumber "DIS_004" ;
    ns1:memilikiGejala ns1:PengamatanPenyakitTungroPadiKerdilTanaman,
        ns1:PengamatanPenyakitTungroPadiKlorosisDaun,
        ns1:PengamatanPenyakitTungroPadiPertumbuhanTerhambat ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangTanaman ns1:Padi ;
    rdfs:comment "Asal kata tungro pada nama penyakit ini berasal dari bahasa Tagalog, Filipina yang mempunyai arti pertumbuhan yang terhambat. Meskipun sudah menjadi nama penyakit yang resmi dan berlaku di Indonesia. Penyakit ini juga mempunyai nama lokal di negara lain maupun di wilayah lain di Indonesia, seperti di Malaysia disebut dengan penyakit merah, di Thailand disebut yellow orange leaf disease, di Kalimantan Selatan disebut penyakit habang, di Sulawesi Selatan disebut penyakit cella pance, dan di Bali disebut penyakit kebebeng (Muhsin dan Widiarta 2009). Oleh karena itu, penyebaran penyakit sangat luas dengan luas serangan mencapai 3.650 ha per tahun di Indonesia pada periode 2001-2006 (Kusprayogie et al. 2001)"@id,
        "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ;
    skos:prefLabel "Penyakit Tungro"@id .

