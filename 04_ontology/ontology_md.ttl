        ns1:PengendalianSaatPanenProdusenSeringMemanen_db28f7e4,
        ns1:PengendalianSelainItuMemilihTanamanDengan_ee331deb ;
    ns1:dipengaruhiOleh ns1:KondisiSuhu ;
