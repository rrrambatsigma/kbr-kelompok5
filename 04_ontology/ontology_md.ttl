ns1:PengamatanPenyakitBusukHitamBlackRotUbiJalarBusukAkar a ns1:GejalaAkar,
        owl:NamedIndividual ;
    rdfs:label "Busuk akar pada Penyakit busuk hitam (black rot)"@id ;
    ns1:deskripsiGejala "Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020)."@id ;
    ns1:didukungOleh ns1:BuktiGejalaPenyakitBusukHitamBlackRotUbiJalarPenyebaranHitamMelaluiLukaSetek ;
    ns1:memilikiGejalaKanonik ns1:BusukAkar ;
    ns1:merupakanGejalaDari ns1:PenyakitBusukHitamBlackRotUbiJalar ;
    ns1:terdapatPada ns1:Akar ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id,
        "Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020)."@id ;
    skos:prefLabel "Busuk akar pada Penyakit busuk hitam (black rot)"@id .

