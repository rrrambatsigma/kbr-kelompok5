ns1:ObservasiLingkungan a owl:Class ;
    rdfs:label "Observasi Lingkungan"@id ;
    rdfs:comment "Individu observasi kuantitatif atau kualitatif faktor lingkungan."@id ;
    rdfs:subClassOf ns1:FaktorLingkungan ;
    skos:prefLabel "Observasi Lingkungan"@id .

ns1:PenyakitHawarBakteriBacterialBlightKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Hawar Bakteri (Bacterial Blight)"@id ;
    ns1:berkaitanPengendalian ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanBakterisida,
        ns1:PenggunaanPseudomonas,
        ns1:PerlakuanBenih,
        ns1:RotasiTanaman ;
    ns1:deskripsiPenyakit "Penyakit hawar bakteri (bacterial blight) disebabkan oleh patogen bakteri Pseudomonas syringae pv. glycine. Penyakit hawar bakteri menjadi salah satu penyakit yang menjadi kendala utama pada budidaya tanaman kedelai. Gejala tanaman yang disebabkan oleh patogen P. syringae pv. glycine diawali dengan munculnya bercak yang awalnya berwarna coklat kekuningan dengan ukuran bercak kecil. Pada tingkat serangan yang tinggi bercak kemudian menjadi hawar yang ditandai dengan warna kecokelatan dilingkari dengan lingkaran kuning dan menyebar tidak beraturan (Gambar 2.14)."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitHawarBakteriBacterialBlightKedelaiPenBacterialBlightDisebabkanPseudomonas,
        ns1:BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelaiBacillusSubtilisPseudomonasFluorescensMerupakan,
        ns1:BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelaiMelakukanPergiliranAgarSiklusDiputus,
