        ns1:GejalaPenyakitEmbunPalsuDownyMildewKedelaiMiseliumPadaTanama,
        ns1:GejalaPenyakitEmbunPalsuDownyMildewKedelaiNekrosisDaun,
        ns1:GejalaPenyakitEmbunPalsuDownyMildewKedelaiPertumbuhanAbnorma ;
    ns1:memilikiReferensi ns1:BukuDOC002,
        ns1:BukuDOC005 ;
    ns1:menyerangBagian ns1:Buah,
        ns1:Daun ;
    ns1:menyerangTanaman ns1:Kedelai ;
    ns1:namaInggrisPenyakit "Downy mildew" ;
    ns1:tingkatKeparahan "Kehilangan hasil akibat penyakit ini mencapai 6–18%."@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit embun madu atau downy mildew atau disebut juga dengan penyakit bulai disebabkan oleh patogen dari jamur Peronospora manshurica (Inayati and Yusnawan, 2017). Patogen merupakan parasit obligat. Patogen P. manshurica memiliki kisaran inang seperti tanaman Cucurbitaceae seperti timun, labu kuning, melon, dan timun suri (Anggraini et al., 2019)."@id ;
    skos:altLabel "Downy mildew"@id,
        "EMBUN BULU"@id ;
    skos:prefLabel "Penyakit Embun Palsu (Downy mildew)"@id .

ns1:PenyakitLayuBakteriKacangTanah a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Layu Bakteri"@id ;
    ns1:berkaitanPengendalian ns1:PengelolaanTerpadu,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanBacillus,
        ns1:PenggunaanBakterisida,
        ns1:PenggunaanBenihSehat,
        ns1:PenggunaanBiopestisida,
        ns1:PenggunaanPestisidaNabati,
        ns1:PenggunaanPseudomonas,
        ns1:PenggunaanTanamanBukanInang,
        ns1:PenggunaanVarietasTahan,
        ns1:RotasiTanaman ;
    ns1:deskripsiPenyakit "Kacang tanah umumnya kurang rentan dibandingkan tomat, kentang, tembakau dan terung. Insiden penyakit 4-8% pada kultivar kacang tanah resisten dan 10-30% pada yang rentan. Gejala awal berupa kelayuan tidak permanen, tanaman segar kembali malam atau pagi hari. Daun yang layu melengkung ke atas. Gejala ini diikuti oleh kematian sebagian atau seluruh cabang dalam satu tanaman. Jaringan xylem dan pith mengalami perubahan warna. Pada kondisi ini sistem perakaran tidak berfungsi sehingga tanaman layu dan mati."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitLayuBakteriKacangTanah,
