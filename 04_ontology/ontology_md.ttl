    rdfs:label "Diagnosis"@id ;
    dcterms:source "Dokumentasi TBox"@id ;
    rdfs:comment "Catatan proses diagnosis tanaman."@id ;
    owl:disjointWith kbr:BagianTanaman,
        kbr:BuktiSumber,
        kbr:FaktorRisiko,
        kbr:FasePertumbuhan,
        kbr:Gejala,
        kbr:GejalaKanonik,
