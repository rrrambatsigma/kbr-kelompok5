        ns1:BuktiPengendalianPenyakitKudisUbiJalar4,
        ns1:BuktiPenyakitPenyakitKudisUbiJalar ;
    ns1:dikendalikanDengan ns1:PengelolaanTerpadu,
        ns1:PenggunaanBakterisida,
        ns1:PenggunaanEkstrakTanaman,
        ns1:PenggunaanFungisida,
        ns1:PenggunaanPestisidaNabati,
        ns1:PenggunaanTanamanBukanInang,
        ns1:PenggunaanVarietasTahan,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:KondisiMusimHujan,
        ns1:KondisiSuhuRendah ;
    ns1:disebabkanOleh ns1:ElsinoeBatatas,
        ns1:SpacelomaBatatas ;
