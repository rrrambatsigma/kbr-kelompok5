    skos:prefLabel "Klorosis daun"@id .

kbr:GejalaPenyakitBusukHitamBlackRotUbiJalarBercakTanaman a kbr:GejalaAkar,
        kbr:GejalaUmbi,
        owl:NamedIndividual ;
    rdfs:label "Bercak pada tanaman"@id ;
    kbr:deskripsiGejala "fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b)."@id ;
    kbr:didukungOleh kbr:BuktiGejalaPenyakitBusukHitamBlackRotUbiJalar2 ;
    kbr:memilikiGejalaKanonik kbr:BercakTanaman ;
    kbr:merupakanGejalaDari kbr:PenyakitBusukHitamBlackRotUbiJalar ;
    kbr:terdapatPada kbr:Akar,
        kbr:Umbi ;
    rdfs:comment "Gejala bercak pada tanaman pada tanaman Ubi jalar: fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b)."@id,
        "fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b)."@id ;
    skos:prefLabel "Bercak pada tanaman"@id .

kbr:GejalaPenyakitBusukHitamBlackRotUbiJalarBusukAkar a kbr:GejalaAkar,
        owl:NamedIndividual ;
    rdfs:label "Busuk akar"@id ;
    kbr:deskripsiGejala "Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020)."@id ;
    kbr:didukungOleh kbr:BuktiGejalaPenyakitBusukHitamBlackRotUbiJalar3 ;
    kbr:memilikiGejalaKanonik kbr:BusukAkar ;
    kbr:merupakanGejalaDari kbr:PenyakitBusukHitamBlackRotUbiJalar ;
    kbr:terdapatPada kbr:Akar ;
    rdfs:comment "Gejala busuk akar pada tanaman Ubi jalar: Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020)."@id,
        "Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020)."@id ;
    skos:prefLabel "Busuk akar"@id .

