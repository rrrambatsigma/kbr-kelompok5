    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Batang ;
    ns1:menyerangTanaman ns1:UbiKayu ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Muncul eksudat bergetah berwarna krem atau coklat kekuningan pada bagian batang yang terinfeksi, dan batang akan mati, meskipun adakalanya pada batang yang terinfeksi dan mati juga dapat memunculkan tunas baru"@id ;
    skos:prefLabel "Hawar bakteri"@id .

