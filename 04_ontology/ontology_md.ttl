ns1:BuktiPengendalianPenyakitLayuFusariumKedelaiDilakukanTeknikPengendalianMemperbaikiSaluran a ns1:BuktiPengendalian,
        owl:NamedIndividual ;
    rdfs:label "Bukti pengendalian Penyakit Layu Fusarium"@id ;
    ns1:catatanKualitas "Kutipan sumber berupa fragmen atau kalimat terpotong."@id ;
    ns1:dokumenSumber "DOC002" ;
    ns1:halamanSumber "43" ;
    ns1:idChunkSumber "DOC002_C043_02" ;
    ns1:identifierSumber "CTL_049" ;
    ns1:kutipanNormalisasi "dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017)."@id ;
