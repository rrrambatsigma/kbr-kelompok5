        ns1:GejalaPadaBercakTersebutTumbuhPustul_97a58385 ;
    ns1:memilikiReferensi ns1:BukuDOC005 ;
    ns1:menyerangBagian ns1:Daun ;
    ns1:menyerangTanaman ns1:KacangTanah ;
    ns1:tingkatKeparahan "Kehilangan hasil mencapai 57% (Semangun 1991)."@id .

ns1:Padi a ns1:TanamanPangan,
        owl:NamedIndividual ;
    rdfs:label "Padi"@id ;
    ns1:deskripsiTanaman "Padi merupakan tanaman pangan yang paling banyak dibudidayakan, sebab menjadi sumber pangan pokok bagi masyarakat Indonesia. Tidak hanya di Indonesia, di sebagian besar negara Asia pun padi menjadi tanaman pangan utama. Adapun 4 negara yang mengonsumsi beras paling besar yaitu Cina, India, Indonesia, dan Bangladesh dengan jumlah konsumsi berturut-turut sebesar 200 juta ton, 170 juta ton, 50 juta ton, dan 20 juta ton (FAO 2016). Berdasarkan jumlah konsumsi beras yang begitu besar, maka perlu upaya untuk peningkatan produksi beras untuk mencukup kebutuhan tersebut. Upaya peningkatan produksi dapat dilakukan dengan berbagai cara, termasuk dengan proteksi tanaman terhadap gangguan organisme pengganggu tanaman (OPT). OPT merupakan faktor biotik yang dapat mengakibatkan kehilangan hasil dari padi, sehingga produksi tanaman dapat menurun bahkan menimbulkan kerugian ekonomi."@id ;
    ns1:diserangPenyakit ns1:PenyakitBlasPadi,
        ns1:PenyakitHawarDaunBakteriPadi,
        ns1:PenyakitHawarPelepahDaunPadi,
        ns1:PenyakitKerdilRumputDanKerdilHampaPadi,
        ns1:PenyakitTungroPadi ;
    ns1:memilikiVarietas ns1:VarietasBondoyudo,
        ns1:VarietasKalimas,
        ns1:VarietasTukadBalian,
        ns1:VarietasTukadUnda .

ns1:PenyakitEmbunTepungPowderyMildewKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Embun Tepung (Powdery Mildew)"@id ;
