        "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Pengamatan gejala Penyakit kudis"@id .

ns1:PengamatanPenyakitKudisUbiJalarMenjadiTidakProduktifFotosintesisTingkat a ns1:GejalaDaun,
        owl:NamedIndividual ;
