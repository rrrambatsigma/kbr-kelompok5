ns1:GejalaPenyakitBercakDaunKacangTanahKlorosisDaun a ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Klorosis daun pada Penyakit Bercak Daun (Kacang tanah)"@id ;
    ns1:deskripsiGejala "C personata membentuk konidia lebih pendek dan gemuk bersekat 1 - 7, C arachidicola bercak relatif lebih dulu muncul, berukuran lebih besar, berwarna kekuningan, sporulasi cendawan lebih banyak di permukaan atas daun."@id ;
