ns1:PenyakitRebahKecambahKedelai a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Rebah Kecambah"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianAplikasiRizobakteriPemacuTumbuhTanaman_a1a5a132,
        ns1:PengendalianFajarfika2021PerlakuanBenihDengan_3ee86472,
        ns1:PengendalianMenurutInayatiAndYusnawan2017_8d683f5b,
        ns1:PengendalianPenggunaanAgensHayatiMenggunakanBakteri_57428b11,
        ns1:PengendalianSolaniDapatDilakukanDenganBeberapa_1988ff15 ;
    ns1:deskripsiPenyakit "Penyakit rebah kecambah pada tanaman kedelai disebabkan oleh jamur Rhizoctonia solani. Patogen ini mampu menginfeksi tanaman kedelai sejak benih ditanam di lahan. Pada benih yang terinfeksi patogen R. solani maka benih tidak akan berkecambah atau mati. Akibatnya tanaman mati sebelum muncul pada permukaan tanah atau yang disebut dengan pre emergence damping off. Gejala yang muncul adalah benih membusuk akibat infeksi R. solani. Gejala yang muncul setelah benih tumbuh pada permukaan tanah kemudian tanaman mati akibat pangkal batang pada permukaan tanah terdapat bercak coklat akibat terinfeksi patogen (post emergence damping off)."@id ;
    ns1:dikendalikanDengan ns1:PengendalianAplikasiRizobakteriPemacuTumbuhTanaman_a1a5a132,
        ns1:PengendalianFajarfika2021PerlakuanBenihDengan_3ee86472,
        ns1:PengendalianMenurutInayatiAndYusnawan2017_8d683f5b,
        ns1:PengendalianPenggunaanAgensHayatiMenggunakanBakteri_57428b11,
        ns1:PengendalianSolaniDapatDilakukanDenganBeberapa_1988ff15 ;
    ns1:dipengaruhiOleh ns1:KondisiMusimHujan ;
    ns1:disebabkanOleh ns1:RhizoctoniaSolani ;
