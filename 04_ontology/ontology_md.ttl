        "Penyakit Hawar Pelepah Daun"@id .

kbr:PenyakitLayuFusariumKedelai a kbr:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Layu Fusarium"@id ;
    kbr:berkaitanPengendalian kbr:PemupukanBerimbang,
