                                                                            ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottle5 ,
                                                                            ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleV ,
                                                                            ns1:BuktiPenyakitPenyakitSamarKacangTunggakCowpeaMildMottleVirus ;
                                                           ns1:dikendalikanDengan ns1:PengaturanJarakTanam ,
                                                                                  ns1:PengaturanWaktuTanam ,
                                                                                  ns1:PenggunaanInsektisida ,
                                                                                  ns1:PenggunaanMulsa ,
                                                                                  ns1:PenggunaanTanamanBukanInang ,
                                                                                  ns1:PenggunaanVarietasTahan ,
                                                                                  ns1:RotasiTanaman ,
                                                                                  ns1:SanitasiLahan ;
                                                           ns1:dipengaruhiOleh ns1:CuacaMemengaruhiPopulasiBemisiaTabaciPadaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai ;
                                                           ns1:disebabkanOleh ns1:CowpeaMildMottleVirus ;
                                                           ns1:memilikiGejala ns1:GejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedela2 ,
                                                                              ns1:GejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedela3 ,
                                                                              ns1:GejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedela4 ,
                                                                              ns1:GejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedela5 ,
                                                                              ns1:GejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai ;
                                                           ns1:memilikiReferensi ns1:BukuDOC002 ;
                                                           ns1:menyerangBagian ns1:Batang ,
                                                                               ns1:Daun ;
                                                           ns1:menyerangTanaman ns1:Kedelai ;
                                                           ns1:deskripsiPenyakit "Penyakit samar kacang tunggak disebabkan oleh virus Cowpea Mild Mottle Virus (CMMV). Patogen virus CMMV ini mampu menyerang pada beberapa tanaman seperti kedelai atau famili Leguminoceae, Solanaceae, Amaranthaceae, dan Chenopodiaceae. Gejala yang ditunjukkan oleh patogen CMMV pada tanaman kedelai adalah pada daun tanaman terdapat belang secara sistemik, bagian tulang daun terdapat klorosis serta daun yang terinfeksi CMMV mengalami malformasi (Gambar 2.18)."@id ;
                                                           ns1:identifierSumber "DIS_019" ;
                                                           ns1:namaInggrisPenyakit "Cowpea Mild Mottle Virus" ;
                                                           rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                                                        "Penyakit samar kacang tunggak disebabkan oleh virus Cowpea Mild Mottle Virus (CMMV). Patogen virus CMMV ini mampu menyerang pada beberapa tanaman seperti kedelai atau famili Leguminoceae, Solanaceae, Amaranthaceae, dan Chenopodiaceae. Gejala yang ditunjukkan oleh patogen CMMV pada tanaman kedelai adalah pada daun tanaman terdapat belang secara sistemik, bagian tulang daun terdapat klorosis serta daun yang terinfeksi CMMV mengalami malformasi (Gambar 2.18)."@id ;
                                                           rdfs:label "Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)"@id ;
                                                           skos:altLabel "Cowpea Mild Mottle Virus"@id ;
                                                           skos:prefLabel "Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitTungroPadi
ns1:PenyakitTungroPadi rdf:type owl:NamedIndividual ,
                                ns1:EntitasKBR ,
                                ns1:Penyakit ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ns1:disebabkanOleh ;
                                  owl:someValuesFrom ns1:Virus
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ns1:memilikiGejala ;
                                  owl:someValuesFrom ns1:Gejala
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ns1:menyerangTanaman ;
                                  owl:someValuesFrom ns1:TanamanPangan
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ns1:disebabkanOleh ;
                                  owl:allValuesFrom ns1:Patogen
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ns1:memilikiReferensi ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass ns1:Referensi
                                ] ;
                       ns1:berkaitanPengendalian ns1:PengaturanWaktuTanam ,
                                                 ns1:PengelolaanGulma ,
                                                 ns1:PengendalianVektor ,
                                                 ns1:PenggunaanMetarhizium ,
                                                 ns1:PenggunaanVarietasTahan ,
                                                 ns1:PengumpulanDanPemusnahan ,
                                                 ns1:SanitasiLahan ;
                       ns1:didukungOleh ns1:BuktiPatogenPenyakitTungroPadi ,
                                        ns1:BuktiPatogenPenyakitTungroPadi2 ,
                                        ns1:BuktiPengendalianPenyakitTungroPadi ,
                                        ns1:BuktiPengendalianPenyakitTungroPadi2 ,
                                        ns1:BuktiPengendalianPenyakitTungroPadi3 ,
                                        ns1:BuktiPengendalianPenyakitTungroPadi4 ,
                                        ns1:BuktiPenyakitPenyakitTungroPadi ;
                       ns1:dikendalikanDengan ns1:PengaturanWaktuTanam ,
                                              ns1:PengelolaanGulma ,
                                              ns1:PengendalianVektor ,
                                              ns1:PenggunaanMetarhizium ,
                                              ns1:PenggunaanVarietasTahan ,
                                              ns1:PengumpulanDanPemusnahan ,
                                              ns1:SanitasiLahan ;
                       ns1:dipengaruhiOleh ns1:MusimHujanPadaPenyakitTungroPadi ;
                       ns1:disebabkanOleh ns1:RiceTungroBacilliforVirus ,
                                          ns1:RiceTungroSphericalVirus ;
                       ns1:memilikiGejala ns1:GejalaPenyakitTungroPadiBercakTanaman ,
                                          ns1:GejalaPenyakitTungroPadiKerdilTanaman ,
                                          ns1:GejalaPenyakitTungroPadiKlorosisDaun ,
                                          ns1:GejalaPenyakitTungroPadiPertumbuhanTerhambat ;
                       ns1:memilikiReferensi ns1:BukuDOC002 ;
                       ns1:menyerangBagian ns1:Batang ,
                                           ns1:Daun ,
                                           ns1:Malai ;
                       ns1:menyerangTanaman ns1:Padi ;
                       ns1:deskripsiPenyakit "Asal kata tungro pada nama penyakit ini berasal dari bahasa Tagalog, Filipina yang mempunyai arti pertumbuhan yang terhambat. Meskipun sudah menjadi nama penyakit yang resmi dan berlaku di Indonesia. Penyakit ini juga mempunyai nama lokal di negara lain maupun di wilayah lain di Indonesia, seperti di Malaysia disebut dengan penyakit merah, di Thailand disebut yellow orange leaf disease, di Kalimantan Selatan disebut penyakit habang, di Sulawesi Selatan disebut penyakit cella pance, dan di Bali disebut penyakit kebebeng (Muhsin dan Widiarta 2009). Oleh karena itu, penyebaran penyakit sangat luas dengan luas serangan mencapai 3.650 ha per tahun di Indonesia pada periode 2001-2006 (Kusprayogie et al. 2001)"@id ;
                       ns1:identifierSumber "DIS_004" ;
                       rdfs:comment "Asal kata tungro pada nama penyakit ini berasal dari bahasa Tagalog, Filipina yang mempunyai arti pertumbuhan yang terhambat. Meskipun sudah menjadi nama penyakit yang resmi dan berlaku di Indonesia. Penyakit ini juga mempunyai nama lokal di negara lain maupun di wilayah lain di Indonesia, seperti di Malaysia disebut dengan penyakit merah, di Thailand disebut yellow orange leaf disease, di Kalimantan Selatan disebut penyakit habang, di Sulawesi Selatan disebut penyakit cella pance, dan di Bali disebut penyakit kebebeng (Muhsin dan Widiarta 2009). Oleh karena itu, penyebaran penyakit sangat luas dengan luas serangan mencapai 3.650 ha per tahun di Indonesia pada periode 2001-2006 (Kusprayogie et al. 2001)"@id ,
                                    "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ;
                       rdfs:label "Penyakit Tungro"@id ;
                       skos:prefLabel "Penyakit Tungro"@id .


