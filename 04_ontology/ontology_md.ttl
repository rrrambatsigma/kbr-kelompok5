                        owl:onProperty kbr:disebabkanOleh ;
                        owl:someValuesFrom kbr:Fitoplasma ] ) ] ;
    skos:definition "Penyakit yang disebabkan oleh patogen kelompok fitoplasma."@id ;
    skos:prefLabel "Penyakit Fitoplasma"@id .

