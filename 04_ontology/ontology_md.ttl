        kbr:GejalaHawarDaunBakteriUbiKayuHawarDaun,
        kbr:GejalaHawarDaunBakteriUbiKayuLayuDaun ;
    kbr:memilikiReferensi kbr:BukuDOC002 ;
    kbr:menyerangBagian kbr:Daun ;
    kbr:menyerangTanaman kbr:UbiKayu ;
    dcterms:source "Kurasi pakar"@id ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ;
    skos:altLabel "Bacterial leaf blight"@en ;
    skos:definition "Penyakit Hawar daun bakteri pada tanaman Ubi kayu, disebabkan oleh Xanthomonas Campestrispv. Manihotis, dengan gejala antara lain Bercak daun, Daun rontok, Hawar daun, Layu daun."@id ;
    skos:prefLabel "Bacterial leaf blight"@en,
        "Hawar daun bakteri"@id .

kbr:KacangHijau a kbr:Legum,
        kbr:TanamanPangan,
        owl:NamedIndividual ;
    rdfs:label "Kacang hijau"@id ;
    kbr:deskripsiTanaman "Kacang hijau (Vigna radiata) adalah tanaman legum berumur pendek yang termasuk dalam famili Leguminosae (Wilczek, 1954; Verdcourt, 1970). Kacang hijau berasal dari India (De Candole, 1886; Zhukovsky, 1950; Bailey, 1970) atau wilayah Indo-Burma (Vavilov, 1951; H.B. Singh et al., 1970; Jain dan Mehra, 1980). Tanaman ini diproduksi dalam skala besar di Asia bagian selatan dan timur. Kacang hijau merupakan sumber pangan penting bagi protein dan nutrisi esensial lainnya di Asia Selatan dan Barat, serta Afrika Utara dan Timur. Kacang hijau mengandung 26% protein, serta 51% karbohidrat, 10% kadar air, 4% mineral, dan 3% vitamin. Biji kacang hijau mengandung lisin, asam amino esensial yang hanya ditemukan dalam kadar rendah pada protein serealia. Kacang hijau adalah pangan manusia yang bernilai, kebanyakan dikonsumsi dalam bentuk biji kering, juga digunakan sebagai pakan ternak, dan umumnya ditanam sebagai tanaman rotasi setelah serealia untuk memperkaya tanah melalui kemampuannya mengikat nitrogen. Produksi kacang hijau terutama (90%) berada di Asia: India adalah produsen terbesar dengan lebih dari 50% produksi dunia, tetapi mengonsumsi hampir seluruh produksinya sendiri. Tiongkok memproduksi kacang hijau dalam jumlah besar, yang mewakili 19% dari produksi legumnya."@id ;
    kbr:diserangPenyakit kbr:PenyakitBercakDaunKacangHijau,
        kbr:PenyakitEmbunTepungKacangHijau,
        kbr:PenyakitLayuKacangHijau ;
    kbr:identifierSumber "PLANT_020" ;
    kbr:memilikiFasePertumbuhan kbr:FasePemasakanKacangHijau,
        kbr:FasePembungaanKacangHijau,
        kbr:FasePengisianPolongKacangHijau,
        kbr:FaseVegetatifKacangHijau ;
    kbr:memilikiKondisiTumbuh kbr:KondisiSuhuHangat ;
    kbr:memilikiVarietas kbr:VarietasCamar,
        kbr:VarietasKutilang,
        kbr:VarietasMerpati,
        kbr:VarietasVima1,
        kbr:VarietasVima2,
        kbr:VarietasVima4,
        kbr:VarietasVima5 ;
    kbr:namaIlmiah "Vigna radiata (L.) R. Wilczek" ;
    dcterms:source "Kurasi pakar"@id ;
    rdfs:comment "Nama ilmiah dilengkapi dari Plants of the World Online (Kew) karena tidak tercantum pada sumber utama."@id,
        "Tanaman pangan dalam ruang lingkup knowledge base."@id ;
    rdfs:seeAlso <https://powo.science.kew.org/results?q=Vigna%20radiata> ;
    skos:altLabel "Vigna radiata"@id,
        "kacang hijau"@id ;
    skos:definition "Tanaman pangan legum berumur pendek penghasil biji kacang hijau yang kaya protein."@id ;
    skos:prefLabel "Kacang hijau"@id .

