ns1:Legum a owl:Class ;
    rdfs:label "Legum"@id ;
    rdfs:comment "Hal ini karena patogen *S. rolfsii* memiliki kisaran inang yang luas seperti famili *leguminoceae*, *Cruciferaceae*, *Cucurbitaceae*, tanaman pisang, jeruk, gandum, padi, tebu, bit, keladi, bahkan tanaman rempah (Sumartini, 2012)."@id,
        "Kelompok tanaman pangan legum dalam ruang lingkup."@id ;
    rdfs:subClassOf ns1:TanamanPangan ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:Kedelai ns1:KacangTanah ns1:KacangHijau ) ] ;
    skos:prefLabel "Legum"@id .

ns1:Malai a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Malai"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id,
        "Penyakit blas menjadi salah satu penyakit utama tanaman padi karena dapat menyerang beberapa bagian tanaman seperti daun, buku batang, leher malai, bulir pada, bahkan kolar daun (BBPADI 2015)."@id ;
    skos:prefLabel "Malai"@id .

ns1:PenerapanPengendalianMekanis a ns1:PengendalianMekanis,
