        kbr:BuktiPengendalianPenyakitBercakDaunKacangHijau2,
        kbr:BuktiPengendalianPenyakitBercakDaunKacangHijau3,
        kbr:BuktiPenyakitPenyakitBercakDaunKacangHijau ;
    kbr:dikendalikanDengan kbr:PengaturanJarakTanam,
        kbr:PengaturanKelembapan,
        kbr:PengelolaanGulma,
        kbr:PenggunaanEkstrakTanaman,
        kbr:PenggunaanPestisidaNabati ;
    kbr:dipengaruhiOleh kbr:KelembapanRelatif98100PersenPadaPenyakitBercakDaunKacangHijau,
        kbr:Suhu2530CPadaPenyakitBercakDaunKacangHijau ;
