        ns1:PengamatanBusukAkarDanUmbiUbiKayuPertumbuhanTerhambat ;
    ns1:memilikiReferensi ns1:BukuDOC002 ;
    ns1:menyerangBagian ns1:Akar,
        ns1:Umbi ;
    ns1:menyerangTanaman ns1:UbiKayu ;
