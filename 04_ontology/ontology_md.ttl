    skos:prefLabel "Gejala pada Penyakit kudis (Ubi jalar): Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat..."@id .

ns1:GejalaPenyakitKudisUbiJalar2 a ns1:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Gejala pada Penyakit kudis (Ubi jalar): Sumber inokulum penyakit kudis biasanya berasal dari bahan tanam..."@id ;
    ns1:deskripsiGejala "Sumber inokulum penyakit kudis biasanya berasal dari bahan tanam (setek) yang terinfeksi jamur, penyakit ini menyebar lebih cepat ke tanaman yang sehat percikan air hujan yang disertai angin, lebih banyak terjadi serangan pada musim hujan (Saleh and Rahayuningsih, 2013)."@id ;
    ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalar4 ;
    ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
