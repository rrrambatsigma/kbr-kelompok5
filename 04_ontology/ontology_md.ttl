              rdfs:label "nilai maksimum"@id ;
              skos:prefLabel "nilai maksimum"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#nilaiMin
ns1:nilaiMin rdf:type owl:DatatypeProperty ;
             rdfs:domain ns1:EntitasKBR ,
                         ns1:FaktorLingkungan ,
                         ns1:FaktorRisiko ,
                         ns1:ObservasiLingkungan ;
             rdfs:range xsd:decimal ;
             rdfs:comment "Batas bawah nilai observasi lingkungan."@id ;
             rdfs:label "nilai minimum"@id ;
             skos:prefLabel "nilai minimum"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#nilaiTunggal
ns1:nilaiTunggal rdf:type owl:DatatypeProperty ;
                 rdfs:domain ns1:EntitasKBR ,
                             ns1:FaktorLingkungan ,
                             ns1:FaktorRisiko ,
                             ns1:ObservasiLingkungan ;
                 rdfs:range xsd:decimal ;
                 rdfs:comment "Nilai tunggal observasi lingkungan."@id ;
                 rdfs:label "nilai tunggal"@id ;
                 skos:prefLabel "nilai tunggal"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#operatorNilai
ns1:operatorNilai rdf:type owl:DatatypeProperty ;
                  rdfs:domain ns1:EntitasKBR ,
                              ns1:FaktorLingkungan ,
                              ns1:FaktorRisiko ,
                              ns1:ObservasiLingkungan ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Operator pembanding pada observasi lingkungan."@id ;
                  rdfs:label "operator nilai"@id ;
                  skos:prefLabel "operator nilai"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#satuan
ns1:satuan rdf:type owl:DatatypeProperty ;
           rdfs:domain ns1:EntitasKBR ,
                       ns1:FaktorLingkungan ,
                       ns1:FaktorRisiko ,
                       ns1:ObservasiLingkungan ;
           rdfs:range xsd:string ;
           rdfs:comment "Satuan nilai observasi lingkungan."@id ;
           rdfs:label "satuan"@id ;
           skos:prefLabel "satuan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#tahunTerbit
ns1:tahunTerbit rdf:type owl:DatatypeProperty ;
                rdfs:domain ns1:EntitasKBR ,
                            ns1:Referensi ;
                rdfs:range xsd:integer ;
                rdfs:comment "Tahun publikasi referensi."@id ;
                rdfs:label "tahun terbit"@id ;
                skos:prefLabel "tahun terbit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#tingkatKeparahan
ns1:tingkatKeparahan rdf:type owl:DatatypeProperty ;
                     rdfs:domain ns1:EntitasKBR ,
                                 ns1:Penyakit ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ns1:memilikiGejala ;
                                   owl:someValuesFrom ns1:Gejala
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ns1:menyerangTanaman ;
                                   owl:someValuesFrom ns1:TanamanPangan
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ns1:disebabkanOleh ;
                                   owl:allValuesFrom ns1:Patogen
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ns1:memilikiReferensi ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass ns1:Referensi
                                 ] ;
                     rdfs:range rdf:PlainLiteral ;
                     rdfs:comment "Kategori keparahan penyakit bila tersedia di sumber."@id ;
                     rdfs:label "tingkat keparahan"@id ;
                     skos:prefLabel "tingkat keparahan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#urlReferensi
ns1:urlReferensi rdf:type owl:DatatypeProperty ;
                 rdfs:domain ns1:EntitasKBR ,
                             ns1:Referensi ;
                 rdfs:range xsd:anyURI ;
                 rdfs:comment "Tautan sumber referensi bila tersedia."@id ;
                 rdfs:label "url referensi"@id ;
                 skos:prefLabel "url referensi"@id .


#################################################################
#    Classes
#################################################################

###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BagianTanaman
ns1:BagianTanaman rdf:type owl:Class ;
                  rdfs:subClassOf ns1:EntitasKBR ;
                  owl:disjointWith ns1:BuktiSumber ,
                                   ns1:Diagnosis ,
                                   ns1:FaktorRisiko ,
                                   ns1:FasePertumbuhan ,
                                   ns1:Gejala ,
                                   ns1:GejalaKanonik ,
                                   ns1:Observasi ,
                                   ns1:Patogen ,
                                   ns1:Pengendalian ,
                                   ns1:Penyakit ,
                                   ns1:Referensi ,
                                   ns1:TanamanPangan ,
                                   ns1:Varietas ;
                  rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala atau serangan."@id ,
                               "Penurunan hasil panen umbi ubi kayu ini selain disebabkan oleh faktor penyakit yang menyerang bagian tanaman lainnya dari ubi kayu (daun dan batang), penyakit yang menyerang akar juga akan mempengaruhi pasokan nutrisi tanaman dari tanah untuk pertumbuhan tanaman serta pembentukan umbi akar pada tanaman ubi kayu."@id ;
                  rdfs:label "Bagian Tanaman"@id ;
                  skos:prefLabel "Bagian Tanaman"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Bakteri
ns1:Bakteri rdf:type owl:Class ;
            rdfs:subClassOf ns1:EntitasKBR ,
                            ns1:Patogen ;
            rdfs:comment "Pada tulisan ini akan disajikan penjelasan OPT, khususnya penyakit penting tanaman padi, seperti penyakit hawar daun bakteri, penyakit blas, penyakit hawar pelepah daun, penyakit tungro, serta penyakit kerdil rumput dan kerdil hampa."@id ,
                         "Patogen kelompok bakteri."@id ;
            rdfs:label "Bakteri"@id ;
            skos:prefLabel "Bakteri"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala
ns1:BuktiGejala rdf:type owl:Class ;
                rdfs:subClassOf ns1:BuktiSumber ,
                                ns1:EntitasKBR ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:wasDerivedFrom ;
                                  owl:someValuesFrom ns1:Referensi
                                ] ;
                rdfs:comment "Bukti untuk pengamatan gejala."@id ;
                rdfs:label "Bukti Gejala"@id ;
                skos:prefLabel "Bukti Gejala"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPatogen
ns1:BuktiPatogen rdf:type owl:Class ;
                 rdfs:subClassOf ns1:BuktiSumber ,
                                 ns1:EntitasKBR ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty prov:wasDerivedFrom ;
                                   owl:someValuesFrom ns1:Referensi
                                 ] ;
                 rdfs:comment "Bukti untuk hubungan penyakit-patogen."@id ;
                 rdfs:label "Bukti Patogen"@id ;
                 skos:prefLabel "Bukti Patogen"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian
ns1:BuktiPengendalian rdf:type owl:Class ;
                      rdfs:subClassOf ns1:BuktiSumber ,
                                      ns1:EntitasKBR ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty prov:wasDerivedFrom ;
                                        owl:someValuesFrom ns1:Referensi
                                      ] ;
                      rdfs:comment "Bukti untuk tindakan pengendalian."@id ;
                      rdfs:label "Bukti Pengendalian"@id ;
                      skos:prefLabel "Bukti Pengendalian"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPenyakit
ns1:BuktiPenyakit rdf:type owl:Class ;
                  rdfs:subClassOf ns1:BuktiSumber ,
                                  ns1:EntitasKBR ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty prov:wasDerivedFrom ;
                                    owl:someValuesFrom ns1:Referensi
                                  ] ;
                  rdfs:comment "Bukti untuk pernyataan penyakit."@id ,
                               "Hasil penelitian Sunkad dan Kulkarni (2007) dan Arsule dan Pande (2011), membuktikan penyakit karat banyak terjadi selama bulan September."@id ;
                  rdfs:label "Bukti Penyakit"@id ;
                  skos:prefLabel "Bukti Penyakit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber
ns1:BuktiSumber rdf:type owl:Class ;
                rdfs:subClassOf ns1:EntitasKBR ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty prov:wasDerivedFrom ;
                                  owl:someValuesFrom ns1:Referensi
                                ] ;
                owl:disjointWith ns1:Diagnosis ,
                                 ns1:FaktorRisiko ,
                                 ns1:FasePertumbuhan ,
                                 ns1:Gejala ,
                                 ns1:GejalaKanonik ,
                                 ns1:Observasi ,
                                 ns1:Patogen ,
                                 ns1:Pengendalian ,
                                 ns1:Penyakit ,
                                 ns1:Referensi ,
                                 ns1:TanamanPangan ,
                                 ns1:Varietas ;
                rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
                rdfs:label "Bukti Sumber"@id ;
                skos:prefLabel "Bukti Sumber"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Buku
ns1:Buku rdf:type owl:Class ;
         rdfs:subClassOf ns1:EntitasKBR ,
                         ns1:Referensi ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty ns1:tahunTerbit ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ;
         rdfs:comment "Penyakit blas menjadi salah satu penyakit utama tanaman padi karena dapat menyerang beberapa bagian tanaman seperti daun, buku batang, leher malai, bulir pada, bahkan kolar daun (BBPADI 2015)."@id ,
                      "Referensi berbentuk buku."@id ;
         rdfs:label "Buku"@id ;
         skos:prefLabel "Buku"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#CurahHujan
ns1:CurahHujan rdf:type owl:Class ;
               rdfs:subClassOf ns1:EntitasKBR ,
                               ns1:FaktorLingkungan ,
                               ns1:FaktorRisiko ;
               rdfs:comment "Faktor curah hujan."@id ,
                            "Pengendalian patogen Fusarium spp. dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017)."@id ;
               rdfs:label "Curah Hujan"@id ;
               skos:prefLabel "Curah Hujan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Diagnosis
ns1:Diagnosis rdf:type owl:Class ;
              rdfs:subClassOf ns1:EntitasKBR ;
              owl:disjointWith ns1:FaktorRisiko ,
                               ns1:FasePertumbuhan ,
                               ns1:Gejala ,
                               ns1:GejalaKanonik ,
                               ns1:Observasi ,
                               ns1:Patogen ,
                               ns1:Pengendalian ,
                               ns1:Penyakit ,
                               ns1:Referensi ,
                               ns1:TanamanPangan ,
                               ns1:Varietas ;
              rdfs:comment "Catatan proses diagnosis tanaman."@id ,
                           "Diagnosis and integrated management of fruit rot in Cucurbita argyrosperma, caused by Sclerotium rolfsii."@id ;
              rdfs:label "Diagnosis"@id ;
              skos:prefLabel "Diagnosis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#EntitasKBR
ns1:EntitasKBR rdf:type owl:Class ;
               rdfs:comment "Kelas akar seluruh entitas knowledge base penyakit tanaman pangan."@id ;
               rdfs:label "Entitas KBR"@id ;
               skos:prefLabel "Entitas KBR"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorLahan
ns1:FaktorLahan rdf:type owl:Class ;
                rdfs:subClassOf ns1:EntitasKBR ,
                                ns1:FaktorRisiko ;
                owl:disjointWith ns1:FaktorLingkungan ;
                rdfs:comment "Faktor kondisi lahan."@id ,
                             "Perkembangan penyakit bakteri pustul dipengaruhi oleh faktor suhu dan kelembaban di lahan."@id ;
                rdfs:label "Faktor Lahan"@id ;
                skos:prefLabel "Faktor Lahan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorLingkungan
ns1:FaktorLingkungan rdf:type owl:Class ;
                     rdfs:subClassOf ns1:EntitasKBR ,
                                     ns1:FaktorRisiko ;
                     rdfs:comment "Faktor lingkungan abiotik atau iklim."@id ,
                                  "Selain faktor lingkungan yang menjadi pembatas produksi kedelai, faktor biotik seperti patogen juga menjadi salah satu pembatas menurunnya produksi kedelai."@id ;
                     rdfs:label "Faktor Lingkungan"@id ;
                     skos:prefLabel "Faktor Lingkungan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorRisiko
ns1:FaktorRisiko rdf:type owl:Class ;
                 rdfs:subClassOf ns1:EntitasKBR ;
                 owl:disjointWith ns1:FasePertumbuhan ,
                                  ns1:Gejala ,
                                  ns1:GejalaKanonik ,
                                  ns1:Observasi ,
                                  ns1:Patogen ,
                                  ns1:Pengendalian ,
                                  ns1:Penyakit ,
                                  ns1:Referensi ,
                                  ns1:TanamanPangan ,
                                  ns1:Varietas ;
                 rdfs:comment "Faktor lingkungan, budidaya, atau lahan yang memengaruhi penyakit."@id ;
                 rdfs:label "Faktor Risiko"@id ;
                 skos:prefLabel "Faktor Risiko"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaseAnakan
ns1:FaseAnakan rdf:type owl:Class ;
               rdfs:subClassOf ns1:EntitasKBR ,
                               ns1:FasePertumbuhan ;
               rdfs:comment "Fase anakan."@id ,
                            "Gejala tersebut dapat ditemukan pada padi fase anakan sampai fase matang susu."@id ;
               rdfs:label "Fase Anakan"@id ;
               skos:prefLabel "Fase Anakan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaseGeneratif
ns1:FaseGeneratif rdf:type owl:Class ;
                  rdfs:subClassOf ns1:EntitasKBR ,
                                  ns1:FasePertumbuhan ;
                  rdfs:comment "Bila penyakit menginfeksi tanaman kacang di awal fase generatif, menyebabkan pengurangan pengisian polong."@id ,
                               "Fase pertumbuhan generatif."@id ;
                  rdfs:label "Fase Generatif"@id ;
                  skos:prefLabel "Fase Generatif"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePanen
ns1:FasePanen rdf:type owl:Class ;
              rdfs:subClassOf ns1:EntitasKBR ,
                              ns1:FasePertumbuhan ;
              rdfs:comment "Fase menjelang atau saat panen."@id ,
                           "Patogen dapat menginfeksi dari fase pembibitan hingga panen dan menyebabkan kehilangan hasil mencapai 50-70% (Majid, 2016)."@id ;
              rdfs:label "Fase Panen"@id ;
              skos:prefLabel "Fase Panen"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePemasakan
ns1:FasePemasakan rdf:type owl:Class ;
                  rdfs:subClassOf ns1:EntitasKBR ,
                                  ns1:FasePertumbuhan ;
                  rdfs:comment "Fase pemasakan."@id ,
                               "Pada fase perkecambahan akan berbeda dengan fase pembungaan dan pemasakan di mana suhu untuk perkecambahan kedelai berkisar 15-220C, fase pembentukan bunga suhu optimum berkisar 20-250C, dan fase pemasakan suhu optimumnya berkisar 15-220C (Taufiq and Sundari, 2014)."@id ;
                  rdfs:label "Fase Pemasakan"@id ;
                  skos:prefLabel "Fase Pemasakan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePembibitan
ns1:FasePembibitan rdf:type owl:Class ;
                   rdfs:subClassOf ns1:EntitasKBR ,
                                   ns1:FasePertumbuhan ;
                   rdfs:comment "Adanya patogen tular tanah yang menginfeksi tanaman pada fase pembibitan menjadi permasalahan utama."@id ,
                                "Fase pembibitan."@id ;
                   rdfs:label "Fase Pembibitan"@id ;
                   skos:prefLabel "Fase Pembibitan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePertumbuhan
ns1:FasePertumbuhan rdf:type owl:Class ;
                    rdfs:subClassOf ns1:EntitasKBR ;
                    owl:disjointWith ns1:Gejala ,
                                     ns1:GejalaKanonik ,
                                     ns1:Observasi ,
                                     ns1:Patogen ,
                                     ns1:Pengendalian ,
                                     ns1:Penyakit ,
                                     ns1:Referensi ,
                                     ns1:TanamanPangan ,
                                     ns1:Varietas ;
                    rdfs:comment "Biasanya cendawan C. arachidicola menginfeksi kacang tanah pada fase pertumbuhan yang lebih awal daripada C. personata."@id ,
                                 "Fase pertumbuhan tanaman."@id ;
                    rdfs:label "Fase Pertumbuhan"@id ;
                    skos:prefLabel "Fase Pertumbuhan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaseVegetatif
ns1:FaseVegetatif rdf:type owl:Class ;
                  rdfs:subClassOf ns1:EntitasKBR ,
                                  ns1:FasePertumbuhan ;
                  rdfs:comment "Fase pertumbuhan vegetatif."@id ,
                               "Penyakit bulai menyerang tanaman pada fase vegetatif dan infeksi akan berkurang saat tanaman semakin tua karena semakin dewasa tanaman akan lebih tahan terhadap penyakit bulai (Purwanto et al., 2016)."@id ;
                  rdfs:label "Fase Vegetatif"@id ;
                  skos:prefLabel "Fase Vegetatif"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Fitoplasma
ns1:Fitoplasma rdf:type owl:Class ;
               rdfs:subClassOf ns1:EntitasKBR ,
                               ns1:Patogen ;
               rdfs:comment "Manihotis, serta penyakit-penyakit yang disebabkan oleh virus dan fitoplasma."@id ,
                            "Patogen kelompok fitoplasma."@id ;
               rdfs:label "Fitoplasma"@id ;
               skos:prefLabel "Fitoplasma"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala
ns1:Gejala rdf:type owl:Class ;
           rdfs:subClassOf ns1:EntitasKBR ;
           owl:disjointWith ns1:GejalaKanonik ,
                            ns1:Observasi ,
                            ns1:Patogen ,
                            ns1:Pengendalian ,
                            ns1:Penyakit ,
                            ns1:Referensi ,
                            ns1:TanamanPangan ,
                            ns1:Varietas ;
           rdfs:comment "Gejala khas dari penyakit ini adalah tepi bergelombang atau penggulungan yang terlihat jelas pada helaian daun."@id ,
                        "Pengamatan gejala pada tanaman atau bagian tanaman."@id ;
           rdfs:label "Gejala"@id ;
           skos:prefLabel "Gejala"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkar
ns1:GejalaAkar rdf:type owl:Class ;
               rdfs:subClassOf ns1:EntitasKBR ,
                               ns1:Gejala ;
               rdfs:comment "Gejala yang diamati pada akar."@id ,
                            "Pada tanaman yang terinfeksi *R. solani* akan menunjukkan gejala adanya lekukan coklat dan berkembang menjadi warna hitam pada pangkal akar muda yang terinfeksi (Muslim et al., 2019)."@id ;
               rdfs:label "Gejala Akar"@id ;
               skos:prefLabel "Gejala Akar"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang
ns1:GejalaBatang rdf:type owl:Class ;
                 rdfs:subClassOf ns1:EntitasKBR ,
                                 ns1:Gejala ;
                 rdfs:comment "Gejala yang diamati pada batang."@id ,
                              "Gejala yang muncul setelah benih tumbuh pada permukaan tanah kemudian tanaman mati akibat pangkal batang pada permukaan tanah terdapat bercak coklat akibat terinfeksi patogen (post emergence damping off)."@id ;
                 rdfs:label "Gejala Batang"@id ;
                 skos:prefLabel "Gejala Batang"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBiji
ns1:GejalaBiji rdf:type owl:Class ;
               rdfs:subClassOf ns1:EntitasKBR ,
                               ns1:Gejala ;
               rdfs:comment "Gejala lanjut pada daun dapat menyebabkan bentuk dan warna daun tidak normal, biji mengalami distorsi, perubahan warna dan lesi, pada batang akan nampak gejala dieback, kerdil dan roset, sedangkan pada keseluruhan tanaman menjadi kerdil."@id ,
                            "Gejala yang diamati pada biji."@id ;
               rdfs:label "Gejala Biji"@id ;
               skos:prefLabel "Gejala Biji"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBuah
ns1:GejalaBuah rdf:type owl:Class ;
               rdfs:subClassOf ns1:EntitasKBR ,
                               ns1:Gejala ;
               rdfs:comment "Gejala yang diamati pada buah."@id ,
                            """Infeksi dapat terjadi pada kedua permukaan daun, meskipun infeksi melalui epidermis permukaan daun atas lebih banyak terjadi (Singh 1969). flow_chart: disease cycle diagram

flowchart TD subgraph A A1[\"Batang konidia pada permukaan atas daun\"] --> A2[\"Spora disebarkan oleh angin, percikan air dan serangga\"] A2 --> A3[\"Infeksi didalam jaringan tanaman inang\"] A3 --> A4[\"Miselium tanpa hauspora\"] A4 --> A5[\"Badan buah conidien pada sisi-sisi tanaman\"] A5 --> A6[\"Pseudothecium Mycosphaerella arachidia\"] A6 --> A7[\"Gejala bercak daun awal\"] A7 --> A8[\"Permukaan atas daun\"] A8 --> A1 end subgraph B B1[\"Batang konidia pada permukaan bawah daun\"] --> B2[\"Spora disebarkan oleh angin, percikan air dan serangga\"] B2 --> B3[\"Infeksi dari jaringan tanaman inang\"] B3 --> B4[\"Miselium didalam sel dengan hauspora\"] B4 --> B5[\"Badan buah conidien pada sisi-sisi tanaman\"] B5 --> B6[\"Pseudothecium Mycosphaerella berkoknyi\"] B6 --> B7[\"Gejala bercak daun lambat\"] B7 --> B8[\"Permukaan bawah daun\"] B8 --> B1 end

Gambar 15."""@id ;
               rdfs:label "Gejala Buah"@id ;
               skos:prefLabel "Gejala Buah"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun
ns1:GejalaDaun rdf:type owl:Class ;
               rdfs:subClassOf ns1:EntitasKBR ,
                               ns1:Gejala ;
               rdfs:comment "Gejala khas dari penyakit ini adalah tepi bergelombang atau penggulungan yang terlihat jelas pada helaian daun."@id ,
                            "Gejala yang diamati pada daun."@id ;
               rdfs:label "Gejala Daun"@id ;
               skos:prefLabel "Gejala Daun"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaKanonik
ns1:GejalaKanonik rdf:type owl:Class ;
                  rdfs:subClassOf ns1:EntitasKBR ;
                  owl:disjointWith ns1:Observasi ,
                                   ns1:Patogen ,
                                   ns1:Pengendalian ,
                                   ns1:Penyakit ,
                                   ns1:Referensi ,
                                   ns1:TanamanPangan ,
                                   ns1:Varietas ;
                  rdfs:comment "Konsep gejala kanonik yang dipakai untuk normalisasi pengamatan."@id ;
                  rdfs:label "Gejala Kanonik"@id ;
                  skos:prefLabel "Gejala Kanonik"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaMalai
ns1:GejalaMalai rdf:type owl:Class ;
                rdfs:subClassOf ns1:EntitasKBR ,
                                ns1:Gejala ;
                rdfs:comment "Gejala khas dari penyakit ini, yaitu blas daun dan blas malai."@id ,
                             "Gejala yang diamati pada malai."@id ;
                rdfs:label "Gejala Malai"@id ;
                skos:prefLabel "Gejala Malai"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPolong
ns1:GejalaPolong rdf:type owl:Class ;
                 rdfs:subClassOf ns1:EntitasKBR ,
                                 ns1:Gejala ;
                 rdfs:comment "Gejala juga dapat muncul pada bagian tanaman seperti batang dan polong yang terinfeksi patogen C. cassiicola (López-Cardona et al., 2021)."@id ,
                              "Gejala yang diamati pada polong."@id ;
                 rdfs:label "Gejala Polong"@id ;
                 skos:prefLabel "Gejala Polong"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPucuk
ns1:GejalaPucuk rdf:type owl:Class ;
                rdfs:subClassOf ns1:EntitasKBR ,
                                ns1:Gejala ;
                rdfs:comment "Gejala yang diamati pada pucuk atau tunas."@id ,
                             "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
                rdfs:label "Gejala Pucuk"@id ;
                skos:prefLabel "Gejala Pucuk"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaUmbi
ns1:GejalaUmbi rdf:type owl:Class ;
               rdfs:subClassOf ns1:EntitasKBR ,
                               ns1:Gejala ;
               rdfs:comment "Cassava Brown Streak Disease (CBSD) juga menyebabkan gejala umbi ubi kayu berlekuk-lekuk dan nekrosis pada daging umbinya."@id ,
                            "Gejala yang diamati pada umbi."@id ;
               rdfs:label "Gejala Umbi"@id ;
               skos:prefLabel "Gejala Umbi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Iklim
ns1:Iklim rdf:type owl:Class ;
          rdfs:subClassOf ns1:EntitasKBR ,
                          ns1:FaktorLingkungan ,
                          ns1:FaktorRisiko ;
          rdfs:comment "Faktor iklim umum."@id ,
                       "Kemudian sanitasi dari keberadaan gulma, singgang, dan ceceran gabah yang dapat menjadi inang alternatif bagi patogen maupun vektor, penanaman sistem jajar legowo yang dapat memanipulasi kondisi mikro iklim di bawah kanopi tidak sesuai untuk patogen, pengeringan sawah untuk menekan populasi nimfa wereng hijau."@id ;
          rdfs:label "Iklim"@id ;
          skos:prefLabel "Iklim"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#IntensitasCahaya
ns1:IntensitasCahaya rdf:type owl:Class ;
                     rdfs:subClassOf ns1:EntitasKBR ,
                                     ns1:FaktorLingkungan ,
                                     ns1:FaktorRisiko ;
                     rdfs:comment "Faktor intensitas cahaya."@id ,
                                  "Menurut Sudjono (1979), penjemuran daun kedelai yang terinfeksi di bawah sinar matahari dengan intensitas cahaya 700 lux dapat menurunkan daya kecambah urediospora yang hanya mampu bertahan selama 6 jam, selain itu sinar ultra violet juga menurunkan daya kecambah urediospora."@id ;
                     rdfs:label "Intensitas Cahaya"@id ;
                     skos:prefLabel "Intensitas Cahaya"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Jamur
ns1:Jamur rdf:type owl:Class ;
          rdfs:subClassOf ns1:EntitasKBR ,
                          ns1:Patogen ;
          rdfs:comment "Patogen kelompok jamur."@id ,
                       "Pengendalian menggunakan agens hayati seperti jamur dan bakteri antagonis dapat dilakukan untuk menekan perkembangan penyakit."@id ;
          rdfs:label "Jamur"@id ;
          skos:prefLabel "Jamur"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#JurnalIlmiah
ns1:JurnalIlmiah rdf:type owl:Class ;
                 rdfs:subClassOf ns1:EntitasKBR ,
                                 ns1:Referensi ;
                 rdfs:comment "Referensi berbentuk artikel jurnal."@id ;
                 rdfs:label "Jurnal Ilmiah"@id ;
                 skos:prefLabel "Jurnal Ilmiah"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanTanah
ns1:KelembapanTanah rdf:type owl:Class ;
                    rdfs:subClassOf ns1:EntitasKBR ,
                                    ns1:FaktorLingkungan ,
                                    ns1:FaktorRisiko ;
                    rdfs:comment "Faktor kelembapan tanah."@id ,
                                 "Kelembapan tanah juga mempengaruhi kejadian penyakit di lapang."@id ;
                    rdfs:label "Kelembapan Tanah"@id ;
                    skos:prefLabel "Kelembapan Tanah"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanUdara
ns1:KelembapanUdara rdf:type owl:Class ;
                    rdfs:subClassOf ns1:EntitasKBR ,
                                    ns1:FaktorLingkungan ,
                                    ns1:FaktorRisiko ;
                    rdfs:comment "Apabila kelembapan udara sekitar 95% maka proses penetrasi terjadi selama 6–8 jam."@id ,
                                 "Faktor kelembapan udara."@id ;
                    rdfs:label "Kelembapan Udara"@id ;
                    skos:prefLabel "Kelembapan Udara"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#KetinggianTempat
ns1:KetinggianTempat rdf:type owl:Class ;
                     rdfs:subClassOf ns1:EntitasKBR ,
                                     ns1:FaktorLingkungan ,
                                     ns1:FaktorRisiko ;
                     rdfs:comment "Faktor ketinggian tempat."@id ;
                     rdfs:label "Ketinggian Tempat"@id ;
                     skos:prefLabel "Ketinggian Tempat"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiDrainase
ns1:KondisiDrainase rdf:type owl:Class ;
                    rdfs:subClassOf ns1:EntitasKBR ,
                                    ns1:FaktorLahan ,
                                    ns1:FaktorRisiko ;
                    rdfs:comment "Faktor kondisi drainase lahan."@id ;
                    rdfs:label "Kondisi Drainase"@id ;
                    skos:prefLabel "Kondisi Drainase"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiTanah
ns1:KondisiTanah rdf:type owl:Class ;
                 rdfs:subClassOf ns1:EntitasKBR ,
                                 ns1:FaktorLahan ,
                                 ns1:FaktorRisiko ;
                 rdfs:comment "Faktor kondisi tanah."@id ,
                              "Pada kondisi lembab jamur S. rolfsii dapat berkembang dan menginfeksi bagian daun dan batang tanaman yang berada di dekat tanah."@id ;
                 rdfs:label "Kondisi Tanah"@id ;
                 skos:prefLabel "Kondisi Tanah"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Legum
ns1:Legum rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Class ;
                                owl:oneOf ( ns1:KacangHijau
                                            ns1:KacangTanah
                                            ns1:Kedelai
                                          )
                              ] ;
          rdfs:subClassOf ns1:TanamanPangan ,
                          [ rdf:type owl:Class ;
                            owl:oneOf ( ns1:KacangHijau
                                        ns1:KacangTanah
                                        ns1:Kedelai
                                      )
                          ] ;
          rdfs:comment "Hal ini karena patogen *S. rolfsii* memiliki kisaran inang yang luas seperti famili *leguminoceae*, *Cruciferaceae*, *Cucurbitaceae*, tanaman pisang, jeruk, gandum, padi, tebu, bit, keladi, bahkan tanaman rempah (Sumartini, 2012)."@id ,
                       "Kelompok tanaman pangan legum dalam ruang lingkup."@id ;
          rdfs:label "Legum"@id ;
          skos:prefLabel "Legum"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Musim
ns1:Musim rdf:type owl:Class ;
          rdfs:subClassOf ns1:EntitasKBR ,
                          ns1:FaktorLingkungan ,
                          ns1:FaktorRisiko ;
          rdfs:comment "Faktor musim."@id ,
                       "Lebih lanjut Saleh dan Hardaningsih (1997) menyatakan bahwa pengendalian penyakit bercak daun dan karat dengan tiofanat metil pada kacang tanah yang tahan cukup dua kali dalam musim yaitu pada umur 49 dan 63 hari, sedangkan untuk yang rentan penyemprotan dilakukan setidaknya empat kali."@id ;
          rdfs:label "Musim"@id ;
          skos:prefLabel "Musim"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Observasi
ns1:Observasi rdf:type owl:Class ;
              rdfs:subClassOf ns1:EntitasKBR ;
              owl:disjointWith ns1:Patogen ,
                               ns1:Pengendalian ,
                               ns1:Penyakit ,
                               ns1:Referensi ,
                               ns1:TanamanPangan ,
                               ns1:Varietas ;
              rdfs:comment "Observasi yang menjadi masukan proses diagnosis."@id ;
              rdfs:label "Observasi"@id ;
              skos:prefLabel "Observasi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#ObservasiLingkungan
ns1:ObservasiLingkungan rdf:type owl:Class ;
                        rdfs:subClassOf ns1:EntitasKBR ,
                                        ns1:FaktorLingkungan ,
                                        ns1:FaktorRisiko ;
                        rdfs:comment "Individu observasi kuantitatif atau kualitatif faktor lingkungan."@id ;
                        rdfs:label "Observasi Lingkungan"@id ;
                        skos:prefLabel "Observasi Lingkungan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Oomycete
ns1:Oomycete rdf:type owl:Class ;
             rdfs:subClassOf ns1:EntitasKBR ,
                             ns1:Patogen ;
             rdfs:comment "Patogen kelompok oomycete."@id ;
             rdfs:label "Oomycete"@id ;
             skos:prefLabel "Oomycete"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Patogen
ns1:Patogen rdf:type owl:Class ;
            rdfs:subClassOf ns1:EntitasKBR ;
            owl:disjointWith ns1:Pengendalian ,
                             ns1:Penyakit ,
                             ns1:Referensi ,
                             ns1:TanamanPangan ,
                             ns1:Varietas ;
            rdfs:comment "Organisme penyebab penyakit tanaman."@id ,
                         "Patogen merupakan parasit obligat."@id ;
            rdfs:label "Patogen"@id ;
            skos:prefLabel "Patogen"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian
ns1:Pengendalian rdf:type owl:Class ;
                 rdfs:subClassOf ns1:EntitasKBR ;
                 owl:disjointWith ns1:Penyakit ,
                                  ns1:Referensi ,
                                  ns1:TanamanPangan ,
                                  ns1:Varietas ;
                 rdfs:comment "Pengendalian patogen *S. rolfsii* dengan rotasi atau pergiliran tanaman di lahan kurang efektif."@id ,
                              "Tindakan pengendalian penyakit tanaman."@id ;
                 rdfs:label "Pengendalian"@id ;
                 skos:prefLabel "Pengendalian"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianBiologis
ns1:PengendalianBiologis rdf:type owl:Class ;
                         rdfs:subClassOf ns1:EntitasKBR ,
                                         ns1:Pengendalian ;
                         rdfs:comment "Pengendalian dengan agens hayati atau biopestisida."@id ;
                         rdfs:label "Pengendalian Biologis"@id ;
                         skos:prefLabel "Pengendalian Biologis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianFisik
ns1:PengendalianFisik rdf:type owl:Class ;
                      rdfs:subClassOf ns1:EntitasKBR ,
                                      ns1:Pengendalian ;
                      rdfs:comment "Pengendalian dengan perlakuan fisik seperti panas atau radiasi."@id ;
                      rdfs:label "Pengendalian Fisik"@id ;
                      skos:prefLabel "Pengendalian Fisik"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKimiawi
ns1:PengendalianKimiawi rdf:type owl:Class ;
                        rdfs:subClassOf ns1:EntitasKBR ,
                                        ns1:Pengendalian ;
                        rdfs:comment "Pengendalian dengan bahan kimia atau pestisida."@id ,
                                     "Pengendalian kimiawi dengan fungisida berbahan aktif risiklikol, pyroquilon, iprobenfos, benomyl, isoprothiolane, diclocymet, edifenphos, felimzone, probenazole, karpropamid, fenoxanil dan metominostrobin, dan antibiotik seperti blasticidin, kasugamycin dan dipotassium hidrogen fosfat (DHP) telah dilaporkan dapat mengurangi keparahan penyakit blas."@id ;
                        rdfs:label "Pengendalian Kimiawi"@id ;
                        skos:prefLabel "Pengendalian Kimiawi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis
ns1:PengendalianKulturTeknis rdf:type owl:Class ;
                             rdfs:subClassOf ns1:EntitasKBR ,
                                             ns1:Pengendalian ;
                             rdfs:comment "Menurut Inayati and Yusnawan, (2017) pengendalian penyakit yang disebabkan oleh R. solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian"@id ,
                                          "Pengendalian melalui praktik budidaya."@id ;
                             rdfs:label "Pengendalian Kultur Teknis"@id ;
                             skos:prefLabel "Pengendalian Kultur Teknis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianMekanis
ns1:PengendalianMekanis rdf:type owl:Class ;
                        rdfs:subClassOf ns1:EntitasKBR ,
                                        ns1:Pengendalian ;
                        rdfs:comment "Pengendalian busuk pelepah menurut Chaudhary et al., (2016) dapat dilakukan dengan mekanis seperti pemotongan dua hingga tiga daun bagian bawah tanaman jagung serta melakukan tumpang sari dengan menggunakan tanaman lain."@id ,
                                     "Pengendalian melalui tindakan fisik-mekanis."@id ;
                        rdfs:label "Pengendalian Mekanis"@id ;
                        skos:prefLabel "Pengendalian Mekanis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianTerpadu
ns1:PengendalianTerpadu rdf:type owl:Class ;
                        rdfs:subClassOf ns1:EntitasKBR ,
                                        ns1:Pengendalian ;
                        rdfs:comment "Pengendalian terpadu yang menggabungkan beberapa pendekatan."@id ,
                                     "Upaya tersebut di antaranya menanam varietas unggul, pola bertanam yang tepat dan pengendalian penyakit terpadu."@id ;
                        rdfs:label "Pengendalian Terpadu"@id ;
                        skos:prefLabel "Pengendalian Terpadu"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit
ns1:Penyakit rdf:type owl:Class ;
             rdfs:subClassOf ns1:EntitasKBR ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty ns1:memilikiGejala ;
                               owl:someValuesFrom ns1:Gejala
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty ns1:menyerangTanaman ;
                               owl:someValuesFrom ns1:TanamanPangan
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty ns1:disebabkanOleh ;
                               owl:allValuesFrom ns1:Patogen
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty ns1:memilikiReferensi ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass ns1:Referensi
                             ] ;
             owl:disjointWith ns1:Referensi ,
                              ns1:TanamanPangan ,
                              ns1:Varietas ;
             rdfs:comment "Pada tulisan ini akan disajikan penjelasan OPT, khususnya penyakit penting tanaman padi, seperti penyakit hawar daun bakteri, penyakit blas, penyakit hawar pelepah daun, penyakit tungro, serta penyakit kerdil rumput dan kerdil hampa."@id ,
                          "Penyakit tanaman pangan yang dicatat dalam sumber."@id ;
             rdfs:label "Penyakit"@id ;
             skos:prefLabel "Penyakit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBakteri
ns1:PenyakitBakteri rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( ns1:Penyakit
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty ns1:disebabkanOleh ;
                                                                 owl:someValuesFrom ns1:Bakteri
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf ns1:Penyakit ,
                                    [ owl:intersectionOf ( ns1:Penyakit
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty ns1:disebabkanOleh ;
                                                             owl:someValuesFrom ns1:Bakteri
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                    rdfs:comment "Penyakit yang disebabkan oleh patogen kelompok bakteri."@id ,
                                 "Penyakit yang juga sering menyerang pada tanaman kedelai adalah penyakit bakteri pustul."@id ;
                    rdfs:label "Penyakit Bakteri"@id ;
                    skos:prefLabel "Penyakit Bakteri"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitFitoplasma
ns1:PenyakitFitoplasma rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( ns1:Penyakit
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty ns1:disebabkanOleh ;
                                                                    owl:someValuesFrom ns1:Fitoplasma
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf ns1:Penyakit ,
                                       [ owl:intersectionOf ( ns1:Penyakit
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty ns1:disebabkanOleh ;
                                                                owl:someValuesFrom ns1:Fitoplasma
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                       rdfs:comment "Manihotis, serta penyakit-penyakit yang disebabkan oleh virus dan fitoplasma."@id ,
                                    "Penyakit yang disebabkan oleh patogen kelompok fitoplasma."@id ;
                       rdfs:label "Penyakit Fitoplasma"@id ;
                       skos:prefLabel "Penyakit Fitoplasma"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitJamur
ns1:PenyakitJamur rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( ns1:Penyakit
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ns1:disebabkanOleh ;
                                                               owl:someValuesFrom ns1:Jamur
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf ns1:Penyakit ,
                                  [ owl:intersectionOf ( ns1:Penyakit
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty ns1:disebabkanOleh ;
                                                           owl:someValuesFrom ns1:Jamur
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
                  rdfs:comment "Pengendalian menggunakan agens hayati seperti jamur dan bakteri antagonis dapat dilakukan untuk menekan perkembangan penyakit."@id ,
                               "Penyakit yang disebabkan oleh patogen kelompok jamur."@id ;
                  rdfs:label "Penyakit Jamur"@id ;
                  skos:prefLabel "Penyakit Jamur"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitOomycete
ns1:PenyakitOomycete rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( ns1:Penyakit
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty ns1:disebabkanOleh ;
                                                                  owl:someValuesFrom ns1:Oomycete
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf ns1:Penyakit ,
                                     [ owl:intersectionOf ( ns1:Penyakit
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty ns1:disebabkanOleh ;
                                                              owl:someValuesFrom ns1:Oomycete
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                     rdfs:comment "Penyakit yang disebabkan oleh patogen kelompok oomycete."@id ;
                     rdfs:label "Penyakit Oomycete"@id ;
                     skos:prefLabel "Penyakit Oomycete"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitVirus
ns1:PenyakitVirus rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( ns1:Penyakit
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ns1:disebabkanOleh ;
                                                               owl:someValuesFrom ns1:Virus
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf ns1:Penyakit ,
                                  [ owl:intersectionOf ( ns1:Penyakit
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty ns1:disebabkanOleh ;
                                                           owl:someValuesFrom ns1:Virus
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
                  rdfs:comment "Di Indonesia, penyakit virus belang diketahui telah tersebar luas di sentra tanaman kacang tanah."@id ,
                               "Penyakit yang disebabkan oleh patogen kelompok virus."@id ;
                  rdfs:label "Penyakit Virus"@id ;
                  skos:prefLabel "Penyakit Virus"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PublikasiInstansi
ns1:PublikasiInstansi rdf:type owl:Class ;
                      rdfs:subClassOf ns1:EntitasKBR ,
                                      ns1:Referensi ;
                      rdfs:comment "Referensi terbitan instansi."@id ;
                      rdfs:label "Publikasi Instansi"@id ;
                      skos:prefLabel "Publikasi Instansi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Referensi
ns1:Referensi rdf:type owl:Class ;
              rdfs:subClassOf ns1:EntitasKBR ;
              owl:disjointWith ns1:TanamanPangan ,
                               ns1:Varietas ;
              rdfs:comment "Harapannya buku ini dapat menjadi buku referensi tidak hanya dilingkungan akademis, tetapi juga bagi praktisi pertanian."@id ,
                           "Sumber bibliografis yang mendukung data."@id ;
              rdfs:label "Referensi"@id ;
              skos:prefLabel "Referensi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Serealia
ns1:Serealia rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( ns1:Jagung
                                               ns1:Padi
                                             )
                                 ] ;
             rdfs:subClassOf ns1:TanamanPangan ,
                             [ rdf:type owl:Class ;
                               owl:oneOf ( ns1:Jagung
                                           ns1:Padi
                                         )
                             ] ;
             rdfs:comment "Kelompok tanaman pangan serealia dalam ruang lingkup."@id ,
                          "Pergiliran kacang tanah dengan kapas, kedelai, dan serealia (padi, jagung, sorgum, gandum, tebu) dapat memutus siklus perkembangan R. solanacearum di lahan setempat sehingga mengurangi kejadian penyakit layu."@id ;
             rdfs:label "Serealia"@id ;
             skos:prefLabel "Serealia"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Suhu
ns1:Suhu rdf:type owl:Class ;
         rdfs:subClassOf ns1:EntitasKBR ,
                         ns1:FaktorLingkungan ,
                         ns1:FaktorRisiko ;
         rdfs:comment "Faktor suhu lingkungan."@id ,
                      "Selain itu perlakuan panas kering juga dapat menjadi alternatif lainnya, seperti perlakuan panas kering pada suhu 55oC yang dapat mengeliminasi Pantoea stewartii pada benih jagung (Nalis et al. 2015) ataupun perendaman benih pada air panas 57oC selama 10 menit (Kadir et al. 2009)"@id ;
         rdfs:label "Suhu"@id ;
         skos:prefLabel "Suhu"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#TanamanPangan
ns1:TanamanPangan rdf:type owl:Class ;
                  rdfs:subClassOf ns1:EntitasKBR ;
                  owl:disjointWith ns1:Varietas ;
                  rdfs:comment "Tanaman pangan dalam ruang lingkup knowledge base."@id ,
                               "Tidak hanya di Indonesia, di sebagian besar negara Asia pun padi menjadi tanaman pangan utama."@id ;
                  rdfs:label "Tanaman Pangan"@id ;
                  skos:prefLabel "Tanaman Pangan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#TeksturTanah
ns1:TeksturTanah rdf:type owl:Class ;
                 rdfs:subClassOf ns1:EntitasKBR ,
                                 ns1:FaktorLahan ,
                                 ns1:FaktorRisiko ;
                 rdfs:comment "Faktor tekstur tanah."@id ,
                              "Karakter tanah ideal bagi apel adalah bertekstur sedang, gembur dengan kedalaman efektif lebih dari 50 cm, berdrainase baik dengan pH tanah berkisar 5,5 – 7 (Jackson, 2003)."@id ;
                 rdfs:label "Tekstur Tanah"@id ;
                 skos:prefLabel "Tekstur Tanah"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#UmbiUmbian
ns1:UmbiUmbian rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( ns1:UbiJalar
                                                 ns1:UbiKayu
                                               )
                                   ] ;
               rdfs:subClassOf ns1:TanamanPangan ,
                               [ rdf:type owl:Class ;
                                 owl:oneOf ( ns1:UbiJalar
                                             ns1:UbiKayu
                                           )
                               ] ;
               rdfs:comment "Hasil pengujian 120 genotipe koleksi plasma nutfah kacang tanah di Balai Penelitian Tanaman Kacang- kacangan dan Umbi-umbian, didapatkan satu genotipe yang tahan yaitu Mlg A-0099, tidak ditemukan genotipe agak tahan, 59 genotipe agak rentan, dan 60 genotipe rentan."@id ,
                            "Kelompok tanaman pangan umbi-umbian dalam ruang lingkup."@id ;
               rdfs:label "Umbi-Umbian"@id ;
               skos:prefLabel "Umbi-Umbian"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas
ns1:Varietas rdf:type owl:Class ;
             rdfs:subClassOf ns1:EntitasKBR ;
             rdfs:comment "Pengendalian dengan varietas tahan menjadi salah satu pengendalian yang efektif."@id ,
                          "Varietas tanaman pangan yang disebut sumber."@id ;
             rdfs:label "Varietas"@id ;
             skos:prefLabel "Varietas"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasUnggul
ns1:VarietasUnggul rdf:type owl:Class ;
                   rdfs:subClassOf ns1:EntitasKBR ,
                                   ns1:Varietas ;
                   rdfs:comment "Hampir beberapa varietas unggul kedelai dapat dipatahkan ketahanannya oleh ras patogen yang baru."@id ,
                                "Kategori varietas unggul."@id ;
                   rdfs:label "Varietas Unggul"@id ;
                   skos:prefLabel "Varietas Unggul"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Virus
ns1:Virus rdf:type owl:Class ;
          rdfs:subClassOf ns1:EntitasKBR ,
                          ns1:Patogen ;
          rdfs:comment "Benih sehat bebas virus merupakan awal dari budidaya tanaman sehat bebas virus PStV."@id ,
                       "Patogen kelompok virus."@id ;
          rdfs:label "Virus"@id ;
          skos:prefLabel "Virus"@id .


#################################################################
#    Individuals
#################################################################

###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Akar
ns1:Akar rdf:type owl:NamedIndividual ,
                  ns1:BagianTanaman ,
                  ns1:EntitasKBR ;
         rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id ,
                      "Tanaman akan layu akibat akar tanaman busuk dan terinfeksi patogen kemudian menyebar pada pangkal batang sehingga menyebabkan rebah semai atau rebah kecambah (Gambar 2.3) (Hidayah and Yulianti, 2015)."@id ;
         rdfs:label "Akar"@id ;
         skos:prefLabel "Akar"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#AntraknosaUbiKayuBatang
ns1:AntraknosaUbiKayuBatang rdf:type owl:NamedIndividual ,
                                     ns1:EntitasKBR ,
                                     ns1:Penyakit ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:disebabkanOleh ;
                                       owl:someValuesFrom ns1:Jamur
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:memilikiGejala ;
                                       owl:someValuesFrom ns1:Gejala
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:menyerangTanaman ;
                                       owl:someValuesFrom ns1:TanamanPangan
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:disebabkanOleh ;
                                       owl:allValuesFrom ns1:Patogen
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:memilikiReferensi ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass ns1:Referensi
                                     ] ;
                            ns1:didukungOleh ns1:BuktiPatogenAntraknosaUbiKayuBatang ,
                                             ns1:BuktiPenyakitAntraknosaUbiKayuBatang ;
                            ns1:dipengaruhiOleh ns1:CurahHujanDanKelembapanRelatifPadaAntraknosaUbiKayuBatang ;
                            ns1:disebabkanOleh ns1:CollectothricumGloeosporioides ;
                            ns1:memilikiGejala ns1:GejalaAntraknosaUbiKayuBatangPucukMati ;
                            ns1:memilikiReferensi ns1:BukuDOC002 ;
                            ns1:menyerangBagian ns1:Batang ;
                            ns1:menyerangTanaman ns1:UbiKayu ;
                            ns1:deskripsiPenyakit "Infeksi pada batang akan menimbulkan retakan berupa kanker batang, gejala mati pucuk, dan pucuk atau batang akan patah."@id ;
                            ns1:identifierSumber "DIS_110" ;
                            rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                         "Infeksi pada batang akan menimbulkan retakan berupa kanker batang, gejala mati pucuk, dan pucuk atau batang akan patah."@id ;
                            rdfs:label "Antraknosa"@id ;
                            skos:prefLabel "Antraknosa"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#AntraknosaUbiKayuDaun
ns1:AntraknosaUbiKayuDaun rdf:type owl:NamedIndividual ,
                                   ns1:EntitasKBR ,
                                   ns1:Penyakit ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:disebabkanOleh ;
                                     owl:someValuesFrom ns1:Jamur
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:memilikiGejala ;
                                     owl:someValuesFrom ns1:Gejala
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:menyerangTanaman ;
                                     owl:someValuesFrom ns1:TanamanPangan
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:disebabkanOleh ;
                                     owl:allValuesFrom ns1:Patogen
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:memilikiReferensi ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass ns1:Referensi
                                   ] ;
                          ns1:didukungOleh ns1:BuktiPatogenAntraknosaUbiKayuDaun ,
                                           ns1:BuktiPenyakitAntraknosaUbiKayuDaun ;
                          ns1:dipengaruhiOleh ns1:CurahHujanDanKelembapanRelatifPadaAntraknosaUbiKayuDaun ;
                          ns1:disebabkanOleh ns1:ColletotricumSpp ;
                          ns1:memilikiGejala ns1:GejalaAntraknosaUbiKayuDaunLayuDaun ;
                          ns1:memilikiReferensi ns1:BukuDOC002 ;
                          ns1:menyerangBagian ns1:Daun ;
                          ns1:menyerangTanaman ns1:UbiKayu ;
                          ns1:deskripsiPenyakit "Pada tangkai daun muncul retakan jaringan berupa kanker, infeksi lebih lanjut mengakibatkan tanaman layu yang disertai defoliasi"@id ;
                          ns1:identifierSumber "DIS_031" ;
                          rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                       "Pada tangkai daun muncul retakan jaringan berupa kanker, infeksi lebih lanjut mengakibatkan tanaman layu yang disertai defoliasi"@id ;
                          rdfs:label "Antraknosa"@id ;
                          skos:prefLabel "Antraknosa"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang
ns1:Batang rdf:type owl:NamedIndividual ,
                    ns1:BagianTanaman ,
                    ns1:EntitasKBR ;
           rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id ,
                        "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
           rdfs:label "Batang"@id ;
           skos:prefLabel "Batang"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Begomovirus
ns1:Begomovirus rdf:type owl:NamedIndividual ,
                         ns1:EntitasKBR ,
                         ns1:Patogen ,
                         ns1:Virus ;
                ns1:didukungOleh ns1:BuktiPatogenCassavaMosaicBegomovirusCMBsUbiKayu ,
                                 ns1:BuktiPatogenTanamanKerdilStuntUbiKayu ;
                ns1:menyebabkanPenyakit ns1:CassavaMosaicBegomovirusCMBsUbiKayu ,
                                        ns1:TanamanKerdilStuntUbiKayu ;
                ns1:identifierSumber "PAT_105" ;
                ns1:namaIlmiahPatogen "Begomovirus" ;
                rdfs:comment "Patogen yang tercatat pada sumber."@id ;
                rdfs:label "Begomovirus"@id ;
                skos:prefLabel "Begomovirus"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BelangTanaman
ns1:BelangTanaman rdf:type owl:NamedIndividual ,
                           ns1:EntitasKBR ,
                           ns1:GejalaKanonik ;
                  ns1:merupakanKanonikDari ns1:GejalaPenyakitBelangMottleKacangTanahBelangTanaman ,
                                           ns1:GejalaPenyakitBercakKuningUbiJalarBelangTanaman ,
                                           ns1:GejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiBelangTa ;
                  ns1:kodeGejala "BelangTanaman" ;
                  rdfs:comment "Konsep generik untuk pola belang atau mottle tanpa bagian tanaman eksplisit."@id ;
                  rdfs:label "Belang pada tanaman"@id ;
                  skos:altLabel "belang pada tanaman"@id ;
                  skos:prefLabel "Belang pada tanaman"@id .


