###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanLayuFusariumUbiJalarKlorosisDaun
ns1:PengamatanLayuFusariumUbiJalarKlorosisDaun rdf:type owl:NamedIndividual ,
                                                        ns1:GejalaDaun ;
                                               ns1:didukungOleh ns1:BuktiGejalaLayuFusariumUbiJalar2018MenjelaskanBahwaAwalDitandai ;
                                               ns1:memilikiGejalaKanonik ns1:KlorosisDaun ;
                                               ns1:merupakanGejalaDari ns1:LayuFusariumUbiJalar ;
                                               ns1:terdapatPada ns1:Daun ;
                                               ns1:deskripsiGejala "(2018) menjelaskan bahwa gejala awal ditandai dengan daun yang terinfeksi berwarna kuning pada bagian atas, diikuti menguningnya pada bagian bawah dan lebih cepat pada daun tua."@id ;
                                               rdfs:comment "(2018) menjelaskan bahwa gejala awal ditandai dengan daun yang terinfeksi berwarna kuning pada bagian atas, diikuti menguningnya pada bagian bawah dan lebih cepat pada daun tua."@id ,
                                                            "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
                                               rdfs:label "Klorosis daun pada layu fusarium"@id ;
                                               skos:prefLabel "Klorosis daun pada layu fusarium"@id .


