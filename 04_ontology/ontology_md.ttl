[] a owl:AllDisjointClasses ;
    owl:members ( ns1:FaseVegetatif ns1:FaseGeneratif ns1:FasePembibitan ns1:FaseAnakan ns1:FasePembungaan ns1:FasePemasakan ns1:FasePanen ) .

[] a owl:AllDisjointClasses ;
