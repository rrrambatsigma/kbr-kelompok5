###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBulaiJagungKerdilTanaman
ns1:PengamatanPenyakitBulaiJagungKerdilTanaman rdf:type owl:NamedIndividual ,
                                                        ns1:GejalaBatang ,
                                                        ns1:GejalaDaun ;
