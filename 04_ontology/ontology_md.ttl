        ns1:GejalaPenyakitLayuBakteriKacangTanahLayuDaun,
        ns1:GejalaPenyakitLayuFusariumKedelaiLayuDaun,
        ns1:GejalaPenyakitLayuKacangHijauLayuDaun,
        ns1:GejalaPenyakitLayuStewartJagungLayuDaun,
        ns1:GejalaPenyakitRebahKecambahKedelaiLayuDaun,
        ns1:GejalaPenyakitRebahSemaiKedelaiLayuDaun ;
    rdfs:comment "Konsep kanonik untuk gejala layu pada daun atau tanaman."@id ;
    skos:altLabel "layu daun"@id ;
    skos:prefLabel "Layu daun"@id .

ns1:KlorosisTanaman a ns1:GejalaKanonik,
        owl:NamedIndividual ;
    rdfs:label "Klorosis pada tanaman"@id ;
    ns1:kodeGejala "KlorosisTanaman" ;
    ns1:merupakanKanonikDari ns1:GejalaBusukAkarUbiKayuKlorosisTanaman,
        ns1:GejalaHawarBakteriUbiKayuKlorosisTanaman,
        ns1:GejalaPenyakitBakteriPustulKedelaiKlorosisTanaman,
