ns1:PenyakitKudisUbiJalar a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit kudis"@id ;
    ns1:berkaitanPengendalian ns1:PengelolaanTerpadu,
        ns1:PenggunaanBakterisida,
        ns1:PenggunaanEkstrakTanaman,
