ns1:Musim a owl:Class ;
    rdfs:label "Musim"@id ;
    rdfs:comment "Faktor musim."@id,
        "Lebih lanjut Saleh dan Hardaningsih (1997) menyatakan bahwa pengendalian penyakit bercak daun dan karat dengan tiofanat metil pada kacang tanah yang tahan cukup dua kali dalam musim yaitu pada umur 49 dan 63 hari, sedangkan untuk yang rentan penyemprotan dilakukan setidaknya empat kali."@id ;
    rdfs:subClassOf ns1:FaktorLingkungan ;
    skos:prefLabel "Musim"@id .

