kbr:PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai a kbr:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)"@id ;
    kbr:berkaitanPengendalian kbr:PengaturanJarakTanam,
