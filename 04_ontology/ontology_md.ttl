ns1:SanitasiLahan a ns1:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Sanitasi lahan"@id ;
    ns1:deskripsiPengendalian "Kemudian sanitasi dari keberadaan gulma, singgang, dan ceceran gabah yang dapat menjadi inang alternatif bagi patogen maupun vektor, penanaman sistem jajar legowo yang dapat memanipulasi kondisi mikro iklim di bawah kanopi tidak sesuai untuk patogen, pengeringan sawah untuk menekan populasi nimfa wereng hijau."@id ;
    ns1:didukungOleh ns1:BuktiPengendalianLayuFusariumUbiJalarPengendalianDilakukanAntaranyaSanitasiPenanganan,
        ns1:BuktiPengendalianPenyakitAntraknosaKedelaiCTruncatumBertahanSeresahSakit,
        ns1:BuktiPengendalianPenyakitAntraknosaKedelaiPengendalianDilakukanMelakukanSanitasiLahan,
        ns1:BuktiPengendalianPenyakitBakteriPustulKedelaiPengendalianDilakukanPenggunaanBenihBebas,
        ns1:BuktiPengendalianPenyakitBercakDaunKacangTanahSifatCendawanBertahanHidupPeriode,
        ns1:BuktiPengendalianPenyakitBercakDaunKacangTanahUpayaMengendalikanMelaluiAntaranyaSanitasi,
        ns1:BuktiPengendalianPenyakitBercakKuningUbiJalarPengendalianDilakukanBibitSetekBahan,
        ns1:BuktiPengendalianPenyakitBercakTargetKedelaiCassicolaEradikasiLahanSisaSisa,
        ns1:BuktiPengendalianPenyakitEmbunPalsuDownyMildewKedelaiPengendalianDilakukanMelakukanEradikasiInokulum,
        ns1:BuktiPengendalianPenyakitEmbunTepungPowderyMildewKedelaiMelakukanEradikasiMenjadiInokulum,
        ns1:BuktiPengendalianPenyakitHawarDaunJagungHalKondisiSanitasiBurukBanyaknya,
        ns1:BuktiPengendalianPenyakitHawarDaunJagungPengendalianDilakukanPengelolaanSanitasiLahan,
        ns1:BuktiPengendalianPenyakitKaratDaunJagungTingginyaDisebabkanBuruknyaSanitasiLahan,
        ns1:BuktiPengendalianPenyakitKaratDaunKacangTanahSanitasiLingkunganPertanamanDiperlukanMengantisipasi,
        ns1:BuktiPengendalianPenyakitKerdilRumputDanKerdilHampaPadiKemudianSanitasiKeberadaanGulmaSinggang,
        ns1:BuktiPengendalianPenyakitKudisUbiJalarBatatasKacanganCampuranSanitasiLahan,
        ns1:BuktiPengendalianPenyakitLayuStewartJagungDjaenuddinMuis2018MengatakanPengendalian,
        ns1:BuktiPengendalianPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiAdaTerinfeksiMakaSegeraDilakukan,
        ns1:BuktiPengendalianPenyakitRebahKecambahKedelaiSolaniDilakukanTeknikPengendalianKultur,
        ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiEradikasiInokulumMenjadiTindakanMenekan,
        ns1:BuktiPengendalianPenyakitTungroPadiKemudianSanitasiKeberadaanGulmaSinggang,
        ns1:BuktiPengendalianUmumUbiKayuSelainTindakanPengendalianDilakukanMelalui ;
    ns1:mengendalikanPenyakit ns1:LayuFusariumUbiJalar,
        ns1:PenyakitAntraknosaKedelai,
        ns1:PenyakitBakteriPustulKedelai,
        ns1:PenyakitBercakDaunKacangTanah,
        ns1:PenyakitBercakKuningUbiJalar,
        ns1:PenyakitBercakTargetKedelai,
        ns1:PenyakitEmbunPalsuDownyMildewKedelai,
        ns1:PenyakitEmbunTepungPowderyMildewKedelai,
        ns1:PenyakitHawarDaunJagung,
        ns1:PenyakitKaratDaunJagung,
        ns1:PenyakitKaratDaunKacangTanah,
        ns1:PenyakitKerdilRumputDanKerdilHampaPadi,
        ns1:PenyakitKudisUbiJalar,
        ns1:PenyakitLayuStewartJagung,
        ns1:PenyakitMosaikKedelaiSoybeanMosaicVirusKedelai,
        ns1:PenyakitRebahKecambahKedelai,
        ns1:PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai,
        ns1:PenyakitTungroPadi ;
    ns1:namaPengendalian "Sanitasi lahan"@id ;
    rdfs:comment "Kemudian sanitasi dari keberadaan gulma, singgang, dan ceceran gabah yang dapat menjadi inang alternatif bagi patogen maupun vektor, penanaman sistem jajar legowo yang dapat memanipulasi kondisi mikro iklim di bawah kanopi tidak sesuai untuk patogen, pengeringan sawah untuk menekan populasi nimfa wereng hijau."@id,
        "Tindakan kanonik sanitasi lahan dan sisa tanaman."@id ;
    skos:prefLabel "Sanitasi lahan"@id .

ns1:Patogen a owl:Class ;
    rdfs:label "Patogen"@id ;
    rdfs:comment "Organisme penyebab penyakit tanaman."@id,
        "Patogen merupakan parasit obligat."@id ;
    rdfs:subClassOf ns1:EntitasKBR ;
    owl:disjointWith ns1:BagianTanaman,
        ns1:BuktiSumber,
        ns1:Diagnosis,
        ns1:FaktorRisiko,
        ns1:FasePertumbuhan,
        ns1:Gejala,
        ns1:GejalaKanonik,
        ns1:Observasi,
        ns1:Pengendalian,
        ns1:Penyakit,
        ns1:Referensi,
        ns1:RekomendasiPengendalian,
        ns1:TanamanPangan,
        ns1:Varietas ;
    skos:prefLabel "Patogen"@id .

ns1:Batang a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Batang"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id,
        "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
    skos:prefLabel "Batang"@id .

ns1:BuktiSumber a owl:Class ;
    rdfs:label "Bukti Sumber"@id ;
    rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom ns1:Referensi ],
        ns1:EntitasKBR ;
    owl:disjointWith ns1:BagianTanaman,
        ns1:Diagnosis,
        ns1:FaktorRisiko,
        ns1:FasePertumbuhan,
        ns1:Gejala,
        ns1:GejalaKanonik,
        ns1:Observasi,
        ns1:Patogen,
        ns1:Pengendalian,
        ns1:Penyakit,
        ns1:Referensi,
        ns1:RekomendasiPengendalian,
        ns1:TanamanPangan,
        ns1:Varietas ;
    skos:prefLabel "Bukti Sumber"@id .

ns1:Varietas a owl:Class ;
    rdfs:label "Varietas"@id ;
    rdfs:comment "Pengendalian dengan varietas tahan menjadi salah satu pengendalian yang efektif."@id,
        "Varietas tanaman pangan yang disebut sumber."@id ;
    rdfs:subClassOf ns1:EntitasKBR ;
    owl:disjointWith ns1:BagianTanaman,
        ns1:BuktiSumber,
        ns1:Diagnosis,
        ns1:FaktorRisiko,
        ns1:FasePertumbuhan,
        ns1:Gejala,
        ns1:GejalaKanonik,
        ns1:Observasi,
        ns1:Patogen,
        ns1:Pengendalian,
        ns1:Penyakit,
        ns1:Referensi,
        ns1:RekomendasiPengendalian,
        ns1:TanamanPangan ;
    skos:prefLabel "Varietas"@id .

ns1:BuktiPenyakit a owl:Class ;
    rdfs:label "Bukti Penyakit"@id ;
    rdfs:comment "Bukti untuk pernyataan penyakit."@id,
        "Hasil penelitian Sunkad dan Kulkarni (2007) dan Arsule dan Pande (2011), membuktikan penyakit karat banyak terjadi selama bulan September."@id ;
    rdfs:subClassOf ns1:BuktiSumber ;
    skos:prefLabel "Bukti Penyakit"@id .

ns1:BuktiPatogen a owl:Class ;
    rdfs:label "Bukti Patogen"@id ;
    rdfs:comment "Bukti untuk hubungan penyakit-patogen."@id ;
    rdfs:subClassOf ns1:BuktiSumber ;
    skos:prefLabel "Bukti Patogen"@id .

ns1:BukuDOC005 a ns1:Buku,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Utama Pada Tanaman: Kedelai, Kacang Tanah Dan Kacang Hijau"@id ;
    ns1:dijelaskanDalam ns1:PenyakitAntraknosaKedelai,
        ns1:PenyakitBercakDaunKacangHijau,
        ns1:PenyakitBercakDaunKacangTanah,
        ns1:PenyakitEmbunPalsuDownyMildewKedelai,
        ns1:PenyakitEmbunTepungKacangHijau,
        ns1:PenyakitKaratDaunKacangTanah,
        ns1:PenyakitKaratDaunKedelai,
        ns1:PenyakitLayuKacangHijau ;
    ns1:identifierSumber "DOC005" ;
    ns1:judulReferensi "Penyakit Utama Pada Tanaman: Kedelai, Kacang Tanah Dan Kacang Hijau"@id ;
    ns1:namaPenulis "Sumartini, Emerensiana Uge, Yuliantoro Baliadi" ;
    ns1:tahunTerbit 2020 ;
    rdfs:comment "Referensi buku yang menjadi sumber data."@id ;
    skos:prefLabel "Penyakit Utama Pada Tanaman: Kedelai, Kacang Tanah Dan Kacang Hijau"@id .

ns1:GejalaDaun a owl:Class ;
    rdfs:label "Gejala Daun"@id ;
    rdfs:comment "Gejala khas dari penyakit ini adalah tepi bergelombang atau penggulungan yang terlihat jelas pada helaian daun."@id,
        "Gejala yang diamati pada daun."@id ;
    rdfs:subClassOf ns1:Gejala ;
    skos:prefLabel "Gejala Daun"@id .

ns1:Penyakit a owl:Class ;
    rdfs:label "Penyakit"@id ;
    rdfs:comment "Pada tulisan ini akan disajikan penjelasan OPT, khususnya penyakit penting tanaman padi, seperti penyakit hawar daun bakteri, penyakit blas, penyakit hawar pelepah daun, penyakit tungro, serta penyakit kerdil rumput dan kerdil hampa."@id,
        "Penyakit tanaman pangan yang dicatat dalam sumber."@id ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Patogen ;
            owl:onProperty ns1:disebabkanOleh ],
        [ a owl:Restriction ;
            owl:onProperty ns1:menyerangTanaman ;
            owl:someValuesFrom ns1:TanamanPangan ],
        [ a owl:Restriction ;
            owl:onProperty ns1:memilikiGejala ;
            owl:someValuesFrom ns1:Gejala ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Referensi ;
            owl:onProperty ns1:memilikiReferensi ],
        ns1:EntitasKBR ;
    owl:disjointWith ns1:BagianTanaman,
        ns1:BuktiSumber,
        ns1:Diagnosis,
        ns1:FaktorRisiko,
        ns1:FasePertumbuhan,
        ns1:Gejala,
        ns1:GejalaKanonik,
        ns1:Observasi,
        ns1:Patogen,
        ns1:Pengendalian,
        ns1:Referensi,
        ns1:RekomendasiPengendalian,
        ns1:TanamanPangan,
        ns1:Varietas ;
    skos:prefLabel "Penyakit"@id .

ns1:Daun a ns1:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Daun"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id,
        "Penyakit bercak daun merupakan penyakit tular udara yang disebabkan oleh patogen (Cercospora arachidicola dan C. Personata)."@id ;
    skos:prefLabel "Daun"@id .

ns1:Gejala a owl:Class ;
    rdfs:label "Gejala"@id ;
    rdfs:comment "Gejala khas dari penyakit ini adalah tepi bergelombang atau penggulungan yang terlihat jelas pada helaian daun."@id,
        "Pengamatan gejala pada tanaman atau bagian tanaman."@id ;
    rdfs:subClassOf ns1:EntitasKBR ;
    owl:disjointWith ns1:BagianTanaman,
        ns1:BuktiSumber,
        ns1:Diagnosis,
        ns1:FaktorRisiko,
        ns1:FasePertumbuhan,
        ns1:GejalaKanonik,
        ns1:Observasi,
        ns1:Patogen,
        ns1:Pengendalian,
        ns1:Penyakit,
        ns1:Referensi,
        ns1:RekomendasiPengendalian,
        ns1:TanamanPangan,
        ns1:Varietas ;
    skos:prefLabel "Gejala"@id .

ns1:BuktiGejala a owl:Class ;
    rdfs:label "Bukti Gejala"@id ;
    rdfs:comment "Bukti untuk pengamatan gejala."@id ;
    rdfs:subClassOf ns1:BuktiSumber ;
    skos:prefLabel "Bukti Gejala"@id .

ns1:BuktiPengendalian a owl:Class ;
    rdfs:label "Bukti Pengendalian"@id ;
    rdfs:comment "Bukti untuk tindakan pengendalian."@id ;
    rdfs:subClassOf ns1:BuktiSumber ;
    skos:prefLabel "Bukti Pengendalian"@id .

