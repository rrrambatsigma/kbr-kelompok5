   ns2:propertyPredicate ns1:tahanTerhadap
 ] .

[ ns2:argument1 ns1:d ;
   ns2:argument2 ns1:o ;
   ns2:propertyPredicate ns1:memilikiObservasi
 ] .

[ ns2:argument1 ns1:d ;
   ns2:argument2 ns1:t ;
   ns2:propertyPredicate ns1:memilikiTanaman
 ] .

[ ns2:argument1 ns1:d ;
   ns2:classPredicate ns1:Diagnosis
 ] .

[ ns2:argument1 ns1:d ;
   ns2:argument2 ns1:v ;
   ns2:propertyPredicate ns1:merekomendasikanVarietas
 ] .

[ ns2:argument1 ns1:d ;
   ns2:argument2 ns1:p ;
   ns2:propertyPredicate ns1:menandaiRisikoLingkungan
 ] .

