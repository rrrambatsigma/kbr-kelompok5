kbr:PenyakitHawarDaunJagung a kbr:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Hawar Daun"@id ;
    kbr:berkaitanPengendalian kbr:PengelolaanGulma,
        kbr:PenggunaanAgensHayati,
        kbr:PenggunaanTrichoderma,
        kbr:PenggunaanVarietasTahan,
        kbr:SanitasiLahan ;
    kbr:deskripsiPenyakit "Penyakit hawar daun pada jagung disebabkan oleh jamur patogen Helminthosporium maydis Y. Nisik & C.Miyake (Kuilya et al., 2018; Hamidson, Suwandi and Effendy, 2019) atau Helminthosporium turticum (Pass.) Leonard et Suggs (Faizah, 2017). Koloni Helinthosporium maydis yang ditumbuhkan pada media PDA awalnya berwarna keputihan kusam, coklat pucat, selanjutnya menjadi berwarna coklat agak gelap. Hifanya bersekat dengan sekat agak longgar. Konidia berdinding tipis dan mempunyai 7-10 sekat. Setelah 8 hari ditumbuhkan pada media PDA, panjang diameter mencapai 8.75 cm."@id ;
    kbr:didukungOleh kbr:BuktiMetadataPhasePenyakitHawarDaunJagung,
        kbr:BuktiMetadataSeverityPenyakitHawarDaunJagung,
        kbr:BuktiPatogenPenyakitHawarDaunJagung,
        kbr:BuktiPengendalianPenyakitHawarDaunJagung,
        kbr:BuktiPengendalianPenyakitHawarDaunJagung2,
