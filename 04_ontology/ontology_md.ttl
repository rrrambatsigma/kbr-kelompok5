                                                 ns1:KondisiMusimKemarau ;
                             ns1:disebabkanOleh ns1:PhakopsoraMeibomiae ,
                                                ns1:PhakopsoraPachyrhizi ,
                                                ns1:PhakopsporaPachyrhizi ;
                             ns1:memilikiGejala ns1:PengamatanPenyakitKaratDaunKedelaiAkibatMenyebabkanPenurunanProduksiPolong ,
                                                ns1:PengamatanPenyakitKaratDaunKedelaiBercakDaun ,
                                                ns1:PengamatanPenyakitKaratDaunKedelaiBercakTanaman ,
                                                ns1:PengamatanPenyakitKaratDaunKedelaiDaunKering ,
                                                ns1:PengamatanPenyakitKaratDaunKedelaiDaunRontok ,
                                                ns1:PengamatanPenyakitKaratDaunKedelaiIntensitasBeratPengisianPolong ,
                                                ns1:PengamatanPenyakitKaratDaunKedelaiKlorosisDaun ,
