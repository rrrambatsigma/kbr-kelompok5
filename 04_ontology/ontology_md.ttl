        kbr:PenggunaanVarietasTahan,
        kbr:SanitasiLahan ;
    kbr:dipengaruhiOleh kbr:KelembapanTanah2875PersenPadaLayuFusariumUbiJalar,
        kbr:SuhuInfeksiOptimalPadaLayuFusariumUbiJalar ;
