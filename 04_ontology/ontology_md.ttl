ns1:PengamatanPenyakitBulaiJagungKerdilTanaman a ns1:GejalaBatang,
        ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Kerdil tanaman pada Penyakit Bulai"@id ;
    ns1:deskripsiGejala "Gejala bulai pada tanaman jagung ditandai dengan daun mengalami klorosis sejajar dengan tulang daun, pertumbuhan terhambat (kerdil), berbentuk kipas dan adanya lapisan tepung berwarna putih pada permukaan daun bagian bawah, yang biasanya hanya terlihat di pagi hari."@id ;
