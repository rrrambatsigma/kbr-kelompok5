ns1:PenyakitKudisUbiJalar a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit kudis"@id ;
    ns1:berkaitanPengendalian ns1:PengendalianBatatasMisalnyaJagungPadiKacangKacangan_0235e728,
