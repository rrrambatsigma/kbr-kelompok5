                                                          rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                      ns2:propertyPredicate ns1:memilikiGejalaKanonik ;
                                                                      ns2:argument1 <o> ;
                                                                      ns2:argument2 <g>
                                                                    ] ;
                                                          rdf:rest [ rdf:type ns2:AtomList ;
                                                                     rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                 ns2:propertyPredicate ns1:menyerangTanaman ;
                                                                                 ns2:argument1 <p> ;
                                                                                 ns2:argument2 <t>
                                                                               ] ;
                                                                     rdf:rest [ rdf:type ns2:AtomList ;
                                                                                rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                            ns2:propertyPredicate ns1:memilikiGejala ;
                                                                                            ns2:argument1 <p> ;
                                                                                            ns2:argument2 <gp>
                                                                                          ] ;
                                                                                rdf:rest [ rdf:type ns2:AtomList ;
                                                                                           rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                                                                                                       ns2:propertyPredicate ns1:memilikiGejalaKanonik ;
                                                                                                       ns2:argument1 <gp> ;
                                                                                                       ns2:argument2 <g>
                                                                                                     ] ;
                                                                                           rdf:rest rdf:nil
                                                                                         ]
                                                                              ]
                                                                   ]
                                                        ]
                                             ]
                                  ]
                       ]
            ] ;
   ns2:head [ rdf:type ns2:AtomList ;
              rdf:first [ rdf:type ns2:IndividualPropertyAtom ;
                          ns2:propertyPredicate ns1:menghasilkanPenyakit ;
                          ns2:argument1 <d> ;
                          ns2:argument2 <p>
                        ] ;
              rdf:rest rdf:nil
            ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Tujuan: penyakit kandidat menghasilkan rekomendasi pengendalian spesifik." ;
   rdfs:label "RuleRekomendasiSpesifik" ;
   rdf:type ns2:Imp ;
