        owl:NamedIndividual ;
    rdfs:label "Klorosis pada tanaman"@id ;
    kbr:deskripsiGejala "Gejala pertama muncul 10 hari setelah inokulasi berupa lesio kecil klorotik, selanjutnya lesio semakin meluas hingga diameter 1 - 10 mm berwarna semakin gelap."@id ;
    kbr:didukungOleh kbr:BuktiGejalaPenyakitBercakDaunKacangTanah11,
