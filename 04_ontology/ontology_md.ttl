    ns1:terdapatPada ns1:Daun ;
    rdfs:comment "Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018)."@id,
        "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Bercak daun pada Penyakit bercak kuning"@id .

ns1:PengamatanPenyakitBercakKuningUbiJalarKlorosisDaun a ns1:GejalaDaun,
        ns1:GejalaPucuk,
        owl:NamedIndividual ;
