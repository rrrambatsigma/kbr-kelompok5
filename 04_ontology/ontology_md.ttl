kbr:GejalaLayuFusariumUbiJalarBercakTanaman a kbr:GejalaUmbi,
        owl:NamedIndividual ;
    rdfs:label "Bercak pada tanaman"@id ;
    kbr:deskripsiGejala "Gejala serangan Fusarium pada umbi ubi jalar berupa kanker melingkar permukaan yang minimal memengaruhi jaringan di bawahnya, berwarna coklat pucat sampai kehitaman kering, rerata diameter awalnya 2-4 mm, luka dapat tumbuh dan berkembang menghasilkan area gelap yang lebih luas (Gambar 2A)."@id ;
