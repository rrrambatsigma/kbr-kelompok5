        ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottle5,
        ns1:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleV,
        ns1:BuktiPenyakitPenyakitSamarKacangTunggakCowpeaMildMottleVirus ;
    ns1:dikendalikanDengan ns1:PengaturanJarakTanam,
        ns1:PengaturanWaktuTanam,
        ns1:PenggunaanInsektisida,
        ns1:PenggunaanMulsa,
        ns1:PenggunaanTanamanBukanInang,
        ns1:PenggunaanVarietasTahan,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:CuacaMemengaruhiPopulasiBemisiaTabaciPadaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai ;
