ns1:PengamatanPenyakitKerdilRumputDanKerdilHampaPadiBercakDaun a ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id ;
    ns1:deskripsiGejala "Selain perubahan warna, tampak pula bintik-bintik atau bercak coklat tua pada daun yang bergejala kerdil hampa bila pupuk nitrogen yang diberikan tidak berimbang (Sari, 2019)."@id ;
    ns1:didukungOleh ns1:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSelainPerubahanWarnaTampakPula ;
    ns1:memilikiGejalaKanonik ns1:BercakDaun ;
    ns1:merupakanGejalaDari ns1:PenyakitKerdilRumputDanKerdilHampaPadi ;
    ns1:terdapatPada ns1:Daun ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id,
        "Selain perubahan warna, tampak pula bintik-bintik atau bercak coklat tua pada daun yang bergejala kerdil hampa bila pupuk nitrogen yang diberikan tidak berimbang (Sari, 2019)."@id ;
    skos:prefLabel "Bercak daun pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id .

ns1:PengamatanPenyakitKerdilRumputDanKerdilHampaPadiKerdilTanaman a ns1:GejalaBatang,
        ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Kerdil tanaman pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id ;
    ns1:deskripsiGejala "Gejala yang khas dari penyakit kerdil rumput yaitu kerdil dengan jumlah anakan banyak, bentuk daun pendek dan sempit, bagian batang tumbuh menjadi tegak dan kaku, serta diskolorasi daun (Gambar 1.7)."@id ;
    ns1:didukungOleh ns1:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiKhasRumputJumlahAnakanBentuk,
        ns1:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSelainPerubahanWarnaTampakPula,
        ns1:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSementaraHampaSelainMudaBergigi ;
    ns1:memilikiGejalaKanonik ns1:KerdilTanaman ;
    ns1:merupakanGejalaDari ns1:PenyakitKerdilRumputDanKerdilHampaPadi ;
    ns1:terdapatPada ns1:Batang,
        ns1:Daun ;
    rdfs:comment "Gejala yang khas dari penyakit kerdil rumput yaitu kerdil dengan jumlah anakan banyak, bentuk daun pendek dan sempit, bagian batang tumbuh menjadi tegak dan kaku, serta diskolorasi daun (Gambar 1.7)."@id,
        "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Kerdil tanaman pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id .

ns1:PengamatanPenyakitKerdilRumputDanKerdilHampaPadiKlorosisDaun a ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Klorosis daun pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id ;
    ns1:deskripsiGejala "Sementara itu, gejala penyakit kerdil hampa yaitu selain kerdil, pada tanaman padi yang masih muda daun akan bergigi, tidak rata, klorotik, dan pecah-pecah."@id ;
    ns1:didukungOleh ns1:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSementaraHampaSelainMudaBergigi ;
    ns1:memilikiGejalaKanonik ns1:KlorosisDaun ;
    ns1:merupakanGejalaDari ns1:PenyakitKerdilRumputDanKerdilHampaPadi ;
    ns1:terdapatPada ns1:Daun ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id,
        "Sementara itu, gejala penyakit kerdil hampa yaitu selain kerdil, pada tanaman padi yang masih muda daun akan bergigi, tidak rata, klorotik, dan pecah-pecah."@id ;
    skos:prefLabel "Klorosis daun pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id .

ns1:PengamatanPenyakitKudisUbiJalarBercakDaun a ns1:GejalaBatang,
        ns1:GejalaDaun,
        ns1:GejalaPucuk,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun pada Penyakit kudis"@id ;
    ns1:deskripsiGejala "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
    ns1:didukungOleh ns1:BuktiGejalaPenyakitKudisUbiJalarTimbulAkibatBagianBatangTerdapat ;
    ns1:memilikiGejalaKanonik ns1:BercakDaun ;
    ns1:merupakanGejalaDari ns1:PenyakitKudisUbiJalar ;
    ns1:terdapatPada ns1:Batang,
        ns1:Daun,
        ns1:Pucuk ;
    rdfs:comment "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id,
        "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Bercak daun pada Penyakit kudis"@id .

ns1:PengamatanPenyakitLayuBakteriKacangTanahLayuDaun a ns1:GejalaBiji,
        ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Layu daun pada Penyakit Layu Bakteri"@id ;
    ns1:deskripsiGejala "Gejala awal berupa kelayuan tidak permanen, tanaman segar kembali malam atau pagi hari."@id ;
    ns1:didukungOleh ns1:BuktiGejalaPenyakitLayuBakteriKacangTanahAwalBerupaKelayuanTidakPermanen,
        ns1:BuktiGejalaPenyakitLayuBakteriKacangTanahChinaMenunjukkanBahwaPenularanBerkisar,
        ns1:BuktiGejalaPenyakitLayuBakteriKacangTanahEkspresiSeringKaliTidakStabil,
        ns1:BuktiGejalaPenyakitLayuBakteriKacangTanahGulmaTumbuhBersamaPeranPenting,
        ns1:BuktiGejalaPenyakitLayuBakteriKacangTanahKondisiSistemPerakaranTidakBerfungsi,
        ns1:BuktiGejalaPenyakitLayuBakteriKacangTanahMengeringkanHinggaKadarAirBiji,
        ns1:BuktiGejalaPenyakitLayuBakteriKacangTanahPenyebabRalstoniaSolanacearum,
        ns1:BuktiGejalaPenyakitLayuBakteriKacangTanahSelainMenjadiTempatHidupKomoditas,
        ns1:BuktiGejalaPenyakitLayuBakteriKacangTanahSeringKaliGulmaTerinfeksiTidak,
