kbr:GejalaPenyakitHawarDaunJagungHawarDaun a kbr:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Hawar daun"@id ;
    kbr:deskripsiGejala "Gejala hawar daun mulai terlihat pada umur 25 hari setelah tanam dan biasanya diawali dari daun bagian bawah dan menular ke daun bagian atas."@id ;
