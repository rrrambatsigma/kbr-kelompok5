    ns1:menyerangTanaman ns1:KacangTanah ;
    ns1:namaInggrisPenyakit "Mottle" ;
    rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id,
        "Penyakit belang merupakan penyakit yang disebabkan oleh virus. Virus yang menyerang yaitu Peanut mottle virus (PeMoV) maupun Peanut stripe virus (PStV). Serangga vektor yang membawa virus menginfeksi tanaman kacang tanah adalah Aphids sp. Aphis dengan tipe mulut mencucuk menghisap merupakan vektor PStV yang efisien. Silet Aphis dalam waktu singkat dapat menghisap cairan daun yang berada di jaringan epidermis dan endodermis. Ukuran tubuh yang kecil dan ringan menyebabkan penyebaran hama ini terjadi secara pasif dengan bantuan angin. Secara alami, penyebaran Aphis dapat mencapai 50-100."@id ;
    skos:altLabel "Mottle"@id ;
    skos:prefLabel "Penyakit Belang (Mottle)"@id .

ns1:PenyakitBercakKuningUbiJalar a ns1:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit bercak kuning"@id ;
    ns1:berkaitanPengendalian ns1:KulturMeristem,
        ns1:PengendalianVektor,
        ns1:PenggunaanVarietasTahan,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan,
        ns1:SeleksiBahanTanam ;
    ns1:deskripsiPenyakit "Beberapa virus sudah dilaporkan dapat menginfeksi ubi jalar di antaranya Sweet Potato Feathery Mottle Virus (SPFMV), Sweet Potato Mild Mottle Virus (SPMMV), Sweet Potato Chlorotic Fleck Virus (SPCFV), Sweet Potato Latent Potyvirus (SPLV), Sweet potato virus-6 dan Sweet potato virus-8 (Saleh et al 2015). Informasi terbaru bahwa Sweet potato virus G (SPVG) dilaporkan sudah menginfeksi ubi jalar di Indonesianya, khususnya Tana Toraja (Anjarsari, Suastika and Damayanti, 2013). Informasi penelitian di Indonesia terkait virus pada ubi jalar masih sedikit, namun yang paling dominan adalah serangan SPFMV."@id ;
    ns1:didukungOleh ns1:BuktiPatogenPenyakitBercakKuningUbiJalar,
        ns1:BuktiPatogenPenyakitBercakKuningUbiJalar2,
        ns1:BuktiPatogenPenyakitBercakKuningUbiJalar3,
        ns1:BuktiPengendalianPenyakitBercakKuningUbiJalar,
        ns1:BuktiPengendalianPenyakitBercakKuningUbiJalar2,
        ns1:BuktiPenyakitPenyakitBercakKuningUbiJalar ;
    ns1:dikendalikanDengan ns1:KulturMeristem,
        ns1:PengendalianVektor,
        ns1:PenggunaanVarietasTahan,
        ns1:RotasiTanaman,
        ns1:SanitasiLahan,
        ns1:SeleksiBahanTanam ;
    ns1:dipengaruhiOleh ns1:Suhu2029CPadaPenyakitBercakKuningUbiJalar ;
    ns1:disebabkanOleh ns1:SweetPotatoChloroticFleckVirus,
        ns1:SweetPotatoFeatheryMottleVirus,
        ns1:SweetPotatoMildMottleVirus ;
    ns1:identifierSumber "DIS_026" ;
