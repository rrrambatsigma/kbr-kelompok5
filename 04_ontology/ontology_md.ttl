        ns1:BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelaiSyringaeMajid2016,
        ns1:BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelaiSyringaeMenjadiAwalPengelolaanPerkembangan,
        ns1:BuktiPenyakitPenyakitHawarBakteriBacterialBlightKedelaiBacterialBlight ;
