ns1:PenggunaanFungisida a ns1:PengendalianKimiawi,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan fungisida"@id ;
    ns1:deskripsiPengendalian "Penggunaan benih sehat yang bebas penyakit, dapat pula dilakukan perlakuan benih dengan larutan amonium sulfat maupun larutan garam untuk memisahkan benih yang cukup matang kemudian dilanjutkan dengan desinfeksi benih dengan fungisida Praktik budidaya diperhatikan untuk mencegah padi terinfeksi blas seperti pengaturan pengairan supaya tidak terjadi kekeringan karena padi rentan blas saat kekeringan."@id ;
