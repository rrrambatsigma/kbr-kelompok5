        kbr:BuktiPengendalianPenyakitRebahKecambahKedelai3,
        kbr:BuktiPengendalianPenyakitRebahKecambahKedelai4,
        kbr:BuktiPengendalianPenyakitRebahKecambahKedelai5,
        kbr:BuktiPenyakitPenyakitRebahKecambahKedelai ;
    kbr:dikendalikanDengan kbr:PengairanDanDrainase,
        kbr:PenggunaanAgensHayati,
