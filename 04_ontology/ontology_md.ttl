        ns1:BuktiPengendalianPenyakitHawarPelepahDaunPadi4,
        ns1:BuktiPenyakitPenyakitHawarPelepahDaunPadi ;
    ns1:dikendalikanDengan ns1:PengaturanJarakTanam,
        ns1:PenggunaanAgensHayati,
        ns1:PenggunaanFungisida,
        ns1:PenggunaanPseudomonas,
        ns1:PenggunaanTrichoderma,
        ns1:PengumpulanDanPemusnahan,
        ns1:SanitasiLahan ;
    ns1:dipengaruhiOleh ns1:KelembapanRelatifPadaPenyakitHawarPelepahDaunPadi,
        ns1:SuhuPadaPenyakitHawarPelepahDaunPadi ;
