kbr:PenggunaanBeauveria a kbr:PengendalianBiologis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan Beauveria"@id ;
    kbr:deskripsiPengendalian "Pengendalian wereng coklat dapat dengan penggunaan cendawan entomopatogen seperti Metarhizium dan Beauveria."@id ;
    kbr:didukungOleh kbr:BuktiPengendalianPenyakitKerdilRumputDanKerdilHampaPadi3,
        kbr:BuktiPengendalianPenyakitRebahSemaiKedelai13 ;
