    skos:prefLabel "Bercak daun pada Penyakit Hawar Daun"@id .

ns1:PengamatanPenyakitHawarDaunJagungHawarDaun a ns1:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Hawar daun pada Penyakit Hawar Daun"@id ;
