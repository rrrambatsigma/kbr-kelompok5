                              skos:altLabel "ANTRAKNOSA"@id ;
                              skos:prefLabel "Penyakit Antraknosa"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBakteriPustulKedelai
ns1:PenyakitBakteriPustulKedelai rdf:type owl:NamedIndividual ,
                                          ns1:EntitasKBR ,
                                          ns1:Penyakit ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ns1:disebabkanOleh ;
                                            owl:someValuesFrom ns1:Bakteri
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ns1:memilikiGejala ;
                                            owl:someValuesFrom ns1:Gejala
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ns1:menyerangTanaman ;
                                            owl:someValuesFrom ns1:TanamanPangan
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ns1:disebabkanOleh ;
                                            owl:allValuesFrom ns1:Patogen
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty ns1:memilikiReferensi ;
                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass ns1:Referensi
                                          ] ;
                                 ns1:berkaitanPengendalian ns1:PenggunaanAgensHayati ,
                                                           ns1:PenggunaanBacillus ,
                                                           ns1:PenggunaanBenihSehat ,
                                                           ns1:PenggunaanEkstrakTanaman ,
                                                           ns1:SanitasiLahan ;
                                 ns1:didukungOleh ns1:BuktiPatogenPenyakitBakteriPustulKedelai ,
                                                  ns1:BuktiPengendalianPenyakitBakteriPustulKedelai ,
                                                  ns1:BuktiPengendalianPenyakitBakteriPustulKedelai2 ,
                                                  ns1:BuktiPengendalianPenyakitBakteriPustulKedelai3 ,
                                                  ns1:BuktiPenyakitPenyakitBakteriPustulKedelai ;
                                 ns1:dikendalikanDengan ns1:PenggunaanAgensHayati ,
                                                        ns1:PenggunaanBacillus ,
                                                        ns1:PenggunaanBenihSehat ,
                                                        ns1:PenggunaanEkstrakTanaman ,
                                                        ns1:SanitasiLahan ;
                                 ns1:dipengaruhiOleh ns1:KelembapanTinggiDanDaunBasahPadaPenyakitBakteriPustulKedelai ,
                                                     ns1:SuhuPadaPenyakitBakteriPustulKedelai ;
                                 ns1:disebabkanOleh ns1:XanthomonasAxonopodis ;
                                 ns1:memilikiGejala ns1:GejalaPenyakitBakteriPustulKedelai ,
                                                    ns1:GejalaPenyakitBakteriPustulKedelaiBercakDaun ,
                                                    ns1:GejalaPenyakitBakteriPustulKedelaiBercakTanaman ,
                                                    ns1:GejalaPenyakitBakteriPustulKedelaiDaunRontok ,
                                                    ns1:GejalaPenyakitBakteriPustulKedelaiKlorosisTanaman ;
                                 ns1:memilikiReferensi ns1:BukuDOC002 ;
                                 ns1:menyerangBagian ns1:Daun ;
                                 ns1:menyerangTanaman ns1:Kedelai ;
                                 ns1:deskripsiPenyakit "Penyakit yang juga sering menyerang pada tanaman kedelai adalah penyakit bakteri pustul. Penyakit ini disebabkan oleh patogen Xanthomonas axonopodis pv. glycines. Patogen akan menginfeksi bagian daun tanaman. Gejala yang muncul akibat serangan patogen X. axonopodis pv. glycines diawali dengan adanya bercak-bercak pada bagian daun. Bercak berwarna hijau kekuningan. Kemudian bercak berkembang menjadi berwarna kuning kecokelatan. Pada awal munculnya bercak berukuran kecil. Kemudian pada serangan yang tinggi maka bercak menjadi berukuran besar (Gambar 2.16)."@id ;
                                 ns1:identifierSumber "DIS_017" ;
                                 rdfs:comment "Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber."@id ,
                                              "Penyakit yang juga sering menyerang pada tanaman kedelai adalah penyakit bakteri pustul. Penyakit ini disebabkan oleh patogen Xanthomonas axonopodis pv. glycines. Patogen akan menginfeksi bagian daun tanaman. Gejala yang muncul akibat serangan patogen X. axonopodis pv. glycines diawali dengan adanya bercak-bercak pada bagian daun. Bercak berwarna hijau kekuningan. Kemudian bercak berkembang menjadi berwarna kuning kecokelatan. Pada awal munculnya bercak berukuran kecil. Kemudian pada serangan yang tinggi maka bercak menjadi berukuran besar (Gambar 2.16)."@id ;
                                 rdfs:label "Penyakit Bakteri Pustul"@id ;
                                 skos:prefLabel "Penyakit Bakteri Pustul"@id .


