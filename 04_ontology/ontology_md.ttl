        ns1:BuktiPenyakitPenyakitBusukHitamBlackRotUbiJalar ;
    ns1:dikendalikanDengan ns1:PenggunaanVarietasTahan,
        ns1:PerlakuanKimiaTanah,
        ns1:RotasiTanaman ;
    ns1:dipengaruhiOleh ns1:SuhuLapang2327CPadaPenyakitBusukHitamBlackRotUbiJalar ;
    ns1:disebabkanOleh ns1:CeratocystisFimbriata ;
    ns1:identifierSumber "DIS_027" ;
    ns1:memilikiGejala ns1:GejalaPenyakitBusukHitamBlackRotUbiJalar,
