#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ns1:ArtikelIlmiah
                ns1:Buku
                ns1:JurnalIlmiah
                ns1:PublikasiInstansi
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ns1:Bakteri
                ns1:Fitoplasma
                ns1:Jamur
                ns1:Nematoda
                ns1:Oomycete
                ns1:OrganismeLain
                ns1:Virus
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ns1:FaktorBudidaya
                ns1:FaktorLahan
                ns1:FaktorLingkungan
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ns1:FaseAnakan
                ns1:FaseGeneratif
                ns1:FasePanen
                ns1:FasePemasakan
                ns1:FasePembibitan
                ns1:FasePembungaan
                ns1:FaseVegetatif
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ns1:Legum
                ns1:Serealia
                ns1:UmbiUmbian
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ns1:PengendalianBiologis
                ns1:PengendalianFisik
                ns1:PengendalianKimiawi
                ns1:PengendalianKulturTeknis
                ns1:PengendalianMekanis
                ns1:PengendalianTerpadu
              )
] .


