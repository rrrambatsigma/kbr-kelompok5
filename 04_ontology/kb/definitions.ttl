@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kbr: <http://kbr.kelompok5.org/penyakit-tanaman-pangan#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kbr:AntraknosaUbiKayuBatang kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Antraknosa pada tanaman Ubi kayu, disebabkan oleh Collectothricum gloeosporioides, dengan gejala antara lain Pucuk mati."@id ;
    skos:prefLabel "Anthracnose"@en .

kbr:AntraknosaUbiKayuDaun kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Antraknosa pada tanaman Ubi kayu, disebabkan oleh Colletotricum spp, dengan gejala antara lain Layu daun."@id ;
    skos:prefLabel "Anthracnose"@en .

kbr:BagianTanaman kbr:knowledgeType "class" ;
    skos:definition "Bagian tanaman yang dapat menjadi lokasi gejala atau serangan penyakit."@id .

kbr:BelangTanaman kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "belang"@id,
        "mottle"@id ;
    skos:broader kbr:KategoriPerubahanWarna ;
    skos:definition "Pola belang atau mottle pada jaringan tanaman tanpa bagian tanaman yang spesifik."@id ;
    skos:prefLabel "mottling"@en .

kbr:BercakDaun kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "bercak"@id,
        "lesi daun"@id,
        "noda daun"@id ;
    skos:broader kbr:KategoriNekrosis ;
    skos:definition "Bercak atau noda berwarna berbeda dari jaringan sehat pada daun; dapat berupa lesi kecil, bulat, atau tidak beraturan."@id ;
    skos:prefLabel "leaf spot"@en .

kbr:BercakDaunBaurUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bercak daun baur pada tanaman Ubi kayu, disebabkan oleh Cercospora. viscosae, dengan gejala antara lain Bercak daun."@id ;
    skos:prefLabel "Cassava brown leaf spot"@en .

kbr:BercakDaunCoklatUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bercak daun Coklat pada tanaman Ubi kayu, disebabkan oleh Cercospora henningsii, Cercosporidium henningsii, dengan gejala antara lain Bercak daun."@id ;
    skos:prefLabel "Cassava brown leaf spot"@en .

kbr:BercakDaunPutihUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bercak daun putih pada tanaman Ubi kayu, disebabkan oleh Phaeoramularia manihotis, dengan gejala antara lain Bercak pada tanaman."@id ;
    skos:prefLabel "Cassava white leaf spot"@en .

kbr:Biji kbr:knowledgeType "part" ;
    kbr:partParent kbr:Buah,
        kbr:Malai,
        kbr:Polong ;
    skos:altLabel "benih"@id,
        "biji"@id ;
    skos:definition "Unit perbanyakan tanaman yang terbentuk di dalam buah, polong, atau malai; dapat menunjukkan gejala bercak atau perubahan warna."@id ;
    skos:prefLabel "seed"@en .

kbr:BusukAkar kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "busuk perakaran"@id ;
    skos:broader kbr:KategoriPembusukan ;
    skos:definition "Jaringan akar membusuk, berwarna coklat sampai hitam, sehingga penyerapan air dan hara terganggu."@id ;
    skos:prefLabel "root rot"@en .

kbr:BusukAkarDanUmbiUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Busuk akar dan umbi pada tanaman Ubi kayu, disebabkan oleh Botryodiplodia spp, Diplodia spp, Phytophthora spp, Sclerotium rolfsii, dengan gejala antara lain Busuk akar, Pertumbuhan terhambat."@id ;
    skos:prefLabel "Cassava root and tuber rot"@en .

kbr:BusukAkarUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Busuk akar pada tanaman Ubi kayu, disebabkan oleh Polyporus sulphureus, dengan gejala antara lain Busuk akar, Busuk batang, Busuk buah, Klorosis pada tanaman."@id ;
    skos:prefLabel "Cassava root rot"@en .

kbr:BusukBatang kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "busuk pangkal batang"@id,
        "busuk pelepah"@id ;
    skos:broader kbr:KategoriPembusukan ;
    skos:definition "Jaringan batang atau pelepah membusuk, berwarna coklat sampai hitam, dan dapat menyebabkan tanaman rebah atau mati."@id ;
    skos:prefLabel "stem rot"@en .

kbr:BusukBuah kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "busuk buah"@id ;
    skos:broader kbr:KategoriPembusukan ;
    skos:definition "Jaringan buah membusuk, biasanya berair, berwarna coklat, dan dapat disertai miselium atau bau."@id ;
    skos:prefLabel "fruit rot"@en .

kbr:BusukPangkalBatangUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Busuk pangkal batang pada tanaman Ubi kayu, disebabkan oleh Botryodiplodia spp, Diplodia spp, Fusarium spp, Phytophthora spp, Sclerotium rolfsii, dengan gejala antara lain Busuk batang, Layu daun."@id ;
    skos:prefLabel "Cassava stem base rot"@en .

kbr:BusukTanaman kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "busuk"@id,
        "pembusukan"@id ;
    skos:broader kbr:KategoriPembusukan ;
    skos:definition "Pembusukan jaringan tanaman tanpa bagian tanaman yang spesifik."@id ;
    skos:prefLabel "rot"@en .

kbr:BusukUmbiUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Busuk Umbi pada tanaman Ubi kayu, disebabkan oleh Fusarium spp, dengan gejala antara lain Busuk pada tanaman, Layu daun."@id ;
    skos:prefLabel "Cassava tuber rot"@en .

kbr:CassavaBrownStreakDiseaseCBSDUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Cassava Brown Streak Disease (CBSD) pada tanaman Ubi kayu, disebabkan oleh Ipomovirus, dengan gejala antara lain Bercak daun, Klorosis daun."@id ;
    skos:prefLabel "Cassava brown streak disease"@en .

kbr:CassavaMosaicBegomovirusCMBsUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Cassava Mosaic Begomovirus (CMBs) pada tanaman Ubi kayu, disebabkan oleh Begomovirus, dengan gejala antara lain Klorosis daun, Mosaik daun."@id ;
    skos:prefLabel "Cassava mosaic disease"@en .

kbr:Daun kbr:knowledgeType "part" ;
    kbr:partParent kbr:Pucuk ;
    skos:altLabel "daun"@id ;
    skos:definition "Organ fotosintesis tanaman; tempat munculnya gejala seperti klorosis, bercak, hawar, atau lapisan tepung."@id ;
    skos:prefLabel "leaf"@en .

kbr:DaunBerlubang kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "lubang daun"@id ;
    skos:broader kbr:KategoriNekrosis ;
    skos:definition "Daun berlubang akibat kerusakan jaringan, sering karena serangan hama atau patogen."@id ;
    skos:prefLabel "leaf perforation"@en .

kbr:DaunKering kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "daun mengering"@id ;
    skos:broader kbr:KategoriNekrosis ;
    skos:definition "Daun mengering, rapuh, dan berwarna coklat akibat kehilangan air atau kerusakan jaringan."@id ;
    skos:prefLabel "leaf drying"@en .

kbr:FaseAnakan kbr:knowledgeType "phase" ;
    kbr:urutanFase 3 ;
    skos:altLabel "anakan"@id,
        "pembentukan anakan"@id ;
    skos:definition "Tahap pembentukan tunas atau anakan, terutama pada tanaman seperti padi."@id ;
    skos:prefLabel "tillering stage"@en .

kbr:FaseGeneratif kbr:knowledgeType "phase" ;
    kbr:urutanFase 4 ;
    skos:altLabel "fase reproduktif"@id,
        "generatif"@id ;
    skos:definition "Tahap pembentukan bunga, buah, biji, polong, atau umbi yang menentukan hasil panen."@id ;
    skos:prefLabel "generative stage"@en .

kbr:FaseMatang kbr:knowledgeType "phase" ;
    skos:altLabel "matang"@id ;
    skos:definition "Tahap buah atau biji mencapai kematangan."@id ;
    skos:prefLabel "mature stage"@en .

kbr:FasePanen kbr:knowledgeType "phase" ;
    kbr:urutanFase 6 ;
    skos:altLabel "panen"@id ;
    skos:definition "Tahap tanaman siap dipanen."@id ;
    skos:prefLabel "harvest stage"@en .

kbr:FasePemasakan kbr:knowledgeType "phase" ;
    kbr:urutanFase 5 ;
    skos:altLabel "pemasakan"@id,
        "pematangan"@id ;
    skos:definition "Tahap pengisian dan pematangan biji, buah, atau umbi."@id ;
    skos:prefLabel "ripening stage"@en .

kbr:FasePembentukanPolong kbr:knowledgeType "phase" ;
    skos:altLabel "pembentukan polong"@id ;
    skos:definition "Tahap pembentukan polong setelah pembungaan."@id ;
    skos:prefLabel "pod formation stage"@en .

kbr:FasePembibitan kbr:knowledgeType "phase" ;
    kbr:urutanFase 1 ;
    skos:altLabel "pembibitan"@id,
        "pesemaian"@id ;
    skos:definition "Tahap awal pertumbuhan sejak benih disemai atau ditanam hingga bibit siap dipindah ke lahan; fokus pada perkecambahan dan pembentukan akar, batang, serta daun muda."@id ;
    skos:prefLabel "nursery stage"@en .

kbr:FasePembibitanTanaman kbr:phaseNext kbr:FaseVegetatifUmum .

kbr:FasePembungaan kbr:knowledgeType "phase" ;
    skos:altLabel "berbunga"@id,
        "pembungaan"@id ;
    skos:definition "Tahap munculnya bunga dan berlangsungnya penyerbukan."@id ;
    skos:prefLabel "flowering stage"@en .

kbr:FasePengisianPolong kbr:knowledgeType "phase" ;
    skos:altLabel "pengisian polong"@id ;
    skos:definition "Tahap pengisian biji di dalam polong."@id ;
    skos:prefLabel "pod filling stage"@en .

kbr:FasePertumbuhan kbr:knowledgeType "class" ;
    skos:definition "Tahap perkembangan tanaman yang dapat menjadi periode rentan penyakit."@id .

kbr:FaseVegetatif kbr:knowledgeType "phase" ;
    kbr:urutanFase 2 ;
    skos:altLabel "pertumbuhan vegetatif"@id,
        "vegetatif"@id ;
    skos:definition "Tahap pertumbuhan akar, batang, dan daun sebelum tanaman memasuki pembungaan atau pembuahan."@id ;
    skos:prefLabel "vegetative stage"@en .

kbr:GejalaKanonik kbr:knowledgeType "class" ;
    skos:definition "Konsep gejala yang dipakai untuk normalisasi pengamatan gejala dari sumber."@id .

kbr:HawarBakteriUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Hawar bakteri pada tanaman Ubi kayu, disebabkan oleh Xanthomonas campestris pv. Manihotis, dengan gejala antara lain Klorosis pada tanaman, Pucuk mati."@id ;
    skos:prefLabel "Bacterial blight"@en .

kbr:HawarDaun kbr:knowledgeType "symptom" ;
    dcterms:source "Glosarium DOC006: Hawar"@id ;
    skos:altLabel "blight daun"@id,
        "hawar"@id ;
    skos:broader kbr:KategoriNekrosis ;
    skos:definition "Kematian jaringan daun yang meluas cepat, biasanya dimulai dari tepi atau ujung daun sehingga daun tampak coklat dan kering."@id ;
    skos:prefLabel "leaf blight"@en .

kbr:HawarDaunBakteriUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Hawar daun bakteri pada tanaman Ubi kayu, disebabkan oleh Xanthomonas Campestrispv. Manihotis, dengan gejala antara lain Bercak daun, Daun rontok, Hawar daun, Layu daun."@id ;
    skos:prefLabel "Bacterial leaf blight"@en .

kbr:Jagung kbr:knowledgeType "plant" ;
    skos:altLabel "Zea mays"@id,
        "jagung"@id ;
    skos:definition "Tanaman pangan serealia penghasil tongkol jagung yang digunakan sebagai bahan pangan dan pakan."@id .

kbr:KacangHijau kbr:knowledgeType "plant" ;
    skos:altLabel "Vigna radiata"@id,
        "kacang hijau"@id ;
    skos:definition "Tanaman pangan legum berumur pendek penghasil biji kacang hijau yang kaya protein."@id .

kbr:KacangTanah kbr:knowledgeType "plant" ;
    skos:altLabel "Arachis hypogaea"@id,
        "kacang tanah"@id ;
    skos:definition "Tanaman pangan legum penghasil biji kacang tanah yang dibudidayakan untuk pangan dan industri."@id .

kbr:KarantinaTanaman kbr:knowledgeType "control" ;
    skos:definition "Mengisolasi tanaman atau bahan tanam yang terinfeksi untuk mencegah penyebaran penyakit."@id .

kbr:Kedelai kbr:knowledgeType "plant" ;
    skos:altLabel "Glycine max"@id,
        "kedelai"@id ;
    skos:definition "Tanaman pangan legum penghasil biji kedelai yang kaya protein, dibudidayakan sebagai tanaman pangan dan bahan baku olahan."@id .

kbr:KematianTanaman kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "benih mati"@id,
        "tanaman mati"@id ;
    skos:broader kbr:KategoriNekrosis ;
    skos:definition "Tanaman atau benih mati, tidak tumbuh, atau tidak berkecambah."@id ;
    skos:prefLabel "plant death"@en .

kbr:KlorosisDaun kbr:knowledgeType "symptom" ;
    dcterms:source "Glosarium DOC006: Klorosis"@id ;
    skos:altLabel "daun menguning"@id,
        "klorotik"@id ;
    skos:broader kbr:KategoriPerubahanWarna ;
    skos:definition "Kurang berkembangnya klorofil pada daun; bagian yang semula hijau tua berubah menjadi hijau muda, kuning, atau putih."@id ;
    skos:prefLabel "chlorosis"@en .

kbr:KlorosisTanaman kbr:knowledgeType "symptom" ;
    dcterms:source "Glosarium DOC006: Klorosis"@id ;
    skos:altLabel "klorotik"@id,
        "menguning"@id ;
    skos:broader kbr:KategoriPerubahanWarna ;
    skos:definition "Klorosis pada jaringan tanaman tanpa bagian tanaman yang spesifik."@id ;
    skos:prefLabel "chlorosis"@en .

kbr:KondisiCurahHujanRendah kbr:knowledgeType "environment" ;
    skos:definition "Curah hujan rendah yang mengurangi percikan air dan penyebaran patogen."@id .

kbr:KondisiCurahHujanTinggi kbr:knowledgeType "environment" ;
    skos:definition "Curah hujan tinggi yang meningkatkan percikan air dan penyebaran patogen."@id .

kbr:KondisiKelembapanRendah kbr:knowledgeType "environment" ;
    skos:definition "Kelembapan udara rendah yang dapat menekan perkecambahan spora dan infeksi patogen."@id .

kbr:KondisiKelembapanTinggi kbr:knowledgeType "environment" ;
    skos:definition "Kelembapan udara tinggi yang mendukung perkecambahan spora dan infeksi patogen."@id .

kbr:KondisiMusimHujan kbr:knowledgeType "environment" ;
    skos:definition "Musim hujan dengan curah hujan dan kelembapan tinggi yang mendukung perkembangan penyakit."@id .

kbr:KondisiMusimKemarau kbr:knowledgeType "environment" ;
    skos:definition "Musim kemarau dengan curah hujan rendah yang dapat menekan atau mengubah pola penyakit."@id .

kbr:KondisiSuhuRendah kbr:knowledgeType "environment" ;
    skos:definition "Suhu udara rendah yang dapat mendukung perkembangan patogen tertentu."@id .

kbr:KondisiSuhuTinggi kbr:knowledgeType "environment" ;
    skos:definition "Suhu udara tinggi yang dapat mendukung atau menekan perkembangan patogen tertentu."@id .

kbr:Kresek kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "hawar daun bakteri"@id,
        "kresek"@id ;
    skos:broader kbr:KategoriNekrosis ;
    skos:definition "Gejala kresek pada daun padi berupa daun menguning, menggulung, dan mengering akibat hawar daun bakteri."@id ;
    skos:prefLabel "kresek"@en .

kbr:KulturMeristem kbr:knowledgeType "control" ;
    skos:definition "Memperbanyak jaringan meristem untuk memperoleh bahan tanam bebas virus."@id .

kbr:LayuDaun kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "kelayuan"@id,
        "layu"@id ;
    skos:broader kbr:KategoriPertumbuhan ;
    skos:definition "Daun atau tanaman kehilangan turgor sehingga menggantung atau lemas, sering akibat gangguan pada akar atau pembuluh."@id ;
    skos:prefLabel "wilting"@en .

kbr:LayuFusariumUbiJalar kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit layu fusarium pada tanaman Ubi jalar, disebabkan oleh Fusarium oxysporum, dengan gejala antara lain Bercak pada tanaman, Busuk pada tanaman, Kematian tanaman, Kerdil tanaman."@id ;
    skos:prefLabel "Fusarium wilt"@en .

kbr:LekukanPangkalAkar kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "lekukan pangkal akar"@id ;
    skos:broader kbr:KategoriNekrosis ;
    skos:definition "Lekukan berwarna coklat atau hitam pada pangkal akar."@id ;
    skos:prefLabel "root collar depression"@en .

kbr:MalaiKosong kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "bulir hampa"@id,
        "malai hampa"@id ;
    skos:broader kbr:KategoriPertumbuhan ;
    skos:definition "Malai tidak terisi bulir atau bulir hampa sehingga malai tampak kosong."@id ;
    skos:prefLabel "empty panicle"@en .

kbr:MalaiPatah kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "patah malai"@id ;
    skos:broader kbr:KategoriKelainanBentuk ;
    skos:definition "Malai patah karena tidak mampu menopang bulir."@id ;
    skos:prefLabel "panicle breakage"@en .

kbr:MiseliumPadaTanaman kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "miselia"@id,
        "miselium"@id ;
    skos:broader kbr:KategoriLainnya ;
    skos:definition "Tanda miselium jamur berupa lapisan atau benang putih pada jaringan tanaman."@id ;
    skos:prefLabel "mycelium"@en .

kbr:MosaikDaun kbr:knowledgeType "symptom" ;
    dcterms:source "Glosarium DOC006: Mosaik"@id ;
    skos:altLabel "belang daun"@id,
        "mosaik"@id,
        "mottle"@id ;
    skos:broader kbr:KategoriPerubahanWarna ;
    skos:definition "Pola belang hijau tua dan hijau muda pada daun akibat terganggunya pembentukan klorofil; bentuk daun dapat sedikit berubah."@id ;
    skos:prefLabel "mosaic"@en .

kbr:NekrosisDaun kbr:knowledgeType "symptom" ;
    dcterms:source "Glosarium DOC006: Nekrosis"@id ;
    skos:altLabel "jaringan daun mati"@id,
        "nekrotik daun"@id ;
    skos:broader kbr:KategoriNekrosis ;
    skos:definition "Kematian jaringan daun setempat, tampak coklat, kering, atau menghitam."@id ;
    skos:prefLabel "leaf necrosis"@en .

kbr:NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Nekrosis pada titik tunas (Cassava bud necrosis) pada tanaman Ubi kayu, disebabkan oleh Fungi/Jamur, dengan gejala antara lain Bercak pada tanaman, Nekrosis pada tanaman."@id ;
    skos:prefLabel "Cassava bud necrosis"@en .

kbr:NekrosisTanaman kbr:knowledgeType "symptom" ;
    dcterms:source "Glosarium DOC006: Nekrosis"@id ;
    skos:altLabel "nekrosis"@id,
        "nekrotik"@id ;
    skos:broader kbr:KategoriNekrosis ;
    skos:definition "Kematian jaringan tanaman setempat tanpa bagian tanaman yang spesifik."@id ;
    skos:prefLabel "necrosis"@en .

kbr:OverrideSYM_020 kbr:knowledgeType "override" ;
    kbr:nonGejala true ;
    kbr:sourceId "SYM_020" .

kbr:OverrideSYM_032 kbr:canonicalGejala kbr:PertumbuhanAbnormal ;
    kbr:knowledgeType "override" ;
    kbr:sourceId "SYM_032" .

kbr:OverrideSYM_034 kbr:knowledgeType "override" ;
    kbr:nonGejala true ;
    kbr:sourceId "SYM_034" .

kbr:OverrideSYM_046 kbr:knowledgeType "override" ;
    kbr:nonGejala true ;
    kbr:sourceId "SYM_046" .

kbr:OverrideSYM_051 kbr:knowledgeType "override" ;
    kbr:nonGejala true ;
    kbr:sourceId "SYM_051" .

kbr:OverrideSYM_055 kbr:knowledgeType "override" ;
    kbr:nonGejala true ;
    kbr:sourceId "SYM_055" .

kbr:OverrideSYM_059 kbr:knowledgeType "override" ;
