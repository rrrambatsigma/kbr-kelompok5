kbr:Padi kbr:knowledgeType "plant" ;
    skos:altLabel "Oryza sativa"@id,
        "padi"@id ;
    skos:definition "Tanaman pangan serealia penghasil beras yang dibudidayakan di lahan sawah atau lahan kering."@id .

kbr:PanenTepatWaktu kbr:knowledgeType "control" ;
    skos:definition "Melakukan panen pada waktu yang dianjurkan untuk mengurangi kehilangan hasil dan infeksi pascapanen."@id .

kbr:Patogen kbr:knowledgeType "class" ;
    skos:definition "Organisme penyebab penyakit tanaman, seperti jamur, bakteri, virus, atau oomycete."@id .

kbr:PemangkasanTanaman kbr:knowledgeType "control" ;
    skos:definition "Memangkas bagian tanaman yang tidak produktif atau terserang untuk mengurangi sumber infeksi."@id .

kbr:PembersihanAlat kbr:knowledgeType "control" ;
    skos:definition "Membersihkan dan mensterilkan alat pertanian agar tidak menyebarkan patogen."@id .

kbr:PemupukanBerimbang kbr:knowledgeType "control" ;
    skos:definition "Memberikan pupuk secara berimbang sesuai kebutuhan hara tanaman agar tanaman lebih tahan terhadap penyakit."@id .

kbr:PencabutanTanaman kbr:knowledgeType "control" ;
    skos:definition "Mencabut dan membuang tanaman yang terserang agar tidak menjadi sumber infeksi."@id .

kbr:PenerapanKulturTeknis kbr:knowledgeType "control" ;
    skos:definition "Menerapkan praktik budidaya yang mendukung kesehatan tanaman, seperti pengolahan tanah, pemupukan, dan pengaturan tanam."@id .

kbr:PenerapanPengendalianBiologis kbr:knowledgeType "control" ;
    skos:definition "Menerapkan pengendalian biologis dengan memanfaatkan musuh alami atau agens antagonis secara terjadwal."@id .

kbr:PenerapanPengendalianFisik kbr:knowledgeType "control" ;
    skos:definition "Menerapkan pengendalian fisik seperti perlakuan panas, radiasi, atau pengaturan suhu."@id .

kbr:PenerapanPengendalianKimiawi kbr:knowledgeType "control" ;
    skos:definition "Menerapkan pengendalian kimiawi dengan pestisida sesuai sasaran dan dosis anjuran."@id .

kbr:PenerapanPengendalianMekanis kbr:knowledgeType "control" ;
    skos:definition "Menerapkan pengendalian mekanis dengan tindakan fisik seperti pencabutan, pemangkasan, atau pengumpulan bagian terserang."@id .

kbr:PengairanDanDrainase kbr:knowledgeType "control" ;
    skos:definition "Mengatur irigasi dan drainase untuk menjaga kelembapan lahan pada tingkat yang tidak mendukung patogen."@id .

kbr:PengaturanJarakTanam kbr:knowledgeType "control" ;
    skos:definition "Mengatur jarak atau kerapatan tanam agar sirkulasi udara dan cahaya lebih baik."@id .

kbr:PengaturanKelembapan kbr:knowledgeType "control" ;
    skos:definition "Mengatur kelembapan dan sirkulasi udara di sekitar tanaman atau ruang penyimpanan."@id .

kbr:PengaturanSuhuPenyimpanan kbr:knowledgeType "control" ;
    skos:definition "Mengatur suhu ruang penyimpanan agar perkembangan patogen pascapanen terhambat."@id .

kbr:PengaturanWaktuTanam kbr:knowledgeType "control" ;
    skos:definition "Mengatur waktu tanam agar tanaman terhindar dari periode tekanan penyakit atau vektor."@id .

kbr:PengelolaanGulma kbr:knowledgeType "control" ;
    skos:definition "Mengendalikan gulma yang dapat menjadi inang alternatif atau pesaing tanaman."@id .

kbr:PengelolaanTerpadu kbr:knowledgeType "control" ;
    skos:definition "Menerapkan pengelolaan penyakit secara terpadu dengan beberapa komponen teknologi."@id .

kbr:Pengendalian kbr:knowledgeType "class" ;
    skos:definition "Tindakan yang direkomendasikan untuk menekan penyakit tanaman."@id .

kbr:PengendalianHamaTerpadu kbr:knowledgeType "control" ;
    skos:definition "Menggabungkan beberapa teknik pengendalian hama dan penyakit secara terpadu."@id .

kbr:PengendalianVektor kbr:knowledgeType "control" ;
    skos:definition "Mengendalikan serangga atau organisme vektor yang menularkan patogen."@id .

kbr:PenggunaanAgensHayati kbr:knowledgeType "control" ;
    skos:definition "Memanfaatkan organisme antagonis atau agens hayati untuk menekan patogen."@id .

kbr:PenggunaanBacillus kbr:knowledgeType "control" ;
    skos:definition "Memanfaatkan bakteri Bacillus sebagai agens hayati pengendali patogen."@id .

kbr:PenggunaanBakterisida kbr:knowledgeType "control" ;
    skos:definition "Menggunakan bakterisida yang sesuai sasaran untuk menekan bakteri patogen."@id .

kbr:PenggunaanBeauveria kbr:knowledgeType "control" ;
    skos:definition "Memanfaatkan jamur Beauveria sebagai agens hayati pengendali serangga hama."@id .

kbr:PenggunaanBenihSehat kbr:knowledgeType "control" ;
    skos:definition "Menggunakan benih sehat, bersertifikat, atau bebas patogen untuk mencegah infeksi awal."@id .

kbr:PenggunaanBiopestisida kbr:knowledgeType "control" ;
    skos:definition "Menggunakan biopestisida berbahan aktif organisme atau metabolit alami."@id .

kbr:PenggunaanEkstrakTanaman kbr:knowledgeType "control" ;
    skos:definition "Menggunakan ekstrak tanaman yang memiliki senyawa antimikroba atau antijamur."@id .

kbr:PenggunaanFungisida kbr:knowledgeType "control" ;
    skos:definition "Menggunakan fungisida yang sesuai sasaran untuk menekan pertumbuhan jamur patogen."@id .

kbr:PenggunaanHerbisida kbr:knowledgeType "control" ;
    skos:definition "Menggunakan herbisida untuk mengendalikan gulma di sekitar pertanaman."@id .

kbr:PenggunaanInsektisida kbr:knowledgeType "control" ;
    skos:definition "Menggunakan insektisida untuk mengendalikan serangga vektor atau hama."@id .

kbr:PenggunaanMetarhizium kbr:knowledgeType "control" ;
    skos:definition "Memanfaatkan jamur Metarhizium sebagai agens hayati pengendali serangga hama."@id .

kbr:PenggunaanMulsa kbr:knowledgeType "control" ;
    skos:definition "Menutup permukaan tanah dengan mulsa untuk mengurangi percikan tanah dan menjaga kelembapan."@id .

kbr:PenggunaanPerangkap kbr:knowledgeType "control" ;
    skos:definition "Memasang perangkap untuk memantau atau menangkap serangga vektor atau hama."@id .

kbr:PenggunaanPestisidaNabati kbr:knowledgeType "control" ;
    skos:definition "Menggunakan pestisida nabati berbahan tanaman untuk menekan patogen atau hama."@id .

kbr:PenggunaanPseudomonas kbr:knowledgeType "control" ;
    skos:definition "Memanfaatkan bakteri Pseudomonas sebagai agens hayati pengendali patogen."@id .

kbr:PenggunaanTanamanBukanInang kbr:knowledgeType "control" ;
    skos:definition "Menanam tanaman yang bukan inang patogen untuk memutus siklus penyakit."@id .

kbr:PenggunaanTrichoderma kbr:knowledgeType "control" ;
    skos:definition "Memanfaatkan jamur Trichoderma sebagai agens hayati pengendali patogen."@id .

kbr:PenggunaanVarietasTahan kbr:knowledgeType "control" ;
    skos:definition "Menggunakan varietas yang dinyatakan tahan atau toleran terhadap penyakit sasaran."@id .

kbr:PengumpulanDanPemusnahan kbr:knowledgeType "control" ;
    skos:definition "Mengumpulkan dan memusnahkan bagian tanaman terserang untuk mengurangi sumber inokulum."@id .

kbr:Penyakit kbr:knowledgeType "class" ;
    skos:definition "Penyakit tanaman pangan yang tercatat pada sumber."@id .

kbr:PenyakitAntraknosaKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Antraknosa pada tanaman Kedelai, disebabkan oleh Colletotrichum, Colletotrichum truncatum, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Daun rontok, Kematian tanaman."@id ;
    skos:prefLabel "Anthracnose"@en .

kbr:PenyakitBakteriPustulKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bakteri Pustul pada tanaman Kedelai, disebabkan oleh Xanthomonas axonopodis, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Daun rontok, Klorosis pada tanaman."@id ;
    skos:prefLabel "Bacterial pustule"@en .

kbr:PenyakitBelangMottleKacangTanah kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Belang (Mottle) pada tanaman Kacang tanah, disebabkan oleh Peanut mottle virus, Peanut stripe virus, dengan gejala antara lain Belang pada tanaman, Klorosis daun, Klorosis pada tanaman, Mosaik daun."@id ;
    skos:prefLabel "Mottle"@en .

kbr:PenyakitBercakBijiUnguKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bercak Biji Ungu pada tanaman Kedelai, disebabkan oleh Cercospora kikuchii, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Hawar daun, Nekrosis daun."@id ;
    skos:prefLabel "Purple seed stain"@en .

kbr:PenyakitBercakDaunKacangHijau kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bercak Daun pada tanaman Kacang hijau, disebabkan oleh Cercospora canescens, Cercospora cruenta, dengan gejala antara lain Bercak daun, Daun rontok, Pertumbuhan terhambat."@id ;
    skos:prefLabel "Leaf spot"@en .

kbr:PenyakitBercakDaunKacangTanah kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bercak Daun pada tanaman Kacang tanah, disebabkan oleh Cercospora arachidicola, Cercospora personata, Puccinia arachidis, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Daun berlubang, Daun kering."@id ;
    skos:prefLabel "Leaf spot"@en .

kbr:PenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bercak Daun Mata Katak (Frogeye Leaf Spot) pada tanaman Kedelai, disebabkan oleh Cercospora sojina, dengan gejala antara lain Bercak daun, Bercak pada tanaman."@id ;
    skos:prefLabel "Frogeye leaf spot"@en .

kbr:PenyakitBercakKuningUbiJalar kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit bercak kuning pada tanaman Ubi jalar, disebabkan oleh Sweet Potato Chlorotic Fleck Virus, Sweet Potato Feathery Mottle Virus, Sweet Potato Mild Mottle Virus, dengan gejala antara lain Belang pada tanaman, Bercak daun, Bercak pada tanaman, Klorosis daun."@id ;
    skos:prefLabel "Yellow spot"@en .

kbr:PenyakitBercakTargetKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bercak Target pada tanaman Kedelai, disebabkan oleh Corynespora cassiicola, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Klorosis pada tanaman."@id ;
    skos:prefLabel "Target spot"@en .

kbr:PenyakitBlasPadi kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Blas pada tanaman Padi, disebabkan oleh Magnaporthe grisea, Pyricularia grisea, Pyricularia oryzae, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Malai patah."@id ;
    skos:prefLabel "Rice blast"@en .

kbr:PenyakitBulaiJagung kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bulai pada tanaman Jagung, disebabkan oleh Peronosclerospora maydis, Peronosclerospora sp, dengan gejala antara lain Kerdil tanaman, Klorosis daun, Pertumbuhan terhambat, Tepung pada daun."@id ;
    skos:prefLabel "Downy mildew"@en .

kbr:PenyakitBusukHitamBlackRotUbiJalar kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit busuk hitam (black rot) pada tanaman Ubi jalar, disebabkan oleh Ceratocystis fimbriata, dengan gejala antara lain Bercak pada tanaman, Busuk akar, Busuk pada tanaman."@id ;
    skos:prefLabel "Black rot"@en .

kbr:PenyakitBusukPelepahJagung kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Busuk Pelepah pada tanaman Jagung, disebabkan oleh Rhizoctonia solani, dengan gejala antara lain Bercak pada tanaman, Busuk batang."@id ;
    skos:prefLabel "Sheath rot"@en .

kbr:PenyakitEmbunPalsuDownyMildewKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Embun Palsu (Downy mildew) pada tanaman Kedelai, disebabkan oleh Peronospora manshurica, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Klorosis daun, Klorosis pada tanaman."@id ;
    skos:prefLabel "Downy mildew"@en .

kbr:PenyakitEmbunTepungKacangHijau kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Embun Tepung pada tanaman Kacang hijau, disebabkan oleh Erysiphe polygoni, dengan gejala antara lain Tepung pada daun."@id ;
    skos:prefLabel "Powdery mildew"@en .

kbr:PenyakitEmbunTepungPowderyMildewKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Embun Tepung (Powdery Mildew) pada tanaman Kedelai, disebabkan oleh Erysiphae diffusa, dengan gejala antara lain Bercak daun, Tepung pada daun."@id ;
    skos:prefLabel "Powdery mildew"@en .

kbr:PenyakitHawarBakteriBacterialBlightKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Hawar Bakteri (Bacterial Blight) pada tanaman Kedelai, disebabkan oleh Pseudomonas syringae, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Daun berlubang, Daun rontok."@id ;
    skos:prefLabel "Bacterial blight"@en .

kbr:PenyakitHawarDaunBakteriPadi kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Hawar Daun Bakteri pada tanaman Padi, disebabkan oleh Xanthomonas oryzae, dengan gejala antara lain Bercak daun, Hawar daun, Klorosis daun, Klorosis pada tanaman."@id ;
    skos:prefLabel "Bacterial leaf blight"@en .

kbr:PenyakitHawarDaunJagung kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Hawar Daun pada tanaman Jagung, disebabkan oleh Helminthosporium maydis, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Hawar daun, Nekrosis daun."@id ;
    skos:prefLabel "Leaf blight"@en .

kbr:PenyakitHawarPelepahDaunPadi kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Hawar Pelepah Daun pada tanaman Padi, disebabkan oleh Rhizoctonia solani, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Busuk batang."@id ;
    skos:prefLabel "Sheath blight"@en .

kbr:PenyakitKaratDaunJagung kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Karat Daun pada tanaman Jagung, disebabkan oleh Puccinia polysora, dengan gejala antara lain Bercak pada tanaman, Klorosis daun."@id ;
    skos:prefLabel "Rust"@en .

kbr:PenyakitKaratDaunKacangTanah kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Karat Daun pada tanaman Kacang tanah, disebabkan oleh Puccinia arachidis, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Klorosis daun, Klorosis pada tanaman."@id ;
    skos:prefLabel "Rust"@en .

kbr:PenyakitKaratDaunKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Karat Daun pada tanaman Kedelai, disebabkan oleh Phakopsora meibomiae, Phakopsora pachyrhizi, Phakopspora pachyrhizi, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Daun kering, Daun rontok."@id ;
    skos:prefLabel "Rust"@en .

kbr:PenyakitKerdilKedelaiSoybeanStuntVirusKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Kerdil Kedelai (Soybean Stunt Virus) pada tanaman Kedelai, disebabkan oleh Soybean Stunt Virus, dengan gejala antara lain Kerdil tanaman, Mosaik daun, Pertumbuhan terhambat."@id ;
    skos:prefLabel "Soybean stunt virus"@en .

kbr:PenyakitKerdilRumputDanKerdilHampaPadi kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Kerdil Rumput dan Kerdil Hampa pada tanaman Padi, disebabkan oleh Rice grassy stunt virus, Rice ragged stunt virus, dengan gejala antara lain Bercak daun, Kerdil tanaman, Klorosis daun, Pertumbuhan abnormal."@id ;
    skos:prefLabel "Grassy stunt and ragged stunt"@en .

kbr:PenyakitKudisUbiJalar kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit kudis pada tanaman Ubi jalar, disebabkan oleh Elsinoe batatas, Spaceloma batatas, dengan gejala antara lain Bercak daun, Bercak pada tanaman, Klorosis pada tanaman."@id ;
    skos:prefLabel "Scab"@en .

kbr:PenyakitLayuBakteriKacangTanah kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Layu Bakteri pada tanaman Kacang tanah, disebabkan oleh Ralstonia solanacearum, dengan gejala antara lain Kematian tanaman, Layu daun."@id ;
    skos:prefLabel "Bacterial wilt"@en .

kbr:PenyakitLayuFusariumKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Layu Fusarium pada tanaman Kedelai, disebabkan oleh Fusarium spp, dengan gejala antara lain Busuk akar, Kematian tanaman, Layu daun, Nekrosis pada tanaman."@id ;
    skos:prefLabel "Fusarium wilt"@en .

kbr:PenyakitLayuKacangHijau kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Layu pada tanaman Kacang hijau, disebabkan oleh Sclerotium rolfsii, dengan gejala antara lain Busuk pada tanaman, Layu daun, Miselium pada tanaman."@id ;
    skos:prefLabel "Wilt"@en .

kbr:PenyakitLayuStewartJagung kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Layu Stewart pada tanaman Jagung, disebabkan oleh Pantoea stewartii, dengan gejala antara lain Kerdil tanaman, Klorosis daun, Layu daun, Pertumbuhan abnormal."@id ;
    skos:prefLabel "Stewart's wilt"@en .

kbr:PenyakitMosaikKedelaiSoybeanMosaicVirusKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Mosaik Kedelai (Soybean Mosaic Virus) pada tanaman Kedelai, disebabkan oleh Soybean Mosaic Virus, dengan gejala antara lain Belang pada tanaman, Kerdil tanaman, Klorosis daun, Mosaik daun."@id ;
    skos:prefLabel "Soybean mosaic virus"@en .

kbr:PenyakitRebahKecambahKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Rebah Kecambah pada tanaman Kedelai, disebabkan oleh Rhizoctonia solani, dengan gejala antara lain Bercak pada tanaman, Busuk akar, Busuk batang, Busuk pada tanaman."@id ;
    skos:prefLabel "Damping-off"@en .

kbr:PenyakitRebahSemaiKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Rebah Semai pada tanaman Kedelai, disebabkan oleh Sclerotium rolfsii, dengan gejala antara lain Bercak pada tanaman, Busuk batang, Klorosis daun, Layu daun."@id ;
    skos:prefLabel "Damping-off"@en .

kbr:PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus) pada tanaman Kedelai, disebabkan oleh Cowpea Mild Mottle Virus, dengan gejala antara lain Kerdil tanaman, Klorosis daun, Mosaik daun, Pertumbuhan abnormal."@id ;
    skos:prefLabel "Cowpea mild mottle virus"@en .

kbr:PenyakitTungroPadi kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Tungro pada tanaman Padi, disebabkan oleh Rice tungro bacillifor virus, Rice tungro spherical virus, dengan gejala antara lain Bercak pada tanaman, Kerdil tanaman, Klorosis daun, Pertumbuhan terhambat."@id ;
    skos:prefLabel "Tungro"@en .

kbr:PerlakuanAirPanas kbr:knowledgeType "control" ;
    skos:definition "Merendam benih atau bahan tanam dalam air panas pada suhu dan waktu tertentu untuk membunuh patogen."@id .

kbr:PerlakuanBenih kbr:knowledgeType "control" ;
    skos:definition "Memperlakukan benih sebelum tanam, misalnya dengan fungisida atau air panas, untuk mencegah infeksi awal."@id .

kbr:PerlakuanKimiaTanah kbr:knowledgeType "control" ;
    skos:definition "Memperlakukan tanah dengan bahan kimia untuk menekan patogen tular tanah."@id .

kbr:PerlakuanRadiasi kbr:knowledgeType "control" ;
    skos:definition "Menggunakan radiasi tertentu untuk menekan patogen pada bahan tanam atau hasil panen."@id .

kbr:PucukMati kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "dieback"@id,
        "mati pucuk"@id ;
    skos:broader kbr:KategoriNekrosis ;
    skos:definition "Pucuk atau tunas mati, mengering, dan berwarna coklat sampai hitam."@id ;
    skos:prefLabel "dieback"@en .

kbr:RotasiTanaman kbr:knowledgeType "control" ;
    skos:definition "Menggilir jenis tanaman antar musim untuk memutus siklus hidup patogen di lahan."@id .

kbr:SanitasiLahan kbr:knowledgeType "control" ;
    skos:definition "Membersihkan sisa tanaman, gulma, dan sumber inokulum lain dari lahan."@id .

kbr:SapuSetanWitchesBroomUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Sapu setan (Witches broom) pada tanaman Ubi kayu, disebabkan oleh Fitoplasma, dengan gejala antara lain Kerdil tanaman."@id ;
    skos:prefLabel "Witches' broom"@en .

kbr:SeleksiBahanTanam kbr:knowledgeType "control" ;
    skos:definition "Menyeleksi bahan tanam atau bahan perbanyakan yang sehat dan bebas patogen."@id .

kbr:SolarisasiTanah kbr:knowledgeType "control" ;
    skos:definition "Memanaskan tanah dengan sinar matahari yang ditutup plastik untuk menekan patogen tular tanah."@id .

kbr:SuperelongasiUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Superelongasi pada tanaman Ubi kayu, disebabkan oleh Elsinoe brasiliensis, dengan gejala antara lain Pertumbuhan abnormal."@id ;
    skos:prefLabel "Superelongation"@en .

kbr:TanamanKerdilStuntUbiKayu kbr:knowledgeType "disease",
        "disease_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Tanaman kerdil (stunt) pada tanaman Ubi kayu, disebabkan oleh Begomovirus, dengan gejala antara lain Kerdil tanaman, Pertumbuhan terhambat."@id ;
    skos:prefLabel "Stunt"@en .

kbr:TanamanPangan kbr:knowledgeType "class" ;
    skos:definition "Tanaman pangan dalam ruang lingkup knowledge base."@id .

kbr:TepungDaun kbr:knowledgeType "symptom" ;
    dcterms:source "Glosarium DOC006: Tepung"@id ;
    skos:altLabel "embun tepung"@id,
        "lapisan tepung"@id ;
    skos:broader kbr:KategoriLainnya ;
    skos:definition "Lapisan tepung berwarna putih pada permukaan daun atau bagian hijau, terdiri dari miselium dan konidia jamur."@id ;
    skos:prefLabel "powdery mildew"@en .

kbr:TidakSpesifik kbr:knowledgeType "part" ;
    skos:altLabel "tidak spesifik"@id ;
    skos:definition "Bagian tanaman yang tidak dapat ditentukan secara spesifik dari sumber."@id ;
    skos:prefLabel "unspecified plant part"@en .

kbr:UbiJalar kbr:knowledgeType "plant" ;
    skos:altLabel "Ipomoea batatas"@id,
        "ubi jalar"@id ;
    skos:definition "Tanaman pangan umbi-umbian penghasil umbi akar yang kaya karbohidrat."@id .

kbr:UbiKayu kbr:knowledgeType "plant" ;
    skos:altLabel "Manihot esculenta"@id,
        "singkong"@id,
        "ubi kayu"@id ;
    skos:definition "Tanaman pangan umbi-umbian penghasil umbi akar yang digunakan sebagai bahan pangan dan industri."@id .

kbr:Umbi kbr:knowledgeType "part" ;
    kbr:partParent kbr:Akar ;
    skos:altLabel "umbi"@id ;
    skos:definition "Organ penyimpanan cadangan makanan pada tanaman tertentu, seperti ubi jalar dan ubi kayu."@id ;
    skos:prefLabel "tuber"@en .

kbr:Varietas kbr:knowledgeType "class" ;
    skos:definition "Varietas tanaman yang disebut sumber, termasuk status tahan atau rentan."@id .

kbr:bagianDari kbr:knowledgeType "property" ;
    skos:definition "Menghubungkan bagian tanaman dengan bagian tanaman induknya (partonomy)."@id .

kbr:didahuluiOleh kbr:knowledgeType "property" ;
    skos:definition "Kebalikan dari diikutiOleh."@id .

kbr:diikutiOleh kbr:knowledgeType "property" ;
    skos:definition "Menghubungkan fase pertumbuhan dengan fase berikutnya."@id .

kbr:dikendalikanDengan kbr:knowledgeType "property" ;
    skos:definition "Menghubungkan penyakit dengan tindakan pengendalian yang direkomendasikan."@id .

kbr:dipengaruhiOleh kbr:knowledgeType "property" ;
    skos:definition "Menghubungkan penyakit dengan faktor risiko atau kondisi lingkungan yang memengaruhinya."@id .

kbr:disebabkanOleh kbr:knowledgeType "property" ;
    skos:definition "Menghubungkan penyakit dengan patogen penyebabnya."@id .

kbr:memilikiFasePertumbuhan kbr:knowledgeType "property" ;
    skos:definition "Menghubungkan tanaman pangan dengan fase pertumbuhan yang dimilikinya."@id .

kbr:memilikiGejala kbr:knowledgeType "property" ;
    skos:definition "Menghubungkan penyakit dengan pengamatan gejala yang didukung sumber."@id .

kbr:memilikiGejalaKanonik kbr:knowledgeType "property" ;
    skos:definition "Memetakan pengamatan gejala ke konsep gejala kanonik."@id .

kbr:memilikiVarietas kbr:knowledgeType "property" ;
    skos:definition "Menghubungkan tanaman pangan dengan varietas yang disebut sumber."@id .

kbr:rentanTerhadap kbr:knowledgeType "property" ;
    skos:definition "Menyatakan varietas rentan atau peka terhadap penyakit tertentu."@id .

kbr:tahanTerhadap kbr:knowledgeType "property" ;
    skos:definition "Menyatakan varietas tahan atau toleran terhadap penyakit tertentu."@id .

kbr:terdapatPada kbr:knowledgeType "property" ;
    skos:definition "Menghubungkan pengamatan gejala dengan bagian tanaman tempat gejala diamati."@id .

kbr:Akar kbr:knowledgeType "part" ;
    skos:altLabel "akar"@id ;
    skos:definition "Organ penyerap air dan hara serta penopang tanaman di dalam tanah; tempat munculnya gejala busuk akar."@id ;
    skos:prefLabel "root"@en .

kbr:BercakTanaman kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "bercak"@id,
        "lesi"@id,
        "noda"@id ;
    skos:broader kbr:KategoriNekrosis ;
    skos:definition "Bercak, noda, lesi, atau bintik pada jaringan tanaman tanpa bagian tanaman yang spesifik."@id ;
    skos:prefLabel "spotting"@en .

kbr:Buah kbr:knowledgeType "part" ;
    kbr:partParent kbr:Batang ;
    skos:altLabel "buah"@id ;
    skos:definition "Organ hasil perkembangan bunga yang mengandung biji; tempat munculnya gejala busuk atau bercak buah."@id ;
    skos:prefLabel "fruit"@en .

kbr:DaunRontok kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "daun gugur"@id,
        "defoliasi"@id ;
    skos:broader kbr:KategoriPertumbuhan ;
    skos:definition "Daun gugur atau rontok sebelum waktunya."@id ;
    skos:prefLabel "leaf drop"@en .

kbr:FaseGeneratifUmum kbr:phaseNext kbr:FaseMatangSusu .

kbr:FaseMatangSusu kbr:knowledgeType "phase" ;
    kbr:phaseNext kbr:FasePanenTanaman ;
    skos:altLabel "matang susu"@id ;
    skos:definition "Tahap biji mengeras dan berisi cairan seperti susu, menandakan menjelang pemasakan."@id ;
    skos:prefLabel "milk stage"@en .

kbr:FaseVegetatifUmum kbr:phaseNext kbr:FaseGeneratifUmum .

kbr:KategoriKelainanBentuk rdfs:label "Kelainan bentuk"@id ;
    kbr:knowledgeType "category" ;
    skos:definition "Kategori gejala yang ditandai perubahan bentuk atau struktur tanaman, seperti malformasi atau patah."@id .

kbr:KerdilTanaman kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "pertumbuhan kerdil"@id,
        "tanaman kerdil"@id ;
    skos:broader kbr:KategoriPertumbuhan ;
    skos:definition "Pertumbuhan tanaman terhambat sehingga ukurannya lebih kecil atau lebih pendek daripada tanaman normal pada umur yang sama."@id ;
    skos:prefLabel "stunting"@en .

kbr:Malai kbr:knowledgeType "part" ;
    kbr:partParent kbr:Batang ;
    skos:altLabel "malai"@id ;
    skos:definition "Bunga majemuk pada tanaman seperti padi; tempat munculnya gejala malai kosong, patah, atau bercak."@id ;
    skos:prefLabel "panicle"@en .

kbr:Polong kbr:knowledgeType "part" ;
    kbr:partParent kbr:Batang ;
    skos:altLabel "polong"@id ;
    skos:definition "Buah khas tanaman legum yang membungkus biji; tempat munculnya gejala bercak atau busuk polong."@id ;
    skos:prefLabel "pod"@en .

kbr:Pucuk kbr:knowledgeType "part" ;
    kbr:partParent kbr:Batang ;
    skos:altLabel "pucuk"@id,
        "tunas"@id ;
    skos:definition "Tunas atau bagian ujung tanaman yang sedang tumbuh; tempat munculnya gejala mati pucuk atau klorosis."@id ;
    skos:prefLabel "shoot"@en .

kbr:KategoriLainnya rdfs:label "Gejala lainnya"@id ;
    kbr:knowledgeType "category" ;
    skos:definition "Kategori gejala yang tidak termasuk kelompok perubahan warna, pertumbuhan, nekrosis, pembusukan, atau kelainan bentuk."@id .

kbr:PertumbuhanAbnormal kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "deformasi"@id,
        "malformasi"@id,
        "pertumbuhan tidak normal"@id ;
    skos:broader kbr:KategoriPertumbuhan ;
    skos:definition "Bentuk atau pola pertumbuhan tanaman tidak normal, misalnya malformasi, deformasi, atau penggulungan."@id ;
    skos:prefLabel "abnormal growth"@en .

kbr:PertumbuhanTerhambat kbr:knowledgeType "symptom" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:altLabel "pertumbuhan lambat"@id,
        "terhambat"@id ;
    skos:broader kbr:KategoriPertumbuhan ;
    skos:definition "Laju pertumbuhan tanaman lebih lambat dan ukuran tanaman lebih kecil dibanding tanaman normal."@id ;
    skos:prefLabel "growth retardation"@en .

kbr:Batang kbr:knowledgeType "part" ;
    skos:altLabel "batang"@id ;
    skos:definition "Organ penopang tanaman dan pengangkut air serta hara; tempat munculnya gejala busuk, kerdil, atau bercak batang."@id ;
    skos:prefLabel "stem"@en .

kbr:KategoriPembusukan rdfs:label "Pembusukan"@id ;
    kbr:knowledgeType "category" ;
    skos:definition "Kategori gejala yang ditandai pembusukan jaringan tanaman pada batang, akar, buah, atau bagian lain."@id .

kbr:KategoriPerubahanWarna rdfs:label "Perubahan warna"@id ;
    kbr:knowledgeType "category" ;
    skos:definition "Kategori gejala yang ditandai perubahan warna jaringan tanaman, seperti menguning, memudar, atau belang."@id .

kbr:KategoriPertumbuhan rdfs:label "Gangguan pertumbuhan"@id ;
    kbr:knowledgeType "category" ;
    skos:definition "Kategori gejala yang ditandai gangguan pertumbuhan atau perkembangan tanaman, seperti kerdil, terhambat, atau layu."@id .

kbr:KategoriNekrosis rdfs:label "Nekrosis dan kematian jaringan"@id ;
    kbr:knowledgeType "category" ;
    skos:definition "Kategori gejala yang ditandai kematian jaringan atau bagian tanaman, seperti bercak, hawar, kering, atau lubang."@id .

