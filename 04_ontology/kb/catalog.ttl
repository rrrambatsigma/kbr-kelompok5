kbr:TextFilterEnvControl kbr:filterName "env_control_context" ;
    kbr:knowledgeType "text_filter" ;
    kbr:pattern "perlakuan\\s+(?:panas|air\\s+panas|benih)|panas\\s+kering|mengeliminasi|membunuh|ruang\\s+penyimpanan|selama\\s+penyimpanan|penyimpanan\\s+diatur|agar\\s+perkembangan\\s+penyakit\\s+lambat|penyembuhan\\s+periderm|pengeringan\\s+dilakukan|solarisasi|seed\\s+treatment|perendaman\\s+benih|air\\s+panas|direndam|disemprot" .

kbr:TextFilterEnvNegative kbr:filterName "env_negative_context" ;
    kbr:knowledgeType "text_filter" ;
    kbr:pattern "\\bmenurun\\b|\\bbertahan\\b|tidak\\s+(?:berkembang|tumbuh)|kurang\\s+(?:baik|sesuai)" .

kbr:VarietyConfig kbr:fallbackRegex "\\badalah\\s+([A-Z][A-Za-z0-9\\-']*(?:\\s+[A-Z0-9][A-Za-z0-9\\-']*){0,5})" ;
    kbr:knowledgeType "variety_config" ;
    kbr:plantWord "hijau",
        "jagung",
        "jalar",
        "kacang",
        "kayu",
        "kedelai",
        "padi",
        "tanah",
        "ubi" ;
    kbr:primaryRegex "\\bvarietas\\b" ;
    kbr:resistMarker "\\b(tahan|resistan|resisten|toleran)\\b" ;
    kbr:stopword "adalah",
        "agak",
