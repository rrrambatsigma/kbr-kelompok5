kbr:KondisiCurahHujanRendah rdfs:label "Curah hujan rendah"@id ;
    kbr:knowledgeType "qualitative_rule" ;
    kbr:pattern "curah\\s+hujan\\s+(?:yang\\s+)?rendah" ;
    kbr:qualitativeClass kbr:CurahHujan .

kbr:KondisiCurahHujanTinggi rdfs:label "Curah hujan tinggi"@id ;
    kbr:knowledgeType "qualitative_rule" ;
    kbr:pattern "curah\\s+hujan\\s+(?:yang\\s+)?tinggi" ;
    kbr:qualitativeClass kbr:CurahHujan .

kbr:KondisiKelembapanRendah rdfs:label "Kelembapan rendah"@id ;
    kbr:knowledgeType "qualitative_rule" ;
    kbr:pattern "kelembap(?:a|e)n\\s+(?:yang\\s+)?rendah" ;
    kbr:qualitativeClass kbr:KelembapanUdara .

kbr:KondisiKelembapanTinggi rdfs:label "Kelembapan tinggi"@id ;
    kbr:knowledgeType "qualitative_rule" ;
    kbr:pattern "kelembap(?:a|e)n\\s+(?:yang\\s+)?tinggi" ;
    kbr:qualitativeClass kbr:KelembapanUdara .

kbr:KondisiMusimHujan rdfs:label "Musim hujan"@id ;
    kbr:knowledgeType "qualitative_rule" ;
    kbr:pattern "musim\\s+hujan" ;
    kbr:qualitativeClass kbr:Musim .

kbr:KondisiMusimKemarau rdfs:label "Musim kemarau"@id ;
    kbr:knowledgeType "qualitative_rule" ;
    kbr:pattern "musim\\s+kemarau" ;
    kbr:qualitativeClass kbr:Musim .

kbr:KondisiSuhuRendah rdfs:label "Suhu rendah"@id ;
    kbr:knowledgeType "qualitative_rule" ;
    kbr:pattern "suhu\\s+(?:yang\\s+)?rendah" ;
    kbr:qualitativeClass kbr:Suhu .

kbr:KondisiSuhuTinggi rdfs:label "Suhu tinggi"@id ;
    kbr:knowledgeType "qualitative_rule" ;
    kbr:pattern "suhu\\s+(?:yang\\s+)?tinggi" ;
    kbr:qualitativeClass kbr:Suhu .

