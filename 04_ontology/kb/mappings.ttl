    kbr:phase kbr:FasePanenTanaman,
        kbr:FasePembibitanTanaman ;
    kbr:sourceId "DOC002_P055_B004" ;
    kbr:sourceText "patogen dapat menginfeksi dari fase pembibitan hingga panen dan menyebabkan kehilangan hasil mencapai 50-70% (majid, 2016)." .

kbr:MappingBuktiMetadataPhasePenyakitHawarDaunJagung kbr:knowledgeType "mapping" ;
    kbr:phase kbr:FaseGeneratifUmum ;
    kbr:sourceId "DOC002_P102_B003" ;
    kbr:sourceText "hawar daun berkembang lebih baik pada fase generatif (latifahani et al., 2014)." .

kbr:MappingBuktiMetadataPhasePenyakitKaratDaunJagung kbr:knowledgeType "mapping" ;
    kbr:phase kbr:FaseGeneratifUmum ;
    kbr:sourceId "DOC002_P104_B003" ;
    kbr:sourceText "gejala karat biasanya diawali dari daun bagian bawah dan berkembang ke daun bagian atas, umumnya muncul pada masa generatif (puspawati and sudarma, 2016)." .

kbr:MappingBuktiMetadataPhasePenyakitLayuKacangHijau kbr:knowledgeType "mapping" ;
    kbr:phase kbr:FaseGeneratifUmum ;
    kbr:sourceId "DOC005_C064_01" ;
    kbr:sourceText "infeksi pada tanaman dapat terjadi pada stadia awal sebelum benih berkecambah hingga fase generatif akhir." .

