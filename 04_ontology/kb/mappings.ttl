    kbr:canonicalGejala kbr:BercakTanaman ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_123" ;
    kbr:sourceText "sporulasi patogen terjadi pada bercak yang telah berkembang penuh biasanya 15 hari setelah inokulasi." .

kbr:MappingBuktiGejalaPenyakitBercakDaunKacangTanah13 kbr:bagianTanaman kbr:Daun ;
