    kbr:canonicalGejala kbr:BercakDaun,
        kbr:TepungDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_057" ;
    kbr:sourceText "diffusa menginfeksi daun kedelai bagian bawah sehingga pada permukaan daun bagian bawah terdapat bercak berwarna putih seperti tepung yang merupakan kumpulan dari konidia dan konidiofor patogen e." .

kbr:MappingBuktiGejalaPenyakitEmbunTepungPowderyMildewKedelai2 kbr:bagianTanaman kbr:Daun ;
    kbr:canonicalGejala kbr:BercakDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_058" ;
    kbr:sourceText "bercak kemudian menyebar ke bagian atas permukaan daun." .

