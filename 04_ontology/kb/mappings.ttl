        kbr:PenggunaanAgensHayati ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "CTL_067" ;
    kbr:sourceText "aplikasi pupuk kandang dan pemberian agens hayati aspergillus sp." .

kbr:MappingBuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai kbr:controlAction kbr:PenggunaanAgensHayati ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "CTL_086" ;
    kbr:sourceText "pengendalian penyakit ini dapat ditekan dengan beberapa teknik pengendalian seperti penggunaan agens hayati seperti bakteri antagonis untuk menekan perkembangan penyakit hawar bakteri." .

kbr:MappingBuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelai2 kbr:controlAction kbr:PenggunaanAgensHayati,
