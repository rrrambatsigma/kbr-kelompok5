    kbr:canonicalGejala kbr:BercakDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_121" ;
    kbr:sourceText "penyakit bercak daun merupakan penyakit tular udara yang disebabkan oleh patogen (cercospora arachidicola dan c." .

kbr:MappingBuktiGejalaPenyakitBercakDaunKacangTanah10 kbr:bagianTanaman kbr:Daun ;
    kbr:canonicalGejala kbr:BercakDaun,
        kbr:DaunRontok ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_619" ;
    kbr:sourceText "gejala tanaman yang terinfeksi cendawan ditunjukkan adanya bercak kecil pada daun-daun di bagian bawah, bercak kemudian melebar dan menyatu sehingga membentuk bercak besar, yang menyebabkan daun mengering dan rontok." .

kbr:MappingBuktiGejalaPenyakitBercakDaunKacangTanah11 kbr:bagianTanaman kbr:Daun ;
