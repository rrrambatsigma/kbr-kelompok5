        kbr:PerlakuanBenih ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "CTL_091" ;
    kbr:sourceText "menghilangkan tanaman yang dapat menjadi sumber inokulum dan melakukan seed treatment dengan bakterisida seperti streptomisin (inayati and yusnawan, 2017)." .

