        kbr:KlorosisTanaman ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_135" ;
    kbr:sourceText "pada umumnya bintik-bintik kecil tersebut dikelilingi oleh bagian yang klorosis, walaupun ada yang hanya berupa bintik coklat (abadi, 2003, semangun, 2004)." .

kbr:MappingBuktiGejalaPenyakitBercakDaunKacangTanah14 kbr:bagianTanaman kbr:Daun ;
    kbr:canonicalGejala kbr:KlorosisDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_130" ;
