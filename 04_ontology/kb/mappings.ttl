    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_068" ;
    kbr:sourceText "konidia merupakan sumber inokulum primer dan sekunder untuk perkembangan penyakit bercak daun mata katak." .

kbr:MappingBuktiGejalaPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedela3 kbr:bagianTanaman kbr:Daun ;
