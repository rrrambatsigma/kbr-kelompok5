        kbr:KlorosisTanaman ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "T5.3_AKAR#3" ;
    kbr:sourceText "akar membusuk, terdapat tubuh buah (jamur) kecil berwarna keputihan dan menguning, di ujung akar dekat pangkal batang," .

kbr:MappingBuktiGejalaBusukPangkalBatangUbiKayu kbr:bagianTanaman kbr:Batang ;
    kbr:canonicalGejala kbr:BusukBatang,
        kbr:LayuDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "T5.2_BATANG#" ;
    kbr:sourceText "infeksi patogen pada bagian batang dekat permukaan tanah (pangkal batang), dan menyebabkan pangkal batang membusuk sehingga tanaman layu." .

kbr:MappingBuktiGejalaBusukUmbiUbiKayu kbr:bagianTanaman kbr:Umbi ;
    kbr:canonicalGejala kbr:BusukTanaman,
        kbr:LayuDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "T5.3_AKAR#2" ;
    kbr:sourceText "umbi membusuk dan tanaman layu, umbi berwarna lebih gelap dan berbau busuk khas." .

