        kbr:PenggunaanPseudomonas ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "CTL_087" ;
    kbr:sourceText "bakteri bacillus subtilis dan pseudomonas fluorescens merupakan bakteri antagonis untuk menekan perkembangan penyakit hawar bakteri oleh patogen p." .

