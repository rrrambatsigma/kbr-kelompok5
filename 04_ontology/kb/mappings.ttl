kbr:MappingBuktiGejalaAntraknosaUbiKayuBatang kbr:bagianTanaman kbr:Batang ;
    kbr:canonicalGejala kbr:NekrosisTanaman,
        kbr:PucukMati ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "T5.2_BATANG#1" ;
    kbr:sourceText "infeksi pada batang akan menimbulkan retakan berupa kanker batang, gejala mati pucuk, dan pucuk atau batang akan patah." .

kbr:MappingBuktiGejalaAntraknosaUbiKayuDaun kbr:bagianTanaman kbr:Daun ;
