    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_139" ;
    kbr:sourceText "gejala lanjut helaian daun terdapat bentuk belang-belang yang tidak beraturan, berwarna hijau tua dan hijau muda." .

