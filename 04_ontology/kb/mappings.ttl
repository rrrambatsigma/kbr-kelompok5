    kbr:canonicalGejala kbr:Kresek,
        kbr:LayuDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_011" ;
    kbr:sourceText "dalam kondisi yang parah daun tanaman padi menjadi hijau keabu-abuan hingga keputihan dan tiba-tiba layu dan terkadang fase \"kresek\" penyakit terjadi pada tanaman dewasa." .

kbr:MappingBuktiGejalaPenyakitHawarDaunBakteriPadi8 kbr:bagianTanaman kbr:Daun ;
    kbr:canonicalGejala kbr:PertumbuhanAbnormal ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_005" ;
    kbr:sourceText "gejala khas dari penyakit ini adalah tepi bergelombang atau penggulungan yang terlihat jelas pada helaian daun." .

kbr:MappingBuktiGejalaPenyakitHawarDaunBakteriPadi9 kbr:bagianTanaman kbr:Daun ;
