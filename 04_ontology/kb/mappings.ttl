    kbr:canonicalGejala kbr:KlorosisDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_008" ;
    kbr:sourceText "saat serangan tinggi gejala berupa garis-garis kuning menjadi putih muncul tepat di dalam tepi bilah daun." .

