    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_183" ;
    kbr:sourceText "jika bintil pecah, spora akan keluar dan terbawa angin maupun percikan air hujan sehingga menjadi sumber inokulum baru dan dapat menginfeksi tanaman lain." .

kbr:MappingBuktiGejalaPenyakitKaratDaunKacangTanah kbr:bagianTanaman kbr:Daun ;
