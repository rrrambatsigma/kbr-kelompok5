        kbr:DaunRontok ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_097" ;
    kbr:sourceText "lama kelamaan bercak menjadi berlubang pada tingkat serangan yang parah daun akan rontok karena daun yang mengering ." .

kbr:MappingBuktiGejalaPenyakitHawarBakteriBacterialBlightKedelai5 kbr:bagianTanaman kbr:Daun ;
    kbr:canonicalGejala kbr:BercakDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_098" ;
    kbr:sourceText "syringae pada gejala tidak ada pustul pada bagian bercak daun." .

