        kbr:Kresek ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_006" ;
    kbr:sourceText "penyakit ini dapat di karakterisasi menjadi dua fase yang berbeda; fase hawar daun, dan fase kresek yang merupakan fase destruktif bagi wabah penyakit (mukko et al." .

kbr:MappingBuktiGejalaPenyakitHawarDaunJagung kbr:bagianTanaman kbr:Daun ;
    kbr:canonicalGejala kbr:HawarDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_177" ;
