kbr:MappingBuktiGejalaPenyakitHawarDaunJagung3 kbr:bagianTanaman kbr:Daun ;
    kbr:canonicalGejala kbr:BercakTanaman ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_180" ;
