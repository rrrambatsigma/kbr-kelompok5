    kbr:canonicalGejala kbr:BercakTanaman ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_091" ;
    kbr:sourceText "bercak ungu pada biji menutupi sebagian atau seluruh permukaan biji." .

