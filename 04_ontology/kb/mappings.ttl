    kbr:knowledgeType "mapping" ;
    kbr:sourceId "Conditions that Favor Disease, paragraph 1" ;
    kbr:sourceText "the fungus that causes nclb requires relatively long periods of leaf moisture (6 hours) for infection, which may be supplied by rain, heavy dew, or overhead irrigation." .

kbr:MappingBuktiFasePenyakitBulaiJagung kbr:knowledgeType "mapping" ;
    kbr:phase kbr:FaseVegetatifUmum ;
    kbr:sourceId "SYM_195" ;
