    kbr:canonicalGejala kbr:BercakDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_132" ;
    kbr:sourceText "penyakit karat merupakan penyakit penting kedua pada kacang tanah setelah bercak daun." .

