kbr:MappingBuktiGejalaPenyakitHawarDaunJagung4 kbr:bagianTanaman kbr:Daun ;
    kbr:canonicalGejala kbr:BercakDaun,
        kbr:NekrosisDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_179" ;
    kbr:sourceText "selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan, infeksi lebih lanjut bercak akan melebar dan bergabung dengan bercak lain dan menyebabkan jaringan daun mengalami nekrosis." .

kbr:MappingBuktiGejalaPenyakitHawarPelepahDaunPadi kbr:bagianTanaman kbr:Daun ;
    kbr:canonicalGejala kbr:BercakTanaman ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_021" ;
    kbr:sourceText "pada bagian tersebut akan terdapat bercak berwarna coklat kemerahan." .

