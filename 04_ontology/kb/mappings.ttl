    kbr:canonicalGejala kbr:HawarDaun,
        kbr:KlorosisDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_007" ;
    kbr:sourceText "pada fase hawar daun gejala berupa perubahan warna daun menjadi kuning pucat (mizukami dan wakimoto, 1969)." .

