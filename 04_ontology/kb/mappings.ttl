    kbr:canonicalGejala kbr:TepungDaun ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_621" ;
    kbr:sourceText "gejala tersebut hampir sama dengan embun tepung pada beberapa tanaman lainnya." .

