        kbr:PertumbuhanTerhambat ;
    kbr:knowledgeType "mapping" ;
    kbr:sourceId "SYM_623" ;
    kbr:sourceText "pada varietas rentan menyebabkan gejala defoliasi prematur pengurangan ukuran polong dan biji (grewal et al. 1980)." .

