kbr:Akar kbr:knowledgeType "entity_definition" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:definition "Organ penyerap air dan hara serta penopang tanaman di dalam tanah; tempat munculnya gejala busuk akar."@id .

kbr:AntraknosaUbiKayuBatang kbr:knowledgeType "entity_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Antraknosa pada tanaman Ubi kayu, disebabkan oleh Collectothricum gloeosporioides, dengan gejala antara lain Pucuk mati."@id .

kbr:AntraknosaUbiKayuDaun kbr:knowledgeType "entity_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Antraknosa pada tanaman Ubi kayu, disebabkan oleh Colletotricum spp, dengan gejala antara lain Layu daun."@id .

kbr:BagianTanaman kbr:knowledgeType "entity_definition" ;
    dcterms:source "Dokumentasi TBox"@id ;
    skos:definition "Bagian tanaman yang dapat menjadi lokasi gejala atau serangan penyakit."@id .

kbr:Bakteri kbr:knowledgeType "entity_definition" ;
    dcterms:source "Dokumentasi TBox"@id ;
    skos:definition "Patogen kelompok bakteri."@id .

kbr:Batang kbr:knowledgeType "entity_definition" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:definition "Organ penopang tanaman dan pengangkut air serta hara; tempat munculnya gejala busuk, kerdil, atau bercak batang."@id .

kbr:Begomovirus kbr:knowledgeType "entity_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Virus Begomovirus yang menyebabkan penyakit Cassava Mosaic Begomovirus (CMBs), Tanaman kerdil (stunt) pada tanaman Ubi kayu."@id .

kbr:BelangTanaman kbr:knowledgeType "entity_definition" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:definition "Pola belang atau mottle pada jaringan tanaman tanpa bagian tanaman yang spesifik."@id .

kbr:BercakDaun kbr:knowledgeType "entity_definition" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:definition "Bercak atau noda berwarna berbeda dari jaringan sehat pada daun; dapat berupa lesi kecil, bulat, atau tidak beraturan."@id .

kbr:BercakDaunBaurUbiKayu kbr:knowledgeType "entity_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bercak daun baur pada tanaman Ubi kayu, disebabkan oleh Cercospora. viscosae, dengan gejala antara lain Bercak daun."@id .

kbr:BercakDaunCoklatUbiKayu kbr:knowledgeType "entity_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bercak daun Coklat pada tanaman Ubi kayu, disebabkan oleh Cercospora henningsii, Cercosporidium henningsii, dengan gejala antara lain Bercak daun."@id .

kbr:BercakDaunPutihUbiKayu kbr:knowledgeType "entity_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Bercak daun putih pada tanaman Ubi kayu, disebabkan oleh Phaeoramularia manihotis, dengan gejala antara lain Bercak pada tanaman."@id .

kbr:BercakTanaman kbr:knowledgeType "entity_definition" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:definition "Bercak, noda, lesi, atau bintik pada jaringan tanaman tanpa bagian tanaman yang spesifik."@id .

kbr:Biji kbr:knowledgeType "entity_definition" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:definition "Unit perbanyakan tanaman yang terbentuk di dalam buah, polong, atau malai; dapat menunjukkan gejala bercak atau perubahan warna."@id .

kbr:BotryodiplodiaSpp kbr:knowledgeType "entity_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Jamur Botryodiplodia spp yang menyebabkan penyakit Busuk akar dan umbi, Busuk pangkal batang pada tanaman Ubi kayu."@id .

kbr:Buah kbr:knowledgeType "entity_definition" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:definition "Organ hasil perkembangan bunga yang mengandung biji; tempat munculnya gejala busuk atau bercak buah."@id .

kbr:BuktiGejala kbr:knowledgeType "entity_definition" ;
    dcterms:source "Dokumentasi TBox"@id ;
    skos:definition "Bukti untuk pengamatan gejala."@id .

kbr:BuktiPatogen kbr:knowledgeType "entity_definition" ;
    dcterms:source "Dokumentasi TBox"@id ;
