kbr:BuktiSumber kbr:knowledgeType "entity_definition" ;
    dcterms:source "Dokumentasi TBox"@id ;
    skos:definition "Node bukti yang menyimpan kutipan dan lokasi sumber."@id .

kbr:Buku kbr:knowledgeType "entity_definition" ;
    dcterms:source "Dokumentasi TBox"@id ;
    skos:definition "Referensi berbentuk buku."@id .

kbr:BusukAkar kbr:knowledgeType "entity_definition" ;
    dcterms:source "Kurasi pakar"@id ;
    skos:definition "Jaringan akar membusuk, berwarna coklat sampai hitam, sehingga penyerapan air dan hara terganggu."@id .

kbr:BusukAkarDanUmbiUbiKayu kbr:knowledgeType "entity_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
    skos:definition "Penyakit Busuk akar dan umbi pada tanaman Ubi kayu, disebabkan oleh Botryodiplodia spp, Diplodia spp, Phytophthora spp, Sclerotium rolfsii, dengan gejala antara lain Busuk akar, Pertumbuhan terhambat."@id .

kbr:BusukAkarUbiKayu kbr:knowledgeType "entity_definition" ;
    dcterms:source "Turunan relasi ontology"@id ;
