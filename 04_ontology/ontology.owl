    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBusukHitamBlackRotUbiJalarBusukAkar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkar"/>
    <rdfs:label xml:lang="id">Busuk akar pada Penyakit busuk hitam (black rot)</rdfs:label>
    <skos:prefLabel xml:lang="id">Busuk akar pada Penyakit busuk hitam (black rot)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BusukAkar"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Akar"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBusukHitamBlackRotUbiJalarPenyebaranHitamMelaluiLukaSetek"/>
    <ptp:deskripsiGejala xml:lang="id">Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020).</ptp:deskripsiGejala>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBusukHitamBlackRotUbiJalar"/>
  </rdf:Description>
