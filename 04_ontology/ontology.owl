  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#SuhuOptimal29Sampai32">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorRisiko"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorLingkungan"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Suhu"/>
    <rdfs:label xml:lang="id">Suhu optimal 29-32 °C</rdfs:label>
    <skos:prefLabel xml:lang="id">Suhu optimal 29-32 °C</skos:prefLabel>
    <skos:definition xml:lang="id">Saat panen, produsen sering memanen ubi jalar di bawah suhu dan kelembaban relatif dan pengeringan dilakukan di lapangan dengan kisaran suhu optimum 29 – 32° C dengan kelembaban 85%, di mana kondisi tersebut memungkinkan penyembuhan periderm secara cepat dan lengkap (Nielsen and Johnson, 1974).</skos:definition>
    <ptp:nilaiMin rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">29.0</ptp:nilaiMin>
    <ptp:nilaiMaks rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">32.0</ptp:nilaiMaks>
    <ptp:satuan xml:lang="id">°C</ptp:satuan>
    <ptp:tingkat xml:lang="id">tinggi</ptp:tingkat>
    <ptp:kondisi xml:lang="id">optimal</ptp:kondisi>
    <ptp:kutipanSumber xml:lang="id">Saat panen, produsen sering memanen ubi jalar di bawah suhu dan kelembaban relatif dan pengeringan dilakukan di lapangan dengan kisaran suhu optimum 29 – 32° C dengan kelembaban 85%, di mana kondisi tersebut memungkinkan penyembuhan periderm secara cepat dan lengkap (Nielsen and Johnson, 1974).</ptp:kutipanSumber>
    <ptp:halamanSumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80</ptp:halamanSumber>
    <ptp:idBlokSumber>DOC002_P080_B004</ptp:idBlokSumber>
    <prov:wasDerivedFrom>DOC002_P080_B004</prov:wasDerivedFrom>
  </rdf:Description>
