    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#EMBUNBULUKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianCassicolaEradikasiLahanDariSisaSisa_c176e873">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <rdfs:label xml:lang="id">cassicola, eradikasi lahan dari sisa-sisa tanaman yang terinfeksi patogen dan melakukan sanitasi lahan, melakukan pergiliran tanaman dengan tanaman yang bukan inang patogen C.</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">cassicola, eradikasi lahan dari sisa-sisa tanaman yang terinfeksi patogen dan melakukan sanitasi lahan, melakukan pergiliran tanaman dengan tanaman yang bukan inang patogen C.</ptp:deskripsiPengendalian>
