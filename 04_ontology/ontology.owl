  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBulaiJagungTepungDaun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Tepung pada daun</rdfs:label>
    <skos:prefLabel xml:lang="id">Tepung pada daun</skos:prefLabel>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#TepungDaun"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBulaiJagung"/>
    <ptp:deskripsiGejala xml:lang="id">Gejala bulai pada tanaman jagung ditandai dengan daun mengalami klorosis sejajar dengan tulang daun, pertumbuhan terhambat (kerdil), berbentuk kipas dan adanya lapisan tepung berwarna putih pada permukaan daun bagian bawah, yang biasanya hanya terlihat di pagi hari.</ptp:deskripsiGejala>
    <rdfs:comment xml:lang="id">Gejala tepung pada daun pada tanaman Jagung: Gejala bulai pada tanaman jagung ditandai dengan daun mengalami klorosis sejajar dengan tulang daun, pertumbuhan terhambat (kerdil), berbentuk kipas dan adanya lapisan tepung berwarna putih pada permukaan daun bagian bawah, yang biasanya hanya terlihat di pagi hari.</rdfs:comment>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBulaiJagung"/>
  </rdf:Description>
