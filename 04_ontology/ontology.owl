    <ptp:namaPengendalian xml:lang="id">Panen tepat waktu</ptp:namaPengendalian>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumUbiKayuUmbiTerjadiPascapanenDicegahWaktu"/>
    <ptp:deskripsiPengendalian xml:lang="id">Penyakit pada umbi yang terjadi pada pascapanen dapat dicegah dengan waktu panen pada usia tanaman dewasa (6-7 bulan setelah tanam), dan menghindari adanya pelukaan pada umbi pada waktu pemanenan.</ptp:deskripsiPengendalian>
  </rdf:Description>
