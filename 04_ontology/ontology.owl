  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaHawarBakteriUbiKayuMunculEksudatBergetahBerwarnaKrem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdfs:label xml:lang="id">Bukti gejala Hawar bakteri</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti gejala Hawar bakteri</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Muncul eksudat bergetah berwarna krem atau coklat kekuningan pada bagian batang yang terinfeksi, dan batang akan mati, meskipun adakalanya pada batang yang terinfeksi dan mati juga dapat memunculkan tunas baru</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Muncul eksudat bergetah berwarna krem atau coklat kekuningan pada bagian batang yang terinfeksi, dan batang akan mati, meskipun adakalanya pada batang yang terinfeksi dan mati juga dapat memunculkan tunas baru</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>T5.2_BATANG#2</ptp:identifierSumber>
    <ptp:idBlokSumber>DOC002_P094_B001</ptp:idBlokSumber>
    <ptp:halamanSumber>94</ptp:halamanSumber>
    <ptp:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ptp:catatanKualitas>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
