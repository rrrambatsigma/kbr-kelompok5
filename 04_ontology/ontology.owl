  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanKelembapan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <rdfs:label xml:lang="id">Pengaturan kelembapan</rdfs:label>
    <skos:prefLabel xml:lang="id">Pengaturan kelembapan</skos:prefLabel>
    <rdfs:comment xml:lang="id">Tindakan kanonik pengaturan kelembapan dan sirkulasi udara.</rdfs:comment>
    <ptp:namaPengendalian xml:lang="id">Pengaturan kelembapan</ptp:namaPengendalian>
    <skos:definition xml:lang="id">Mengatur kelembapan dan sirkulasi udara di sekitar tanaman atau ruang penyimpanan.</skos:definition>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:altLabel xml:lang="id">pengaturan kelembapan</skos:altLabel>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunJagung"/>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangHijau"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKaratDaunJagung2"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangHijau3"/>
    <ptp:deskripsiPengendalian xml:lang="id">Upaya pengendalian karat jagung dapat dilakukan dengan beberapa cara seperti jarak tanam yang tidak terlalu rapat dan penyiangan gulma rutin sehingga sirkulasi udara lebih baik dan kelembaban tidak terlalu tinggi.</ptp:deskripsiPengendalian>
  </rdf:Description>
