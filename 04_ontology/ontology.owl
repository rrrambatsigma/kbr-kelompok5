  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanWaktuTanam">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <rdfs:label xml:lang="id">Pengaturan waktu tanam</rdfs:label>
    <skos:prefLabel xml:lang="id">Pengaturan waktu tanam</skos:prefLabel>
    <rdfs:comment xml:lang="id">Tindakan kanonik pengaturan waktu atau keserempakan tanam.</rdfs:comment>
    <ptp:namaPengendalian xml:lang="id">Pengaturan waktu tanam</ptp:namaPengendalian>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitTungroPadi"/>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai"/>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBelangMottleKacangTanah"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitTungroPadiBerbagaiStrategiPengendalianDijelaskanBerikut"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiPengaturanWaktuTanamJarakTanam"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanahMengaturWaktuTanamTepatPopulasi"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanahWaktuTanamTepatBerbedaAgroekosistem"/>
    <ptp:deskripsiPengendalian xml:lang="id">Berbagai strategi pengendalian penyakit tungro dijelaskan sebagai berikut meliputi pemusnahan tanaman terinfeksi, penggunaan varietas tahan seperti Tukad Unda, Tukad Balian, Kalimas, dan Bondoyudo, penanaman serempak minimal 20 ha luasan sawah, serta penanaman sebelum puncak kepadatan wereng hijau (Puslitbangtan 2005).</ptp:deskripsiPengendalian>
  </rdf:Description>
