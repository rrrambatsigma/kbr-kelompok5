  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianRolfsiiDenganMelilitkanHifanyaDengan_43672907">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdfs:label xml:lang="id">rolfsii dengan melilitkan hifanya dengan membentuk haustorium pada hifa patogen kemudian menghasilkan enzim kitinase yang menyebabkan dinding sel patogen lisis dan rusak (Chamzurni et al., 2011).</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">rolfsii dengan melilitkan hifanya dengan membentuk haustorium pada hifa patogen kemudian menghasilkan enzim kitinase yang menyebabkan dinding sel patogen lisis dan rusak (Chamzurni et al., 2011).</ptp:deskripsiPengendalian>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitRebahSemaiKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaFimbriataPadaUmbiUbiJalar_7db4ad13">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkar"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaUmbi"/>
    <rdfs:label xml:lang="id">fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b).</rdfs:label>
    <ptp:deskripsiGejala xml:lang="id">fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b).</ptp:deskripsiGejala>
