  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaSuperelongasiUbiKayuNekrosisTanaman">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Nekrosis pada tanaman</rdfs:label>
    <skos:prefLabel xml:lang="id">Nekrosis pada tanaman</skos:prefLabel>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#NekrosisTanaman"/>
