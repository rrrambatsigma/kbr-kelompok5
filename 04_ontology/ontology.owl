    <ptp:kutipanSumber xml:lang="id">Bakteri Bacillus subtilis dan Pseudomonas fluorescens merupakan bakteri antagonis untuk menekan perkembangan penyakit hawar bakteri oleh patogen P.</ptp:kutipanSumber>
