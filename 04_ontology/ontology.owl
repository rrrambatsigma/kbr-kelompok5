    <rdfs:label xml:lang="id">Suhu maksimum 25 °C</rdfs:label>
    <skos:prefLabel xml:lang="id">Suhu maksimum 25 °C</skos:prefLabel>
    <skos:definition xml:lang="id">Urediospora bertahan hidup selama 20 hari di lapangan, pada suhu berkisar 25-28 °C, dan perkecambahan maksimum pada suhu 25 °C.</skos:definition>
    <ptp:nilaiTunggal rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25.0</ptp:nilaiTunggal>
