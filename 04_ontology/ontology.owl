    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdfs:label xml:lang="id">Ruang penyimpanan diatur pada suhu 13-16° C dengan kelembaban 85% agar perkembangan penyakit lambat (Clark and Moyer, 2013).</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">Ruang penyimpanan diatur pada suhu 13-16° C dengan kelembaban 85% agar perkembangan penyakit lambat (Clark and Moyer, 2013).</ptp:deskripsiPengendalian>
