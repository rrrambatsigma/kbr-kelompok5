  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangTanahHarzianumBerbagaiTempatDiisolasiTumbuh">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Bercak Daun</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Bercak Daun</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">harzianum dapat ditemukan di berbagai tempat, mudah diisolasi dan tumbuh cepat pada berbagai substrat, mampu hidup dan berkembang di rhizosfer dan dekat struktur istirahat patogen, mampu beradaptasi terhadap kondisi untuk dapat diperbanyak secara massal, dapat berperan sebagai biofertilizer dan biostimulan, dapat berperan sebagai biokontrol dengan mekanisme mikoparasit, antibiosis, kompetisi nutrisi dan induksi ketahanan tanaman.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">harzianum dapat ditemukan di berbagai tempat, mudah diisolasi dan tumbuh cepat pada berbagai substrat, mampu hidup dan berkembang di rhizosfer dan dekat struktur istirahat patogen, mampu beradaptasi terhadap kondisi untuk dapat diperbanyak secara massal, dapat berperan sebagai biofertilizer dan biostimulan, dapat berperan sebagai biokontrol dengan mekanisme mikoparasit, antibiosis, kompetisi nutrisi dan induksi ketahanan tanaman.</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>CTL_118</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C067_01</ptp:idChunkSumber>
    <ptp:halamanSumber>67</ptp:halamanSumber>
    <ptp:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ptp:catatanKualitas>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
