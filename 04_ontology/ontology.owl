    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuBakteriKacangTanahKeamananHayatiProdukPertanianSemakin"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumKacangTanahKeamananHayatiProdukPertanianSemakin"/>
    <ptp:deskripsiPengendalian xml:lang="id">Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati.</ptp:deskripsiPengendalian>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitRebahKecambahKedelaiAkibatAkarTerinfeksiKemudianMenyebar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Rebah Kecambah</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Rebah Kecambah</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Tanaman akan layu akibat akar tanaman busuk dan terinfeksi patogen kemudian menyebar pada pangkal batang sehingga menyebabkan rebah semai atau rebah kecambah (Gambar 2.3) (Hidayah and Yulianti, 2015).</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Tanaman akan layu akibat akar tanaman busuk dan terinfeksi patogen kemudian menyebar pada pangkal batang sehingga menyebabkan rebah semai atau rebah kecambah (Gambar 2.3) (Hidayah and Yulianti, 2015).</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
