    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Penyemprotan ekstrak lengkuas pada umur 4, 5, 6, dan 7 minggu setelah tanam dapat menekan intensitas penyakit bercak daun pada kacang hijau hingga 60%.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Penyemprotan ekstrak lengkuas pada umur 4, 5, 6, dan 7 minggu setelah tanam dapat menekan intensitas penyakit bercak daun pada kacang hijau hingga 60%.</ptp:kutipanNormalisasi>
