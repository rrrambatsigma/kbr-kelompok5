  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiKerdilTanaman">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Kerdil tanaman pada Penyakit Mosaik Kedelai (Soybean Mosaic Virus)</rdfs:label>
    <skos:prefLabel xml:lang="id">Kerdil tanaman pada Penyakit Mosaik Kedelai (Soybean Mosaic Virus)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KerdilTanaman"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiSMVMenunjukkanAdanyaUkuranMenjadi"/>
    <ptp:deskripsiGejala xml:lang="id">Secara umum infeksi patogen SMV pada tanaman akan menunjukkan gejala pada daun adanya mosaik, ukuran daun menjadi kecil, permukaannya tidak rata, daun seperti menggulung ke dalam dan adanya klorosis pada bagian tepi daun dan tanaman kadang-kadang menjadi terhambat pertumbuhannya atau kerdil (Gambar 2.17) (Andayanie, 2012).</ptp:deskripsiGejala>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitMosaikKedelaiSoybeanMosaicVirusKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitAntraknosaKedelaiPengendalianFungisidaSirihIntervalAplikasi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
