    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <rdfs:label xml:lang="id">solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian dengan hayati seperti pemanfaatan jamur antagonis Trichoderma virens.</rdfs:label>
    <skos:prefLabel xml:lang="id">solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian dengan hayati seperti pemanfaatan jamur antagonis Trichoderma virens.</skos:prefLabel>
    <skos:definition xml:lang="id">solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian dengan hayati seperti pemanfaatan jamur antagonis Trichoderma virens.</skos:definition>
    <ptp:deskripsiPengendalian xml:lang="id">solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian dengan hayati seperti pemanfaatan jamur antagonis Trichoderma virens.</ptp:deskripsiPengendalian>
    <ptp:namaPengendalian xml:lang="id">Trichoderma; Drainase</ptp:namaPengendalian>
    <ptp:kutipanSumber xml:lang="id">solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian dengan hayati seperti pemanfaatan jamur antagonis Trichoderma virens.</ptp:kutipanSumber>
