  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#VarietasDega1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas"/>
    <rdfs:label xml:lang="id">Dega 1</rdfs:label>
    <skos:prefLabel xml:lang="id">Dega 1</skos:prefLabel>
    <skos:definition xml:lang="id">Varietas Dega 1.</skos:definition>
    <ptp:kutipanSumber xml:lang="id">rolfsii diketahui bahwa Varietas Dena 1 tingkat keparahan penyakitnya lebih rendah dibandingkan dengan varietas Anjasmoro, Devon 1, Dering 1, Grobogan, dan Dega 1 yaitu 30% yang termasuk ke dalam varietas tahan.</ptp:kutipanSumber>
    <ptp:halamanSumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40</ptp:halamanSumber>
    <ptp:idBlokSumber>DOC002_C040_01</ptp:idBlokSumber>
    <prov:wasDerivedFrom>DOC002_C040_01</prov:wasDerivedFrom>
    <ptp:merupakanVarietasDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <ptp:tahanTerhadap rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#RebahSemaiKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakDaunKacangTanah">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdfs:label xml:lang="id">Penyakit Bercak Daun</rdfs:label>
    <skos:prefLabel xml:lang="id">Penyakit Bercak Daun</skos:prefLabel>
    <dcterms:identifier>DIS_021</dcterms:identifier>
    <dcterms:identifier>DIS_122</dcterms:identifier>
    <dcterms:source>DOC002</dcterms:source>
    <dcterms:source>DOC005</dcterms:source>
    <ptp:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuPenyakitTanamanDanPengendaliannya"/>
    <ptp:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuPenyakitUtamaPadaTanamanKedelaiKacangTanahDanKacangHijau"/>
    <ptp:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KacangTanah"/>
    <skos:altLabel xml:lang="id">BERCAK DAUN</skos:altLabel>
    <ptp:deskripsiPenyakit xml:lang="id">Penyakit bercak daun disebabkan oleh dua jenis cendawan, yaitu Cercospora arachidicola dan Cercospora personata (Bercak yang disebabkan oleh C. arachidicola berwarna coklat muda hingga coklat tua ditandai dengan warna kuning di sekitar bercak (halo kuning), sedangkan gejala akibat infeksi C. personata cenderung lebih hitam.</ptp:deskripsiPenyakit>
    <skos:definition xml:lang="id">Penyakit bercak daun disebabkan oleh dua jenis cendawan, yaitu Cercospora arachidicola dan Cercospora personata (Bercak yang disebabkan oleh C. arachidicola berwarna coklat muda hingga coklat tua ditandai dengan warna kuning di sekitar bercak (halo kuning), sedangkan gejala akibat infeksi C. personata cenderung lebih hitam.</skos:definition>
    <ptp:kutipanSumber xml:lang="id">Penyakit bercak daun disebabkan oleh dua jenis cendawan, yaitu Cercospora arachidicola dan Cercospora personata (Bercak yang disebabkan oleh C. arachidicola berwarna coklat muda hingga coklat tua ditandai dengan warna kuning di sekitar bercak (halo kuning), sedangkan gejala akibat infeksi C. personata cenderung lebih hitam.</ptp:kutipanSumber>
    <ptp:halamanSumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45</ptp:halamanSumber>
