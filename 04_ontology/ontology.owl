    <ptp:disebabkanOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Ipomovirus"/>
    <ptp:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaCassavaBrownStreakDiseaseCBSDUbiKayuBercakDaun"/>
    <ptp:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaCassavaBrownStreakDiseaseCBSDUbiKayuKlorosisDaun"/>
