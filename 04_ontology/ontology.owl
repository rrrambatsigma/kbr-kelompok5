  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanLayuFusariumUbiJalarFusariumUmbiBerupaKankerMelingkar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaUmbi"/>
    <rdfs:label xml:lang="id">Pengamatan gejala layu fusarium</rdfs:label>
    <skos:prefLabel xml:lang="id">Pengamatan gejala layu fusarium</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang belum dipetakan ke konsep kanonik.</rdfs:comment>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Umbi"/>
    <ptp:deskripsiGejala xml:lang="id">Gejala serangan Fusarium pada umbi ubi jalar berupa kanker melingkar permukaan yang minimal memengaruhi jaringan di bawahnya, berwarna coklat pucat sampai kehitaman kering, rerata diameter awalnya 2-4 mm, luka dapat tumbuh dan berkembang menghasilkan area gelap yang lebih luas (Gambar 2A).</ptp:deskripsiGejala>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaLayuFusariumUbiJalarFusariumUmbiBerupaKankerMelingkar"/>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#LayuFusariumUbiJalar"/>
  </rdf:Description>
