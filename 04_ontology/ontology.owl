  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianAplikasiFungisidaSAAFYaituFungisida_3cf9cef0">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKimiawi"/>
    <rdfs:label xml:lang="id">Aplikasi fungisida SAAF yaitu fungisida berbahan aktif Karbendazim 12% + fungisida berbahan aktif Mancozeb 63% dengan konsentrasi 2,5 gram/liter menekan perkembangan penyakit 29,67% (Subedi et al., 2015).</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">Aplikasi fungisida SAAF yaitu fungisida berbahan aktif Karbendazim 12% + fungisida berbahan aktif Mancozeb 63% dengan konsentrasi 2,5 gram/liter menekan perkembangan penyakit 29,67% (Subedi et al., 2015).</ptp:deskripsiPengendalian>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitAntraknosaKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianRolfsiiDiketahuiBahwaVarietasDena_d314aa09">
