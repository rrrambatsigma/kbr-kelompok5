  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianNaqvi2019TidakDianjurkanMemotong_d9cb40d7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdfs:label xml:lang="id">Naqvi 2019), tidak dianjurkan memotong bibit sebelum tanah supaya mencegah terjadinya infeksi patogen dan pola tanam dianjurkan memakai sistem legowo dengan sistem pengairan berselang.</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">Naqvi 2019), tidak dianjurkan memotong bibit sebelum tanah supaya mencegah terjadinya infeksi patogen dan pola tanam dianjurkan memakai sistem legowo dengan sistem pengairan berselang.</ptp:deskripsiPengendalian>
