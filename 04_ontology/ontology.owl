  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PanenTepatWaktu">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <rdfs:label xml:lang="id">Panen tepat waktu</rdfs:label>
    <skos:prefLabel xml:lang="id">Panen tepat waktu</skos:prefLabel>
    <rdfs:comment xml:lang="id">Tindakan kanonik panen pada waktu yang dianjurkan.</rdfs:comment>
    <ptp:namaPengendalian xml:lang="id">Panen tepat waktu</ptp:namaPengendalian>
    <skos:definition xml:lang="id">Melakukan panen pada waktu yang dianjurkan untuk mengurangi kehilangan hasil dan infeksi pascapanen.</skos:definition>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:altLabel xml:lang="id">panen tepat waktu</skos:altLabel>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumUbiKayu5"/>
    <ptp:deskripsiPengendalian xml:lang="id">Penyakit pada umbi yang terjadi pada pascapanen dapat dicegah dengan waktu panen pada usia tanaman dewasa (6-7 bulan setelah tanam), dan menghindari adanya pelukaan pada umbi pada waktu pemanenan.</ptp:deskripsiPengendalian>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengaturanJarakTanam">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <rdfs:label xml:lang="id">Pengaturan jarak tanam</rdfs:label>
    <skos:prefLabel xml:lang="id">Pengaturan jarak tanam</skos:prefLabel>
    <rdfs:comment xml:lang="id">Tindakan kanonik pengaturan jarak atau kerapatan tanam.</rdfs:comment>
    <ptp:namaPengendalian xml:lang="id">Pengaturan jarak tanam</ptp:namaPengendalian>
    <skos:definition xml:lang="id">Mengatur jarak atau kerapatan tanam agar sirkulasi udara dan cahaya lebih baik.</skos:definition>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:altLabel xml:lang="id">pengaturan jarak tanam</skos:altLabel>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitHawarPelepahDaunPadi"/>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai"/>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunJagung"/>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangHijau"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarPelepahDaunPadi"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottle3"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKaratDaunJagung2"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangHijau3"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumUbiKayu3"/>
    <ptp:deskripsiPengendalian xml:lang="id">Beberapa pengendalian penyakit hawar daun bakteri pada padi, di antaranya Kultur teknis, melalui pengaturan jarak tanam tidak terlalu rapat, pengeringan sawah beberapa hari pada saat anakan maksimum, pemusnahan atau pengomposan sisa-sisa tanaman yang terinfeksi (Puslitbangtan 2005).</ptp:deskripsiPengendalian>
  </rdf:Description>
