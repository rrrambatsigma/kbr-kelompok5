  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedela6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Bercak Daun Mata Katak (Frogeye Leaf Spot) (Kedelai)</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Bercak Daun Mata Katak (Frogeye Leaf Spot) (Kedelai)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Gejala yang muncul pada tanaman adalah adanya bercak atau bintik-bintik kecil dengan bagian tengah pada bintik berwarna lebih terang.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Gejala yang muncul pada tanaman adalah adanya bercak atau bintik-bintik kecil dengan bagian tengah pada bintik berwarna lebih terang.</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>SYM_069</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C047_02</ptp:idChunkSumber>
    <ptp:halamanSumber>47</ptp:halamanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitRebahSemaiKedelai2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Rebah Semai (Kedelai)</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Rebah Semai (Kedelai)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">rolfsii memiliki kisaran inang yang luas seperti famili leguminoceae, Cruciferaceae, Cucurbitaceae, tanaman pisang, jeruk, gandum, padi, tebu, bit, keladi, bahkan tanaman rempah (Sumartini, 2012).</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">rolfsii memiliki kisaran inang yang luas seperti famili leguminoceae, Cruciferaceae, Cucurbitaceae, tanaman pisang, jeruk, gandum, padi, tebu, bit, keladi, bahkan tanaman rempah (Sumartini, 2012).</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>CTL_031</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C040_01</ptp:idChunkSumber>
    <ptp:halamanSumber>40</ptp:halamanSumber>
    <ptp:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ptp:catatanKualitas>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
