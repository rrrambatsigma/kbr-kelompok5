    <skos:prefLabel xml:lang="en">stem rot</skos:prefLabel>
    <rdfs:comment xml:lang="id">Konsep kanonik untuk pembusukan pada batang atau pelepah.</rdfs:comment>
    <skos:altLabel xml:lang="id">busuk batang</skos:altLabel>
    <skos:altLabel xml:lang="id">busuk pangkal batang</skos:altLabel>
    <skos:altLabel xml:lang="id">busuk pelepah</skos:altLabel>
    <ptp:kodeGejala>BusukBatang</ptp:kodeGejala>
    <skos:definition xml:lang="id">Jaringan batang atau pelepah membusuk, berwarna coklat sampai hitam, dan dapat menyebabkan tanaman rebah atau mati.</skos:definition>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:broader rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KategoriPembusukan"/>
