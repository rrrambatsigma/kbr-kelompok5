  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaMenurutSemangun1991GejalaTanaman_c63f9ed4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Menurut Semangun, 1991 gejala tanaman yang terinfeksi oleh penyakit terdapat bercak coklat kecil pada daun bawah yang memiliki bentuk bulat yang tidak beraturan.</rdfs:label>
    <ptp:deskripsiGejala xml:lang="id">Menurut Semangun, 1991 gejala tanaman yang terinfeksi oleh penyakit terdapat bercak coklat kecil pada daun bawah yang memiliki bentuk bulat yang tidak beraturan.</ptp:deskripsiGejala>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangTanah"/>
  </rdf:Description>
