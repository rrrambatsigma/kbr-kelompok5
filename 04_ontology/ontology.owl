    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaTanamanKerdilStuntUbiKayu"/>
    <ptp:deskripsiGejala xml:lang="id">Tanaman tidak tumbuh secara normal, gejala ini umumnya terjadi pada tanaman yang mengalami infeksi awal oleh virus ini. Tanaman yang terinfeksi virus ini umumnya akan memiliki batang yang berukuran kecil</ptp:deskripsiGejala>
    <rdfs:comment xml:lang="id">Gejala kerdil tanaman pada tanaman Ubi kayu: Tanaman tidak tumbuh secara normal, gejala ini umumnya terjadi pada tanaman yang mengalami infeksi awal oleh virus ini. Tanaman yang terinfeksi virus ini umumnya akan memiliki batang yang berukuran kecil</rdfs:comment>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#TanamanKerdilStuntUbiKayu"/>
  </rdf:Description>
