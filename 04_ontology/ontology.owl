  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CurahHujanTinggi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorRisiko"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorLingkungan"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CurahHujan"/>
    <rdfs:label xml:lang="id">Curah hujan tinggi</rdfs:label>
    <skos:prefLabel xml:lang="id">Curah hujan tinggi</skos:prefLabel>
    <skos:definition xml:lang="id">dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017).</skos:definition>
    <ptp:tingkat xml:lang="id">tinggi</ptp:tingkat>
    <ptp:kondisi xml:lang="id">tinggi</ptp:kondisi>
    <ptp:kutipanSumber xml:lang="id">dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017).</ptp:kutipanSumber>
    <ptp:halamanSumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">42</ptp:halamanSumber>
    <ptp:idBlokSumber>DOC002_P042_B003</ptp:idBlokSumber>
    <prov:wasDerivedFrom>DOC002_P042_B003</prov:wasDerivedFrom>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianBakteriPustulKedelai">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdfs:label xml:lang="id">Pengendalian dapat dilakukan dengan penggunaan benih yang bebas dari patogen, tindakan eradikasi terhadap sumber inokulum juga dapat menjadi salah satu tindakan penekanan perkembangan penyakit bakteri pustul pada tanaman kedelai (Inayati and Yusnawan, 2017).</rdfs:label>
    <skos:prefLabel xml:lang="id">Pengendalian dapat dilakukan dengan penggunaan benih yang bebas dari patogen, tindakan eradikasi terhadap sumber inokulum juga dapat menjadi salah satu tindakan penekanan perkembangan penyakit bakteri pustul pada tanaman kedelai (Inayati and Yusnawan, 2017).</skos:prefLabel>
    <skos:definition xml:lang="id">Pengendalian dapat dilakukan dengan penggunaan benih yang bebas dari patogen, tindakan eradikasi terhadap sumber inokulum juga dapat menjadi salah satu tindakan penekanan perkembangan penyakit bakteri pustul pada tanaman kedelai (Inayati and Yusnawan, 2017).</skos:definition>
