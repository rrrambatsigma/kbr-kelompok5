    <ptp:tingkat xml:lang="id">sedang</ptp:tingkat>
    <ptp:kondisi xml:lang="id">maksimum</ptp:kondisi>
    <ptp:kutipanSumber xml:lang="id">Urediospora bertahan hidup selama 20 hari di lapangan, pada suhu berkisar 25-28 °C, dan perkecambahan maksimum pada suhu 25 °C.</ptp:kutipanSumber>
    <ptp:halamanSumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">39</ptp:halamanSumber>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianBercakDaunKacangTanahBerpotensiBahanPestisidaAntaranyaMemiliki">
