    <owl:inverseOf rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#menyebabkanPenyakit"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianPengendalianHayatiDenganAgensBiokontrol_52af804f">
