  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayuBercakT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPucuk"/>
    <rdfs:label xml:lang="id">Bercak pada tanaman</rdfs:label>
    <skos:prefLabel xml:lang="id">Bercak pada tanaman</skos:prefLabel>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakTanaman"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pucuk"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaNekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu"/>
    <ptp:deskripsiGejala xml:lang="id">Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas</ptp:deskripsiGejala>
    <rdfs:comment xml:lang="id">Gejala bercak pada tanaman pada tanaman Ubi kayu: Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas</rdfs:comment>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#NekrosisPadaTitikTunasCassavaBudNecrosisUbiKayu"/>
  </rdf:Description>
