    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitRebahSemaiKedelai4"/>
    <ptp:deskripsiGejala xml:lang="id">rolfsii adalah tanaman akan layu, kemudian daun menjadi layu dan menguning, kemudian pada bagian pangkal akar akan muncul tanda berupa kumpulan hifa jamur yang berwarna putih (Gambar 2.1).</ptp:deskripsiGejala>
    <rdfs:comment xml:lang="id">Gejala klorosis daun pada tanaman Kedelai: rolfsii adalah tanaman akan layu, kemudian daun menjadi layu dan menguning, kemudian pada bagian pangkal akar akan muncul tanda berupa kumpulan hifa jamur yang berwarna putih (Gambar 2.1).</rdfs:comment>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitRebahSemaiKedelai"/>
  </rdf:Description>
