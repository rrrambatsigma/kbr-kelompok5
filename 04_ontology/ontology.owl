  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianSelainItuPemanfaatanTanamanSebagai_376eba43">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdfs:label xml:lang="id">Selain itu, pemanfaatan tanaman sebagai fungisida nabati dapat menggunakan ekstrak Zingeber officinale, Portulaca oleracea dan Impatiens balsamina dengan larutan etanol atau aseton mampu menghambat pertumbuhan jamur S.</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">Selain itu, pemanfaatan tanaman sebagai fungisida nabati dapat menggunakan ekstrak Zingeber officinale, Portulaca oleracea dan Impatiens balsamina dengan larutan etanol atau aseton mampu menghambat pertumbuhan jamur S.</ptp:deskripsiPengendalian>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKudisUbiJalar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianPestisidaMerupakanBahanAtauZat_90d7f35f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdfs:label xml:lang="id">Pestisida merupakan bahan atau zat kimia yang berguna untuk mengendalikan populasi hama yang menyerang pada tumbuhan.</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">Pestisida merupakan bahan atau zat kimia yang berguna untuk mengendalikan populasi hama yang menyerang pada tumbuhan.</ptp:deskripsiPengendalian>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangTanah"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#menyerangBagian">
