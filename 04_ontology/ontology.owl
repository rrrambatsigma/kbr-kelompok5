    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanah8"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanah12"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanah13"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuBakteriKacangTanah2"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuStewartJagung9"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitEmbunPalsuDownyMildewKedelai3"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitAntraknosaKedelai6"/>
    <ptp:deskripsiPengendalian xml:lang="id">Penggunaan benih sehat yang bebas penyakit, dapat pula dilakukan perlakuan benih dengan larutan amonium sulfat maupun larutan garam untuk memisahkan benih yang cukup matang kemudian dilanjutkan dengan desinfeksi benih dengan fungisida Praktik budidaya diperhatikan untuk mencegah padi terinfeksi blas seperti pengaturan pengairan supaya tidak terjadi kekeringan karena padi rentan blas saat kekeringan.</ptp:deskripsiPengendalian>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBakteriPustulKedelaiDaunRontok">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
