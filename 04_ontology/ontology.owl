  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiMosaikDaun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Mosaik daun pada Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)</rdfs:label>
    <skos:prefLabel xml:lang="id">Mosaik daun pada Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#MosaikDaun"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiDitunjukkanCMMVTerdapatBelangSistemik"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiIntensitasMakaMunculTerdapatDiikuti"/>
    <ptp:deskripsiGejala xml:lang="id">Gejala yang ditunjukkan oleh patogen CMMV pada tanaman kedelai adalah pada daun tanaman terdapat belang secara sistemik, bagian tulang daun terdapat klorosis serta daun yang terinfeksi CMMV mengalami malformasi (Gambar 2.18).</ptp:deskripsiGejala>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitEmbunTepungPowderyMildewKedelaiDiffusaMenginfeksiBagianBawahPermukaan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Embun Tepung (Powdery Mildew)</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Embun Tepung (Powdery Mildew)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">diffusa menginfeksi daun kedelai bagian bawah sehingga pada permukaan daun bagian bawah terdapat bercak berwarna putih seperti tepung yang merupakan kumpulan dari konidia dan konidiofor patogen E.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">diffusa menginfeksi daun kedelai bagian bawah sehingga pada permukaan daun bagian bawah terdapat bercak berwarna putih seperti tepung yang merupakan kumpulan dari konidia dan konidiofor patogen E.</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>SYM_057</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C045_01</ptp:idChunkSumber>
    <ptp:halamanSumber>45</ptp:halamanSumber>
    <ptp:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ptp:catatanKualitas>
