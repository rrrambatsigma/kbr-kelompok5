  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBulaiJagungKerdilTanaman">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdfs:label xml:lang="id">Kerdil tanaman</rdfs:label>
    <skos:prefLabel xml:lang="id">Kerdil tanaman</skos:prefLabel>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KerdilTanaman"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBulaiJagung"/>
    <ptp:deskripsiGejala xml:lang="id">Gejala bulai pada tanaman jagung ditandai dengan daun mengalami klorosis sejajar dengan tulang daun, pertumbuhan terhambat (kerdil), berbentuk kipas dan adanya lapisan tepung berwarna putih pada permukaan daun bagian bawah, yang biasanya hanya terlihat di pagi hari.</ptp:deskripsiGejala>
    <rdfs:comment xml:lang="id">Gejala kerdil tanaman pada tanaman Jagung: Gejala bulai pada tanaman jagung ditandai dengan daun mengalami klorosis sejajar dengan tulang daun, pertumbuhan terhambat (kerdil), berbentuk kipas dan adanya lapisan tepung berwarna putih pada permukaan daun bagian bawah, yang biasanya hanya terlihat di pagi hari.</rdfs:comment>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBulaiJagung"/>
  </rdf:Description>
