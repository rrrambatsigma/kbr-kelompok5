  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiLingkunganLayuFusariumUbiJalarPanenProdusenSeringMemanenBawah">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdfs:label xml:lang="id">Bukti faktor lingkungan layu fusarium</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti faktor lingkungan layu fusarium</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Saat panen, produsen sering memanen ubi jalar di bawah suhu dan kelembaban relatif dan pengeringan dilakukan di lapangan dengan kisaran suhu optimum 29 – 32° C dengan kelembaban 85%, di mana kondisi tersebut memungkinkan penyembuhan periderm secara cepat dan lengkap (Nielsen and Johnson, 1974).</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Saat panen, produsen sering memanen ubi jalar di bawah suhu dan kelembaban relatif dan pengeringan dilakukan di lapangan dengan kisaran suhu optimum 29 - 32° C dengan kelembaban 85%, di mana kondisi tersebut memungkinkan penyembuhan periderm secara cepat dan lengkap (Nielsen and Johnson, 1974).</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>CTL_187</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C082_02</ptp:idChunkSumber>
    <ptp:halamanSumber>82</ptp:halamanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKerdilKedelaiSoybeanStuntVirusKedelaiMenusukkanAlatMulutStyletSehat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Kerdil Kedelai (Soybean Stunt Virus)</rdfs:label>
