  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#CassavaBrownStreakDiseaseCBSDUbiKayu">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdfs:label xml:lang="id">Cassava Brown Streak Disease (CBSD)</rdfs:label>
    <skos:prefLabel xml:lang="id">Cassava Brown Streak Disease (CBSD)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Cassava brown streak disease</skos:prefLabel>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <skos:altLabel xml:lang="en">Cassava brown streak disease</skos:altLabel>
    <skos:definition xml:lang="id">Penyakit Cassava Brown Streak Disease (CBSD) pada tanaman Ubi kayu, disebabkan oleh Ipomovirus, dengan gejala antara lain Bercak daun, Klorosis daun.</skos:definition>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <ptp:identifierSumber>DIS_035</ptp:identifierSumber>
