    <rdfs:label xml:lang="id">Infeksi patogen pada bagian batang dekat permukaan tanah (pangkal batang), dan menyebabkan pangkal batang membusuk sehingga tanaman layu.</rdfs:label>
    <ptp:deskripsiGejala xml:lang="id">Infeksi patogen pada bagian batang dekat permukaan tanah (pangkal batang), dan menyebabkan pangkal batang membusuk sehingga tanaman layu.</ptp:deskripsiGejala>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
