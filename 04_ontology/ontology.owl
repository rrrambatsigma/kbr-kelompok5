  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianPemberianPupukKaliumJugaDapat_0c028f55">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <rdfs:label xml:lang="id">Pemberian pupuk kalium juga dapat menurunkan laju infeksi, kejadian dan keparahan penyakit bulai karena kalium membantu pengaturan membuka dan menutupnya stomata dan membentuk senyawa lignin sehingga dinding sel menjadi lebih tebal dan sulit ditembus oleh jamur patogen (Habibi et al., 2017).</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">Pemberian pupuk kalium juga dapat menurunkan laju infeksi, kejadian dan keparahan penyakit bulai karena kalium membantu pengaturan membuka dan menutupnya stomata dan membentuk senyawa lignin sehingga dinding sel menjadi lebih tebal dan sulit ditembus oleh jamur patogen (Habibi et al., 2017).</ptp:deskripsiPengendalian>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBulaiJagung"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaInangKeduaPatogenIniHanya_871e0176">
