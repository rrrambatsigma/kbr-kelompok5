    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Selain perubahan warna, tampak pula bintik-bintik atau bercak coklat tua pada daun yang bergejala kerdil hampa bila pupuk nitrogen yang diberikan tidak berimbang (Sari, 2019).</rdfs:label>
    <ptp:deskripsiGejala xml:lang="id">Selain perubahan warna, tampak pula bintik-bintik atau bercak coklat tua pada daun yang bergejala kerdil hampa bila pupuk nitrogen yang diberikan tidak berimbang (Sari, 2019).</ptp:deskripsiGejala>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKerdilRumputDanKerdilHampaPadi"/>
  </rdf:Description>
