    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSelainPerubahanWarnaTampakPula"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSementaraHampaSelainMudaBergigi"/>
    <ptp:deskripsiGejala xml:lang="id">Gejala yang khas dari penyakit kerdil rumput yaitu kerdil dengan jumlah anakan banyak, bentuk daun pendek dan sempit, bagian batang tumbuh menjadi tegak dan kaku, serta diskolorasi daun (Gambar 1.7).</ptp:deskripsiGejala>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKerdilRumputDanKerdilHampaPadi"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarDaunJagungHalKondisiSanitasiBurukBanyaknya">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
