    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdfs:label xml:lang="id">Tingginya harga antibiotik dan adanya permintaan produk pertanian yang bebas residu pestisida, telah membatasi penerapan pengendalian kimiawi di beberapa negara seperti Mesir dan Eropa.</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">Tingginya harga antibiotik dan adanya permintaan produk pertanian yang bebas residu pestisida, telah membatasi penerapan pengendalian kimiawi di beberapa negara seperti Mesir dan Eropa.</ptp:deskripsiPengendalian>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLayuBakteriKacangTanah"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaInangKeduaPatogenIniHanya_871e0176">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
