    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Temaja et al., (2017) melaporkan kejadian penyakit layu stewart di Bali antara 11% hingga 23%, dengan keparahan penyakit antara 3% hingga 10% yang dapat dikatakan masih ringan.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Temaja et al., (2017) melaporkan kejadian penyakit layu stewart di Bali antara 11% hingga 23%, dengan keparahan penyakit antara 3% hingga 10% yang dapat dikatakan masih ringan.</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>SYM_202</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C107_02</ptp:idChunkSumber>
    <ptp:halamanSumber>107</ptp:halamanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitLayuStewartJagung3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
