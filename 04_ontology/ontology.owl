    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLayuKacangHijau"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitRebahSemaiKedelai14"/>
