  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBercakKuningUbiJalarBercakDaun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Bercak daun pada Penyakit bercak kuning</rdfs:label>
    <skos:prefLabel xml:lang="id">Bercak daun pada Penyakit bercak kuning</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakDaun"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBercakKuningUbiJalarAdapunLapanganKadangKadangTidak"/>
    <ptp:deskripsiGejala xml:lang="id">Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018).</ptp:deskripsiGejala>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakKuningUbiJalar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKaratDaunKacangTanahBercakDaun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Bercak daun pada KARAT</rdfs:label>
    <skos:prefLabel xml:lang="id">Bercak daun pada KARAT</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakDaun"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKaratDaunKacangTanahAwalDitandaiMunculnyaKlorotikKecil"/>
    <ptp:deskripsiGejala xml:lang="id">Gejala awal penyakit karat di kacang tanah ditandai dengan munculnya bercak klorotik kecil pada permukaan bawah daun, yang bentuknya tidak beraturan.</ptp:deskripsiGejala>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunKacangTanah"/>
  </rdf:Description>
