  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiLingkunganPenyakitRebahKecambahKedelaiSolaniDilakukanTeknikPengendalianKultur">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdfs:label xml:lang="id">Bukti faktor lingkungan Penyakit Rebah Kecambah</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti faktor lingkungan Penyakit Rebah Kecambah</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian dengan hayati seperti pemanfaatan jamur antagonis Trichoderma virens.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian dengan hayati seperti pemanfaatan jamur antagonis Trichoderma virens.</ptp:kutipanNormalisasi>
