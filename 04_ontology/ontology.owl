    <rdfs:label xml:lang="id">Fase vegetatif</rdfs:label>
    <skos:prefLabel xml:lang="id">Fase vegetatif</skos:prefLabel>
    <skos:prefLabel xml:lang="en">vegetative stage</skos:prefLabel>
    <rdfs:comment xml:lang="id">Fase pertumbuhan yang disebut pada sumber.</rdfs:comment>
    <skos:definition xml:lang="id">Tahap pertumbuhan akar, batang, dan daun sebelum tanaman memasuki pembungaan atau pembuahan.</skos:definition>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:altLabel xml:lang="id">pertumbuhan vegetatif</skos:altLabel>
