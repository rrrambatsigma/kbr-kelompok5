    <prov:wasDerivedFrom>DOC002_C087_02</prov:wasDerivedFrom>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Akar"/>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BusukHitamBlackRotUbiJalar"/>
  </rdf:Description>
