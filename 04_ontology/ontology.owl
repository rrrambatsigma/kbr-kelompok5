  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitEmbunPalsuDownyMildewKedelaiBuluDiawaliMunculnyaPermukaanBagian">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Embun Palsu (Downy mildew)</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Embun Palsu (Downy mildew)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Penyakit embun bulu diawali munculnya gejala pada permukaan daun bagian atas berupa bercak berwarna kuning pucat, kemudian berubah menjadi kuning kecoklatan dengan warna agak kekuningan di sekeliling bercak (Gambar 4).</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Penyakit embun bulu diawali munculnya gejala pada permukaan daun bagian atas berupa bercak berwarna kuning pucat, kemudian berubah menjadi kuning kecoklatan dengan warna agak kekuningan di sekeliling bercak (Gambar 4).</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC005</ptp:dokumenSumber>
    <ptp:identifierSumber>SYM_612</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC005_C026_02</ptp:idChunkSumber>
    <ptp:halamanSumber>26</ptp:halamanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC005"/>
  </rdf:Description>
