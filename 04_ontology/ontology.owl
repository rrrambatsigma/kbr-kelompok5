  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiMetadataVarietyPenyakitKaratDaunJagung">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdfs:label xml:lang="id">Bukti metadata variety Penyakit Karat Daun (Jagung)</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti metadata variety Penyakit Karat Daun (Jagung)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Varietas jagung yang diketahui tahan terhadap karat yaitu enam varietas bersari bebas (Bisma, Lamuru, Palakka, Sukmaraga, Srikandi Putih-1, dan Srikandi Kuning-1) dan 19 jagung hibrida (Semar-5, 6, 7, 8, 9,10, Bima-1, 4, 5, 7, 8, 9, 10, 11, 16,17, 18, Bima 19-URI dan Bima 20 URI (Burhanuddin, 2015).</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Varietas jagung yang diketahui tahan terhadap karat yaitu enam varietas bersari bebas (Bisma, Lamuru, Palakka, Sukmaraga, Srikandi Putih-1, dan Srikandi Kuning-1) dan 19 jagung hibrida (Semar-5, 6, 7, 8, 9,10, Bima-1, 4, 5, 7, 8, 9, 10, 11, 16,17, 18, Bima 19-URI dan Bima 20 URI (Burhanuddin, 2015).</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>DOC002_P104_B005</ptp:identifierSumber>
    <ptp:halamanSumber>104</ptp:halamanSumber>
    <ptp:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ptp:catatanKualitas>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
