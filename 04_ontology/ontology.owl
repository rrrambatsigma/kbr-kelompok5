    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitRebahSemaiKedelaiBatangDisebabkanS"/>
    <ptp:deskripsiGejala xml:lang="id">Gejala selanjutnya adalah batang tanaman menjadi busuk dan lama-lama tanaman akan mati (Astiko et al., 2017).</ptp:deskripsiGejala>
