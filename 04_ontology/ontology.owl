    <rdfs:label xml:lang="id">Bukti gejala layu fusarium</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti gejala layu fusarium</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Tanaman merambat berwarna kecokelatan (1B dan E), tanaman yang mati sering terdapat miselium berwarna merah muda dengan makrokonidia dan mikrokonidia patogen (1C dan F).</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Tanaman merambat berwarna kecokelatan (1B dan E), tanaman yang mati sering terdapat miselium berwarna merah muda dengan makrokonidia dan mikrokonidia patogen (1C dan F).</ptp:kutipanNormalisasi>
