  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuBakteriKacangTanahTingginyaHargaAntibiotikAdanyaPermintaan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Layu Bakteri</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Layu Bakteri</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Tingginya harga antibiotik dan adanya permintaan produk pertanian yang bebas residu pestisida, telah membatasi penerapan pengendalian kimiawi di beberapa negara seperti Mesir dan Eropa.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Tingginya harga antibiotik dan adanya permintaan produk pertanian yang bebas residu pestisida, telah membatasi penerapan pengendalian kimiawi di beberapa negara seperti Mesir dan Eropa.</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>CTL_182</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C077_02</ptp:idChunkSumber>
    <ptp:halamanSumber>77</ptp:halamanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarBakteriBacterialBlightKedelaiMenghilangkanMenjadiInokulumMelakukanSeed">
