    <ptp:identifierSumber>CTL_018</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C032_03</ptp:idChunkSumber>
    <ptp:halamanSumber>32</ptp:halamanSumber>
    <ptp:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ptp:catatanKualitas>
