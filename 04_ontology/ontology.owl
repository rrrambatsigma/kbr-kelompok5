  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#MosaikKedelaiSoybeanMosaicVirusKedelai">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdfs:label xml:lang="id">Penyakit Mosaik Kedelai (Soybean Mosaic Virus)</rdfs:label>
    <skos:prefLabel xml:lang="id">Penyakit Mosaik Kedelai (Soybean Mosaic Virus)</skos:prefLabel>
    <dcterms:identifier>DIS_018</dcterms:identifier>
    <dcterms:source>DOC002</dcterms:source>
    <ptp:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuPenyakitTanamanDanPengendaliannya"/>
    <ptp:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <skos:altLabel xml:lang="id">Soybean Mosaic Virus</skos:altLabel>
    <ptp:namaInggrisPenyakit xml:lang="id">Soybean Mosaic Virus</ptp:namaInggrisPenyakit>
    <ptp:deskripsiPenyakit xml:lang="id">Penyakit mosaik kedelai (soybean mosaic virus) atau SMV disebabkan oleh infeksi patogen dari golongan virus. Dapat menyerang tanaman kedelai sejak dari benih disemai. Patogen SMV dapat terbawa oleh benih yang ditanam (seed borne disease).</ptp:deskripsiPenyakit>
    <skos:definition xml:lang="id">Penyakit mosaik kedelai (soybean mosaic virus) atau SMV disebabkan oleh infeksi patogen dari golongan virus. Dapat menyerang tanaman kedelai sejak dari benih disemai. Patogen SMV dapat terbawa oleh benih yang ditanam (seed borne disease).</skos:definition>
    <ptp:kutipanSumber xml:lang="id">Penyakit mosaik kedelai (soybean mosaic virus) atau SMV disebabkan oleh infeksi patogen dari golongan virus. Dapat menyerang tanaman kedelai sejak dari benih disemai. Patogen SMV dapat terbawa oleh benih yang ditanam (seed borne disease).</ptp:kutipanSumber>
    <ptp:halamanSumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">57</ptp:halamanSumber>
    <ptp:idBlokSumber>DOC002_P057_B008</ptp:idBlokSumber>
    <prov:wasDerivedFrom>DOC002_P057_B008</prov:wasDerivedFrom>
