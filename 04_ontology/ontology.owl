    <rdfs:label xml:lang="id">Bukti pengendalian umum Kacang tanah</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti pengendalian umum Kacang tanah</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Sejumlah tanaman yang dapat digunakan sebagai bahan baku pestisida nabati seperti daun pepaya, brotowali, bawang putih, mimba, kipait, saliara, suren, jarak pagar, daun kemangi.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Sejumlah tanaman yang dapat digunakan sebagai bahan baku pestisida nabati seperti daun pepaya, brotowali, bawang putih, mimba, kipait, saliara, suren, jarak pagar, daun kemangi.</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>CTL_459</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C067_01</ptp:idChunkSumber>
