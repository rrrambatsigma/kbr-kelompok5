  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengairanDanDrainase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <rdfs:label xml:lang="id">Pengairan dan drainase</rdfs:label>
    <skos:prefLabel xml:lang="id">Pengairan dan drainase</skos:prefLabel>
    <rdfs:comment xml:lang="id">Tindakan kanonik pengaturan air, irigasi, dan drainase.</rdfs:comment>
    <ptp:namaPengendalian xml:lang="id">Pengairan dan drainase</ptp:namaPengendalian>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitHawarDaunBakteriPadi"/>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBlasPadi"/>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitRebahKecambahKedelai"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarDaunBakteriPadiNaqvi2019TidakMemotongBibit"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBlasPadiPenggunaanBenihSehatBebasPula"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitRebahKecambahKedelaiSolaniDilakukanTeknikPengendalianKultur"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumUbiKayuPengendalianPerbaikanTeknikBudidayaTepat"/>
    <ptp:deskripsiPengendalian xml:lang="id">Penggunaan benih sehat yang bebas penyakit, dapat pula dilakukan perlakuan benih dengan larutan amonium sulfat maupun larutan garam untuk memisahkan benih yang cukup matang kemudian dilanjutkan dengan desinfeksi benih dengan fungisida Praktik budidaya diperhatikan untuk mencegah padi terinfeksi blas seperti pengaturan pengairan supaya tidak terjadi kekeringan karena padi rentan blas saat kekeringan.</ptp:deskripsiPengendalian>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBercakDaunMataKatakFrogeyeLeafSpotKedelaiMunculAdanyaBintikBintikKecil">
