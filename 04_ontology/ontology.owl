  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianPengendalianHayatiAdalahPengendalianDengan_048cd90f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdfs:label xml:lang="id">Pengendalian hayati adalah pengendalian dengan menggunakan mikroorganisme antagonis sehingga menghambat pertumbuhan patogen penyebab penyakit.</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">Pengendalian hayati adalah pengendalian dengan menggunakan mikroorganisme antagonis sehingga menghambat pertumbuhan patogen penyebab penyakit.</ptp:deskripsiPengendalian>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakDaunKacangTanah"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianSaatPanenProdusenSeringMemanen_db28f7e4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdfs:label xml:lang="id">Saat panen, produsen sering memanen ubi jalar di bawah suhu dan kelembaban relatif dan pengeringan dilakukan di lapangan dengan kisaran suhu optimum 29 – 32° C dengan kelembaban 85%, di mana kondisi tersebut memungkinkan penyembuhan periderm secara cepat dan lengkap (Nielsen and Johnson, 1974).</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">Saat panen, produsen sering memanen ubi jalar di bawah suhu dan kelembaban relatif dan pengeringan dilakukan di lapangan dengan kisaran suhu optimum 29 – 32° C dengan kelembaban 85%, di mana kondisi tersebut memungkinkan penyembuhan periderm secara cepat dan lengkap (Nielsen and Johnson, 1974).</ptp:deskripsiPengendalian>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#LayuFusariumUbiJalar"/>
  </rdf:Description>
