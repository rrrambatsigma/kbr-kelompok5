  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaHawarBakteriUbiKayuKlorosisTanaman">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPucuk"/>
    <rdfs:label xml:lang="id">Klorosis pada tanaman</rdfs:label>
    <skos:prefLabel xml:lang="id">Klorosis pada tanaman</skos:prefLabel>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KlorosisTanaman"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pucuk"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaHawarBakteriUbiKayu"/>
    <ptp:deskripsiGejala xml:lang="id">Muncul eksudat bergetah berwarna krem atau coklat kekuningan pada bagian batang yang terinfeksi, dan batang akan mati, meskipun adakalanya pada batang yang terinfeksi dan mati juga dapat memunculkan tunas baru</ptp:deskripsiGejala>
    <rdfs:comment xml:lang="id">Gejala klorosis pada tanaman pada tanaman Ubi kayu: Muncul eksudat bergetah berwarna krem atau coklat kekuningan pada bagian batang yang terinfeksi, dan batang akan mati, meskipun adakalanya pada batang yang terinfeksi dan mati juga dapat memunculkan tunas baru</rdfs:comment>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#HawarBakteriUbiKayu"/>
  </rdf:Description>
