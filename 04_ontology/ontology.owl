  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaInfeksiPatogenPadaBagianBatang_259b3d61">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
