  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBulaiJagung8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Bulai (Jagung)</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Bulai (Jagung)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Pemberian pupuk kalium juga dapat menurunkan laju infeksi, kejadian dan keparahan penyakit bulai karena kalium membantu pengaturan membuka dan menutupnya stomata dan membentuk senyawa lignin sehingga dinding sel menjadi lebih tebal dan sulit ditembus oleh jamur patogen (Habibi et al., 2017).</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Pemberian pupuk kalium juga dapat menurunkan laju infeksi, kejadian dan keparahan penyakit bulai karena kalium membantu pengaturan membuka dan menutupnya stomata dan membentuk senyawa lignin sehingga dinding sel menjadi lebih tebal dan sulit ditembus oleh jamur patogen (Habibi et al., 2017).</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>CTL_215</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C106_02</ptp:idChunkSumber>
    <ptp:halamanSumber>106</ptp:halamanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
