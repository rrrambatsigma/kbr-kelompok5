    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBusukHitamBlackRotUbiJalar2018MenjelaskanBahwaPengendalianPascapanen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit busuk hitam (black rot)</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit busuk hitam (black rot)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">(2018) menjelaskan bahwa pengendalian pascapanen menggunakan perilladehyde (PAE) 100 μm/l dengan cara fumigasi dapat mengurangi perkembangan miselium C.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">(2018) menjelaskan bahwa pengendalian pascapanen menggunakan perilladehyde (PAE) 100 μm/l dengan cara fumigasi dapat mengurangi perkembangan miselium C.</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>CTL_196</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C088_02</ptp:idChunkSumber>
    <ptp:halamanSumber>88</ptp:halamanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitHawarPelepahDaunPadiBusukBatang">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Busuk batang pada Penyakit Hawar Pelepah Daun</rdfs:label>
    <skos:prefLabel xml:lang="id">Busuk batang pada Penyakit Hawar Pelepah Daun</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BusukBatang"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitHawarPelepahDaunPadiKondisiLembabMembusukMenjadiRebah"/>
    <ptp:deskripsiGejala xml:lang="id">Pada saat kondisi lembab, bercak juga akan ditemukan pada daun padi dan pelepah daun membusuk sehingga padi menjadi rebah dan gabah menjadi kopong (Harahap &amp; Tjahjono, 1992) seperti pada Gambar 1.6.</ptp:deskripsiGejala>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitHawarPelepahDaunPadi"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitEmbunTepungKacangHijauBahanFungisidaNabatiEkstrakBiji">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
