    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBelangMottleKacangTanah"/>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLayuStewartJagung"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiAdaTerinfeksiMakaSegeraDilakukan"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiAplikasiInsektisidaDeltametrinDigabungkanPemakaian"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKerdilKedelaiSoybeanStuntVirusKedelaiPengendalianDilakukanBenihBebasSSV"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangTanahPestisidaDigolongkanMenjadiMacamAntaranya"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanahPengendalianDilakukanInsektisida"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBelangMottleKacangTanahNonPersistenPenyemprotanInsektisidaTidak"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuStewartJagungAlternatifTerakhirPerlakuanKimiaPestisida"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumKacangTanahPestisidaDigolongkanMenjadiMacamAntaranya"/>
    <ptp:deskripsiPengendalian xml:lang="id">Apabila ada tanaman yang terinfeksi maka segera dilakukan eradikasi dan dimusnahkan agar tidak menjadi sumber inokulum, dan apabila perkembangan serangga vektor tinggi maka lakukan penyemprotan menggunakan insektisida berbahan aktif imidakloprid (Inayati and Yusnawan, 2017).</ptp:deskripsiPengendalian>
  </rdf:Description>
