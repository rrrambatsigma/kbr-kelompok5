  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyebaranPenyakitBusukHitamMelalui_7e4b35e6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkar"/>
    <rdfs:label xml:lang="id">Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020).</rdfs:label>
    <ptp:deskripsiGejala xml:lang="id">Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020).</ptp:deskripsiGejala>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Akar"/>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBusukHitamBlackRotUbiJalar"/>
  </rdf:Description>
