  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanSuperelongasiUbiKayuPemanjanganRuasBatangBerlebihanBatang">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdfs:label xml:lang="id">Pengamatan gejala Superelongasi</rdfs:label>
    <skos:prefLabel xml:lang="id">Pengamatan gejala Superelongasi</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang belum dipetakan ke konsep kanonik.</rdfs:comment>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ptp:deskripsiGejala xml:lang="id">Pemanjangan ruas batang yang berlebihan, sehingga batang terbentuk tipis dan lemah dibandingkan tanaman sehat. Gejala pada daun dan tangkai daun di batang muda, deformasi berkembang berasosisi dengan gejala kanker.</ptp:deskripsiGejala>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaSuperelongasiUbiKayuPemanjanganRuasBatangBerlebihanBatang"/>
