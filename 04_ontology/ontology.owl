  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Kerdil Rumput dan Kerdil Hampa (Padi)</rdfs:label>
