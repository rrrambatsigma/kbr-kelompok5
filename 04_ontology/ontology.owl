    <rdfs:label xml:lang="id">Penyakit Bakteri Pustul</rdfs:label>
    <skos:prefLabel xml:lang="id">Penyakit Bakteri Pustul</skos:prefLabel>
    <dcterms:identifier>DIS_017</dcterms:identifier>
    <dcterms:source>DOC002</dcterms:source>
    <ptp:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuPenyakitTanamanDanPengendaliannya"/>
    <ptp:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Kedelai"/>
    <ptp:deskripsiPenyakit xml:lang="id">Secara sepintas gejala yang ditunjukkan hampir menyerupai penyakit karat tetapi pada bercak bakteri pustul ini tidak adanya spora pada bagian tengah bercak. Gejala selanjutnya adalah daun yang terinfeksi akan rontok akibat intensitas serangan yang tinggi sehingga akan mengganggu proses fotosintesis dan berpengaruh terhadap pengisian polong. Patogen dapat terbawa benih akibat tanaman telah terinfeksi patogen X.</ptp:deskripsiPenyakit>
    <skos:definition xml:lang="id">Secara sepintas gejala yang ditunjukkan hampir menyerupai penyakit karat tetapi pada bercak bakteri pustul ini tidak adanya spora pada bagian tengah bercak. Gejala selanjutnya adalah daun yang terinfeksi akan rontok akibat intensitas serangan yang tinggi sehingga akan mengganggu proses fotosintesis dan berpengaruh terhadap pengisian polong. Patogen dapat terbawa benih akibat tanaman telah terinfeksi patogen X.</skos:definition>
    <ptp:kutipanSumber xml:lang="id">Secara sepintas gejala yang ditunjukkan hampir menyerupai penyakit karat tetapi pada bercak bakteri pustul ini tidak adanya spora pada bagian tengah bercak. Gejala selanjutnya adalah daun yang terinfeksi akan rontok akibat intensitas serangan yang tinggi sehingga akan mengganggu proses fotosintesis dan berpengaruh terhadap pengisian polong. Patogen dapat terbawa benih akibat tanaman telah terinfeksi patogen X.</ptp:kutipanSumber>
    <ptp:halamanSumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">56</ptp:halamanSumber>
