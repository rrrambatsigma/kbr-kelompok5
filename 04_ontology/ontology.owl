    <rdfs:label xml:lang="id">Bercak pada daun terinfeksi umumnya berbentuk agak bundar hingga tidak beraturan, dan umumnya berwarna coklat, bagian tengah berwarna keabu-abuan dan dikelilingi oleh bercak coklat kemerahan dengan bentuk permukaan agak tertekan (Gambar 21).</rdfs:label>
    <ptp:deskripsiGejala xml:lang="id">Bercak pada daun terinfeksi umumnya berbentuk agak bundar hingga tidak beraturan, dan umumnya berwarna coklat, bagian tengah berwarna keabu-abuan dan dikelilingi oleh bercak coklat kemerahan dengan bentuk permukaan agak tertekan (Gambar 21).</ptp:deskripsiGejala>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BERCAKDAUNKacangHijau"/>
  </rdf:Description>
