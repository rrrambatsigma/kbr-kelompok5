    <rdfs:label xml:lang="id">Antraknosa</rdfs:label>
    <skos:prefLabel xml:lang="id">Antraknosa</skos:prefLabel>
    <dcterms:identifier>DIS_110</dcterms:identifier>
    <dcterms:source>DOC002</dcterms:source>
