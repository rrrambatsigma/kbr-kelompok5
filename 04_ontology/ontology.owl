    <ptp:merupakanKanonikDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBusukPelepahJagungBusukBatang"/>
    <ptp:merupakanKanonikDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBusukPangkalBatangUbiKayuBusukBatang"/>
    <ptp:merupakanKanonikDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBusukAkarUbiKayuBusukBatang"/>
  </rdf:Description>
