    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KlorosisDaun"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitTungroPadi"/>
    <ptp:deskripsiGejala xml:lang="id">Indikasi adanya infeksi virus tungro pada tanaman padi dapat dilihat dari daun perubahan warna daun (diskolorasi) menjadi kuning hingga oranye.</ptp:deskripsiGejala>
    <rdfs:comment xml:lang="id">Gejala klorosis daun pada tanaman Padi: Indikasi adanya infeksi virus tungro pada tanaman padi dapat dilihat dari daun perubahan warna daun (diskolorasi) menjadi kuning hingga oranye.</rdfs:comment>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitTungroPadi"/>
