  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#HawarDaunJagung">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdfs:label xml:lang="id">Penyakit Hawar Daun</rdfs:label>
    <skos:prefLabel xml:lang="id">Penyakit Hawar Daun</skos:prefLabel>
    <dcterms:identifier>DIS_044</dcterms:identifier>
    <dcterms:source>DOC002</dcterms:source>
    <ptp:memilikiReferensi rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuPenyakitTanamanDanPengendaliannya"/>
    <ptp:menyerangTanaman rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Jagung"/>
    <ptp:deskripsiPenyakit xml:lang="id">Penyakit hawar daun pada jagung disebabkan oleh jamur patogen Helminthosporium maydis Y. Nisik &amp; C.Miyake (Kuilya et al., 2018; Hamidson, Suwandi and Effendy, 2019) atau Helminthosporium turticum (Pass.) Leonard et Suggs (Faizah, 2017). Koloni Helinthosporium maydis yang ditumbuhkan pada media PDA awalnya berwarna keputihan kusam, coklat pucat, selanjutnya menjadi berwarna coklat agak gelap.</ptp:deskripsiPenyakit>
    <skos:definition xml:lang="id">Penyakit hawar daun pada jagung disebabkan oleh jamur patogen Helminthosporium maydis Y. Nisik &amp; C.Miyake (Kuilya et al., 2018; Hamidson, Suwandi and Effendy, 2019) atau Helminthosporium turticum (Pass.) Leonard et Suggs (Faizah, 2017). Koloni Helinthosporium maydis yang ditumbuhkan pada media PDA awalnya berwarna keputihan kusam, coklat pucat, selanjutnya menjadi berwarna coklat agak gelap.</skos:definition>
    <ptp:kutipanSumber xml:lang="id">Penyakit hawar daun pada jagung disebabkan oleh jamur patogen Helminthosporium maydis Y. Nisik &amp; C.Miyake (Kuilya et al., 2018; Hamidson, Suwandi and Effendy, 2019) atau Helminthosporium turticum (Pass.) Leonard et Suggs (Faizah, 2017). Koloni Helinthosporium maydis yang ditumbuhkan pada media PDA awalnya berwarna keputihan kusam, coklat pucat, selanjutnya menjadi berwarna coklat agak gelap.</ptp:kutipanSumber>
