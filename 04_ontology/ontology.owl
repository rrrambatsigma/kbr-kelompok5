    <ptp:kutipanSumber xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Penyakit busuk hitam (black rot) disebabkan oleh jamur Ceratocystis fimbriata menjadi salah satu ancaman produksi pada ubi jalar di dunia (Muramoto et al., 2012) dan menyebabkan kerusakan parah selama penyimpanan pascapanen (Baker et al., 2</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>PAT_033</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C087_01</ptp:idChunkSumber>
    <ptp:halamanSumber>87</ptp:halamanSumber>
    <ptp:catatanKualitas xml:lang="id">Kutipan sumber berupa fragmen atau kalimat terpotong.</ptp:catatanKualitas>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiKerdilTanaman">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Kerdil tanaman pada Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)</rdfs:label>
    <skos:prefLabel xml:lang="id">Kerdil tanaman pada Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KerdilTanaman"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiIntensitasMakaMunculTerdapatDiikuti"/>
    <ptp:deskripsiGejala xml:lang="id">Pada intensitas serangan yang tinggi maka gejala yang muncul pada tanaman kedelai adalah terdapat mosaik pada daun yang diikuti dengan tonjolan pada permukaan daun dan terdapat blister di mana helai daun berwarna hijau tua, bentuk daun keriting, adanya mosaik kuning dan tanaman kedelai menjadi kerdil.</ptp:deskripsiGejala>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitHawarDaunJagungHalDikarenakanIntensitasTerdapatDisemprot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
