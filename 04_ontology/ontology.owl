    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdfs:label xml:lang="id">Menurut (Martanto, Tanati and Baan, 2016) varietas tahan dapat menggunakan Mouwebsi, Wonembai, Kuyage-2, Inanwatan-4, Abomourow, sedangkan Bonsasarai termasuk agak tahan.</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">Menurut (Martanto, Tanati and Baan, 2016) varietas tahan dapat menggunakan Mouwebsi, Wonembai, Kuyage-2, Inanwatan-4, Abomourow, sedangkan Bonsasarai termasuk agak tahan.</ptp:deskripsiPengendalian>
