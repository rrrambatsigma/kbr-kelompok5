  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitEmbunTepungKacangHijau3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Embun Tepung (Kacang hijau)</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Embun Tepung (Kacang hijau)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Cendawan Ampelomyces quisqualis merupakan antagonis dari E. polygoni, terbukti efektif menekan pertumbuhan E. polygoni yang menginfeksi kacang hijau.</ptp:kutipanSumber>
