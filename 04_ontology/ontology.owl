    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuKacangHijau4"/>
    <ptp:deskripsiPengendalian xml:lang="id">Pengendalian S. rolfsii dapat dilakukan dengan perlakuan kultur teknis, seperti pengolahan tanah, pemberian kompos, dan solarisasi tanah.</ptp:deskripsiPengendalian>
  </rdf:Description>
