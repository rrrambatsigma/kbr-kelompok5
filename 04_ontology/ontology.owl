  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBlasPadi7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Blas (Padi)</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Blas (Padi)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Pengendalian kimiawi dengan fungisida berbahan aktif risiklikol, pyroquilon, iprobenfos, benomyl, isoprothiolane, diclocymet, edifenphos, felimzone, probenazole, karpropamid, fenoxanil dan metominostrobin, dan antibiotik seperti blasticidin, kasugamycin dan dipotassium hidrogen fosfat (DHP) telah dilaporkan dapat mengurangi keparahan penyakit blas.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Pengendalian kimiawi dengan fungisida berbahan aktif risiklikol, pyroquilon, iprobenfos, benomyl, isoprothiolane, diclocymet, edifenphos, felimzone, probenazole, karpropamid, fenoxanil dan metominostrobin, dan antibiotik seperti blasticidin, kasugamycin dan dipotassium hidrogen fosfat (DHP) telah dilaporkan dapat mengurangi keparahan penyakit blas.</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>CTL_015</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C030_02</ptp:idChunkSumber>
    <ptp:halamanSumber>30</ptp:halamanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitLayuStewartJagungPertumbuhanAbnormal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Pertumbuhan abnormal</rdfs:label>
    <skos:prefLabel xml:lang="id">Pertumbuhan abnormal</skos:prefLabel>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PertumbuhanAbnormal"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitLayuStewartJagung3"/>
    <ptp:deskripsiGejala xml:lang="id">Daun bergejala layu stewart berwarna hijau pucat hingga kekuningan dengan garis linier dengan tepi lurus maupun bergelombang yang sejajar tulang daun, layu dan kerdil (Rahma et al., 2014).</ptp:deskripsiGejala>
    <rdfs:comment xml:lang="id">Gejala pertumbuhan abnormal pada tanaman Jagung: Daun bergejala layu stewart berwarna hijau pucat hingga kekuningan dengan garis linier dengan tepi lurus maupun bergelombang yang sejajar tulang daun, layu dan kerdil (Rahma et al., 2014).</rdfs:comment>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLayuStewartJagung"/>
  </rdf:Description>
