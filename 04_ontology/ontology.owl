  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBiopestisida">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianBiologis"/>
    <rdfs:label xml:lang="id">Penggunaan biopestisida</rdfs:label>
    <skos:prefLabel xml:lang="id">Penggunaan biopestisida</skos:prefLabel>
    <rdfs:comment xml:lang="id">Tindakan kanonik penggunaan biopestisida.</rdfs:comment>
    <ptp:namaPengendalian xml:lang="id">Penggunaan biopestisida</ptp:namaPengendalian>
    <skos:definition xml:lang="id">Menggunakan biopestisida berbahan aktif organisme atau metabolit alami.</skos:definition>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:altLabel xml:lang="id">penggunaan biopestisida</skos:altLabel>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLayuBakteriKacangTanah"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuBakteriKacangTanah3"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianUmumKacangTanah28"/>
    <ptp:deskripsiPengendalian xml:lang="id">Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati.</ptp:deskripsiPengendalian>
  </rdf:Description>
