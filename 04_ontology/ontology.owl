  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#AntraknosaUbiKayuBatang">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit"/>
    <rdfs:label xml:lang="id">Antraknosa</rdfs:label>
    <skos:prefLabel xml:lang="id">Antraknosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Anthracnose</skos:prefLabel>
    <rdfs:comment xml:lang="id">Data penyakit dari sumber; rincian bukti tersedia pada node BuktiSumber.</rdfs:comment>
    <skos:altLabel xml:lang="en">Anthracnose</skos:altLabel>
    <skos:definition xml:lang="id">Penyakit Antraknosa pada tanaman Ubi kayu, disebabkan oleh Collectothricum gloeosporioides, dengan gejala antara lain Pucuk mati.</skos:definition>
