    <ptp:didahuluiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePembibitanTanaman"/>
    <ptp:diikutiOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaseGeneratifUmum"/>
  </rdf:Description>
