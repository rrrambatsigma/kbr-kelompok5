    <ptp:namaPengendalian xml:lang="id">Solarisasi tanah</ptp:namaPengendalian>
    <skos:definition xml:lang="id">Memanaskan tanah dengan sinar matahari yang ditutup plastik untuk menekan patogen tular tanah.</skos:definition>
    <dcterms:source xml:lang="id">Kurasi pakar</dcterms:source>
    <skos:altLabel xml:lang="id">solarisasi tanah</skos:altLabel>
