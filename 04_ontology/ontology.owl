    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiSumber"/>
    <rdfs:label xml:lang="id">Bukti faktor lingkungan Penyakit Bulai</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti faktor lingkungan Penyakit Bulai</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Kecepatan angin, kelembaban yang tinggi lebih dari 90% dan suhu di bawah 24°C dapat meningkatkan laju infeksi penyakit bulai.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Kecepatan angin, kelembaban yang tinggi lebih dari 90% dan suhu di bawah 24°C dapat meningkatkan laju infeksi penyakit bulai.</ptp:kutipanNormalisasi>
