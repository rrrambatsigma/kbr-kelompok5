    <ptp:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaSamaBerbedaAkibatPatogen"/>
    <ptp:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBeberapaFaktorUmurTerinfeksi"/>
    <ptp:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaunKerdilMosaikKlorosis"/>
    <ptp:memilikiGejala rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBelang"/>
    <ptp:menyerangBagian rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
