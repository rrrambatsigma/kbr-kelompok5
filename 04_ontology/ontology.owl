  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBlasPadiPengendalianKimiawiFungisidaBerbahanAktif">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalian"/>
    <rdfs:label xml:lang="id">Bukti pengendalian Penyakit Blas</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Blas</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Pengendalian kimiawi dengan fungisida berbahan aktif risiklikol, pyroquilon, iprobenfos, benomyl, isoprothiolane, diclocymet, edifenphos, felimzone, probenazole, karpropamid, fenoxanil dan metominostrobin, dan antibiotik seperti blasticidin, kasugamycin dan dipotassium hidrogen fosfat (DHP) telah dilaporkan dapat mengurangi keparahan penyakit blas.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Pengendalian kimiawi dengan fungisida berbahan aktif risiklikol, pyroquilon, iprobenfos, benomyl, isoprothiolane, diclocymet, edifenphos, felimzone, probenazole, karpropamid, fenoxanil dan metominostrobin, dan antibiotik seperti blasticidin, kasugamycin dan dipotassium hidrogen fosfat (DHP) telah dilaporkan dapat mengurangi keparahan penyakit blas.</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>CTL_015</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C030_02</ptp:idChunkSumber>
    <ptp:halamanSumber>30</ptp:halamanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
