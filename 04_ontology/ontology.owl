  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanBusukPangkalBatangUbiKayuLayuDaun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Layu daun pada Busuk pangkal batang</rdfs:label>
    <skos:prefLabel xml:lang="id">Layu daun pada Busuk pangkal batang</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#LayuDaun"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Batang"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaBusukPangkalBatangUbiKayuBagianBatangDekatPermukaanBatang"/>
    <ptp:deskripsiGejala xml:lang="id">Infeksi patogen pada bagian batang dekat permukaan tanah (pangkal batang), dan menyebabkan pangkal batang membusuk sehingga tanaman layu.</ptp:deskripsiGejala>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BusukPangkalBatangUbiKayu"/>
