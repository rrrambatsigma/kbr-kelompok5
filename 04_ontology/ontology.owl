  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaGejalaKhasBerupaBercakAtau_bb5a688d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Gejala khas berupa bercak atau lesi berair (eksudat seperti getah berwarna krem) pada tangkai daun tanaman terinfeksi. Pada daun gejala muncul urat atau tulang daun,tepi dan ujung bilah daun. Perkembangan infeksi lebih lanjut bercak tersebut menyatu membentuk hawar/bercak coklat besar, daun mengering atau layu, daun gugur.</rdfs:label>
    <ptp:deskripsiGejala xml:lang="id">Gejala khas berupa bercak atau lesi berair (eksudat seperti getah berwarna krem) pada tangkai daun tanaman terinfeksi. Pada daun gejala muncul urat atau tulang daun,tepi dan ujung bilah daun. Perkembangan infeksi lebih lanjut bercak tersebut menyatu membentuk hawar/bercak coklat besar, daun mengering atau layu, daun gugur.</ptp:deskripsiGejala>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#HawarDaunBakteriUbiKayu"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianSolaniDapatDilakukanDenganBeberapa_1988ff15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianBiologis"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis"/>
    <rdfs:label xml:lang="id">solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian dengan hayati seperti pemanfaatan jamur antagonis Trichoderma virens.</rdfs:label>
    <ptp:deskripsiPengendalian xml:lang="id">solani dapat dilakukan dengan beberapa cara yaitu teknik pengendalian secara kultur teknis seperti rotasi tanam, melakukan perbaikan drainase, penanaman kedelai tidak pada musim hujan yang tinggi, melakukan eradikasi tanaman yang menjadi sumber inokulum, melakukan pengendalian dengan hayati seperti pemanfaatan jamur antagonis Trichoderma virens.</ptp:deskripsiPengendalian>
    <ptp:mengendalikanPenyakit rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitRebahKecambahKedelai"/>
  </rdf:Description>
