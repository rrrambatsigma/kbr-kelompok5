    <ptp:kutipanSumber xml:lang="id">Sporulasi patogen terjadi pada bercak yang telah berkembang penuh biasanya 15 hari setelah inokulasi.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Sporulasi patogen terjadi pada bercak yang telah berkembang penuh biasanya 15 hari setelah inokulasi.</ptp:kutipanNormalisasi>
