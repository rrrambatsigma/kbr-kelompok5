    <skos:prefLabel xml:lang="id">Bukti pengendalian Penyakit Bulai (Jagung)</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Pengendalian penyakit bulai jagung dapat dilakukan dengan menggunakan varietas tahan seperti Jagung Asian Honey yang mempunyai kejadian penyakit lebih rendah (54.17%) dibandingkan dengan varietas Jagung Pioneer 21 (70.83%) dan Jagung Pacific 339 (79.17%).</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Pengendalian penyakit bulai jagung dapat dilakukan dengan menggunakan varietas tahan seperti Jagung Asian Honey yang mempunyai kejadian penyakit lebih rendah (54.17%) dibandingkan dengan varietas Jagung Pioneer 21 (70.83%) dan Jagung Pacific 339 (79.17%).</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>CTL_213</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C106_02</ptp:idChunkSumber>
    <ptp:halamanSumber>106</ptp:halamanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
