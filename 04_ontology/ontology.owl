  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitAntraknosaKedelaiKematianTanaman">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala"/>
    <rdfs:label xml:lang="id">Kematian tanaman</rdfs:label>
    <skos:prefLabel xml:lang="id">Kematian tanaman</skos:prefLabel>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KematianTanaman"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#TidakSpesifik"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitAntraknosaKedelai7"/>
    <ptp:deskripsiGejala xml:lang="id">truncatum dengan cara melakukan penetrasi pada jaringan tanaman dengan membentuk hifa primer dan diikuti dengan fase nekrotik di mana patogen memproduksi hifa sekunder yang menginfeksi jaringan tanaman secara intra dan interseluler sehingga menyebabkan kematian jaringan sel.</ptp:deskripsiGejala>
    <rdfs:comment xml:lang="id">Gejala kematian tanaman pada tanaman Kedelai: truncatum dengan cara melakukan penetrasi pada jaringan tanaman dengan membentuk hifa primer dan diikuti dengan fase nekrotik di mana patogen memproduksi hifa sekunder yang menginfeksi jaringan tanaman secara intra dan interseluler sehingga menyebabkan kematian jaringan sel.</rdfs:comment>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitAntraknosaKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPenyakitBusukHitamBlackRotUbiJalarBercakTanaman">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkar"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaUmbi"/>
    <rdfs:label xml:lang="id">Bercak pada tanaman</rdfs:label>
    <skos:prefLabel xml:lang="id">Bercak pada tanaman</skos:prefLabel>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BercakTanaman"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Akar"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Umbi"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBusukHitamBlackRotUbiJalar2"/>
    <ptp:deskripsiGejala xml:lang="id">fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b).</ptp:deskripsiGejala>
    <rdfs:comment xml:lang="id">Gejala bercak pada tanaman pada tanaman Ubi jalar: fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b).</rdfs:comment>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBusukHitamBlackRotUbiJalar"/>
  </rdf:Description>
