    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitLayuStewartJagung8"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitKaratDaunKacangTanah2"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiPengendalianPenyakitBercakDaunKacangHijau3"/>
    <ptp:deskripsiPengendalian xml:lang="id">Kemudian sanitasi dari keberadaan gulma, singgang, dan ceceran gabah yang dapat menjadi inang alternatif bagi patogen maupun vektor, penanaman sistem jajar legowo yang dapat memanipulasi kondisi mikro iklim di bawah kanopi tidak sesuai untuk patogen, pengeringan sawah untuk menekan populasi nimfa wereng hijau.</ptp:deskripsiPengendalian>
  </rdf:Description>
