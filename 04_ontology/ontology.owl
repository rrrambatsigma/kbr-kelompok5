    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitKaratDaunKedelaiAkibatMenyebabkanPenurunanProduksiPolong"/>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitKaratDaunKedelai"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitBercakKuningUbiJalarKlorosisDaun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPucuk"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun"/>
    <rdfs:label xml:lang="id">Klorosis daun pada Penyakit bercak kuning</rdfs:label>
    <skos:prefLabel xml:lang="id">Klorosis daun pada Penyakit bercak kuning</skos:prefLabel>
    <rdfs:comment xml:lang="id">Pengamatan gejala yang dipetakan ke konsep kanonik.</rdfs:comment>
    <ptp:memilikiGejalaKanonik rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#KlorosisDaun"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Daun"/>
    <ptp:terdapatPada rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pucuk"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBercakKuningUbiJalarTimbulAkibatPlanletMengalamiKultur"/>
    <ptp:didukungOleh rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitBercakKuningUbiJalarAdapunLapanganKadangKadangTidak"/>
    <ptp:deskripsiGejala xml:lang="id">Gejala yang timbul akibat serangan penyakit ini pada planlet yang belum mengalami kultur meristem tunas pucuk berupa klorotik, nekrosis, daun kecil dan terlipat (Barahima and Purnomo, 2003).</ptp:deskripsiGejala>
    <ptp:merupakanGejalaDari rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBercakKuningUbiJalar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejalaPenyakitHawarDaunJagungSelanjutnyaBerkembangMenjadiBerbentukLonjong">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BuktiGejala"/>
    <rdfs:label xml:lang="id">Bukti gejala Penyakit Hawar Daun</rdfs:label>
    <skos:prefLabel xml:lang="id">Bukti gejala Penyakit Hawar Daun</skos:prefLabel>
    <rdfs:comment xml:lang="id">Node bukti yang menyimpan kutipan dan lokasi sumber.</rdfs:comment>
    <ptp:kutipanSumber xml:lang="id">Selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan, infeksi lebih lanjut bercak akan melebar dan bergabung dengan bercak lain dan menyebabkan jaringan daun mengalami nekrosis.</ptp:kutipanSumber>
    <ptp:kutipanNormalisasi xml:lang="id">Selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan, infeksi lebih lanjut bercak akan melebar dan bergabung dengan bercak lain dan menyebabkan jaringan daun mengalami nekrosis.</ptp:kutipanNormalisasi>
    <ptp:dokumenSumber>DOC002</ptp:dokumenSumber>
    <ptp:identifierSumber>SYM_179</ptp:identifierSumber>
    <ptp:idChunkSumber>DOC002_C101_02</ptp:idChunkSumber>
    <ptp:halamanSumber>101</ptp:halamanSumber>
    <prov:wasDerivedFrom rdf:resource="http://kbr.kelompok5.org/penyakit-tanaman-pangan#BukuDOC002"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengamatanPenyakitKaratDaunJagungBiasanyaDiawaliBagianBawahBerkembang">
