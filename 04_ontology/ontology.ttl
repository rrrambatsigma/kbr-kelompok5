        ptp:Referensi .

ptp:Penyakit a owl:Class ;
    rdfs:label "Penyakit"@id ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ptp:Patogen ;
            owl:onProperty ptp:disebabkanOleh ],
        [ a owl:Restriction ;
            owl:onProperty ptp:memilikiGejala ;
            owl:someValuesFrom ptp:Gejala ],
        [ a owl:Restriction ;
            owl:onProperty ptp:menyerangTanaman ;
            owl:someValuesFrom ptp:TanamanPangan ] ;
    owl:disjointWith ptp:BagianTanaman,
        ptp:FaktorRisiko,
        ptp:Gejala,
        ptp:Patogen,
        ptp:Pengendalian,
        ptp:Referensi .

