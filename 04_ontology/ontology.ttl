    kbr:rowStatus "unnumbered"@id ;
    kbr:sourceBlockId "DOC002_P094_B001"@id ;
    kbr:symptomText "Gejala utama ditandai dengan munculnya bercak gelap/abu-abu atau nekrotik pada permukaan batang, area nekrotik tersebut merupakan struktur dari jamur patogen yang menginfeksi batang ubi kayu, dan gejala tersebut juga menutupi titik tunas dan menghambat pertumbuhan tunas"@id .

kbrd:T5_2_BATANG_R_unnumbered_2 a kbr:SourceTableRow,
