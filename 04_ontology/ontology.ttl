    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ptp:Penyakit [ a owl:Restriction ;
                        owl:onProperty ptp:disebabkanOleh ;
                        owl:someValuesFrom ptp:Virus ] ) ] ;
    skos:prefLabel "Penyakit Virus"@id .

ptp:PerlakuanRadiasi a ptp:PengendalianFisik,
