###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkibatDariInfeksiIniMaka_b83a2e23
ptp:GejalaAkibatDariInfeksiIniMaka_b83a2e23 rdf:type owl:NamedIndividual ,
                                                     ptp:Gejala ;
                                            ptp:merupakanGejalaDari ptp:PenyakitLayuFusariumKedelai ;
                                            ptp:deskripsiGejala "Akibat dari infeksi ini maka tanaman menunjukkan gejala kematian mendadak pada tanaman kedelai (Chang et al., 2018)."@id ;
                                            rdfs:label "Akibat dari infeksi ini maka tanaman menunjukkan gejala kematian mendadak pada tanaman kedelai (Chang et al., 2018)."@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkibatInfeksiPadaAkarMenyebabkan_5af2b70e
ptp:GejalaAkibatInfeksiPadaAkarMenyebabkan_5af2b70e rdf:type owl:NamedIndividual ,
                                                             ptp:Gejala ,
                                                             ptp:GejalaAkar ;
                                                    ptp:merupakanGejalaDari ptp:PenyakitLayuFusariumKedelai ;
                                                    ptp:terdapatPada ptp:Akar ;
                                                    ptp:deskripsiGejala "Akibat infeksi pada akar menyebabkan terganggunya proses translokasi unsur hara sehingga menyebabkan tanaman layu dan mati (Gambar 2.4) (Musdalifa et al., 2017)."@id ;
                                                    rdfs:label "Akibat infeksi pada akar menyebabkan terganggunya proses translokasi unsur hara sehingga menyebabkan tanaman layu dan mati (Gambar 2.4) (Musdalifa et al., 2017)."@id .


