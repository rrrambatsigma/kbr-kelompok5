ptp:PengairanDanDrainase a ptp:PengendalianKulturTeknis,
        owl:NamedIndividual ;
    rdfs:label "Pengairan dan drainase"@id ;
    ptp:deskripsiPengendalian "Penggunaan benih sehat yang bebas penyakit, dapat pula dilakukan perlakuan benih dengan larutan amonium sulfat maupun larutan garam untuk memisahkan benih yang cukup matang kemudian dilanjutkan dengan desinfeksi benih dengan fungisida Praktik budidaya diperhatikan untuk mencegah padi terinfeksi blas seperti pengaturan pengairan supaya tidak terjadi kekeringan karena padi rentan blas saat kekeringan."@id ;
    ptp:didukungOleh ptp:BuktiPengendalianPenyakitBlasPadiPenggunaanBenihSehatBebasPula,
        ptp:BuktiPengendalianPenyakitHawarDaunBakteriPadiNaqvi2019TidakMemotongBibit,
        ptp:BuktiPengendalianPenyakitRebahKecambahKedelaiSolaniDilakukanTeknikPengendalianKultur,
        ptp:BuktiPengendalianUmumUbiKayuPengendalianPerbaikanTeknikBudidayaTepat ;
    ptp:mengendalikanPenyakit ptp:PenyakitBlasPadi,
        ptp:PenyakitHawarDaunBakteriPadi,
        ptp:PenyakitRebahKecambahKedelai ;
    ptp:namaPengendalian "Pengairan dan drainase"@id ;
    rdfs:comment "Tindakan kanonik pengaturan air, irigasi, dan drainase."@id ;
    skos:prefLabel "Pengairan dan drainase"@id .

