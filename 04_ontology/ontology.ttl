ptp:Gejala2018MenjelaskanBahwaGejalaAwal_5c05bed5 a ptp:Gejala,
        ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "(2018) menjelaskan bahwa gejala awal ditandai dengan daun yang terinfeksi berwarna kuning pada bagian atas, diikuti menguningnya pada bagian bawah dan lebih cepat pada daun tua."@id ;
    ptp:deskripsiGejala "(2018) menjelaskan bahwa gejala awal ditandai dengan daun yang terinfeksi berwarna kuning pada bagian atas, diikuti menguningnya pada bagian bawah dan lebih cepat pada daun tua."@id ;
    ptp:merupakanGejalaDari ptp:LayuFusariumUbiJalar ;
    ptp:terdapatPada ptp:Daun .

ptp:Gejala2018MenjelaskanBahwaGejalaSerangan_a1bd3ac9 a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "(2018) menjelaskan bahwa gejala serangan C."@id ;
    ptp:deskripsiGejala "(2018) menjelaskan bahwa gejala serangan C."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitBusukHitamBlackRotUbiJalar .

ptp:GejalaAdapunBentukBercakSendiriDapat_626f021f a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Adapun bentuk bercak sendiri dapat berupa bulat lonjong dengan panjang 2 – 3 cm yang kemudian akan meluas."@id ;
    ptp:deskripsiGejala "Adapun bentuk bercak sendiri dapat berupa bulat lonjong dengan panjang 2 – 3 cm yang kemudian akan meluas."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitHawarPelepahDaunPadi .

ptp:GejalaAdapunBentukWarnaDanUkuran_f8023518 a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Adapun bentuk, warna dan ukuran dari bercak dapat bervariasi tergantung dari umur dan ketahanan varietas tanaman serta umur dari bercak (Ou 1985)."@id ;
    ptp:deskripsiGejala "Adapun bentuk, warna dan ukuran dari bercak dapat bervariasi tergantung dari umur dan ketahanan varietas tanaman serta umur dari bercak (Ou 1985)."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitBlasPadi .

ptp:GejalaAdapunGejalaDiLapanganPada_b6b7db6c a ptp:Gejala,
        ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018)."@id ;
    ptp:deskripsiGejala "Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018)."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitBercakKuningUbiJalar ;
    ptp:terdapatPada ptp:Daun .

ptp:GejalaAkarMembusukTerdapatTubuhBuah_0f535eca a ptp:Gejala,
        ptp:GejalaAkar,
        ptp:GejalaBatang,
        owl:NamedIndividual ;
    rdfs:label "Akar membusuk, terdapat tubuh buah (jamur) kecil berwarna keputihan dan menguning, di ujung akar dekat pangkal batang,"@id ;
    ptp:deskripsiGejala "Akar membusuk, terdapat tubuh buah (jamur) kecil berwarna keputihan dan menguning, di ujung akar dekat pangkal batang,"@id ;
    ptp:merupakanGejalaDari ptp:BusukAkarUbiKayu ;
    ptp:terdapatPada ptp:Akar,
        ptp:Batang,
        ptp:Buah .

ptp:GejalaAkarMengalamiKerusakanAkarPembentukan_99e28980 a ptp:Gejala,
        ptp:GejalaAkar,
        ptp:GejalaUmbi,
        owl:NamedIndividual ;
    rdfs:label "Akar mengalami kerusakan akar, pembentukan dan pembesaran umbi ubi kayu terhambat, serta busuk"@id ;
    ptp:deskripsiGejala "Akar mengalami kerusakan akar, pembentukan dan pembesaran umbi ubi kayu terhambat, serta busuk"@id ;
    ptp:merupakanGejalaDari ptp:BusukAkarDanUmbiUbiKayu ;
    ptp:terdapatPada ptp:Akar,
        ptp:Umbi .

ptp:GejalaAkibatDariInfeksiIniMaka_b83a2e23 a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Akibat dari infeksi ini maka tanaman menunjukkan gejala kematian mendadak pada tanaman kedelai (Chang et al., 2018)."@id ;
    ptp:deskripsiGejala "Akibat dari infeksi ini maka tanaman menunjukkan gejala kematian mendadak pada tanaman kedelai (Chang et al., 2018)."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitLayuFusariumKedelai .

ptp:GejalaAkibatInfeksiPadaAkarMenyebabkan_5af2b70e a ptp:Gejala,
        ptp:GejalaAkar,
        owl:NamedIndividual ;
    rdfs:label "Akibat infeksi pada akar menyebabkan terganggunya proses translokasi unsur hara sehingga menyebabkan tanaman layu dan mati (Gambar 2.4) (Musdalifa et al., 2017)."@id ;
    ptp:deskripsiGejala "Akibat infeksi pada akar menyebabkan terganggunya proses translokasi unsur hara sehingga menyebabkan tanaman layu dan mati (Gambar 2.4) (Musdalifa et al., 2017)."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitLayuFusariumKedelai ;
    ptp:terdapatPada ptp:Akar .

ptp:GejalaAkibatSeranganOlehPatogenIni_444ad2f3 a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Akibat serangan oleh patogen ini menyebabkan penurunan produksi polong kedelai mencapai 30-60%."@id ;
    ptp:deskripsiGejala "Akibat serangan oleh patogen ini menyebabkan penurunan produksi polong kedelai mencapai 30-60%."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitKaratDaunKedelai .

