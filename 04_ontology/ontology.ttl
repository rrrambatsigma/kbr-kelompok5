@prefix : <http://kbr.kelompok5.org/penyakit-tanaman-pangan#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ptp: <http://kbr.kelompok5.org/penyakit-tanaman-pangan#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://kbr.kelompok5.org/penyakit-tanaman-pangan> .

<http://kbr.kelompok5.org/penyakit-tanaman-pangan> rdf:type owl:Ontology ;
                                                    rdfs:comment "Knowledge base penyakit tanaman pangan Indonesia (padi, kedelai, jagung, ubi jalar, ubi kayu, kacang tanah, kacang hijau) untuk penalaran OWL 2 minimal SROIQ(D) di Protégé."@id ;
                                                    rdfs:label "Ontologi Penyakit Tanaman Pangan Indonesia"@id .

#################################################################
#    Object Properties
#################################################################

###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#berkaitanPengendalian
ptp:berkaitanPengendalian rdf:type owl:ObjectProperty ;
                          rdfs:range ptp:Pengendalian ;
                          rdfs:comment "Superproperty pengendalian tanpa domain: menghubungkan penyakit atau tanaman dengan metode pengendalian."@id ;
                          rdfs:label "berkaitan pengendalian"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#dijelaskanDalam
ptp:dijelaskanDalam rdf:type owl:ObjectProperty ;
                    owl:inverseOf ptp:memilikiReferensi ;
                    rdfs:domain ptp:Referensi ;
                    rdfs:range ptp:Penyakit ;
                    rdfs:comment "Referensi menjelaskan penyakit; kebalikan dari memilikiReferensi."@id ;
                    rdfs:label "dijelaskan dalam"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#dikendalikanDengan
ptp:dikendalikanDengan rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf ptp:berkaitanPengendalian ;
                       owl:inverseOf ptp:mengendalikanPenyakit ;
                       rdfs:domain ptp:Penyakit ;
                       rdfs:range ptp:Pengendalian ;
                       rdfs:comment "Metode pengendalian yang direkomendasikan untuk penyakit."@id ;
                       rdfs:label "dikendalikan dengan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#dipengaruhiOleh
ptp:dipengaruhiOleh rdf:type owl:ObjectProperty ;
                    rdfs:domain ptp:Penyakit ;
                    rdfs:range ptp:FaktorRisiko ;
                    rdfs:comment "Faktor risiko lingkungan/budidaya yang memengaruhi kemunculan penyakit."@id ;
                    rdfs:label "dipengaruhi oleh"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#disebabkanOleh
ptp:disebabkanOleh rdf:type owl:ObjectProperty ;
                   owl:inverseOf ptp:menyebabkanPenyakit ;
                   rdfs:domain ptp:Penyakit ;
                   rdfs:range ptp:Patogen ;
                   rdfs:comment "Penyakit disebabkan oleh patogen tertentu."@id ;
                   rdfs:label "disebabkan oleh"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#diserangPenyakit
ptp:diserangPenyakit rdf:type owl:ObjectProperty ;
                     owl:inverseOf ptp:menyerangTanaman ;
                     rdfs:domain ptp:TanamanPangan ;
                     rdfs:range ptp:Penyakit ;
                     rdfs:comment "Kebalikan dari menyerangTanaman."@id ;
                     rdfs:label "diserang penyakit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#memilikiGejala
ptp:memilikiGejala rdf:type owl:ObjectProperty ;
                   owl:inverseOf ptp:merupakanGejalaDari ;
                   rdfs:domain ptp:Penyakit ;
                   rdfs:range ptp:Gejala ;
                   rdfs:comment "Penyakit menimbulkan gejala tertentu pada tanaman."@id ;
                   rdfs:label "memiliki gejala"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#memilikiReferensi
ptp:memilikiReferensi rdf:type owl:ObjectProperty ;
                      rdfs:domain ptp:Penyakit ;
                      rdfs:range ptp:Referensi ;
                      rdfs:comment "Penyakit didukung oleh referensi sumber."@id ;
                      rdfs:label "memiliki referensi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#memilikiVarietas
ptp:memilikiVarietas rdf:type owl:ObjectProperty ;
                     owl:inverseOf ptp:merupakanVarietasDari ;
                     rdfs:domain ptp:TanamanPangan ;
                     rdfs:range ptp:Varietas ;
                     rdfs:comment "Tanaman pangan memiliki varietas tertentu."@id ;
                     rdfs:label "memiliki varietas"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#mengendalikanPenyakit
ptp:mengendalikanPenyakit rdf:type owl:ObjectProperty ;
                          rdfs:domain ptp:Pengendalian ;
                          rdfs:range ptp:Penyakit ;
                          rdfs:comment "Kebalikan dari dikendalikanDengan."@id ;
                          rdfs:label "mengendalikan penyakit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#menyebabkanPenyakit
ptp:menyebabkanPenyakit rdf:type owl:ObjectProperty ;
                        rdfs:domain ptp:Patogen ;
                        rdfs:range ptp:Penyakit ;
                        rdfs:comment "Kebalikan dari disebabkanOleh."@id ;
                        rdfs:label "menyebabkan penyakit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#menyerangBagian
ptp:menyerangBagian rdf:type owl:ObjectProperty ;
                    rdfs:domain ptp:Penyakit ;
                    rdfs:range ptp:BagianTanaman ;
                    owl:propertyChainAxiom ( ptp:memilikiGejala
                                             ptp:terdapatPada
                                           ) ;
                    rdfs:comment "Bagian tanaman (daun, batang, akar, umbi) yang terserang penyakit."@id ;
                    rdfs:label "menyerang bagian"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#menyerangFase
ptp:menyerangFase rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf ptp:menyerangTanaman ;
                  rdfs:domain ptp:Penyakit ;
                  rdfs:range ptp:FasePertumbuhan ;
                  rdfs:comment "Fase pertumbuhan tanaman yang diserang penyakit."@id ;
                  rdfs:label "menyerang fase"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#menyerangTanaman
ptp:menyerangTanaman rdf:type owl:ObjectProperty ;
                     rdfs:domain ptp:Penyakit ;
                     rdfs:range ptp:TanamanPangan ;
                     rdfs:comment "Penyakit menyerang tanaman pangan tertentu (tanaman inang)."@id ;
                     rdfs:label "menyerang tanaman"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#merupakanGejalaDari
ptp:merupakanGejalaDari rdf:type owl:ObjectProperty ;
                        rdfs:domain ptp:Gejala ;
                        rdfs:range ptp:Penyakit ;
                        rdfs:comment "Kebalikan dari memilikiGejala."@id ;
                        rdfs:label "merupakan gejala dari"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#merupakanVarietasDari
ptp:merupakanVarietasDari rdf:type owl:ObjectProperty ;
                          rdfs:domain ptp:Varietas ;
                          rdfs:range ptp:TanamanPangan ;
                          rdfs:comment "Kebalikan dari memilikiVarietas."@id ;
                          rdfs:label "merupakan varietas dari"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#pengendalianUmum
ptp:pengendalianUmum rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ptp:berkaitanPengendalian ;
                     rdfs:domain ptp:TanamanPangan ;
                     rdfs:range ptp:Pengendalian ;
                     rdfs:comment "Pengendalian umum per tanaman yang berlaku lintas penyakit."@id ;
                     rdfs:label "pengendalian umum"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#tahanTerhadap
ptp:tahanTerhadap rdf:type owl:ObjectProperty ;
                  rdfs:domain ptp:Varietas ;
                  rdfs:range ptp:Penyakit ;
                  rdfs:comment "Varietas tahan/resisten terhadap penyakit tertentu."@id ;
                  rdfs:label "tahan terhadap"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#terdapatPada
ptp:terdapatPada rdf:type owl:ObjectProperty ;
                 rdfs:domain ptp:Gejala ;
                 rdfs:range ptp:BagianTanaman ;
                 rdfs:comment "Lokasi gejala pada bagian tanaman tertentu."@id ;
                 rdfs:label "terdapat pada"@id .


#################################################################
#    Data properties
#################################################################

###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#deskripsiGejala
ptp:deskripsiGejala rdf:type owl:DatatypeProperty ;
                    rdfs:domain ptp:Gejala ;
                    rdfs:comment "Penjelasan gejala menurut sumber."@id ;
                    rdfs:label "deskripsi gejala"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#deskripsiPengendalian
ptp:deskripsiPengendalian rdf:type owl:DatatypeProperty ;
                          rdfs:domain ptp:Pengendalian ;
                          rdfs:comment "Penjelasan metode pengendalian menurut sumber."@id ;
                          rdfs:label "deskripsi pengendalian"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#deskripsiPenyakit
ptp:deskripsiPenyakit rdf:type owl:DatatypeProperty ;
                      rdfs:domain ptp:Penyakit ;
                      rdfs:comment "Penjelasan penyakit menurut sumber."@id ;
                      rdfs:label "deskripsi penyakit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#deskripsiTanaman
ptp:deskripsiTanaman rdf:type owl:DatatypeProperty ;
                     rdfs:domain ptp:TanamanPangan ;
                     rdfs:comment "Deskripsi tanaman pangan."@id ;
                     rdfs:label "deskripsi tanaman"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#judulReferensi
ptp:judulReferensi rdf:type owl:DatatypeProperty ;
                   rdfs:domain ptp:Referensi ;
                   rdfs:comment "Judul sumber referensi."@id ;
                   rdfs:label "judul referensi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#namaIlmiah
ptp:namaIlmiah rdf:type owl:DatatypeProperty ;
               rdfs:domain ptp:TanamanPangan ;
               rdfs:comment "Nama ilmiah tanaman pangan."@id ;
               rdfs:label "nama ilmiah"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#namaIlmiahPatogen
ptp:namaIlmiahPatogen rdf:type owl:DatatypeProperty ;
                      rdfs:domain ptp:Patogen ;
                      rdfs:comment "Nama ilmiah patogen penyebab penyakit."@id ;
                      rdfs:label "nama ilmiah patogen"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#namaPengendalian
ptp:namaPengendalian rdf:type owl:DatatypeProperty ;
                     rdfs:domain ptp:Pengendalian ;
                     rdfs:comment "Nama metode pengendalian."@id ;
                     rdfs:label "nama pengendalian"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#namaPenulis
ptp:namaPenulis rdf:type owl:DatatypeProperty ;
                rdfs:domain ptp:Referensi ;
                rdfs:comment "Penulis referensi."@id ;
                rdfs:label "nama penulis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#tahunTerbit
ptp:tahunTerbit rdf:type owl:DatatypeProperty ;
                rdfs:domain ptp:Referensi ;
                rdfs:comment "Tahun publikasi referensi."@id ;
                rdfs:label "tahun terbit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#tingkatKeparahan
ptp:tingkatKeparahan rdf:type owl:DatatypeProperty ;
                     rdfs:domain ptp:Penyakit ;
                     rdfs:comment "Kategori keparahan penyakit bila tersedia di sumber."@id ;
                     rdfs:label "tingkat keparahan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#urlReferensi
ptp:urlReferensi rdf:type owl:DatatypeProperty ;
                 rdfs:domain ptp:Referensi ;
                 rdfs:comment "Tautan sumber referensi."@id ;
                 rdfs:label "url referensi"@id .


#################################################################
#    Classes
#################################################################

###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#ArtikelIlmiah
ptp:ArtikelIlmiah rdf:type owl:Class ;
                  rdfs:subClassOf ptp:Referensi ;
                  rdfs:label "Artikel Ilmiah"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#BagianTanaman
ptp:BagianTanaman rdf:type owl:Class ;
                  owl:disjointWith ptp:FaktorRisiko ,
                                   ptp:FasePertumbuhan ,
                                   ptp:Gejala ,
                                   ptp:Patogen ,
                                   ptp:Pengendalian ,
                                   ptp:Penyakit ,
                                   ptp:Referensi ,
                                   ptp:TanamanPangan ,
                                   ptp:Varietas ;
                  rdfs:label "Bagian Tanaman"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Bakteri
ptp:Bakteri rdf:type owl:Class ;
            rdfs:subClassOf ptp:Patogen ;
            owl:disjointWith ptp:Jamur ,
                             ptp:OrganismeLain ,
                             ptp:Virus ;
            rdfs:label "Bakteri"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Buku
ptp:Buku rdf:type owl:Class ;
         rdfs:subClassOf ptp:Referensi ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty ptp:tahunTerbit ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ;
         rdfs:label "Buku"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#CurahHujan
ptp:CurahHujan rdf:type owl:Class ;
               rdfs:subClassOf ptp:FaktorLingkungan ;
               rdfs:label "Curah Hujan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#DrainaseBuruk
ptp:DrainaseBuruk rdf:type owl:Class ;
                  rdfs:subClassOf ptp:FaktorBudidaya ;
                  rdfs:label "Drainase Buruk"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorBudidaya
ptp:FaktorBudidaya rdf:type owl:Class ;
                   rdfs:subClassOf ptp:FaktorRisiko ;
                   owl:disjointWith ptp:FaktorLahan ,
                                    ptp:FaktorLingkungan ;
                   rdfs:label "Faktor Budidaya"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorLahan
ptp:FaktorLahan rdf:type owl:Class ;
                rdfs:subClassOf ptp:FaktorRisiko ;
                owl:disjointWith ptp:FaktorLingkungan ;
                rdfs:label "Faktor Lahan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorLingkungan
ptp:FaktorLingkungan rdf:type owl:Class ;
                     rdfs:subClassOf ptp:FaktorRisiko ;
                     rdfs:label "Kondisi Lingkungan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FaktorRisiko
ptp:FaktorRisiko rdf:type owl:Class ;
                 owl:disjointWith ptp:FasePertumbuhan ,
                                  ptp:Gejala ,
                                  ptp:Patogen ,
                                  ptp:Pengendalian ,
                                  ptp:Penyakit ,
                                  ptp:Referensi ,
                                  ptp:TanamanPangan ,
                                  ptp:Varietas ;
                 rdfs:label "Faktor Risiko"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#FasePertumbuhan
ptp:FasePertumbuhan rdf:type owl:Class ;
                    owl:disjointWith ptp:Gejala ,
                                     ptp:Patogen ,
                                     ptp:Pengendalian ,
                                     ptp:Penyakit ,
                                     ptp:Referensi ,
                                     ptp:TanamanPangan ,
                                     ptp:Varietas ;
                    rdfs:label "Fase Pertumbuhan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala
ptp:Gejala rdf:type owl:Class ;
           owl:disjointWith ptp:Patogen ,
                            ptp:Pengendalian ,
                            ptp:Penyakit ,
                            ptp:Referensi ,
                            ptp:TanamanPangan ,
                            ptp:Varietas ;
           rdfs:label "Gejala"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkar
ptp:GejalaAkar rdf:type owl:Class ;
               rdfs:subClassOf ptp:Gejala ;
               rdfs:label "Gejala Akar"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaBatang
ptp:GejalaBatang rdf:type owl:Class ;
                 rdfs:subClassOf ptp:Gejala ;
                 rdfs:label "Gejala Batang"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaDaun
ptp:GejalaDaun rdf:type owl:Class ;
               rdfs:subClassOf ptp:Gejala ;
               rdfs:label "Gejala Daun"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaUmbi
ptp:GejalaUmbi rdf:type owl:Class ;
               rdfs:subClassOf ptp:Gejala ;
               rdfs:label "Gejala Umbi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Jamur
ptp:Jamur rdf:type owl:Class ;
          rdfs:subClassOf ptp:Patogen ;
          owl:disjointWith ptp:OrganismeLain ,
                           ptp:Virus ;
          rdfs:label "Jamur"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#JurnalIlmiah
ptp:JurnalIlmiah rdf:type owl:Class ;
                 rdfs:subClassOf ptp:Referensi ;
                 rdfs:label "Jurnal Ilmiah"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#KelembapanTinggi
ptp:KelembapanTinggi rdf:type owl:Class ;
                     rdfs:subClassOf ptp:FaktorLingkungan ;
                     rdfs:label "Kelembapan Tinggi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiDrainase
ptp:KondisiDrainase rdf:type owl:Class ;
                    rdfs:subClassOf ptp:FaktorLahan ;
                    rdfs:label "Kondisi Drainase"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#KondisiTanah
ptp:KondisiTanah rdf:type owl:Class ;
                 rdfs:subClassOf ptp:FaktorLahan ;
                 rdfs:label "Kondisi Tanah"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Legum
ptp:Legum rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Class ;
                                owl:oneOf ( ptp:KacangHijau
                                            ptp:KacangTanah
                                            ptp:Kedelai
                                          )
                              ] ;
          rdfs:subClassOf ptp:TanamanPangan ;
          rdfs:label "Legum"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#MusimHujan
ptp:MusimHujan rdf:type owl:Class ;
               rdfs:subClassOf ptp:FaktorLingkungan ;
               rdfs:label "Musim Hujan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#MusimKemarau
ptp:MusimKemarau rdf:type owl:Class ;
                 rdfs:subClassOf ptp:FaktorLingkungan ;
                 rdfs:label "Musim Kemarau"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#OrganismeLain
ptp:OrganismeLain rdf:type owl:Class ;
                  rdfs:subClassOf ptp:Patogen ;
                  owl:disjointWith ptp:Virus ;
                  rdfs:label "Organisme Lain"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Patogen
ptp:Patogen rdf:type owl:Class ;
            owl:disjointWith ptp:Pengendalian ,
                             ptp:Penyakit ,
                             ptp:Referensi ,
                             ptp:TanamanPangan ,
                             ptp:Varietas ;
            rdfs:label "Patogen"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Pengendalian
ptp:Pengendalian rdf:type owl:Class ;
                 owl:disjointWith ptp:Penyakit ,
                                  ptp:Referensi ,
                                  ptp:TanamanPangan ,
                                  ptp:Varietas ;
                 rdfs:label "Pengendalian"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianBiologis
ptp:PengendalianBiologis rdf:type owl:Class ;
                         rdfs:subClassOf ptp:Pengendalian ;
                         rdfs:label "Pengendalian Biologis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKimiawi
ptp:PengendalianKimiawi rdf:type owl:Class ;
                        rdfs:subClassOf ptp:Pengendalian ;
                        rdfs:label "Pengendalian Kimiawi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianKulturTeknis
ptp:PengendalianKulturTeknis rdf:type owl:Class ;
                             rdfs:subClassOf ptp:Pengendalian ;
                             rdfs:label "Pengendalian Kultur Teknis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianMekanis
ptp:PengendalianMekanis rdf:type owl:Class ;
                        rdfs:subClassOf ptp:Pengendalian ;
                        rdfs:label "Pengendalian Mekanis"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianTerpadu
ptp:PengendalianTerpadu rdf:type owl:Class ;
                        rdfs:subClassOf ptp:Pengendalian ;
                        rdfs:label "Pengendalian Terpadu"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenggunaanBenihTerinfeksi
ptp:PenggunaanBenihTerinfeksi rdf:type owl:Class ;
                              rdfs:subClassOf ptp:FaktorBudidaya ;
                              rdfs:label "Penggunaan Benih Terinfeksi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Penyakit
ptp:Penyakit rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty ptp:memilikiGejala ;
                               owl:someValuesFrom ptp:Gejala
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty ptp:menyerangTanaman ;
                               owl:someValuesFrom ptp:TanamanPangan
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty ptp:disebabkanOleh ;
                               owl:allValuesFrom ptp:Patogen
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty ptp:memilikiReferensi ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass ptp:Referensi
                             ] ;
             owl:disjointWith ptp:Referensi ,
                              ptp:TanamanPangan ,
                              ptp:Varietas ;
             rdfs:label "Penyakit"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitBakteri
ptp:PenyakitBakteri rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( ptp:Penyakit
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty ptp:disebabkanOleh ;
                                                                 owl:someValuesFrom ptp:Bakteri
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf ptp:Penyakit ;
                    owl:disjointWith ptp:PenyakitJamur ,
                                     ptp:PenyakitLainnya ,
                                     ptp:PenyakitVirus ;
                    rdfs:label "Penyakit Bakteri"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitJamur
ptp:PenyakitJamur rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( ptp:Penyakit
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ptp:disebabkanOleh ;
                                                               owl:someValuesFrom ptp:Jamur
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf ptp:Penyakit ;
                  owl:disjointWith ptp:PenyakitLainnya ,
                                   ptp:PenyakitVirus ;
                  rdfs:label "Penyakit Jamur"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitLainnya
ptp:PenyakitLainnya rdf:type owl:Class ;
                    rdfs:subClassOf ptp:Penyakit ;
                    owl:disjointWith ptp:PenyakitVirus ;
                    rdfs:label "Penyakit Lainnya"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PenyakitVirus
ptp:PenyakitVirus rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( ptp:Penyakit
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ptp:disebabkanOleh ;
                                                               owl:someValuesFrom ptp:Virus
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf ptp:Penyakit ;
                  rdfs:label "Penyakit Virus"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PublikasiInstansi
ptp:PublikasiInstansi rdf:type owl:Class ;
                      rdfs:subClassOf ptp:Referensi ;
                      rdfs:label "Publikasi Instansi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Referensi
ptp:Referensi rdf:type owl:Class ;
              owl:disjointWith ptp:TanamanPangan ,
                               ptp:Varietas ;
              rdfs:label "Referensi"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#SanitasiLahanBuruk
ptp:SanitasiLahanBuruk rdf:type owl:Class ;
                       rdfs:subClassOf ptp:FaktorBudidaya ;
                       rdfs:label "Sanitasi Lahan Buruk"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Serealia
ptp:Serealia rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( ptp:Jagung
                                               ptp:Padi
                                             )
                                 ] ;
             rdfs:subClassOf ptp:TanamanPangan ;
             rdfs:label "Serealia"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Suhu
ptp:Suhu rdf:type owl:Class ;
         rdfs:subClassOf ptp:FaktorLingkungan ;
         rdfs:label "Suhu"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#TanamanPangan
ptp:TanamanPangan rdf:type owl:Class ;
                  owl:disjointWith ptp:Varietas ;
                  rdfs:label "Tanaman Pangan"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Varietas
ptp:Varietas rdf:type owl:Class ;
             rdfs:label "Varietas"@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Virus
ptp:Virus rdf:type owl:Class ;
          rdfs:subClassOf ptp:Patogen ;
          rdfs:label "Virus"@id .


