kbrd:T5_2_BATANG_R3 a kbr:SourceTableRow,
        owl:NamedIndividual ;
    rdfs:label "Superelongasi"@id ;
    kbr:diseaseName "Superelongasi"@id ;
    kbr:hasSourceDocument kbrd:DOC002 ;
    kbr:isTableRowOf kbrd:T5_2_BATANG ;
    kbr:pageStart 94 ;
    kbr:pathogenName "Elsinoe brasiliensis"@id ;
    kbr:rowNumber "3"@id ;
