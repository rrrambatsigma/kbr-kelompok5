ptp:BusukHitamBlackRotUbiJalar a ptp:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit busuk hitam (black rot)"@id ;
    ptp:berkaitanPengendalian ptp:PengendalianBusukHitamBlackRotUbiJalar,
        ptp:PengendalianBusukHitamBlackRotUbiJalarSterilisasiAkarBahanDitanamPersemaian,
        ptp:PengendalianRotasiTanamanBusukHitamBlackRotUbiJalar ;
    ptp:deskripsiPenyakit "Di lapangan, patogen ini termasuk patogen tular tanah (Okada et al., 2017). Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020). Adapun pengendalian yang dapat dilakukan dengan menggunakan lahan baru yang bebas dari patogen untuk persemaian, rotasi tanaman selama 3-4 tahun (Saleh et al., 2015)."@id ;
    ptp:dikendalikanDengan ptp:PengendalianBusukHitamBlackRotUbiJalar,
        ptp:PengendalianBusukHitamBlackRotUbiJalarSterilisasiAkarBahanDitanamPersemaian,
        ptp:PengendalianRotasiTanamanBusukHitamBlackRotUbiJalar ;
    ptp:dipengaruhiOleh ptp:SuhuTercatat25 ;
    ptp:disebabkanOleh ptp:CeratocystisFimbriata ;
    ptp:halamanSumber 87 ;
    ptp:idBlokSumber "DOC002_P087_B008" ;
    ptp:kutipanSumber "Di lapangan, patogen ini termasuk patogen tular tanah (Okada et al., 2017). Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020). Adapun pengendalian yang dapat dilakukan dengan menggunakan lahan baru yang bebas dari patogen untuk persemaian, rotasi tanaman selama 3-4 tahun (Saleh et al., 2015)."@id ;
    ptp:memilikiGejala ptp:GejalaAkarBusukHitam,
        ptp:GejalaAkarHitamKecil,
        ptp:GejalaBusukHitam,
        ptp:GejalaBusukHitamBlackRotUbiJalar,
        ptp:GejalaLeherMalaiFimbriataPascapanenUbiJalar ;
    ptp:memilikiReferensi ptp:BukuPenyakitTanamanDanPengendaliannya ;
    ptp:menyerangBagian ptp:Akar,
        ptp:LeherMalai,
        ptp:Umbi ;
    ptp:menyerangTanaman ptp:UbiJalar ;
    ptp:namaInggrisPenyakit "black rot"@id ;
    dcterms:identifier "DIS_027" ;
    dcterms:source "DOC002" ;
    skos:altLabel "black rot"@id ;
    skos:definition "Di lapangan, patogen ini termasuk patogen tular tanah (Okada et al., 2017). Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020). Adapun pengendalian yang dapat dilakukan dengan menggunakan lahan baru yang bebas dari patogen untuk persemaian, rotasi tanaman selama 3-4 tahun (Saleh et al., 2015)."@id ;
    skos:prefLabel "Penyakit busuk hitam (black rot)"@id ;
    prov:wasDerivedFrom "DOC002_P087_B008" .

