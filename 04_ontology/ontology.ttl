kbr:Bioactivator a owl:Class ;
    rdfs:label "Bioaktivator"@id ;
    rdfs:comment "Catatan bioaktivator (category = bioaktivator)."@id ;
    rdfs:subClassOf kbr:OrganicFertilizer .

kbr:CompoundFertilizer a owl:Class ;
    rdfs:label "Pupuk Majemuk"@id ;
    rdfs:comment "Pupuk majemuk/NPK (category = pupuk majemuk)."@id ;
    rdfs:subClassOf kbr:Fertilizer .

kbr:causedBy a owl:ObjectProperty ;
    rdfs:label "disebabkan oleh"@id ;
    rdfs:comment "Penyakit disebabkan oleh patogen (relasi banyak-ke-banyak dari tabel disease_pathogen)."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:D kbr:i kbr:s kbr:e kbr:a kbr:s kbr:e ) ] ;
    rdfs:range kbr:Pathogen ;
    owl:inverseOf kbr:causes .

kbr:causes a owl:ObjectProperty ;
    rdfs:label "menyebabkan"@id ;
    rdfs:comment "Patogen menyebabkan penyakit; inverse dari kbr:causedBy."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:P kbr:a kbr:t kbr:h kbr:o kbr:g kbr:e kbr:n ) ] ;
    rdfs:range kbr:Disease ;
    owl:inverseOf kbr:causedBy .

kbr:containsSection a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "memuat bagian"@id ;
    rdfs:comment "Relasi hierarki bagian dokumen: bab memuat seksi, seksi memuat subseksi. Transitif, asimetris, dan irrefleksif."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:S kbr:o kbr:u kbr:r kbr:c kbr:e kbr:S kbr:e kbr:c kbr:t kbr:i kbr:o kbr:n ) ] ;
    rdfs:range kbr:SourceSection ;
    owl:inverseOf kbr:sectionOf .

kbr:hasControlMeasure a owl:ObjectProperty ;
    rdfs:label "memiliki tindakan pengendalian"@id ;
    rdfs:comment "Penyakit memiliki tindakan pengendalian; inverse dari kbr:appliesTo."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:D kbr:i kbr:s kbr:e kbr:a kbr:s kbr:e ) ] ;
    rdfs:range kbr:ControlMeasure ;
    owl:inverseOf kbr:appliesTo .

kbr:hasDisease a owl:ObjectProperty ;
    rdfs:label "memiliki penyakit"@id ;
    rdfs:comment "Tanaman memiliki penyakit; inverse dari kbr:occursIn."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:P kbr:l kbr:a kbr:n kbr:t ) ] ;
    rdfs:range kbr:Disease ;
    owl:inverseOf kbr:occursIn .

kbr:hasEvidence a owl:ObjectProperty ;
    rdfs:label "memiliki bukti chunk"@id ;
    rdfs:comment "Rekaman pengetahuan dirujuk ke chunk teks sumber sebagai bukti verbatim."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:K kbr:n kbr:o kbr:w kbr:l kbr:e kbr:d kbr:g kbr:e kbr:R kbr:e kbr:c kbr:o kbr:r kbr:d ) ] ;
    rdfs:range kbr:EvidenceChunk .

kbr:hasTableRow a owl:ObjectProperty ;
    rdfs:label "memiliki baris tabel"@id ;
    rdfs:comment "Tabel sumber memiliki baris; inverse dari kbr:isTableRowOf."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:S kbr:o kbr:u kbr:r kbr:c kbr:e kbr:T kbr:a kbr:b kbr:l kbr:e ) ] ;
    rdfs:range kbr:SourceTableRow ;
    owl:inverseOf kbr:isTableRowOf .

kbr:isTableRowOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "baris dari tabel"@id ;
    rdfs:comment "Baris tabel termasuk dalam satu tabel sumber; fungsional."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:S kbr:o kbr:u kbr:r kbr:c kbr:e kbr:T kbr:a kbr:b kbr:l kbr:e kbr:R kbr:o kbr:w ) ] ;
    rdfs:range kbr:SourceTable ;
    owl:inverseOf kbr:hasTableRow .

kbr:observedOn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "diamati pada tanaman"@id ;
    rdfs:comment "Gejala diamati pada tanaman tertentu; fungsional (satu baris gejala menunjuk satu tanaman)."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:S kbr:y kbr:m kbr:p kbr:t kbr:o kbr:m ) ] ;
    rdfs:range kbr:Plant .

kbr:sectionOf a owl:ObjectProperty ;
    rdfs:label "bagian dari"@id ;
    rdfs:comment "Kebalikan dari kbr:containsSection."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:S kbr:o kbr:u kbr:r kbr:c kbr:e kbr:S kbr:e kbr:c kbr:t kbr:i kbr:o kbr:n ) ] ;
    rdfs:range kbr:SourceSection ;
    owl:inverseOf kbr:containsSection .

kbr:symptomOf a owl:ObjectProperty ;
    rdfs:label "gejala dari"@id ;
    rdfs:comment "Gejala dari penyakit; inverse dari kbr:hasSymptom."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:S kbr:y kbr:m kbr:p kbr:t kbr:o kbr:m ) ] ;
    rdfs:range kbr:Disease ;
    owl:inverseOf kbr:hasSymptom .

