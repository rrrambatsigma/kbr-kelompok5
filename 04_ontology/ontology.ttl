ptp:SamarKacangTunggakCowpeaMildMottleVirusKedelai a ptp:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Samar Kacang Tunggak (Cowpea Mild Mottle Virus)"@id ;
    ptp:berkaitanPengendalian ptp:PengendalianJarakTanam,
        ptp:PengendalianKulturTeknisSamarKacangTunggakCowpeaMildMottleVirusKedelai,
        ptp:PengendalianMulsa,
        ptp:PengendalianSamarKacangTunggakCowpeaMildMottleVirusKedelai,
        ptp:PengendalianSamarKacangTunggakCowpeaMildMottleVirusKedelaiPengendalianRotasiTanamBukanInang ;
    ptp:deskripsiPenyakit "Penyakit samar kacang tunggak disebabkan oleh virus Cowpea Mild Mottle Virus (CMMV). Patogen virus CMMV ini mampu menyerang pada beberapa tanaman seperti kedelai atau famili Leguminoceae, Solanaceae, Amaranthaceae, dan Chenopodiaceae. Gejala yang ditunjukkan oleh patogen CMMV pada tanaman kedelai adalah pada daun tanaman terdapat belang secara sistemik, bagian tulang daun terdapat klorosis serta daun yang terinfeksi CMMV mengalami malformasi (Gambar 2.18)."@id ;
    ptp:dikendalikanDengan ptp:PengendalianJarakTanam,
        ptp:PengendalianKulturTeknisSamarKacangTunggakCowpeaMildMottleVirusKedelai,
