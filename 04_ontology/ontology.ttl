ptp:PenyakitJamur a owl:Class ;
    rdfs:label "Penyakit Jamur"@id ;
    rdfs:comment "Penyakit yang disebabkan oleh jamur (inferensi reasoner)."@id ;
    rdfs:isDefinedBy <http://kbr.kelompok5.org/penyakit-tanaman-pangan> ;
    rdfs:subClassOf ptp:Penyakit ;
    owl:disjointWith ptp:PenyakitBakteri,
        ptp:PenyakitFitoplasma,
        ptp:PenyakitLainnya,
        ptp:PenyakitNematoda,
        ptp:PenyakitOomycete,
        ptp:PenyakitVirus ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ptp:Penyakit [ a owl:Restriction ;
                        owl:onProperty ptp:disebabkanOleh ;
                        owl:someValuesFrom ptp:Jamur ] ) ] ;
    skos:prefLabel "Penyakit Jamur"@id .

ptp:RotasiTanamanTidakDilakukan a owl:Class ;
    rdfs:label "Rotasi Tanaman Tidak Dilakukan"@id ;
