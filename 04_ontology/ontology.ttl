ptp:PengamatanPenyakitAntraknosaKedelaiJaringanTerinfeksiMakaAdaDitutupi a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala Penyakit Antraknosa"@id ;
    ptp:deskripsiGejala "Pada jaringan yang terinfeksi maka akan ada bercak yang ditutupi oleh acervuli berwarna hitam berbentuk lonjong sampai memanjang seperti jarum (Jahan et al., 2015)."@id ;
