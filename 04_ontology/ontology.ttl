    rdfs:comment "Batas bawah nilai observasi lingkungan."@id ;
    rdfs:domain ptp:ObservasiLingkungan ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "nilai minimum"@id .

ptp:nilaiTunggal a owl:DatatypeProperty ;
