        owl:NamedIndividual ;
    rdfs:label "Sanitasi lahan"@id ;
    ptp:deskripsiPengendalian "Kemudian sanitasi dari keberadaan gulma, singgang, dan ceceran gabah yang dapat menjadi inang alternatif bagi patogen maupun vektor, penanaman sistem jajar legowo yang dapat memanipulasi kondisi mikro iklim di bawah kanopi tidak sesuai untuk patogen, pengeringan sawah untuk menekan populasi nimfa wereng hijau."@id ;
    ptp:didukungOleh ptp:BuktiPengendalianLayuFusariumUbiJalarPengendalianDilakukanAntaranyaSanitasiPenanganan,
        ptp:BuktiPengendalianPenyakitAntraknosaKedelaiCTruncatumBertahanSeresahSakit,
        ptp:BuktiPengendalianPenyakitAntraknosaKedelaiPengendalianDilakukanMelakukanSanitasiLahan,
        ptp:BuktiPengendalianPenyakitBakteriPustulKedelaiPengendalianDilakukanPenggunaanBenihBebas,
        ptp:BuktiPengendalianPenyakitBercakDaunKacangTanahSifatCendawanBertahanHidupPeriode,
        ptp:BuktiPengendalianPenyakitBercakDaunKacangTanahUpayaMengendalikanMelaluiAntaranyaSanitasi,
        ptp:BuktiPengendalianPenyakitBercakKuningUbiJalarPengendalianDilakukanBibitSetekBahan,
        ptp:BuktiPengendalianPenyakitBercakTargetKedelaiCassicolaEradikasiLahanSisaSisa,
        ptp:BuktiPengendalianPenyakitEmbunPalsuDownyMildewKedelaiPengendalianDilakukanMelakukanEradikasiInokulum,
        ptp:BuktiPengendalianPenyakitEmbunTepungPowderyMildewKedelaiMelakukanEradikasiMenjadiInokulum,
        ptp:BuktiPengendalianPenyakitHawarDaunJagungHalKondisiSanitasiBurukBanyaknya,
        ptp:BuktiPengendalianPenyakitHawarDaunJagungPengendalianDilakukanPengelolaanSanitasiLahan,
        ptp:BuktiPengendalianPenyakitKaratDaunJagungTingginyaDisebabkanBuruknyaSanitasiLahan,
        ptp:BuktiPengendalianPenyakitKaratDaunKacangTanahSanitasiLingkunganPertanamanDiperlukanMengantisipasi,
        ptp:BuktiPengendalianPenyakitKerdilRumputDanKerdilHampaPadiKemudianSanitasiKeberadaanGulmaSinggang,
        ptp:BuktiPengendalianPenyakitKudisUbiJalarBatatasKacanganCampuranSanitasiLahan,
        ptp:BuktiPengendalianPenyakitLayuStewartJagungDjaenuddinMuis2018MengatakanPengendalian,
        ptp:BuktiPengendalianPenyakitMosaikKedelaiSoybeanMosaicVirusKedelaiAdaTerinfeksiMakaSegeraDilakukan,
        ptp:BuktiPengendalianPenyakitRebahKecambahKedelaiSolaniDilakukanTeknikPengendalianKultur,
        ptp:BuktiPengendalianPenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelaiEradikasiInokulumMenjadiTindakanMenekan,
        ptp:BuktiPengendalianPenyakitTungroPadiKemudianSanitasiKeberadaanGulmaSinggang,
        ptp:BuktiPengendalianUmumUbiKayuSelainTindakanPengendalianDilakukanMelalui ;
    ptp:mengendalikanPenyakit ptp:LayuFusariumUbiJalar,
        ptp:PenyakitAntraknosaKedelai,
        ptp:PenyakitBakteriPustulKedelai,
        ptp:PenyakitBercakDaunKacangTanah,
        ptp:PenyakitBercakKuningUbiJalar,
        ptp:PenyakitBercakTargetKedelai,
        ptp:PenyakitEmbunPalsuDownyMildewKedelai,
        ptp:PenyakitEmbunTepungPowderyMildewKedelai,
        ptp:PenyakitHawarDaunJagung,
        ptp:PenyakitKaratDaunJagung,
        ptp:PenyakitKaratDaunKacangTanah,
        ptp:PenyakitKerdilRumputDanKerdilHampaPadi,
        ptp:PenyakitKudisUbiJalar,
        ptp:PenyakitLayuStewartJagung,
        ptp:PenyakitMosaikKedelaiSoybeanMosaicVirusKedelai,
        ptp:PenyakitRebahKecambahKedelai,
        ptp:PenyakitSamarKacangTunggakCowpeaMildMottleVirusKedelai,
        ptp:PenyakitTungroPadi ;
    ptp:namaPengendalian "Sanitasi lahan"@id ;
    rdfs:comment "Tindakan kanonik sanitasi lahan dan sisa tanaman."@id ;
    skos:prefLabel "Sanitasi lahan"@id .

ptp:Patogen a owl:Class ;
    rdfs:label "Patogen"@id ;
    rdfs:comment "Organisme penyebab penyakit tanaman."@id ;
    rdfs:subClassOf ptp:EntitasKBR ;
    owl:disjointWith ptp:BagianTanaman,
        ptp:BuktiSumber,
        ptp:Diagnosis,
        ptp:FaktorRisiko,
        ptp:FasePertumbuhan,
        ptp:Gejala,
        ptp:GejalaKanonik,
        ptp:Observasi,
        ptp:Pengendalian,
        ptp:Penyakit,
        ptp:Referensi,
        ptp:RekomendasiPengendalian,
        ptp:TanamanPangan,
        ptp:Varietas ;
    skos:prefLabel "Patogen"@id .

ptp:Batang a ptp:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Batang"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id ;
    skos:prefLabel "Batang"@id .

ptp:BuktiSumber a owl:Class ;
    rdfs:label "Bukti Sumber"@id ;
    rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:wasDerivedFrom ;
            owl:someValuesFrom ptp:Referensi ],
        ptp:EntitasKBR ;
    owl:disjointWith ptp:BagianTanaman,
        ptp:Diagnosis,
        ptp:FaktorRisiko,
        ptp:FasePertumbuhan,
        ptp:Gejala,
        ptp:GejalaKanonik,
        ptp:Observasi,
        ptp:Patogen,
        ptp:Pengendalian,
        ptp:Penyakit,
        ptp:Referensi,
        ptp:RekomendasiPengendalian,
        ptp:TanamanPangan,
        ptp:Varietas ;
    skos:prefLabel "Bukti Sumber"@id .

ptp:Varietas a owl:Class ;
    rdfs:label "Varietas"@id ;
    rdfs:comment "Varietas tanaman pangan yang disebut sumber."@id ;
    rdfs:subClassOf ptp:EntitasKBR ;
    owl:disjointWith ptp:BagianTanaman,
        ptp:BuktiSumber,
        ptp:Diagnosis,
        ptp:FaktorRisiko,
        ptp:FasePertumbuhan,
        ptp:Gejala,
        ptp:GejalaKanonik,
        ptp:Observasi,
        ptp:Patogen,
        ptp:Pengendalian,
        ptp:Penyakit,
        ptp:Referensi,
        ptp:RekomendasiPengendalian,
        ptp:TanamanPangan ;
    skos:prefLabel "Varietas"@id .

ptp:BuktiPenyakit a owl:Class ;
    rdfs:label "Bukti Penyakit"@id ;
    rdfs:comment "Bukti untuk pernyataan penyakit."@id ;
    rdfs:subClassOf ptp:BuktiSumber ;
    skos:prefLabel "Bukti Penyakit"@id .

ptp:BuktiPatogen a owl:Class ;
    rdfs:label "Bukti Patogen"@id ;
    rdfs:comment "Bukti untuk hubungan penyakit-patogen."@id ;
    rdfs:subClassOf ptp:BuktiSumber ;
    skos:prefLabel "Bukti Patogen"@id .

ptp:BukuDOC005 a ptp:Buku,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Utama Pada Tanaman: Kedelai, Kacang Tanah Dan Kacang Hijau"@id ;
    ptp:dijelaskanDalam ptp:PenyakitAntraknosaKedelai,
        ptp:PenyakitBercakDaunKacangHijau,
        ptp:PenyakitBercakDaunKacangTanah,
        ptp:PenyakitEmbunPalsuDownyMildewKedelai,
        ptp:PenyakitEmbunTepungKacangHijau,
        ptp:PenyakitKaratDaunKacangTanah,
        ptp:PenyakitKaratDaunKedelai,
        ptp:PenyakitLayuKacangHijau ;
    ptp:identifierSumber "DOC005" ;
    ptp:judulReferensi "Penyakit Utama Pada Tanaman: Kedelai, Kacang Tanah Dan Kacang Hijau"@id ;
    ptp:namaPenulis "Sumartini, Emerensiana Uge, Yuliantoro Baliadi" ;
    ptp:tahunTerbit 2020 ;
    rdfs:comment "Referensi buku yang menjadi sumber data."@id ;
    skos:prefLabel "Penyakit Utama Pada Tanaman: Kedelai, Kacang Tanah Dan Kacang Hijau"@id .

ptp:GejalaDaun a owl:Class ;
    rdfs:label "Gejala Daun"@id ;
    rdfs:comment "Gejala yang diamati pada daun."@id ;
    rdfs:subClassOf ptp:Gejala ;
    skos:prefLabel "Gejala Daun"@id .

ptp:Penyakit a owl:Class ;
    rdfs:label "Penyakit"@id ;
    rdfs:comment "Penyakit tanaman pangan yang dicatat dalam sumber."@id ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ptp:Patogen ;
            owl:onProperty ptp:disebabkanOleh ],
        [ a owl:Restriction ;
            owl:onProperty ptp:menyerangTanaman ;
            owl:someValuesFrom ptp:TanamanPangan ],
        [ a owl:Restriction ;
            owl:onProperty ptp:memilikiGejala ;
            owl:someValuesFrom ptp:Gejala ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ptp:Referensi ;
            owl:onProperty ptp:memilikiReferensi ],
        ptp:EntitasKBR ;
    owl:disjointWith ptp:BagianTanaman,
        ptp:BuktiSumber,
        ptp:Diagnosis,
        ptp:FaktorRisiko,
        ptp:FasePertumbuhan,
        ptp:Gejala,
        ptp:GejalaKanonik,
        ptp:Observasi,
        ptp:Patogen,
        ptp:Pengendalian,
        ptp:Referensi,
        ptp:RekomendasiPengendalian,
        ptp:TanamanPangan,
        ptp:Varietas ;
    skos:prefLabel "Penyakit"@id .

ptp:Daun a ptp:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Daun"@id ;
    rdfs:comment "Bagian tanaman yang dapat menjadi lokasi gejala."@id ;
    skos:prefLabel "Daun"@id .

ptp:Gejala a owl:Class ;
    rdfs:label "Gejala"@id ;
    rdfs:comment "Pengamatan gejala pada tanaman atau bagian tanaman."@id ;
    rdfs:subClassOf ptp:EntitasKBR ;
    owl:disjointWith ptp:BagianTanaman,
        ptp:BuktiSumber,
        ptp:Diagnosis,
        ptp:FaktorRisiko,
        ptp:FasePertumbuhan,
        ptp:GejalaKanonik,
        ptp:Observasi,
        ptp:Patogen,
        ptp:Pengendalian,
        ptp:Penyakit,
        ptp:Referensi,
        ptp:RekomendasiPengendalian,
        ptp:TanamanPangan,
        ptp:Varietas ;
    skos:prefLabel "Gejala"@id .

ptp:BuktiGejala a owl:Class ;
    rdfs:label "Bukti Gejala"@id ;
    rdfs:comment "Bukti untuk pengamatan gejala."@id ;
    rdfs:subClassOf ptp:BuktiSumber ;
    skos:prefLabel "Bukti Gejala"@id .

ptp:BuktiPengendalian a owl:Class ;
    rdfs:label "Bukti Pengendalian"@id ;
    rdfs:comment "Bukti untuk tindakan pengendalian."@id ;
    rdfs:subClassOf ptp:BuktiSumber ;
    skos:prefLabel "Bukti Pengendalian"@id .

