ptp:PengendalianBercakDaunKacangTanahHarzianumDitemukanTempatMudahDiisolasi a ptp:Pengendalian,
        owl:NamedIndividual ;
    rdfs:label "harzianum dapat ditemukan di berbagai tempat, mudah diisolasi dan tumbuh cepat pada berbagai substrat, mampu hidup dan berkembang di rhizosfer dan dekat struktur istirahat patogen, mampu beradaptasi terhadap kondisi untuk dapat diperbanyak secara massal, dapat berperan sebagai biofertilizer dan biostimulan, dapat berperan sebagai biokontrol dengan mekanisme mikoparasit, antibiosis, kompetisi nutrisi dan induksi ketahanan tanaman."@id ;
    ptp:deskripsiPengendalian "harzianum dapat ditemukan di berbagai tempat, mudah diisolasi dan tumbuh cepat pada berbagai substrat, mampu hidup dan berkembang di rhizosfer dan dekat struktur istirahat patogen, mampu beradaptasi terhadap kondisi untuk dapat diperbanyak secara massal, dapat berperan sebagai biofertilizer dan biostimulan, dapat berperan sebagai biokontrol dengan mekanisme mikoparasit, antibiosis, kompetisi nutrisi dan induksi ketahanan tanaman."@id ;
