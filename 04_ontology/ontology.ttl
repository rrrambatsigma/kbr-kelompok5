ptp:AntraknosaKedelai a ptp:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Antraknosa"@id ;
    ptp:berkaitanPengendalian ptp:PengendalianAntraknosaKedelai,
        ptp:PengendalianAntraknosaKedelaiAplikasiAirRimpangLengkuasPerkembangan,
        ptp:PengendalianAntraknosaKedelaiAplikasiFungisidaSaafFungisidaBerbahan,
        ptp:PengendalianBenihSehatAntraknosaKedelai,
        ptp:PengendalianFungisidaAntraknosaKedelai,
        ptp:PengendalianPerlakuanBenihAgensHayatiAntraknosaKedelai,
        ptp:PengendalianRotasiTanamanAntraknosaKedelai,
        ptp:PengendalianSanitasiLahanAntraknosaKedelai,
        ptp:PengendalianSanitasiLahanFungisida ;
    ptp:deskripsiPenyakit "Penyakit ini disebabkan oleh cendawan Colletotrichum truncatum (Schwein.) dari kelompok Genus Colletotrichum, dengan klasifikasi menurut (Alexopodus dan Mims 1996) sebagai berikut: Hifa cendawan pada biji tidak berwarna (hialin), bersekat, dan bercabang, sedangkan acervuli pada biji berbentuk oval hingga kerucut, dengan warna coklat kehitaman dan berukuran 178,6 × 256,0 µm. Pada acervuli akan ditemukan massa konidia. Apabila cendawan diisolasi pada media PDA akan menunjukkan koloni berwarna abu-abu gelap dengan tepian halus (Gambar 7)."@id ;
    ptp:dikendalikanDengan ptp:PengendalianAntraknosaKedelai,
        ptp:PengendalianAntraknosaKedelaiAplikasiAirRimpangLengkuasPerkembangan,
        ptp:PengendalianAntraknosaKedelaiAplikasiFungisidaSaafFungisidaBerbahan,
        ptp:PengendalianBenihSehatAntraknosaKedelai,
        ptp:PengendalianFungisidaAntraknosaKedelai,
        ptp:PengendalianPerlakuanBenihAgensHayatiAntraknosaKedelai,
        ptp:PengendalianRotasiTanamanAntraknosaKedelai,
        ptp:PengendalianSanitasiLahanAntraknosaKedelai,
        ptp:PengendalianSanitasiLahanFungisida ;
    ptp:dipengaruhiOleh ptp:KondisiAngin,
        ptp:SuhuMaksimum30,
        ptp:SuhuOptimal20,
        ptp:SuhuTercatat25Sampai30 ;
    ptp:disebabkanOleh ptp:Colletotrichum,
        ptp:ColletotrichumTruncatum ;
    ptp:halamanSumber 32 ;
    ptp:kutipanSumber "Penyakit ini disebabkan oleh cendawan Colletotrichum truncatum (Schwein.) dari kelompok Genus Colletotrichum, dengan klasifikasi menurut (Alexopodus dan Mims 1996) sebagai berikut: Hifa cendawan pada biji tidak berwarna (hialin), bersekat, dan bercabang, sedangkan acervuli pada biji berbentuk oval hingga kerucut, dengan warna coklat kehitaman dan berukuran 178,6 × 256,0 µm. Pada acervuli akan ditemukan massa konidia. Apabila cendawan diisolasi pada media PDA akan menunjukkan koloni berwarna abu-abu gelap dengan tepian halus (Gambar 7)."@id ;
    ptp:memilikiGejala ptp:GejalaAntraknosaKedelai,
        ptp:GejalaAntraknosaKedelaiJaringanTerinfeksiMakaAdaBercak,
        ptp:GejalaBercakHitam,
        ptp:GejalaDaunAntraknosaKedelai,
        ptp:GejalaDaunAntraknosaKedelaiDitemukanBagian,
        ptp:GejalaDaunBercakNekrotikCoklat,
        ptp:GejalaDaunMenggulungGugur,
        ptp:GejalaNekrotik ;
    ptp:memilikiReferensi ptp:BukuPenyakitTanamanDanPengendaliannya,
        ptp:BukuPenyakitUtamaPadaTanamanKedelaiKacangTanahDanKacangHijau ;
    ptp:menyerangBagian ptp:Batang,
        ptp:Daun,
        ptp:Polong ;
    ptp:menyerangTanaman ptp:Kedelai ;
    dcterms:identifier "DIS_013",
        "DIS_120" ;
    dcterms:source "DOC002",
        "DOC005" ;
    skos:altLabel "ANTRAKNOSA"@id ;
    skos:definition "Penyakit ini disebabkan oleh cendawan Colletotrichum truncatum (Schwein.) dari kelompok Genus Colletotrichum, dengan klasifikasi menurut (Alexopodus dan Mims 1996) sebagai berikut: Hifa cendawan pada biji tidak berwarna (hialin), bersekat, dan bercabang, sedangkan acervuli pada biji berbentuk oval hingga kerucut, dengan warna coklat kehitaman dan berukuran 178,6 × 256,0 µm. Pada acervuli akan ditemukan massa konidia. Apabila cendawan diisolasi pada media PDA akan menunjukkan koloni berwarna abu-abu gelap dengan tepian halus (Gambar 7)."@id ;
    skos:prefLabel "Penyakit Antraknosa"@id .

ptp:BulaiJagung a ptp:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Bulai"@id ;
    ptp:berkaitanPengendalian ptp:PengendalianAgensHayatiBulaiJagung,
        ptp:PengendalianBulaiJagung,
        ptp:PengendalianBulaiJagungDiberikanKombinasiVarietasPioneerIsolat,
        ptp:PengendalianBulaiJagungFluorescensMemberikanKetahananTerinduksiMengeluarkan,
        ptp:PengendalianBulaiJagungFluorescensMempunyaiKejadianRendah,
        ptp:PengendalianBulaiJagungFungisidaDigunakanPerkecambahanKonidiaPeronosclerospora,
        ptp:PengendalianBulaiJagungPemberianPupukKaliumMenurunkanLaju,
        ptp:PengendalianBulaiJagungPengendalianMenggunakanAgensHayatiPseudomonas,
        ptp:PengendalianBulaiJagungPenggunaanBahanKimiaBerkepanjanganDosis,
        ptp:PengendalianBulaiJagungUlhaqMasnilahVarietasPioneerAgak,
        ptp:PengendalianFungisidaBulaiJagung,
        ptp:PengendalianFungisidaSintetikFungisida,
        ptp:PengendalianKulturTeknisBulaiJagung,
        ptp:PengendalianVarietasTahanBulaiJagung ;
    ptp:deskripsiPenyakit "Spora jamur akan disebarkan oleh angin. Kecepatan angin, kelembaban yang tinggi lebih dari 90% dan suhu di bawah 24°C dapat meningkatkan laju infeksi penyakit bulai. Penyakit bulai menyerang tanaman pada fase vegetatif dan infeksi akan berkurang saat tanaman semakin tua karena semakin dewasa tanaman akan lebih tahan terhadap penyakit bulai (Purwanto et al., 2016)."@id ;
    ptp:dikendalikanDengan ptp:PengendalianAgensHayatiBulaiJagung,
        ptp:PengendalianBulaiJagung,
        ptp:PengendalianBulaiJagungDiberikanKombinasiVarietasPioneerIsolat,
        ptp:PengendalianBulaiJagungFluorescensMemberikanKetahananTerinduksiMengeluarkan,
        ptp:PengendalianBulaiJagungFluorescensMempunyaiKejadianRendah,
        ptp:PengendalianBulaiJagungFungisidaDigunakanPerkecambahanKonidiaPeronosclerospora,
        ptp:PengendalianBulaiJagungPemberianPupukKaliumMenurunkanLaju,
        ptp:PengendalianBulaiJagungPengendalianMenggunakanAgensHayatiPseudomonas,
