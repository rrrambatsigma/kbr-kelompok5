    kbr:sourceBlockId "DOC002_P094_B001"@id ;
    kbr:symptomText "Tanaman tidak tumbuh secara normal, gejala ini umumnya terjadi pada tanaman yang mengalami infeksi awal oleh virus ini. Tanaman yang terinfeksi virus ini umumnya akan memiliki batang yang berukuran kecil"@id .

kbrd:T5_2_BATANG_R_unnumbered_1 a kbr:SourceTableRow,
        owl:NamedIndividual ;
