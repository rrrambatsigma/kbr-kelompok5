kbrd:CTL_456 a kbr:ChapterControl,
        kbr:ControlMeasure,
        owl:NamedIndividual ;
    rdfs:label "harzianum dapat ditemukan di berbagai tempat, mudah diisolasi dan tumbuh cepat pada berbagai substrat, mampu hidup dan berkembang di rhizosfer dan dekat struktur istirahat patogen, mampu beradaptasi terhadap kondisi untuk dapat diperbanyak secara massal, dapat berperan sebagai biofertilizer dan biostimulan, dapat berperan sebagai biokontrol dengan mekanisme mikoparasit, antibiosis, kompetisi nutrisi dan induksi ketahanan tanaman."@id ;
    kbr:appliesToPlant kbrd:PLANT_003 ;
    kbr:charEnd 1388 ;
    kbr:charStart 955 ;
    kbr:hasEvidence kbrd:DOC002_C067_01 ;
    kbr:hasSourceDocument kbrd:DOC002 ;
    kbr:pageEnd 67 ;
    kbr:pageStart 67 ;
    kbr:reviewStatus "auto_ok"@id ;
    kbr:verbatimText "harzianum dapat ditemukan di berbagai tempat, mudah diisolasi dan tumbuh cepat pada berbagai substrat, mampu hidup dan berkembang di rhizosfer dan dekat struktur istirahat patogen, mampu beradaptasi terhadap kondisi untuk dapat diperbanyak secara massal, dapat berperan sebagai biofertilizer dan biostimulan, dapat berperan sebagai biokontrol dengan mekanisme mikoparasit, antibiosis, kompetisi nutrisi dan induksi ketahanan tanaman."@id .

