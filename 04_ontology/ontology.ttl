        owl:NamedIndividual ;
    rdfs:label "akibat serangan patogen ini maka benih yang dihasilkan menjadi berukuran kecil dan warnanya akan berubah."@id ;
    ptp:deskripsiGejala "akibat serangan patogen ini maka benih yang dihasilkan menjadi berukuran kecil dan warnanya akan berubah."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitHawarBakteriBacterialBlightKedelai .

