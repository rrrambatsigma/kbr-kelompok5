###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala2018MenjelaskanBahwaGejalaAwal_5c05bed5
ptp:Gejala2018MenjelaskanBahwaGejalaAwal_5c05bed5 rdf:type owl:NamedIndividual ,
                                                           ptp:Gejala ,
                                                           ptp:GejalaDaun ;
                                                  ptp:merupakanGejalaDari ptp:LayuFusariumUbiJalar ;
                                                  ptp:terdapatPada ptp:Daun ;
                                                  ptp:deskripsiGejala "(2018) menjelaskan bahwa gejala awal ditandai dengan daun yang terinfeksi berwarna kuning pada bagian atas, diikuti menguningnya pada bagian bawah dan lebih cepat pada daun tua."@id ;
                                                  rdfs:label "(2018) menjelaskan bahwa gejala awal ditandai dengan daun yang terinfeksi berwarna kuning pada bagian atas, diikuti menguningnya pada bagian bawah dan lebih cepat pada daun tua."@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#Gejala2018MenjelaskanBahwaGejalaSerangan_a1bd3ac9
ptp:Gejala2018MenjelaskanBahwaGejalaSerangan_a1bd3ac9 rdf:type owl:NamedIndividual ,
                                                               ptp:Gejala ;
                                                      ptp:merupakanGejalaDari ptp:PenyakitBusukHitamBlackRotUbiJalar ;
                                                      ptp:deskripsiGejala "(2018) menjelaskan bahwa gejala serangan C."@id ;
                                                      rdfs:label "(2018) menjelaskan bahwa gejala serangan C."@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAdapunBentukBercakSendiriDapat_626f021f
ptp:GejalaAdapunBentukBercakSendiriDapat_626f021f rdf:type owl:NamedIndividual ,
                                                           ptp:Gejala ;
                                                  ptp:merupakanGejalaDari ptp:PenyakitHawarPelepahDaunPadi ;
                                                  ptp:deskripsiGejala "Adapun bentuk bercak sendiri dapat berupa bulat lonjong dengan panjang 2 – 3 cm yang kemudian akan meluas."@id ;
                                                  rdfs:label "Adapun bentuk bercak sendiri dapat berupa bulat lonjong dengan panjang 2 – 3 cm yang kemudian akan meluas."@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAdapunBentukWarnaDanUkuran_f8023518
ptp:GejalaAdapunBentukWarnaDanUkuran_f8023518 rdf:type owl:NamedIndividual ,
                                                       ptp:Gejala ;
                                              ptp:merupakanGejalaDari ptp:PenyakitBlasPadi ;
                                              ptp:deskripsiGejala "Adapun bentuk, warna dan ukuran dari bercak dapat bervariasi tergantung dari umur dan ketahanan varietas tanaman serta umur dari bercak (Ou 1985)."@id ;
                                              rdfs:label "Adapun bentuk, warna dan ukuran dari bercak dapat bervariasi tergantung dari umur dan ketahanan varietas tanaman serta umur dari bercak (Ou 1985)."@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAdapunGejalaDiLapanganPada_b6b7db6c
ptp:GejalaAdapunGejalaDiLapanganPada_b6b7db6c rdf:type owl:NamedIndividual ,
                                                       ptp:Gejala ,
                                                       ptp:GejalaDaun ;
                                              ptp:merupakanGejalaDari ptp:PenyakitBercakKuningUbiJalar ;
                                              ptp:terdapatPada ptp:Daun ;
                                              ptp:deskripsiGejala "Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018)."@id ;
                                              rdfs:label "Adapun gejala di lapangan pada daun yaitu kadang-kadang tidak tampak atau mottling, klorosis, bercak klorotik (Tugume, Mukasa and Valkonen, 2008), dan bercak kuning (Hondo et al., 2018)."@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaAkarMembusukTerdapatTubuhBuah_0f535eca
ptp:GejalaAkarMembusukTerdapatTubuhBuah_0f535eca rdf:type owl:NamedIndividual ,
                                                          ptp:Gejala ,
                                                          ptp:GejalaAkar ,
                                                          ptp:GejalaBatang ;
                                                 ptp:merupakanGejalaDari ptp:BusukAkarUbiKayu ;
