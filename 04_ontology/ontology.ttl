    ptp:merupakanGejalaDari ptp:PenyakitHawarPelepahDaunPadi ;
    ptp:terdapatPada ptp:Daun ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Bercak daun pada Penyakit Hawar Pelepah Daun"@id .

ptp:PengamatanPenyakitHawarPelepahDaunPadiBusukBatang a ptp:GejalaBatang,
        ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Busuk batang pada Penyakit Hawar Pelepah Daun"@id ;
