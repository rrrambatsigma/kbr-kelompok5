    ptp:halamanSumber "84" ;
    ptp:idChunkSumber "DOC002_C084_04" ;
    ptp:identifierSumber "CTL_189" ;
    ptp:kutipanNormalisasi "batatas misalnya jagung, padi, kacang-kacangan, penanaman varietas campuran misalnya varietas yang tahan dengan yang agak tahan, sanitasi lahan dengan cara membakar atau mengubur dalam tanah sisa-sisa tanaman yang terinfeksi, menggunakan fungisida kimiawi misalnya menggunakan bahan aktif benomyl (dosis 400 g ba/ha), chlorotalonil (1.300 g ba/ha), captafol (1.520 g ba/ha), fentin hidraxide (300 g ba/ha), tembaga oxiklorida (1.500 g ba/ha), dan mancozeb, dapat juga menggunakan fungisida nabati (Saleh and Rahayuningsih, 2013)."@id ;
    ptp:kutipanSumber "batatas misalnya jagung, padi, kacang-kacangan, penanaman varietas campuran misalnya varietas yang tahan dengan yang agak tahan, sanitasi lahan dengan cara membakar atau mengubur dalam tanah sisa-sisa tanaman yang terinfeksi, menggunakan fungisida kimiawi misalnya menggunakan bahan aktif benomyl (dosis 400 g ba/ha), chlorotalonil (1.300 g ba/ha), captafol (1.520 g ba/ha), fentin hidraxide (300 g ba/ha), tembaga oxiklorida (1.500 g ba/ha), dan mancozeb, dapat juga menggunakan fungisida nabati (Saleh and Rahayuningsih, 2013)."@id ;
    rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
    skos:prefLabel "Bukti pengendalian Penyakit kudis"@id ;
    prov:wasDerivedFrom ptp:BukuDOC002 .

