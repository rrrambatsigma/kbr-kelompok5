        owl:NamedIndividual ;
    rdfs:label "harzianum juga dapat memarasit miselium jamur lain dengan menembus dinding sel dan masuk ke dalam sel untuk mengambil zat makanan dari dalam sel sehingga jamur menjadi mati, dalam proses kompetisi jamur T."@id ;
    ptp:deskripsiPengendalian "harzianum juga dapat memarasit miselium jamur lain dengan menembus dinding sel dan masuk ke dalam sel untuk mengambil zat makanan dari dalam sel sehingga jamur menjadi mati, dalam proses kompetisi jamur T."@id ;
    ptp:mengendalikanPenyakit ptp:PenyakitBercakDaunKacangTanah .

