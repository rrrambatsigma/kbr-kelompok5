ptp:BuktiPengendalianPenyakitKudisUbiJalar2 a ptp:BuktiPengendalian,
        owl:NamedIndividual ;
    rdfs:label "Bukti pengendalian Penyakit kudis (Ubi jalar)"@id ;
    ptp:catatanKualitas "Kutipan sumber berupa fragmen atau kalimat terpotong."@id ;
    ptp:dokumenSumber "DOC002" ;
    ptp:halamanSumber "84" ;
    ptp:idChunkSumber "DOC002_C084_04" ;
    ptp:identifierSumber "CTL_189" ;
    ptp:kutipanNormalisasi "batatas misalnya jagung, padi, kacang-kacangan, penanaman varietas campuran misalnya varietas yang tahan dengan yang agak tahan, sanitasi lahan dengan cara membakar atau mengubur dalam tanah sisa-sisa tanaman yang terinfeksi, menggunakan fungisida kimiawi misalnya menggunakan bahan aktif benomyl (dosis 400 g ba/ha), chlorotalonil (1.300 g ba/ha), captafol (1.520 g ba/ha), fentin hidraxide (300 g ba/ha), tembaga oxiklorida (1.500 g ba/ha), dan mancozeb, dapat juga menggunakan fungisida nabati (Saleh and Rahayuningsih, 2013)."@id ;
    ptp:kutipanSumber "batatas misalnya jagung, padi, kacang-kacangan, penanaman varietas campuran misalnya varietas yang tahan dengan yang agak tahan, sanitasi lahan dengan cara membakar atau mengubur dalam tanah sisa-sisa tanaman yang terinfeksi, menggunakan fungisida kimiawi misalnya menggunakan bahan aktif benomyl (dosis 400 g ba/ha), chlorotalonil (1.300 g ba/ha), captafol (1.520 g ba/ha), fentin hidraxide (300 g ba/ha), tembaga oxiklorida (1.500 g ba/ha), dan mancozeb, dapat juga menggunakan fungisida nabati (Saleh and Rahayuningsih, 2013)."@id ;
    rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
    skos:prefLabel "Bukti pengendalian Penyakit kudis (Ubi jalar)"@id ;
    prov:wasDerivedFrom ptp:BukuDOC002 .

ptp:BuktiPengendalianPenyakitLayuFusariumKedelai a ptp:BuktiPengendalian,
        owl:NamedIndividual ;
    rdfs:label "Bukti pengendalian Penyakit Layu Fusarium (Kedelai)"@id ;
    ptp:catatanKualitas "Kutipan sumber berupa fragmen atau kalimat terpotong."@id ;
    ptp:dokumenSumber "DOC002" ;
    ptp:halamanSumber "43" ;
    ptp:idChunkSumber "DOC002_C043_02" ;
    ptp:identifierSumber "CTL_049" ;
    ptp:kutipanNormalisasi "dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017)."@id ;
    ptp:kutipanSumber "dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017)."@id ;
    rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
    skos:prefLabel "Bukti pengendalian Penyakit Layu Fusarium (Kedelai)"@id ;
    prov:wasDerivedFrom ptp:BukuDOC002 .

