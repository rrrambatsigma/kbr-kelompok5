        owl:NamedIndividual ;
    rdfs:label "Bercak daun pada BERCAK DAUN"@id ;
    ptp:deskripsiGejala "Bercak pada daun terinfeksi umumnya berbentuk agak bundar hingga tidak beraturan, dan umumnya berwarna coklat, bagian tengah berwarna keabu-abuan dan dikelilingi oleh bercak coklat kemerahan dengan bentuk permukaan agak tertekan (Gambar 21)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitBercakDaunKacangHijauTerinfeksiUmumnyaBerbentukBundarHingga ;
