@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ptp: <http://kbr.kelompok5.org/penyakit-tanaman-pangan#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://kbr.kelompok5.org/penyakit-tanaman-pangan> a owl:Ontology ;
    rdfs:label "Ontologi Penyakit Tanaman Pangan Indonesia"@id ;
    rdfs:comment "Knowledge base penyakit tanaman pangan Indonesia (prototipe: kacang tanah, ubi jalar, ubi kayu) untuk penalaran OWL di Protégé."@id .

ptp:ArtikelIlmiah a owl:Class ;
    rdfs:label "Artikel Ilmiah"@id ;
    rdfs:subClassOf ptp:Referensi .

ptp:CurahHujan a owl:Class ;
    rdfs:label "Curah Hujan"@id ;
    rdfs:subClassOf ptp:FaktorLingkungan .

ptp:DrainaseBuruk a owl:Class ;
    rdfs:label "Drainase Buruk"@id ;
    rdfs:subClassOf ptp:FaktorBudidaya .

ptp:JurnalIlmiah a owl:Class ;
    rdfs:label "Jurnal Ilmiah"@id ;
    rdfs:subClassOf ptp:Referensi .

ptp:KelembapanTinggi a owl:Class ;
    rdfs:label "Kelembapan Tinggi"@id ;
    rdfs:subClassOf ptp:FaktorLingkungan .

ptp:KondisiDrainase a owl:Class ;
    rdfs:label "Kondisi Drainase"@id ;
    rdfs:subClassOf ptp:FaktorLahan .

ptp:KondisiTanah a owl:Class ;
    rdfs:label "Kondisi Tanah"@id ;
    rdfs:subClassOf ptp:FaktorLahan .

ptp:PengendalianBiologis a owl:Class ;
    rdfs:label "Pengendalian Biologis"@id ;
    rdfs:subClassOf ptp:Pengendalian .

ptp:PengendalianKimiawi a owl:Class ;
    rdfs:label "Pengendalian Kimiawi"@id ;
    rdfs:subClassOf ptp:Pengendalian .

ptp:PengendalianKulturTeknis a owl:Class ;
    rdfs:label "Pengendalian Kultur Teknis"@id ;
    rdfs:subClassOf ptp:Pengendalian .

ptp:PengendalianMekanis a owl:Class ;
    rdfs:label "Pengendalian Mekanis"@id ;
    rdfs:subClassOf ptp:Pengendalian .

ptp:PengendalianTerpadu a owl:Class ;
    rdfs:label "Pengendalian Terpadu"@id ;
    rdfs:subClassOf ptp:Pengendalian .

ptp:PenggunaanBenihTerinfeksi a owl:Class ;
    rdfs:label "Penggunaan Benih Terinfeksi"@id ;
    rdfs:subClassOf ptp:FaktorBudidaya .

ptp:PenyakitJamur a owl:Class ;
    rdfs:label "Penyakit Jamur"@id ;
    rdfs:subClassOf ptp:Penyakit ;
    owl:disjointWith ptp:PenyakitBakteri,
        ptp:PenyakitLainnya,
        ptp:PenyakitVirus ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ptp:Penyakit [ a owl:Restriction ;
                        owl:onProperty ptp:disebabkanOleh ;
                        owl:someValuesFrom ptp:Jamur ] ) ] .

ptp:PublikasiInstansi a owl:Class ;
    rdfs:label "Publikasi Instansi"@id ;
    rdfs:subClassOf ptp:Referensi .

ptp:SanitasiLahanBuruk a owl:Class ;
    rdfs:label "Sanitasi Lahan Buruk"@id ;
    rdfs:subClassOf ptp:FaktorBudidaya .

ptp:Suhu a owl:Class ;
    rdfs:label "Suhu"@id ;
    rdfs:subClassOf ptp:FaktorLingkungan .

ptp:deskripsiGejala a owl:DatatypeProperty ;
    rdfs:label "deskripsi gejala"@id ;
    rdfs:comment "Penjelasan gejala menurut sumber."@id ;
    rdfs:domain ptp:Gejala .

ptp:deskripsiPengendalian a owl:DatatypeProperty ;
    rdfs:label "deskripsi pengendalian"@id ;
    rdfs:comment "Penjelasan metode pengendalian menurut sumber."@id ;
    rdfs:domain ptp:Pengendalian .

ptp:deskripsiPenyakit a owl:DatatypeProperty ;
    rdfs:label "deskripsi penyakit"@id ;
    rdfs:comment "Penjelasan penyakit menurut sumber."@id ;
    rdfs:domain ptp:Penyakit .

ptp:deskripsiTanaman a owl:DatatypeProperty ;
    rdfs:label "deskripsi tanaman"@id ;
    rdfs:comment "Deskripsi tanaman pangan."@id ;
    rdfs:domain ptp:TanamanPangan .

ptp:dipengaruhiOleh a owl:ObjectProperty ;
    rdfs:label "dipengaruhi oleh"@id ;
    rdfs:comment "Faktor risiko lingkungan/budidaya yang memengaruhi kemunculan penyakit."@id ;
    rdfs:domain ptp:Penyakit ;
    rdfs:range ptp:FaktorRisiko .

ptp:judulReferensi a owl:DatatypeProperty ;
    rdfs:label "judul referensi"@id ;
    rdfs:comment "Judul sumber referensi."@id ;
    rdfs:domain ptp:Referensi .

ptp:menyerangBagian a owl:ObjectProperty ;
    rdfs:label "menyerang bagian"@id ;
    rdfs:comment "Bagian tanaman (daun, batang, akar, umbi) yang terserang penyakit."@id ;
    rdfs:domain ptp:Penyakit ;
    rdfs:range ptp:BagianTanaman .

ptp:namaIlmiah a owl:DatatypeProperty ;
    rdfs:label "nama ilmiah"@id ;
    rdfs:comment "Nama ilmiah tanaman pangan."@id ;
    rdfs:domain ptp:TanamanPangan .

ptp:namaIlmiahPatogen a owl:DatatypeProperty ;
    rdfs:label "nama ilmiah patogen"@id ;
    rdfs:comment "Nama ilmiah patogen penyebab penyakit."@id ;
    rdfs:domain ptp:Patogen .

ptp:namaPengendalian a owl:DatatypeProperty ;
    rdfs:label "nama pengendalian"@id ;
    rdfs:comment "Nama metode pengendalian."@id ;
    rdfs:domain ptp:Pengendalian .

ptp:namaPenulis a owl:DatatypeProperty ;
    rdfs:label "nama penulis"@id ;
    rdfs:comment "Penulis referensi."@id ;
    rdfs:domain ptp:Referensi .

ptp:tahunTerbit a owl:DatatypeProperty ;
    rdfs:label "tahun terbit"@id ;
    rdfs:comment "Tahun publikasi referensi."@id ;
    rdfs:domain ptp:Referensi .

ptp:terdapatPada a owl:ObjectProperty ;
    rdfs:label "terdapat pada"@id ;
    rdfs:comment "Lokasi gejala pada bagian tanaman tertentu."@id ;
    rdfs:domain ptp:Gejala ;
    rdfs:range ptp:BagianTanaman .

ptp:tingkatKeparahan a owl:DatatypeProperty ;
    rdfs:label "tingkat keparahan"@id ;
    rdfs:comment "Kategori keparahan penyakit bila tersedia di sumber."@id ;
    rdfs:domain ptp:Penyakit .

ptp:urlReferensi a owl:DatatypeProperty ;
    rdfs:label "url referensi"@id ;
    rdfs:comment "Tautan sumber referensi."@id ;
    rdfs:domain ptp:Referensi .

ptp:Buah a ptp:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Buah"@id .

ptp:Buku a owl:Class ;
    rdfs:label "Buku"@id ;
    rdfs:subClassOf ptp:Referensi .

