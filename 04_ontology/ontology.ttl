    ptp:terdapatPada ptp:Batang ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Kerdil tanaman pada Penyakit Kerdil Kedelai (Soybean Stunt Virus)"@id .

ptp:PengamatanPenyakitKerdilKedelaiSoybeanStuntVirusKedelaiMosaikDaun a ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Mosaik daun pada Penyakit Kerdil Kedelai (Soybean Stunt Virus)"@id ;
    ptp:deskripsiGejala "Pada daun yang terinfeksi ukurannya menjadi lebih kecil dibandingkan pada daun yang normal, yang diikuti dengan adanya mosaik pada daun (Gambar 2.19)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitKerdilKedelaiSoybeanStuntVirusKedelaiTerinfeksiUkurannyaMenjadiKecilDibandingkan ;
    ptp:memilikiGejalaKanonik ptp:MosaikDaun ;
    ptp:merupakanGejalaDari ptp:PenyakitKerdilKedelaiSoybeanStuntVirusKedelai ;
    ptp:terdapatPada ptp:Daun ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Mosaik daun pada Penyakit Kerdil Kedelai (Soybean Stunt Virus)"@id .

ptp:PengamatanPenyakitKerdilKedelaiSoybeanStuntVirusKedelaiPertumbuhanTerhambat a ptp:GejalaBatang,
        owl:NamedIndividual ;
    rdfs:label "Pertumbuhan terhambat pada Penyakit Kerdil Kedelai (Soybean Stunt Virus)"@id ;
    ptp:deskripsiGejala "Tanaman yang terinfeksi akan menunjukkan gejala terhambatnya pertumbuhan tanaman kedelai."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitKerdilKedelaiSoybeanStuntVirusKedelaiTerinfeksiMenunjukkanTerhambatnyaPertumbuhan ;
