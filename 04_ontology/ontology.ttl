    skos:prefLabel "Pengamatan gejala Penyakit Antraknosa"@id .

ptp:PengamatanPenyakitAntraknosaKedelaiKondisiLembapMenggulungGugurPolong a ptp:GejalaDaun,
        ptp:GejalaPolong,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala ANTRAKNOSA"@id ;
    ptp:deskripsiGejala "Pada kondisi lembap, daun akan menggulung dan mudah gugur, sedangkan pada polong akan terlihat acervuli yang membentuk pola cincin konsentris (Gambar 6b)."@id ;
