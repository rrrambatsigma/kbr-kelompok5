ptp:BuktiLingkunganPenyakitLayuFusariumKedelaiDilakukanTeknikPengendalianMemperbaikiSaluran a ptp:BuktiSumber,
        owl:NamedIndividual ;
    rdfs:label "Bukti faktor lingkungan Penyakit Layu Fusarium"@id ;
    ptp:catatanKualitas "Kutipan sumber berupa fragmen atau kalimat terpotong."@id ;
    ptp:dokumenSumber "DOC002" ;
    ptp:halamanSumber "43" ;
    ptp:idChunkSumber "DOC002_C043_02" ;
    ptp:identifierSumber "CTL_049" ;
    ptp:kutipanNormalisasi "dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017)."@id ;
    ptp:kutipanSumber "dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017)."@id ;
    rdfs:comment "Node bukti yang menyimpan kutipan dan lokasi sumber."@id ;
    skos:prefLabel "Bukti faktor lingkungan Penyakit Layu Fusarium"@id ;
    prov:wasDerivedFrom ptp:BukuDOC002 .

