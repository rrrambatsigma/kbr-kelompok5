<http://kbr.kelompok5.org/ontology> a owl:Ontology ;
    rdfs:label "Ontologi Penyakit dan Pengendalian Tanaman Pangan"@id ;
    rdfs:comment "Ontologi OWL 2 dari knowledge tables Tahap 2 (03_knowledge_tables). TBox menjelaskan kelas, properti, dan hubungan domain; ABox dibangun dari tabel curated (tanaman, penyakit, patogen, gejala, pengendalian, tabel ubi kayu, nutrisi/pupuk) beserta bukti chunk yang dapat ditelusuri ke dokumen sumber."@id ;
    owl:versionInfo "1.0.0" .

kbr:Macronutrient a owl:Class ;
    rdfs:label "Makronutrien"@id ;
