ptp:BercakDaunCoklatUbiKayu a ptp:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun Coklat"@id ;
    ptp:deskripsiPenyakit "Penyakit pada daun tanaman ubi kayu dapat menyebabkan kerusakan pada daun dan menurunkan hasil pertanian ubi kayu berupa sayuran (daun singkong). Selain itu, kerusakan daun akibat serangan penyakit dapat menyebabkan penurunan aktivitas fotosintesis yang dapat berakibat pada penurunan hasil dan kualitas umbi akar. Serangan penyakit pada daun tanaman ubi kayu di antaranya berupa bercak daun coklat, bercak daun baur, hawar daun bakteri, bercak daun putih, antraknosa, layu bakteri, dan virus mosaik."@id ;
    ptp:disebabkanOleh ptp:CercosporaHenningsii,
        ptp:CercosporidiumHenningsii ;
    ptp:halamanSumber 91 ;
    ptp:idBlokSumber "DOC002_P091_B005" ;
    ptp:kutipanSumber "Penyakit pada daun tanaman ubi kayu dapat menyebabkan kerusakan pada daun dan menurunkan hasil pertanian ubi kayu berupa sayuran (daun singkong). Selain itu, kerusakan daun akibat serangan penyakit dapat menyebabkan penurunan aktivitas fotosintesis yang dapat berakibat pada penurunan hasil dan kualitas umbi akar. Serangan penyakit pada daun tanaman ubi kayu di antaranya berupa bercak daun coklat, bercak daun baur, hawar daun bakteri, bercak daun putih, antraknosa, layu bakteri, dan virus mosaik."@id ;
    ptp:memilikiGejala ptp:GejalaDaunBercakDaunCoklatUbiKayu ;
    ptp:memilikiReferensi ptp:BukuPenyakitTanamanDanPengendaliannya ;
    ptp:menyerangBagian ptp:Daun ;
    ptp:menyerangTanaman ptp:UbiKayu ;
    dcterms:identifier "DIS_028" ;
    dcterms:source "DOC002" ;
    skos:definition "Penyakit pada daun tanaman ubi kayu dapat menyebabkan kerusakan pada daun dan menurunkan hasil pertanian ubi kayu berupa sayuran (daun singkong). Selain itu, kerusakan daun akibat serangan penyakit dapat menyebabkan penurunan aktivitas fotosintesis yang dapat berakibat pada penurunan hasil dan kualitas umbi akar. Serangan penyakit pada daun tanaman ubi kayu di antaranya berupa bercak daun coklat, bercak daun baur, hawar daun bakteri, bercak daun putih, antraknosa, layu bakteri, dan virus mosaik."@id ;
    skos:prefLabel "Bercak daun Coklat"@id ;
    prov:wasDerivedFrom "DOC002_P091_B005" .

