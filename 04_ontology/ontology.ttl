kbr:appliesTo a owl:ObjectProperty ;
    rdfs:label "berlaku untuk penyakit"@id ;
    rdfs:comment "Tindakan pengendalian berlaku untuk penyakit tertentu (scope = disease)."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:C kbr:o kbr:n kbr:t kbr:r kbr:o kbr:l kbr:M kbr:e kbr:a kbr:s kbr:u kbr:r kbr:e ) ] ;
    rdfs:range kbr:Disease ;
    owl:inverseOf kbr:hasControlMeasure .

kbr:hasSymptom a owl:ObjectProperty ;
    rdfs:label "memiliki gejala"@id ;
    rdfs:comment "Penyakit memiliki gejala; setiap baris gejala berupa satu kalimat verbatim."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:D kbr:i kbr:s kbr:e kbr:a kbr:s kbr:e ) ] ;
    rdfs:range kbr:Symptom ;
    owl:inverseOf kbr:symptomOf .

kbr:occursIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "terjadi pada"@id ;
    rdfs:comment "Penyakit terjadi pada tanaman inang. Fungsional: satu penyakit menunjuk tepat satu tanaman (satu baris disease)."@id ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kbr:D kbr:i kbr:s kbr:e kbr:a kbr:s kbr:e ) ] ;
    rdfs:range kbr:Plant ;
    owl:inverseOf kbr:hasDisease ;
    owl:propertyChainAxiom ( kbr:hasSymptom kbr:observedOn ) .

