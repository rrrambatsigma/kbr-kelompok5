    skos:altLabel "BERCAK DAUN"@id ;
    skos:definition "Penyakit bercak daun disebabkan oleh dua jenis cendawan, yaitu Cercospora arachidicola dan Cercospora personata (Bercak yang disebabkan oleh C. arachidicola berwarna coklat muda hingga coklat tua ditandai dengan warna kuning di sekitar bercak (halo kuning), sedangkan gejala akibat infeksi C. personata cenderung lebih hitam."@id ;
    skos:prefLabel "Penyakit Bercak Daun"@id .

ptp:Patogen a owl:Class ;
    rdfs:label "Patogen"@id ;
    rdfs:comment "Organisme penyebab penyakit."@id ;
    rdfs:isDefinedBy <http://kbr.kelompok5.org/penyakit-tanaman-pangan> ;
    owl:disjointWith ptp:BagianTanaman,
        ptp:FaktorRisiko,
        ptp:FasePertumbuhan,
        ptp:Pengendalian,
        ptp:Referensi,
        ptp:Varietas ;
    skos:prefLabel "Patogen"@id .

ptp:PengendalianKulturTeknis a owl:Class ;
    rdfs:label "Pengendalian Kultur Teknis"@id ;
    rdfs:comment "Kelas Pengendalian Kultur Teknis pada ontologi penyakit tanaman pangan."@id ;
    rdfs:isDefinedBy <http://kbr.kelompok5.org/penyakit-tanaman-pangan> ;
    rdfs:subClassOf ptp:Pengendalian ;
    skos:prefLabel "Pengendalian Kultur Teknis"@id .

ptp:Penyakit a owl:Class ;
    rdfs:label "Penyakit"@id ;
    rdfs:comment "Penyakit tanaman pangan yang dideskripsikan pada sumber."@id ;
    rdfs:isDefinedBy <http://kbr.kelompok5.org/penyakit-tanaman-pangan> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ptp:Patogen ;
            owl:onProperty ptp:disebabkanOleh ],
        [ a owl:Restriction ;
            owl:onProperty ptp:memilikiGejala ;
            owl:someValuesFrom ptp:Gejala ],
        [ a owl:Restriction ;
            owl:onProperty ptp:menyerangTanaman ;
            owl:someValuesFrom ptp:TanamanPangan ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ptp:Referensi ;
            owl:onProperty ptp:memilikiReferensi ] ;
    owl:disjointWith ptp:BagianTanaman,
        ptp:FaktorRisiko,
        ptp:FasePertumbuhan,
        ptp:Gejala,
        ptp:Patogen,
        ptp:Pengendalian,
        ptp:Referensi,
        ptp:Varietas ;
    skos:prefLabel "Penyakit"@id .

ptp:GejalaDaun a owl:Class ;
    rdfs:label "Gejala Daun"@id ;
    rdfs:comment "Kelas Gejala Daun pada ontologi penyakit tanaman pangan."@id ;
    rdfs:isDefinedBy <http://kbr.kelompok5.org/penyakit-tanaman-pangan> ;
    rdfs:subClassOf ptp:Gejala ;
    skos:prefLabel "Gejala Daun"@id .

<http://kbr.kelompok5.org/penyakit-tanaman-pangan> a owl:Ontology ;
    rdfs:label "Ontologi Penyakit Tanaman Pangan Indonesia"@id ;
    dcterms:creator "Kelompok 5 KBR"@id ;
    dcterms:description "Knowledge base penyakit tanaman pangan Indonesia untuk tujuh tanaman: padi, kedelai, jagung, ubi jalar, ubi kayu, kacang tanah, dan kacang hijau."@id ;
    dcterms:source "DOC002"@id,
        "DOC005"@id ;
    dcterms:title "Ontologi Penyakit Tanaman Pangan Indonesia"@id ;
    owl:versionInfo "2.0.0" .

ptp:Daun a ptp:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Daun"@id ;
    rdfs:comment "Bagian tanaman: Daun."@id ;
    skos:prefLabel "Daun"@id .

ptp:Gejala a owl:Class ;
    rdfs:label "Gejala"@id ;
    rdfs:comment "Gejala serangan penyakit pada tanaman."@id ;
    rdfs:isDefinedBy <http://kbr.kelompok5.org/penyakit-tanaman-pangan> ;
    owl:disjointWith ptp:BagianTanaman,
