ptp:CurahHujanTinggi a ptp:CurahHujan,
        ptp:FaktorLingkungan,
        ptp:FaktorRisiko,
        owl:NamedIndividual ;
    rdfs:label "Curah hujan tinggi"@id ;
    ptp:halamanSumber 42 ;
    ptp:idBlokSumber "DOC002_P042_B003" ;
    ptp:kondisi "tinggi"@id ;
    ptp:kutipanSumber "dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017)."@id ;
    ptp:tingkat "tinggi"@id ;
    skos:definition "dapat dilakukan dengan beberapa teknik pengendalian seperti memperbaiki saluran air yang buruk, mengatur waktu penanaman kedelai agar tidak pada musim penghujan dengan curah hujan yang tinggi, pengendalian dengan solarisasi pada lahan yang akan dibudidayakan, penggunaan sistem tanam dengan mulsa plastik, perlakuan seed treatment pada benih yang akan ditanam dengan fungisida berbahan aktif thiram dan karbendazim, secara hayati dengan jamur antagonis Trichoderma dan Gliocladium, dan penyemprotan fungisida berbahan aktif etridiazole dan tiofanat (Inayati and Yusnawan, 2017)."@id ;
    skos:prefLabel "Curah hujan tinggi"@id ;
    prov:wasDerivedFrom "DOC002_P042_B003" .

