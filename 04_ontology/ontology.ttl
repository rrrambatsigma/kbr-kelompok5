    rdfs:comment "Deskripsi tanaman pangan menurut sumber."@id ;
    rdfs:domain ptp:TanamanPangan ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "deskripsi tanaman"@id .

ptp:didukungOleh a owl:ObjectProperty ;
    rdfs:label "didukung oleh"@id ;
    rdfs:comment "Entitas didukung oleh node bukti sumber."@id ;
    rdfs:domain ptp:EntitasKBR ;
    rdfs:range ptp:BuktiSumber ;
    skos:prefLabel "didukung oleh"@id .

ptp:dokumenSumber a owl:DatatypeProperty ;
    rdfs:label "dokumen sumber"@id ;
    rdfs:comment "Kode dokumen sumber."@id ;
    rdfs:domain ptp:BuktiSumber ;
    rdfs:range xsd:string ;
    skos:prefLabel "dokumen sumber"@id .

ptp:halamanSumber a owl:DatatypeProperty ;
    rdfs:label "halaman sumber"@id ;
    rdfs:comment "Halaman sumber."@id ;
    rdfs:domain ptp:BuktiSumber ;
    rdfs:range xsd:string ;
    skos:prefLabel "halaman sumber"@id .

ptp:idBlokSumber a owl:DatatypeProperty ;
    rdfs:label "id blok sumber"@id ;
    rdfs:comment "Identifier blok sumber."@id ;
    rdfs:domain ptp:BuktiSumber ;
    rdfs:range xsd:string ;
    skos:prefLabel "id blok sumber"@id .

ptp:idChunkSumber a owl:DatatypeProperty ;
    rdfs:label "id chunk sumber"@id ;
    rdfs:comment "Identifier chunk sumber."@id ;
    rdfs:domain ptp:BuktiSumber ;
    rdfs:range xsd:string ;
    skos:prefLabel "id chunk sumber"@id .

ptp:identifierSumber a owl:DatatypeProperty ;
    rdfs:label "identifier sumber"@id ;
    rdfs:comment "Identifier baris atau entitas pada sumber."@id ;
    rdfs:domain ptp:EntitasKBR ;
    rdfs:range xsd:string ;
    skos:prefLabel "identifier sumber"@id .

ptp:judulReferensi a owl:DatatypeProperty ;
    rdfs:label "judul referensi"@id ;
    rdfs:comment "Judul sumber referensi."@id ;
    rdfs:domain ptp:Referensi ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "judul referensi"@id .

ptp:klasifikasiTurunan a owl:DatatypeProperty ;
    rdfs:label "klasifikasi turunan"@id ;
    rdfs:comment "Klasifikasi turunan eksplisit, bukan fakta tambahan."@id ;
    rdfs:domain ptp:ObservasiLingkungan ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "klasifikasi turunan"@id .

ptp:kondisi a owl:DatatypeProperty ;
    rdfs:label "kondisi"@id ;
    rdfs:comment "Kondisi lingkungan kualitatif yang dinyatakan sumber."@id ;
    rdfs:domain ptp:ObservasiLingkungan ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "kondisi"@id .

ptp:kutipanNormalisasi a owl:DatatypeProperty ;
    rdfs:label "kutipan normalisasi"@id ;
    rdfs:comment "Kutipan sumber setelah normalisasi ringan."@id ;
    rdfs:domain ptp:BuktiSumber ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "kutipan normalisasi"@id .

ptp:kutipanSumber a owl:DatatypeProperty ;
    rdfs:label "kutipan sumber"@id ;
    rdfs:comment "Kutipan verbatim dari sumber."@id ;
    rdfs:domain ptp:BuktiSumber ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "kutipan sumber"@id .

ptp:memilikiObservasi a owl:ObjectProperty ;
    rdfs:label "memiliki observasi"@id ;
    rdfs:comment "Diagnosis memiliki observasi gejala."@id ;
    rdfs:domain ptp:Diagnosis ;
    rdfs:range ptp:Observasi ;
    skos:prefLabel "memiliki observasi"@id .

ptp:memilikiTanaman a owl:ObjectProperty ;
    rdfs:label "memiliki tanaman"@id ;
    rdfs:comment "Diagnosis memiliki tanaman yang diamati."@id ;
    rdfs:domain ptp:Diagnosis ;
    rdfs:range ptp:TanamanPangan ;
    skos:prefLabel "memiliki tanaman"@id .

ptp:menghasilkanPenyakit a owl:ObjectProperty ;
    rdfs:label "menghasilkan penyakit"@id ;
    rdfs:comment "Diagnosis atau kandidat diagnosis menghasilkan penyakit."@id ;
    rdfs:domain ptp:Diagnosis ;
    rdfs:range ptp:Penyakit ;
    skos:prefLabel "menghasilkan penyakit"@id .

ptp:menyerangBagian a owl:ObjectProperty ;
    rdfs:label "menyerang bagian"@id ;
    rdfs:comment "Bagian tanaman yang terserang penyakit."@id ;
    rdfs:domain ptp:Penyakit ;
    rdfs:range ptp:BagianTanaman ;
    owl:propertyChainAxiom ( ptp:memilikiGejala ptp:terdapatPada ) ;
    skos:prefLabel "menyerang bagian"@id .

ptp:menyerangFase a owl:ObjectProperty ;
    rdfs:label "menyerang fase"@id ;
    rdfs:comment "Fase pertumbuhan tanaman yang diserang penyakit."@id ;
    rdfs:domain ptp:Penyakit ;
    rdfs:range ptp:FasePertumbuhan ;
    skos:prefLabel "menyerang fase"@id .

ptp:merekomendasikanPengendalian a owl:ObjectProperty ;
    rdfs:label "merekomendasikan pengendalian"@id ;
    rdfs:comment "Diagnosis merekomendasikan tindakan pengendalian."@id ;
    rdfs:domain ptp:Diagnosis ;
    rdfs:range ptp:Pengendalian ;
    rdfs:subPropertyOf ptp:berkaitanPengendalian ;
    skos:prefLabel "merekomendasikan pengendalian"@id .

ptp:namaIlmiah a owl:DatatypeProperty ;
    rdfs:label "nama ilmiah"@id ;
    rdfs:comment "Nama ilmiah tanaman pangan."@id ;
    rdfs:domain ptp:TanamanPangan ;
    rdfs:range xsd:string ;
