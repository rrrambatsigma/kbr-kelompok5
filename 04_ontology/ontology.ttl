                                                        ptp:GejalaDaun ;
                                               ptp:merupakanGejalaDari ptp:PenyakitHawarPelepahDaunPadi ;
                                               ptp:terdapatPada ptp:Daun ;
                                               ptp:deskripsiGejala "Pada saat kondisi lembab, bercak juga akan ditemukan pada daun padi dan pelepah daun membusuk sehingga padi menjadi rebah dan gabah menjadi kopong (Harahap & Tjahjono, 1992) seperti pada Gambar 1.6."@id ;
                                               rdfs:label "Pada saat kondisi lembab, bercak juga akan ditemukan pada daun padi dan pelepah daun membusuk sehingga padi menjadi rebah dan gabah menjadi kopong (Harahap & Tjahjono, 1992) seperti pada Gambar 1.6."@id .


###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#GejalaPadaSeranganBeratDaunMenjadi_b44ea481
ptp:GejalaPadaSeranganBeratDaunMenjadi_b44ea481 rdf:type owl:NamedIndividual ,
