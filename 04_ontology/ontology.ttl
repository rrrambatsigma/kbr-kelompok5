ptp:PenggunaanPerangkap a ptp:PengendalianMekanis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan perangkap"@id ;
    ptp:namaPengendalian "Penggunaan perangkap"@id ;
    rdfs:comment "Tindakan kanonik penggunaan perangkap."@id ;
    skos:prefLabel "Penggunaan perangkap"@id .

ptp:PenyakitBakteri a owl:Class ;
    rdfs:label "Penyakit Bakteri"@id ;
    rdfs:comment "Penyakit yang disebabkan oleh patogen kelompok bakteri."@id ;
    rdfs:subClassOf ptp:Penyakit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ptp:Penyakit [ a owl:Restriction ;
                        owl:onProperty ptp:disebabkanOleh ;
                        owl:someValuesFrom ptp:Bakteri ] ) ] ;
    skos:prefLabel "Penyakit Bakteri"@id .

ptp:PenyakitFitoplasma a owl:Class ;
    rdfs:label "Penyakit Fitoplasma"@id ;
    rdfs:comment "Penyakit yang disebabkan oleh patogen kelompok fitoplasma."@id ;
    rdfs:subClassOf ptp:Penyakit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ptp:Penyakit [ a owl:Restriction ;
                        owl:onProperty ptp:disebabkanOleh ;
                        owl:someValuesFrom ptp:Fitoplasma ] ) ] ;
    skos:prefLabel "Penyakit Fitoplasma"@id .

ptp:PenyakitJamur a owl:Class ;
    rdfs:label "Penyakit Jamur"@id ;
    rdfs:comment "Penyakit yang disebabkan oleh patogen kelompok jamur."@id ;
    rdfs:subClassOf ptp:Penyakit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ptp:Penyakit [ a owl:Restriction ;
                        owl:onProperty ptp:disebabkanOleh ;
                        owl:someValuesFrom ptp:Jamur ] ) ] ;
    skos:prefLabel "Penyakit Jamur"@id .

ptp:PenyakitNematoda a owl:Class ;
    rdfs:label "Penyakit Nematoda"@id ;
    rdfs:comment "Penyakit yang disebabkan oleh patogen kelompok nematoda."@id ;
    rdfs:subClassOf ptp:Penyakit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ptp:Penyakit [ a owl:Restriction ;
                        owl:onProperty ptp:disebabkanOleh ;
                        owl:someValuesFrom ptp:Nematoda ] ) ] ;
    skos:prefLabel "Penyakit Nematoda"@id .

ptp:PenyakitOomycete a owl:Class ;
    rdfs:label "Penyakit Oomycete"@id ;
    rdfs:comment "Penyakit yang disebabkan oleh patogen kelompok oomycete."@id ;
    rdfs:subClassOf ptp:Penyakit ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ptp:Penyakit [ a owl:Restriction ;
                        owl:onProperty ptp:disebabkanOleh ;
                        owl:someValuesFrom ptp:Oomycete ] ) ] ;
    skos:prefLabel "Penyakit Oomycete"@id .

ptp:PenyakitPenyebabTidakDiketahui a owl:Class ;
    rdfs:label "Penyakit dengan Penyebab Tidak Diketahui"@id ;
