ptp:GejalaCPersonataMembentukKonidiaLebih_76d88dc6 a ptp:Gejala,
        ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "C personata membentuk konidia lebih pendek dan gemuk bersekat 1 – 7, C arachidicola bercak relatif lebih dulu muncul, berukuran lebih besar, berwarna kekuningan, sporulasi cendawan lebih banyak di permukaan atas daun."@id ;
    ptp:deskripsiGejala "C personata membentuk konidia lebih pendek dan gemuk bersekat 1 – 7, C arachidicola bercak relatif lebih dulu muncul, berukuran lebih besar, berwarna kekuningan, sporulasi cendawan lebih banyak di permukaan atas daun."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitBercakDaunKacangTanah ;
    ptp:terdapatPada ptp:Daun .

ptp:GejalaDalamPerkembangannyaBintikBintikIniBerubah_d1fd297e a ptp:Gejala,
        ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Dalam perkembangannya bintik-bintik ini berubah menjadi bercak coklat agak menonjol pada permukaan bawah dan atas daun."@id ;
    ptp:deskripsiGejala "Dalam perkembangannya bintik-bintik ini berubah menjadi bercak coklat agak menonjol pada permukaan bawah dan atas daun."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitBercakDaunKacangTanah ;
    ptp:terdapatPada ptp:Daun .

ptp:GejalaDaunMenjadiTidakProduktifDalam_20fbcc4e a ptp:Gejala,
        ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997)."@id ;
    ptp:deskripsiGejala "Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997)."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitKudisUbiJalar ;
    ptp:terdapatPada ptp:Daun .

ptp:GejalaEkspresiKetahananTerhadapPenyakitLayu_0ac95d2e a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Ekspresi ketahanan terhadap penyakit layu sering kali tidak stabil, di agroekologi yang berbeda sifat tahan tersebut kadang tidak muncul."@id ;
    ptp:deskripsiGejala "Ekspresi ketahanan terhadap penyakit layu sering kali tidak stabil, di agroekologi yang berbeda sifat tahan tersebut kadang tidak muncul."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitLayuBakteriKacangTanah .

ptp:GejalaFimbriataABGejalaPascapanenPada_3531aef5 a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "fimbriata, (a&b) gejala pascapanen pada ubi jalar (c&d) Anterior dan posterior koloni SPL17100 pada media PDA yang diinkubasi selama 7 hari pada 25 °C, e,g,h) aleurokonidiophore dengan aleurokonidia, f) perithecium dengan leher panjang (i&j) konidia silinder (Sumber: Paul et al., 2018) Hasil penelitian Zhang et al."@id ;
    ptp:deskripsiGejala "fimbriata, (a&b) gejala pascapanen pada ubi jalar (c&d) Anterior dan posterior koloni SPL17100 pada media PDA yang diinkubasi selama 7 hari pada 25 °C, e,g,h) aleurokonidiophore dengan aleurokonidia, f) perithecium dengan leher panjang (i&j) konidia silinder (Sumber: Paul et al., 2018) Hasil penelitian Zhang et al."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitBusukHitamBlackRotUbiJalar .

ptp:GejalaFimbriataPadaUmbiUbiJalar_7db4ad13 a ptp:Gejala,
        ptp:GejalaAkar,
        ptp:GejalaUmbi,
        owl:NamedIndividual ;
    rdfs:label "fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b)."@id ;
    ptp:deskripsiGejala "fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau bintik hitam, kecil, melingkar, dan sedikit cekung, kemudian bintik hitam tersebut membesar dan perithecia dengan leher panjang, pada tahap selanjutnya muncul bulu gelap pada akar penyimpanan (Gambar 6a dan b)."@id ;
    ptp:merupakanGejalaDari ptp:PenyakitBusukHitamBlackRotUbiJalar ;
    ptp:terdapatPada ptp:Akar,
        ptp:Umbi .

