ptp:menyerangBagian a owl:ObjectProperty ;
    rdfs:label "menyerang bagian"@id ;
    rdfs:comment "Bagian tanaman (daun, batang, akar, umbi) yang terserang penyakit."@id ;
    rdfs:domain ptp:Penyakit ;
    rdfs:isDefinedBy <http://kbr.kelompok5.org/penyakit-tanaman-pangan> ;
    rdfs:range ptp:BagianTanaman ;
    owl:propertyChainAxiom ( ptp:memilikiGejala ptp:terdapatPada ) ;
    skos:definition "Bagian tanaman (daun, batang, akar, umbi) yang terserang penyakit."@id ;
    skos:prefLabel "menyerang bagian"@id .

