    ptp:deskripsiGejala "Inang kedua patogen ini hanya kacang tanah, Cercospora personata bercak relatif lambat muncul, berukuran lebih kecil, berwarna coklat gelap sampai hitam, sporulasi cendawan lebih banyak di permukaan bawah daun."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitBercakDaunKacangTanahCPersonataMembentukKonidiaPendek,
        ptp:BuktiGejalaPenyakitBercakDaunKacangTanahKeduaCercosporaPersonataRelatifLambat,
        ptp:BuktiGejalaPenyakitBercakDaunKacangTanahMerupakanPentingKeduaSetelah,
        ptp:BuktiGejalaPenyakitBercakDaunKacangTanahMerupakanTularUdaraDisebabkanCercospora,
        ptp:BuktiGejalaPenyakitBercakDaunKacangTanahPengamatanMakroskopisTerinfeksiCArachidicola,
        ptp:BuktiGejalaPenyakitBercakDaunKacangTanahPerkembangannyaBintikBintikBerubahMenjadi,
        ptp:BuktiGejalaPenyakitBercakDaunKacangTanahSemangun1991TerinfeksiTerdapatCoklat,
        ptp:BuktiGejalaPenyakitBercakDaunKacangTanahTerdapatBagianBawahKemudianBerkembang,
        ptp:BuktiGejalaPenyakitBercakDaunKacangTanahTerinfeksiCendawanDitunjukkanAdanyaKecil ;
    ptp:memilikiGejalaKanonik ptp:BercakDaun ;
    ptp:merupakanGejalaDari ptp:PenyakitBercakDaunKacangTanah ;
    ptp:terdapatPada ptp:Daun ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Bercak daun pada Penyakit Bercak Daun"@id .

ptp:PengamatanPenyakitBercakDaunKacangTanahKlorosisDaun a ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Klorosis daun pada Penyakit Bercak Daun"@id ;
    ptp:deskripsiGejala "C personata membentuk konidia lebih pendek dan gemuk bersekat 1 - 7, C arachidicola bercak relatif lebih dulu muncul, berukuran lebih besar, berwarna kekuningan, sporulasi cendawan lebih banyak di permukaan atas daun."@id ;
