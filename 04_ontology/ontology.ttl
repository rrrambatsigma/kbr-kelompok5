ptp:BercakKuningUbiJalar a ptp:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit bercak kuning"@id ;
    ptp:berkaitanPengendalian ptp:PengendalianBercakKuningUbiJalar,
        ptp:PengendalianRotasiTanamanSanitasiLahan ;
    ptp:deskripsiPenyakit "Penyakit bercak kuning pada ubi jalar disebabkan oleh Sweet Potato Feathery Mottle Virus (SPFMV) termasuk ke dalam genus Potyvirus, famili Potyviridae (Tugume, Mukasa and Valkonen, 2008). SPFMV merupakan virus yang sudah menyebar luas di negara-negara produsen ubi jalar, tetapi di Indonesia baru dilaporkan terdapat di Papua (Barahima and Purnomo, 2003) dan pertama kalinya teridentifikasi secara molekuler terdapat di Cikarawang, Bogor, Jawa Barat di mana berdasarkan urutan nukleotida dan asam amino memiliki homologi berkisar 89–98% dan 97–100% dengan isolat Jepang dan Spanyol (Hondo et al., 2018)."@id ;
    ptp:dikendalikanDengan ptp:PengendalianBercakKuningUbiJalar,
        ptp:PengendalianRotasiTanamanSanitasiLahan ;
    ptp:disebabkanOleh ptp:SweetPotatoChloroticFleckVirus,
        ptp:SweetPotatoFeatheryMottleVirus,
        ptp:SweetPotatoMildMottleVirus ;
    ptp:halamanSumber 85 ;
    ptp:idBlokSumber "DOC002_P085_B007" ;
    ptp:kutipanSumber "Penyakit bercak kuning pada ubi jalar disebabkan oleh Sweet Potato Feathery Mottle Virus (SPFMV) termasuk ke dalam genus Potyvirus, famili Potyviridae (Tugume, Mukasa and Valkonen, 2008). SPFMV merupakan virus yang sudah menyebar luas di negara-negara produsen ubi jalar, tetapi di Indonesia baru dilaporkan terdapat di Papua (Barahima and Purnomo, 2003) dan pertama kalinya teridentifikasi secara molekuler terdapat di Cikarawang, Bogor, Jawa Barat di mana berdasarkan urutan nukleotida dan asam amino memiliki homologi berkisar 89–98% dan 97–100% dengan isolat Jepang dan Spanyol (Hondo et al., 2018)."@id ;
    ptp:memilikiGejala ptp:GejalaBercakKuningUbiJalar,
        ptp:GejalaCooperJonesVariabilitasEkspresi,
        ptp:GejalaDaunBercakKuningKlorosis,
        ptp:GejalaDaunNekrosisKlorotikKecil,
        ptp:GejalaInformasiIndonesiaTerkaitVirus ;
    ptp:memilikiReferensi ptp:BukuPenyakitTanamanDanPengendaliannya ;
    ptp:menyerangBagian ptp:Daun,
        ptp:Pucuk ;
    ptp:menyerangTanaman ptp:UbiJalar ;
    dcterms:identifier "DIS_026" ;
    dcterms:source "DOC002" ;
    skos:definition "Penyakit bercak kuning pada ubi jalar disebabkan oleh Sweet Potato Feathery Mottle Virus (SPFMV) termasuk ke dalam genus Potyvirus, famili Potyviridae (Tugume, Mukasa and Valkonen, 2008). SPFMV merupakan virus yang sudah menyebar luas di negara-negara produsen ubi jalar, tetapi di Indonesia baru dilaporkan terdapat di Papua (Barahima and Purnomo, 2003) dan pertama kalinya teridentifikasi secara molekuler terdapat di Cikarawang, Bogor, Jawa Barat di mana berdasarkan urutan nukleotida dan asam amino memiliki homologi berkisar 89–98% dan 97–100% dengan isolat Jepang dan Spanyol (Hondo et al., 2018)."@id ;
    skos:prefLabel "Penyakit bercak kuning"@id ;
    prov:wasDerivedFrom "DOC002_P085_B007" .

