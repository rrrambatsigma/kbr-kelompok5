ptp:PengamatanPenyakitHawarDaunJagungBercakDaun a ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun pada Penyakit Hawar Daun"@id ;
    ptp:deskripsiGejala "Selanjutnya bercak berkembang menjadi berbentuk lonjong kecokelatan, infeksi lebih lanjut bercak akan melebar dan bergabung dengan bercak lain dan menyebabkan jaringan daun mengalami nekrosis."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitHawarDaunJagungSelanjutnyaBerkembangMenjadiBerbentukLonjong ;
    ptp:memilikiGejalaKanonik ptp:BercakDaun ;
    ptp:merupakanGejalaDari ptp:PenyakitHawarDaunJagung ;
    ptp:terdapatPada ptp:Daun ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Bercak daun pada Penyakit Hawar Daun"@id .

ptp:PengamatanPenyakitHawarDaunJagungHawarDaun a ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Hawar daun pada Penyakit Hawar Daun"@id ;
    ptp:deskripsiGejala "Gejala hawar daun mulai terlihat pada umur 25 hari setelah tanam dan biasanya diawali dari daun bagian bawah dan menular ke daun bagian atas."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitHawarDaunJagungMulaiTerlihatUmur25Hari ;
    ptp:memilikiGejalaKanonik ptp:HawarDaun ;
    ptp:merupakanGejalaDari ptp:PenyakitHawarDaunJagung ;
    ptp:terdapatPada ptp:Daun ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Hawar daun pada Penyakit Hawar Daun"@id .

ptp:PengamatanPenyakitHawarPelepahDaunPadiBercakDaun a ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun pada Penyakit Hawar Pelepah Daun"@id ;
    ptp:deskripsiGejala "Pada saat kondisi lembab, bercak juga akan ditemukan pada daun padi dan pelepah daun membusuk sehingga padi menjadi rebah dan gabah menjadi kopong (Harahap & Tjahjono, 1992) seperti pada Gambar 1.6."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitHawarPelepahDaunPadiKondisiLembabMembusukMenjadiRebah ;
