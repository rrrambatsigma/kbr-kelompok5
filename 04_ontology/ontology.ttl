ptp:AntraknosaUbiKayuBatang a ptp:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Antraknosa"@id ;
    ptp:deskripsiPenyakit "Patogen penyebab penyakit pada daun juga dapat diketahui terdapat pada batang tanaman ubi kayu antara lain yaitu, patogen penyebab penyakit antraknosa, Xanthomonas campestris pv. Manihotis, serta penyakit-penyakit yang disebabkan oleh virus dan fitoplasma. Begomovirus selain menyebabkan gejala mosaik pada daun, juga dapat menyebabkan tanaman menjadi kerdil (stunt)."@id ;
    ptp:disebabkanOleh ptp:CollectothricumGloeosporioides ;
    ptp:halamanSumber 93 ;
    ptp:idBlokSumber "DOC002_P093_B006" ;
    ptp:kutipanSumber "Patogen penyebab penyakit pada daun juga dapat diketahui terdapat pada batang tanaman ubi kayu antara lain yaitu, patogen penyebab penyakit antraknosa, Xanthomonas campestris pv. Manihotis, serta penyakit-penyakit yang disebabkan oleh virus dan fitoplasma. Begomovirus selain menyebabkan gejala mosaik pada daun, juga dapat menyebabkan tanaman menjadi kerdil (stunt)."@id ;
    ptp:memilikiGejala ptp:GejalaBatangPatahMati ;
    ptp:memilikiReferensi ptp:BukuPenyakitTanamanDanPengendaliannya ;
    ptp:menyerangBagian ptp:Batang ;
    ptp:menyerangTanaman ptp:UbiKayu ;
    dcterms:identifier "DIS_110" ;
    dcterms:source "DOC002" ;
    skos:definition "Patogen penyebab penyakit pada daun juga dapat diketahui terdapat pada batang tanaman ubi kayu antara lain yaitu, patogen penyebab penyakit antraknosa, Xanthomonas campestris pv. Manihotis, serta penyakit-penyakit yang disebabkan oleh virus dan fitoplasma. Begomovirus selain menyebabkan gejala mosaik pada daun, juga dapat menyebabkan tanaman menjadi kerdil (stunt)."@id ;
    skos:prefLabel "Antraknosa"@id ;
    prov:wasDerivedFrom "DOC002_P093_B006" .

ptp:AntraknosaUbiKayuDaun a ptp:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Antraknosa"@id ;
    ptp:deskripsiPenyakit "Pada tangkai daun muncul retakan jaringan berupa kanker, infeksi lebih lanjut mengakibatkan tanaman layu yang disertai defoliasi"@id ;
