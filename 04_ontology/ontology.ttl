ptp:BuktiPengendalianUmumKacangTanah8 a ptp:BuktiPengendalian,
        owl:NamedIndividual ;
    rdfs:label "Bukti pengendalian umum Kacang tanah"@id ;
    ptp:catatanKualitas "Kutipan sumber berupa fragmen atau kalimat terpotong."@id ;
