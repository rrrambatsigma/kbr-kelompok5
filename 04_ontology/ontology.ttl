    ptp:merupakanGejalaDari ptp:PenyakitHawarPelepahDaunPadi .

ptp:GejalaBercakBerukuranBesarSeringDijumpai_3379344c a ptp:Gejala,
        ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Bercak berukuran besar, sering dijumpai pada ujung daun dan daun muda,bercak tanpa batas yang jelas, bercak pada permukaan atas daun berwarna coklat dan bagian bawah berwarna keabu-abuan (spora fungi)"@id ;
    ptp:deskripsiGejala "Bercak berukuran besar, sering dijumpai pada ujung daun dan daun muda,bercak tanpa batas yang jelas, bercak pada permukaan atas daun berwarna coklat dan bagian bawah berwarna keabu-abuan (spora fungi)"@id ;
    ptp:merupakanGejalaDari ptp:BercakDaunBaurUbiKayu ;
    ptp:terdapatPada ptp:Daun .

