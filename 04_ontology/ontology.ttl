ptp:BakteriPustulKedelai a ptp:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit Bakteri Pustul"@id ;
    ptp:berkaitanPengendalian ptp:PengendalianAgensHayatiBakteriPustulKedelai,
        ptp:PengendalianBakteriPustulKedelai,
        ptp:PengendalianBiologisBakteriPustulKedelai ;
    ptp:deskripsiPenyakit "Secara sepintas gejala yang ditunjukkan hampir menyerupai penyakit karat tetapi pada bercak bakteri pustul ini tidak adanya spora pada bagian tengah bercak. Gejala selanjutnya adalah daun yang terinfeksi akan rontok akibat intensitas serangan yang tinggi sehingga akan mengganggu proses fotosintesis dan berpengaruh terhadap pengisian polong. Patogen dapat terbawa benih akibat tanaman telah terinfeksi patogen X."@id ;
    ptp:dikendalikanDengan ptp:PengendalianAgensHayatiBakteriPustulKedelai,
        ptp:PengendalianBakteriPustulKedelai,
        ptp:PengendalianBiologisBakteriPustulKedelai ;
