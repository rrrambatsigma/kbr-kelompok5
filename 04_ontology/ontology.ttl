    skos:prefLabel "Pengamatan gejala Penyakit kudis"@id .

ptp:PengamatanPenyakitKudisUbiJalarMartanto2010MenjelaskanBahwaMembentuk a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala Penyakit kudis"@id ;
    ptp:deskripsiGejala "Hasil penelitian Martanto (2010) menjelaskan bahwa tanaman ubi jalar membentuk lapisan gabus untuk mempertahankan diri dari serangan penyakit kudis (Gambar 3A dan B)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitKudisUbiJalarMartanto2010MenjelaskanBahwaMembentuk ;
    ptp:merupakanGejalaDari ptp:PenyakitKudisUbiJalar ;
    rdfs:comment "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ;
