        ptp:Patogen,
        ptp:Pengendalian,
        ptp:Referensi,
        ptp:Varietas ;
    skos:prefLabel "Gejala"@id .

ptp:Pengendalian a owl:Class ;
    rdfs:label "Pengendalian"@id ;
    rdfs:comment "Metode pengendalian penyakit."@id ;
    rdfs:isDefinedBy <http://kbr.kelompok5.org/penyakit-tanaman-pangan> ;
    owl:disjointWith ptp:FaktorRisiko,
        ptp:FasePertumbuhan,
        ptp:Referensi,
        ptp:Varietas ;
    skos:prefLabel "Pengendalian"@id .

