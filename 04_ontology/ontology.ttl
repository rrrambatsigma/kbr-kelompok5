ptp:alasanKecocokan a owl:DatatypeProperty ;
    rdfs:label "alasan kecocokan"@id ;
    rdfs:comment "Alasan kecocokan kandidat diagnosis."@id ;
    rdfs:domain ptp:KandidatDiagnosis ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "alasan kecocokan"@id .

ptp:catatanKualitas a owl:DatatypeProperty ;
    rdfs:label "catatan kualitas"@id ;
    rdfs:comment "Catatan kualitas atau keterbatasan kutipan sumber."@id ;
    rdfs:domain ptp:BuktiSumber ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "catatan kualitas"@id .

ptp:deskripsiGejala a owl:DatatypeProperty ;
