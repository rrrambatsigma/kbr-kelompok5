ptp:KudisUbiJalar a ptp:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Penyakit kudis"@id ;
    ptp:berkaitanPengendalian ptp:PengendalianFungisidaNabatiFungisida,
        ptp:PengendalianRotasiTanamanKudisUbiJalar,
        ptp:PengendalianSanitasiLahanFungisidaNabati,
        ptp:PengendalianVarietasTahanKudisUbiJalar ;
    ptp:deskripsiPenyakit "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010). Pada awalnya bercak berwarna kuning coklat kekuningan, coklat kemerahan dan akhirnya menjadi coklat kehitaman (Martanto, Tanati and Baan, 2016). Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997)."@id ;
    ptp:dikendalikanDengan ptp:PengendalianFungisidaNabatiFungisida,
        ptp:PengendalianRotasiTanamanKudisUbiJalar,
        ptp:PengendalianSanitasiLahanFungisidaNabati,
        ptp:PengendalianVarietasTahanKudisUbiJalar ;
    ptp:dipengaruhiOleh ptp:KondisiAngin,
        ptp:KondisiMusimHujan,
        ptp:SuhuKamar28,
        ptp:SuhuRendah21 ;
    ptp:disebabkanOleh ptp:ElsinoeBatatas,
        ptp:SpacelomaBatatas ;
    ptp:halamanSumber 83 ;
    ptp:idBlokSumber "DOC002_P083_B005" ;
    ptp:kutipanSumber "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010). Pada awalnya bercak berwarna kuning coklat kekuningan, coklat kemerahan dan akhirnya menjadi coklat kehitaman (Martanto, Tanati and Baan, 2016). Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997)."@id ;
    ptp:memilikiGejala ptp:GejalaBercakKekuninganKuning,
        ptp:GejalaDaunDaunMenjadiTidakProduktif,
        ptp:GejalaDaunKudisUbiJalar,
        ptp:GejalaInokulumKudisBiasanyaBerasal,
        ptp:GejalaMartantoUbiJalarMembentuk,
        ptp:GejalaSelainFaktorLingkunganMemengaruhi ;
    ptp:memilikiReferensi ptp:BukuPenyakitTanamanDanPengendaliannya ;
    ptp:menyerangBagian ptp:Batang,
        ptp:Daun,
        ptp:Pucuk ;
    ptp:menyerangTanaman ptp:UbiJalar ;
    dcterms:identifier "DIS_025" ;
    dcterms:source "DOC002" ;
    skos:definition "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010). Pada awalnya bercak berwarna kuning coklat kekuningan, coklat kemerahan dan akhirnya menjadi coklat kehitaman (Martanto, Tanati and Baan, 2016). Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997)."@id ;
    skos:prefLabel "Penyakit kudis"@id ;
    prov:wasDerivedFrom "DOC002_P083_B005" .

