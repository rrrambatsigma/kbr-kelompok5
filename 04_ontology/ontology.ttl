    ptp:merupakanGejalaDari ptp:PenyakitKerdilKedelaiSoybeanStuntVirusKedelai ;
    ptp:terdapatPada ptp:Batang ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Pertumbuhan terhambat pada Penyakit Kerdil Kedelai (Soybean Stunt Virus)"@id .

ptp:PengamatanPenyakitKerdilRumputDanKerdilHampaPadiBercakDaun a ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id ;
    ptp:deskripsiGejala "Selain perubahan warna, tampak pula bintik-bintik atau bercak coklat tua pada daun yang bergejala kerdil hampa bila pupuk nitrogen yang diberikan tidak berimbang (Sari, 2019)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSelainPerubahanWarnaTampakPula ;
    ptp:memilikiGejalaKanonik ptp:BercakDaun ;
    ptp:merupakanGejalaDari ptp:PenyakitKerdilRumputDanKerdilHampaPadi ;
    ptp:terdapatPada ptp:Daun ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Bercak daun pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id .

ptp:PengamatanPenyakitKerdilRumputDanKerdilHampaPadiKerdilTanaman a ptp:GejalaBatang,
        ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Kerdil tanaman pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id ;
    ptp:deskripsiGejala "Gejala yang khas dari penyakit kerdil rumput yaitu kerdil dengan jumlah anakan banyak, bentuk daun pendek dan sempit, bagian batang tumbuh menjadi tegak dan kaku, serta diskolorasi daun (Gambar 1.7)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiKhasRumputJumlahAnakanBentuk,
        ptp:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSelainPerubahanWarnaTampakPula,
        ptp:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSementaraHampaSelainMudaBergigi ;
    ptp:memilikiGejalaKanonik ptp:KerdilTanaman ;
    ptp:merupakanGejalaDari ptp:PenyakitKerdilRumputDanKerdilHampaPadi ;
    ptp:terdapatPada ptp:Batang,
        ptp:Daun ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Kerdil tanaman pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id .

ptp:PengamatanPenyakitKerdilRumputDanKerdilHampaPadiKlorosisDaun a ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Klorosis daun pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id ;
    ptp:deskripsiGejala "Sementara itu, gejala penyakit kerdil hampa yaitu selain kerdil, pada tanaman padi yang masih muda daun akan bergigi, tidak rata, klorotik, dan pecah-pecah."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitKerdilRumputDanKerdilHampaPadiSementaraHampaSelainMudaBergigi ;
    ptp:memilikiGejalaKanonik ptp:KlorosisDaun ;
    ptp:merupakanGejalaDari ptp:PenyakitKerdilRumputDanKerdilHampaPadi ;
    ptp:terdapatPada ptp:Daun ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Klorosis daun pada Penyakit Kerdil Rumput dan Kerdil Hampa"@id .

ptp:PengamatanPenyakitKudisUbiJalarBercakDaun a ptp:GejalaBatang,
        ptp:GejalaDaun,
        ptp:GejalaPucuk,
        owl:NamedIndividual ;
    rdfs:label "Bercak daun pada Penyakit kudis"@id ;
    ptp:deskripsiGejala "Gejala yang timbul akibat serangan penyakit kudis pada bagian batang yaitu terdapat bercak berwarna coklat, berbentuk cekung atau bulat tidak beraturan, satu bercak dapat meluas dan akan bersatu dengan bercak yang lain (Gambar 3A), sedangkan pada bagian daun terutama tulang daun pucuk terdapat bercak kecil, cekung dan berwarna coklat (Gambar 3B, Martanto, 2010)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitKudisUbiJalarTimbulAkibatBagianBatangTerdapat ;
    ptp:memilikiGejalaKanonik ptp:BercakDaun ;
    ptp:merupakanGejalaDari ptp:PenyakitKudisUbiJalar ;
    ptp:terdapatPada ptp:Batang,
        ptp:Daun,
        ptp:Pucuk ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Bercak daun pada Penyakit kudis"@id .

ptp:PengamatanPenyakitLayuBakteriKacangTanahLayuDaun a ptp:GejalaBiji,
        ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Layu daun pada Penyakit Layu Bakteri"@id ;
    ptp:deskripsiGejala "Gejala awal berupa kelayuan tidak permanen, tanaman segar kembali malam atau pagi hari."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitLayuBakteriKacangTanahAwalBerupaKelayuanTidakPermanen,
        ptp:BuktiGejalaPenyakitLayuBakteriKacangTanahChinaMenunjukkanBahwaPenularanBerkisar,
        ptp:BuktiGejalaPenyakitLayuBakteriKacangTanahEkspresiSeringKaliTidakStabil,
        ptp:BuktiGejalaPenyakitLayuBakteriKacangTanahGulmaTumbuhBersamaPeranPenting,
        ptp:BuktiGejalaPenyakitLayuBakteriKacangTanahKondisiSistemPerakaranTidakBerfungsi,
        ptp:BuktiGejalaPenyakitLayuBakteriKacangTanahMengeringkanHinggaKadarAirBiji,
        ptp:BuktiGejalaPenyakitLayuBakteriKacangTanahPenyebabRalstoniaSolanacearum,
        ptp:BuktiGejalaPenyakitLayuBakteriKacangTanahSelainMenjadiTempatHidupKomoditas,
        ptp:BuktiGejalaPenyakitLayuBakteriKacangTanahSeringKaliGulmaTerinfeksiTidak,
        ptp:BuktiGejalaPenyakitLayuBakteriKacangTanahSolanacearumLahanSetempatMengurangi ;
    ptp:memilikiGejalaKanonik ptp:LayuDaun ;
    ptp:merupakanGejalaDari ptp:PenyakitLayuBakteriKacangTanah ;
    ptp:terdapatPada ptp:Biji,
        ptp:Daun ;
    rdfs:comment "Pengamatan gejala yang dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Layu daun pada Penyakit Layu Bakteri"@id .

ptp:PengamatanPenyakitLayuFusariumKedelaiBusukAkar a ptp:GejalaAkar,
