    ptp:merupakanGejalaDari ptp:PenyakitBusukHitamBlackRotUbiJalar ;
    ptp:terdapatPada ptp:Akar,
        ptp:Umbi ;
    rdfs:comment "Gejala bercak pada tanaman pada tanaman Ubi jalar: fimbriata pada umbi ubi jalar pada tahap awal terdapat lesio atau..."@id ;
    skos:prefLabel "Bercak pada tanaman pada Penyakit busuk hitam (black rot) (Ubi jalar)"@id .

ptp:GejalaPenyakitBusukHitamBlackRotUbiJalarBusukAkar a ptp:GejalaAkar,
        owl:NamedIndividual ;
    rdfs:label "Busuk akar pada Penyakit busuk hitam (black rot) (Ubi jalar)"@id ;
    ptp:deskripsiGejala "Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok akar sehingga pohon yang berdekatan akan mudah terinfeksi, serangga vektor kumbang nitidulid (Glischrochilus quadrisignatus) pemakan jamur dan cairan tanaman, melalui kotoran serangga, dan alat-alat pertanian, sedangkan penyebaran konidium melalui udara tidak mungkin terjadi (Soesanto, 2020)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitBusukHitamBlackRotUbiJalar3 ;
    ptp:memilikiGejalaKanonik ptp:BusukAkar ;
    ptp:merupakanGejalaDari ptp:PenyakitBusukHitamBlackRotUbiJalar ;
    ptp:terdapatPada ptp:Akar ;
    rdfs:comment "Gejala busuk akar pada tanaman Ubi jalar: Penyebaran penyakit busuk hitam melalui luka, setek propagativ, cangkok..."@id ;
    skos:prefLabel "Busuk akar pada Penyakit busuk hitam (black rot) (Ubi jalar)"@id .

