    rdfs:domain ptp:Patogen ;
    rdfs:range xsd:string ;
    skos:prefLabel "nama ilmiah patogen"@id .

ptp:namaInggrisPenyakit a owl:DatatypeProperty ;
    rdfs:label "nama Inggris penyakit"@id ;
    rdfs:comment "Nama Inggris penyakit bila tersedia di sumber."@id ;
    rdfs:domain ptp:Penyakit ;
    rdfs:range xsd:string ;
    skos:prefLabel "nama Inggris penyakit"@id .

ptp:namaPengendalian a owl:DatatypeProperty ;
    rdfs:label "nama pengendalian"@id ;
    rdfs:comment "Nama tindakan pengendalian kanonik."@id ;
    rdfs:domain ptp:Pengendalian ;
    rdfs:range rdf:PlainLiteral ;
    skos:prefLabel "nama pengendalian"@id .

ptp:namaPenulis a owl:DatatypeProperty ;
    rdfs:label "nama penulis"@id ;
    rdfs:comment "Nama penulis referensi."@id ;
    rdfs:domain ptp:Referensi ;
    rdfs:range xsd:string ;
    skos:prefLabel "nama penulis"@id .

ptp:nilaiMaks a owl:DatatypeProperty ;
    rdfs:label "nilai maksimum"@id ;
    rdfs:comment "Batas atas nilai observasi lingkungan."@id ;
    rdfs:domain ptp:ObservasiLingkungan ;
    rdfs:range xsd:decimal ;
    skos:prefLabel "nilai maksimum"@id .

ptp:nilaiMin a owl:DatatypeProperty ;
