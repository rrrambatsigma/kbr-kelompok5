ptp:dijelaskanDalam a owl:ObjectProperty ;
    rdfs:label "dijelaskan dalam"@id ;
    rdfs:comment "Referensi menjelaskan penyakit; kebalikan dari memilikiReferensi."@id ;
    rdfs:domain ptp:Referensi ;
    rdfs:range ptp:Penyakit ;
    owl:inverseOf ptp:memilikiReferensi .

ptp:dikendalikanDengan a owl:ObjectProperty ;
    rdfs:label "dikendalikan dengan"@id ;
    rdfs:comment "Metode pengendalian yang direkomendasikan untuk penyakit."@id ;
    rdfs:domain ptp:Penyakit ;
    rdfs:range ptp:Pengendalian ;
    rdfs:subPropertyOf ptp:berkaitanPengendalian ;
    owl:inverseOf ptp:mengendalikanPenyakit .

ptp:diserangPenyakit a owl:ObjectProperty ;
    rdfs:label "diserang penyakit"@id ;
    rdfs:comment "Kebalikan dari menyerangTanaman."@id ;
    rdfs:domain ptp:TanamanPangan ;
    rdfs:range ptp:Penyakit ;
    owl:inverseOf ptp:menyerangTanaman .

ptp:memilikiVarietas a owl:ObjectProperty ;
    rdfs:label "memiliki varietas"@id ;
    rdfs:comment "Tanaman pangan memiliki varietas tertentu."@id ;
    rdfs:domain ptp:TanamanPangan ;
    rdfs:range ptp:Varietas ;
    owl:inverseOf ptp:merupakanVarietasDari .

ptp:mengendalikanPenyakit a owl:ObjectProperty ;
    rdfs:label "mengendalikan penyakit"@id ;
    rdfs:comment "Kebalikan dari dikendalikanDengan."@id ;
    rdfs:domain ptp:Pengendalian ;
    rdfs:range ptp:Penyakit ;
    owl:inverseOf ptp:dikendalikanDengan .

ptp:menyebabkanPenyakit a owl:ObjectProperty ;
    rdfs:label "menyebabkan penyakit"@id ;
    rdfs:comment "Kebalikan dari disebabkanOleh."@id ;
    rdfs:domain ptp:Patogen ;
    rdfs:range ptp:Penyakit ;
    owl:inverseOf ptp:disebabkanOleh .

ptp:merupakanGejalaDari a owl:ObjectProperty ;
    rdfs:label "merupakan gejala dari"@id ;
    rdfs:comment "Kebalikan dari memilikiGejala."@id ;
    rdfs:domain ptp:Gejala ;
    rdfs:range ptp:Penyakit ;
    owl:inverseOf ptp:memilikiGejala .

ptp:merupakanVarietasDari a owl:ObjectProperty ;
    rdfs:label "merupakan varietas dari"@id ;
    rdfs:comment "Kebalikan dari memilikiVarietas."@id ;
    rdfs:domain ptp:Varietas ;
    rdfs:range ptp:TanamanPangan ;
    owl:inverseOf ptp:memilikiVarietas .

ptp:tahunTerbit a owl:DatatypeProperty ;
    rdfs:label "tahun terbit"@id ;
    rdfs:comment "Tahun publikasi referensi."@id ;
    rdfs:domain ptp:Referensi .

ptp:terdapatPada a owl:ObjectProperty ;
    rdfs:label "terdapat pada"@id ;
    rdfs:comment "Lokasi gejala pada bagian tanaman tertentu."@id ;
    rdfs:domain ptp:Gejala ;
    rdfs:range ptp:BagianTanaman .

