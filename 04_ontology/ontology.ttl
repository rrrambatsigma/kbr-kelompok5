###  http://kbr.kelompok5.org/penyakit-tanaman-pangan#PengendalianUpayaPengendalianKaratJagungDapat_c695ff73
ptp:PengendalianUpayaPengendalianKaratJagungDapat_c695ff73 rdf:type owl:NamedIndividual ,
                                                                    ptp:Pengendalian ,
                                                                    ptp:PengendalianKulturTeknis ;
                                                           ptp:mengendalikanPenyakit ptp:PenyakitKaratDaunJagung ;
                                                           ptp:deskripsiPengendalian "Upaya pengendalian karat jagung dapat dilakukan dengan beberapa cara seperti jarak tanam yang tidak terlalu rapat dan penyiangan gulma rutin sehingga sirkulasi udara lebih baik dan kelembaban tidak terlalu tinggi."@id ;
