ptp:HawarDaunBakteriUbiKayu a ptp:Penyakit,
        owl:NamedIndividual ;
    rdfs:label "Hawar daun bakteri"@id ;
    ptp:deskripsiPenyakit "Gejala khas berupa bercak atau lesi berair (eksudat seperti getah berwarna krem) pada tangkai daun tanaman terinfeksi. Pada daun gejala muncul urat atau tulang daun,tepi dan ujung bilah daun. Perkembangan infeksi lebih lanjut bercak tersebut menyatu membentuk hawar/bercak coklat besar, daun mengering atau layu, daun gugur."@id ;
    ptp:disebabkanOleh ptp:XanthomonasCampestrispvManihotis ;
    ptp:halamanSumber 92 ;
    ptp:idBlokSumber "DOC002_P092_B002" ;
    ptp:kutipanSumber "Gejala khas berupa bercak atau lesi berair (eksudat seperti getah berwarna krem) pada tangkai daun tanaman terinfeksi. Pada daun gejala muncul urat atau tulang daun,tepi dan ujung bilah daun. Perkembangan infeksi lebih lanjut bercak tersebut menyatu membentuk hawar/bercak coklat besar, daun mengering atau layu, daun gugur."@id ;
    ptp:memilikiGejala ptp:GejalaDaunBercakLayuHawar ;
    ptp:memilikiReferensi ptp:BukuPenyakitTanamanDanPengendaliannya ;
    ptp:menyerangBagian ptp:Daun ;
    ptp:menyerangTanaman ptp:UbiKayu ;
    dcterms:identifier "DIS_032" ;
    dcterms:source "DOC002" ;
    skos:definition "Gejala khas berupa bercak atau lesi berair (eksudat seperti getah berwarna krem) pada tangkai daun tanaman terinfeksi. Pada daun gejala muncul urat atau tulang daun,tepi dan ujung bilah daun. Perkembangan infeksi lebih lanjut bercak tersebut menyatu membentuk hawar/bercak coklat besar, daun mengering atau layu, daun gugur."@id ;
    skos:prefLabel "Hawar daun bakteri"@id ;
    prov:wasDerivedFrom "DOC002_P092_B002" .

