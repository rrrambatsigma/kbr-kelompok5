[] a owl:AllDisjointClasses ;
    owl:members ( ptp:FaktorLingkungan ptp:FaktorBudidaya ptp:FaktorLahan ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ptp:VarietasUnggul ptp:VarietasLokal ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ptp:Buku ptp:JurnalIlmiah ptp:ArtikelIlmiah ptp:PublikasiInstansi ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ptp:PengendalianKulturTeknis ptp:PengendalianMekanis ptp:PengendalianBiologis ptp:PengendalianKimiawi ptp:PengendalianFisik ptp:PengendalianTerpadu ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ptp:FaseVegetatif ptp:FaseGeneratif ptp:FasePembibitan ptp:FaseAnakan ptp:FasePembungaan ptp:FasePemasakan ptp:FasePanen ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ptp:Serealia ptp:Legum ptp:UmbiUmbian ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ptp:Jamur ptp:Bakteri ptp:Virus ptp:Nematoda ptp:Oomycete ptp:Fitoplasma ptp:OrganismeLain ) .

