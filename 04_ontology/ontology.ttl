ptp:PengendalianBiologis a owl:Class ;
    rdfs:label "Pengendalian Biologis"@id ;
    rdfs:subClassOf ptp:Pengendalian .

ptp:PengendalianKimiawi a owl:Class ;
    rdfs:label "Pengendalian Kimiawi"@id ;
    rdfs:subClassOf ptp:Pengendalian .

ptp:Patogen a owl:Class ;
    rdfs:label "Patogen"@id ;
    owl:disjointWith ptp:BagianTanaman,
        ptp:FaktorRisiko,
        ptp:FasePertumbuhan,
        ptp:Pengendalian,
        ptp:Referensi,
        ptp:Varietas .

ptp:PengendalianKulturTeknis a owl:Class ;
    rdfs:label "Pengendalian Kultur Teknis"@id ;
    rdfs:subClassOf ptp:Pengendalian .

ptp:Penyakit a owl:Class ;
    rdfs:label "Penyakit"@id ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ptp:memilikiGejala ;
            owl:someValuesFrom ptp:Gejala ],
        [ a owl:Restriction ;
            owl:onProperty ptp:menyerangTanaman ;
            owl:someValuesFrom ptp:TanamanPangan ],
        [ a owl:Restriction ;
            owl:allValuesFrom ptp:Patogen ;
            owl:onProperty ptp:disebabkanOleh ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ptp:Referensi ;
            owl:onProperty ptp:memilikiReferensi ] ;
    owl:disjointWith ptp:BagianTanaman,
        ptp:FaktorRisiko,
        ptp:FasePertumbuhan,
        ptp:Gejala,
        ptp:Patogen,
        ptp:Pengendalian,
        ptp:Referensi,
        ptp:Varietas .

ptp:GejalaDaun a owl:Class ;
    rdfs:label "Gejala Daun"@id ;
    rdfs:subClassOf ptp:Gejala .

ptp:Daun a ptp:BagianTanaman,
        owl:NamedIndividual ;
    rdfs:label "Daun"@id .

ptp:Gejala a owl:Class ;
    rdfs:label "Gejala"@id ;
    owl:disjointWith ptp:BagianTanaman,
        ptp:FaktorRisiko,
        ptp:FasePertumbuhan,
        ptp:Patogen,
        ptp:Pengendalian,
        ptp:Referensi,
        ptp:Varietas .

ptp:Pengendalian a owl:Class ;
    rdfs:label "Pengendalian"@id ;
    owl:disjointWith ptp:FaktorRisiko,
        ptp:FasePertumbuhan,
        ptp:Referensi,
        ptp:Varietas .

