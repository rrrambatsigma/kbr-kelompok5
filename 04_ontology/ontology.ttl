ptp:PengamatanPenyakitKudisUbiJalarInokulumBiasanyaBerasalBahanTanam a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala Penyakit kudis"@id ;
    ptp:deskripsiGejala "Sumber inokulum penyakit kudis biasanya berasal dari bahan tanam (setek) yang terinfeksi jamur, penyakit ini menyebar lebih cepat ke tanaman yang sehat percikan air hujan yang disertai angin, lebih banyak terjadi serangan pada musim hujan (Saleh and Rahayuningsih, 2013)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitKudisUbiJalarInokulumBiasanyaBerasalBahanTanam ;
    ptp:merupakanGejalaDari ptp:PenyakitKudisUbiJalar ;
