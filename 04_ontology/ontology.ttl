ptp:PengamatanPenyakitKudisUbiJalarMenjadiTidakProduktifFotosintesisTingkat a ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala Penyakit kudis"@id ;
    ptp:deskripsiGejala "Daun menjadi tidak produktif dalam fotosintesis jika pada tingkat serangan berat, sehingga hasil ubi rendah dan bahkan tidak menghasilkan sama sekali (Rukmana, 1997)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitKudisUbiJalarMenjadiTidakProduktifFotosintesisTingkat ;
    ptp:merupakanGejalaDari ptp:PenyakitKudisUbiJalar ;
    ptp:terdapatPada ptp:Daun ;
    rdfs:comment "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Pengamatan gejala Penyakit kudis"@id .

ptp:PengamatanPenyakitKudisUbiJalarSelainFaktorLingkunganMemengaruhiPerubahan a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala Penyakit kudis"@id ;
    ptp:deskripsiGejala "Selain itu, faktor lingkungan juga memengaruhi perubahan ketahanan ubi jalar terhadap penyakit kudis (Roosda et al., 20013), sehingga kultivar yang tahan dapat berubah menjadi tidak tahan dan periode inkubasi juga memengaruhi munculnya gejala penyakit (Samiyarsih, Juwarno and Muljowati, 2018)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaPenyakitKudisUbiJalarSelainFaktorLingkunganMemengaruhiPerubahan ;
    ptp:merupakanGejalaDari ptp:PenyakitKudisUbiJalar ;
    rdfs:comment "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Pengamatan gejala Penyakit kudis"@id .

