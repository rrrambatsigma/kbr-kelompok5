        owl:NamedIndividual ;
    rdfs:label "Klorosis daun pada Penyakit Karat Daun"@id ;
    ptp:deskripsiGejala "Gejala karat daun berupa bintil kecil timbul berwarna kuning kecokelatan (oranye) yang terdapat pada permukaan atas daun."@id ;
