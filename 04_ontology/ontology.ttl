ptp:PengamatanLayuFusariumUbiJalarFusariumUmbiBerupaKankerMelingkar a ptp:GejalaUmbi,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala layu fusarium"@id ;
    ptp:deskripsiGejala "Gejala serangan Fusarium pada umbi ubi jalar berupa kanker melingkar permukaan yang minimal memengaruhi jaringan di bawahnya, berwarna coklat pucat sampai kehitaman kering, rerata diameter awalnya 2-4 mm, luka dapat tumbuh dan berkembang menghasilkan area gelap yang lebih luas (Gambar 2A)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaLayuFusariumUbiJalarFusariumUmbiBerupaKankerMelingkar ;
    ptp:merupakanGejalaDari ptp:LayuFusariumUbiJalar ;
    ptp:terdapatPada ptp:Umbi ;
    rdfs:comment "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Pengamatan gejala layu fusarium"@id .

ptp:PengamatanLayuFusariumUbiJalarMerambatBerwarnaKecokelatan1BE a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala layu fusarium"@id ;
    ptp:deskripsiGejala "Tanaman merambat berwarna kecokelatan (1B dan E), tanaman yang mati sering terdapat miselium berwarna merah muda dengan makrokonidia dan mikrokonidia patogen (1C dan F)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaLayuFusariumUbiJalarMerambatBerwarnaKecokelatan1BE ;
    ptp:merupakanGejalaDari ptp:LayuFusariumUbiJalar ;
    rdfs:comment "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Pengamatan gejala layu fusarium"@id .

ptp:PengamatanLayuFusariumUbiJalarSelainTerjadiNekrosisBagianVaskular a ptp:GejalaBatang,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala layu fusarium"@id ;
    ptp:deskripsiGejala "Selain itu, terjadi nekrosis pada bagian vaskular batang dengan perubahan warna coklat menjadi ungu yang disertai pecahnya korteks batang dan miselium tumbuh pada permukaan batang yang terinfeksi (Gambar 1G dan F)."@id ;
    ptp:didukungOleh ptp:BuktiGejalaLayuFusariumUbiJalarSelainTerjadiNekrosisBagianVaskular ;
    ptp:merupakanGejalaDari ptp:LayuFusariumUbiJalar ;
    ptp:terdapatPada ptp:Batang ;
    rdfs:comment "Pengamatan gejala yang belum dipetakan ke konsep kanonik."@id ;
    skos:prefLabel "Pengamatan gejala layu fusarium"@id .

