ptp:PenggunaanBeauveria a ptp:PengendalianBiologis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan Beauveria"@id ;
    ptp:deskripsiPengendalian "Pengendalian wereng coklat dapat dengan penggunaan cendawan entomopatogen seperti Metarhizium dan Beauveria."@id ;
    ptp:didukungOleh ptp:BuktiPengendalianPenyakitKerdilRumputDanKerdilHampaPadiPengendalianWerengCoklatPenggunaanCendawan,
        ptp:BuktiPengendalianPenyakitRebahSemaiKedelaiHarzianumBeauveriaBassianaMenginduksiTingkat ;
