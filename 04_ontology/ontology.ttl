    rdfs:comment "Tindakan kanonik penggunaan Beauveria."@id ;
    skos:prefLabel "Penggunaan Beauveria"@id .

ptp:PenggunaanBiopestisida a ptp:PengendalianBiologis,
        owl:NamedIndividual ;
    rdfs:label "Penggunaan biopestisida"@id ;
    ptp:deskripsiPengendalian "Keamanan hayati produk pertanian saat ini semakin mendapat perhatian masyarakat dan petani, sehingga secara berangsur-angsur penggunaan pestisida kimia yang memiliki residu berbahaya terhadap kesehatan, disubstitusi dengan pestisida hayati berasal dari mikroba agens hayati."@id ;
    ptp:didukungOleh ptp:BuktiPengendalianPenyakitLayuBakteriKacangTanahKeamananHayatiProdukPertanianSemakin,
        ptp:BuktiPengendalianUmumKacangTanahKeamananHayatiProdukPertanianSemakin ;
    ptp:mengendalikanPenyakit ptp:PenyakitLayuBakteriKacangTanah ;
    ptp:namaPengendalian "Penggunaan biopestisida"@id ;
    rdfs:comment "Tindakan kanonik penggunaan biopestisida."@id ;
    skos:prefLabel "Penggunaan biopestisida"@id .

ptp:PenggunaanHerbisida a ptp:PengendalianKimiawi,
