        ptp:PenyakitBusukHitamBlackRotUbiJalar,
        ptp:PenyakitBusukPelepahJagung,
        ptp:PenyakitEmbunPalsuDownyMildewKedelai,
        ptp:PenyakitEmbunTepungPowderyMildewKedelai,
        ptp:PenyakitHawarBakteriBacterialBlightKedelai,
        ptp:PenyakitHawarDaunBakteriPadi,
        ptp:PenyakitHawarDaunJagung,
        ptp:PenyakitHawarPelepahDaunPadi,
