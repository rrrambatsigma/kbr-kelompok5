ptp:PengamatanPenyakitKudisUbiJalarAwalnyaBerwarnaKuningCoklatKekuningan a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala Penyakit kudis"@id ;
    ptp:deskripsiGejala "Pada awalnya bercak berwarna kuning coklat kekuningan, coklat kemerahan dan akhirnya menjadi coklat kehitaman (Martanto, Tanati and Baan, 2016)."@id ;
