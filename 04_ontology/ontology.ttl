ptp:PengamatanPenyakitLayuKacangHijauMiseliaBerwarnaPutihTingkatLanjut a ptp:GejalaAkar,
        ptp:GejalaDaun,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala LAYU"@id ;
    ptp:deskripsiGejala "Miselia berwarna putih akan ditemukan di sekitar gejala, dan pada gejala tingkat lanjut akan ditemukan sejumlah sclerosia pada akar (Jin Hyeuk 2017) dan daun dekat permukaan tanah (Gambar 25)."@id ;
