ptp:PengamatanPenyakitAntraknosaKedelaiDiawaliMunculnyaLekukanBerwarnaHitam a ptp:Gejala,
        owl:NamedIndividual ;
    rdfs:label "Pengamatan gejala Penyakit Antraknosa"@id ;
    ptp:deskripsiGejala "Gejala diawali dengan munculnya lekukan bercak berwarna hitam dengan bentuk bercak yang tidak beraturan."@id ;
