        ptp:PenyakitTungroPadi,
        ptp:SapuSetanWitchesBroomUbiKayu,
        ptp:SuperelongasiUbiKayu,
        ptp:TanamanKerdilStuntUbiKayu ;
    ptp:identifierSumber "DOC002" ;
    ptp:judulReferensi "Penyakit Tanaman dan Pengendaliannya"@id ;
    ptp:namaPenulis "Evan Purnama Ramdan, Lina Budiarti, Nur Kholida Wulansari, Resti Fajarfika, Riana Murti Handayani, Ratna Dwi Hirma Windriyati, Junairiah, Dwiwiyati Nurul Septariani, Arsi, Muzayyanah Rahmiyah, Wenni Tania Defriyanti, Muh. Adiwena, Akhmad Faisal Malik, Ankardiansyah Pandu Pradana, Muhammad Asril" ;
    ptp:tahunTerbit 2021 ;
    rdfs:comment "Referensi buku yang menjadi sumber data."@id ;
