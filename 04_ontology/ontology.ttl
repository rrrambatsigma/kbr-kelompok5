    kbr:sourceBlockId "DOC002_P094_B001"@id ;
    kbr:symptomText "Pemanjangan ruas batang yang berlebihan, sehingga batang terbentuk tipis dan lemah dibandingkan tanaman sehat. Gejala pada daun dan tangkai daun di batang muda, deformasi berkembang berasosisi dengan gejala kanker."@id .

kbrd:T5_2_BATANG_R4 a kbr:SourceTableRow,
        owl:NamedIndividual ;
    rdfs:label "Tanaman kerdil (stunt)"@id ;
