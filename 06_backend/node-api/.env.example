# Node API
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Fuseki (SPARQL read-only)
FUSEKI_BASE_URL=http://localhost:3030
FUSEKI_DATASET=plant-kb
FUSEKI_TIMEOUT_MS=5000

# Java reasoning API (OWL API + Openllet)
REASONING_API_URL=http://localhost:8082
REASONING_TIMEOUT_MS=15000

# Opsional: untuk health check checksum file vs Java.
# Kosongkan bila Node tidak punya akses ke file ontology.
ONTOLOGY_FILE_PATH=E:/kbr-kelompok5/04_ontology/ontology_md.ttl

# Case log (ABox runtime, dataset terpisah dari plant-kb)
FUSEKI_CASE_DATASET=plant-kb-kasus
CASE_LOG_ENABLED=true
CBR_INCLUDE_UNVERIFIED=false
CBR_MIN_OVERLAP=1
CBR_TIMEOUT_MS=2000

# Pencarian gejala dengan kata sendiri
SYMPTOM_MATCH_LIMIT=5
SYMPTOM_MATCH_MIN_SCORE=0.35

# Frontend CORS origin
FRONTEND_URL=http://localhost:5173
