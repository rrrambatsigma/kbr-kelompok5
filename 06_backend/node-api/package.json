{
  "name": "api",
  "version": "1.0.0",
  "description": "KBR plant disease expert system API (Express -> Fuseki + reasoning API)",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prestart": "npm run clean && npm run build",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dataset:inspect": "tsx scripts/inspect-dataset.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
